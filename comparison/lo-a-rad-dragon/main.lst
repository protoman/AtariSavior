     14 U0081		       00	   RoomY      byte.b
     15 U0082		       00	   OldX       byte.b
     16 U0083		       00	   OldY       byte.b
     17 U0084		       00	   Random     byte.b
     18 U0085		       00	   MapPtrLo   byte.b
     19 U0086		       00	   MapPtrHi   byte.b
     20 U0087		       00	   CollisionX byte.b
     21 U0088		       00	   CollisionCellX byte.b
     22 U0089		       00	   CollisionCellY byte.b
     23 U008a		       00	   CollisionEndX byte.b
     24 U008b		       00	   CollisionEndY byte.b
