   2122  fd7c		       85 e3		      sta	scorePtr2+1
   2123  fd7e		       85 e5		      sta	scorePtr3+1
   2124  fd80		       85 e7		      sta	scorePtr4+1
   2125  fd82		       85 e9		      sta	scorePtr5+1
   2126  fd84		       85 eb		      sta	scorePtr6+1
   2127  fd86
   2128  fd86		       a5 f2		      lda	LevelShowTimer
   2129  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2130  fd8a		       f0 2e		      beq	.scoreLows
   2131  fd8c		       c6 f2		      dec	LevelShowTimer
   2132  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2133  fd90		       85 e0		      sta	scorePtr1
   2134  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2135  fd94		       85 e2		      sta	scorePtr2
   2136  fd96		       a9 00		      lda	#0	; hundreds '0'
   2137  fd98		       85 e4		      sta	scorePtr3
   2138  fd9a		       a5 a3		      lda	Level
   2139  fd9c		       18		      clc
   2140  fd9d		       69 01		      adc	#1	; 1-based level number
   2141  fd9f		       a2 00		      ldx	#0
   2142  fda1				   .LVTens
   2143  fda1		       c9 0a		      cmp	#10
   2144  fda3		       90 05		      bcc	.LVTensDone
   2145  fda5		       e9 0a		      sbc	#10
   2146  fda7		       e8		      inx
   2147  fda8		       d0 f7		      bne	.LVTens
   2148  fdaa				   .LVTensDone
   2149  fdaa		       0a		      asl
   2150  fdab		       0a		      asl
   2151  fdac		       0a		      asl		; ones * 8
   2152  fdad		       85 e8		      sta	scorePtr5
   2153  fdaf		       8a		      txa
   2154  fdb0		       0a		      asl
   2155  fdb1		       0a		      asl
   2156  fdb2		       0a		      asl		; tens * 8
   2157  fdb3		       85 e6		      sta	scorePtr4
   2158  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2159  fdb7		       85 ea		      sta	scorePtr6
   2160  fdb9		       60		      rts
   2161  fdba
   2162  fdba							; scorePtr1..2 = leading zeros
   2163  fdba				   .scoreLows
   2164  fdba		       a9 00		      lda	#0
   2165  fdbc		       85 e0		      sta	scorePtr1
   2166  fdbe		       85 e2		      sta	scorePtr2
   2167  fdc0
   2168  fdc0							; scorePtr3 = ScoreTh * 8
   2169  fdc0		       a5 f3		      lda	ScoreTh
   2170  fdc2		       0a		      asl
   2171  fdc3		       0a		      asl
   2172  fdc4		       0a		      asl
   2173  fdc5		       85 e4		      sta	scorePtr3
   2174  fdc7
