   1179  f7a0							; ====================================================================
   1180  f7a0							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1181  f7a0							; Proven kernel from score48pix.asm
   1182  f7a0							; ====================================================================
   1183  f7a0		       a0 07		      ldy	#7
   1184  f7a2		       84 ec		      sty	scbrdCnt
   1185  f7a4				   .ScoreLoop
   1186  f7a4		       a4 ec		      ldy	<scbrdCnt	; 3c
   1187  f7a6		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1188  f7a8		       aa		      tax		; 2c — cache in X
   1189  f7a9		       85 02		      sta	WSYNC	; 3c
   1190  f7ab		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1191  f7ad		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1192  f7b0		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1193  f7b2		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1194  f7b4		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1195  f7b6		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1196  f7b8		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1197  f7ba		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1198  f7bc		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1199  f7be		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1200  f7c0		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1201  f7c2		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1202  f7c4		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1203  f7c6		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1204  f7c8		       c6 ec		      dec	<scbrdCnt	; 5c
   1205  f7ca		       d0 d8		      bne	.ScoreLoop	; 3c
   1206  f7cc
