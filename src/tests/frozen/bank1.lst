   2111  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2112  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2113  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2114  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2115  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2116  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2117  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2118  fd68				   SetupScorePointers
   2119  fd68							; --- Initialize score to 0 on first frame ---
   2120  fd68		       a5 ad		      lda	Temp
   2121  fd6a		       d0 0c		      bne	.scoreInitDone
   2122  fd6c		       e6 ad		      inc	Temp
   2123  fd6e		       a9 00		      lda	#0
   2124  fd70		       85 f3		      sta	ScoreTh
   2125  fd72		       85 f4		      sta	ScoreHu
   2126  fd74		       a9 00		      lda	#$00
   2127  fd76		       85 f5		      sta	ScoreTe
   2128  fd78				   .scoreInitDone
   2129  fd78
   2130  fd78							; --- Set up 6 digit pointers ---
   2131  fd78							; High bytes first (all $FD)
   2132  fd78		       a9 fd		      lda	#>DigitGfx
