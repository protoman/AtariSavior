    449  f35a							; ==============================================================================
    450  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    451  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    452  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    453  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    454  f35a							;   byte = note_code*4 + duration_code
    455  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    456  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    457  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    458  f35a							; ==============================================================================
    459  f35a		       00 9d	   MelPtr     =	$9D
    460  f35a		       00 9e	   MelTimer   =	$9E
    461  f35a
    462  f35a				   MusicTick
    463  f35a		       a9 00		      lda	#0
    464  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    465  f35e		       a6 9d		      ldx	MelPtr
    466  f360		       a5 9e		      lda	MelTimer
    467  f362		       f0 0d		      beq	.MelLoad
    468  f364		       c6 9e		      dec	MelTimer
    469  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    470  f369							;   MelPtr already points at the NEXT step, so
    471  f369							;   this mirrors the pre-pack (duration,note)
    472  f369							;   player's MusicMel+1,X read, keeps the same
    473  f369							;   audible melody
    474  f369		       4a		      lsr
    475  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    476  f36b		       20 98 f3 	      jsr	MelApply
    477  f36e		       4c f8 fb 	      jmp	ReturnPad
    478  f371				   .MelLoad
    479  f371		       bd b0 f3 	      lda	MusicMel,X
    480  f374		       29 03		      and	#3
    481  f376		       a8		      tay
    482  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    483  f37a		       85 9e		      sta	MelTimer
    484  f37c		       bd b0 f3 	      lda	MusicMel,X
    485  f37f		       4a		      lsr
    486  f380		       4a		      lsr
