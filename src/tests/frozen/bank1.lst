     95  f041							; TitleSelect — moved from bank0 (refactor_v4_plan Phase 3.1 canary, 2026-10-16).
     96  f041							; Pure leaf (no calls); returns C=1 edge (caller runs LoadLevel) / C=0 no-edge.
     97  f041							; Entered via CallPad_TitleSelect ($FC4F); tail-exits through ReturnPad
     98  f041							; (sta $1FF6/rts), which returns to the bank0 caller with C intact.
     99  f041		       02 82	   SWCHB      =	$0282
    100  f041		       00 97	   StepsLeft  =	$97	; bank0 per-frame step latch (ZP byte block)
    101  f041		       00 04	   LEVEL_COUNT =	4	; hand copy of kernel LEVEL_COUNT
    102  f041				   TitleSelect
    103  f041		       a5 97		      lda	StepsLeft
    104  f043		       29 02		      and	#%00000010
    105  f045		       f0 17		      beq	.TSnoB1
    106  f047		       ad 82 02 	      lda	SWCHB
    107  f04a		       29 02		      and	#%00000010
    108  f04c		       d0 10		      bne	.TSnoB1
    109  f04e		       e6 a3		      inc	Level
    110  f050		       a5 a3		      lda	Level
    111  f052		       c9 04		      cmp	#LEVEL_COUNT
    112  f054		       d0 04		      bne	.TSokB1
    113  f056		       a9 00		      lda	#0
    114  f058		       85 a3		      sta	Level
    115  f05a				   .TSokB1
    116  f05a		       38		      sec
    117  f05b		       4c f8 fb 	      jmp	ReturnPad
    118  f05e				   .TSnoB1
    119  f05e		       18		      clc
    120  f05f		       4c f8 fb 	      jmp	ReturnPad
