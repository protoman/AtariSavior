   2234  fd7e		       85 e5		      sta	scorePtr3+1
   2235  fd80		       85 e7		      sta	scorePtr4+1
   2236  fd82		       85 e9		      sta	scorePtr5+1
   2237  fd84		       85 eb		      sta	scorePtr6+1
   2238  fd86
   2239  fd86		       a5 f2		      lda	LevelShowTimer
   2240  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2241  fd8a		       f0 2e		      beq	.scoreLows
