   1467  f867							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1468  f867							; verify_build.check_raft_tramp). bank0 executes `sta $1FF5` at $F8C0-$F8C2 and
   1469  f867							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1470  f867							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1471  f867							; `sta $1FF5` is never executed (it is only the swapped-out image's prefix).
   1472  f867							; In bank1's $F822-$F8C6 fill; StripBlastCheck follows it directly ($F937 pin
   1473  f867							; deleted 2026-10-20 — the body floats and the $F9AC pin bounds the leaves).
   1474  f867							; ------------------------------------------------------------------------------
   1475  f867		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1476  f8c0		       8d f5 1f 	      .byte.b	$8D, $F5, $1F	; sta $1FF5 (twin)
   1477  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1478  f8c6
   1479  f8c6							; ($F937 pin DELETED 2026-10-20, audit round 2: it pinned bank2's
   1480  f8c6							;  M1StripBlast back-jmp operand, and that body is same-bank now — the chain
   1481  f8c6							;  is .BMWDone -> M1StripBlast -> StripBlastCheck inside bank1, so
   1482  f8c6							;  StripBlastCheck is reached by label and floats. It now starts right after
   1483  f8c6							;  the raft tramp twin; the $F9AC pin still bounds the sound-leaf block.)
   1484  f8c6							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1485  f8c6							; from BombMarkWalls .BMWDone through M1StripBlast (same bank, label `jmp`s
   1486  f8c6							; — repack chunk 2; 0 pushes, no switch). Still 0 pushes (the jsr+pha
   1487  f8c6							; version measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1488  f8c6							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1489  f8c6							; Every exit ends in ReturnPad with A = count.
   1490  f8c6							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1491  f8c6							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1492  f8c6							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1493  f8c6							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1494  f8c6							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1495  f8c6							; inc the count (caller's +75 loop scores it). The
   1496  f8c6							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1497  f8c6							; lifecycle as WallMask holes (D1-B). P2b door models never
   1498  f8c6							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1499  f8c6							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1500  f8c6							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1501  f8c6							; ------------------------------------------------------------------------------
   1502  f8c6				   StripBlastCheck
   1503  f8c6							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1504  f8c6							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1505  f8c6							; Window is still LEFT-half here (the mirror below). Door models stage
   1506  f8c6							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1507  f8c6							; sets b3/b4 instead.
   1508  f8c6		       a5 92		      lda	RectCount
   1509  f8c8		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1510  f8ca		       a5 8c		      lda	CollisionCellX	; blast hi
   1511  f8cc		       c5 92		      cmp	RectCount
   1512  f8ce		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1513  f8d0		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1514  f8d2		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1515  f8d4		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1516  f8d6		       c9 02		      cmp	#2
   1517  f8d8		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1518  f8da							;   (A=0/1 falls into take = overlap)
   1519  f8da				   .SBleftTake
   1520  f8da		       a5 ba		      lda	EnemyDeadMask
   1521  f8dc		       29 10		      and	#$10
   1522  f8de		       d0 08		      bne	.SBright	; already destroyed → no double score
   1523  f8e0		       a9 10		      lda	#$10
   1524  f8e2		       05 ba		      ora	EnemyDeadMask
   1525  f8e4		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1526  f8e6		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1527  f8e8				   .SBright
   1528  f8e8							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1529  f8e8							; window here (space is free in this gap): lo_r = 39-hi_l,
   1530  f8e8							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
