   1632  fa83							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1633  fa83							; ScoreTh/ScoreHu = binary 0-9; ScoreTe = packed BCD. Clobbers A.
   1634  fa83							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1635  fa83							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1636  fa83							; (the 2026-09-23 decimal-mode rule). The old BINARY `cmp #$A0 / sbc #$A0`
   1637  fa83							; fix-up missed nibble-level overflow: $25+$75 = $9A stored raw -> ones
   1638  fa83							; digit A -> glyph index 10 -> DigitGfx+80 (past the 10-glyph font) =
   1639  fa83							; the solid-block score digit (screenshots/score_issue_002.png).
   1640  fa83							; C=1 = BCD carry (sum >= 100) -> ScoreHu path.
   1641  fa83							; SIZE PIN: routine runs $FA7D..$FAA4 exactly (UpdateLaserSound's pad
   1642  fa83							; target is $FAA5). Old head = clc/adc/cmp/bcc/sbc = 9 bytes, new head =
   1643  fa83							; sed/clc/adc/cld/bcc = 7, so the two nops restore the exact length —
   1644  fa83							; without them every pad below shifts silently.
   1645  fa83				   AddScore
   1646  fa83		       f8		      sed
   1647  fa84		       18		      clc
   1648  fa85		       65 f5		      adc	ScoreTe
   1649  fa87		       d8		      cld
   1650  fa88		       90 1c		      bcc	.ASstoreTe
   1651  fa8a		       ea		      nop		; byte-pin (see SIZE PIN above)
   1652  fa8b		       ea		      nop		; byte-pin
   1653  fa8c		       48		      pha		; save wrapped ScoreTe
   1654  fa8d		       e6 f4		      inc	ScoreHu
   1655  fa8f		       a5 f4		      lda	ScoreHu
   1656  fa91		       c9 0a		      cmp	#10
   1657  fa93		       90 10		      bcc	.AShuOk
   1658  fa95		       a9 00		      lda	#0
   1659  fa97		       85 f4		      sta	ScoreHu
   1660  fa99		       e6 f3		      inc	ScoreTh
   1661  fa9b		       a5 f3		      lda	ScoreTh
   1662  fa9d		       c9 0a		      cmp	#10
   1663  fa9f		       90 04		      bcc	.ASthOk
   1664  faa1		       a9 09		      lda	#9
   1665  faa3		       85 f3		      sta	ScoreTh
   1666  faa5				   .ASthOk
   1667  faa5				   .AShuOk
   1668  faa5		       68		      pla
   1669  faa6				   .ASstoreTe
