   1456  f8f7		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1457  f8f9		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1458  f8fb		       a5 8c		      lda	CollisionCellX	; hi
   1459  f8fd		       38		      sec
   1460  f8fe		       e5 88		      sbc	BMWScratch	; hi - pL
