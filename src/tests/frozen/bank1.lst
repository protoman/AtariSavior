   2222  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2223  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2224  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2225  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2226  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2227  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2228  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2229  fd68				   SetupScorePointers
   2230  fd68							; --- Initialize score to 0 on first frame ---
   2231  fd68		       a5 ad		      lda	Temp
   2232  fd6a		       d0 0c		      bne	.scoreInitDone
   2233  fd6c		       e6 ad		      inc	Temp
   2234  fd6e		       a9 00		      lda	#0
   2235  fd70		       85 f3		      sta	ScoreTh
   2236  fd72		       85 f4		      sta	ScoreHu
   2237  fd74		       a9 00		      lda	#$00
   2238  fd76		       85 f5		      sta	ScoreTe
   2239  fd78				   .scoreInitDone
   2240  fd78
   2241  fd78							; --- Set up 6 digit pointers ---
   2242  fd78							; High bytes first (all $FD)
   2243  fd78		       a9 fd		      lda	#>DigitGfx
   2244  fd7a		       85 e1		      sta	scorePtr1+1
   2245  fd7c		       85 e3		      sta	scorePtr2+1
   2246  fd7e		       85 e5		      sta	scorePtr3+1
   2247  fd80		       85 e7		      sta	scorePtr4+1
   2248  fd82		       85 e9		      sta	scorePtr5+1
   2249  fd84		       85 eb		      sta	scorePtr6+1
   2250  fd86
   2251  fd86		       a5 f2		      lda	LevelShowTimer
   2252  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2253  fd8a		       f0 2e		      beq	.scoreLows
   2254  fd8c		       c6 f2		      dec	LevelShowTimer
   2255  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2256  fd90		       85 e0		      sta	scorePtr1
   2257  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2258  fd94		       85 e2		      sta	scorePtr2
   2259  fd96		       a9 00		      lda	#0	; hundreds '0'
   2260  fd98		       85 e4		      sta	scorePtr3
   2261  fd9a		       a5 a3		      lda	Level
   2262  fd9c		       18		      clc
   2263  fd9d		       69 01		      adc	#1	; 1-based level number
   2264  fd9f		       a2 00		      ldx	#0
   2265  fda1				   .LVTens
   2266  fda1		       c9 0a		      cmp	#10
   2267  fda3		       90 05		      bcc	.LVTensDone
   2268  fda5		       e9 0a		      sbc	#10
   2269  fda7		       e8		      inx
   2270  fda8		       d0 f7		      bne	.LVTens
   2271  fdaa				   .LVTensDone
   2272  fdaa		       0a		      asl
   2273  fdab		       0a		      asl
   2274  fdac		       0a		      asl		; ones * 8
   2275  fdad		       85 e8		      sta	scorePtr5
   2276  fdaf		       8a		      txa
   2277  fdb0		       0a		      asl
   2278  fdb1		       0a		      asl
   2279  fdb2		       0a		      asl		; tens * 8
   2280  fdb3		       85 e6		      sta	scorePtr4
   2281  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2282  fdb7		       85 ea		      sta	scorePtr6
   2283  fdb9		       60		      rts
   2284  fdba
   2285  fdba							; scorePtr1..2 = leading zeros
   2286  fdba				   .scoreLows
   2287  fdba		       a9 00		      lda	#0
   2288  fdbc		       85 e0		      sta	scorePtr1
   2289  fdbe		       85 e2		      sta	scorePtr2
   2290  fdc0
   2291  fdc0							; scorePtr3 = ScoreTh * 8
   2292  fdc0		       a5 f3		      lda	ScoreTh
   2293  fdc2		       0a		      asl
   2294  fdc3		       0a		      asl
   2295  fdc4		       0a		      asl
   2296  fdc5		       85 e4		      sta	scorePtr3
   2297  fdc7
   2298  fdc7							; scorePtr4 = ScoreHu * 8
   2299  fdc7		       a5 f4		      lda	ScoreHu
   2300  fdc9		       0a		      asl
   2301  fdca		       0a		      asl
   2302  fdcb		       0a		      asl
   2303  fdcc		       85 e6		      sta	scorePtr4
   2304  fdce
   2305  fdce							; scorePtr5 = (ScoreTe >> 4) * 8  (tens digit)
   2306  fdce		       a5 f5		      lda	ScoreTe
   2307  fdd0		       4a		      lsr
   2308  fdd1		       4a		      lsr
   2309  fdd2		       4a		      lsr
   2310  fdd3		       4a		      lsr		; tens digit in low nibble
   2311  fdd4		       0a		      asl
   2312  fdd5		       0a		      asl
   2313  fdd6		       0a		      asl
   2314  fdd7		       85 e8		      sta	scorePtr5
   2315  fdd9
   2316  fdd9							; scorePtr6 = (ScoreTe & $0F) * 8  (ones digit)
   2317  fdd9		       a5 f5		      lda	ScoreTe
   2318  fddb		       29 0f		      and	#$0F
   2319  fddd		       0a		      asl
   2320  fdde		       0a		      asl
   2321  fddf		       0a		      asl
   2322  fde0		       85 ea		      sta	scorePtr6
   2323  fde2		       60		      rts
   2324  fde3
   2325  fde3							; ========================================================================
   2326  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2327  fde3							; ========================================================================
   2328  fde3					      .ds	$FDE3 - *, 0
   2329  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2330  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2331  fde3							; rails keep it inside the room
   2332  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2333  fde3							; surface (line 132) - 7, so its BOTTOM row
   2334  fde3							; sits exactly ON the surface. The live value is
   2335  fde3							; RAFTER_BASE + off (see the tide block below) —
   2336  fde3							; never hard-code the Y: the surface MOVES.
   2337  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2338  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2339  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2340  fde3							; from 12 px above the raft's top to 5 px into it
   2341  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2342  fde3
   2343  fde3				   RaftBody
   2344  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2345  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2346  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2347  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2348  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2349  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2350  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2351  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2352  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2353  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2354  fde3		       a5 c2		      lda	EnemyRamP
   2355  fde5		       29 f0		      and	#$F0
   2356  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2357  fde9		       4a		      lsr
   2358  fdea		       4a		      lsr
   2359  fdeb		       4a		      lsr
   2360  fdec		       4a		      lsr		; A = p (1..15)
   2361  fded		       c9 08		      cmp	#8
   2362  fdef		       90 04		      bcc	.RaftTideTri
   2363  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2364  fdf3		       f0 09		      beq	.RaftTide	; always
   2365  fdf5				   .RaftTideTri
   2366  fdf5		       c9 04		      cmp	#4
   2367  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2368  fdf9		       49 ff		      eor	#$FF
   2369  fdfb		       38		      sec
   2370  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2371  fdfe				   .RaftTide
   2372  fdfe		       18		      clc
   2373  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2374  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2375  fe03							; water line is what the raft floats on
   2376  fe03
   2377  fe03							; --- does the player count as "over the raft"? --------------------------
   2378  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2379  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2380  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2381  fe03							; block here is what makes it park; the pin/carry later still applies while
   2382  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2383  fe03							; raft he is actually standing on.
   2384  fe03		       a5 80		      lda	RoomX
   2385  fe05		       38		      sec
   2386  fe06		       f5 bd		      sbc	EnemyRamX,X
   2387  fe08		       18		      clc
   2388  fe09		       69 06		      adc	#RAFTER_XOFF
   2389  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2390  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2391  fe0f		       a5 81		      lda	RoomY
   2392  fe11		       38		      sec
   2393  fe12		       f5 e2		      sbc	EnemyRamY,X
   2394  fe14		       18		      clc
   2395  fe15		       69 0c		      adc	#RAFTER_PINFIT
