   1169  f787							; P0 at pixel 60, P1 at pixel 68 (shifted 4px right to fix pipeline timing)
   1170  f787		       a9 3c		      lda	#60
   1171  f789		       a2 00		      ldx	#0
   1172  f78b		       20 f8 f7 	      jsr	SetObjectXPos_b1
   1173  f78e		       a9 44		      lda	#68
