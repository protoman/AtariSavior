   2335  fde3							; ========================================================================
   2336  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2337  fde3							; ========================================================================
   2338  fde3					      .ds	$FDE3 - *, 0
   2339  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2340  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2341  fde3							; rails keep it inside the room
   2342  fde3		       00 83	   RAFTER_BASE =	131	; raft top when the tide is at 0: the 2-row
   2343  fde3							; surface (line 132) - 7, so its BOTTOM row
   2344  fde3							; sits exactly ON the surface. The live value is
   2345  fde3							; plank's BOTTOM row (top+1) lands on the water
   2346  fde3							; surface (132+off) — see the tide block below;
   2347  fde3							; never hard-code the Y: the surface MOVES.
   2348  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2349  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2350  fde3		       00 1c	   RAFTER_YSPAN =	28	; PLAYER_SPRITE_H+6: riding when the feet are
   2351  fde3							; from 22 px above the raft's top to 5 px into it
   2352  fde3		       00 16	   RAFTER_PINFIT =	22	; PLAYER_SPRITE_H: pin = raft top - this
   2353  fde3
   2354  fde3				   RaftBody
   2355  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2356  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2357  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2358  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2359  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
   2360  fde3							; This mirrors the VBL's
   2361  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2362  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2363  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2364  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2365  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2366  fde3		       a5 c2		      lda	EnemyRamP
   2367  fde5		       29 f0		      and	#$F0
   2368  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2369  fde9		       4a		      lsr
