   2213  fde3
   2214  fde3							; ========================================================================
   2215  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2216  fde3							; ========================================================================
   2217  fde3					      .ds	$FDE3 - *, 0
   2218  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2219  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2220  fde3							; rails keep it inside the room
   2221  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2222  fde3							; surface (line 132) - 7, so its BOTTOM row
   2223  fde3							; sits exactly ON the surface. The live value is
   2224  fde3							; RAFTER_BASE + off (see the tide block below) —
   2225  fde3							; never hard-code the Y: the surface MOVES.
   2226  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2227  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2228  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2229  fde3							; from 12 px above the raft's top to 5 px into it
   2230  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2231  fde3
   2232  fde3				   RaftBody
   2233  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2234  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2235  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2236  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2237  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2238  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2239  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2240  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2241  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2242  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2243  fde3		       a5 c2		      lda	EnemyRamP
   2244  fde5		       29 f0		      and	#$F0
   2245  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2246  fde9		       4a		      lsr
   2247  fdea		       4a		      lsr
   2248  fdeb		       4a		      lsr
   2249  fdec		       4a		      lsr		; A = p (1..15)
   2250  fded		       c9 08		      cmp	#8
   2251  fdef		       90 04		      bcc	.RaftTideTri
   2252  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2253  fdf3		       f0 09		      beq	.RaftTide	; always
   2254  fdf5				   .RaftTideTri
   2255  fdf5		       c9 04		      cmp	#4
   2256  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2257  fdf9		       49 ff		      eor	#$FF
   2258  fdfb		       38		      sec
   2259  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2260  fdfe				   .RaftTide
   2261  fdfe		       18		      clc
   2262  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2263  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2264  fe03							; water line is what the raft floats on
   2265  fe03
   2266  fe03							; --- does the player count as "over the raft"? --------------------------
   2267  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2268  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2269  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2270  fe03							; block here is what makes it park; the pin/carry later still applies while
   2271  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2272  fe03							; raft he is actually standing on.
   2273  fe03		       a5 80		      lda	RoomX
   2274  fe05		       38		      sec
   2275  fe06		       f5 bd		      sbc	EnemyRamX,X
   2276  fe08		       18		      clc
   2277  fe09		       69 06		      adc	#RAFTER_XOFF
   2278  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2279  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2280  fe0f		       a5 81		      lda	RoomY
   2281  fe11		       38		      sec
   2282  fe12		       f5 e2		      sbc	EnemyRamY,X
   2283  fe14		       18		      clc
   2284  fe15		       69 0c		      adc	#RAFTER_PINFIT
   2285  fe17		       c9 12		      cmp	#RAFTER_YSPAN
   2286  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2287  fe1b		       a5 94		      lda	vyHi
   2288  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2289  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2290  fe22				   .RaftNoRide
   2291  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2292  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2293  fe22		       a5 f0		      lda	$F0
   2294  fe24		       29 07		      and	#%00000111
   2295  fe26		       85 f0		      sta	$F0
   2296  fe28		       4c f8 fb 	      jmp	ReturnPad
   2297  fe2b				   .RaftGo
   2298  fe2b							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2299  fe2b							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2300  fe2b							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2301  fe2b							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2302  fe2b							; it cannot borrow upward either (see the kernel EQU for the contract).
   2303  fe2b							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2304  fe2b							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2305  fe2b							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2306  fe2b		       a5 f0		      lda	$F0
   2307  fe2d		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2308  fe2f		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2309  fe31		       f0 04		      beq	.RaftAtSpeed
   2310  fe33		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2311  fe35		       d0 07		      bne	.RaftHaveStep	; always
   2312  fe37				   .RaftAtSpeed
   2313  fe37		       a5 c2		      lda	EnemyRamP
   2314  fe39		       29 01		      and	#1
   2315  fe3b		       18		      clc
   2316  fe3c		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2317  fe3e				   .RaftHaveStep
   2318  fe3e		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2319  fe40		       bd 44 f8 	      lda	RaftBitTab,X
   2320  fe43		       25 c1		      and	EnemyRamD
   2321  fe45		       f0 29		      beq	.RaftLeft
   2322  fe47							; ---- leading edge right: candidate = x + step ---------------------------
   2323  fe47		       b5 bd		      lda	EnemyRamX,X
   2324  fe49		       18		      clc
   2325  fe4a		       65 88		      adc	$88
   2326  fe4c		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2327  fe4e		       c9 94		      cmp	#RAFT_MAX_X
   2328  fe50		       b0 14		      bcs	.RaftTurn	; right rail
   2329  fe52		       18		      clc
   2330  fe53		       69 01		      adc	#1	; the cell just beyond the right edge
   2331  fe55		       4a		      lsr
   2332  fe56		       4a		      lsr
   2333  fe57		       20 26 f8 	      jsr	RaftCellSolid
   2334  fe5a		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2335  fe5c		       b5 bd		      lda	EnemyRamX,X
   2336  fe5e		       18		      clc
   2337  fe5f		       65 88		      adc	$88
   2338  fe61		       95 bd		      sta	EnemyRamX,X
   2339  fe63		       4c 90 fe 	      jmp	.RaftRide
   2340  fe66							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
   2341  fe66							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2342  fe66				   .RaftTurn
   2343  fe66		       bd 44 f8 	      lda	RaftBitTab,X
   2344  fe69		       45 c1		      eor	EnemyRamD
   2345  fe6b		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2346  fe6d							; bank1's RoomDarkMask — must be preserved)
   2347  fe6d		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2348  fe70							; ---- leading edge left --------------------------------------------------
   2349  fe70				   .RaftLeft
   2350  fe70		       b5 bd		      lda	EnemyRamX,X
   2351  fe72		       38		      sec
   2352  fe73		       e5 88		      sbc	$88
   2353  fe75		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2354  fe77		       c9 08		      cmp	#RAFT_MIN_X
   2355  fe79		       90 eb		      bcc	.RaftTurn	; left rail
   2356  fe7b		       38		      sec
   2357  fe7c		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2358  fe7e		       b0 02		      bcs	.RaftLeftCol
   2359  fe80		       a9 00		      lda	#0
   2360  fe82				   .RaftLeftCol
   2361  fe82		       4a		      lsr
   2362  fe83		       4a		      lsr
   2363  fe84		       20 26 f8 	      jsr	RaftCellSolid
   2364  fe87		       d0 dd		      bne	.RaftTurn
   2365  fe89		       b5 bd		      lda	EnemyRamX,X
   2366  fe8b		       38		      sec
   2367  fe8c		       e5 88		      sbc	$88
   2368  fe8e		       95 bd		      sta	EnemyRamX,X
   2369  fe90							; ---- carry + pin while the player is aboard -----------------------------
   2370  fe90				   .RaftRide
   2371  fe90		       a5 94		      lda	vyHi
   2372  fe92		       30 0d		      bmi	.RaftNoPin	; rising: pin skipped, carry still happens
   2373  fe94		       b5 e2		      lda	EnemyRamY,X
   2374  fe96		       38		      sec
   2375  fe97		       e9 0c		      sbc	#RAFTER_PINFIT
   2376  fe99		       85 81		      sta	RoomY	; feet on the raft's top
   2377  fe9b		       a9 00		      lda	#0
   2378  fe9d		       85 93		      sta	vyLo
   2379  fe9f		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2380  fea1				   .RaftNoPin
   2381  fea1							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2382  fea1		       a5 f0		      lda	$F0
   2383  fea3		       09 80		      ora	#%10000000
   2384  fea5		       85 f0		      sta	$F0
   2385  fea7		       a5 c2		      lda	EnemyRamP
   2386  fea9		       4a		      lsr		; C = the frame-parity bit
   2387  feaa		       b0 0f		      bcs	.RaftCarry	; odd frame: flag only this time
   2388  feac		       a5 f0		      lda	$F0
   2389  feae		       29 78		      and	#%01111000
   2390  feb0		       c9 78		      cmp	#%01111000
   2391  feb2		       f0 07		      beq	.RaftCarry	; already spun up
   2392  feb4		       a5 f0		      lda	$F0
   2393  feb6		       18		      clc
   2394  feb7		       69 10		      adc	#%00010000
   2395  feb9		       85 f0		      sta	$F0
   2396  febb				   .RaftCarry
   2397  febb		       bd 44 f8 	      lda	RaftBitTab,X
   2398  febe		       25 c1		      and	EnemyRamD
   2399  fec0		       f0 0a		      beq	.RaftCarryL
