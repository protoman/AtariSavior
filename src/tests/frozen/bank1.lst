   1249  f7a3							; ====================================================================
   1250  f7a3							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1251  f7a3							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1252  f7a3							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1253  f7a3							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1254  f7a3							; ====================================================================
   1255  f7a3
   1256  f7a3							; --- Setup sprites ---
   1257  f7a3		       a9 0e		      lda	#$0E	; white
   1258  f7a5		       85 06		      sta	COLUP0
   1259  f7a7		       85 07		      sta	COLUP1
   1260  f7a9		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1261  f7ab		       85 04		      sta	NUSIZ0
   1262  f7ad		       85 05		      sta	NUSIZ1
   1263  f7af		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1264  f7b1		       85 25		      sta	VDELP0
   1265  f7b3		       85 26		      sta	VDELP1
   1266  f7b5							; Flush both VDELP buffers + live registers to 0.
   1267  f7b5							; Without this, stale buffer data from previous frame shows as
   1268  f7b5							; white ghost copies during the positioning scanlines.
   1269  f7b5		       a9 00		      lda	#0
   1270  f7b7		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1271  f7b9		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1272  f7bb		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1273  f7bd		       85 0b		      sta	REFP0
   1274  f7bf		       85 0c		      sta	REFP1
