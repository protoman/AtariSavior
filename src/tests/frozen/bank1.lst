   1536  f984		       29 08		      and	#$08
   1537  f986		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1538  f988		       a9 08		      lda	#$08
   1539  f98a		       05 ba		      ora	EnemyDeadMask
