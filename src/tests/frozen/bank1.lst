   1166  f826							; ------------------------------------------------------------------------------
   1167  f826
   1168  f826							; ==============================================================================
   1169  f826							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1170  f826							; ==============================================================================
   1171  f826							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1172  f826							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1173  f826							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1174  f826							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1175  f826							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1176  f826							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1177  f826							; TickCounter — writing that would stall the game timer).
   1178  f826							;
   1179  f826							; User spec 2026-10-18: floats only on water; carries the player across and
   1180  f826							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1181  f826							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1182  f826							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1183  f826							;	       into CollisionX, kernel draws the strip as the band's last
   1184  f826							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1185  f826							;	       row sits exactly on the moving surface — it rides the wave the
   1186  f826							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1187  f826							;	       stays clear of the 125 water-kill line at every tide phase.
   1188  f826							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1189  f826							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1190  f826							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1191  f826							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1192  f826							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1193  f826							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1194  f826							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1195  f826							;	       flag+level, so the empty raft runs at full speed and the next
   1196  f826							;	       take-off ramps again. It also holds the frame it turns around on.
   1197  f826							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1198  f826							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1199  f826							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1200  f826							;	       exactly the open water span of the room.
   1201  f826							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1202  f826							;	       its upper rows; step off and it parks immediately (the ramp state
   1203  f826							;	       is cleared too, so the next take-off ramps again). While over it a
   1204  f826							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1205  f826							;	       zeroed (gravity must never accumulate into the water) and carried
   1206  f826							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1207  f826							;	       flying off is always possible. Leaving and re-entering the ROOM
   1208  f826							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1209  f826							;	       it), which is the "reset" the user asked for.
   1210  f826							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1211  f826							; ==============================================================================
   1212  f826							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1213  f826							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1214  f826							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1215  f826							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1216  f826							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1217  f826							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1218  f826							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1219  f826							;   cols 20-39 -> the mirrored half: source = 39-col
   1220  f826				   RaftCellSolid
   1221  f826		       c9 14		      cmp	#20
   1222  f828		       90 05		      bcc	.RCSrc
   1223  f82a		       49 ff		      eor	#$ff
   1224  f82c		       18		      clc
   1225  f82d		       69 28		      adc	#40
   1226  f82f				   .RCSrc
   1227  f82f		       a8		      tay
   1228  f830		       b9 48 f8 	      lda	RaftCellMasks,Y
   1229  f833		       c0 04		      cpy	#4
   1230  f835		       b0 03		      bcs	.RCPF1
   1231  f837		       25 c5		      and	$C5
   1232  f839		       60		      rts
   1233  f83a				   .RCPF1
   1234  f83a		       c0 0c		      cpy	#12
   1235  f83c		       b0 03		      bcs	.RCPF2
   1236  f83e		       25 c8		      and	$C8
   1237  f840		       60		      rts
   1238  f841				   .RCPF2
   1239  f841		       25 cb		      and	$CB
   1240  f843		       60		      rts
   1241  f844
   1242  f844				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1243  f844		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1244  f848
   1245  f848				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1246  f848		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1247  f84c		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1248  f850		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1249  f854		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1250  f858		       10 20 40 80	      .byte.b	$10, $20, $40, $80
   1251  f85c							; ------------------------------------------------------------------------------
   1252  f85c							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1253  f85c							; verify_build.check_raft_tramp). bank0 executes `sta $1FF7` at $F8C0-$F8C2 and
   1254  f85c							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1255  f85c							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1256  f85c							; `sta $1FF7` is never executed (it is only the swapped-out image's prefix).
   1257  f85c							; In bank1's $F822-$F936 fill, so the $F937 pin does not move.
   1258  f85c							; ------------------------------------------------------------------------------
   1259  f85c		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1260  f8c0		       8d f7 1f 	      .byte.b	$8D, $F7, $1F	; sta $1FF7 (twin)
   1261  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1262  f8c6
   1263  f8c6		       00 00 00 00*	      .ds	$F937 - *, 0	; pinned: bank2 M1StripBlast back-jmp operand
   1264  f937							; ($F937) — test_bomb_strip asserts both literals
   1265  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1266  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1267  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1268  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1269  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1270  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1271  f937							; Every exit ends in ReturnPad with A = count.
   1272  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1273  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1274  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1275  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1276  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1277  f937							; inc the count (caller's +75 loop scores it). The
   1278  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1279  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1280  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1281  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1282  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1283  f937							; ------------------------------------------------------------------------------
   1284  f937				   StripBlastCheck
   1285  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1286  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1287  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1288  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1289  f937							; sets b3/b4 instead.
   1290  f937		       a5 92		      lda	RectCount
   1291  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1292  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1293  f93d		       c5 92		      cmp	RectCount
   1294  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1295  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1296  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1297  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1298  f947		       c9 02		      cmp	#2
   1299  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1300  f94b							;   (A=0/1 falls into take = overlap)
   1301  f94b				   .SBleftTake
   1302  f94b		       a5 ba		      lda	EnemyDeadMask
   1303  f94d		       29 10		      and	#$10
   1304  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1305  f951		       a9 10		      lda	#$10
   1306  f953		       05 ba		      ora	EnemyDeadMask
   1307  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1308  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1309  f959				   .SBright
   1310  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1311  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1312  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1313  f959		       18		      clc
   1314  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1315  f95c		       49 ff		      eor	#$FF
   1316  f95e		       69 28		      adc	#40	; hi_r = 39-lo_l
   1317  f960		       a8		      tay
   1318  f961		       18		      clc
   1319  f962		       a5 8c		      lda	CollisionCellX	; hi_l
   1320  f964		       49 ff		      eor	#$FF
   1321  f966		       69 28		      adc	#40	; lo_r = 39-hi_l
   1322  f968		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1323  f96a		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1324  f96c		       a5 8c		      lda	CollisionCellX	; hi
   1325  f96e		       38		      sec
   1326  f96f		       e5 88		      sbc	BMWScratch	; hi - pL
   1327  f971		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1328  f973		       a5 8e		      lda	CollisionEndX	; lo
   1329  f975		       c5 88		      cmp	BMWScratch
   1330  f977		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1331  f979		       f0 07		      beq	.SBtake	; lo == pL
   1332  f97b		       38		      sec
   1333  f97c		       e9 01		      sbc	#1
   1334  f97e		       c5 88		      cmp	BMWScratch
   1335  f980		       d0 0e		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1336  f982				   .SBtake
   1337  f982		       a5 ba		      lda	EnemyDeadMask
   1338  f984		       29 08		      and	#$08
   1339  f986		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1340  f988		       a9 08		      lda	#$08
   1341  f98a		       05 ba		      ora	EnemyDeadMask
   1342  f98c		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1343  f98e		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1344  f990				   .SBdone
   1345  f990		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1346  f992		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
   1347  f995
   1348  f995		       00 00 00 00*	      .ds	$F9AC - *, 0	; shared cross-bank pad — bank2 carries the
   1349  f9ac							; SAME 12 bytes at $F9AC (identity asserted
   1350  f9ac							; in test_bomb_strip): after `sta $1FF8` the
   1351  f9ac							; NEXT opcode fetch is from the NEW bank at
   1352  f9ac							; pc+3, so both banks must hold the identical
   1353  f9ac							; `jmp` (F6 pad rule — ReturnPad/OverlayTramp
   1354  f9ac							; do the same).
