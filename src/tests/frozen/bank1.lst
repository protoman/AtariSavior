   1462  f937							; ($F937) — test_bomb_strip asserts both literals
   1463  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1464  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1465  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1466  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1467  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1468  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1469  f937							; Every exit ends in ReturnPad with A = count.
   1470  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1471  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1472  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1473  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1474  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1475  f937							; inc the count (caller's +75 loop scores it). The
   1476  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1477  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1478  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1479  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1480  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1481  f937							; ------------------------------------------------------------------------------
   1482  f937				   StripBlastCheck
   1483  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1484  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1485  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1486  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1487  f937							; sets b3/b4 instead.
   1488  f937		       a5 92		      lda	RectCount
   1489  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1490  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1491  f93d		       c5 92		      cmp	RectCount
   1492  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1493  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1494  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1495  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1496  f947		       c9 02		      cmp	#2
   1497  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1498  f94b							;   (A=0/1 falls into take = overlap)
   1499  f94b				   .SBleftTake
   1500  f94b		       a5 ba		      lda	EnemyDeadMask
   1501  f94d		       29 10		      and	#$10
   1502  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1503  f951		       a9 10		      lda	#$10
   1504  f953		       05 ba		      ora	EnemyDeadMask
   1505  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1506  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1507  f959				   .SBright
   1508  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1509  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1510  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1511  f959		       18		      clc
   1512  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1513  f95c		       49 ff		      eor	#$FF
