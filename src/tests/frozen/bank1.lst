   2316  fdce							; scorePtr5 = (ScoreTe >> 4) * 8  (tens digit)
   2317  fdce		       a5 f5		      lda	ScoreTe
   2318  fdd0		       4a		      lsr
   2319  fdd1		       4a		      lsr
   2320  fdd2		       4a		      lsr
   2321  fdd3		       4a		      lsr		; tens digit in low nibble
   2322  fdd4		       0a		      asl
   2323  fdd5		       0a		      asl
   2324  fdd6		       0a		      asl
