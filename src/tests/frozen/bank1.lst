   1534  faa8		       a5 c0		      lda	LaserState
   1535  faaa		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1536  faac		       a5 c2		      lda	EnemyRamP
   1537  faae		       4a		      lsr
   1538  faaf		       4a		      lsr
   1539  fab0		       4a		      lsr		; /8 frames per sweep step
   1540  fab1		       29 07		      and	#7
   1541  fab3		       aa		      tax
   1542  fab4		       bd c4 fa 	      lda	LaserFreqTable,X
   1543  fab7		       85 17		      sta	AUDF0
   1544  fab9		       a9 02		      lda	#LASER_AUD_C
   1545  fabb		       85 15		      sta	AUDC0
   1546  fabd		       a9 09		      lda	#LASER_AUD_V
   1547  fabf		       85 19		      sta	AUDV0
