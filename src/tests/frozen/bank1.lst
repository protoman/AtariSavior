   1743  fa6b							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1744  fa6b							; Score = THREE packed-BCD bytes, 6 digits, max 999,999 (user 2026-10-27; it was
   1745  fa6b							; one binary thousands digit = 9,999, and level 1 alone is worth ~1,200):
   1746  fa6b							;   ScoreTe = tens|ones   ScoreHu = thousands|hundreds   ScoreTh = 100k|10k
   1747  fa6b							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1748  fa6b							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1749  fa6b							; (the 2026-09-23 decimal-mode rule). The old BINARY fix-up missed nibble-level
   1750  fa6b							; overflow: $25+$75 = $9A stored raw -> glyph index 10 -> the solid-block score
   1751  fa6b							; digit (screenshots/score_issue_002.png).
   1752  fa6b							; A carry out of ScoreTe (>= 100 points) is rare, so it jumps to AddScoreCarry
   1753  fa6b							; (in the $FABB fill) which ripples it up and awards the EXTRA LIFE.
   1754  fa6b							; SIZE PIN: routine runs exactly 40 bytes (UpdateLaserSound's pad target follows).
   1755  fa6b				   AddScore
   1756  fa6b		       f8		      sed
   1757  fa6c		       18		      clc
   1758  fa6d		       65 f5		      adc	ScoreTe
   1759  fa6f		       85 f5		      sta	ScoreTe
   1760  fa71		       90 03		      bcc	.ASdone	; the common case: no carry out of tens/ones
   1761  fa73		       4c bb fa 	      jmp	AddScoreCarry	; D is still set here, C = 1
   1762  fa76				   .ASdone
   1763  fa76		       d8		      cld
   1764  fa77		       4c f8 fb 	      jmp	ReturnPad
   1765  fa7a		       ea ea ea ea*	      .ds	AddScore + 40 - *, $EA	; byte-pin (see SIZE PIN above)
   1766  fa93
   1767  fa93							; UpdateLaserSound — low "zoom" tone on channel 0 while fire is held.
   1768  fa93							; Call order in bank0 overscan: UpdateBombSound, UpdateJetSound, this — so
   1769  fa93							; AUDV0 is already forced to 0 by UpdateBombSound when BombSnd = 0, which is
   1770  fa93							; exactly what silence-on-release needs (this routine then does nothing).
   1771  fa93							; Bomb events own ch0 (BombSnd > 0 -> skip) so blip/explosion stay audible.
   1772  fa93							; Pitch sweeps AUDF 4..14 on the free-running frame clock: AUDC=2 divides by
   1773  fa93							; 15, so f = 31400/((AUDF+1)*15) = 419..140 Hz (low). Triangle, 8 steps x
   1774  fa93							; 8 frames = 1.07 s per cycle, no audible wrap jump.
   1775  fa93							; Clobbers A/X; Y preserved. No ZP writes.
   1776  fa93				   UpdateLaserSound
   1777  fa93		       a5 f1		      lda	BombSnd
   1778  fa95		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1779  fa97		       a5 c0		      lda	LaserState
   1780  fa99		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1781  fa9b		       a5 c2		      lda	EnemyRamP
   1782  fa9d		       4a		      lsr
   1783  fa9e		       4a		      lsr
   1784  fa9f		       4a		      lsr		; /8 frames per sweep step
   1785  faa0		       29 07		      and	#7
