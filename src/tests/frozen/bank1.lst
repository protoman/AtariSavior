   1989  fbda							; ========================================================================
   1990  fbda							; Cross-bank call pads — 2026-10-20 (chunk 4): SPLIT across the banks, no
   1991  fbda							; twin. kernel.asm holds the eleven `sta $1FFx` halves compactly at
   1992  fbda							; $FBFC..$FC1C; after the switch the fetch at A+3 lands HERE, so this bank
   1993  fbda							; keeps only the `jmp` halves (at A+3, i.e. $FBFF onward). The reverse halves
   1994  fbda							; were dead bytes: no bank1/bank2/bank3 code calls a CallPad (guard:
   1995  fbda							; verify_build.check_callpads rejects any `jsr/jmp CallPad_*` outside
   1996  fbda							; kernel.asm). F6 hotspot ignores the written value, so a pad still passes
   1997  fbda							; A/X/Y/flags through untouched (`sta` affects no flag).
   1998  fbda							;   $FBFF <-$FBFC+3 UpdateBombSound	  $FC0E <-$FC0B+3 AddScore
   1999  fbda							;   $FC02 <-$FBFF+3 UpdateJetSound	  $FC11 <-$FC0E+3 IsRoomDark
   2000  fbda							;   $FC05 <-$FC02+3 BombSndDrop	  $FC14 <-$FC11+3 SetRoomDark
   2001  fbda							;   $FC08 <-$FC05+3 BombSndExplode	  $FC17 <-$FC14+3 UpdateLaserSound
   2002  fbda							;   ($FC0B retired by C3)		 $FC1D <-$FC1A+3 BombMarkWalls
   2003  fbda							; $FC1A (BuildColupF's +3) belongs to BANK3 — its pad is `sta $1FF7`.
   2004  fbda							; ========================================================================
   2005  fbda		       00 00 00 00*	      .ds	$FBF8 - *, 0
   2006  fbf8				   ReturnPad
   2007  fbf8		       8d f4 1f 	      sta	$1FF4	; the `rts` at $FBFB is served by bank0
   2008  fbfb		       00 00 00 00	      .ds	$FBFF - *, 0
   2009  fbff		       4c c0 f9 	      jmp	UpdateBombSound
   2010  fc02		       4c cf f9 	      jmp	UpdateJetSound
   2011  fc05		       4c 00 fa 	      jmp	BombSndDrop
   2012  fc08		       4c 13 fa 	      jmp	BombSndExplode
   2013  fc0b		       00 00 00 	      .byte.b	0,0,0	; $FC0B: GetConnIdx's half, retired by C3
   2014  fc0e		       4c 6b fa 	      jmp	AddScore	; label, not the literal: bank1 shifts move it
   2015  fc11		       4c 78 fc 	      jmp	IsRoomDark
   2016  fc14		       4c 9e fc 	      jmp	SetRoomDark
   2017  fc17		       4c 93 fa 	      jmp	UpdateLaserSound	; label, not the literal (bank1 shifts)
   2018  fc1a		       00 00 00 	      .ds	$FC1D - *, 0	; ($FC1A is bank3's BuildColupF image)
   2019  fc1d		       4c 10 fb 	      jmp	BombMarkWalls	; S5.2: body lives in bank1 ($FB10)
   2020  fc20
   2021  fc20							; CallPad tail pads (2026-10-20: SPLIT across the banks, no twin). kernel.asm
   2022  fc20							; holds the three `sta $1FF5` at $FC4F/$FC52/$FC55; after the switch the fetch
   2023  fc20							; at A+3 lands HERE, so bank1 keeps only the `jmp` halves. Nothing calls a
   2024  fc20							; tail pad from bank1, so bank1's `sta` halves and bank0's `jmp` halves were
   2025  fc20							; dead bytes — reclaiming them gave bank0 15 B of pre-pad headroom.
   2026  fc20							;   $FC52 <-$FC4F+3 CallPad_TitleSelect
   2027  fc20							;   $FC55 <-$FC52+3 CallPad_TitleBand
   2028  fc20							;   $FC58 <-$FC55+3 CallPad_MusicTick
   2029  fc20							; Guard: verify_build.check_callpads (per-pad A / A+3 contract).
   2030  fc20		       00 00 00 00*	      .ds	$FC52 - *, 0
   2031  fc52		       4c 50 f0 	      jmp	TitleSelect
   2032  fc55					      .ds	$FC55 - *, 0
   2033  fc55		       4c 80 f0 	      jmp	$F080	; TitleBand
   2034  fc58					      .ds	$FC58 - *, 0
   2035  fc58		       4c 5a f3 	      jmp	MusicTick
