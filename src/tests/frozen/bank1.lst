   1244  f778							; white ghost copies during the positioning scanlines.
   1245  f778		       a9 00		      lda	#0
   1246  f77a		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1247  f77c		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1248  f77e		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1249  f780		       85 0b		      sta	REFP0
   1250  f782		       85 0c		      sta	REFP1
