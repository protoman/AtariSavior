   1662  fa93							; UpdateLaserSound — low "zoom" tone on channel 0 while fire is held.
   1663  fa93							; Call order in bank0 overscan: UpdateBombSound, UpdateJetSound, this — so
   1664  fa93							; AUDV0 is already forced to 0 by UpdateBombSound when BombSnd = 0, which is
   1665  fa93							; exactly what silence-on-release needs (this routine then does nothing).
   1666  fa93							; Bomb events own ch0 (BombSnd > 0 -> skip) so blip/explosion stay audible.
   1667  fa93							; Pitch sweeps AUDF 4..14 on the free-running frame clock: AUDC=2 divides by
   1668  fa93							; 15, so f = 31400/((AUDF+1)*15) = 419..140 Hz (low). Triangle, 8 steps x
   1669  fa93							; 8 frames = 1.07 s per cycle, no audible wrap jump.
   1670  fa93							; Clobbers A/X; Y preserved. No ZP writes.
   1671  fa93				   UpdateLaserSound
   1672  fa93		       a5 f1		      lda	BombSnd
   1673  fa95		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1674  fa97		       a5 c0		      lda	LaserState
   1675  fa99		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1676  fa9b		       a5 c2		      lda	EnemyRamP
   1677  fa9d		       4a		      lsr
   1678  fa9e		       4a		      lsr
   1679  fa9f		       4a		      lsr		; /8 frames per sweep step
   1680  faa0		       29 07		      and	#7
   1681  faa2		       aa		      tax
