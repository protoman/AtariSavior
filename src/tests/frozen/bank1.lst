    152  f071		       00 00 00 00*	      .ds	$F080 - *, 0	; TitleBand pin (CallPad_TitleBand literal)
    153  f080							; ==============================================================================
    154  f080							; TitleBand — merged title, bands 1-3 (N=4 layout, 2026-10-24).
    155  f080							; Band 0 is drawn by the CAVE kernel (stage PF + COLUPF from the room buffers,
    156  f080							; player via PlayerColTable/Grp0Ptr), so the title reuses the real kernel
    157  f080							; instead of duplicating its band rendering. The bank0 row-advance tail
    158  f080							; diverts here when DropTarget=$FF, exactly where band 1 would start.
    159  f080							; This routine: band 1 = stage row 1 (PREVIEW ONLY), band 2 = the TITLE PAD
    160  f080							; (playfield blanked, 48px S.A.V.I.O.R. logo + credit footer), band 3 = stage
    161  f080							; row 3, then the HUD band (score = level+1, lives/bombs/bar via MenuMain).
    162  f080							; Why the split (user ruling 2026-10-24): with 36-line bands the text no longer
    163  f080							; fitted under the player inside band 1 — the miner (band 0, Y 24..35) ran
    164  f080							; straight into the logo. Preview up top, text one band lower, keeps the two
    165  f080							; cleanly apart. No object is drawn on the title: DropArm .DATitle clears
    166  f080							; EnemyCount/LevelMinerRoom and the laser on every title LoadLevel, so
    167  f080							; SelectActiveObject parks GRP1.
    168  f080							; Entered via CallPad_TitleBand ($FC55). ZP: LineCount ($84) + Temp ($88) as
    169  f080							; loop counter/tmp — idle on title frames (cave overscan bypassed).
    170  f080							; ==============================================================================
    171  f080				   TitleBand
    172  f080							; ==================================================================
    173  f080							; Band 1 (36 lines): stage middle row — PREVIEW ONLY, no text.
    174  f080							; Same store order as the cave .Row (PF0, PF1, COLUPF, ENABL, PF2 last)
    175  f080							; so the band-transition line keeps the left half on band 0.
    176  f080							; ==================================================================
    177  f080							; Cave band 0 leaves the missiles latched (the .AfterRows clear is
    178  f080							; skipped on the title) and may leave the player's last GRP row live:
    179  f080							; clear GRP with VDEL OFF first (a GRP write while VDELP=1 only reaches
    180  f080							; the delayed slot — AGENTS "VDEL stale live-slot"). The missiles STAY
    181  f080							; on: band 1 is a real room preview, so a latched M1 strip is the room's
    182  f080							; own geometry (band 2 clears it before the 48px text).
    183  f080		       a9 00		      lda	#0
    184  f082		       85 25		      sta	VDELP0
    185  f084		       85 26		      sta	VDELP1
    186  f086		       85 1b		      sta	GRP0
    187  f088		       85 1c		      sta	GRP1
    188  f08a		       a5 c4		      lda	PF0Buf+1
    189  f08c		       85 0d		      sta	PF0
    190  f08e		       a5 c8		      lda	PF1Buf+1
    191  f090		       85 0e		      sta	PF1
    192  f092		       a5 d4		      lda	ColupfBuf+1
    193  f094		       85 08		      sta	COLUPF
    194  f096		       a5 d0		      lda	BandTab+1
    195  f098		       85 1f		      sta	ENABL
    196  f09a		       a5 cc		      lda	PF2Buf+1
    197  f09c		       85 0f		      sta	PF2
    198  f09e		       a2 24		      ldx	#36
    199  f0a0				   .TkB1Bl
    200  f0a0		       85 02		      sta	WSYNC
    201  f0a2		       ca		      dex
    202  f0a3		       d0 fb		      bne	.TkB1Bl
