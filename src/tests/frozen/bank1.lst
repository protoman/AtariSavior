   1124  f7fb		       e9 0f		      sbc	#15
   1125  f7fd		       b0 fc		      bcs	.Div15Loop
   1126  f7ff		       a8		      tay
   1127  f800		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1128  f803		       95 20		      sta	HMP0,X
   1129  f805		       95 10		      sta	RESP0,X
   1130  f807		       60		      rts
