   2388  fe2b							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2389  fe2b							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2390  fe2b							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2391  fe2b							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2392  fe2b							; it cannot borrow upward either (see the kernel EQU for the contract).
   2393  fe2b							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2394  fe2b							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2395  fe2b							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2396  fe2b		       a5 f0		      lda	$F0
   2397  fe2d		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2398  fe2f		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2399  fe31		       f0 04		      beq	.RaftAtSpeed
   2400  fe33		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2401  fe35		       d0 07		      bne	.RaftHaveStep	; always
