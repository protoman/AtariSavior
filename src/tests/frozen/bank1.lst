   2201  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2202  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2203  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2204  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2205  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2206  fd68							; once per banner frame. Lives with the glyphs (bank1's pre-pad region is
   2207  fd68							; tight; the score section is a jsr here from MenuMain).
   2208  fd68				   SetupScorePointers
   2209  fd68							; --- Initialize score to 0 on first frame ---
   2210  fd68		       a5 ad		      lda	Temp
   2211  fd6a		       d0 0c		      bne	.scoreInitDone
   2212  fd6c		       e6 ad		      inc	Temp
   2213  fd6e		       a9 00		      lda	#0
   2214  fd70		       85 f3		      sta	ScoreTh
   2215  fd72		       85 f4		      sta	ScoreHu
   2216  fd74		       a9 00		      lda	#$00
   2217  fd76		       85 f5		      sta	ScoreTe
   2218  fd78				   .scoreInitDone
   2219  fd78
   2220  fd78							; --- Set up 6 digit pointers ---
   2221  fd78							; High bytes first (all $FD)
