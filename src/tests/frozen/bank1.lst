   1408  f875							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1409  f875							; ==============================================================================
   1410  f875							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF5 / jmp $F822) -> here;
   1411  f875							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1412  f875							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1413  f875							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1414  f875							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1415  f875							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1416  f875							; TickCounter — writing that would stall the game timer).
   1417  f875							;
   1418  f875							; User spec 2026-10-18: floats only on water; carries the player across and
   1419  f875							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1420  f875							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1421  f875							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1422  f875							;	       into CollisionX, kernel draws the strip as the band's last
   1423  f875							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1424  f875							;	       row sits exactly on the moving surface — it rides the wave the
   1425  f875							;	       water does. The rider's pin (top-22 = 103+off, worst case 106)
   1426  f875							;	       stays clear of the 125 water-kill line at every tide phase.
   1427  f875							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1428  f875							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1429  f875							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1430  f875							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1431  f875							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1432  f875							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1433  f875							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1434  f875							;	       flag+level, so the empty raft runs at full speed and the next
   1435  f875							;	       take-off ramps again. It also holds the frame it turns around on.
   1436  f875							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1437  f875							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1438  f875							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1439  f875							;	       exactly the open water span of the room.
   1440  f875							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1441  f875							;	       its upper rows; step off and it parks immediately (the ramp state
   1442  f875							;	       is cleared too, so the next take-off ramps again). While over it a
   1443  f875							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1444  f875							;	       zeroed (gravity must never accumulate into the water) and carried
   1445  f875							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1446  f875							;	       flying off is always possible. Leaving and re-entering the ROOM
   1447  f875							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1448  f875							;	       it), which is the "reset" the user asked for.
   1449  f875							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1450  f875							; ==============================================================================
   1451  f875							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1452  f875							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1453  f875							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1454  f875							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1455  f875							;   cols 0-3	-> PF0 row 3 ($C6), bit 4+col (PF0 bit 4 = leftmost pixel)
   1456  f875							;   cols 4-11	-> PF1 row 3 ($CA), bit 7-(col-4)
   1457  f875							;   cols 12-19 -> PF2 row 3 ($CE), bit col-12
   1458  f875							; (row 3 = the bottom/water band of a 4-band room. These read $C5/$C8/$CB, the
   1459  f875							; rows of the old 3-band stride-3 layout, until 2026-10-28: the raft then turned
   1460  f875							; at ceiling/ledge cells that were not on its water row.)
   1461  f875							;   cols 20-39 -> the mirrored half: source = 39-col
   1462  f875				   RaftCellSolid
   1463  f875		       c9 14		      cmp	#20
   1464  f877		       90 05		      bcc	.RCSrc
   1465  f879		       49 ff		      eor	#$ff
   1466  f87b		       18		      clc
   1467  f87c		       69 28		      adc	#40
   1468  f87e				   .RCSrc
   1469  f87e		       a8		      tay
   1470  f87f		       b9 97 f8 	      lda	RaftCellMasks,Y
   1471  f882		       c0 04		      cpy	#4
   1472  f884		       b0 03		      bcs	.RCPF1
   1473  f886		       25 c6		      and	$C6	; PF0Buf+3: the water row (4 bands; was +2 = band 3)
   1474  f888		       60		      rts
   1475  f889				   .RCPF1
   1476  f889		       c0 0c		      cpy	#12
   1477  f88b		       b0 03		      bcs	.RCPF2
   1478  f88d		       25 ca		      and	$CA	; PF1Buf+3 (stride 4; $C8 was row 1)
   1479  f88f		       60		      rts
   1480  f890				   .RCPF2
   1481  f890		       25 ce		      and	$CE	; PF2Buf+3 (stride 4; $CB was row 0)
   1482  f892		       60		      rts
   1483  f893
   1484  f893				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1485  f893		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1486  f897
   1487  f897				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1488  f897		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1489  f89b		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1490  f89f		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1491  f8a3		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1492  f8a7		       10 20 40 80	      .byte.b	$10, $20, $40, $80
   1493  f8ab							; ------------------------------------------------------------------------------
   1494  f8ab							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1495  f8ab							; verify_build.check_raft_tramp). bank0 executes `sta $1FF5` at $F8C0-$F8C2 and
   1496  f8ab							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1497  f8ab							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1498  f8ab							; `sta $1FF5` is never executed (it is only the swapped-out image's prefix).
   1499  f8ab							; In bank1's $F822-$F8C6 fill; StripBlastCheck follows it directly ($F937 pin
   1500  f8ab							; deleted 2026-10-20 — the body floats and the $F9AC pin bounds the leaves).
   1501  f8ab							; ------------------------------------------------------------------------------
   1502  f8ab		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1503  f8c0		       8d f5 1f 	      .byte.b	$8D, $F5, $1F	; sta $1FF5 (twin)
   1504  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1505  f8c6
   1506  f8c6							; ($F937 pin DELETED 2026-10-20, audit round 2: it pinned bank2's
   1507  f8c6							;  M1StripBlast back-jmp operand, and that body is same-bank now — the chain
   1508  f8c6							;  is .BMWDone -> M1StripBlast -> StripBlastCheck inside bank1, so
   1509  f8c6							;  StripBlastCheck is reached by label and floats. It now starts right after
   1510  f8c6							;  the raft tramp twin; the $F9AC pin still bounds the sound-leaf block.)
   1511  f8c6							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1512  f8c6							; from BombMarkWalls .BMWDone through M1StripBlast (same bank, label `jmp`s
   1513  f8c6							; — repack chunk 2; 0 pushes, no switch). Still 0 pushes (the jsr+pha
   1514  f8c6							; version measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1515  f8c6							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1516  f8c6							; Every exit ends in ReturnPad with A = count.
   1517  f8c6							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1518  f8c6							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1519  f8c6							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1520  f8c6							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1521  f8c6							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1522  f8c6							; inc the count (caller's +75 loop scores it). The
   1523  f8c6							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1524  f8c6							; lifecycle as WallMask holes (D1-B). P2b door models never
   1525  f8c6							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1526  f8c6							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1527  f8c6							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1528  f8c6							; ------------------------------------------------------------------------------
   1529  f8c6				   StripBlastCheck
   1530  f8c6							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1531  f8c6							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1532  f8c6							; Window is still LEFT-half here (the mirror below). Door models stage
   1533  f8c6							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1534  f8c6							; sets b3/b4 instead.
   1535  f8c6		       a5 92		      lda	RectCount
   1536  f8c8		       30 28		      bmi	.SBright	; $FF → no left strip this frame
   1537  f8ca		       a5 8c		      lda	CollisionCellX	; blast hi
   1538  f8cc		       c5 92		      cmp	RectCount
   1539  f8ce		       90 22		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1540  f8d0		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1541  f8d2		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1542  f8d4		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1543  f8d6		       c9 02		      cmp	#2
   1544  f8d8		       b0 18		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1545  f8da							;   (A=0/1 falls into take = overlap)
   1546  f8da				   .SBleftTake
   1547  f8da		       a5 92		      lda	RectCount
   1548  f8dc		       d0 06		      bne	.SBlOk	; an interior strip is a designed block: bombable
   1549  f8de		       a5 db		      lda	RoomExits	; the EDGE strip (dcol 0) is the dead-side plug
   1550  f8e0		       29 02		      and	#2
   1551  f8e2		       d0 0e		      bne	.SBright	;   (no room to the WEST): unbreakable
   1552  f8e4				   .SBlOk
   1553  f8e4		       a5 ba		      lda	EnemyDeadMask
   1554  f8e6		       29 10		      and	#$10
   1555  f8e8		       d0 08		      bne	.SBright	; already destroyed → no double score
   1556  f8ea		       a9 10		      lda	#$10
   1557  f8ec		       05 ba		      ora	EnemyDeadMask
   1558  f8ee		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1559  f8f0		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1560  f8f2				   .SBright
   1561  f8f2							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1562  f8f2							; window here (space is free in this gap): lo_r = 39-hi_l,
   1563  f8f2							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1564  f8f2		       18		      clc
   1565  f8f3		       a5 8e		      lda	CollisionEndX	; lo_l
   1566  f8f5		       49 ff		      eor	#$FF
   1567  f8f7		       69 28		      adc	#40	; hi_r = 39-lo_l
   1568  f8f9		       a8		      tay
   1569  f8fa		       18		      clc
   1570  f8fb		       a5 8c		      lda	CollisionCellX	; hi_l
   1571  f8fd		       49 ff		      eor	#$FF
   1572  f8ff		       69 28		      adc	#40	; lo_r = 39-hi_l
   1573  f901		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1574  f903		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1575  f905		       a5 8c		      lda	CollisionCellX	; hi
   1576  f907		       38		      sec
   1577  f908		       e5 88		      sbc	BMWScratch	; hi - pL
   1578  f90a		       90 29		      bcc	.SBdone	; hi < pL → strip right of the blast
   1579  f90c		       a5 8e		      lda	CollisionEndX	; lo
   1580  f90e		       c5 88		      cmp	BMWScratch
   1581  f910		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1582  f912		       f0 07		      beq	.SBtake	; lo == pL
   1583  f914		       38		      sec
   1584  f915		       e9 01		      sbc	#1
   1585  f917		       c5 88		      cmp	BMWScratch
   1586  f919		       d0 1a		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1587  f91b				   .SBtake
   1588  f91b		       a5 88		      lda	BMWScratch
   1589  f91d		       c9 26		      cmp	#38
   1590  f91f		       d0 06		      bne	.SBrOk	; an interior strip is a designed block: bombable
   1591  f921		       a5 db		      lda	RoomExits	; the EDGE strip (pL 38 = right_col 9) is the plug
   1592  f923		       29 01		      and	#1
   1593  f925		       d0 0e		      bne	.SBdone	;   (no room to the EAST): unbreakable
   1594  f927				   .SBrOk
   1595  f927		       a5 ba		      lda	EnemyDeadMask
   1596  f929		       29 08		      and	#$08
   1597  f92b		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1598  f92d		       a9 08		      lda	#$08
   1599  f92f		       05 ba		      ora	EnemyDeadMask
   1600  f931		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1601  f933		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1602  f935				   .SBdone
   1603  f935		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1604  f937		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
