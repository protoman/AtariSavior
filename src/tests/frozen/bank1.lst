   1181  f7a4							; ====================================================================
   1182  f7a4							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1183  f7a4							; Proven kernel from score48pix.asm
   1184  f7a4							; ====================================================================
   1185  f7a4		       a0 07		      ldy	#7
   1186  f7a6		       84 ec		      sty	scbrdCnt
   1187  f7a8				   .ScoreLoop
   1188  f7a8		       a4 ec		      ldy	<scbrdCnt	; 3c
   1189  f7aa		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1190  f7ac		       aa		      tax		; 2c — cache in X
   1191  f7ad		       85 02		      sta	WSYNC	; 3c
   1192  f7af		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1193  f7b1		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1194  f7b4		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1195  f7b6		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1196  f7b8		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1197  f7ba		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1198  f7bc		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1199  f7be		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1200  f7c0		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1201  f7c2		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1202  f7c4		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1203  f7c6		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1204  f7c8		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1205  f7ca		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1206  f7cc		       c6 ec		      dec	<scbrdCnt	; 5c
   1207  f7ce		       d0 d8		      bne	.ScoreLoop	; 3c
   1208  f7d0
   1209  f7d0							; --- Cleanup ---
   1210  f7d0		       a9 00		      lda	#0
   1211  f7d2		       85 1b		      sta	GRP0
   1212  f7d4		       85 1c		      sta	GRP1
   1213  f7d6		       85 04		      sta	NUSIZ0
   1214  f7d8		       85 05		      sta	NUSIZ1
   1215  f7da		       85 25		      sta	VDELP0
   1216  f7dc		       85 26		      sta	VDELP1
   1217  f7de
   1218  f7de							; --- Restore cave kernel settings ---
   1219  f7de		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + 8-clk ball (cave mode
   1220  f7e0							; since D6 — bank1 bar overwrote $05 during its band)
   1221  f7e0		       85 0a		      sta	CTRLPF
   1222  f7e2		       a9 00		      lda	#0
   1223  f7e4		       85 04		      sta	NUSIZ0
   1224  f7e6		       a9 00		      lda	#0
   1225  f7e8		       85 05		      sta	NUSIZ1
   1226  f7ea		       85 25		      sta	VDELP0
   1227  f7ec		       85 26		      sta	VDELP1
