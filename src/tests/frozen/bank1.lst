   2013  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2014  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2015  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2016  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2017  fc78							; survives the cross-bank return.
   2018  fc78				   IsRoomDark
   2019  fc78		       a5 98		      lda	RoomNo
   2020  fc7a		       c9 04		      cmp	#4
   2021  fc7c		       b0 0c		      bcs	.IRDhi
   2022  fc7e		       18		      clc
   2023  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2024  fc81		       aa		      tax
   2025  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2026  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2027  fc87		       4c f8 fb 	      jmp	ReturnPad
   2028  fc8a				   .IRDhi
   2029  fc8a		       c9 08		      cmp	#8
   2030  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2031  fc8e		       aa		      tax
   2032  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2033  fc92		       4a		      lsr
   2034  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2035  fc94		       25 c0		      and	LaserState
   2036  fc96		       4c f8 fb 	      jmp	ReturnPad
   2037  fc99				   .IRDlit
   2038  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2039  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2040  fc9e
