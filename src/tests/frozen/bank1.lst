   2441  fe72		       38		      sec
   2442  fe73		       e5 88		      sbc	$88
   2443  fe75		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2444  fe77		       c9 08		      cmp	#RAFT_MIN_X
   2445  fe79		       90 eb		      bcc	.RaftTurn	; left rail
