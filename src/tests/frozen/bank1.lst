   2412  fe2b							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2413  fe2b							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2414  fe2b							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2415  fe2b							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2416  fe2b							; it cannot borrow upward either (see the kernel EQU for the contract).
   2417  fe2b							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2418  fe2b							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2419  fe2b							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2420  fe2b		       a5 f0		      lda	$F0
   2421  fe2d		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2422  fe2f		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2423  fe31		       f0 04		      beq	.RaftAtSpeed
   2424  fe33		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2425  fe35		       d0 07		      bne	.RaftHaveStep	; always
   2426  fe37				   .RaftAtSpeed
   2427  fe37		       a5 c2		      lda	EnemyRamP
   2428  fe39		       29 01		      and	#1
   2429  fe3b		       18		      clc
   2430  fe3c		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2431  fe3e				   .RaftHaveStep
   2432  fe3e		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2433  fe40		       bd 44 f8 	      lda	RaftBitTab,X
   2434  fe43		       25 c1		      and	EnemyRamD
   2435  fe45		       f0 29		      beq	.RaftLeft
   2436  fe47							; ---- leading edge right: candidate = x + step ---------------------------
   2437  fe47		       b5 bd		      lda	EnemyRamX,X
   2438  fe49		       18		      clc
   2439  fe4a		       65 88		      adc	$88
   2440  fe4c		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2441  fe4e		       c9 94		      cmp	#RAFT_MAX_X
   2442  fe50		       b0 14		      bcs	.RaftTurn	; right rail
   2443  fe52		       18		      clc
   2444  fe53		       69 01		      adc	#1	; the cell just beyond the right edge
   2445  fe55		       4a		      lsr
   2446  fe56		       4a		      lsr
   2447  fe57		       20 26 f8 	      jsr	RaftCellSolid
   2448  fe5a		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2449  fe5c		       b5 bd		      lda	EnemyRamX,X
   2450  fe5e		       18		      clc
   2451  fe5f		       65 88		      adc	$88
   2452  fe61		       95 bd		      sta	EnemyRamX,X
   2453  fe63		       4c 90 fe 	      jmp	.RaftRide
