   2022  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2023  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2024  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2025  fc78							; survives the cross-bank return.
   2026  fc78				   IsRoomDark
   2027  fc78		       a5 98		      lda	RoomNo
   2028  fc7a		       c9 04		      cmp	#4
   2029  fc7c		       b0 0c		      bcs	.IRDhi
   2030  fc7e		       18		      clc
   2031  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2032  fc81		       aa		      tax
   2033  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2034  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2035  fc87		       4c f8 fb 	      jmp	ReturnPad
   2036  fc8a				   .IRDhi
   2037  fc8a		       c9 08		      cmp	#8
   2038  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2039  fc8e		       aa		      tax
   2040  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2041  fc92		       4a		      lsr
   2042  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2043  fc94		       25 c0		      and	LaserState
   2044  fc96		       4c f8 fb 	      jmp	ReturnPad
   2045  fc99				   .IRDlit
   2046  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2047  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2048  fc9e
   2049  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2050  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2051  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2052  fc9e				   SetRoomDark
   2053  fc9e		       a5 98		      lda	RoomNo
   2054  fca0		       c9 04		      cmp	#4
   2055  fca2		       b0 0e		      bcs	.SRDhi
   2056  fca4		       18		      clc
   2057  fca5		       69 04		      adc	#4
   2058  fca7		       aa		      tax
   2059  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2060  fcab		       05 c1		      ora	EnemyRamD
   2061  fcad		       85 c1		      sta	EnemyRamD
   2062  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2063  fcb2				   .SRDhi
   2064  fcb2		       c9 08		      cmp	#8
   2065  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2066  fcb6		       aa		      tax
   2067  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2068  fcba		       4a		      lsr
   2069  fcbb		       4a		      lsr
   2070  fcbc		       05 c0		      ora	LaserState
   2071  fcbe		       85 c0		      sta	LaserState
   2072  fcc0				   .SRDdone
   2073  fcc0		       4c f8 fb 	      jmp	ReturnPad
