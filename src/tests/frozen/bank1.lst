   1481  f893		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1482  f897
   1483  f897				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1484  f897		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1485  f89b		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1486  f89f		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1487  f8a3		       01 02 04 08	      .byte.b	$01, $02, $04, $08
