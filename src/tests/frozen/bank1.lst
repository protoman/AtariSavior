   1661  faa4							; UpdateLaserSound — low "zoom" tone on channel 0 while fire is held.
   1662  faa4							; Call order in bank0 overscan: UpdateBombSound, UpdateJetSound, this — so
   1663  faa4							; AUDV0 is already forced to 0 by UpdateBombSound when BombSnd = 0, which is
   1664  faa4							; exactly what silence-on-release needs (this routine then does nothing).
   1665  faa4							; Bomb events own ch0 (BombSnd > 0 -> skip) so blip/explosion stay audible.
   1666  faa4							; Pitch sweeps AUDF 4..14 on the free-running frame clock: AUDC=2 divides by
   1667  faa4							; 15, so f = 31400/((AUDF+1)*15) = 419..140 Hz (low). Triangle, 8 steps x
   1668  faa4							; 8 frames = 1.07 s per cycle, no audible wrap jump.
   1669  faa4							; Clobbers A/X; Y preserved. No ZP writes.
   1670  faa4				   UpdateLaserSound
   1671  faa4		       a5 f1		      lda	BombSnd
   1672  faa6		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1673  faa8		       a5 c0		      lda	LaserState
   1674  faaa		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1675  faac		       a5 c2		      lda	EnemyRamP
   1676  faae		       4a		      lsr
   1677  faaf		       4a		      lsr
   1678  fab0		       4a		      lsr		; /8 frames per sweep step
   1679  fab1		       29 07		      and	#7
