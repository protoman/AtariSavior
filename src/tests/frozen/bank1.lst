    528  f41f							; ------------------------------------------------------------------------------
    529  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    530  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    531  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    532  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    533  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    534  f41f							; Staging contract (both scratch bytes free in this flow):
    535  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    536  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    537  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    538  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    539  f41f							; ------------------------------------------------------------------------------
    540  f41f				   M1StripBlast
    541  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    542  f421		       c9 14		      cmp	#20
    543  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    544  f425		       a5 ba		      lda	EnemyDeadMask
    545  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    546  f429		       d0 15		      bne	.M1SBnone
    547  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    548  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    549  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    550  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    551  f433		       4a		      lsr
    552  f434		       4a		      lsr
    553  f435		       4a		      lsr
    554  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    555  f437							;   high end — StripBlastCheck rejects)
    556  f437		       38		      sec
    557  f438		       e9 01		      sbc	#1	; ℓ = left_col
    558  f43a		       0a		      asl		; 2ℓ = strip left dcol
    559  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    560  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    561  f440				   .M1SBnone
    562  f440		       a9 ff		      lda	#$FF
    563  f442		       85 92		      sta	RectCount	; no left strip this frame
    564  f444				   .M1SBdoorR
    565  f444		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
    566  f446		       10 04		      bpl	.M1SBout
    567  f448		       a0 ff		      ldy	#$FF
    568  f44a		       84 88		      sty	BMWScratch	; $88 = StripBlastCheck's "no strip"
    569  f44c				   .M1SBout
    570  f44c		       4c c6 f8 	      jmp	StripBlastCheck	; same bank now (was the $F9B2 pad)
    571  f44f
    572  f44f							; ------------------------------------------------------------------------------
    573  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    574  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    575  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    576  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    577  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    578  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    579  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    580  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    581  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    582  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    583  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    584  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    585  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    586  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    587  f44f							; ------------------------------------------------------------------------------
    588  f44f				   TallyEntry
    589  f44f		       a5 8a		      lda	DropTarget
    590  f451		       f0 36		      beq	.TEArm
    591  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    592  f455		       d0 2d		      bne	.TEIdle
    593  f457		       a9 04		      lda	#4
    594  f459		       85 ad		      sta	TickCounter
    595  f45b		       c6 f2		      dec	TallyTicks
    596  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    597  f45f		       a5 f2		      lda	TallyTicks
    598  f461		       29 03		      and	#3
    599  f463		       d0 15		      bne	.TEOne	; tick only
    600  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    601  f467		       85 f1		      sta	BombSnd
    602  f469		       a9 04		      lda	#4
    603  f46b		       85 15		      sta	AUDC0	; square
    604  f46d		       a9 18		      lda	#24
    605  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    606  f471		       a9 08		      lda	#8
    607  f473		       85 19		      sta	AUDV0
    608  f475		       a9 03		      lda	#3	; tick + coin
    609  f477		       4c f8 fb 	      jmp	ReturnPad
    610  f47a				   .TEOne
    611  f47a		       a9 01		      lda	#1	; tick only
    612  f47c		       4c f8 fb 	      jmp	ReturnPad
    613  f47f				   .TEFinal
    614  f47f		       a9 07		      lda	#7	; tick + coin + done
    615  f481		       4c f8 fb 	      jmp	ReturnPad
    616  f484				   .TEIdle
    617  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    618  f486		       4c f8 fb 	      jmp	ReturnPad
    619  f489				   .TEArm
    620  f489		       a5 ae		      lda	BarLevel
    621  f48b		       18		      clc
    622  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    623  f48e		       a2 00		      ldx	#0
    624  f490				   .TEDiv
    625  f490		       c9 06		      cmp	#6
    626  f492		       90 06		      bcc	.TEDivSum
    627  f494		       38		      sec
    628  f495		       e9 06		      sbc	#6
    629  f497		       e8		      inx		; X = time ticks (0..20; BarLevel <= 120)
    630  f498		       d0 f6		      bne	.TEDiv
    631  f49a				   .TEDivSum
    632  f49a		       20 b0 f4 	      jsr	TallySum	; TallyTicks = ticks + 20 + bombs + 2*lives
    633  f49d							; (masking the raft's ramp bits out of
    634  f49d							; PlayerBombs needs the split helper below)
    635  f49d		       a9 04		      lda	#4
    636  f49f		       85 ad		      sta	TickCounter	; fresh pace divider
    637  f4a1		       a9 00		      lda	#0
    638  f4a3		       85 96		      sta	JetPower	; frozen frame: no thrust flutter
    639  f4a5		       85 83		      sta	LaserX	; drop any live beam (travel restarts on press)
    640  f4a7		       a9 fe		      lda	#$FE
    641  f4a9		       85 8a		      sta	DropTarget
    642  f4ab		       a9 00		      lda	#0
    643  f4ad		       4c f8 fb 	      jmp	ReturnPad
