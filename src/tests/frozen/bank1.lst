   1529  f8ab							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1530  f8ab							; verify_build.check_raft_tramp). bank0 executes `sta $1FF5` at $F8C0-$F8C2 and
   1531  f8ab							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1532  f8ab							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1533  f8ab							; `sta $1FF5` is never executed (it is only the swapped-out image's prefix).
   1534  f8ab							; In bank1's $F822-$F8C6 fill; StripBlastCheck follows it directly ($F937 pin
   1535  f8ab							; deleted 2026-10-20 — the body floats and the $F9AC pin bounds the leaves).
   1536  f8ab							; ------------------------------------------------------------------------------
   1537  f8ab		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1538  f8c0		       8d f5 1f 	      .byte.b	$8D, $F5, $1F	; sta $1FF5 (twin)
   1539  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1540  f8c6
   1541  f8c6							; ($F937 pin DELETED 2026-10-20, audit round 2: it pinned bank2's
   1542  f8c6							;  M1StripBlast back-jmp operand, and that body is same-bank now — the chain
   1543  f8c6							;  is .BMWDone -> M1StripBlast -> StripBlastCheck inside bank1, so
   1544  f8c6							;  StripBlastCheck is reached by label and floats. It now starts right after
   1545  f8c6							;  the raft tramp twin; the $F9AC pin still bounds the sound-leaf block.)
   1546  f8c6							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1547  f8c6							; from BombMarkWalls .BMWDone through M1StripBlast (same bank, label `jmp`s
   1548  f8c6							; — repack chunk 2; 0 pushes, no switch). Still 0 pushes (the jsr+pha
   1549  f8c6							; version measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1550  f8c6							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1551  f8c6							; Every exit ends in ReturnPad with A = count.
   1552  f8c6							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1553  f8c6							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1554  f8c6							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1555  f8c6							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1556  f8c6							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1557  f8c6							; inc the count (caller's +75 loop scores it). The
   1558  f8c6							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1559  f8c6							; lifecycle as WallMask holes (D1-B). P2b door models never
   1560  f8c6							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1561  f8c6							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1562  f8c6							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1563  f8c6							; ------------------------------------------------------------------------------
   1564  f8c6				   StripBlastCheck
   1565  f8c6							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1566  f8c6							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1567  f8c6							; Window is still LEFT-half here (the mirror below). Door models stage
   1568  f8c6							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1569  f8c6							; sets b3/b4 instead.
   1570  f8c6		       a5 92		      lda	RectCount
   1571  f8c8		       30 28		      bmi	.SBright	; $FF → no left strip this frame
   1572  f8ca		       a5 8c		      lda	CollisionCellX	; blast hi
   1573  f8cc		       c5 92		      cmp	RectCount
   1574  f8ce		       90 22		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1575  f8d0		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1576  f8d2		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1577  f8d4		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1578  f8d6		       c9 02		      cmp	#2
   1579  f8d8		       b0 18		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1580  f8da							;   (A=0/1 falls into take = overlap)
   1581  f8da				   .SBleftTake
   1582  f8da		       a5 92		      lda	RectCount
   1583  f8dc		       d0 06		      bne	.SBlOk	; an interior strip is a designed block: bombable
   1584  f8de		       a5 db		      lda	RoomExits	; the EDGE strip (dcol 0) is the dead-side plug
   1585  f8e0		       29 02		      and	#2
   1586  f8e2		       d0 0e		      bne	.SBright	;   (no room to the WEST): unbreakable
   1587  f8e4				   .SBlOk
   1588  f8e4		       a5 ba		      lda	EnemyDeadMask
   1589  f8e6		       29 10		      and	#$10
   1590  f8e8		       d0 08		      bne	.SBright	; already destroyed → no double score
   1591  f8ea		       a9 10		      lda	#$10
   1592  f8ec		       05 ba		      ora	EnemyDeadMask
   1593  f8ee		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1594  f8f0		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1595  f8f2				   .SBright
   1596  f8f2							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1597  f8f2							; window here (space is free in this gap): lo_r = 39-hi_l,
   1598  f8f2							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1599  f8f2		       18		      clc
   1600  f8f3		       a5 8e		      lda	CollisionEndX	; lo_l
   1601  f8f5		       49 ff		      eor	#$FF
