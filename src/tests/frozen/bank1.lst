   1236  f7a3							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1237  f7a3							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1238  f7a3							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1239  f7a3							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1240  f7a3							; ====================================================================
   1241  f7a3
   1242  f7a3							; --- Setup sprites ---
