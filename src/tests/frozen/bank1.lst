     92  f050							; TitleSelect — moved from bank0 (refactor_v4_plan Phase 3.1 canary, 2026-10-16).
     93  f050							; Pure leaf (no calls); returns C=1 edge (caller runs LoadLevel) / C=0 no-edge.
     94  f050							; Entered via CallPad_TitleSelect ($FC4F); tail-exits through ReturnPad
     95  f050							; (sta $1FF6/rts), which returns to the bank0 caller with C intact.
     96  f050		       02 82	   SWCHB      =	$0282
     97  f050		       00 97	   StepsLeft  =	$97	; bank0 per-frame step latch (ZP byte block)
     98  f050		       00 04	   LEVEL_COUNT =	4	; hand copy of kernel LEVEL_COUNT
     99  f050				   TitleSelect
    100  f050		       a5 97		      lda	StepsLeft
    101  f052		       29 02		      and	#%00000010
    102  f054		       f0 17		      beq	.TSnoB1
    103  f056		       ad 82 02 	      lda	SWCHB
    104  f059		       29 02		      and	#%00000010
    105  f05b		       d0 10		      bne	.TSnoB1
    106  f05d		       e6 a3		      inc	Level
    107  f05f		       a5 a3		      lda	Level
    108  f061		       c9 04		      cmp	#LEVEL_COUNT
    109  f063		       d0 04		      bne	.TSokB1
    110  f065		       a9 00		      lda	#0
    111  f067		       85 a3		      sta	Level
    112  f069				   .TSokB1
    113  f069		       38		      sec
    114  f06a		       4c f8 fb 	      jmp	ReturnPad
    115  f06d				   .TSnoB1
    116  f06d		       18		      clc
