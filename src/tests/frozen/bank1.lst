   2117  fd50							; SetupScorePointers — score digit pointers:
   2118  fd50							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2119  fd50							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu..").
   2120  fd50							; Lives with the glyphs: bank1 pre-pad $F937 pin has ~1B slack (score
   2121  fd50							; section is a jsr here from MenuMain).
   2122  fd50				   SetupScorePointers
   2123  fd50							; --- Initialize score to 0 on first frame ---
   2124  fd50		       a5 ad		      lda	Temp
   2125  fd52		       d0 0c		      bne	.scoreInitDone
   2126  fd54		       e6 ad		      inc	Temp
   2127  fd56		       a9 00		      lda	#0
   2128  fd58		       85 f3		      sta	ScoreTh
   2129  fd5a		       85 f4		      sta	ScoreHu
   2130  fd5c		       a9 00		      lda	#$00
   2131  fd5e		       85 f5		      sta	ScoreTe
   2132  fd60				   .scoreInitDone
   2133  fd60
   2134  fd60							; --- Set up 6 digit pointers ---
   2135  fd60							; High bytes first (all $FD)
   2136  fd60		       a9 fd		      lda	#>DigitGfx
   2137  fd62		       85 e1		      sta	scorePtr1+1
   2138  fd64		       85 e3		      sta	scorePtr2+1
   2139  fd66		       85 e5		      sta	scorePtr3+1
   2140  fd68		       85 e7		      sta	scorePtr4+1
   2141  fd6a		       85 e9		      sta	scorePtr5+1
   2142  fd6c		       85 eb		      sta	scorePtr6+1
   2143  fd6e
   2144  fd6e							; scorePtr1..2 = leading zeros
   2145  fd6e		       a9 00		      lda	#0
   2146  fd70		       85 e0		      sta	scorePtr1
   2147  fd72		       85 e2		      sta	scorePtr2
   2148  fd74
   2149  fd74							; scorePtr3 = ScoreTh * 8
   2150  fd74		       a5 f3		      lda	ScoreTh
   2151  fd76		       0a		      asl
   2152  fd77		       0a		      asl
   2153  fd78		       0a		      asl
   2154  fd79		       85 e4		      sta	scorePtr3
   2155  fd7b
   2156  fd7b							; scorePtr4 = ScoreHu * 8
   2157  fd7b		       a5 f4		      lda	ScoreHu
   2158  fd7d		       0a		      asl
   2159  fd7e		       0a		      asl
   2160  fd7f		       0a		      asl
   2161  fd80		       85 e6		      sta	scorePtr4
   2162  fd82
   2163  fd82							; scorePtr5 = (ScoreTe >> 4) * 8  (tens digit)
   2164  fd82		       a5 f5		      lda	ScoreTe
   2165  fd84		       4a		      lsr
   2166  fd85		       4a		      lsr
   2167  fd86		       4a		      lsr
   2168  fd87		       4a		      lsr		; tens digit in low nibble
   2169  fd88		       0a		      asl
   2170  fd89		       0a		      asl
   2171  fd8a		       0a		      asl
   2172  fd8b		       85 e8		      sta	scorePtr5
   2173  fd8d
   2174  fd8d							; scorePtr6 = (ScoreTe & $0F) * 8  (ones digit)
   2175  fd8d		       a5 f5		      lda	ScoreTe
   2176  fd8f		       29 0f		      and	#$0F
   2177  fd91		       0a		      asl
   2178  fd92		       0a		      asl
   2179  fd93		       0a		      asl
   2180  fd94		       85 ea		      sta	scorePtr6
   2181  fd96		       60		      rts
   2182  fd97
   2183  fd97							; ========================================================================
   2184  fd97							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2185  fd97							; ========================================================================
   2186  fd97		       00 00 00 00*	      .ds	$FDE3 - *, 0
   2187  fd97		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2188  fd97		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2189  fde3							; rails keep it inside the room
   2190  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2191  fde3							; surface (line 132) - 7, so its BOTTOM row
   2192  fde3							; sits exactly ON the surface. The live value is
   2193  fde3							; RAFTER_BASE + off (see the tide block below) —
   2194  fde3							; never hard-code the Y: the surface MOVES.
   2195  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2196  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2197  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2198  fde3							; from 12 px above the raft's top to 5 px into it
   2199  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2200  fde3
   2201  fde3				   RaftBody
   2202  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2203  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2204  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2205  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2206  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2207  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2208  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2209  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2210  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2211  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2212  fde3		       a5 c2		      lda	EnemyRamP
   2213  fde5		       29 f0		      and	#$F0
   2214  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2215  fde9		       4a		      lsr
   2216  fdea		       4a		      lsr
   2217  fdeb		       4a		      lsr
   2218  fdec		       4a		      lsr		; A = p (1..15)
   2219  fded		       c9 08		      cmp	#8
   2220  fdef		       90 04		      bcc	.RaftTideTri
   2221  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2222  fdf3		       f0 09		      beq	.RaftTide	; always
   2223  fdf5				   .RaftTideTri
   2224  fdf5		       c9 04		      cmp	#4
   2225  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2226  fdf9		       49 ff		      eor	#$FF
   2227  fdfb		       38		      sec
   2228  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2229  fdfe				   .RaftTide
   2230  fdfe		       18		      clc
   2231  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2232  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2233  fe03							; water line is what the raft floats on
   2234  fe03
   2235  fe03							; --- does the player count as "over the raft"? --------------------------
   2236  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2237  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2238  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2239  fe03							; block here is what makes it park; the pin/carry later still applies while
   2240  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2241  fe03							; raft he is actually standing on.
   2242  fe03		       a5 80		      lda	RoomX
   2243  fe05		       38		      sec
   2244  fe06		       f5 bd		      sbc	EnemyRamX,X
   2245  fe08		       18		      clc
   2246  fe09		       69 06		      adc	#RAFTER_XOFF
   2247  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2248  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2249  fe0f		       a5 81		      lda	RoomY
   2250  fe11		       38		      sec
   2251  fe12		       f5 e2		      sbc	EnemyRamY,X
   2252  fe14		       18		      clc
   2253  fe15		       69 0c		      adc	#RAFTER_PINFIT
   2254  fe17		       c9 12		      cmp	#RAFTER_YSPAN
   2255  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2256  fe1b		       a5 94		      lda	vyHi
   2257  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2258  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2259  fe22				   .RaftNoRide
   2260  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2261  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2262  fe22		       a5 f0		      lda	$F0
   2263  fe24		       29 07		      and	#%00000111
   2264  fe26		       85 f0		      sta	$F0
   2265  fe28		       4c f8 fb 	      jmp	ReturnPad
   2266  fe2b				   .RaftGo
   2267  fe2b							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2268  fe2b							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2269  fe2b							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2270  fe2b							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2271  fe2b							; it cannot borrow upward either (see the kernel EQU for the contract).
   2272  fe2b							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2273  fe2b							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2274  fe2b							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2275  fe2b		       a5 f0		      lda	$F0
   2276  fe2d		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2277  fe2f		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2278  fe31		       f0 04		      beq	.RaftAtSpeed
   2279  fe33		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2280  fe35		       d0 07		      bne	.RaftHaveStep	; always
   2281  fe37				   .RaftAtSpeed
   2282  fe37		       a5 c2		      lda	EnemyRamP
   2283  fe39		       29 01		      and	#1
   2284  fe3b		       18		      clc
   2285  fe3c		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2286  fe3e				   .RaftHaveStep
   2287  fe3e		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2288  fe40		       bd 44 f8 	      lda	RaftBitTab,X
   2289  fe43		       25 c1		      and	EnemyRamD
   2290  fe45		       f0 29		      beq	.RaftLeft
   2291  fe47							; ---- leading edge right: candidate = x + step ---------------------------
   2292  fe47		       b5 bd		      lda	EnemyRamX,X
   2293  fe49		       18		      clc
   2294  fe4a		       65 88		      adc	$88
   2295  fe4c		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2296  fe4e		       c9 94		      cmp	#RAFT_MAX_X
   2297  fe50		       b0 14		      bcs	.RaftTurn	; right rail
   2298  fe52		       18		      clc
   2299  fe53		       69 01		      adc	#1	; the cell just beyond the right edge
   2300  fe55		       4a		      lsr
   2301  fe56		       4a		      lsr
   2302  fe57		       20 26 f8 	      jsr	RaftCellSolid
   2303  fe5a		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2304  fe5c		       b5 bd		      lda	EnemyRamX,X
   2305  fe5e		       18		      clc
   2306  fe5f		       65 88		      adc	$88
   2307  fe61		       95 bd		      sta	EnemyRamX,X
   2308  fe63		       4c 90 fe 	      jmp	.RaftRide
   2309  fe66							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
   2310  fe66							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2311  fe66				   .RaftTurn
   2312  fe66		       bd 44 f8 	      lda	RaftBitTab,X
   2313  fe69		       45 c1		      eor	EnemyRamD
   2314  fe6b		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2315  fe6d							; bank1's RoomDarkMask — must be preserved)
   2316  fe6d		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2317  fe70							; ---- leading edge left --------------------------------------------------
   2318  fe70				   .RaftLeft
   2319  fe70		       b5 bd		      lda	EnemyRamX,X
   2320  fe72		       38		      sec
   2321  fe73		       e5 88		      sbc	$88
   2322  fe75		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2323  fe77		       c9 08		      cmp	#RAFT_MIN_X
   2324  fe79		       90 eb		      bcc	.RaftTurn	; left rail
   2325  fe7b		       38		      sec
   2326  fe7c		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2327  fe7e		       b0 02		      bcs	.RaftLeftCol
   2328  fe80		       a9 00		      lda	#0
   2329  fe82				   .RaftLeftCol
   2330  fe82		       4a		      lsr
   2331  fe83		       4a		      lsr
   2332  fe84		       20 26 f8 	      jsr	RaftCellSolid
   2333  fe87		       d0 dd		      bne	.RaftTurn
   2334  fe89		       b5 bd		      lda	EnemyRamX,X
   2335  fe8b		       38		      sec
   2336  fe8c		       e5 88		      sbc	$88
   2337  fe8e		       95 bd		      sta	EnemyRamX,X
   2338  fe90							; ---- carry + pin while the player is aboard -----------------------------
   2339  fe90				   .RaftRide
   2340  fe90		       a5 94		      lda	vyHi
   2341  fe92		       30 0d		      bmi	.RaftNoPin	; rising: pin skipped, carry still happens
   2342  fe94		       b5 e2		      lda	EnemyRamY,X
   2343  fe96		       38		      sec
   2344  fe97		       e9 0c		      sbc	#RAFTER_PINFIT
   2345  fe99		       85 81		      sta	RoomY	; feet on the raft's top
   2346  fe9b		       a9 00		      lda	#0
   2347  fe9d		       85 93		      sta	vyLo
   2348  fe9f		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2349  fea1				   .RaftNoPin
   2350  fea1							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2351  fea1		       a5 f0		      lda	$F0
   2352  fea3		       09 80		      ora	#%10000000
   2353  fea5		       85 f0		      sta	$F0
   2354  fea7		       a5 c2		      lda	EnemyRamP
   2355  fea9		       4a		      lsr		; C = the frame-parity bit
   2356  feaa		       b0 0f		      bcs	.RaftCarry	; odd frame: flag only this time
   2357  feac		       a5 f0		      lda	$F0
   2358  feae		       29 78		      and	#%01111000
   2359  feb0		       c9 78		      cmp	#%01111000
   2360  feb2		       f0 07		      beq	.RaftCarry	; already spun up
   2361  feb4		       a5 f0		      lda	$F0
   2362  feb6		       18		      clc
   2363  feb7		       69 10		      adc	#%00010000
   2364  feb9		       85 f0		      sta	$F0
   2365  febb				   .RaftCarry
   2366  febb		       bd 44 f8 	      lda	RaftBitTab,X
   2367  febe		       25 c1		      and	EnemyRamD
   2368  fec0		       f0 0a		      beq	.RaftCarryL
   2369  fec2		       a5 80		      lda	RoomX
   2370  fec4		       18		      clc
   2371  fec5		       65 88		      adc	$88
   2372  fec7		       85 80		      sta	RoomX
   2373  fec9		       4c d6 fe 	      jmp	.RaftDone
   2374  fecc				   .RaftCarryL
   2375  fecc		       a5 80		      lda	RoomX
   2376  fece		       38		      sec
   2377  fecf		       e5 88		      sbc	$88
   2378  fed1		       85 80		      sta	RoomX
   2379  fed3		       4c d6 fe 	      jmp	.RaftDone
   2380  fed6				   .RaftDone
   2381  fed6		       4c f8 fb 	      jmp	ReturnPad
