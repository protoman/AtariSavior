   2097  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   2098  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2099  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2100  fc78							; check_callpads asserts they equal these labels.
   2101  fc78							; ------------------------------------------------------------------------
   2102  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2103  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2104  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2105  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2106  fc78							; survives the cross-bank return.
   2107  fc78				   IsRoomDark
   2108  fc78		       a5 98		      lda	RoomNo
   2109  fc7a		       c9 04		      cmp	#4
   2110  fc7c		       b0 0c		      bcs	.IRDhi
   2111  fc7e		       18		      clc
   2112  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2113  fc81		       aa		      tax
   2114  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2115  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2116  fc87		       4c f8 fb 	      jmp	ReturnPad
   2117  fc8a				   .IRDhi
   2118  fc8a		       c9 08		      cmp	#8
   2119  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2120  fc8e		       aa		      tax
   2121  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2122  fc92		       4a		      lsr
   2123  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2124  fc94		       25 c0		      and	LaserState
   2125  fc96		       4c f8 fb 	      jmp	ReturnPad
   2126  fc99				   .IRDlit
   2127  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2128  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2129  fc9e
   2130  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2131  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2132  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2133  fc9e				   SetRoomDark
   2134  fc9e		       a5 98		      lda	RoomNo
   2135  fca0		       c9 04		      cmp	#4
   2136  fca2		       b0 0e		      bcs	.SRDhi
   2137  fca4		       18		      clc
   2138  fca5		       69 04		      adc	#4
   2139  fca7		       aa		      tax
   2140  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2141  fcab		       05 c1		      ora	EnemyRamD
   2142  fcad		       85 c1		      sta	EnemyRamD
   2143  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2144  fcb2				   .SRDhi
   2145  fcb2		       c9 08		      cmp	#8
   2146  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2147  fcb6		       aa		      tax
   2148  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2149  fcba		       4a		      lsr
   2150  fcbb		       4a		      lsr
   2151  fcbc		       05 c0		      ora	LaserState
   2152  fcbe		       85 c0		      sta	LaserState
   2153  fcc0				   .SRDdone
   2154  fcc0		       4c f8 fb 	      jmp	ReturnPad
