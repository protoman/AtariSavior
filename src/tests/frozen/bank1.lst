   1630  fa81		       90 1c		      bcc	.ASstoreTe
   1631  fa83		       ea		      nop		; byte-pin (see SIZE PIN above)
   1632  fa84		       ea		      nop		; byte-pin
   1633  fa85		       48		      pha		; save wrapped ScoreTe
   1634  fa86		       e6 f4		      inc	ScoreHu
   1635  fa88		       a5 f4		      lda	ScoreHu
   1636  fa8a		       c9 0a		      cmp	#10
   1637  fa8c		       90 10		      bcc	.AShuOk
   1638  fa8e		       a9 00		      lda	#0
   1639  fa90		       85 f4		      sta	ScoreHu
   1640  fa92		       e6 f3		      inc	ScoreTh
   1641  fa94		       a5 f3		      lda	ScoreTh
   1642  fa96		       c9 0a		      cmp	#10
   1643  fa98		       90 04		      bcc	.ASthOk
   1644  fa9a		       a9 09		      lda	#9
   1645  fa9c		       85 f3		      sta	ScoreTh
   1646  fa9e				   .ASthOk
   1647  fa9e				   .AShuOk
