   1288  f7b1							; ====================================================================
   1289  f7b1							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1290  f7b1							; Proven kernel from score48pix.asm
   1291  f7b1							; ====================================================================
   1292  f7b1		       a0 07		      ldy	#7
   1293  f7b3		       84 ec		      sty	scbrdCnt
