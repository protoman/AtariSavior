   1782  fa95		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1783  fa97		       a5 c0		      lda	LaserState
   1784  fa99		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1785  fa9b		       a5 c2		      lda	EnemyRamP
   1786  fa9d		       4a		      lsr
   1787  fa9e		       4a		      lsr
