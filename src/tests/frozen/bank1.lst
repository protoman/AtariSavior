   2594  ff5e		       0a		      asl
   2595  ff5f		       0a		      asl
   2596  ff60		       85 e2		      sta	scorePtr2
   2597  ff62		       a5 f4		      lda	ScoreHu
   2598  ff64		       29 f0		      and	#$F0
   2599  ff66		       4a		      lsr
