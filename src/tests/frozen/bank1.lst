   2197  fda3		       90 05		      bcc	.LVTensDone
   2198  fda5		       e9 0a		      sbc	#10
   2199  fda7		       e8		      inx
   2200  fda8		       d0 f7		      bne	.LVTens
   2201  fdaa				   .LVTensDone
