   1273  f822		       00 00 00 00*	      .ds	$F937 - *, 0	; pinned: bank2 M1StripBlast back-jmp operand
   1274  f937							; ($F937) — test_bomb_strip asserts both literals
   1275  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1276  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1277  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1278  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1279  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1280  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1281  f937							; Every exit ends in ReturnPad with A = count.
   1282  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1283  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1284  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1285  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1286  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1287  f937							; inc the count (caller's +75 loop scores it). The
   1288  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1289  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1290  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1291  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1292  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1293  f937							; ------------------------------------------------------------------------------
   1294  f937				   StripBlastCheck
   1295  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1296  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1297  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1298  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1299  f937							; sets b3/b4 instead.
   1300  f937		       a5 92		      lda	RectCount
   1301  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1302  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1303  f93d		       c5 92		      cmp	RectCount
   1304  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1305  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1306  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1307  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1308  f947		       c9 02		      cmp	#2
   1309  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1310  f94b							;   (A=0/1 falls into take = overlap)
   1311  f94b				   .SBleftTake
   1312  f94b		       a5 ba		      lda	EnemyDeadMask
   1313  f94d		       29 10		      and	#$10
   1314  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1315  f951		       a9 10		      lda	#$10
   1316  f953		       05 ba		      ora	EnemyDeadMask
   1317  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1318  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1319  f959				   .SBright
   1320  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1321  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1322  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1323  f959		       18		      clc
   1324  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1325  f95c		       49 ff		      eor	#$FF
   1326  f95e		       69 28		      adc	#40	; hi_r = 39-lo_l
   1327  f960		       a8		      tay
   1328  f961		       18		      clc
   1329  f962		       a5 8c		      lda	CollisionCellX	; hi_l
   1330  f964		       49 ff		      eor	#$FF
   1331  f966		       69 28		      adc	#40	; lo_r = 39-hi_l
   1332  f968		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1333  f96a		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1334  f96c		       a5 8c		      lda	CollisionCellX	; hi
   1335  f96e		       38		      sec
   1336  f96f		       e5 88		      sbc	BMWScratch	; hi - pL
   1337  f971		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1338  f973		       a5 8e		      lda	CollisionEndX	; lo
   1339  f975		       c5 88		      cmp	BMWScratch
   1340  f977		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1341  f979		       f0 07		      beq	.SBtake	; lo == pL
   1342  f97b		       38		      sec
   1343  f97c		       e9 01		      sbc	#1
   1344  f97e		       c5 88		      cmp	BMWScratch
   1345  f980		       d0 0e		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1346  f982				   .SBtake
   1347  f982		       a5 ba		      lda	EnemyDeadMask
   1348  f984		       29 08		      and	#$08
   1349  f986		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1350  f988		       a9 08		      lda	#$08
   1351  f98a		       05 ba		      ora	EnemyDeadMask
   1352  f98c		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1353  f98e		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1354  f990				   .SBdone
   1355  f990		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1356  f992		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
   1357  f995
   1358  f995		       00 00 00 00*	      .ds	$F9AC - *, 0	; shared cross-bank pad — bank2 carries the
   1359  f9ac							; SAME 12 bytes at $F9AC (identity asserted
   1360  f9ac							; in test_bomb_strip): after `sta $1FF8` the
   1361  f9ac							; NEXT opcode fetch is from the NEW bank at
   1362  f9ac							; pc+3, so both banks must hold the identical
