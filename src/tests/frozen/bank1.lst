   2322  fddd		       0a		      asl
   2323  fdde		       0a		      asl
   2324  fddf		       0a		      asl
   2325  fde0		       85 ea		      sta	scorePtr6
   2326  fde2		       60		      rts
   2327  fde3
   2328  fde3							; ========================================================================
   2329  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2330  fde3							; ========================================================================
   2331  fde3					      .ds	$FDE3 - *, 0
   2332  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2333  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2334  fde3							; rails keep it inside the room
   2335  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2336  fde3							; surface (line 132) - 7, so its BOTTOM row
   2337  fde3							; sits exactly ON the surface. The live value is
   2338  fde3							; RAFTER_BASE + off (see the tide block below) —
   2339  fde3							; never hard-code the Y: the surface MOVES.
   2340  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2341  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2342  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2343  fde3							; from 12 px above the raft's top to 5 px into it
   2344  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2345  fde3
   2346  fde3				   RaftBody
   2347  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2348  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2349  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2350  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2351  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2352  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2353  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2354  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2355  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2356  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2357  fde3		       a5 c2		      lda	EnemyRamP
   2358  fde5		       29 f0		      and	#$F0
   2359  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2360  fde9		       4a		      lsr
   2361  fdea		       4a		      lsr
   2362  fdeb		       4a		      lsr
   2363  fdec		       4a		      lsr		; A = p (1..15)
   2364  fded		       c9 08		      cmp	#8
   2365  fdef		       90 04		      bcc	.RaftTideTri
   2366  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2367  fdf3		       f0 09		      beq	.RaftTide	; always
   2368  fdf5				   .RaftTideTri
   2369  fdf5		       c9 04		      cmp	#4
   2370  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2371  fdf9		       49 ff		      eor	#$FF
   2372  fdfb		       38		      sec
   2373  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2374  fdfe				   .RaftTide
   2375  fdfe		       18		      clc
   2376  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2377  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2378  fe03							; water line is what the raft floats on
   2379  fe03
   2380  fe03							; --- does the player count as "over the raft"? --------------------------
   2381  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2382  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2383  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2384  fe03							; block here is what makes it park; the pin/carry later still applies while
   2385  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2386  fe03							; raft he is actually standing on.
   2387  fe03		       a5 80		      lda	RoomX
   2388  fe05		       38		      sec
   2389  fe06		       f5 bd		      sbc	EnemyRamX,X
   2390  fe08		       18		      clc
   2391  fe09		       69 06		      adc	#RAFTER_XOFF
   2392  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2393  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2394  fe0f		       a5 81		      lda	RoomY
   2395  fe11		       38		      sec
   2396  fe12		       f5 e2		      sbc	EnemyRamY,X
   2397  fe14		       18		      clc
   2398  fe15		       69 0c		      adc	#RAFTER_PINFIT
   2399  fe17		       c9 12		      cmp	#RAFTER_YSPAN
   2400  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2401  fe1b		       a5 94		      lda	vyHi
   2402  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
