    557  f41f							; ------------------------------------------------------------------------------
    558  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    559  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    560  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    561  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    562  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    563  f41f							; Staging contract (both scratch bytes free in this flow):
    564  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    565  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    566  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    567  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    568  f41f							; ------------------------------------------------------------------------------
    569  f41f				   M1StripBlast
    570  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    571  f421		       c9 14		      cmp	#20
    572  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    573  f425		       a5 ba		      lda	EnemyDeadMask
    574  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    575  f429		       d0 15		      bne	.M1SBnone
    576  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    577  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    578  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    579  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    580  f433		       4a		      lsr
    581  f434		       4a		      lsr
    582  f435		       4a		      lsr
    583  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    584  f437							;   high end — StripBlastCheck rejects)
    585  f437		       38		      sec
    586  f438		       e9 01		      sbc	#1	; ℓ = left_col
    587  f43a		       0a		      asl		; 2ℓ = strip left dcol
    588  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    589  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    590  f440				   .M1SBnone
    591  f440		       a9 ff		      lda	#$FF
    592  f442		       85 92		      sta	RectCount	; no left strip this frame
    593  f444				   .M1SBdoorR
