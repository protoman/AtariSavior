    484  f35a							; ==============================================================================
    485  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    486  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    487  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    488  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    489  f35a							;   byte = note_code*4 + duration_code
    490  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    491  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    492  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    493  f35a							; ==============================================================================
    494  f35a							; --- Melody state: BombX/BombTimer ($F6/$F7) ------------------------------
    495  f35a							; The theme plays ONLY on title frames, and on those frames the bomb block
    496  f35a							; never runs (DropTarget != 0 -> DropStep skips it), so the bomb's two bytes are
    497  f35a							; dead for exactly as long as the music is alive. Sharing them here frees
    498  f35a							; $9D/$9E, which the CAVE kernel needs on BOTH kinds of frame (the title
    499  f35a							; previews the stage with real room objects) — that is where the per-type
    500  f35a							; object height will live. Restart on return: the title-entry path zeroes both.
    501  f35a							; Contract: nothing may read BombX/BombTimer while a title frame is running.
    502  f35a		       00 f6	   MelPtr     =	$F6	; = kernel BombX   (dead on the title)
    503  f35a		       00 f7	   MelTimer   =	$F7	; = kernel BombTimer (dead on the title)
    504  f35a
    505  f35a				   MusicTick
    506  f35a		       a9 00		      lda	#0
    507  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    508  f35e		       a6 f6		      ldx	MelPtr
    509  f360		       a5 f7		      lda	MelTimer
    510  f362		       f0 0d		      beq	.MelLoad
    511  f364		       c6 f7		      dec	MelTimer
    512  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    513  f369							;   MelPtr already points at the NEXT step, so
    514  f369							;   this mirrors the pre-pack (duration,note)
    515  f369							;   player's MusicMel+1,X read, keeps the same
    516  f369							;   audible melody
    517  f369		       4a		      lsr
    518  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    519  f36b		       20 98 f3 	      jsr	MelApply
    520  f36e		       4c f8 fb 	      jmp	ReturnPad
    521  f371				   .MelLoad
    522  f371		       bd b0 f3 	      lda	MusicMel,X
    523  f374		       29 03		      and	#3
    524  f376		       a8		      tay
    525  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    526  f37a		       85 f7		      sta	MelTimer
    527  f37c		       bd b0 f3 	      lda	MusicMel,X
    528  f37f		       4a		      lsr
    529  f380		       4a		      lsr
    530  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    531  f383		       f0 0c		      beq	.MelLoop
    532  f385		       20 98 f3 	      jsr	MelApply
    533  f388		       8a		      txa
    534  f389		       18		      clc
    535  f38a		       69 01		      adc	#1
    536  f38c		       85 f6		      sta	MelPtr
    537  f38e		       4c f8 fb 	      jmp	ReturnPad
    538  f391				   .MelLoop
    539  f391		       a9 00		      lda	#0
    540  f393		       85 f6		      sta	MelPtr
    541  f395		       4c f8 fb 	      jmp	ReturnPad
    542  f398
    543  f398							; MelApply: A = note code. Starts the Lead at that pitch, or silences AUD0 on
    544  f398							; a rest ($3E). $3F (loop) HOLDS the tone the load frame started - the old
    545  f398							; paired player's `cmp #$FF / beq .MelDone` arm, kept for an identical melody.
    546  f398				   MelApply
    547  f398		       c9 3f		      cmp	#$3F
    548  f39a		       f0 13		      beq	.MAHold
    549  f39c		       c9 3e		      cmp	#$3E
    550  f39e		       f0 0b		      beq	.MAOff
    551  f3a0		       85 17		      sta	AUDF0
    552  f3a2		       a9 0c		      lda	#$0C	; Lead
    553  f3a4		       85 15		      sta	AUDC0
    554  f3a6		       a9 07		      lda	#7
    555  f3a8		       85 19		      sta	AUDV0
    556  f3aa		       60		      rts
    557  f3ab				   .MAOff
    558  f3ab		       a9 00		      lda	#0
    559  f3ad		       85 19		      sta	AUDV0
    560  f3af				   .MAHold
    561  f3af		       60		      rts
