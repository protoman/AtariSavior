   1284  f812							; ====================================================================
   1285  f812							; Pad remaining scanlines to reach exactly 48 total
   1286  f812							; Path A (PlayerLives > 0) — execution count:
   1287  f812							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1288  f812							;   Timer:    3 loop + 1 gap = 4
   1289  f812							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1290  f812							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1291  f812							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1292  f812							;   Subtotal: 6+4+8+11+10 = 39
   1293  f812							;   Pad:      48 - 39 = 9
   1294  f812							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1295  f812							; ====================================================================
   1296  f812		       a2 09		      ldx	#9
