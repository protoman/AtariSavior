   1343  f7f5							; HUD squares (2026-10-26): QUAD-size players, one pattern bit = 4 px, so squares
   1344  f7f5							; on every other bit sit 8 px apart. SquarePat[n] = n squares from the left
   1345  f7f5							; (lives 0..3, bombs 0..5; the 5th bomb is missile 0). MinerPat[mask] = the
   1346  f7f5							; miners still to rescue (LevelStartRoom b6-4 popcount) packed to the RIGHT end
   1347  f7f5							; of the 32 px sprite (P1 at X 128), so the row reads right aligned.
   1348  f7f5				   SquarePat
   1349  f7f5		       00 80 a0 a8*	      .byte.b	$00,$80,$A0,$A8,$AA,$AA
   1350  f7fb				   MinerPat
   1351  f7fb		       00 01 01 05*	      .byte.b	$00,$01,$01,$05,$01,$05,$05,$15
