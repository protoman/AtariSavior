   2030  fc78							; ========================================================================
   2031  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   2032  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2033  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2034  fc78							; check_callpads asserts they equal these labels.
   2035  fc78							; ------------------------------------------------------------------------
   2036  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2037  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2038  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2039  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2040  fc78							; survives the cross-bank return.
   2041  fc78				   IsRoomDark
   2042  fc78		       a5 98		      lda	RoomNo
   2043  fc7a		       c9 04		      cmp	#4
   2044  fc7c		       b0 0c		      bcs	.IRDhi
   2045  fc7e		       18		      clc
   2046  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2047  fc81		       aa		      tax
   2048  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2049  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2050  fc87		       4c f8 fb 	      jmp	ReturnPad
   2051  fc8a				   .IRDhi
   2052  fc8a		       c9 08		      cmp	#8
   2053  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2054  fc8e		       aa		      tax
   2055  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2056  fc92		       4a		      lsr
   2057  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2058  fc94		       25 c0		      and	LaserState
   2059  fc96		       4c f8 fb 	      jmp	ReturnPad
   2060  fc99				   .IRDlit
   2061  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2062  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2063  fc9e
   2064  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2065  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2066  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2067  fc9e				   SetRoomDark
   2068  fc9e		       a5 98		      lda	RoomNo
   2069  fca0		       c9 04		      cmp	#4
   2070  fca2		       b0 0e		      bcs	.SRDhi
   2071  fca4		       18		      clc
   2072  fca5		       69 04		      adc	#4
   2073  fca7		       aa		      tax
   2074  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2075  fcab		       05 c1		      ora	EnemyRamD
   2076  fcad		       85 c1		      sta	EnemyRamD
   2077  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2078  fcb2				   .SRDhi
   2079  fcb2		       c9 08		      cmp	#8
   2080  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2081  fcb6		       aa		      tax
   2082  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2083  fcba		       4a		      lsr
   2084  fcbb		       4a		      lsr
   2085  fcbc		       05 c0		      ora	LaserState
   2086  fcbe		       85 c0		      sta	LaserState
   2087  fcc0				   .SRDdone
   2088  fcc0		       4c f8 fb 	      jmp	ReturnPad
   2089  fcc3
   2090  fcc3							; Bit masks for IsRoomDark/SetRoomDark. Index 4+room for EnemyRamD
   2091  fcc3							; (rooms 0-3 → bits 4-7); index = room for LaserState (rooms 4-7 →
   2092  fcc3							; bits 4-7 of the table, lsr×2 down to bits 2-5 = LaserState spare).
   2093  fcc3				   BitMaskTable
   2094  fcc3		       01 02 04 08*	      .byte.b	$01, $02, $04, $08, $10, $20, $40, $80
