   1721  fa83		       ea		      nop		; byte-pin (see SIZE PIN above)
   1722  fa84		       ea		      nop		; byte-pin
   1723  fa85		       48		      pha		; save wrapped ScoreTe
   1724  fa86		       e6 f4		      inc	ScoreHu
   1725  fa88		       a5 f4		      lda	ScoreHu
   1726  fa8a		       c9 0a		      cmp	#10
   1727  fa8c		       90 10		      bcc	.AShuOk
   1728  fa8e		       a9 00		      lda	#0
   1729  fa90		       85 f4		      sta	ScoreHu
   1730  fa92		       e6 f3		      inc	ScoreTh
   1731  fa94		       a5 f3		      lda	ScoreTh
   1732  fa96		       c9 0a		      cmp	#10
   1733  fa98		       90 04		      bcc	.ASthOk
   1734  fa9a		       a9 09		      lda	#9
   1735  fa9c		       85 f3		      sta	ScoreTh
   1736  fa9e				   .ASthOk
   1737  fa9e				   .AShuOk
