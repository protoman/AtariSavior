   2205  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2206  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2207  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2208  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2209  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2210  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2211  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2212  fd68				   SetupScorePointers
   2213  fd68							; --- Initialize score to 0 on first frame ---
   2214  fd68		       a5 ad		      lda	Temp
   2215  fd6a		       d0 0c		      bne	.scoreInitDone
   2216  fd6c		       e6 ad		      inc	Temp
   2217  fd6e		       a9 00		      lda	#0
