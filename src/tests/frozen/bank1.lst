   1387  f85c							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1388  f85c							; verify_build.check_raft_tramp). bank0 executes `sta $1FF7` at $F8C0-$F8C2 and
   1389  f85c							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1390  f85c							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1391  f85c							; `sta $1FF7` is never executed (it is only the swapped-out image's prefix).
   1392  f85c							; In bank1's $F822-$F8C6 fill; StripBlastCheck follows it directly ($F937 pin
   1393  f85c							; deleted 2026-10-20 — the body floats and the $F9AC pin bounds the leaves).
   1394  f85c							; ------------------------------------------------------------------------------
   1395  f85c		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1396  f8c0		       8d f7 1f 	      .byte.b	$8D, $F7, $1F	; sta $1FF7 (twin)
   1397  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1398  f8c6
   1399  f8c6							; ($F937 pin DELETED 2026-10-20, audit round 2: it pinned bank2's
   1400  f8c6							;  M1StripBlast back-jmp operand, and that body is same-bank now — the chain
   1401  f8c6							;  is .BMWDone -> M1StripBlast -> StripBlastCheck inside bank1, so
   1402  f8c6							;  StripBlastCheck is reached by label and floats. It now starts right after
   1403  f8c6							;  the raft tramp twin; the $F9AC pin still bounds the sound-leaf block.)
   1404  f8c6							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1405  f8c6							; from BombMarkWalls .BMWDone through M1StripBlast (same bank, label `jmp`s
   1406  f8c6							; — repack chunk 2; 0 pushes, no switch). Still 0 pushes (the jsr+pha
   1407  f8c6							; version measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1408  f8c6							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1409  f8c6							; Every exit ends in ReturnPad with A = count.
   1410  f8c6							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1411  f8c6							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1412  f8c6							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1413  f8c6							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1414  f8c6							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1415  f8c6							; inc the count (caller's +75 loop scores it). The
   1416  f8c6							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1417  f8c6							; lifecycle as WallMask holes (D1-B). P2b door models never
   1418  f8c6							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1419  f8c6							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1420  f8c6							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1421  f8c6							; ------------------------------------------------------------------------------
   1422  f8c6				   StripBlastCheck
   1423  f8c6							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1424  f8c6							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1425  f8c6							; Window is still LEFT-half here (the mirror below). Door models stage
   1426  f8c6							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1427  f8c6							; sets b3/b4 instead.
   1428  f8c6		       a5 92		      lda	RectCount
   1429  f8c8		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1430  f8ca		       a5 8c		      lda	CollisionCellX	; blast hi
   1431  f8cc		       c5 92		      cmp	RectCount
   1432  f8ce		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1433  f8d0		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1434  f8d2		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1435  f8d4		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1436  f8d6		       c9 02		      cmp	#2
   1437  f8d8		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1438  f8da							;   (A=0/1 falls into take = overlap)
   1439  f8da				   .SBleftTake
   1440  f8da		       a5 ba		      lda	EnemyDeadMask
   1441  f8dc		       29 10		      and	#$10
   1442  f8de		       d0 08		      bne	.SBright	; already destroyed → no double score
   1443  f8e0		       a9 10		      lda	#$10
   1444  f8e2		       05 ba		      ora	EnemyDeadMask
   1445  f8e4		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1446  f8e6		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1447  f8e8				   .SBright
   1448  f8e8							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1449  f8e8							; window here (space is free in this gap): lo_r = 39-hi_l,
   1450  f8e8							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1451  f8e8		       18		      clc
   1452  f8e9		       a5 8e		      lda	CollisionEndX	; lo_l
   1453  f8eb		       49 ff		      eor	#$FF
   1454  f8ed		       69 28		      adc	#40	; hi_r = 39-lo_l
   1455  f8ef		       a8		      tay
   1456  f8f0		       18		      clc
   1457  f8f1		       a5 8c		      lda	CollisionCellX	; hi_l
   1458  f8f3		       49 ff		      eor	#$FF
   1459  f8f5		       69 28		      adc	#40	; lo_r = 39-hi_l
   1460  f8f7		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1461  f8f9		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1462  f8fb		       a5 8c		      lda	CollisionCellX	; hi
   1463  f8fd		       38		      sec
   1464  f8fe		       e5 88		      sbc	BMWScratch	; hi - pL
   1465  f900		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1466  f902		       a5 8e		      lda	CollisionEndX	; lo
   1467  f904		       c5 88		      cmp	BMWScratch
   1468  f906		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1469  f908		       f0 07		      beq	.SBtake	; lo == pL
   1470  f90a		       38		      sec
   1471  f90b		       e9 01		      sbc	#1
   1472  f90d		       c5 88		      cmp	BMWScratch
   1473  f90f		       d0 0e		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1474  f911				   .SBtake
   1475  f911		       a5 ba		      lda	EnemyDeadMask
   1476  f913		       29 08		      and	#$08
   1477  f915		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1478  f917		       a9 08		      lda	#$08
   1479  f919		       05 ba		      ora	EnemyDeadMask
   1480  f91b		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1481  f91d		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1482  f91f				   .SBdone
   1483  f91f		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1484  f921		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
