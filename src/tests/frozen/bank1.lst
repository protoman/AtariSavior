    470  f35a							; ==============================================================================
    471  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    472  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    473  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    474  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    475  f35a							;   byte = note_code*4 + duration_code
    476  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    477  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    478  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    479  f35a							; ==============================================================================
    480  f35a							; --- Melody state: BombX/BombTimer ($F6/$F7) ------------------------------
    481  f35a							; The theme plays ONLY on title frames, and on those frames the bomb block
    482  f35a							; never runs (DropTarget != 0 -> DropStep skips it), so the bomb's two bytes are
    483  f35a							; dead for exactly as long as the music is alive. Sharing them here frees
    484  f35a							; $9D/$9E, which the CAVE kernel needs on BOTH kinds of frame (the title
    485  f35a							; previews the stage with real room objects) — that is where the per-type
    486  f35a							; object height will live. Restart on return: the title-entry path zeroes both.
    487  f35a							; Contract: nothing may read BombX/BombTimer while a title frame is running.
    488  f35a		       00 f6	   MelPtr     =	$F6	; = kernel BombX   (dead on the title)
    489  f35a		       00 f7	   MelTimer   =	$F7	; = kernel BombTimer (dead on the title)
    490  f35a
    491  f35a				   MusicTick
    492  f35a		       a9 00		      lda	#0
    493  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    494  f35e		       a6 f6		      ldx	MelPtr
    495  f360		       a5 f7		      lda	MelTimer
    496  f362		       f0 0d		      beq	.MelLoad
    497  f364		       c6 f7		      dec	MelTimer
    498  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    499  f369							;   MelPtr already points at the NEXT step, so
    500  f369							;   this mirrors the pre-pack (duration,note)
    501  f369							;   player's MusicMel+1,X read, keeps the same
    502  f369							;   audible melody
    503  f369		       4a		      lsr
    504  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    505  f36b		       20 98 f3 	      jsr	MelApply
    506  f36e		       4c f8 fb 	      jmp	ReturnPad
    507  f371				   .MelLoad
    508  f371		       bd b0 f3 	      lda	MusicMel,X
    509  f374		       29 03		      and	#3
    510  f376		       a8		      tay
    511  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    512  f37a		       85 f7		      sta	MelTimer
    513  f37c		       bd b0 f3 	      lda	MusicMel,X
    514  f37f		       4a		      lsr
    515  f380		       4a		      lsr
    516  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    517  f383		       f0 0c		      beq	.MelLoop
    518  f385		       20 98 f3 	      jsr	MelApply
    519  f388		       8a		      txa
    520  f389		       18		      clc
