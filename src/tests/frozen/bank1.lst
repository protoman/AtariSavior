   2484  fe90				   .RaftRide
   2485  fe90		       a5 94		      lda	vyHi
   2486  fe92		       30 0d		      bmi	.RaftNoPin	; rising: pin skipped, carry still happens
   2487  fe94		       b5 e2		      lda	EnemyRamY,X
   2488  fe96		       38		      sec
   2489  fe97		       e9 0c		      sbc	#RAFTER_PINFIT
   2490  fe99		       85 81		      sta	RoomY	; feet on the raft's top
   2491  fe9b		       a9 00		      lda	#0
   2492  fe9d		       85 93		      sta	vyLo
   2493  fe9f		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2494  fea1				   .RaftNoPin
   2495  fea1							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2496  fea1		       a5 f0		      lda	$F0
   2497  fea3		       09 80		      ora	#%10000000
   2498  fea5		       85 f0		      sta	$F0
   2499  fea7		       a5 c2		      lda	EnemyRamP
   2500  fea9		       4a		      lsr		; C = the frame-parity bit
   2501  feaa		       b0 0f		      bcs	.RaftCarry	; odd frame: flag only this time
   2502  feac		       a5 f0		      lda	$F0
   2503  feae		       29 78		      and	#%01111000
   2504  feb0		       c9 78		      cmp	#%01111000
   2505  feb2		       f0 07		      beq	.RaftCarry	; already spun up
   2506  feb4		       a5 f0		      lda	$F0
   2507  feb6		       18		      clc
   2508  feb7		       69 10		      adc	#%00010000
   2509  feb9		       85 f0		      sta	$F0
   2510  febb				   .RaftCarry
   2511  febb		       bd 44 f8 	      lda	RaftBitTab,X
   2512  febe		       25 c1		      and	EnemyRamD
   2513  fec0		       f0 0a		      beq	.RaftCarryL
