   2099  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2100  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2101  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2102  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2103  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2104  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2105  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2106  fd68				   SetupScorePointers
   2107  fd68							; --- Initialize score to 0 on first frame ---
   2108  fd68		       a5 ad		      lda	Temp
   2109  fd6a		       d0 0c		      bne	.scoreInitDone
   2110  fd6c		       e6 ad		      inc	Temp
   2111  fd6e		       a9 00		      lda	#0
   2112  fd70		       85 f3		      sta	ScoreTh
   2113  fd72		       85 f4		      sta	ScoreHu
   2114  fd74		       a9 00		      lda	#$00
   2115  fd76		       85 f5		      sta	ScoreTe
   2116  fd78				   .scoreInitDone
   2117  fd78
   2118  fd78							; --- Set up 6 digit pointers ---
   2119  fd78							; High bytes first (all $FD)
   2120  fd78		       a9 fd		      lda	#>DigitGfx
