   1163  f76d		       85 07		      sta	COLUP1
   1164  f76f		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1165  f771		       85 04		      sta	NUSIZ0
   1166  f773		       85 05		      sta	NUSIZ1
   1167  f775		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1168  f777		       85 25		      sta	VDELP0
   1169  f779		       85 26		      sta	VDELP1
   1170  f77b							; Flush both VDELP buffers + live registers to 0.
   1171  f77b							; Without this, stale buffer data from previous frame shows as
   1172  f77b							; white ghost copies during the positioning scanlines.
   1173  f77b		       a9 00		      lda	#0
   1174  f77d		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1175  f77f		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1176  f781		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1177  f783		       85 0b		      sta	REFP0
   1178  f785		       85 0c		      sta	REFP1
