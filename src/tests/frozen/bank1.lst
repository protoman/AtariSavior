   1277  f7f6		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1278  f7f8		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1279  f7fa		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1280  f7fc		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
