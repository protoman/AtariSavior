   1133  f769							; ====================================================================
   1134  f769							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1135  f769							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1136  f769							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1137  f769							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1138  f769							; ====================================================================
   1139  f769
   1140  f769							; --- Setup sprites ---
   1141  f769		       a9 0e		      lda	#$0E	; white
   1142  f76b		       85 06		      sta	COLUP0
   1143  f76d		       85 07		      sta	COLUP1
   1144  f76f		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1145  f771		       85 04		      sta	NUSIZ0
   1146  f773		       85 05		      sta	NUSIZ1
   1147  f775		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1148  f777		       85 25		      sta	VDELP0
   1149  f779		       85 26		      sta	VDELP1
   1150  f77b							; Flush both VDELP buffers + live registers to 0.
   1151  f77b							; Without this, stale buffer data from previous frame shows as
   1152  f77b							; white ghost copies during the positioning scanlines.
   1153  f77b		       a9 00		      lda	#0
   1154  f77d		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1155  f77f		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1156  f781		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1157  f783		       85 0b		      sta	REFP0
   1158  f785		       85 0c		      sta	REFP1
   1159  f787
   1160  f787							; --- Position P0 and P1 for interleaved 6-digit layout ---
   1161  f787							; P0 at pixel 60, P1 at pixel 68 (shifted 4px right to fix pipeline timing)
   1162  f787		       a9 3c		      lda	#60
   1163  f789		       a2 00		      ldx	#0
   1164  f78b		       20 f8 f7 	      jsr	SetObjectXPos_b1
   1165  f78e		       a9 44		      lda	#68
   1166  f790		       a2 01		      ldx	#1
