   2228  fd7c		       85 e3		      sta	scorePtr2+1
   2229  fd7e		       85 e5		      sta	scorePtr3+1
   2230  fd80		       85 e7		      sta	scorePtr4+1
   2231  fd82		       85 e9		      sta	scorePtr5+1
   2232  fd84		       85 eb		      sta	scorePtr6+1
   2233  fd86
   2234  fd86		       a5 f2		      lda	LevelShowTimer
   2235  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2236  fd8a		       f0 2e		      beq	.scoreLows
   2237  fd8c		       c6 f2		      dec	LevelShowTimer
   2238  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2239  fd90		       85 e0		      sta	scorePtr1
   2240  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2241  fd94		       85 e2		      sta	scorePtr2
   2242  fd96		       a9 00		      lda	#0	; hundreds '0'
