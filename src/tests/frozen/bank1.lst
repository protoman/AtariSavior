    520  f35a							; ==============================================================================
    521  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    522  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    523  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    524  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    525  f35a							;   byte = note_code*4 + duration_code
    526  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    527  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    528  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    529  f35a							; ==============================================================================
    530  f35a							; --- Melody state: BombX/BombTimer ($F6/$F7) ------------------------------
    531  f35a							; The theme plays ONLY on title frames, and on those frames the bomb block
    532  f35a							; never runs (DropTarget != 0 -> DropStep skips it), so the bomb's two bytes are
    533  f35a							; dead for exactly as long as the music is alive. Sharing them here frees
    534  f35a							; $9D/$9E, which the CAVE kernel needs on BOTH kinds of frame (the title
    535  f35a							; previews the stage with real room objects) — that is where the per-type
    536  f35a							; object height will live. Restart on return: the title-entry path zeroes both.
    537  f35a							; Contract: nothing may read BombX/BombTimer while a title frame is running.
    538  f35a		       00 f6	   MelPtr     =	$F6	; = kernel BombX   (dead on the title)
    539  f35a		       00 f7	   MelTimer   =	$F7	; = kernel BombTimer (dead on the title)
    540  f35a
    541  f35a				   MusicTick
    542  f35a		       a9 00		      lda	#0
    543  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    544  f35e		       a6 f6		      ldx	MelPtr
    545  f360		       a5 f7		      lda	MelTimer
    546  f362		       f0 0d		      beq	.MelLoad
    547  f364		       c6 f7		      dec	MelTimer
    548  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    549  f369							;   MelPtr already points at the NEXT step, so
    550  f369							;   this mirrors the pre-pack (duration,note)
    551  f369							;   player's MusicMel+1,X read, keeps the same
    552  f369							;   audible melody
    553  f369		       4a		      lsr
    554  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    555  f36b		       20 98 f3 	      jsr	MelApply
    556  f36e		       4c f8 fb 	      jmp	ReturnPad
    557  f371				   .MelLoad
    558  f371		       bd b0 f3 	      lda	MusicMel,X
    559  f374		       29 03		      and	#3
    560  f376		       a8		      tay
    561  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    562  f37a		       85 f7		      sta	MelTimer
    563  f37c		       bd b0 f3 	      lda	MusicMel,X
    564  f37f		       4a		      lsr
    565  f380		       4a		      lsr
    566  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    567  f383		       f0 0c		      beq	.MelLoop
    568  f385		       20 98 f3 	      jsr	MelApply
    569  f388		       8a		      txa
    570  f389		       18		      clc
    571  f38a		       69 01		      adc	#1
    572  f38c		       85 f6		      sta	MelPtr
    573  f38e		       4c f8 fb 	      jmp	ReturnPad
    574  f391				   .MelLoop
    575  f391		       a9 00		      lda	#0
    576  f393		       85 f6		      sta	MelPtr
    577  f395		       4c f8 fb 	      jmp	ReturnPad
    578  f398
    579  f398							; MelApply: A = note code. Starts the Lead at that pitch, or silences AUD0 on
    580  f398							; a rest ($3E). $3F (loop) HOLDS the tone the load frame started - the old
    581  f398							; paired player's `cmp #$FF / beq .MelDone` arm, kept for an identical melody.
    582  f398				   MelApply
    583  f398		       c9 3f		      cmp	#$3F
    584  f39a		       f0 13		      beq	.MAHold
    585  f39c		       c9 3e		      cmp	#$3E
    586  f39e		       f0 0b		      beq	.MAOff
    587  f3a0		       85 17		      sta	AUDF0
    588  f3a2		       a9 0c		      lda	#$0C	; Lead
    589  f3a4		       85 15		      sta	AUDC0
    590  f3a6		       a9 07		      lda	#7
    591  f3a8		       85 19		      sta	AUDV0
    592  f3aa		       60		      rts
    593  f3ab				   .MAOff
    594  f3ab		       a9 00		      lda	#0
    595  f3ad		       85 19		      sta	AUDV0
    596  f3af				   .MAHold
    597  f3af		       60		      rts
