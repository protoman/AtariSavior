   2100  fd7e		       85 e5		      sta	scorePtr3+1
   2101  fd80		       85 e7		      sta	scorePtr4+1
   2102  fd82		       85 e9		      sta	scorePtr5+1
   2103  fd84		       85 eb		      sta	scorePtr6+1
   2104  fd86
   2105  fd86		       a5 f2		      lda	LevelShowTimer
   2106  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2107  fd8a		       f0 2e		      beq	.scoreLows
   2108  fd8c		       c6 f2		      dec	LevelShowTimer
   2109  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2110  fd90		       85 e0		      sta	scorePtr1
   2111  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2112  fd94		       85 e2		      sta	scorePtr2
   2113  fd96		       a9 00		      lda	#0	; hundreds '0'
   2114  fd98		       85 e4		      sta	scorePtr3
   2115  fd9a		       a5 a3		      lda	Level
   2116  fd9c		       18		      clc
   2117  fd9d		       69 01		      adc	#1	; 1-based level number
   2118  fd9f		       a2 00		      ldx	#0
   2119  fda1				   .LVTens
