     47  f000							; --- power-up stub: the F6 latch powers up in an UNDEFINED bank on real
     48  f000							; hardware (Stella only randomises it with developer settings), so every
     49  f000							; bank must be able to start. This is 5 bytes on purpose: `sta $1FF6`
     50  f000							; switches to bank0, and the next fetch ($F005) then comes from BANK0,
     51  f000							; where a `jmp $F008` (GameStart) sits — the same 5-byte prefix bank2 and
     52  f000							; bank3 carry. Never shorten it to a bare `jmp`: that is what this bank had
     53  f000							; (a bank-select-less `jmp $F008` = BRK loop into zero fill).
     54  f000							; Guard: verify_build.check_boot_banks + tools/test_boot_banks.py.
     55  f000		       a9 00		      lda	#0
     56  f002		       8d f6 1f 	      sta	$1FF6	; select bank0 (hotspot: the DATA is ignored)
     57  f005
     58  f005							; --- ColOff/ColMask (plan 5.1b, 2026-10-20) ---
     59  f005							; The cell punch reads PF cells directly: PF0Buf/Y with ColOff,X (row
     60  f005							; base 0/3/6) and AND ColMask,X. Same 20-entry encoding as bank2's
     61  f005							; LaserWallClamp copy (cross-bank reads are impossible). These replace
     62  f005							; the ABW rect tables + BombMaskBit (the rect cache has no reader once
     63  f005							; the punch is cell-based). Parked in the $F003 fill gap, clear of the
     64  f005							; power-up stub's $F008 landing zone.
     65  f005		       00 00 00 00*	      .ds	$F010 - *, 0
     66  f010				   ColOff
     67  f010		       00 00 00 00*	      .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
     68  f024				   ColMask
     69  f024		       10 20 40 80*	      .byte.b	$10,$20,$40,$80, $80,$40,$20,$10,$08,$04,$02,$01
     70  f030		       01 02 04 08*	      .byte.b	$01,$02,$04,$08, $10,$20,$40,$80
     71  f038
