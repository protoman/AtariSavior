    734  f560							; ZP variables for score rendering (48-pixel sprite technique)
    735  f560		       00 e0	   scorePtr1  =	$E0	; pointer to digit 1 font data (hundred-thousands)
    736  f560		       00 e2	   scorePtr2  =	$E2	; pointer to digit 2 font data (ten-thousands)
    737  f560		       00 e4	   scorePtr3  =	$E4	; pointer to digit 3 font data (thousands)
