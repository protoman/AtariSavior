   1998  fc20							; CallPad tail pads (2026-10-20: SPLIT across the banks, no twin). kernel.asm
   1999  fc20							; holds the three `sta $1FF5` at $FC4F/$FC52/$FC55; after the switch the fetch
   2000  fc20							; at A+3 lands HERE, so bank1 keeps only the `jmp` halves. Nothing calls a
   2001  fc20							; tail pad from bank1, so bank1's `sta` halves and bank0's `jmp` halves were
   2002  fc20							; dead bytes — reclaiming them gave bank0 15 B of pre-pad headroom.
   2003  fc20							;   $FC52 <-$FC4F+3 CallPad_TitleSelect
   2004  fc20							;   $FC55 <-$FC52+3 CallPad_TitleBand
