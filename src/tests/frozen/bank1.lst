     47  f000							; --- power-up stub: the F6 latch powers up in an UNDEFINED bank on real
     48  f000							; hardware (Stella only randomises it with developer settings), so every
     49  f000							; bank must be able to start. This is 5 bytes on purpose: `sta $1FF6`
     50  f000							; switches to bank0, and the next fetch ($F005) then comes from BANK0,
     51  f000							; where a `jmp $F008` (GameStart) sits — the same 5-byte prefix bank2 and
     52  f000							; bank3 carry. Never shorten it to a bare `jmp`: that is what this bank had
     53  f000							; (a bank-select-less `jmp $F008` = BRK loop into zero fill).
     54  f000							; Guard: verify_build.check_boot_banks + tools/test_boot_banks.py.
     55  f000		       a9 00		      lda	#0
     56  f002		       8d f6 1f 	      sta	$1FF6	; select bank0 (hotspot: the DATA is ignored)
     57  f005
     58  f005							; --- ABW rect tables + BombMaskBit (relocated 2026-10-10) ---
     59  f005							; The BMW span-overlap fix grew the walk ~9B and overflowed the
     60  f005							; pre-$FBF8 content end ($FBF5, only 2B slack → Origin
     61  f005							; Reverse-indexed). Tables are abs-indexed from BombMarkWalls only,
     62  f005							; so they park in the $F003 fill gap (kept clear of the stub's
     63  f005							; $F008 landing zone). Recheck this gap if the power-up stub grows.
     64  f005		       00 00 00 00*	      .ds	$F010 - *, 0
     65  f010		       cc d0 d4 d8*ABWXTab    .byte.b	RcW1, RcW1+4, RcW1+8, RcW1+12, RcW1+16	; rect.x (EQU-derived S3.1)
     66  f015		       ce d2 d6 da*ABWWTab    .byte.b	RcW1+2, RcW1+6, RcW1+10, RcW1+14, RcW1+18	; rect.w
     67  f01a		       cd d1 d5 d9*ABWYTab    .byte.b	RcW1+1, RcW1+5, RcW1+9, RcW1+13, RcW1+17	; rect.y (plan 5.1 punch)
     68  f01f		       cf d3 d7 db*ABWHTab    .byte.b	RcW1+3, RcW1+7, RcW1+11, RcW1+15, RcW1+19	; rect.h
     69  f024				   BombMaskBit
     70  f024		       08 10 20 40*	      .byte.b	$08, $10, $20, $40, $00	; WallMask bit per rect index; idx4 =
     71  f029							;  $00 (rect4 never in WallMask — zp doc
     72  f029							;  S3.2) — PairGone guards its double-score
     73  f029							;  (kernel copy died with ApplyBombWalls)
     74  f029
     75  f029							; MothYDerive — moved from bank0 (leaf_move_plan Step 0, 2026-10-16). In
     76  f029							; Y = record+0, X = slot (preserved). Out A = live Y delta; the bank0
     77  f029							; caller then jmp DEYDelta (adds the ROM spawn y). Same math as old copy.
     78  f029				   MothYDerive
