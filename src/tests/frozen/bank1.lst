   1481  fa7c							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1482  fa7c							; ScoreTh/ScoreHu = binary 0-9; ScoreTe = packed BCD. Clobbers A.
   1483  fa7c							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1484  fa7c							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1485  fa7c							; (the 2026-09-23 decimal-mode rule). The old BINARY `cmp #$A0 / sbc #$A0`
   1486  fa7c							; fix-up missed nibble-level overflow: $25+$75 = $9A stored raw -> ones
   1487  fa7c							; digit A -> glyph index 10 -> DigitGfx+80 (past the 10-glyph font) =
   1488  fa7c							; the solid-block score digit (screenshots/score_issue_002.png).
   1489  fa7c							; C=1 = BCD carry (sum >= 100) -> ScoreHu path.
   1490  fa7c							; SIZE PIN: routine runs $FA7D..$FAA4 exactly (UpdateLaserSound's pad
   1491  fa7c							; target is $FAA5). Old head = clc/adc/cmp/bcc/sbc = 9 bytes, new head =
   1492  fa7c							; sed/clc/adc/cld/bcc = 7, so the two nops restore the exact length —
   1493  fa7c							; without them every pad below shifts silently.
   1494  fa7c				   AddScore
   1495  fa7c		       f8		      sed
   1496  fa7d		       18		      clc
   1497  fa7e		       65 f5		      adc	ScoreTe
   1498  fa80		       d8		      cld
   1499  fa81		       90 1c		      bcc	.ASstoreTe
   1500  fa83		       ea		      nop		; byte-pin (see SIZE PIN above)
   1501  fa84		       ea		      nop		; byte-pin
   1502  fa85		       48		      pha		; save wrapped ScoreTe
   1503  fa86		       e6 f4		      inc	ScoreHu
   1504  fa88		       a5 f4		      lda	ScoreHu
   1505  fa8a		       c9 0a		      cmp	#10
   1506  fa8c		       90 10		      bcc	.AShuOk
   1507  fa8e		       a9 00		      lda	#0
   1508  fa90		       85 f4		      sta	ScoreHu
   1509  fa92		       e6 f3		      inc	ScoreTh
   1510  fa94		       a5 f3		      lda	ScoreTh
   1511  fa96		       c9 0a		      cmp	#10
   1512  fa98		       90 04		      bcc	.ASthOk
   1513  fa9a		       a9 09		      lda	#9
   1514  fa9c		       85 f3		      sta	ScoreTh
   1515  fa9e				   .ASthOk
   1516  fa9e				   .AShuOk
   1517  fa9e		       68		      pla
   1518  fa9f				   .ASstoreTe
   1519  fa9f		       85 f5		      sta	ScoreTe
