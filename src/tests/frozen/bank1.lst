   1218  f7d0		       a9 00		      lda	#0
   1219  f7d2		       85 1b		      sta	GRP0
   1220  f7d4		       85 1c		      sta	GRP1
   1221  f7d6		       85 04		      sta	NUSIZ0
   1222  f7d8		       85 05		      sta	NUSIZ1
   1223  f7da		       85 25		      sta	VDELP0
   1224  f7dc		       85 26		      sta	VDELP1
   1225  f7de
   1226  f7de							; --- Restore cave kernel settings ---
   1227  f7de		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + 8-clk ball (cave mode
   1228  f7e0							; since D6 — bank1 bar overwrote $05 during its band)
   1229  f7e0		       85 0a		      sta	CTRLPF
   1230  f7e2		       a9 00		      lda	#0
   1231  f7e4		       85 04		      sta	NUSIZ0
   1232  f7e6		       a9 00		      lda	#0
   1233  f7e8		       85 05		      sta	NUSIZ1
   1234  f7ea		       85 25		      sta	VDELP0
   1235  f7ec		       85 26		      sta	VDELP1
