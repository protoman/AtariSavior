   2529  ff0f							; Tally entry tramp slice ($FFE6-$FFEB) — byte-identical with kernel.asm's
   2530  ff0f							; copy at the same address (F6 pad rule). bank0 executes `sta $1FF5` at
   2531  ff0f							; $FFE6-$FFE8; the fetch at $FFE9 comes from THIS bank = `jmp TallyEntry`
   2532  ff0f							; ($F44F — moved here from bank2, repack chunk 3, 2026-10-20). Neither bank
   2533  ff0f							; runs its other half. $FFF2-$FFF9 stay fill (hotspot mirrors).
   2534  ff0f							; ------------------------------------------------------------------------------
   2535  ff0f							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2536  ff0f							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2537  ff0f							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2538  ff0f							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2539  ff0f							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2540  ff0f							; once per banner frame. Lives in the $FF0F fill since the 6-digit score
   2541  ff0f							; (2026-10-27) outgrew its old slot ending at $FDE3 (jsr here from MenuMain).
   2542  ff0f				   SetupScorePointers
   2543  ff0f							; --- Initialize score to 0 on first frame ---
   2544  ff0f		       a5 ad		      lda	Temp
   2545  ff11		       d0 0c		      bne	.scoreInitDone
   2546  ff13		       e6 ad		      inc	Temp
   2547  ff15		       a9 00		      lda	#0
   2548  ff17		       85 f3		      sta	ScoreTh
   2549  ff19		       85 f4		      sta	ScoreHu
   2550  ff1b		       a9 00		      lda	#$00
   2551  ff1d		       85 f5		      sta	ScoreTe
   2552  ff1f				   .scoreInitDone
   2553  ff1f
   2554  ff1f							; --- Set up 6 digit pointers ---
   2555  ff1f							; High bytes first (all $FD)
   2556  ff1f		       a9 fd		      lda	#>DigitGfx
   2557  ff21		       85 e1		      sta	scorePtr1+1
   2558  ff23		       85 e3		      sta	scorePtr2+1
   2559  ff25		       85 e5		      sta	scorePtr3+1
   2560  ff27		       85 e7		      sta	scorePtr4+1
   2561  ff29		       85 e9		      sta	scorePtr5+1
   2562  ff2b		       85 eb		      sta	scorePtr6+1
   2563  ff2d
   2564  ff2d		       a5 f2		      lda	LevelShowTimer
   2565  ff2f		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2566  ff31		       f0 1f		      beq	.scoreLows
   2567  ff33		       c6 f2		      dec	LevelShowTimer
   2568  ff35		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2569  ff37		       85 e0		      sta	scorePtr1
   2570  ff39		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2571  ff3b		       85 e2		      sta	scorePtr2
   2572  ff3d		       a9 00		      lda	#0	; hundreds '0'
   2573  ff3f		       85 e4		      sta	scorePtr3
   2574  ff41		       a6 a3		      ldx	Level	; 0-based; tables hold the 1-based number's digits * 8
   2575  ff43		       bd 05 f8 	      lda	LvOnes8,X	; (a div-10 loop cost +12c per tens digit: level 20's
   2576  ff46		       85 e8		      sta	scorePtr5	;  banner ran a whole scanline long, 273-line frames)
   2577  ff48		       bd 19 f8 	      lda	LvTens8,X
   2578  ff4b		       85 e6		      sta	scorePtr4
   2579  ff4d		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2580  ff4f		       85 ea		      sta	scorePtr6
   2581  ff51		       60		      rts
   2582  ff52
   2583  ff52				   .scoreLows
   2584  ff52							; Three packed-BCD bytes -> six digit pointers (hi nibble, lo nibble each):
   2585  ff52							; ScoreTh = ptr1/ptr2 (100k, 10k), ScoreHu = ptr3/ptr4, ScoreTe = ptr5/ptr6.
   2586  ff52							; Unrolled on purpose: hi digit * 8 = (b & $F0) >> 1, lo digit * 8 = (b & $0F) << 3.
   2587  ff52		       a5 f3		      lda	ScoreTh
