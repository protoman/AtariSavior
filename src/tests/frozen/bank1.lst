    446  f35a							; ==============================================================================
    447  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    448  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    449  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    450  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    451  f35a							;   byte = note_code*4 + duration_code
    452  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    453  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    454  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    455  f35a							; ==============================================================================
    456  f35a		       00 9d	   MelPtr     =	$9D
    457  f35a		       00 9e	   MelTimer   =	$9E
    458  f35a
    459  f35a				   MusicTick
    460  f35a		       a9 00		      lda	#0
    461  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    462  f35e		       a6 9d		      ldx	MelPtr
    463  f360		       a5 9e		      lda	MelTimer
    464  f362		       f0 0d		      beq	.MelLoad
    465  f364		       c6 9e		      dec	MelTimer
    466  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    467  f369							;   MelPtr already points at the NEXT step, so
    468  f369							;   this mirrors the pre-pack (duration,note)
    469  f369							;   player's MusicMel+1,X read, keeps the same
    470  f369							;   audible melody
    471  f369		       4a		      lsr
    472  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    473  f36b		       20 98 f3 	      jsr	MelApply
    474  f36e		       4c f8 fb 	      jmp	ReturnPad
    475  f371				   .MelLoad
    476  f371		       bd b0 f3 	      lda	MusicMel,X
    477  f374		       29 03		      and	#3
    478  f376		       a8		      tay
    479  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    480  f37a		       85 9e		      sta	MelTimer
    481  f37c		       bd b0 f3 	      lda	MusicMel,X
    482  f37f		       4a		      lsr
    483  f380		       4a		      lsr
    484  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    485  f383		       f0 0c		      beq	.MelLoop
    486  f385		       20 98 f3 	      jsr	MelApply
    487  f388		       8a		      txa
    488  f389		       18		      clc
