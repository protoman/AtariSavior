   2459  fe90		       4a		      lsr
   2460  fe91		       20 75 f8 	      jsr	RaftCellSolid
   2461  fe94		       d0 dd		      bne	.RaftTurn
   2462  fe96		       b5 bd		      lda	EnemyRamX,X
