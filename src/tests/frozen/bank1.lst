   2147  fd7c		       85 e3		      sta	scorePtr2+1
   2148  fd7e		       85 e5		      sta	scorePtr3+1
   2149  fd80		       85 e7		      sta	scorePtr4+1
   2150  fd82		       85 e9		      sta	scorePtr5+1
   2151  fd84		       85 eb		      sta	scorePtr6+1
   2152  fd86
   2153  fd86		       a5 f2		      lda	LevelShowTimer
   2154  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2155  fd8a		       f0 2e		      beq	.scoreLows
   2156  fd8c		       c6 f2		      dec	LevelShowTimer
   2157  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2158  fd90		       85 e0		      sta	scorePtr1
   2159  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2160  fd94		       85 e2		      sta	scorePtr2
   2161  fd96		       a9 00		      lda	#0	; hundreds '0'
   2162  fd98		       85 e4		      sta	scorePtr3
   2163  fd9a		       a5 a3		      lda	Level
   2164  fd9c		       18		      clc
   2165  fd9d		       69 01		      adc	#1	; 1-based level number
   2166  fd9f		       a2 00		      ldx	#0
   2167  fda1				   .LVTens
   2168  fda1		       c9 0a		      cmp	#10
   2169  fda3		       90 05		      bcc	.LVTensDone
   2170  fda5		       e9 0a		      sbc	#10
   2171  fda7		       e8		      inx
   2172  fda8		       d0 f7		      bne	.LVTens
   2173  fdaa				   .LVTensDone
   2174  fdaa		       0a		      asl
   2175  fdab		       0a		      asl
   2176  fdac		       0a		      asl		; ones * 8
   2177  fdad		       85 e8		      sta	scorePtr5
   2178  fdaf		       8a		      txa
   2179  fdb0		       0a		      asl
   2180  fdb1		       0a		      asl
   2181  fdb2		       0a		      asl		; tens * 8
   2182  fdb3		       85 e6		      sta	scorePtr4
   2183  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2184  fdb7		       85 ea		      sta	scorePtr6
   2185  fdb9		       60		      rts
   2186  fdba
   2187  fdba							; scorePtr1..2 = leading zeros
   2188  fdba				   .scoreLows
   2189  fdba		       a9 00		      lda	#0
   2190  fdbc		       85 e0		      sta	scorePtr1
   2191  fdbe		       85 e2		      sta	scorePtr2
   2192  fdc0
   2193  fdc0							; scorePtr3 = ScoreTh * 8
   2194  fdc0		       a5 f3		      lda	ScoreTh
   2195  fdc2		       0a		      asl
   2196  fdc3		       0a		      asl
   2197  fdc4		       0a		      asl
   2198  fdc5		       85 e4		      sta	scorePtr3
   2199  fdc7
   2200  fdc7							; scorePtr4 = ScoreHu * 8
