     84  f042		       49 0f		      eor	#15
     85  f044				   .mUpB1
     86  f044		       c9 07		      cmp	#7
     87  f046		       90 02		      bcc	.mOkB1
     88  f048		       a9 06		      lda	#6
     89  f04a				   .mOkB1
     90  f04a		       0a		      asl
     91  f04b		       69 fa		      adc	#$FA
     92  f04d		       4c f8 fb 	      jmp	ReturnPad
