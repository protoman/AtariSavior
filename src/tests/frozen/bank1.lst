    949  f5de		       a9 1c		      lda	#$1C
    950  f5e0		       85 08		      sta	COLUPF
    951  f5e2		       a6 ee		      ldx	DelayCnt
    952  f5e4		       f0 03		      beq	.RF2
    953  f5e6				   .BF2
    954  f5e6		       ca		      dex
