   2210  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2211  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2212  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2213  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2214  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2215  fd68							; once per banner frame. Lives with the glyphs (bank1's pre-pad region is
   2216  fd68							; tight; the score section is a jsr here from MenuMain).
   2217  fd68				   SetupScorePointers
   2218  fd68							; --- Initialize score to 0 on first frame ---
   2219  fd68		       a5 ad		      lda	Temp
   2220  fd6a		       d0 0c		      bne	.scoreInitDone
   2221  fd6c		       e6 ad		      inc	Temp
   2222  fd6e		       a9 00		      lda	#0
   2223  fd70		       85 f3		      sta	ScoreTh
   2224  fd72		       85 f4		      sta	ScoreHu
   2225  fd74		       a9 00		      lda	#$00
   2226  fd76		       85 f5		      sta	ScoreTe
   2227  fd78				   .scoreInitDone
   2228  fd78
   2229  fd78							; --- Set up 6 digit pointers ---
   2230  fd78							; High bytes first (all $FD)
   2231  fd78		       a9 fd		      lda	#>DigitGfx
   2232  fd7a		       85 e1		      sta	scorePtr1+1
   2233  fd7c		       85 e3		      sta	scorePtr2+1
   2234  fd7e		       85 e5		      sta	scorePtr3+1
   2235  fd80		       85 e7		      sta	scorePtr4+1
   2236  fd82		       85 e9		      sta	scorePtr5+1
   2237  fd84		       85 eb		      sta	scorePtr6+1
   2238  fd86
   2239  fd86		       a5 f2		      lda	LevelShowTimer
   2240  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2241  fd8a		       f0 2e		      beq	.scoreLows
   2242  fd8c		       c6 f2		      dec	LevelShowTimer
   2243  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2244  fd90		       85 e0		      sta	scorePtr1
   2245  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2246  fd94		       85 e2		      sta	scorePtr2
   2247  fd96		       a9 00		      lda	#0	; hundreds '0'
   2248  fd98		       85 e4		      sta	scorePtr3
   2249  fd9a		       a5 a3		      lda	Level
   2250  fd9c		       18		      clc
   2251  fd9d		       69 01		      adc	#1	; 1-based level number
   2252  fd9f		       a2 00		      ldx	#0
   2253  fda1				   .LVTens
   2254  fda1		       c9 0a		      cmp	#10
   2255  fda3		       90 05		      bcc	.LVTensDone
   2256  fda5		       e9 0a		      sbc	#10
   2257  fda7		       e8		      inx
   2258  fda8		       d0 f7		      bne	.LVTens
   2259  fdaa				   .LVTensDone
   2260  fdaa		       0a		      asl
   2261  fdab		       0a		      asl
   2262  fdac		       0a		      asl		; ones * 8
   2263  fdad		       85 e8		      sta	scorePtr5
   2264  fdaf		       8a		      txa
   2265  fdb0		       0a		      asl
   2266  fdb1		       0a		      asl
   2267  fdb2		       0a		      asl		; tens * 8
   2268  fdb3		       85 e6		      sta	scorePtr4
   2269  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2270  fdb7		       85 ea		      sta	scorePtr6
   2271  fdb9		       60		      rts
   2272  fdba
