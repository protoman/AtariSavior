   1227  f7ea							; ====================================================================
   1228  f7ea							; Pad remaining scanlines to reach exactly 48 total
   1229  f7ea							; Path A (PlayerLives > 0) — execution count:
   1230  f7ea							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1231  f7ea							;   Timer:    3 loop + 1 gap = 4
   1232  f7ea							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1233  f7ea							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1234  f7ea							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1235  f7ea							;   Subtotal: 6+4+8+11+10 = 39
   1236  f7ea							;   Pad:      48 - 39 = 9
   1237  f7ea							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1238  f7ea							; ====================================================================
   1239  f7ea		       a2 09		      ldx	#9
