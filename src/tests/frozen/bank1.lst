    595  f44f		       a5 8a		      lda	DropTarget
    596  f451		       f0 36		      beq	.TEArm
    597  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    598  f455		       d0 2d		      bne	.TEIdle
    599  f457		       a9 04		      lda	#4
    600  f459		       85 ad		      sta	TickCounter
    601  f45b		       c6 f2		      dec	TallyTicks
    602  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    603  f45f		       a5 f2		      lda	TallyTicks
    604  f461		       29 03		      and	#3
    605  f463		       d0 15		      bne	.TEOne	; tick only
    606  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    607  f467		       85 f1		      sta	BombSnd
    608  f469		       a9 04		      lda	#4
    609  f46b		       85 15		      sta	AUDC0	; square
    610  f46d		       a9 18		      lda	#24
    611  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    612  f471		       a9 08		      lda	#8
    613  f473		       85 19		      sta	AUDV0
    614  f475		       a9 03		      lda	#3	; tick + coin
    615  f477		       4c f8 fb 	      jmp	ReturnPad
    616  f47a				   .TEOne
    617  f47a		       a9 01		      lda	#1	; tick only
    618  f47c		       4c f8 fb 	      jmp	ReturnPad
    619  f47f				   .TEFinal
    620  f47f		       a9 07		      lda	#7	; tick + coin + done
    621  f481		       4c f8 fb 	      jmp	ReturnPad
    622  f484				   .TEIdle
    623  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    624  f486		       4c f8 fb 	      jmp	ReturnPad
    625  f489				   .TEArm
    626  f489		       a5 ae		      lda	BarLevel
    627  f48b		       18		      clc
    628  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    629  f48e		       a2 00		      ldx	#0
