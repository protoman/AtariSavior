   1605  faa8		       a5 c0		      lda	LaserState
   1606  faaa		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1607  faac		       a5 c2		      lda	EnemyRamP
   1608  faae		       4a		      lsr
   1609  faaf		       4a		      lsr
   1610  fab0		       4a		      lsr		; /8 frames per sweep step
   1611  fab1		       29 07		      and	#7
   1612  fab3		       aa		      tax
   1613  fab4		       bd c4 fa 	      lda	LaserFreqTable,X
   1614  fab7		       85 17		      sta	AUDF0
   1615  fab9		       a9 02		      lda	#LASER_AUD_C
   1616  fabb		       85 15		      sta	AUDC0
   1617  fabd		       a9 09		      lda	#LASER_AUD_V
   1618  fabf		       85 19		      sta	AUDV0
   1619  fac1				   .ULSOut
   1620  fac1		       4c f8 fb 	      jmp	ReturnPad
