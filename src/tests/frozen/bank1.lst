    446  f35a							; ==============================================================================
    447  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    448  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    449  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    450  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    451  f35a							;   byte = note_code*4 + duration_code
    452  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    453  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    454  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    455  f35a							; ==============================================================================
    456  f35a							; --- Melody state: BombX/BombTimer ($F6/$F7) ------------------------------
    457  f35a							; The theme plays ONLY on title frames, and on those frames the bomb block
    458  f35a							; never runs (DropTarget != 0 -> DropStep skips it), so the bomb's two bytes are
    459  f35a							; dead for exactly as long as the music is alive. Sharing them here frees
    460  f35a							; $9D/$9E, which the CAVE kernel needs on BOTH kinds of frame (the title
    461  f35a							; previews the stage with real room objects) — that is where the per-type
    462  f35a							; object height will live. Restart on return: the title-entry path zeroes both.
    463  f35a							; Contract: nothing may read BombX/BombTimer while a title frame is running.
    464  f35a		       00 f6	   MelPtr     =	$F6	; = kernel BombX   (dead on the title)
    465  f35a		       00 f7	   MelTimer   =	$F7	; = kernel BombTimer (dead on the title)
    466  f35a
    467  f35a				   MusicTick
    468  f35a		       a9 00		      lda	#0
    469  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    470  f35e		       a6 f6		      ldx	MelPtr
    471  f360		       a5 f7		      lda	MelTimer
    472  f362		       f0 0d		      beq	.MelLoad
    473  f364		       c6 f7		      dec	MelTimer
    474  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    475  f369							;   MelPtr already points at the NEXT step, so
    476  f369							;   this mirrors the pre-pack (duration,note)
    477  f369							;   player's MusicMel+1,X read, keeps the same
    478  f369							;   audible melody
    479  f369		       4a		      lsr
    480  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    481  f36b		       20 98 f3 	      jsr	MelApply
    482  f36e		       4c f8 fb 	      jmp	ReturnPad
    483  f371				   .MelLoad
    484  f371		       bd b0 f3 	      lda	MusicMel,X
    485  f374		       29 03		      and	#3
    486  f376		       a8		      tay
    487  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    488  f37a		       85 f7		      sta	MelTimer
    489  f37c		       bd b0 f3 	      lda	MusicMel,X
    490  f37f		       4a		      lsr
    491  f380		       4a		      lsr
    492  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    493  f383		       f0 0c		      beq	.MelLoop
    494  f385		       20 98 f3 	      jsr	MelApply
    495  f388		       8a		      txa
    496  f389		       18		      clc
    497  f38a		       69 01		      adc	#1
    498  f38c		       85 f6		      sta	MelPtr
    499  f38e		       4c f8 fb 	      jmp	ReturnPad
    500  f391				   .MelLoop
    501  f391		       a9 00		      lda	#0
    502  f393		       85 f6		      sta	MelPtr
    503  f395		       4c f8 fb 	      jmp	ReturnPad
    504  f398
    505  f398							; MelApply: A = note code. Starts the Lead at that pitch, or silences AUD0 on
    506  f398							; a rest ($3E). $3F (loop) HOLDS the tone the load frame started - the old
    507  f398							; paired player's `cmp #$FF / beq .MelDone` arm, kept for an identical melody.
    508  f398				   MelApply
    509  f398		       c9 3f		      cmp	#$3F
    510  f39a		       f0 13		      beq	.MAHold
    511  f39c		       c9 3e		      cmp	#$3E
    512  f39e		       f0 0b		      beq	.MAOff
    513  f3a0		       85 17		      sta	AUDF0
    514  f3a2		       a9 0c		      lda	#$0C	; Lead
    515  f3a4		       85 15		      sta	AUDC0
    516  f3a6		       a9 07		      lda	#7
    517  f3a8		       85 19		      sta	AUDV0
    518  f3aa		       60		      rts
    519  f3ab				   .MAOff
    520  f3ab		       a9 00		      lda	#0
    521  f3ad		       85 19		      sta	AUDV0
    522  f3af				   .MAHold
    523  f3af		       60		      rts
