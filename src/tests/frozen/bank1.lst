   2121  fda3		       90 05		      bcc	.LVTensDone
   2122  fda5		       e9 0a		      sbc	#10
   2123  fda7		       e8		      inx
   2124  fda8		       d0 f7		      bne	.LVTens
   2125  fdaa				   .LVTensDone
   2126  fdaa		       0a		      asl
   2127  fdab		       0a		      asl
   2128  fdac		       0a		      asl		; ones * 8
   2129  fdad		       85 e8		      sta	scorePtr5
   2130  fdaf		       8a		      txa
   2131  fdb0		       0a		      asl
   2132  fdb1		       0a		      asl
   2133  fdb2		       0a		      asl		; tens * 8
   2134  fdb3		       85 e6		      sta	scorePtr4
   2135  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2136  fdb7		       85 ea		      sta	scorePtr6
   2137  fdb9		       60		      rts
   2138  fdba
   2139  fdba							; scorePtr1..2 = leading zeros
   2140  fdba				   .scoreLows
   2141  fdba		       a9 00		      lda	#0
   2142  fdbc		       85 e0		      sta	scorePtr1
   2143  fdbe		       85 e2		      sta	scorePtr2
   2144  fdc0
   2145  fdc0							; scorePtr3 = ScoreTh * 8
   2146  fdc0		       a5 f3		      lda	ScoreTh
   2147  fdc2		       0a		      asl
   2148  fdc3		       0a		      asl
   2149  fdc4		       0a		      asl
   2150  fdc5		       85 e4		      sta	scorePtr3
