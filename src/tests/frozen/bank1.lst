   1203  f808							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1204  f808							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1205  f808							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1206  f808							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1207  f808							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1208  f808							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1209  f808				   BarDelayTable		; (B+7)>>3, 15 entries
   1210  f808		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1211  f817				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1212  f817		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
   1213  f826
   1214  f826							; ------------------------------------------------------------------------------
   1215  f826
   1216  f826							; ==============================================================================
   1217  f826							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1218  f826							; ==============================================================================
   1219  f826							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1220  f826							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1221  f826							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1222  f826							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1223  f826							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1224  f826							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1225  f826							; TickCounter — writing that would stall the game timer).
   1226  f826							;
   1227  f826							; User spec 2026-10-18: floats only on water; carries the player across and
   1228  f826							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1229  f826							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1230  f826							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1231  f826							;	       into CollisionX, kernel draws the strip as the band's last
   1232  f826							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1233  f826							;	       row sits exactly on the moving surface — it rides the wave the
   1234  f826							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1235  f826							;	       stays clear of the 125 water-kill line at every tide phase.
   1236  f826							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1237  f826							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1238  f826							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1239  f826							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1240  f826							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1241  f826							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1242  f826							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1243  f826							;	       flag+level, so the empty raft runs at full speed and the next
   1244  f826							;	       take-off ramps again. It also holds the frame it turns around on.
   1245  f826							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1246  f826							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1247  f826							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1248  f826							;	       exactly the open water span of the room.
   1249  f826							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1250  f826							;	       its upper rows; step off and it parks immediately (the ramp state
   1251  f826							;	       is cleared too, so the next take-off ramps again). While over it a
   1252  f826							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1253  f826							;	       zeroed (gravity must never accumulate into the water) and carried
   1254  f826							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1255  f826							;	       flying off is always possible. Leaving and re-entering the ROOM
   1256  f826							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1257  f826							;	       it), which is the "reset" the user asked for.
   1258  f826							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1259  f826							; ==============================================================================
   1260  f826							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1261  f826							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1262  f826							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1263  f826							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1264  f826							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1265  f826							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1266  f826							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1267  f826							;   cols 20-39 -> the mirrored half: source = 39-col
   1268  f826				   RaftCellSolid
   1269  f826		       c9 14		      cmp	#20
   1270  f828		       90 05		      bcc	.RCSrc
   1271  f82a		       49 ff		      eor	#$ff
   1272  f82c		       18		      clc
   1273  f82d		       69 28		      adc	#40
   1274  f82f				   .RCSrc
   1275  f82f		       a8		      tay
   1276  f830		       b9 48 f8 	      lda	RaftCellMasks,Y
   1277  f833		       c0 04		      cpy	#4
   1278  f835		       b0 03		      bcs	.RCPF1
   1279  f837		       25 c5		      and	$C5
   1280  f839		       60		      rts
   1281  f83a				   .RCPF1
   1282  f83a		       c0 0c		      cpy	#12
   1283  f83c		       b0 03		      bcs	.RCPF2
   1284  f83e		       25 c8		      and	$C8
   1285  f840		       60		      rts
   1286  f841				   .RCPF2
   1287  f841		       25 cb		      and	$CB
   1288  f843		       60		      rts
   1289  f844
   1290  f844				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1291  f844		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1292  f848
   1293  f848				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1294  f848		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1295  f84c		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1296  f850		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1297  f854		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1298  f858		       10 20 40 80	      .byte.b	$10, $20, $40, $80
   1299  f85c							; ------------------------------------------------------------------------------
   1300  f85c							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1301  f85c							; verify_build.check_raft_tramp). bank0 executes `sta $1FF7` at $F8C0-$F8C2 and
   1302  f85c							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1303  f85c							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1304  f85c							; `sta $1FF7` is never executed (it is only the swapped-out image's prefix).
   1305  f85c							; In bank1's $F822-$F936 fill, so the $F937 pin does not move.
   1306  f85c							; ------------------------------------------------------------------------------
   1307  f85c		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1308  f8c0		       8d f7 1f 	      .byte.b	$8D, $F7, $1F	; sta $1FF7 (twin)
   1309  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1310  f8c6
   1311  f8c6		       00 00 00 00*	      .ds	$F937 - *, 0	; pinned: bank2 M1StripBlast back-jmp operand
   1312  f937							; ($F937) — test_bomb_strip asserts both literals
   1313  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1314  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1315  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1316  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1317  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1318  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1319  f937							; Every exit ends in ReturnPad with A = count.
   1320  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1321  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1322  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1323  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1324  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1325  f937							; inc the count (caller's +75 loop scores it). The
   1326  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1327  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1328  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1329  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1330  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1331  f937							; ------------------------------------------------------------------------------
   1332  f937				   StripBlastCheck
   1333  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1334  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1335  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1336  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1337  f937							; sets b3/b4 instead.
   1338  f937		       a5 92		      lda	RectCount
   1339  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1340  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1341  f93d		       c5 92		      cmp	RectCount
   1342  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1343  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1344  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1345  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1346  f947		       c9 02		      cmp	#2
   1347  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1348  f94b							;   (A=0/1 falls into take = overlap)
   1349  f94b				   .SBleftTake
   1350  f94b		       a5 ba		      lda	EnemyDeadMask
   1351  f94d		       29 10		      and	#$10
   1352  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1353  f951		       a9 10		      lda	#$10
   1354  f953		       05 ba		      ora	EnemyDeadMask
   1355  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1356  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1357  f959				   .SBright
   1358  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1359  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1360  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1361  f959		       18		      clc
   1362  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1363  f95c		       49 ff		      eor	#$FF
   1364  f95e		       69 28		      adc	#40	; hi_r = 39-lo_l
   1365  f960		       a8		      tay
   1366  f961		       18		      clc
   1367  f962		       a5 8c		      lda	CollisionCellX	; hi_l
