   1247  f776							; --- Setup sprites ---
   1248  f776		       a9 0e		      lda	#$0E	; white
   1249  f778		       85 06		      sta	COLUP0
   1250  f77a		       85 07		      sta	COLUP1
   1251  f77c		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1252  f77e		       85 04		      sta	NUSIZ0
   1253  f780		       85 05		      sta	NUSIZ1
   1254  f782		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1255  f784		       85 25		      sta	VDELP0
   1256  f786		       85 26		      sta	VDELP1
   1257  f788							; Flush both VDELP buffers + live registers to 0.
   1258  f788							; Without this, stale buffer data from previous frame shows as
   1259  f788							; white ghost copies during the positioning scanlines.
   1260  f788		       a9 00		      lda	#0
   1261  f78a		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1262  f78c		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1263  f78e		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1264  f790		       85 0b		      sta	REFP0
   1265  f792		       85 0c		      sta	REFP1
