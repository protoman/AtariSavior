   1361  f860							; ==============================================================================
   1362  f860							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1363  f860							; ==============================================================================
   1364  f860							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF5 / jmp $F822) -> here;
   1365  f860							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1366  f860							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1367  f860							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1368  f860							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1369  f860							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1370  f860							; TickCounter — writing that would stall the game timer).
   1371  f860							;
   1372  f860							; User spec 2026-10-18: floats only on water; carries the player across and
   1373  f860							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1374  f860							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1375  f860							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1376  f860							;	       into CollisionX, kernel draws the strip as the band's last
   1377  f860							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1378  f860							;	       row sits exactly on the moving surface — it rides the wave the
   1379  f860							;	       water does. The rider's pin (top-22 = 103+off, worst case 106)
   1380  f860							;	       stays clear of the 125 water-kill line at every tide phase.
   1381  f860							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1382  f860							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1383  f860							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1384  f860							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1385  f860							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1386  f860							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1387  f860							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1388  f860							;	       flag+level, so the empty raft runs at full speed and the next
   1389  f860							;	       take-off ramps again. It also holds the frame it turns around on.
   1390  f860							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1391  f860							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1392  f860							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1393  f860							;	       exactly the open water span of the room.
   1394  f860							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1395  f860							;	       its upper rows; step off and it parks immediately (the ramp state
   1396  f860							;	       is cleared too, so the next take-off ramps again). While over it a
   1397  f860							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1398  f860							;	       zeroed (gravity must never accumulate into the water) and carried
   1399  f860							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1400  f860							;	       flying off is always possible. Leaving and re-entering the ROOM
   1401  f860							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1402  f860							;	       it), which is the "reset" the user asked for.
   1403  f860							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1404  f860							; ==============================================================================
   1405  f860							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1406  f860							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1407  f860							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1408  f860							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1409  f860							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1410  f860							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1411  f860							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1412  f860							;   cols 20-39 -> the mirrored half: source = 39-col
   1413  f860				   RaftCellSolid
   1414  f860		       c9 14		      cmp	#20
   1415  f862		       90 05		      bcc	.RCSrc
   1416  f864		       49 ff		      eor	#$ff
   1417  f866		       18		      clc
   1418  f867		       69 28		      adc	#40
   1419  f869				   .RCSrc
   1420  f869		       a8		      tay
   1421  f86a		       b9 82 f8 	      lda	RaftCellMasks,Y
   1422  f86d		       c0 04		      cpy	#4
   1423  f86f		       b0 03		      bcs	.RCPF1
   1424  f871		       25 c5		      and	$C5
   1425  f873		       60		      rts
   1426  f874				   .RCPF1
   1427  f874		       c0 0c		      cpy	#12
   1428  f876		       b0 03		      bcs	.RCPF2
   1429  f878		       25 c8		      and	$C8
   1430  f87a		       60		      rts
   1431  f87b				   .RCPF2
   1432  f87b		       25 cb		      and	$CB
   1433  f87d		       60		      rts
   1434  f87e
   1435  f87e				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1436  f87e		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1437  f882
   1438  f882				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1439  f882		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1440  f886		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1441  f88a		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1442  f88e		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1443  f892		       10 20 40 80	      .byte.b	$10, $20, $40, $80
   1444  f896							; ------------------------------------------------------------------------------
   1445  f896							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1446  f896							; verify_build.check_raft_tramp). bank0 executes `sta $1FF5` at $F8C0-$F8C2 and
   1447  f896							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1448  f896							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1449  f896							; `sta $1FF5` is never executed (it is only the swapped-out image's prefix).
   1450  f896							; In bank1's $F822-$F8C6 fill; StripBlastCheck follows it directly ($F937 pin
   1451  f896							; deleted 2026-10-20 — the body floats and the $F9AC pin bounds the leaves).
   1452  f896							; ------------------------------------------------------------------------------
   1453  f896		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1454  f8c0		       8d f5 1f 	      .byte.b	$8D, $F5, $1F	; sta $1FF5 (twin)
   1455  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1456  f8c6
   1457  f8c6							; ($F937 pin DELETED 2026-10-20, audit round 2: it pinned bank2's
   1458  f8c6							;  M1StripBlast back-jmp operand, and that body is same-bank now — the chain
   1459  f8c6							;  is .BMWDone -> M1StripBlast -> StripBlastCheck inside bank1, so
   1460  f8c6							;  StripBlastCheck is reached by label and floats. It now starts right after
   1461  f8c6							;  the raft tramp twin; the $F9AC pin still bounds the sound-leaf block.)
   1462  f8c6							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1463  f8c6							; from BombMarkWalls .BMWDone through M1StripBlast (same bank, label `jmp`s
   1464  f8c6							; — repack chunk 2; 0 pushes, no switch). Still 0 pushes (the jsr+pha
   1465  f8c6							; version measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1466  f8c6							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1467  f8c6							; Every exit ends in ReturnPad with A = count.
   1468  f8c6							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1469  f8c6							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1470  f8c6							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1471  f8c6							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1472  f8c6							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1473  f8c6							; inc the count (caller's +75 loop scores it). The
   1474  f8c6							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1475  f8c6							; lifecycle as WallMask holes (D1-B). P2b door models never
   1476  f8c6							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1477  f8c6							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1478  f8c6							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1479  f8c6							; ------------------------------------------------------------------------------
   1480  f8c6				   StripBlastCheck
   1481  f8c6							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1482  f8c6							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1483  f8c6							; Window is still LEFT-half here (the mirror below). Door models stage
   1484  f8c6							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1485  f8c6							; sets b3/b4 instead.
   1486  f8c6		       a5 92		      lda	RectCount
   1487  f8c8		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1488  f8ca		       a5 8c		      lda	CollisionCellX	; blast hi
   1489  f8cc		       c5 92		      cmp	RectCount
   1490  f8ce		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1491  f8d0		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1492  f8d2		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1493  f8d4		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1494  f8d6		       c9 02		      cmp	#2
   1495  f8d8		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1496  f8da							;   (A=0/1 falls into take = overlap)
   1497  f8da				   .SBleftTake
   1498  f8da		       a5 ba		      lda	EnemyDeadMask
   1499  f8dc		       29 10		      and	#$10
   1500  f8de		       d0 08		      bne	.SBright	; already destroyed → no double score
   1501  f8e0		       a9 10		      lda	#$10
   1502  f8e2		       05 ba		      ora	EnemyDeadMask
   1503  f8e4		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1504  f8e6		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1505  f8e8				   .SBright
   1506  f8e8							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1507  f8e8							; window here (space is free in this gap): lo_r = 39-hi_l,
   1508  f8e8							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1509  f8e8		       18		      clc
   1510  f8e9		       a5 8e		      lda	CollisionEndX	; lo_l
   1511  f8eb		       49 ff		      eor	#$FF
   1512  f8ed		       69 28		      adc	#40	; hi_r = 39-lo_l
   1513  f8ef		       a8		      tay
   1514  f8f0		       18		      clc
   1515  f8f1		       a5 8c		      lda	CollisionCellX	; hi_l
   1516  f8f3		       49 ff		      eor	#$FF
   1517  f8f5		       69 28		      adc	#40	; lo_r = 39-hi_l
   1518  f8f7		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1519  f8f9		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1520  f8fb		       a5 8c		      lda	CollisionCellX	; hi
   1521  f8fd		       38		      sec
   1522  f8fe		       e5 88		      sbc	BMWScratch	; hi - pL
   1523  f900		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1524  f902		       a5 8e		      lda	CollisionEndX	; lo
   1525  f904		       c5 88		      cmp	BMWScratch
   1526  f906		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1527  f908		       f0 07		      beq	.SBtake	; lo == pL
   1528  f90a		       38		      sec
   1529  f90b		       e9 01		      sbc	#1
   1530  f90d		       c5 88		      cmp	BMWScratch
   1531  f90f		       d0 0e		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1532  f911				   .SBtake
   1533  f911		       a5 ba		      lda	EnemyDeadMask
   1534  f913		       29 08		      and	#$08
   1535  f915		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1536  f917		       a9 08		      lda	#$08
   1537  f919		       05 ba		      ora	EnemyDeadMask
   1538  f91b		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1539  f91d		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1540  f91f				   .SBdone
   1541  f91f		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1542  f921		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
