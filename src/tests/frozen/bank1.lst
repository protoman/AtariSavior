   2509  fea3				   .RaftRide
   2510  fea3							; (the Y pin ran at .RaftGo — it must not depend on the raft moving)
   2511  fea3							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2512  fea3		       a5 f0		      lda	$F0
   2513  fea5		       09 80		      ora	#%10000000
   2514  fea7		       85 f0		      sta	$F0
   2515  fea9		       a5 c2		      lda	EnemyRamP
   2516  feab		       4a		      lsr		; C = the frame-parity bit
   2517  feac		       b0 0f		      bcs	.RaftCarry	; odd frame: flag only this time
   2518  feae		       a5 f0		      lda	$F0
