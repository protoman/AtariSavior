   2418  fe49		       18		      clc
   2419  fe4a		       65 88		      adc	$88
   2420  fe4c		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2421  fe4e		       c9 94		      cmp	#RAFT_MAX_X
   2422  fe50		       b0 14		      bcs	.RaftTurn	; right rail
   2423  fe52		       18		      clc
   2424  fe53		       69 01		      adc	#1	; the cell just beyond the right edge
   2425  fe55		       4a		      lsr
   2426  fe56		       4a		      lsr
   2427  fe57		       20 26 f8 	      jsr	RaftCellSolid
   2428  fe5a		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2429  fe5c		       b5 bd		      lda	EnemyRamX,X
   2430  fe5e		       18		      clc
   2431  fe5f		       65 88		      adc	$88
   2432  fe61		       95 bd		      sta	EnemyRamX,X
   2433  fe63		       4c 90 fe 	      jmp	.RaftRide
