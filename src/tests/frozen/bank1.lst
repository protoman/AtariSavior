   2276  fdbc		       85 e0		      sta	scorePtr1
   2277  fdbe		       85 e2		      sta	scorePtr2
   2278  fdc0
   2279  fdc0							; scorePtr3 = ScoreTh * 8
   2280  fdc0		       a5 f3		      lda	ScoreTh
   2281  fdc2		       0a		      asl
   2282  fdc3		       0a		      asl
   2283  fdc4		       0a		      asl
   2284  fdc5		       85 e4		      sta	scorePtr3
   2285  fdc7
