   1384  f85c							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1385  f85c							; verify_build.check_raft_tramp). bank0 executes `sta $1FF7` at $F8C0-$F8C2 and
   1386  f85c							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1387  f85c							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1388  f85c							; `sta $1FF7` is never executed (it is only the swapped-out image's prefix).
   1389  f85c							; In bank1's $F822-$F936 fill, so the $F937 pin does not move.
   1390  f85c							; ------------------------------------------------------------------------------
   1391  f85c		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1392  f8c0		       8d f7 1f 	      .byte.b	$8D, $F7, $1F	; sta $1FF7 (twin)
   1393  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1394  f8c6
   1395  f8c6		       00 00 00 00*	      .ds	$F937 - *, 0	; pinned: bank2 M1StripBlast back-jmp operand
   1396  f937							; ($F937) — test_bomb_strip asserts both literals
   1397  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1398  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1399  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1400  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1401  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1402  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1403  f937							; Every exit ends in ReturnPad with A = count.
   1404  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1405  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1406  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1407  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1408  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1409  f937							; inc the count (caller's +75 loop scores it). The
   1410  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1411  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1412  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1413  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1414  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1415  f937							; ------------------------------------------------------------------------------
   1416  f937				   StripBlastCheck
   1417  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1418  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1419  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1420  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1421  f937							; sets b3/b4 instead.
   1422  f937		       a5 92		      lda	RectCount
   1423  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1424  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1425  f93d		       c5 92		      cmp	RectCount
   1426  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1427  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1428  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1429  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1430  f947		       c9 02		      cmp	#2
   1431  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1432  f94b							;   (A=0/1 falls into take = overlap)
   1433  f94b				   .SBleftTake
   1434  f94b		       a5 ba		      lda	EnemyDeadMask
   1435  f94d		       29 10		      and	#$10
   1436  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1437  f951		       a9 10		      lda	#$10
   1438  f953		       05 ba		      ora	EnemyDeadMask
   1439  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1440  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1441  f959				   .SBright
   1442  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1443  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1444  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1445  f959		       18		      clc
   1446  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1447  f95c		       49 ff		      eor	#$FF
   1448  f95e		       69 28		      adc	#40	; hi_r = 39-lo_l
   1449  f960		       a8		      tay
   1450  f961		       18		      clc
   1451  f962		       a5 8c		      lda	CollisionCellX	; hi_l
   1452  f964		       49 ff		      eor	#$FF
   1453  f966		       69 28		      adc	#40	; lo_r = 39-hi_l
   1454  f968		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1455  f96a		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1456  f96c		       a5 8c		      lda	CollisionCellX	; hi
   1457  f96e		       38		      sec
   1458  f96f		       e5 88		      sbc	BMWScratch	; hi - pL
   1459  f971		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1460  f973		       a5 8e		      lda	CollisionEndX	; lo
   1461  f975		       c5 88		      cmp	BMWScratch
   1462  f977		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1463  f979		       f0 07		      beq	.SBtake	; lo == pL
   1464  f97b		       38		      sec
   1465  f97c		       e9 01		      sbc	#1
   1466  f97e		       c5 88		      cmp	BMWScratch
   1467  f980		       d0 0e		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1468  f982				   .SBtake
   1469  f982		       a5 ba		      lda	EnemyDeadMask
   1470  f984		       29 08		      and	#$08
   1471  f986		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1472  f988		       a9 08		      lda	#$08
   1473  f98a		       05 ba		      ora	EnemyDeadMask
   1474  f98c		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1475  f98e		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1476  f990				   .SBdone
   1477  f990		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1478  f992		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
