   1540  f8f7		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1541  f8f9		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1542  f8fb		       a5 8c		      lda	CollisionCellX	; hi
   1543  f8fd		       38		      sec
   1544  f8fe		       e5 88		      sbc	BMWScratch	; hi - pL
   1545  f900		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1546  f902		       a5 8e		      lda	CollisionEndX	; lo
   1547  f904		       c5 88		      cmp	BMWScratch
