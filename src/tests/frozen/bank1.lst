   2080  fcb6		       aa		      tax
   2081  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2082  fcba		       4a		      lsr
   2083  fcbb		       4a		      lsr
   2084  fcbc		       05 c0		      ora	LaserState
   2085  fcbe		       85 c0		      sta	LaserState
   2086  fcc0				   .SRDdone
   2087  fcc0		       4c f8 fb 	      jmp	ReturnPad
