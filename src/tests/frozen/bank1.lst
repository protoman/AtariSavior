   1224  f766							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1225  f766							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1226  f766							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1227  f766							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1228  f766							; ====================================================================
   1229  f766
   1230  f766							; --- Setup sprites ---
   1231  f766		       a9 0e		      lda	#$0E	; white
   1232  f768		       85 06		      sta	COLUP0
   1233  f76a		       85 07		      sta	COLUP1
   1234  f76c		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1235  f76e		       85 04		      sta	NUSIZ0
   1236  f770		       85 05		      sta	NUSIZ1
   1237  f772		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1238  f774		       85 25		      sta	VDELP0
   1239  f776		       85 26		      sta	VDELP1
   1240  f778							; Flush both VDELP buffers + live registers to 0.
   1241  f778							; Without this, stale buffer data from previous frame shows as
   1242  f778							; white ghost copies during the positioning scanlines.
   1243  f778		       a9 00		      lda	#0
   1244  f77a		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1245  f77c		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1246  f77e		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1247  f780		       85 0b		      sta	REFP0
   1248  f782		       85 0c		      sta	REFP1
