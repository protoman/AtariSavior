   2304  fde3							; ========================================================================
   2305  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2306  fde3							; ========================================================================
   2307  fde3					      .ds	$FDE3 - *, 0
   2308  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2309  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2310  fde3							; rails keep it inside the room
   2311  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2312  fde3							; surface (line 132) - 7, so its BOTTOM row
   2313  fde3							; sits exactly ON the surface. The live value is
   2314  fde3							; RAFTER_BASE + off (see the tide block below) —
   2315  fde3							; never hard-code the Y: the surface MOVES.
   2316  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2317  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2318  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2319  fde3							; from 12 px above the raft's top to 5 px into it
   2320  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2321  fde3
   2322  fde3				   RaftBody
   2323  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2324  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2325  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2326  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2327  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2328  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2329  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2330  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2331  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2332  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2333  fde3		       a5 c2		      lda	EnemyRamP
   2334  fde5		       29 f0		      and	#$F0
   2335  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2336  fde9		       4a		      lsr
   2337  fdea		       4a		      lsr
   2338  fdeb		       4a		      lsr
   2339  fdec		       4a		      lsr		; A = p (1..15)
   2340  fded		       c9 08		      cmp	#8
   2341  fdef		       90 04		      bcc	.RaftTideTri
   2342  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2343  fdf3		       f0 09		      beq	.RaftTide	; always
   2344  fdf5				   .RaftTideTri
   2345  fdf5		       c9 04		      cmp	#4
   2346  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2347  fdf9		       49 ff		      eor	#$FF
   2348  fdfb		       38		      sec
   2349  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2350  fdfe				   .RaftTide
   2351  fdfe		       18		      clc
   2352  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2353  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2354  fe03							; water line is what the raft floats on
   2355  fe03
   2356  fe03							; --- does the player count as "over the raft"? --------------------------
   2357  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2358  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2359  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2360  fe03							; block here is what makes it park; the pin/carry later still applies while
   2361  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2362  fe03							; raft he is actually standing on.
   2363  fe03		       a5 80		      lda	RoomX
   2364  fe05		       38		      sec
   2365  fe06		       f5 bd		      sbc	EnemyRamX,X
   2366  fe08		       18		      clc
   2367  fe09		       69 06		      adc	#RAFTER_XOFF
   2368  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2369  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2370  fe0f		       a5 81		      lda	RoomY
   2371  fe11		       38		      sec
   2372  fe12		       f5 e2		      sbc	EnemyRamY,X
   2373  fe14		       18		      clc
   2374  fe15		       69 0c		      adc	#RAFTER_PINFIT
   2375  fe17		       c9 12		      cmp	#RAFTER_YSPAN
   2376  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2377  fe1b		       a5 94		      lda	vyHi
   2378  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2379  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2380  fe22				   .RaftNoRide
