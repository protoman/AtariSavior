    571  f41f							; ------------------------------------------------------------------------------
    572  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    573  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    574  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    575  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    576  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    577  f41f							; Staging contract (both scratch bytes free in this flow):
    578  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    579  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    580  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    581  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    582  f41f							; ------------------------------------------------------------------------------
    583  f41f				   M1StripBlast
    584  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    585  f421		       c9 14		      cmp	#20
    586  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    587  f425		       a5 ba		      lda	EnemyDeadMask
    588  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    589  f429		       d0 15		      bne	.M1SBnone
    590  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    591  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    592  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    593  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    594  f433		       4a		      lsr
    595  f434		       4a		      lsr
    596  f435		       4a		      lsr
    597  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    598  f437							;   high end — StripBlastCheck rejects)
    599  f437		       38		      sec
    600  f438		       e9 01		      sbc	#1	; ℓ = left_col
    601  f43a		       0a		      asl		; 2ℓ = strip left dcol
    602  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    603  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    604  f440				   .M1SBnone
    605  f440		       a9 ff		      lda	#$FF
    606  f442		       85 92		      sta	RectCount	; no left strip this frame
    607  f444				   .M1SBdoorR
    608  f444		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
    609  f446		       10 04		      bpl	.M1SBout
    610  f448		       a0 ff		      ldy	#$FF
    611  f44a		       84 88		      sty	BMWScratch	; $88 = StripBlastCheck's "no strip"
    612  f44c				   .M1SBout
    613  f44c		       4c c6 f8 	      jmp	StripBlastCheck	; same bank now (was the $F9B2 pad)
    614  f44f
    615  f44f							; ------------------------------------------------------------------------------
    616  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    617  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    618  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    619  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    620  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    621  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    622  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    623  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    624  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    625  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    626  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    627  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    628  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    629  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    630  f44f							; ------------------------------------------------------------------------------
    631  f44f				   TallyEntry
    632  f44f		       a5 8a		      lda	DropTarget
    633  f451		       f0 36		      beq	.TEArm
    634  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    635  f455		       d0 2d		      bne	.TEIdle
    636  f457		       a9 04		      lda	#4
    637  f459		       85 ad		      sta	TickCounter
    638  f45b		       c6 f2		      dec	TallyTicks
    639  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    640  f45f		       a5 f2		      lda	TallyTicks
    641  f461		       29 03		      and	#3
    642  f463		       d0 15		      bne	.TEOne	; tick only
    643  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    644  f467		       85 f1		      sta	BombSnd
    645  f469		       a9 04		      lda	#4
    646  f46b		       85 15		      sta	AUDC0	; square
    647  f46d		       a9 18		      lda	#24
    648  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    649  f471		       a9 08		      lda	#8
    650  f473		       85 19		      sta	AUDV0
    651  f475		       a9 03		      lda	#3	; tick + coin
    652  f477		       4c f8 fb 	      jmp	ReturnPad
    653  f47a				   .TEOne
    654  f47a		       a9 01		      lda	#1	; tick only
    655  f47c		       4c f8 fb 	      jmp	ReturnPad
    656  f47f				   .TEFinal
    657  f47f		       a9 07		      lda	#7	; tick + coin + done
    658  f481		       4c f8 fb 	      jmp	ReturnPad
    659  f484				   .TEIdle
    660  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    661  f486		       4c f8 fb 	      jmp	ReturnPad
    662  f489				   .TEArm
    663  f489		       a5 ae		      lda	BarLevel
    664  f48b		       18		      clc
    665  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    666  f48e		       a2 00		      ldx	#0
    667  f490				   .TEDiv
    668  f490		       c9 06		      cmp	#6
    669  f492		       90 06		      bcc	.TEDivSum
    670  f494		       38		      sec
    671  f495		       e9 06		      sbc	#6
    672  f497		       e8		      inx		; X = time ticks (0..20; BarLevel <= 120)
    673  f498		       d0 f6		      bne	.TEDiv
    674  f49a				   .TEDivSum
    675  f49a		       20 b0 f4 	      jsr	TallySum	; TallyTicks = ticks + 20 + bombs + 2*lives
    676  f49d							; (masking the raft's ramp bits out of
    677  f49d							; PlayerBombs needs the split helper below)
    678  f49d		       a9 04		      lda	#4
    679  f49f		       85 ad		      sta	TickCounter	; fresh pace divider
