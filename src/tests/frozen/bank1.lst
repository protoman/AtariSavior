   2296  fd68							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2297  fd68							; ========================================================================
   2298  fd68		       00 00 00 00*	      .ds	$FDE3 - *, 0
   2299  fd68		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2300  fd68		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2301  fde3							; rails keep it inside the room
   2302  fde3		       00 83	   RAFTER_BASE =	131	; raft top when the tide is at 0: the 2-row
   2303  fde3							; surface (line 132) - 7, so its BOTTOM row
   2304  fde3							; sits exactly ON the surface. The live value is
   2305  fde3							; plank's BOTTOM row (top+1) lands on the water
   2306  fde3							; surface (132+off) — see the tide block below;
   2307  fde3							; never hard-code the Y: the surface MOVES.
   2308  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2309  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2310  fde3		       00 1c	   RAFTER_YSPAN =	28	; PLAYER_SPRITE_H+6: riding when the feet are
   2311  fde3							; from 22 px above the raft's top to 5 px into it
   2312  fde3		       00 16	   RAFTER_PINFIT =	22	; PLAYER_SPRITE_H: pin = raft top - this
   2313  fde3
   2314  fde3				   RaftBody
   2315  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2316  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2317  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2318  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2319  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
   2320  fde3							; This mirrors the VBL's
   2321  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2322  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2323  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2324  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2325  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2326  fde3		       a5 c2		      lda	EnemyRamP
   2327  fde5		       29 f0		      and	#$F0
   2328  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2329  fde9		       4a		      lsr
   2330  fdea		       4a		      lsr
   2331  fdeb		       4a		      lsr
