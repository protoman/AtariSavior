    748  f560							; a drop-in, or it expires before the player lands.
    749  f560		       00 9c	   Hover      =	$9C	; respawn hover (kernel ZP): $FF = armed/waiting for
    750  f560							; the first input, 1..HOVER_FRAMES = grace running,
    751  f560							; 0 = normal physics (ticked in this band).
    752  f560		       00 5a	   HOVER_FRAMES =	90	; 1.5 s at 60 Hz: the jet reaches lift in 1.0 s.
    753  f560							; Score digits live at $F3-$F6 — MUST match bank0 Score* EQUs.
