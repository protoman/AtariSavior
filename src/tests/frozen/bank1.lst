   1271  f7e9		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1272  f7eb		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1273  f7ee		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
