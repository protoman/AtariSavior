   1673  faab							; UpdateLaserSound — low "zoom" tone on channel 0 while fire is held.
   1674  faab							; Call order in bank0 overscan: UpdateBombSound, UpdateJetSound, this — so
   1675  faab							; AUDV0 is already forced to 0 by UpdateBombSound when BombSnd = 0, which is
   1676  faab							; exactly what silence-on-release needs (this routine then does nothing).
   1677  faab							; Bomb events own ch0 (BombSnd > 0 -> skip) so blip/explosion stay audible.
   1678  faab							; Pitch sweeps AUDF 4..14 on the free-running frame clock: AUDC=2 divides by
   1679  faab							; 15, so f = 31400/((AUDF+1)*15) = 419..140 Hz (low). Triangle, 8 steps x
   1680  faab							; 8 frames = 1.07 s per cycle, no audible wrap jump.
   1681  faab							; Clobbers A/X; Y preserved. No ZP writes.
   1682  faab				   UpdateLaserSound
   1683  faab		       a5 f1		      lda	BombSnd
   1684  faad		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1685  faaf		       a5 c0		      lda	LaserState
   1686  fab1		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1687  fab3		       a5 c2		      lda	EnemyRamP
