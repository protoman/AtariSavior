   1622  fac4				   LaserFreqTable
   1623  fac4		       04 07 0a 0c*	      .byte.b	4,7,10,12,14,12,10,7
   1624  facc
   1625  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1626  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1627  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1628  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1629  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1630  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1631  facc							;   double-score guard for that slot only — first blast sees the pair
   1632  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1633  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1634  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1635  facc							;   Same-bank jsr legal (no pad nesting).
   1636  facc				   PairGone
   1637  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1638  face		       aa		      tax
   1639  facf		       bd 68 fa 	      lda	BombClearMask,X
   1640  fad2		       49 ff		      eor	#$FF
   1641  fad4		       a8		      tay		; Y = bit for col x
   1642  fad5		       e8		      inx
   1643  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1644  fad9		       49 ff		      eor	#$FF
   1645  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1646  fadd		       98		      tya
   1647  fade		       05 ad		      ora	Temp
   1648  fae0		       85 ad		      sta	Temp	; both pair bits
   1649  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1650  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1651  fae2		       a4 84		      ldy	LineCount
   1652  fae4		       e0 04		      cpx	#4
   1653  fae6		       90 0a		      bcc	.pg0
   1654  fae8		       e0 0c		      cpx	#12
   1655  faea		       90 0c		      bcc	.pg1
   1656  faec		       b9 c9 00 	      lda	PF2Buf,Y
   1657  faef		       25 ad		      and	Temp
   1658  faf1		       60		      rts
   1659  faf2				   .pg0
   1660  faf2		       b9 c3 00 	      lda	PF0Buf,Y
   1661  faf5		       25 ad		      and	Temp
   1662  faf7		       60		      rts
   1663  faf8				   .pg1
   1664  faf8		       b9 c6 00 	      lda	PF1Buf,Y
   1665  fafb		       25 ad		      and	Temp
   1666  fafd		       60		      rts
   1667  fafe
   1668  fafe							; ========================================================================
   1669  fafe							; BombMarkWalls (S5.2, moved from bank0) — pinned at $FB10.
   1670  fafe							;   On the bomb 1->2 edge: walk the rect cache, set WallMask bit (BombPacked
   1671  fafe							;   b3-6) for each w==2 rect whose x is in blast cols (bomb left-half col
   1672  fafe							;   +-2, clamped 0..19). w==2 = one D7 logical cell (rect x/w are emitted
   1673  fafe							;   in 4px display cols; a thin wall is exactly one cell = 2 cols). Skip x==0 (screen border). Score is NOT done here —
   1674  fafe							;   pads cannot nest (ReturnPad switches to bank0), so this returns
   1675  fafe							;   A = #walls newly broken and the bank0 caller adds +75 per wall.
   1676  fafe							;   Plan 5.1: each newly broken rect is punched here immediately —
   1677  fafe							;   ClearPFColumn on col x AND col x+1 (D7 thin wall w = 2 display cols;
   1678  fafe							;   the single-col punch left half the wall standing behind a set mask bit)
   1679  fafe							;   — the old VBL ApplyBombWalls re-apply + EnterRoom
   1680  fafe							;   restore are deleted (D1-B). WallMask b3-6 survives only in-room: the
   1681  fafe							;   hot parent-mask AND (HotOverlapBody) still reads it until phase 6.
   1682  fafe							;   ABW tables + BombMaskBit are bank1-only now (kernel copies died with
   1683  fafe							;   ApplyBombWalls).
   1684  fafe							;   #7(i): walk now covers rects 0-4 (cache slot rect4 at $DC-$DF was
   1685  fafe							;   loaded but never walked — a thin wall there was unbreakable). Rect5
   1686  fafe							;   is not cached (ZP ends $DF) and stays unwalkable — shipped models
   1687  fafe							;   have no thin rect at idx5. Rect idx4 has no WallMask bit: PairGone's
   1688  fafe							;   buffer read replaces the mask as its double-score guard. A full
   1689  fafe							;   buffer cell-sweep was evaluated and REJECTED: find_rectangles merges
   1690  fafe							;   maximal runs, so every shipped thin wall has a solid neighbor slab
   1691  fafe							;   (checked all 8 models) — buffer adjacency cannot distinguish thin
   1692  fafe							;   stubs from thick walls without breaking gameplay parity.
   1693  fafe							;   Also fixed: the col x+1 punch passed the ABW table VALUE (the rect's
   1694  fafe							;   ZP address) as the ClearPFColumn col instead of deref'ing rect.x —
   1695  fafe							;   the second half of every thin wall was punched at a garbage col
   1696  fafe							;   (caught by the new test_bomb_strip rect-walk case; pre-existing
   1697  fafe							;   since plan 5.1). RcBase is now clamped ≤5 at the bank2 cache load —
   1698  fafe							;   BMW trusts it (no local clamp).
   1699  fafe							; ========================================================================
   1700  fafe		       00 00 00 00*	      .ds	$FB10 - *, 0
   1701  fb10				   BombMarkWalls
