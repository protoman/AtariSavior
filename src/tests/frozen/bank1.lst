   1186  f7f8							; ========================================================================
   1187  f7f8							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1188  f7f8							; X=0 positions P0, X=1 positions P1
   1189  f7f8							; A = pixel position (0-159)
   1190  f7f8							; ========================================================================
   1191  f7f8				   SetObjectXPos_b1
   1192  f7f8		       85 02		      sta	WSYNC
   1193  f7fa		       38		      sec
   1194  f7fb				   .Div15Loop
   1195  f7fb		       e9 0f		      sbc	#15
   1196  f7fd		       b0 fc		      bcs	.Div15Loop
   1197  f7ff		       a8		      tay
   1198  f800		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1199  f803		       95 20		      sta	HMP0,X
   1200  f805		       95 10		      sta	RESP0,X
   1201  f807		       60		      rts
