   1183  f787							; --- Position P0 and P1 for interleaved 6-digit layout ---
   1184  f787							; P0 at pixel 60, P1 at pixel 68 (shifted 4px right to fix pipeline timing)
   1185  f787		       a9 3c		      lda	#60
   1186  f789		       a2 00		      ldx	#0
   1187  f78b		       20 f8 f7 	      jsr	SetObjectXPos_b1
   1188  f78e		       a9 44		      lda	#68
