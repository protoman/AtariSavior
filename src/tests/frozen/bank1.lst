   2435  fe66							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2436  fe66				   .RaftTurn
   2437  fe66		       bd 44 f8 	      lda	RaftBitTab,X
   2438  fe69		       45 c1		      eor	EnemyRamD
   2439  fe6b		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2440  fe6d							; bank1's RoomDarkMask — must be preserved)
   2441  fe6d		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2442  fe70							; ---- leading edge left --------------------------------------------------
   2443  fe70				   .RaftLeft
   2444  fe70		       b5 bd		      lda	EnemyRamX,X
   2445  fe72		       38		      sec
   2446  fe73		       e5 88		      sbc	$88
   2447  fe75		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2448  fe77		       c9 08		      cmp	#RAFT_MIN_X
   2449  fe79		       90 eb		      bcc	.RaftTurn	; left rail
   2450  fe7b		       38		      sec
   2451  fe7c		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2452  fe7e		       b0 02		      bcs	.RaftLeftCol
   2453  fe80		       a9 00		      lda	#0
   2454  fe82				   .RaftLeftCol
   2455  fe82		       4a		      lsr
   2456  fe83		       4a		      lsr
   2457  fe84		       20 26 f8 	      jsr	RaftCellSolid
   2458  fe87		       d0 dd		      bne	.RaftTurn
   2459  fe89		       b5 bd		      lda	EnemyRamX,X
   2460  fe8b		       38		      sec
   2461  fe8c		       e5 88		      sbc	$88
   2462  fe8e		       95 bd		      sta	EnemyRamX,X
   2463  fe90							; ---- carry + pin while the player is aboard -----------------------------
   2464  fe90				   .RaftRide
   2465  fe90		       a5 94		      lda	vyHi
   2466  fe92		       30 0d		      bmi	.RaftNoPin	; rising: pin skipped, carry still happens
   2467  fe94		       b5 e2		      lda	EnemyRamY,X
   2468  fe96		       38		      sec
   2469  fe97		       e9 0c		      sbc	#RAFTER_PINFIT
   2470  fe99		       85 81		      sta	RoomY	; feet on the raft's top
   2471  fe9b		       a9 00		      lda	#0
   2472  fe9d		       85 93		      sta	vyLo
   2473  fe9f		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2474  fea1				   .RaftNoPin
   2475  fea1							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2476  fea1		       a5 f0		      lda	$F0
   2477  fea3		       09 80		      ora	#%10000000
   2478  fea5		       85 f0		      sta	$F0
   2479  fea7		       a5 c2		      lda	EnemyRamP
   2480  fea9		       4a		      lsr		; C = the frame-parity bit
