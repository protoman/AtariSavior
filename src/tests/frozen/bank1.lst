   2251  fdbe		       85 e2		      sta	scorePtr2
   2252  fdc0
   2253  fdc0							; scorePtr3 = ScoreTh * 8
   2254  fdc0		       a5 f3		      lda	ScoreTh
   2255  fdc2		       0a		      asl
   2256  fdc3		       0a		      asl
