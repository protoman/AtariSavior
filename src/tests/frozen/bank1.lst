    514  f41f							; ------------------------------------------------------------------------------
    515  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    516  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    517  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    518  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    519  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    520  f41f							; Staging contract (both scratch bytes free in this flow):
    521  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    522  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    523  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    524  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    525  f41f							; ------------------------------------------------------------------------------
    526  f41f				   M1StripBlast
    527  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    528  f421		       c9 14		      cmp	#20
    529  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    530  f425		       a5 ba		      lda	EnemyDeadMask
    531  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    532  f429		       d0 15		      bne	.M1SBnone
    533  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    534  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    535  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    536  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    537  f433		       4a		      lsr
    538  f434		       4a		      lsr
    539  f435		       4a		      lsr
    540  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    541  f437							;   high end — StripBlastCheck rejects)
    542  f437		       38		      sec
    543  f438		       e9 01		      sbc	#1	; ℓ = left_col
    544  f43a		       0a		      asl		; 2ℓ = strip left dcol
    545  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    546  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    547  f440				   .M1SBnone
    548  f440		       a9 ff		      lda	#$FF
    549  f442		       85 92		      sta	RectCount	; no left strip this frame
    550  f444				   .M1SBdoorR
    551  f444		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
    552  f446		       10 04		      bpl	.M1SBout
    553  f448		       a0 ff		      ldy	#$FF
    554  f44a		       84 88		      sty	BMWScratch	; $88 = StripBlastCheck's "no strip"
    555  f44c				   .M1SBout
    556  f44c		       4c 37 f9 	      jmp	StripBlastCheck	; same bank now (was the $F9B2 pad)
    557  f44f
    558  f44f							; ------------------------------------------------------------------------------
    559  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    560  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    561  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    562  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    563  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    564  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    565  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    566  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    567  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    568  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    569  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    570  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    571  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    572  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    573  f44f							; ------------------------------------------------------------------------------
    574  f44f				   TallyEntry
    575  f44f		       a5 8a		      lda	DropTarget
    576  f451		       f0 36		      beq	.TEArm
    577  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    578  f455		       d0 2d		      bne	.TEIdle
    579  f457		       a9 04		      lda	#4
    580  f459		       85 ad		      sta	TickCounter
    581  f45b		       c6 f2		      dec	TallyTicks
    582  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    583  f45f		       a5 f2		      lda	TallyTicks
    584  f461		       29 03		      and	#3
    585  f463		       d0 15		      bne	.TEOne	; tick only
    586  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    587  f467		       85 f1		      sta	BombSnd
    588  f469		       a9 04		      lda	#4
    589  f46b		       85 15		      sta	AUDC0	; square
    590  f46d		       a9 18		      lda	#24
    591  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    592  f471		       a9 08		      lda	#8
    593  f473		       85 19		      sta	AUDV0
    594  f475		       a9 03		      lda	#3	; tick + coin
    595  f477		       4c f8 fb 	      jmp	ReturnPad
    596  f47a				   .TEOne
    597  f47a		       a9 01		      lda	#1	; tick only
    598  f47c		       4c f8 fb 	      jmp	ReturnPad
    599  f47f				   .TEFinal
    600  f47f		       a9 07		      lda	#7	; tick + coin + done
    601  f481		       4c f8 fb 	      jmp	ReturnPad
    602  f484				   .TEIdle
    603  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    604  f486		       4c f8 fb 	      jmp	ReturnPad
    605  f489				   .TEArm
    606  f489		       a5 ae		      lda	BarLevel
    607  f48b		       18		      clc
    608  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    609  f48e		       a2 00		      ldx	#0
    610  f490				   .TEDiv
    611  f490		       c9 06		      cmp	#6
    612  f492		       90 06		      bcc	.TEDivSum
    613  f494		       38		      sec
    614  f495		       e9 06		      sbc	#6
    615  f497		       e8		      inx		; X = time ticks (0..20; BarLevel <= 120)
    616  f498		       d0 f6		      bne	.TEDiv
    617  f49a				   .TEDivSum
    618  f49a		       20 b0 f4 	      jsr	TallySum	; TallyTicks = ticks + 20 + bombs + 2*lives
    619  f49d							; (masking the raft's ramp bits out of
    620  f49d							; PlayerBombs needs the split helper below)
    621  f49d		       a9 04		      lda	#4
    622  f49f		       85 ad		      sta	TickCounter	; fresh pace divider
    623  f4a1		       a9 00		      lda	#0
    624  f4a3		       85 96		      sta	JetPower	; frozen frame: no thrust flutter
    625  f4a5		       85 83		      sta	LaserX	; drop any live beam (travel restarts on press)
    626  f4a7		       a9 fe		      lda	#$FE
    627  f4a9		       85 8a		      sta	DropTarget
    628  f4ab		       a9 00		      lda	#0
    629  f4ad		       4c f8 fb 	      jmp	ReturnPad
    630  f4b0
    631  f4b0							; TallySum — the level-bonus total for TallyEntry (frozen-scene frame).
    632  f4b0							; Split out of the inline region in bank2 (which ended at a hard org); now a
    633  f4b0							; same-bank jsr in the same fill.
    634  f4b0				   TallySum
    635  f4b0		       a5 f0		      lda	PlayerBombs
    636  f4b2		       29 07		      and	#%00000111	; bombs only, never the raft ramp bits
    637  f4b4		       85 88		      sta	BMWScratch	; $88 = kernel Temp — NOT bank1's Temp ($AD =
    638  f4b6							; TickCounter: writing it stalls the game timer)
    639  f4b6		       8a		      txa
    640  f4b7		       18		      clc
    641  f4b8		       69 14		      adc	#20	; miner reach = 1000 pts
    642  f4ba		       65 88		      adc	BMWScratch	; + 50 per unspent bomb (chain carry ok)
    643  f4bc		       85 f2		      sta	TallyTicks
    644  f4be		       a5 ac		      lda	PlayerLives
    645  f4c0		       0a		      asl		; + 100 per life = 2 ticks
    646  f4c1		       18		      clc
    647  f4c2		       65 f2		      adc	TallyTicks
    648  f4c4		       85 f2		      sta	TallyTicks
    649  f4c6		       60		      rts
