   2207  fd7c		       85 e3		      sta	scorePtr2+1
   2208  fd7e		       85 e5		      sta	scorePtr3+1
   2209  fd80		       85 e7		      sta	scorePtr4+1
   2210  fd82		       85 e9		      sta	scorePtr5+1
   2211  fd84		       85 eb		      sta	scorePtr6+1
   2212  fd86
   2213  fd86		       a5 f2		      lda	LevelShowTimer
   2214  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2215  fd8a		       f0 2e		      beq	.scoreLows
   2216  fd8c		       c6 f2		      dec	LevelShowTimer
   2217  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2218  fd90		       85 e0		      sta	scorePtr1
   2219  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2220  fd94		       85 e2		      sta	scorePtr2
   2221  fd96		       a9 00		      lda	#0	; hundreds '0'
   2222  fd98		       85 e4		      sta	scorePtr3
   2223  fd9a		       a5 a3		      lda	Level
   2224  fd9c		       18		      clc
   2225  fd9d		       69 01		      adc	#1	; 1-based level number
   2226  fd9f		       a2 00		      ldx	#0
   2227  fda1				   .LVTens
   2228  fda1		       c9 0a		      cmp	#10
   2229  fda3		       90 05		      bcc	.LVTensDone
   2230  fda5		       e9 0a		      sbc	#10
   2231  fda7		       e8		      inx
   2232  fda8		       d0 f7		      bne	.LVTens
   2233  fdaa				   .LVTensDone
   2234  fdaa		       0a		      asl
   2235  fdab		       0a		      asl
   2236  fdac		       0a		      asl		; ones * 8
   2237  fdad		       85 e8		      sta	scorePtr5
   2238  fdaf		       8a		      txa
   2239  fdb0		       0a		      asl
   2240  fdb1		       0a		      asl
   2241  fdb2		       0a		      asl		; tens * 8
   2242  fdb3		       85 e6		      sta	scorePtr4
   2243  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2244  fdb7		       85 ea		      sta	scorePtr6
   2245  fdb9		       60		      rts
   2246  fdba
