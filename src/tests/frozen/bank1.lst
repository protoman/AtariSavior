   1602  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1603  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1604  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1605  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1606  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1607  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1608  facc							;   double-score guard for that slot only — first blast sees the pair
   1609  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1610  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1611  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1612  facc							;   Same-bank jsr legal (no pad nesting).
   1613  facc				   PairGone
   1614  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1615  face		       aa		      tax
   1616  facf		       bd 68 fa 	      lda	BombClearMask,X
   1617  fad2		       49 ff		      eor	#$FF
   1618  fad4		       a8		      tay		; Y = bit for col x
   1619  fad5		       e8		      inx
   1620  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1621  fad9		       49 ff		      eor	#$FF
   1622  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1623  fadd		       98		      tya
   1624  fade		       05 ad		      ora	Temp
   1625  fae0		       85 ad		      sta	Temp	; both pair bits
   1626  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1627  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1628  fae2		       a4 84		      ldy	LineCount
   1629  fae4		       e0 04		      cpx	#4
   1630  fae6		       90 0a		      bcc	.pg0
   1631  fae8		       e0 0c		      cpx	#12
   1632  faea		       90 0c		      bcc	.pg1
   1633  faec		       b9 c9 00 	      lda	PF2Buf,Y
   1634  faef		       25 ad		      and	Temp
