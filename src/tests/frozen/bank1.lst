   2336  fe90		       a5 94		      lda	vyHi
   2337  fe92		       30 0d		      bmi	.RaftNoPin	; rising: pin skipped, carry still happens
   2338  fe94		       b5 e2		      lda	EnemyRamY,X
   2339  fe96		       38		      sec
   2340  fe97		       e9 0c		      sbc	#RAFTER_PINFIT
   2341  fe99		       85 81		      sta	RoomY	; feet on the raft's top
   2342  fe9b		       a9 00		      lda	#0
   2343  fe9d		       85 93		      sta	vyLo
   2344  fe9f		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2345  fea1				   .RaftNoPin
   2346  fea1							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2347  fea1		       a5 f0		      lda	$F0
