   1190  f7b4		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1191  f7b6		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1192  f7b8		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1193  f7ba		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1194  f7bc		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1195  f7be		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
