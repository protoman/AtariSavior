   1165  f7ee							; ====================================================================
   1166  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1167  f7ee							; Path A (PlayerLives > 0) — execution count:
   1168  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1169  f7ee							;   Timer:    3 loop + 1 gap = 4
   1170  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1171  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1172  f7ee							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1173  f7ee							;   Subtotal: 6+4+8+11+10 = 39
   1174  f7ee							;   Pad:      48 - 39 = 9
   1175  f7ee							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1176  f7ee							; ====================================================================
   1177  f7ee		       a2 09		      ldx	#9
   1178  f7f0				   .HudPad
   1179  f7f0		       85 02		      sta	WSYNC
   1180  f7f2		       ca		      dex
   1181  f7f3		       d0 fb		      bne	.HudPad
