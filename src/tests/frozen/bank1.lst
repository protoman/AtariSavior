   2469  fe9d							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2470  fe9d		       a5 f0		      lda	$F0
   2471  fe9f		       09 80		      ora	#%10000000
   2472  fea1		       85 f0		      sta	$F0
   2473  fea3		       a5 c2		      lda	EnemyRamP
