   2421  fe56		       18		      clc
   2422  fe57		       65 88		      adc	$88
   2423  fe59		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2424  fe5b		       c9 94		      cmp	#RAFT_MAX_X
   2425  fe5d		       b0 14		      bcs	.RaftTurn	; right rail
   2426  fe5f		       18		      clc
   2427  fe60		       69 01		      adc	#1	; the cell just beyond the right edge
   2428  fe62		       4a		      lsr
   2429  fe63		       4a		      lsr
   2430  fe64		       20 75 f8 	      jsr	RaftCellSolid
   2431  fe67		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2432  fe69		       b5 bd		      lda	EnemyRamX,X
   2433  fe6b		       18		      clc
   2434  fe6c		       65 88		      adc	$88
   2435  fe6e		       95 bd		      sta	EnemyRamX,X
   2436  fe70		       4c 9d fe 	      jmp	.RaftRide
   2437  fe73							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
