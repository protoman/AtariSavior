   1245  f7a7		       85 07		      sta	COLUP1
   1246  f7a9		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1247  f7ab		       85 04		      sta	NUSIZ0
   1248  f7ad		       85 05		      sta	NUSIZ1
   1249  f7af		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1250  f7b1		       85 25		      sta	VDELP0
   1251  f7b3		       85 26		      sta	VDELP1
   1252  f7b5							; Flush both VDELP buffers + live registers to 0.
   1253  f7b5							; Without this, stale buffer data from previous frame shows as
   1254  f7b5							; white ghost copies during the positioning scanlines.
   1255  f7b5		       a9 00		      lda	#0
   1256  f7b7		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1257  f7b9		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1258  f7bb		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
