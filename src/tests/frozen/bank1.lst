   2134  fd7c		       85 e3		      sta	scorePtr2+1
   2135  fd7e		       85 e5		      sta	scorePtr3+1
   2136  fd80		       85 e7		      sta	scorePtr4+1
   2137  fd82		       85 e9		      sta	scorePtr5+1
   2138  fd84		       85 eb		      sta	scorePtr6+1
   2139  fd86
   2140  fd86		       a5 f2		      lda	LevelShowTimer
   2141  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2142  fd8a		       f0 2e		      beq	.scoreLows
   2143  fd8c		       c6 f2		      dec	LevelShowTimer
   2144  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2145  fd90		       85 e0		      sta	scorePtr1
   2146  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2147  fd94		       85 e2		      sta	scorePtr2
   2148  fd96		       a9 00		      lda	#0	; hundreds '0'
   2149  fd98		       85 e4		      sta	scorePtr3
   2150  fd9a		       a5 a3		      lda	Level
   2151  fd9c		       18		      clc
   2152  fd9d		       69 01		      adc	#1	; 1-based level number
   2153  fd9f		       a2 00		      ldx	#0
   2154  fda1				   .LVTens
   2155  fda1		       c9 0a		      cmp	#10
   2156  fda3		       90 05		      bcc	.LVTensDone
   2157  fda5		       e9 0a		      sbc	#10
   2158  fda7		       e8		      inx
   2159  fda8		       d0 f7		      bne	.LVTens
   2160  fdaa				   .LVTensDone
   2161  fdaa		       0a		      asl
   2162  fdab		       0a		      asl
   2163  fdac		       0a		      asl		; ones * 8
   2164  fdad		       85 e8		      sta	scorePtr5
   2165  fdaf		       8a		      txa
   2166  fdb0		       0a		      asl
   2167  fdb1		       0a		      asl
   2168  fdb2		       0a		      asl		; tens * 8
   2169  fdb3		       85 e6		      sta	scorePtr4
   2170  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2171  fdb7		       85 ea		      sta	scorePtr6
   2172  fdb9		       60		      rts
   2173  fdba
   2174  fdba							; scorePtr1..2 = leading zeros
   2175  fdba				   .scoreLows
   2176  fdba		       a9 00		      lda	#0
   2177  fdbc		       85 e0		      sta	scorePtr1
   2178  fdbe		       85 e2		      sta	scorePtr2
   2179  fdc0
   2180  fdc0							; scorePtr3 = ScoreTh * 8
   2181  fdc0		       a5 f3		      lda	ScoreTh
   2182  fdc2		       0a		      asl
   2183  fdc3		       0a		      asl
   2184  fdc4		       0a		      asl
   2185  fdc5		       85 e4		      sta	scorePtr3
   2186  fdc7
