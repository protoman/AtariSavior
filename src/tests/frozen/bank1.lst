   2301  fdce							; scorePtr5 = (ScoreTe >> 4) * 8  (tens digit)
   2302  fdce		       a5 f5		      lda	ScoreTe
   2303  fdd0		       4a		      lsr
   2304  fdd1		       4a		      lsr
   2305  fdd2		       4a		      lsr
