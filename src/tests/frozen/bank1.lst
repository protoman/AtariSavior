    739  f560		       00 e8	   scorePtr5  =	$E8	; pointer to digit 5 font data (tens)
    740  f560		       00 ea	   scorePtr6  =	$EA	; pointer to digit 6 font data (ones)
    741  f560		       00 ec	   scbrdCnt   =	$EC	; score render loop counter (7..0)
    742  f560		       00 ed	   scbrdTmp   =	$ED	; mid-scanline temp cache
    743  f560		       00 ee	   DelayCnt   =	$EE	; bar delay A preloaded once per frame (bank1; ColupfBuf+7)
    744  f560		       00 ef	   FineCnt    =	$EF	; bar fine delay cycles 0/2/3/4 (H3; bank1 only)
    745  f560		       00 ad	   Temp       =	$AD	; scratch variable
