   1138  f769							; ====================================================================
   1139  f769							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1140  f769							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1141  f769							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1142  f769							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1143  f769							; ====================================================================
   1144  f769
   1145  f769							; --- Setup sprites ---
   1146  f769		       a9 0e		      lda	#$0E	; white
