   1453  f982				   .SBtake
   1454  f982		       a5 ba		      lda	EnemyDeadMask
   1455  f984		       29 08		      and	#$08
   1456  f986		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1457  f988		       a9 08		      lda	#$08
   1458  f98a		       05 ba		      ora	EnemyDeadMask
   1459  f98c		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1460  f98e		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1461  f990				   .SBdone
   1462  f990		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1463  f992		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
