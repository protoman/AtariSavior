   1240  f7de							; --- Restore cave kernel settings ---
   1241  f7de		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + 8-clk ball (cave mode
   1242  f7e0							; since D6 — bank1 bar overwrote $05 during its band)
   1243  f7e0		       85 0a		      sta	CTRLPF
   1244  f7e2		       a9 00		      lda	#0
   1245  f7e4		       85 04		      sta	NUSIZ0
