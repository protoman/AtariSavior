   1603  f8f9		       a8		      tay
   1604  f8fa		       18		      clc
   1605  f8fb		       a5 8c		      lda	CollisionCellX	; hi_l
   1606  f8fd		       49 ff		      eor	#$FF
   1607  f8ff		       69 28		      adc	#40	; lo_r = 39-hi_l
   1608  f901		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1609  f903		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1610  f905		       a5 8c		      lda	CollisionCellX	; hi
   1611  f907		       38		      sec
