   1469  f867							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1470  f867							; verify_build.check_raft_tramp). bank0 executes `sta $1FF5` at $F8C0-$F8C2 and
   1471  f867							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1472  f867							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1473  f867							; `sta $1FF5` is never executed (it is only the swapped-out image's prefix).
   1474  f867							; In bank1's $F822-$F8C6 fill; StripBlastCheck follows it directly ($F937 pin
   1475  f867							; deleted 2026-10-20 — the body floats and the $F9AC pin bounds the leaves).
   1476  f867							; ------------------------------------------------------------------------------
   1477  f867		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1478  f8c0		       8d f5 1f 	      .byte.b	$8D, $F5, $1F	; sta $1FF5 (twin)
   1479  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1480  f8c6
   1481  f8c6							; ($F937 pin DELETED 2026-10-20, audit round 2: it pinned bank2's
   1482  f8c6							;  M1StripBlast back-jmp operand, and that body is same-bank now — the chain
   1483  f8c6							;  is .BMWDone -> M1StripBlast -> StripBlastCheck inside bank1, so
   1484  f8c6							;  StripBlastCheck is reached by label and floats. It now starts right after
   1485  f8c6							;  the raft tramp twin; the $F9AC pin still bounds the sound-leaf block.)
   1486  f8c6							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1487  f8c6							; from BombMarkWalls .BMWDone through M1StripBlast (same bank, label `jmp`s
   1488  f8c6							; — repack chunk 2; 0 pushes, no switch). Still 0 pushes (the jsr+pha
   1489  f8c6							; version measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1490  f8c6							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1491  f8c6							; Every exit ends in ReturnPad with A = count.
   1492  f8c6							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1493  f8c6							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1494  f8c6							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1495  f8c6							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1496  f8c6							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1497  f8c6							; inc the count (caller's +75 loop scores it). The
   1498  f8c6							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1499  f8c6							; lifecycle as WallMask holes (D1-B). P2b door models never
   1500  f8c6							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1501  f8c6							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1502  f8c6							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1503  f8c6							; ------------------------------------------------------------------------------
   1504  f8c6				   StripBlastCheck
   1505  f8c6							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1506  f8c6							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1507  f8c6							; Window is still LEFT-half here (the mirror below). Door models stage
   1508  f8c6							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1509  f8c6							; sets b3/b4 instead.
   1510  f8c6		       a5 92		      lda	RectCount
   1511  f8c8		       30 28		      bmi	.SBright	; $FF → no left strip this frame
   1512  f8ca		       a5 8c		      lda	CollisionCellX	; blast hi
   1513  f8cc		       c5 92		      cmp	RectCount
   1514  f8ce		       90 22		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1515  f8d0		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1516  f8d2		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1517  f8d4		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1518  f8d6		       c9 02		      cmp	#2
   1519  f8d8		       b0 18		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1520  f8da							;   (A=0/1 falls into take = overlap)
   1521  f8da				   .SBleftTake
   1522  f8da		       a5 92		      lda	RectCount
   1523  f8dc		       d0 06		      bne	.SBlOk	; an interior strip is a designed block: bombable
   1524  f8de		       a5 db		      lda	RoomExits	; the EDGE strip (dcol 0) is the dead-side plug
   1525  f8e0		       29 02		      and	#2
   1526  f8e2		       d0 0e		      bne	.SBright	;   (no room to the WEST): unbreakable
   1527  f8e4				   .SBlOk
   1528  f8e4		       a5 ba		      lda	EnemyDeadMask
   1529  f8e6		       29 10		      and	#$10
   1530  f8e8		       d0 08		      bne	.SBright	; already destroyed → no double score
   1531  f8ea		       a9 10		      lda	#$10
   1532  f8ec		       05 ba		      ora	EnemyDeadMask
   1533  f8ee		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1534  f8f0		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1535  f8f2				   .SBright
   1536  f8f2							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1537  f8f2							; window here (space is free in this gap): lo_r = 39-hi_l,
   1538  f8f2							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1539  f8f2		       18		      clc
   1540  f8f3		       a5 8e		      lda	CollisionEndX	; lo_l
   1541  f8f5		       49 ff		      eor	#$FF
   1542  f8f7		       69 28		      adc	#40	; hi_r = 39-lo_l
   1543  f8f9		       a8		      tay
   1544  f8fa		       18		      clc
   1545  f8fb		       a5 8c		      lda	CollisionCellX	; hi_l
   1546  f8fd		       49 ff		      eor	#$FF
   1547  f8ff		       69 28		      adc	#40	; lo_r = 39-hi_l
   1548  f901		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1549  f903		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1550  f905		       a5 8c		      lda	CollisionCellX	; hi
   1551  f907		       38		      sec
   1552  f908		       e5 88		      sbc	BMWScratch	; hi - pL
   1553  f90a		       90 29		      bcc	.SBdone	; hi < pL → strip right of the blast
   1554  f90c		       a5 8e		      lda	CollisionEndX	; lo
   1555  f90e		       c5 88		      cmp	BMWScratch
   1556  f910		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1557  f912		       f0 07		      beq	.SBtake	; lo == pL
