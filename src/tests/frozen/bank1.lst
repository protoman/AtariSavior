   1782  fa6b							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1783  fa6b							; Score = THREE packed-BCD bytes, 6 digits, max 999,999 (user 2026-10-27; it was
   1784  fa6b							; one binary thousands digit = 9,999, and level 1 alone is worth ~1,200):
   1785  fa6b							;   ScoreTe = tens|ones   ScoreHu = thousands|hundreds   ScoreTh = 100k|10k
   1786  fa6b							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1787  fa6b							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1788  fa6b							; (the 2026-09-23 decimal-mode rule). The old BINARY fix-up missed nibble-level
   1789  fa6b							; overflow: $25+$75 = $9A stored raw -> glyph index 10 -> the solid-block score
   1790  fa6b							; digit (screenshots/score_issue_002.png).
   1791  fa6b							; A carry out of ScoreTe (>= 100 points) is rare, so it jumps to AddScoreCarry
   1792  fa6b							; (in the $FABB fill) which ripples it up and awards the EXTRA LIFE.
   1793  fa6b							; SIZE PIN: routine runs exactly 40 bytes (UpdateLaserSound's pad target follows).
   1794  fa6b				   AddScore
   1795  fa6b		       f8		      sed
   1796  fa6c		       18		      clc
   1797  fa6d		       65 f5		      adc	ScoreTe
   1798  fa6f		       85 f5		      sta	ScoreTe
   1799  fa71		       90 03		      bcc	.ASdone	; the common case: no carry out of tens/ones
   1800  fa73		       4c bb fa 	      jmp	AddScoreCarry	; D is still set here, C = 1
   1801  fa76				   .ASdone
   1802  fa76		       d8		      cld
   1803  fa77		       4c f8 fb 	      jmp	ReturnPad
   1804  fa7a		       ea ea ea ea*	      .ds	AddScore + 40 - *, $EA	; byte-pin (see SIZE PIN above)
