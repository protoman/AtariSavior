   2179  fde3							; ========================================================================
   2180  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2181  fde3							; ========================================================================
   2182  fde3					      .ds	$FDE3 - *, 0
   2183  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2184  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2185  fde3							; rails keep it inside the room
   2186  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2187  fde3							; surface (line 132) - 7, so its BOTTOM row
   2188  fde3							; sits exactly ON the surface. The live value is
   2189  fde3							; RAFTER_BASE + off (see the tide block below) —
   2190  fde3							; never hard-code the Y: the surface MOVES.
   2191  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2192  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2193  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2194  fde3							; from 12 px above the raft's top to 5 px into it
   2195  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2196  fde3
   2197  fde3				   RaftBody
   2198  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2199  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2200  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2201  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2202  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2203  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2204  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2205  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2206  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2207  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2208  fde3		       a5 c2		      lda	EnemyRamP
   2209  fde5		       29 f0		      and	#$F0
   2210  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2211  fde9		       4a		      lsr
   2212  fdea		       4a		      lsr
   2213  fdeb		       4a		      lsr
   2214  fdec		       4a		      lsr		; A = p (1..15)
   2215  fded		       c9 08		      cmp	#8
   2216  fdef		       90 04		      bcc	.RaftTideTri
   2217  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2218  fdf3		       f0 09		      beq	.RaftTide	; always
   2219  fdf5				   .RaftTideTri
   2220  fdf5		       c9 04		      cmp	#4
   2221  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2222  fdf9		       49 ff		      eor	#$FF
   2223  fdfb		       38		      sec
   2224  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2225  fdfe				   .RaftTide
   2226  fdfe		       18		      clc
   2227  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2228  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2229  fe03							; water line is what the raft floats on
   2230  fe03
   2231  fe03							; --- does the player count as "over the raft"? --------------------------
   2232  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2233  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2234  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2235  fe03							; block here is what makes it park; the pin/carry later still applies while
   2236  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2237  fe03							; raft he is actually standing on.
   2238  fe03		       a5 80		      lda	RoomX
   2239  fe05		       38		      sec
   2240  fe06		       f5 bd		      sbc	EnemyRamX,X
   2241  fe08		       18		      clc
   2242  fe09		       69 06		      adc	#RAFTER_XOFF
   2243  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2244  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2245  fe0f		       a5 81		      lda	RoomY
   2246  fe11		       38		      sec
   2247  fe12		       f5 e2		      sbc	EnemyRamY,X
   2248  fe14		       18		      clc
   2249  fe15		       69 0c		      adc	#RAFTER_PINFIT
   2250  fe17		       c9 12		      cmp	#RAFTER_YSPAN
   2251  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2252  fe1b		       a5 94		      lda	vyHi
   2253  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2254  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2255  fe22				   .RaftNoRide
   2256  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2257  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2258  fe22		       a5 f0		      lda	$F0
   2259  fe24		       29 07		      and	#%00000111
   2260  fe26		       85 f0		      sta	$F0
   2261  fe28		       4c f8 fb 	      jmp	ReturnPad
   2262  fe2b				   .RaftGo
   2263  fe2b							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2264  fe2b							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2265  fe2b							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2266  fe2b							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2267  fe2b							; it cannot borrow upward either (see the kernel EQU for the contract).
   2268  fe2b							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2269  fe2b							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2270  fe2b							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2271  fe2b		       a5 f0		      lda	$F0
   2272  fe2d		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2273  fe2f		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2274  fe31		       f0 04		      beq	.RaftAtSpeed
   2275  fe33		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2276  fe35		       d0 07		      bne	.RaftHaveStep	; always
   2277  fe37				   .RaftAtSpeed
   2278  fe37		       a5 c2		      lda	EnemyRamP
   2279  fe39		       29 01		      and	#1
   2280  fe3b		       18		      clc
   2281  fe3c		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2282  fe3e				   .RaftHaveStep
   2283  fe3e		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2284  fe40		       bd 44 f8 	      lda	RaftBitTab,X
   2285  fe43		       25 c1		      and	EnemyRamD
   2286  fe45		       f0 29		      beq	.RaftLeft
   2287  fe47							; ---- leading edge right: candidate = x + step ---------------------------
   2288  fe47		       b5 bd		      lda	EnemyRamX,X
   2289  fe49		       18		      clc
   2290  fe4a		       65 88		      adc	$88
   2291  fe4c		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2292  fe4e		       c9 94		      cmp	#RAFT_MAX_X
   2293  fe50		       b0 14		      bcs	.RaftTurn	; right rail
   2294  fe52		       18		      clc
   2295  fe53		       69 01		      adc	#1	; the cell just beyond the right edge
   2296  fe55		       4a		      lsr
   2297  fe56		       4a		      lsr
   2298  fe57		       20 26 f8 	      jsr	RaftCellSolid
   2299  fe5a		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2300  fe5c		       b5 bd		      lda	EnemyRamX,X
   2301  fe5e		       18		      clc
   2302  fe5f		       65 88		      adc	$88
   2303  fe61		       95 bd		      sta	EnemyRamX,X
   2304  fe63		       4c 90 fe 	      jmp	.RaftRide
   2305  fe66							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
   2306  fe66							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2307  fe66				   .RaftTurn
   2308  fe66		       bd 44 f8 	      lda	RaftBitTab,X
   2309  fe69		       45 c1		      eor	EnemyRamD
   2310  fe6b		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2311  fe6d							; bank1's RoomDarkMask — must be preserved)
   2312  fe6d		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2313  fe70							; ---- leading edge left --------------------------------------------------
   2314  fe70				   .RaftLeft
   2315  fe70		       b5 bd		      lda	EnemyRamX,X
   2316  fe72		       38		      sec
   2317  fe73		       e5 88		      sbc	$88
   2318  fe75		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2319  fe77		       c9 08		      cmp	#RAFT_MIN_X
   2320  fe79		       90 eb		      bcc	.RaftTurn	; left rail
   2321  fe7b		       38		      sec
   2322  fe7c		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2323  fe7e		       b0 02		      bcs	.RaftLeftCol
   2324  fe80		       a9 00		      lda	#0
   2325  fe82				   .RaftLeftCol
   2326  fe82		       4a		      lsr
   2327  fe83		       4a		      lsr
   2328  fe84		       20 26 f8 	      jsr	RaftCellSolid
   2329  fe87		       d0 dd		      bne	.RaftTurn
   2330  fe89		       b5 bd		      lda	EnemyRamX,X
   2331  fe8b		       38		      sec
   2332  fe8c		       e5 88		      sbc	$88
   2333  fe8e		       95 bd		      sta	EnemyRamX,X
