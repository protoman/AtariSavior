   2218  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2219  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2220  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2221  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2222  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2223  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2224  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2225  fd68				   SetupScorePointers
   2226  fd68							; --- Initialize score to 0 on first frame ---
   2227  fd68		       a5 ad		      lda	Temp
   2228  fd6a		       d0 0c		      bne	.scoreInitDone
   2229  fd6c		       e6 ad		      inc	Temp
   2230  fd6e		       a9 00		      lda	#0
   2231  fd70		       85 f3		      sta	ScoreTh
   2232  fd72		       85 f4		      sta	ScoreHu
   2233  fd74		       a9 00		      lda	#$00
   2234  fd76		       85 f5		      sta	ScoreTe
   2235  fd78				   .scoreInitDone
   2236  fd78
   2237  fd78							; --- Set up 6 digit pointers ---
   2238  fd78							; High bytes first (all $FD)
   2239  fd78		       a9 fd		      lda	#>DigitGfx
   2240  fd7a		       85 e1		      sta	scorePtr1+1
   2241  fd7c		       85 e3		      sta	scorePtr2+1
   2242  fd7e		       85 e5		      sta	scorePtr3+1
   2243  fd80		       85 e7		      sta	scorePtr4+1
   2244  fd82		       85 e9		      sta	scorePtr5+1
   2245  fd84		       85 eb		      sta	scorePtr6+1
   2246  fd86
   2247  fd86		       a5 f2		      lda	LevelShowTimer
   2248  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2249  fd8a		       f0 2e		      beq	.scoreLows
   2250  fd8c		       c6 f2		      dec	LevelShowTimer
   2251  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2252  fd90		       85 e0		      sta	scorePtr1
   2253  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2254  fd94		       85 e2		      sta	scorePtr2
   2255  fd96		       a9 00		      lda	#0	; hundreds '0'
   2256  fd98		       85 e4		      sta	scorePtr3
   2257  fd9a		       a5 a3		      lda	Level
   2258  fd9c		       18		      clc
   2259  fd9d		       69 01		      adc	#1	; 1-based level number
   2260  fd9f		       a2 00		      ldx	#0
   2261  fda1				   .LVTens
   2262  fda1		       c9 0a		      cmp	#10
   2263  fda3		       90 05		      bcc	.LVTensDone
   2264  fda5		       e9 0a		      sbc	#10
   2265  fda7		       e8		      inx
   2266  fda8		       d0 f7		      bne	.LVTens
   2267  fdaa				   .LVTensDone
   2268  fdaa		       0a		      asl
   2269  fdab		       0a		      asl
   2270  fdac		       0a		      asl		; ones * 8
   2271  fdad		       85 e8		      sta	scorePtr5
   2272  fdaf		       8a		      txa
   2273  fdb0		       0a		      asl
   2274  fdb1		       0a		      asl
   2275  fdb2		       0a		      asl		; tens * 8
   2276  fdb3		       85 e6		      sta	scorePtr4
   2277  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2278  fdb7		       85 ea		      sta	scorePtr6
   2279  fdb9		       60		      rts
   2280  fdba
   2281  fdba							; scorePtr1..2 = leading zeros
   2282  fdba				   .scoreLows
   2283  fdba		       a9 00		      lda	#0
   2284  fdbc		       85 e0		      sta	scorePtr1
   2285  fdbe		       85 e2		      sta	scorePtr2
   2286  fdc0
   2287  fdc0							; scorePtr3 = ScoreTh * 8
   2288  fdc0		       a5 f3		      lda	ScoreTh
   2289  fdc2		       0a		      asl
   2290  fdc3		       0a		      asl
   2291  fdc4		       0a		      asl
   2292  fdc5		       85 e4		      sta	scorePtr3
   2293  fdc7
