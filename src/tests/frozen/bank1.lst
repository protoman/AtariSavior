   1625  fac4				   LaserFreqTable
   1626  fac4		       04 07 0a 0c*	      .byte.b	4,7,10,12,14,12,10,7
   1627  facc
   1628  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1629  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1630  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1631  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1632  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1633  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1634  facc							;   double-score guard for that slot only — first blast sees the pair
   1635  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1636  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1637  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1638  facc							;   Same-bank jsr legal (no pad nesting).
   1639  facc				   PairGone
   1640  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1641  face		       aa		      tax
   1642  facf		       bd 68 fa 	      lda	BombClearMask,X
   1643  fad2		       49 ff		      eor	#$FF
   1644  fad4		       a8		      tay		; Y = bit for col x
   1645  fad5		       e8		      inx
   1646  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1647  fad9		       49 ff		      eor	#$FF
   1648  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1649  fadd		       98		      tya
   1650  fade		       05 ad		      ora	Temp
   1651  fae0		       85 ad		      sta	Temp	; both pair bits
   1652  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1653  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1654  fae2		       a4 84		      ldy	LineCount
   1655  fae4		       e0 04		      cpx	#4
   1656  fae6		       90 0a		      bcc	.pg0
   1657  fae8		       e0 0c		      cpx	#12
   1658  faea		       90 0c		      bcc	.pg1
   1659  faec		       b9 c9 00 	      lda	PF2Buf,Y
   1660  faef		       25 ad		      and	Temp
   1661  faf1		       60		      rts
   1662  faf2				   .pg0
   1663  faf2		       b9 c3 00 	      lda	PF0Buf,Y
   1664  faf5		       25 ad		      and	Temp
   1665  faf7		       60		      rts
   1666  faf8				   .pg1
   1667  faf8		       b9 c6 00 	      lda	PF1Buf,Y
   1668  fafb		       25 ad		      and	Temp
   1669  fafd		       60		      rts
