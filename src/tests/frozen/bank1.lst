     81  f02c		       4a		      lsr
     82  f02d		       29 0f		      and	#15
     83  f02f		       c9 08		      cmp	#8
     84  f031		       90 02		      bcc	.mUpB1
     85  f033		       49 0f		      eor	#15
     86  f035				   .mUpB1
