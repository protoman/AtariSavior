   1306  f81c							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1307  f81c							; X=0 positions P0, X=1 positions P1
   1308  f81c							; A = pixel position (0-159)
   1309  f81c							; ========================================================================
   1310  f81c				   SetObjectXPos_b1
   1311  f81c		       85 02		      sta	WSYNC
   1312  f81e		       38		      sec
   1313  f81f				   .Div15Loop
   1314  f81f		       e9 0f		      sbc	#15
   1315  f821		       b0 fc		      bcs	.Div15Loop
   1316  f823		       a8		      tay
   1317  f824		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1318  f827		       95 20		      sta	HMP0,X
   1319  f829		       95 10		      sta	RESP0,X
   1320  f82b		       60		      rts
   1321  f82c
   1322  f82c							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1323  f82c							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1324  f82c							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1325  f82c							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1326  f82c							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1327  f82c							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1328  f82c				   BarDelayTable		; (B+7)>>3, 15 entries
   1329  f82c		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1330  f83b				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1331  f83b		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
   1332  f84a
   1333  f84a							; ------------------------------------------------------------------------------
   1334  f84a
   1335  f84a							; ==============================================================================
   1336  f84a							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1337  f84a							; ==============================================================================
   1338  f84a							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1339  f84a							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1340  f84a							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1341  f84a							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1342  f84a							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1343  f84a							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1344  f84a							; TickCounter — writing that would stall the game timer).
   1345  f84a							;
   1346  f84a							; User spec 2026-10-18: floats only on water; carries the player across and
   1347  f84a							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1348  f84a							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1349  f84a							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1350  f84a							;	       into CollisionX, kernel draws the strip as the band's last
   1351  f84a							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1352  f84a							;	       row sits exactly on the moving surface — it rides the wave the
   1353  f84a							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1354  f84a							;	       stays clear of the 125 water-kill line at every tide phase.
   1355  f84a							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1356  f84a							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1357  f84a							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1358  f84a							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1359  f84a							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1360  f84a							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1361  f84a							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1362  f84a							;	       flag+level, so the empty raft runs at full speed and the next
   1363  f84a							;	       take-off ramps again. It also holds the frame it turns around on.
   1364  f84a							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1365  f84a							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1366  f84a							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1367  f84a							;	       exactly the open water span of the room.
   1368  f84a							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1369  f84a							;	       its upper rows; step off and it parks immediately (the ramp state
   1370  f84a							;	       is cleared too, so the next take-off ramps again). While over it a
   1371  f84a							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1372  f84a							;	       zeroed (gravity must never accumulate into the water) and carried
   1373  f84a							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1374  f84a							;	       flying off is always possible. Leaving and re-entering the ROOM
   1375  f84a							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1376  f84a							;	       it), which is the "reset" the user asked for.
   1377  f84a							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1378  f84a							; ==============================================================================
   1379  f84a							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1380  f84a							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1381  f84a							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1382  f84a							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1383  f84a							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1384  f84a							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1385  f84a							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1386  f84a							;   cols 20-39 -> the mirrored half: source = 39-col
   1387  f84a				   RaftCellSolid
   1388  f84a		       c9 14		      cmp	#20
   1389  f84c		       90 05		      bcc	.RCSrc
   1390  f84e		       49 ff		      eor	#$ff
   1391  f850		       18		      clc
   1392  f851		       69 28		      adc	#40
   1393  f853				   .RCSrc
   1394  f853		       a8		      tay
   1395  f854		       b9 6c f8 	      lda	RaftCellMasks,Y
   1396  f857		       c0 04		      cpy	#4
   1397  f859		       b0 03		      bcs	.RCPF1
   1398  f85b		       25 c5		      and	$C5
   1399  f85d		       60		      rts
   1400  f85e				   .RCPF1
   1401  f85e		       c0 0c		      cpy	#12
   1402  f860		       b0 03		      bcs	.RCPF2
   1403  f862		       25 c8		      and	$C8
   1404  f864		       60		      rts
   1405  f865				   .RCPF2
   1406  f865		       25 cb		      and	$CB
   1407  f867		       60		      rts
