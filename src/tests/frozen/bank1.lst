   1964  fc81		       aa		      tax
   1965  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   1966  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   1967  fc87		       4c f8 fb 	      jmp	ReturnPad
   1968  fc8a				   .IRDhi
   1969  fc8a		       c9 08		      cmp	#8
   1970  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   1971  fc8e		       aa		      tax
