    636  f560		       00 c1	   EnemyRamD  =	$C1
    637  f560		       00 bd	   EnemyRamX  =	$BD	; 3 bytes live enemy X (slots 0-2) — raft body
    638  f560		       00 e2	   EnemyRamY  =	$E2	; 3 bytes live enemy Y (private since S3.4)
    639  f560		       00 93	   vyLo       =	$93	; Y velocity lo (signed 16) — raft riding pins it
    640  f560		       00 94	   vyHi       =	$94	; Y velocity hi
