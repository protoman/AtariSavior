    601  f44f							; ------------------------------------------------------------------------------
    602  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    603  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    604  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    605  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    606  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    607  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    608  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    609  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    610  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    611  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    612  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    613  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    614  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    615  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    616  f44f							; ------------------------------------------------------------------------------
    617  f44f				   TallyEntry
    618  f44f		       a5 8a		      lda	DropTarget
    619  f451		       f0 36		      beq	.TEArm
    620  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    621  f455		       d0 2d		      bne	.TEIdle
    622  f457		       a9 04		      lda	#4
    623  f459		       85 ad		      sta	TickCounter
    624  f45b		       c6 f2		      dec	TallyTicks
    625  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    626  f45f		       a5 f2		      lda	TallyTicks
    627  f461		       29 03		      and	#3
    628  f463		       d0 15		      bne	.TEOne	; tick only
    629  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    630  f467		       85 f1		      sta	BombSnd
    631  f469		       a9 04		      lda	#4
    632  f46b		       85 15		      sta	AUDC0	; square
    633  f46d		       a9 18		      lda	#24
    634  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    635  f471		       a9 08		      lda	#8
    636  f473		       85 19		      sta	AUDV0
    637  f475		       a9 03		      lda	#3	; tick + coin
    638  f477		       4c f8 fb 	      jmp	ReturnPad
    639  f47a				   .TEOne
    640  f47a		       a9 01		      lda	#1	; tick only
    641  f47c		       4c f8 fb 	      jmp	ReturnPad
    642  f47f				   .TEFinal
    643  f47f		       a9 07		      lda	#7	; tick + coin + done
    644  f481		       4c f8 fb 	      jmp	ReturnPad
    645  f484				   .TEIdle
    646  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    647  f486		       4c f8 fb 	      jmp	ReturnPad
    648  f489				   .TEArm
    649  f489		       a5 ae		      lda	BarLevel
    650  f48b		       18		      clc
    651  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    652  f48e		       a2 00		      ldx	#0
