   1118  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1119  f7ee							; Path A (PlayerLives > 0) — execution count:
   1120  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1121  f7ee							;   Timer:    3 loop + 1 gap = 4
   1122  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1123  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
