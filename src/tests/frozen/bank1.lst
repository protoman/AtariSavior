    592  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    593  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    594  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    595  f433		       4a		      lsr
    596  f434		       4a		      lsr
    597  f435		       4a		      lsr
    598  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    599  f437							;   high end — StripBlastCheck rejects)
    600  f437		       38		      sec
    601  f438		       e9 01		      sbc	#1	; ℓ = left_col
    602  f43a		       0a		      asl		; 2ℓ = strip left dcol
    603  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    604  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    605  f440				   .M1SBnone
