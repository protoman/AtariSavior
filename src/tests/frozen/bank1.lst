   2192  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2193  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2194  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2195  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2196  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2197  fd68							; once per banner frame. Lives with the glyphs (bank1's pre-pad region is
   2198  fd68							; tight; the score section is a jsr here from MenuMain).
   2199  fd68				   SetupScorePointers
   2200  fd68							; --- Initialize score to 0 on first frame ---
   2201  fd68		       a5 ad		      lda	Temp
   2202  fd6a		       d0 0c		      bne	.scoreInitDone
   2203  fd6c		       e6 ad		      inc	Temp
   2204  fd6e		       a9 00		      lda	#0
