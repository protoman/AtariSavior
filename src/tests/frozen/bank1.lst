   1203  f7a4							; ====================================================================
   1204  f7a4							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1205  f7a4							; Proven kernel from score48pix.asm
   1206  f7a4							; ====================================================================
