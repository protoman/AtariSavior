   1577  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1578  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1579  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1580  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1581  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1582  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1583  facc							;   double-score guard for that slot only — first blast sees the pair
   1584  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1585  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1586  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1587  facc							;   Same-bank jsr legal (no pad nesting).
   1588  facc				   PairGone
   1589  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1590  face		       aa		      tax
   1591  facf		       bd 68 fa 	      lda	BombClearMask,X
   1592  fad2		       49 ff		      eor	#$FF
   1593  fad4		       a8		      tay		; Y = bit for col x
   1594  fad5		       e8		      inx
   1595  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1596  fad9		       49 ff		      eor	#$FF
   1597  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1598  fadd		       98		      tya
   1599  fade		       05 ad		      ora	Temp
   1600  fae0		       85 ad		      sta	Temp	; both pair bits
   1601  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1602  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1603  fae2		       a4 84		      ldy	LineCount
   1604  fae4		       e0 04		      cpx	#4
   1605  fae6		       90 0a		      bcc	.pg0
   1606  fae8		       e0 0c		      cpx	#12
   1607  faea		       90 0c		      bcc	.pg1
   1608  faec		       b9 c9 00 	      lda	PF2Buf,Y
   1609  faef		       25 ad		      and	Temp
   1610  faf1		       60		      rts
   1611  faf2				   .pg0
   1612  faf2		       b9 c3 00 	      lda	PF0Buf,Y
   1613  faf5		       25 ad		      and	Temp
   1614  faf7		       60		      rts
   1615  faf8				   .pg1
   1616  faf8		       b9 c6 00 	      lda	PF1Buf,Y
   1617  fafb		       25 ad		      and	Temp
   1618  fafd		       60		      rts
