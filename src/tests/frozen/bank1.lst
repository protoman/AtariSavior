   2183  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2184  fd90		       85 e0		      sta	scorePtr1
   2185  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
