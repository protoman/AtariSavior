    485  f35a							; ==============================================================================
    486  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    487  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    488  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    489  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    490  f35a							;   byte = note_code*4 + duration_code
    491  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    492  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    493  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    494  f35a							; ==============================================================================
    495  f35a							; --- Melody state: BombX/BombTimer ($F6/$F7) ------------------------------
    496  f35a							; The theme plays ONLY on title frames, and on those frames the bomb block
    497  f35a							; never runs (DropTarget != 0 -> DropStep skips it), so the bomb's two bytes are
    498  f35a							; dead for exactly as long as the music is alive. Sharing them here frees
    499  f35a							; $9D/$9E, which the CAVE kernel needs on BOTH kinds of frame (the title
    500  f35a							; previews the stage with real room objects) — that is where the per-type
    501  f35a							; object height will live. Restart on return: the title-entry path zeroes both.
    502  f35a							; Contract: nothing may read BombX/BombTimer while a title frame is running.
    503  f35a		       00 f6	   MelPtr     =	$F6	; = kernel BombX   (dead on the title)
    504  f35a		       00 f7	   MelTimer   =	$F7	; = kernel BombTimer (dead on the title)
    505  f35a
    506  f35a				   MusicTick
    507  f35a		       a9 00		      lda	#0
    508  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    509  f35e		       a6 f6		      ldx	MelPtr
    510  f360		       a5 f7		      lda	MelTimer
    511  f362		       f0 0d		      beq	.MelLoad
    512  f364		       c6 f7		      dec	MelTimer
    513  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    514  f369							;   MelPtr already points at the NEXT step, so
    515  f369							;   this mirrors the pre-pack (duration,note)
    516  f369							;   player's MusicMel+1,X read, keeps the same
    517  f369							;   audible melody
    518  f369		       4a		      lsr
    519  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    520  f36b		       20 98 f3 	      jsr	MelApply
    521  f36e		       4c f8 fb 	      jmp	ReturnPad
    522  f371				   .MelLoad
    523  f371		       bd b0 f3 	      lda	MusicMel,X
    524  f374		       29 03		      and	#3
    525  f376		       a8		      tay
    526  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    527  f37a		       85 f7		      sta	MelTimer
    528  f37c		       bd b0 f3 	      lda	MusicMel,X
    529  f37f		       4a		      lsr
    530  f380		       4a		      lsr
    531  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    532  f383		       f0 0c		      beq	.MelLoop
    533  f385		       20 98 f3 	      jsr	MelApply
    534  f388		       8a		      txa
    535  f389		       18		      clc
    536  f38a		       69 01		      adc	#1
    537  f38c		       85 f6		      sta	MelPtr
    538  f38e		       4c f8 fb 	      jmp	ReturnPad
    539  f391				   .MelLoop
    540  f391		       a9 00		      lda	#0
    541  f393		       85 f6		      sta	MelPtr
    542  f395		       4c f8 fb 	      jmp	ReturnPad
    543  f398
    544  f398							; MelApply: A = note code. Starts the Lead at that pitch, or silences AUD0 on
    545  f398							; a rest ($3E). $3F (loop) HOLDS the tone the load frame started - the old
    546  f398							; paired player's `cmp #$FF / beq .MelDone` arm, kept for an identical melody.
    547  f398				   MelApply
    548  f398		       c9 3f		      cmp	#$3F
    549  f39a		       f0 13		      beq	.MAHold
    550  f39c		       c9 3e		      cmp	#$3E
    551  f39e		       f0 0b		      beq	.MAOff
