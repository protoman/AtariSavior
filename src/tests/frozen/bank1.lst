   1892  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   1893  fc87		       4c f8 fb 	      jmp	ReturnPad
   1894  fc8a				   .IRDhi
   1895  fc8a		       c9 08		      cmp	#8
   1896  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   1897  fc8e		       aa		      tax
