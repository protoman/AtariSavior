   1635  fa7d		       18		      clc
   1636  fa7e		       65 f5		      adc	ScoreTe
   1637  fa80		       d8		      cld
   1638  fa81		       90 1c		      bcc	.ASstoreTe
   1639  fa83		       ea		      nop		; byte-pin (see SIZE PIN above)
   1640  fa84		       ea		      nop		; byte-pin
   1641  fa85		       48		      pha		; save wrapped ScoreTe
   1642  fa86		       e6 f4		      inc	ScoreHu
   1643  fa88		       a5 f4		      lda	ScoreHu
   1644  fa8a		       c9 0a		      cmp	#10
   1645  fa8c		       90 10		      bcc	.AShuOk
   1646  fa8e		       a9 00		      lda	#0
   1647  fa90		       85 f4		      sta	ScoreHu
   1648  fa92		       e6 f3		      inc	ScoreTh
   1649  fa94		       a5 f3		      lda	ScoreTh
   1650  fa96		       c9 0a		      cmp	#10
   1651  fa98		       90 04		      bcc	.ASthOk
   1652  fa9a		       a9 09		      lda	#9
   1653  fa9c		       85 f3		      sta	ScoreTh
   1654  fa9e				   .ASthOk
   1655  fa9e				   .AShuOk
   1656  fa9e		       68		      pla
