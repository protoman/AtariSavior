   2030  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   2031  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2032  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2033  fc78							; check_callpads asserts they equal these labels.
   2034  fc78							; ------------------------------------------------------------------------
   2035  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2036  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2037  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2038  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2039  fc78							; survives the cross-bank return.
   2040  fc78				   IsRoomDark
   2041  fc78		       a5 98		      lda	RoomNo
   2042  fc7a		       c9 04		      cmp	#4
   2043  fc7c		       b0 0c		      bcs	.IRDhi
   2044  fc7e		       18		      clc
   2045  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2046  fc81		       aa		      tax
   2047  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2048  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2049  fc87		       4c f8 fb 	      jmp	ReturnPad
   2050  fc8a				   .IRDhi
   2051  fc8a		       c9 08		      cmp	#8
   2052  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2053  fc8e		       aa		      tax
   2054  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2055  fc92		       4a		      lsr
   2056  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2057  fc94		       25 c0		      and	LaserState
   2058  fc96		       4c f8 fb 	      jmp	ReturnPad
   2059  fc99				   .IRDlit
   2060  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2061  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2062  fc9e
   2063  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2064  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2065  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2066  fc9e				   SetRoomDark
   2067  fc9e		       a5 98		      lda	RoomNo
   2068  fca0		       c9 04		      cmp	#4
   2069  fca2		       b0 0e		      bcs	.SRDhi
   2070  fca4		       18		      clc
   2071  fca5		       69 04		      adc	#4
   2072  fca7		       aa		      tax
   2073  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2074  fcab		       05 c1		      ora	EnemyRamD
   2075  fcad		       85 c1		      sta	EnemyRamD
   2076  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2077  fcb2				   .SRDhi
   2078  fcb2		       c9 08		      cmp	#8
