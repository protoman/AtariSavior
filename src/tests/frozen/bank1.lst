   1069  f7a4							; ====================================================================
   1070  f7a4							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1071  f7a4							; Proven kernel from score48pix.asm
   1072  f7a4							; ====================================================================
