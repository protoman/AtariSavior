   1928  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   1929  fc87		       4c f8 fb 	      jmp	ReturnPad
   1930  fc8a				   .IRDhi
   1931  fc8a		       c9 08		      cmp	#8
   1932  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   1933  fc8e		       aa		      tax
   1934  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   1935  fc92		       4a		      lsr
   1936  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   1937  fc94		       25 c0		      and	LaserState
   1938  fc96		       4c f8 fb 	      jmp	ReturnPad
   1939  fc99				   .IRDlit
