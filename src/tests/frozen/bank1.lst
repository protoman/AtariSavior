   2013  fc20							; CallPad tail pads (2026-10-20: SPLIT across the banks, no twin). kernel.asm
   2014  fc20							; holds the three `sta $1FF5` at $FC4F/$FC52/$FC55; after the switch the fetch
   2015  fc20							; at A+3 lands HERE, so bank1 keeps only the `jmp` halves. Nothing calls a
   2016  fc20							; tail pad from bank1, so bank1's `sta` halves and bank0's `jmp` halves were
   2017  fc20							; dead bytes — reclaiming them gave bank0 15 B of pre-pad headroom.
   2018  fc20							;   $FC52 <-$FC4F+3 CallPad_TitleSelect
   2019  fc20							;   $FC55 <-$FC52+3 CallPad_TitleBand
   2020  fc20							;   $FC58 <-$FC55+3 CallPad_MusicTick
   2021  fc20							; Guard: verify_build.check_callpads (per-pad A / A+3 contract).
   2022  fc20		       00 00 00 00*	      .ds	$FC52 - *, 0
   2023  fc52		       4c 50 f0 	      jmp	TitleSelect
   2024  fc55					      .ds	$FC55 - *, 0
   2025  fc55		       4c 80 f0 	      jmp	$F080	; TitleBand
   2026  fc58					      .ds	$FC58 - *, 0
   2027  fc58		       4c 5a f3 	      jmp	MusicTick
   2028  fc5b
   2029  fc5b							; ========================================================================
   2030  fc5b							; Fold-pad stubs (byte-identical to bank0)
   2031  fc5b							; ========================================================================
   2032  fc5b		       00 00 00 00*	      .ds	$FC68 - *, 0
   2033  fc68		       a9 01		      lda	#1
   2034  fc6a		       8d f5 1f 	      sta	$1FF5
   2035  fc6d		       4c 40 f5 	      jmp	$F540
   2036  fc70
   2037  fc70					      .ds	$FC70 - *, 0
   2038  fc70		       a9 00		      lda	#0
   2039  fc72		       8d f4 1f 	      sta	$1FF4
   2040  fc75		       4c 92 f1 	      jmp	$F192	; Overscan in bank0 (must match bank0 ToGameStub;
   2041  fc78							; verify_build --sync-overscan patches this from
   2042  fc78							; bank0.lst after every bank0 build)
