   2255  fd7c		       85 e3		      sta	scorePtr2+1
   2256  fd7e		       85 e5		      sta	scorePtr3+1
   2257  fd80		       85 e7		      sta	scorePtr4+1
   2258  fd82		       85 e9		      sta	scorePtr5+1
   2259  fd84		       85 eb		      sta	scorePtr6+1
   2260  fd86
   2261  fd86		       a5 f2		      lda	LevelShowTimer
   2262  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2263  fd8a		       f0 2e		      beq	.scoreLows
   2264  fd8c		       c6 f2		      dec	LevelShowTimer
   2265  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2266  fd90		       85 e0		      sta	scorePtr1
   2267  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2268  fd94		       85 e2		      sta	scorePtr2
   2269  fd96		       a9 00		      lda	#0	; hundreds '0'
   2270  fd98		       85 e4		      sta	scorePtr3
