   1216  f7da							; --- Restore cave kernel settings ---
   1217  f7da		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + 8-clk ball (cave mode
   1218  f7dc							; since D6 — bank1 bar overwrote $05 during its band)
   1219  f7dc		       85 0a		      sta	CTRLPF
   1220  f7de		       a9 00		      lda	#0
