   1201  f797		       85 05		      sta	NUSIZ1
   1202  f799		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1203  f79b		       85 25		      sta	VDELP0
   1204  f79d		       85 26		      sta	VDELP1
   1205  f79f							; Flush both VDELP buffers + live registers to 0.
   1206  f79f							; Without this, stale buffer data from previous frame shows as
   1207  f79f							; white ghost copies during the positioning scanlines.
   1208  f79f		       a9 00		      lda	#0
   1209  f7a1		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1210  f7a3		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1211  f7a5		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
