   1409  f868				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1410  f868		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1411  f86c
   1412  f86c				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1413  f86c		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1414  f870		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1415  f874		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1416  f878		       01 02 04 08	      .byte.b	$01, $02, $04, $08
