   2097  fc78							; ========================================================================
   2098  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   2099  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2100  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2101  fc78							; check_callpads asserts they equal these labels.
   2102  fc78							; ------------------------------------------------------------------------
   2103  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2104  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2105  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2106  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2107  fc78							; survives the cross-bank return.
   2108  fc78				   IsRoomDark
   2109  fc78		       a5 98		      lda	RoomNo
   2110  fc7a		       c9 04		      cmp	#4
   2111  fc7c		       b0 0c		      bcs	.IRDhi
   2112  fc7e		       18		      clc
   2113  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2114  fc81		       aa		      tax
   2115  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2116  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2117  fc87		       4c f8 fb 	      jmp	ReturnPad
   2118  fc8a				   .IRDhi
   2119  fc8a		       c9 08		      cmp	#8
   2120  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2121  fc8e		       aa		      tax
   2122  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2123  fc92		       4a		      lsr
   2124  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2125  fc94		       25 c0		      and	LaserState
   2126  fc96		       4c f8 fb 	      jmp	ReturnPad
   2127  fc99				   .IRDlit
   2128  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2129  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2130  fc9e
   2131  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2132  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2133  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2134  fc9e				   SetRoomDark
   2135  fc9e		       a5 98		      lda	RoomNo
   2136  fca0		       c9 04		      cmp	#4
   2137  fca2		       b0 0e		      bcs	.SRDhi
   2138  fca4		       18		      clc
   2139  fca5		       69 04		      adc	#4
   2140  fca7		       aa		      tax
   2141  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2142  fcab		       05 c1		      ora	EnemyRamD
   2143  fcad		       85 c1		      sta	EnemyRamD
   2144  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2145  fcb2				   .SRDhi
   2146  fcb2		       c9 08		      cmp	#8
   2147  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2148  fcb6		       aa		      tax
   2149  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2150  fcba		       4a		      lsr
   2151  fcbb		       4a		      lsr
   2152  fcbc		       05 c0		      ora	LaserState
   2153  fcbe		       85 c0		      sta	LaserState
   2154  fcc0				   .SRDdone
   2155  fcc0		       4c f8 fb 	      jmp	ReturnPad
