    616  f44f							; ------------------------------------------------------------------------------
    617  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    618  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    619  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    620  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    621  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    622  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    623  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    624  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    625  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    626  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    627  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    628  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    629  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    630  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    631  f44f							; ------------------------------------------------------------------------------
    632  f44f				   TallyEntry
    633  f44f		       a5 8a		      lda	DropTarget
    634  f451		       f0 36		      beq	.TEArm
    635  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    636  f455		       d0 2d		      bne	.TEIdle
    637  f457		       a9 04		      lda	#4
    638  f459		       85 ad		      sta	TickCounter
    639  f45b		       c6 f2		      dec	TallyTicks
    640  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    641  f45f		       a5 f2		      lda	TallyTicks
    642  f461		       29 03		      and	#3
    643  f463		       d0 15		      bne	.TEOne	; tick only
    644  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    645  f467		       85 f1		      sta	BombSnd
    646  f469		       a9 04		      lda	#4
    647  f46b		       85 15		      sta	AUDC0	; square
    648  f46d		       a9 18		      lda	#24
    649  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    650  f471		       a9 08		      lda	#8
    651  f473		       85 19		      sta	AUDV0
    652  f475		       a9 03		      lda	#3	; tick + coin
    653  f477		       4c f8 fb 	      jmp	ReturnPad
    654  f47a				   .TEOne
    655  f47a		       a9 01		      lda	#1	; tick only
    656  f47c		       4c f8 fb 	      jmp	ReturnPad
    657  f47f				   .TEFinal
    658  f47f		       a9 07		      lda	#7	; tick + coin + done
    659  f481		       4c f8 fb 	      jmp	ReturnPad
    660  f484				   .TEIdle
    661  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    662  f486		       4c f8 fb 	      jmp	ReturnPad
    663  f489				   .TEArm
    664  f489		       a5 ae		      lda	BarLevel
    665  f48b		       18		      clc
