   2021  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2022  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2023  fc78							; check_callpads asserts they equal these labels.
   2024  fc78							; ------------------------------------------------------------------------
   2025  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2026  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2027  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2028  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2029  fc78							; survives the cross-bank return.
   2030  fc78				   IsRoomDark
   2031  fc78		       a5 98		      lda	RoomNo
   2032  fc7a		       c9 04		      cmp	#4
   2033  fc7c		       b0 0c		      bcs	.IRDhi
   2034  fc7e		       18		      clc
   2035  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2036  fc81		       aa		      tax
   2037  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2038  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2039  fc87		       4c f8 fb 	      jmp	ReturnPad
   2040  fc8a				   .IRDhi
   2041  fc8a		       c9 08		      cmp	#8
   2042  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2043  fc8e		       aa		      tax
   2044  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2045  fc92		       4a		      lsr
   2046  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2047  fc94		       25 c0		      and	LaserState
   2048  fc96		       4c f8 fb 	      jmp	ReturnPad
   2049  fc99				   .IRDlit
   2050  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2051  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2052  fc9e
   2053  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2054  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2055  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2056  fc9e				   SetRoomDark
   2057  fc9e		       a5 98		      lda	RoomNo
   2058  fca0		       c9 04		      cmp	#4
   2059  fca2		       b0 0e		      bcs	.SRDhi
   2060  fca4		       18		      clc
   2061  fca5		       69 04		      adc	#4
   2062  fca7		       aa		      tax
   2063  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2064  fcab		       05 c1		      ora	EnemyRamD
   2065  fcad		       85 c1		      sta	EnemyRamD
   2066  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2067  fcb2				   .SRDhi
   2068  fcb2		       c9 08		      cmp	#8
   2069  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2070  fcb6		       aa		      tax
   2071  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2072  fcba		       4a		      lsr
   2073  fcbb		       4a		      lsr
   2074  fcbc		       05 c0		      ora	LaserState
   2075  fcbe		       85 c0		      sta	LaserState
   2076  fcc0				   .SRDdone
   2077  fcc0		       4c f8 fb 	      jmp	ReturnPad
   2078  fcc3
   2079  fcc3							; Bit masks for IsRoomDark/SetRoomDark. Index 4+room for EnemyRamD
   2080  fcc3							; (rooms 0-3 → bits 4-7); index = room for LaserState (rooms 4-7 →
   2081  fcc3							; bits 4-7 of the table, lsr×2 down to bits 2-5 = LaserState spare).
   2082  fcc3				   BitMaskTable
   2083  fcc3		       01 02 04 08*	      .byte.b	$01, $02, $04, $08, $10, $20, $40, $80
   2084  fccb
