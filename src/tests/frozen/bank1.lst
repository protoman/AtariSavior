   1555  f8f7		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1556  f8f9		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1557  f8fb		       a5 8c		      lda	CollisionCellX	; hi
   1558  f8fd		       38		      sec
   1559  f8fe		       e5 88		      sbc	BMWScratch	; hi - pL
   1560  f900		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1561  f902		       a5 8e		      lda	CollisionEndX	; lo
