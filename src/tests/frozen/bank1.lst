     94  f050							; TitleSelect — moved from bank0 (refactor_v4_plan Phase 3.1 canary, 2026-10-16).
     95  f050							; Pure leaf (no calls); returns C=1 edge (caller runs LoadLevel) / C=0 no-edge.
     96  f050							; Entered via CallPad_TitleSelect ($FC4F); tail-exits through ReturnPad
     97  f050							; (sta $1FF4/rts), which returns to the bank0 caller with C intact.
     98  f050		       02 82	   SWCHB      =	$0282
     99  f050		       00 97	   StepsLeft  =	$97	; bank0 per-frame step latch (ZP byte block)
    100  f050		       00 04	   LEVEL_COUNT =	4	; hand copy of kernel LEVEL_COUNT
    101  f050				   TitleSelect
    102  f050		       a5 97		      lda	StepsLeft
    103  f052		       29 02		      and	#%00000010
    104  f054		       f0 17		      beq	.TSnoB1
    105  f056		       ad 82 02 	      lda	SWCHB
    106  f059		       29 02		      and	#%00000010
    107  f05b		       d0 10		      bne	.TSnoB1
    108  f05d		       e6 a3		      inc	Level
    109  f05f		       a5 a3		      lda	Level
    110  f061		       c9 04		      cmp	#LEVEL_COUNT
    111  f063		       d0 04		      bne	.TSokB1
    112  f065		       a9 00		      lda	#0
    113  f067		       85 a3		      sta	Level
    114  f069				   .TSokB1
    115  f069		       38		      sec
    116  f06a		       4c f8 fb 	      jmp	ReturnPad
    117  f06d				   .TSnoB1
    118  f06d		       18		      clc
