   1775  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1776  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1777  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1778  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1779  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1780  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1781  facc							;   double-score guard for that slot only — first blast sees the pair
   1782  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1783  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1784  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1785  facc							;   Same-bank jsr legal (no pad nesting).
   1786  facc				   PairGone
   1787  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1788  face		       aa		      tax
   1789  facf		       bd 68 fa 	      lda	BombClearMask,X
   1790  fad2		       49 ff		      eor	#$FF
   1791  fad4		       a8		      tay		; Y = bit for col x
   1792  fad5		       e8		      inx
   1793  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1794  fad9		       49 ff		      eor	#$FF
   1795  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1796  fadd		       98		      tya
   1797  fade		       05 ad		      ora	Temp
   1798  fae0		       85 ad		      sta	Temp	; both pair bits
   1799  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1800  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1801  fae2		       a4 84		      ldy	LineCount
   1802  fae4		       e0 04		      cpx	#4
   1803  fae6		       90 0a		      bcc	.pg0
