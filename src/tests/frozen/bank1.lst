   2257  fda7		       e8		      inx
   2258  fda8		       d0 f7		      bne	.LVTens
   2259  fdaa				   .LVTensDone
   2260  fdaa		       0a		      asl
   2261  fdab		       0a		      asl
   2262  fdac		       0a		      asl		; ones * 8
   2263  fdad		       85 e8		      sta	scorePtr5
   2264  fdaf		       8a		      txa
   2265  fdb0		       0a		      asl
   2266  fdb1		       0a		      asl
   2267  fdb2		       0a		      asl		; tens * 8
