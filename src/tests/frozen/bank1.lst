    929  f5c0		       85 ee		      sta	DelayCnt
    930  f5c2		       b9 66 f8 	      lda	BarFineTable,Y
    931  f5c5		       85 ef		      sta	FineCnt
    932  f5c7		       a0 44		      ldy	#$44	; red (hue 4, luma 2) for sty COLUPF
    933  f5c9		       a5 ef		      lda	FineCnt
