   2112  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2113  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2114  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2115  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2116  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2117  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2118  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2119  fd68				   SetupScorePointers
   2120  fd68							; --- Initialize score to 0 on first frame ---
   2121  fd68		       a5 ad		      lda	Temp
   2122  fd6a		       d0 0c		      bne	.scoreInitDone
   2123  fd6c		       e6 ad		      inc	Temp
   2124  fd6e		       a9 00		      lda	#0
   2125  fd70		       85 f3		      sta	ScoreTh
   2126  fd72		       85 f4		      sta	ScoreHu
   2127  fd74		       a9 00		      lda	#$00
   2128  fd76		       85 f5		      sta	ScoreTe
   2129  fd78				   .scoreInitDone
   2130  fd78
   2131  fd78							; --- Set up 6 digit pointers ---
   2132  fd78							; High bytes first (all $FD)
   2133  fd78		       a9 fd		      lda	#>DigitGfx
   2134  fd7a		       85 e1		      sta	scorePtr1+1
   2135  fd7c		       85 e3		      sta	scorePtr2+1
   2136  fd7e		       85 e5		      sta	scorePtr3+1
   2137  fd80		       85 e7		      sta	scorePtr4+1
   2138  fd82		       85 e9		      sta	scorePtr5+1
   2139  fd84		       85 eb		      sta	scorePtr6+1
   2140  fd86
   2141  fd86		       a5 f2		      lda	LevelShowTimer
   2142  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2143  fd8a		       f0 2e		      beq	.scoreLows
   2144  fd8c		       c6 f2		      dec	LevelShowTimer
   2145  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2146  fd90		       85 e0		      sta	scorePtr1
   2147  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2148  fd94		       85 e2		      sta	scorePtr2
   2149  fd96		       a9 00		      lda	#0	; hundreds '0'
   2150  fd98		       85 e4		      sta	scorePtr3
   2151  fd9a		       a5 a3		      lda	Level
   2152  fd9c		       18		      clc
   2153  fd9d		       69 01		      adc	#1	; 1-based level number
   2154  fd9f		       a2 00		      ldx	#0
   2155  fda1				   .LVTens
   2156  fda1		       c9 0a		      cmp	#10
   2157  fda3		       90 05		      bcc	.LVTensDone
   2158  fda5		       e9 0a		      sbc	#10
   2159  fda7		       e8		      inx
   2160  fda8		       d0 f7		      bne	.LVTens
   2161  fdaa				   .LVTensDone
   2162  fdaa		       0a		      asl
   2163  fdab		       0a		      asl
   2164  fdac		       0a		      asl		; ones * 8
   2165  fdad		       85 e8		      sta	scorePtr5
   2166  fdaf		       8a		      txa
   2167  fdb0		       0a		      asl
   2168  fdb1		       0a		      asl
   2169  fdb2		       0a		      asl		; tens * 8
   2170  fdb3		       85 e6		      sta	scorePtr4
   2171  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2172  fdb7		       85 ea		      sta	scorePtr6
   2173  fdb9		       60		      rts
   2174  fdba
   2175  fdba							; scorePtr1..2 = leading zeros
   2176  fdba				   .scoreLows
   2177  fdba		       a9 00		      lda	#0
   2178  fdbc		       85 e0		      sta	scorePtr1
   2179  fdbe		       85 e2		      sta	scorePtr2
   2180  fdc0
   2181  fdc0							; scorePtr3 = ScoreTh * 8
   2182  fdc0		       a5 f3		      lda	ScoreTh
   2183  fdc2		       0a		      asl
   2184  fdc3		       0a		      asl
   2185  fdc4		       0a		      asl
   2186  fdc5		       85 e4		      sta	scorePtr3
   2187  fdc7
   2188  fdc7							; scorePtr4 = ScoreHu * 8
   2189  fdc7		       a5 f4		      lda	ScoreHu
   2190  fdc9		       0a		      asl
   2191  fdca		       0a		      asl
   2192  fdcb		       0a		      asl
   2193  fdcc		       85 e6		      sta	scorePtr4
   2194  fdce
   2195  fdce							; scorePtr5 = (ScoreTe >> 4) * 8  (tens digit)
   2196  fdce		       a5 f5		      lda	ScoreTe
   2197  fdd0		       4a		      lsr
   2198  fdd1		       4a		      lsr
   2199  fdd2		       4a		      lsr
   2200  fdd3		       4a		      lsr		; tens digit in low nibble
   2201  fdd4		       0a		      asl
   2202  fdd5		       0a		      asl
   2203  fdd6		       0a		      asl
   2204  fdd7		       85 e8		      sta	scorePtr5
   2205  fdd9
   2206  fdd9							; scorePtr6 = (ScoreTe & $0F) * 8  (ones digit)
   2207  fdd9		       a5 f5		      lda	ScoreTe
   2208  fddb		       29 0f		      and	#$0F
   2209  fddd		       0a		      asl
   2210  fdde		       0a		      asl
   2211  fddf		       0a		      asl
   2212  fde0		       85 ea		      sta	scorePtr6
   2213  fde2		       60		      rts
