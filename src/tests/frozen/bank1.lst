   2179  fd84		       85 eb		      sta	scorePtr6+1
   2180  fd86
   2181  fd86		       a5 f2		      lda	LevelShowTimer
   2182  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2183  fd8a		       f0 2e		      beq	.scoreLows
   2184  fd8c		       c6 f2		      dec	LevelShowTimer
   2185  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2186  fd90		       85 e0		      sta	scorePtr1
   2187  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2188  fd94		       85 e2		      sta	scorePtr2
   2189  fd96		       a9 00		      lda	#0	; hundreds '0'
   2190  fd98		       85 e4		      sta	scorePtr3
