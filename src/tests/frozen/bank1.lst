   2249  fda1		       c9 0a		      cmp	#10
   2250  fda3		       90 05		      bcc	.LVTensDone
   2251  fda5		       e9 0a		      sbc	#10
   2252  fda7		       e8		      inx
   2253  fda8		       d0 f7		      bne	.LVTens
   2254  fdaa				   .LVTensDone
   2255  fdaa		       0a		      asl
   2256  fdab		       0a		      asl
   2257  fdac		       0a		      asl		; ones * 8
   2258  fdad		       85 e8		      sta	scorePtr5
   2259  fdaf		       8a		      txa
   2260  fdb0		       0a		      asl
   2261  fdb1		       0a		      asl
   2262  fdb2		       0a		      asl		; tens * 8
