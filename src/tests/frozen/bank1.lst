   1047  f769							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1048  f769							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1049  f769							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1050  f769							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1051  f769							; ====================================================================
   1052  f769
   1053  f769							; --- Setup sprites ---
   1054  f769		       a9 0e		      lda	#$0E	; white
   1055  f76b		       85 06		      sta	COLUP0
   1056  f76d		       85 07		      sta	COLUP1
   1057  f76f		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1058  f771		       85 04		      sta	NUSIZ0
   1059  f773		       85 05		      sta	NUSIZ1
   1060  f775		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1061  f777		       85 25		      sta	VDELP0
   1062  f779		       85 26		      sta	VDELP1
   1063  f77b							; Flush both VDELP buffers + live registers to 0.
   1064  f77b							; Without this, stale buffer data from previous frame shows as
   1065  f77b							; white ghost copies during the positioning scanlines.
   1066  f77b		       a9 00		      lda	#0
   1067  f77d		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1068  f77f		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1069  f781		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1070  f783		       85 0b		      sta	REFP0
   1071  f785		       85 0c		      sta	REFP1
   1072  f787
   1073  f787							; --- Position P0 and P1 for interleaved 6-digit layout ---
   1074  f787							; P0 at pixel 60, P1 at pixel 68 (shifted 4px right to fix pipeline timing)
   1075  f787		       a9 3c		      lda	#60
   1076  f789		       a2 00		      ldx	#0
   1077  f78b		       20 f8 f7 	      jsr	SetObjectXPos_b1
   1078  f78e		       a9 44		      lda	#68
   1079  f790		       a2 01		      ldx	#1
   1080  f792		       20 f8 f7 	      jsr	SetObjectXPos_b1
   1081  f795		       85 02		      sta	WSYNC
   1082  f797		       85 2a		      sta	HMOVE
   1083  f799
   1084  f799							; --- Score digits + #18 LV001 banner pointers (sub with the glyphs
   1085  f799							; at $FD.. — bank1 pre-pad $F937 pin has ~1B slack, nothing fits).
   1086  f799		       20 68 fd 	      jsr	SetupScorePointers
   1087  f79c
   1088  f79c							; --- Clear sprites before loop (3-write pattern for VDELP) ---
   1089  f79c		       a9 00		      lda	#0
   1090  f79e		       85 1b		      sta	GRP0
   1091  f7a0		       85 1c		      sta	GRP1
   1092  f7a2		       85 1b		      sta	GRP0
   1093  f7a4
   1094  f7a4							; ====================================================================
   1095  f7a4							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1096  f7a4							; Proven kernel from score48pix.asm
   1097  f7a4							; ====================================================================
   1098  f7a4		       a0 07		      ldy	#7
   1099  f7a6		       84 ec		      sty	scbrdCnt
   1100  f7a8				   .ScoreLoop
   1101  f7a8		       a4 ec		      ldy	<scbrdCnt	; 3c
   1102  f7aa		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1103  f7ac		       aa		      tax		; 2c — cache in X
   1104  f7ad		       85 02		      sta	WSYNC	; 3c
   1105  f7af		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1106  f7b1		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1107  f7b4		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1108  f7b6		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1109  f7b8		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1110  f7ba		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1111  f7bc		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1112  f7be		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1113  f7c0		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1114  f7c2		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1115  f7c4		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1116  f7c6		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1117  f7c8		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1118  f7ca		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1119  f7cc		       c6 ec		      dec	<scbrdCnt	; 5c
   1120  f7ce		       d0 d8		      bne	.ScoreLoop	; 3c
   1121  f7d0
   1122  f7d0							; --- Cleanup ---
   1123  f7d0		       a9 00		      lda	#0
   1124  f7d2		       85 1b		      sta	GRP0
   1125  f7d4		       85 1c		      sta	GRP1
   1126  f7d6		       85 04		      sta	NUSIZ0
   1127  f7d8		       85 05		      sta	NUSIZ1
   1128  f7da		       85 25		      sta	VDELP0
   1129  f7dc		       85 26		      sta	VDELP1
   1130  f7de
   1131  f7de							; --- Restore cave kernel settings ---
   1132  f7de		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + 8-clk ball (cave mode
   1133  f7e0							; since D6 — bank1 bar overwrote $05 during its band)
   1134  f7e0		       85 0a		      sta	CTRLPF
   1135  f7e2		       a9 00		      lda	#0
   1136  f7e4		       85 04		      sta	NUSIZ0
   1137  f7e6		       a9 00		      lda	#0
   1138  f7e8		       85 05		      sta	NUSIZ1
   1139  f7ea		       85 25		      sta	VDELP0
   1140  f7ec		       85 26		      sta	VDELP1
   1141  f7ee
   1142  f7ee							; ====================================================================
   1143  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1144  f7ee							; Path A (PlayerLives > 0) — execution count:
   1145  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1146  f7ee							;   Timer:    3 loop + 1 gap = 4
   1147  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1148  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1149  f7ee							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1150  f7ee							;   Subtotal: 6+4+8+11+10 = 39
   1151  f7ee							;   Pad:      48 - 39 = 9
   1152  f7ee							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1153  f7ee							; ====================================================================
   1154  f7ee		       a2 09		      ldx	#9
   1155  f7f0				   .HudPad
   1156  f7f0		       85 02		      sta	WSYNC
   1157  f7f2		       ca		      dex
   1158  f7f3		       d0 fb		      bne	.HudPad
   1159  f7f5
   1160  f7f5							; --- Return to bank0 via fold-pad ---
   1161  f7f5		       4c 70 fc 	      jmp	$FC70
   1162  f7f8
   1163  f7f8							; ========================================================================
   1164  f7f8							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1165  f7f8							; X=0 positions P0, X=1 positions P1
   1166  f7f8							; A = pixel position (0-159)
   1167  f7f8							; ========================================================================
   1168  f7f8				   SetObjectXPos_b1
   1169  f7f8		       85 02		      sta	WSYNC
   1170  f7fa		       38		      sec
   1171  f7fb				   .Div15Loop
   1172  f7fb		       e9 0f		      sbc	#15
   1173  f7fd		       b0 fc		      bcs	.Div15Loop
   1174  f7ff		       a8		      tay
   1175  f800		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1176  f803		       95 20		      sta	HMP0,X
   1177  f805		       95 10		      sta	RESP0,X
   1178  f807		       60		      rts
   1179  f808
   1180  f808							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1181  f808							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1182  f808							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1183  f808							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1184  f808							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1185  f808							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1186  f808				   BarDelayTable		; (B+7)>>3, 15 entries
   1187  f808		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1188  f817				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1189  f817		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
   1190  f826
   1191  f826							; ------------------------------------------------------------------------------
   1192  f826
   1193  f826							; ==============================================================================
   1194  f826							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1195  f826							; ==============================================================================
   1196  f826							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1197  f826							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1198  f826							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1199  f826							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1200  f826							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1201  f826							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1202  f826							; TickCounter — writing that would stall the game timer).
   1203  f826							;
   1204  f826							; User spec 2026-10-18: floats only on water; carries the player across and
   1205  f826							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1206  f826							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1207  f826							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1208  f826							;	       into CollisionX, kernel draws the strip as the band's last
   1209  f826							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1210  f826							;	       row sits exactly on the moving surface — it rides the wave the
   1211  f826							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1212  f826							;	       stays clear of the 125 water-kill line at every tide phase.
   1213  f826							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1214  f826							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1215  f826							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1216  f826							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1217  f826							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1218  f826							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1219  f826							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1220  f826							;	       flag+level, so the empty raft runs at full speed and the next
   1221  f826							;	       take-off ramps again. It also holds the frame it turns around on.
   1222  f826							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1223  f826							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1224  f826							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1225  f826							;	       exactly the open water span of the room.
   1226  f826							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1227  f826							;	       its upper rows; step off and it parks immediately (the ramp state
   1228  f826							;	       is cleared too, so the next take-off ramps again). While over it a
   1229  f826							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1230  f826							;	       zeroed (gravity must never accumulate into the water) and carried
   1231  f826							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1232  f826							;	       flying off is always possible. Leaving and re-entering the ROOM
   1233  f826							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1234  f826							;	       it), which is the "reset" the user asked for.
   1235  f826							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1236  f826							; ==============================================================================
   1237  f826							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1238  f826							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1239  f826							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1240  f826							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1241  f826							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1242  f826							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1243  f826							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1244  f826							;   cols 20-39 -> the mirrored half: source = 39-col
   1245  f826				   RaftCellSolid
   1246  f826		       c9 14		      cmp	#20
   1247  f828		       90 05		      bcc	.RCSrc
   1248  f82a		       49 ff		      eor	#$ff
   1249  f82c		       18		      clc
   1250  f82d		       69 28		      adc	#40
   1251  f82f				   .RCSrc
   1252  f82f		       a8		      tay
   1253  f830		       b9 48 f8 	      lda	RaftCellMasks,Y
   1254  f833		       c0 04		      cpy	#4
   1255  f835		       b0 03		      bcs	.RCPF1
   1256  f837		       25 c5		      and	$C5
   1257  f839		       60		      rts
   1258  f83a				   .RCPF1
   1259  f83a		       c0 0c		      cpy	#12
   1260  f83c		       b0 03		      bcs	.RCPF2
   1261  f83e		       25 c8		      and	$C8
   1262  f840		       60		      rts
   1263  f841				   .RCPF2
   1264  f841		       25 cb		      and	$CB
   1265  f843		       60		      rts
   1266  f844
   1267  f844				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1268  f844		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1269  f848
   1270  f848				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1271  f848		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1272  f84c		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1273  f850		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1274  f854		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1275  f858		       10 20 40 80	      .byte.b	$10, $20, $40, $80
   1276  f85c							; ------------------------------------------------------------------------------
   1277  f85c							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1278  f85c							; verify_build.check_raft_tramp). bank0 executes `sta $1FF7` at $F8C0-$F8C2 and
   1279  f85c							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1280  f85c							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1281  f85c							; `sta $1FF7` is never executed (it is only the swapped-out image's prefix).
   1282  f85c							; In bank1's $F822-$F936 fill, so the $F937 pin does not move.
   1283  f85c							; ------------------------------------------------------------------------------
   1284  f85c		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1285  f8c0		       8d f7 1f 	      .byte.b	$8D, $F7, $1F	; sta $1FF7 (twin)
   1286  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1287  f8c6
   1288  f8c6		       00 00 00 00*	      .ds	$F937 - *, 0	; pinned: bank2 M1StripBlast back-jmp operand
   1289  f937							; ($F937) — test_bomb_strip asserts both literals
   1290  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1291  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1292  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1293  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1294  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1295  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1296  f937							; Every exit ends in ReturnPad with A = count.
   1297  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1298  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1299  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1300  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1301  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1302  f937							; inc the count (caller's +75 loop scores it). The
   1303  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1304  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1305  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1306  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1307  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1308  f937							; ------------------------------------------------------------------------------
   1309  f937				   StripBlastCheck
   1310  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1311  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1312  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1313  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1314  f937							; sets b3/b4 instead.
   1315  f937		       a5 92		      lda	RectCount
   1316  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1317  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1318  f93d		       c5 92		      cmp	RectCount
   1319  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1320  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1321  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1322  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1323  f947		       c9 02		      cmp	#2
   1324  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1325  f94b							;   (A=0/1 falls into take = overlap)
   1326  f94b				   .SBleftTake
   1327  f94b		       a5 ba		      lda	EnemyDeadMask
   1328  f94d		       29 10		      and	#$10
   1329  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1330  f951		       a9 10		      lda	#$10
   1331  f953		       05 ba		      ora	EnemyDeadMask
   1332  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1333  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1334  f959				   .SBright
   1335  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1336  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1337  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1338  f959		       18		      clc
   1339  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1340  f95c		       49 ff		      eor	#$FF
   1341  f95e		       69 28		      adc	#40	; hi_r = 39-lo_l
   1342  f960		       a8		      tay
   1343  f961		       18		      clc
   1344  f962		       a5 8c		      lda	CollisionCellX	; hi_l
   1345  f964		       49 ff		      eor	#$FF
   1346  f966		       69 28		      adc	#40	; lo_r = 39-hi_l
   1347  f968		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1348  f96a		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1349  f96c		       a5 8c		      lda	CollisionCellX	; hi
