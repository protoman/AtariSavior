   2300  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2301  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2302  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2303  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2304  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2305  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2306  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2307  fd68				   SetupScorePointers
   2308  fd68							; --- Initialize score to 0 on first frame ---
   2309  fd68		       a5 ad		      lda	Temp
   2310  fd6a		       d0 0c		      bne	.scoreInitDone
   2311  fd6c		       e6 ad		      inc	Temp
   2312  fd6e		       a9 00		      lda	#0
   2313  fd70		       85 f3		      sta	ScoreTh
   2314  fd72		       85 f4		      sta	ScoreHu
   2315  fd74		       a9 00		      lda	#$00
   2316  fd76		       85 f5		      sta	ScoreTe
   2317  fd78				   .scoreInitDone
   2318  fd78
   2319  fd78							; --- Set up 6 digit pointers ---
   2320  fd78							; High bytes first (all $FD)
   2321  fd78		       a9 fd		      lda	#>DigitGfx
   2322  fd7a		       85 e1		      sta	scorePtr1+1
   2323  fd7c		       85 e3		      sta	scorePtr2+1
   2324  fd7e		       85 e5		      sta	scorePtr3+1
   2325  fd80		       85 e7		      sta	scorePtr4+1
   2326  fd82		       85 e9		      sta	scorePtr5+1
   2327  fd84		       85 eb		      sta	scorePtr6+1
   2328  fd86
   2329  fd86		       a5 f2		      lda	LevelShowTimer
   2330  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2331  fd8a		       f0 2e		      beq	.scoreLows
   2332  fd8c		       c6 f2		      dec	LevelShowTimer
   2333  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2334  fd90		       85 e0		      sta	scorePtr1
   2335  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2336  fd94		       85 e2		      sta	scorePtr2
   2337  fd96		       a9 00		      lda	#0	; hundreds '0'
   2338  fd98		       85 e4		      sta	scorePtr3
   2339  fd9a		       a5 a3		      lda	Level
   2340  fd9c		       18		      clc
   2341  fd9d		       69 01		      adc	#1	; 1-based level number
   2342  fd9f		       a2 00		      ldx	#0
   2343  fda1				   .LVTens
   2344  fda1		       c9 0a		      cmp	#10
   2345  fda3		       90 05		      bcc	.LVTensDone
   2346  fda5		       e9 0a		      sbc	#10
   2347  fda7		       e8		      inx
   2348  fda8		       d0 f7		      bne	.LVTens
   2349  fdaa				   .LVTensDone
   2350  fdaa		       0a		      asl
   2351  fdab		       0a		      asl
   2352  fdac		       0a		      asl		; ones * 8
   2353  fdad		       85 e8		      sta	scorePtr5
   2354  fdaf		       8a		      txa
   2355  fdb0		       0a		      asl
   2356  fdb1		       0a		      asl
   2357  fdb2		       0a		      asl		; tens * 8
   2358  fdb3		       85 e6		      sta	scorePtr4
   2359  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2360  fdb7		       85 ea		      sta	scorePtr6
   2361  fdb9		       60		      rts
   2362  fdba
   2363  fdba							; scorePtr1..2 = leading zeros
   2364  fdba				   .scoreLows
   2365  fdba		       a9 00		      lda	#0
   2366  fdbc		       85 e0		      sta	scorePtr1
   2367  fdbe		       85 e2		      sta	scorePtr2
   2368  fdc0
   2369  fdc0							; scorePtr3 = ScoreTh * 8
   2370  fdc0		       a5 f3		      lda	ScoreTh
   2371  fdc2		       0a		      asl
   2372  fdc3		       0a		      asl
   2373  fdc4		       0a		      asl
