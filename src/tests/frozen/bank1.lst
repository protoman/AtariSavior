   1143  f76d		       85 04		      sta	NUSIZ0
   1144  f76f		       85 05		      sta	NUSIZ1
   1145  f771		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1146  f773		       85 25		      sta	VDELP0
   1147  f775		       85 26		      sta	VDELP1
   1148  f777							; Flush both VDELP buffers + live registers to 0.
   1149  f777							; Without this, stale buffer data from previous frame shows as
   1150  f777							; white ghost copies during the positioning scanlines.
   1151  f777		       a9 00		      lda	#0
   1152  f779		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1153  f77b		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1154  f77d		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1155  f77f		       85 0b		      sta	REFP0
   1156  f781		       85 0c		      sta	REFP1
