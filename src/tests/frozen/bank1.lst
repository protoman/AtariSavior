   1529  fa7c							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1530  fa7c							; ScoreTh/ScoreHu = binary 0-9; ScoreTe = packed BCD. Clobbers A.
   1531  fa7c							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1532  fa7c							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1533  fa7c							; (the 2026-09-23 decimal-mode rule). The old BINARY `cmp #$A0 / sbc #$A0`
   1534  fa7c							; fix-up missed nibble-level overflow: $25+$75 = $9A stored raw -> ones
   1535  fa7c							; digit A -> glyph index 10 -> DigitGfx+80 (past the 10-glyph font) =
   1536  fa7c							; the solid-block score digit (screenshots/score_issue_002.png).
   1537  fa7c							; C=1 = BCD carry (sum >= 100) -> ScoreHu path.
   1538  fa7c							; SIZE PIN: routine runs $FA7D..$FAA4 exactly (UpdateLaserSound's pad
   1539  fa7c							; target is $FAA5). Old head = clc/adc/cmp/bcc/sbc = 9 bytes, new head =
   1540  fa7c							; sed/clc/adc/cld/bcc = 7, so the two nops restore the exact length —
   1541  fa7c							; without them every pad below shifts silently.
   1542  fa7c				   AddScore
   1543  fa7c		       f8		      sed
   1544  fa7d		       18		      clc
   1545  fa7e		       65 f5		      adc	ScoreTe
   1546  fa80		       d8		      cld
   1547  fa81		       90 1c		      bcc	.ASstoreTe
   1548  fa83		       ea		      nop		; byte-pin (see SIZE PIN above)
   1549  fa84		       ea		      nop		; byte-pin
   1550  fa85		       48		      pha		; save wrapped ScoreTe
   1551  fa86		       e6 f4		      inc	ScoreHu
   1552  fa88		       a5 f4		      lda	ScoreHu
   1553  fa8a		       c9 0a		      cmp	#10
   1554  fa8c		       90 10		      bcc	.AShuOk
   1555  fa8e		       a9 00		      lda	#0
   1556  fa90		       85 f4		      sta	ScoreHu
   1557  fa92		       e6 f3		      inc	ScoreTh
   1558  fa94		       a5 f3		      lda	ScoreTh
   1559  fa96		       c9 0a		      cmp	#10
   1560  fa98		       90 04		      bcc	.ASthOk
   1561  fa9a		       a9 09		      lda	#9
   1562  fa9c		       85 f3		      sta	ScoreTh
   1563  fa9e				   .ASthOk
   1564  fa9e				   .AShuOk
   1565  fa9e		       68		      pla
