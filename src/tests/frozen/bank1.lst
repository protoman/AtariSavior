   2434  fe69		       45 c1		      eor	EnemyRamD
   2435  fe6b		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2436  fe6d							; bank1's RoomDarkMask — must be preserved)
   2437  fe6d		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2438  fe70							; ---- leading edge left --------------------------------------------------
