   1154  f769							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1155  f769							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1156  f769							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1157  f769							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1158  f769							; ====================================================================
   1159  f769
   1160  f769							; --- Setup sprites ---
