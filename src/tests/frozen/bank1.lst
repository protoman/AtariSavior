   2285  fde2		       60		      rts
   2286  fde3
   2287  fde3							; ========================================================================
   2288  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2289  fde3							; ========================================================================
   2290  fde3					      .ds	$FDE3 - *, 0
   2291  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2292  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2293  fde3							; rails keep it inside the room
   2294  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2295  fde3							; surface (line 132) - 7, so its BOTTOM row
   2296  fde3							; sits exactly ON the surface. The live value is
   2297  fde3							; RAFTER_BASE + off (see the tide block below) —
   2298  fde3							; never hard-code the Y: the surface MOVES.
   2299  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2300  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2301  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2302  fde3							; from 12 px above the raft's top to 5 px into it
   2303  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2304  fde3
   2305  fde3				   RaftBody
   2306  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2307  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2308  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2309  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2310  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2311  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2312  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2313  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2314  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2315  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2316  fde3		       a5 c2		      lda	EnemyRamP
   2317  fde5		       29 f0		      and	#$F0
   2318  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2319  fde9		       4a		      lsr
   2320  fdea		       4a		      lsr
   2321  fdeb		       4a		      lsr
   2322  fdec		       4a		      lsr		; A = p (1..15)
   2323  fded		       c9 08		      cmp	#8
   2324  fdef		       90 04		      bcc	.RaftTideTri
   2325  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2326  fdf3		       f0 09		      beq	.RaftTide	; always
   2327  fdf5				   .RaftTideTri
   2328  fdf5		       c9 04		      cmp	#4
   2329  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2330  fdf9		       49 ff		      eor	#$FF
   2331  fdfb		       38		      sec
   2332  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2333  fdfe				   .RaftTide
   2334  fdfe		       18		      clc
   2335  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2336  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2337  fe03							; water line is what the raft floats on
   2338  fe03
   2339  fe03							; --- does the player count as "over the raft"? --------------------------
   2340  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2341  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2342  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2343  fe03							; block here is what makes it park; the pin/carry later still applies while
   2344  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2345  fe03							; raft he is actually standing on.
   2346  fe03		       a5 80		      lda	RoomX
   2347  fe05		       38		      sec
   2348  fe06		       f5 bd		      sbc	EnemyRamX,X
   2349  fe08		       18		      clc
   2350  fe09		       69 06		      adc	#RAFTER_XOFF
   2351  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2352  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2353  fe0f		       a5 81		      lda	RoomY
   2354  fe11		       38		      sec
   2355  fe12		       f5 e2		      sbc	EnemyRamY,X
   2356  fe14		       18		      clc
   2357  fe15		       69 0c		      adc	#RAFTER_PINFIT
   2358  fe17		       c9 12		      cmp	#RAFTER_YSPAN
   2359  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2360  fe1b		       a5 94		      lda	vyHi
   2361  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2362  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2363  fe22				   .RaftNoRide
   2364  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2365  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2366  fe22		       a5 f0		      lda	$F0
   2367  fe24		       29 07		      and	#%00000111
   2368  fe26		       85 f0		      sta	$F0
   2369  fe28		       4c f8 fb 	      jmp	ReturnPad
   2370  fe2b				   .RaftGo
   2371  fe2b							; --- pin FIRST: the rider stays on the raft even on a TURN frame --------
   2372  fe2b							; A raft boxed in by solid row-2 cells (or parked against a rail) turns
   2373  fe2b							; every frame and never moves; the turn path returns before the carry, so
   2374  fe2b							; pinning here is what keeps a rider standing on it. Without it he fell
   2375  fe2b							; through a stuck raft into the water kill line and respawned forever
   2376  fe2b							; (user report 2026-10-22: "player position keeps changing, zig-zags").
   2377  fe2b							; The vyHi < 0 escape is the gate's `.RaftNoRide` (rising is not a ride).
   2378  fe2b		       b5 e2		      lda	EnemyRamY,X
   2379  fe2d		       38		      sec
   2380  fe2e		       e9 0c		      sbc	#RAFTER_PINFIT
   2381  fe30		       85 81		      sta	RoomY	; feet on the raft's top
   2382  fe32		       a9 00		      lda	#0
   2383  fe34		       85 93		      sta	vyLo
   2384  fe36		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2385  fe38							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2386  fe38							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2387  fe38							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2388  fe38							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2389  fe38							; it cannot borrow upward either (see the kernel EQU for the contract).
   2390  fe38							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2391  fe38							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2392  fe38							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2393  fe38		       a5 f0		      lda	$F0
   2394  fe3a		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2395  fe3c		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2396  fe3e		       f0 04		      beq	.RaftAtSpeed
   2397  fe40		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2398  fe42		       d0 07		      bne	.RaftHaveStep	; always
   2399  fe44				   .RaftAtSpeed
   2400  fe44		       a5 c2		      lda	EnemyRamP
   2401  fe46		       29 01		      and	#1
   2402  fe48		       18		      clc
   2403  fe49		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2404  fe4b				   .RaftHaveStep
   2405  fe4b		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2406  fe4d		       bd 68 f8 	      lda	RaftBitTab,X
   2407  fe50		       25 c1		      and	EnemyRamD
   2408  fe52		       f0 29		      beq	.RaftLeft
   2409  fe54							; ---- leading edge right: candidate = x + step ---------------------------
   2410  fe54		       b5 bd		      lda	EnemyRamX,X
   2411  fe56		       18		      clc
   2412  fe57		       65 88		      adc	$88
   2413  fe59		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2414  fe5b		       c9 94		      cmp	#RAFT_MAX_X
   2415  fe5d		       b0 14		      bcs	.RaftTurn	; right rail
   2416  fe5f		       18		      clc
   2417  fe60		       69 01		      adc	#1	; the cell just beyond the right edge
   2418  fe62		       4a		      lsr
   2419  fe63		       4a		      lsr
   2420  fe64		       20 4a f8 	      jsr	RaftCellSolid
   2421  fe67		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2422  fe69		       b5 bd		      lda	EnemyRamX,X
   2423  fe6b		       18		      clc
   2424  fe6c		       65 88		      adc	$88
   2425  fe6e		       95 bd		      sta	EnemyRamX,X
   2426  fe70		       4c 9d fe 	      jmp	.RaftRide
   2427  fe73							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
   2428  fe73							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2429  fe73				   .RaftTurn
   2430  fe73		       bd 68 f8 	      lda	RaftBitTab,X
   2431  fe76		       45 c1		      eor	EnemyRamD
   2432  fe78		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2433  fe7a							; bank1's RoomDarkMask — must be preserved)
   2434  fe7a		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2435  fe7d							; ---- leading edge left --------------------------------------------------
   2436  fe7d				   .RaftLeft
   2437  fe7d		       b5 bd		      lda	EnemyRamX,X
   2438  fe7f		       38		      sec
   2439  fe80		       e5 88		      sbc	$88
   2440  fe82		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2441  fe84		       c9 08		      cmp	#RAFT_MIN_X
   2442  fe86		       90 eb		      bcc	.RaftTurn	; left rail
   2443  fe88		       38		      sec
   2444  fe89		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2445  fe8b		       b0 02		      bcs	.RaftLeftCol
   2446  fe8d		       a9 00		      lda	#0
   2447  fe8f				   .RaftLeftCol
   2448  fe8f		       4a		      lsr
   2449  fe90		       4a		      lsr
   2450  fe91		       20 4a f8 	      jsr	RaftCellSolid
   2451  fe94		       d0 dd		      bne	.RaftTurn
   2452  fe96		       b5 bd		      lda	EnemyRamX,X
   2453  fe98		       38		      sec
   2454  fe99		       e5 88		      sbc	$88
   2455  fe9b		       95 bd		      sta	EnemyRamX,X
   2456  fe9d							; ---- carry + pin while the player is aboard -----------------------------
   2457  fe9d				   .RaftRide
   2458  fe9d							; (the Y pin ran at .RaftGo — it must not depend on the raft moving)
   2459  fe9d							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2460  fe9d		       a5 f0		      lda	$F0
   2461  fe9f		       09 80		      ora	#%10000000
   2462  fea1		       85 f0		      sta	$F0
   2463  fea3		       a5 c2		      lda	EnemyRamP
   2464  fea5		       4a		      lsr		; C = the frame-parity bit
   2465  fea6		       b0 0f		      bcs	.RaftCarry	; odd frame: flag only this time
   2466  fea8		       a5 f0		      lda	$F0
   2467  feaa		       29 78		      and	#%01111000
   2468  feac		       c9 78		      cmp	#%01111000
   2469  feae		       f0 07		      beq	.RaftCarry	; already spun up
   2470  feb0		       a5 f0		      lda	$F0
   2471  feb2		       18		      clc
   2472  feb3		       69 10		      adc	#%00010000
   2473  feb5		       85 f0		      sta	$F0
   2474  feb7				   .RaftCarry
   2475  feb7		       bd 68 f8 	      lda	RaftBitTab,X
   2476  feba		       25 c1		      and	EnemyRamD
   2477  febc		       f0 0a		      beq	.RaftCarryL
   2478  febe		       a5 80		      lda	RoomX
   2479  fec0		       18		      clc
   2480  fec1		       65 88		      adc	$88
   2481  fec3		       85 80		      sta	RoomX
   2482  fec5		       4c d2 fe 	      jmp	.RaftDone
   2483  fec8				   .RaftCarryL
   2484  fec8		       a5 80		      lda	RoomX
   2485  feca		       38		      sec
   2486  fecb		       e5 88		      sbc	$88
   2487  fecd		       85 80		      sta	RoomX
   2488  fecf		       4c d2 fe 	      jmp	.RaftDone
   2489  fed2				   .RaftDone
   2490  fed2		       4c f8 fb 	      jmp	ReturnPad
