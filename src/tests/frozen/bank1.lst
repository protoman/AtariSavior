   2236  fda1		       c9 0a		      cmp	#10
   2237  fda3		       90 05		      bcc	.LVTensDone
   2238  fda5		       e9 0a		      sbc	#10
   2239  fda7		       e8		      inx
   2240  fda8		       d0 f7		      bne	.LVTens
   2241  fdaa				   .LVTensDone
   2242  fdaa		       0a		      asl
   2243  fdab		       0a		      asl
   2244  fdac		       0a		      asl		; ones * 8
   2245  fdad		       85 e8		      sta	scorePtr5
   2246  fdaf		       8a		      txa
   2247  fdb0		       0a		      asl
   2248  fdb1		       0a		      asl
   2249  fdb2		       0a		      asl		; tens * 8
