   1899  fc92		       4a		      lsr
   1900  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   1901  fc94		       25 c0		      and	LaserState
   1902  fc96		       4c f8 fb 	      jmp	ReturnPad
   1903  fc99				   .IRDlit
