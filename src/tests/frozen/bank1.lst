   2044  fc78							; ========================================================================
   2045  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   2046  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2047  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2048  fc78							; check_callpads asserts they equal these labels.
   2049  fc78							; ------------------------------------------------------------------------
   2050  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2051  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2052  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2053  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2054  fc78							; survives the cross-bank return.
   2055  fc78				   IsRoomDark
   2056  fc78		       a5 98		      lda	RoomNo
   2057  fc7a		       c9 04		      cmp	#4
   2058  fc7c		       b0 0c		      bcs	.IRDhi
   2059  fc7e		       18		      clc
   2060  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2061  fc81		       aa		      tax
   2062  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2063  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2064  fc87		       4c f8 fb 	      jmp	ReturnPad
   2065  fc8a				   .IRDhi
   2066  fc8a		       c9 08		      cmp	#8
   2067  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2068  fc8e		       aa		      tax
   2069  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2070  fc92		       4a		      lsr
   2071  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2072  fc94		       25 c0		      and	LaserState
   2073  fc96		       4c f8 fb 	      jmp	ReturnPad
   2074  fc99				   .IRDlit
   2075  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2076  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2077  fc9e
   2078  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2079  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2080  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2081  fc9e				   SetRoomDark
   2082  fc9e		       a5 98		      lda	RoomNo
   2083  fca0		       c9 04		      cmp	#4
   2084  fca2		       b0 0e		      bcs	.SRDhi
   2085  fca4		       18		      clc
   2086  fca5		       69 04		      adc	#4
   2087  fca7		       aa		      tax
   2088  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2089  fcab		       05 c1		      ora	EnemyRamD
   2090  fcad		       85 c1		      sta	EnemyRamD
   2091  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2092  fcb2				   .SRDhi
   2093  fcb2		       c9 08		      cmp	#8
   2094  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2095  fcb6		       aa		      tax
   2096  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2097  fcba		       4a		      lsr
   2098  fcbb		       4a		      lsr
   2099  fcbc		       05 c0		      ora	LaserState
   2100  fcbe		       85 c0		      sta	LaserState
   2101  fcc0				   .SRDdone
   2102  fcc0		       4c f8 fb 	      jmp	ReturnPad
