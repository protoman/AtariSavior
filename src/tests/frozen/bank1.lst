   1669  fb3d		       a5 88		      lda	BMWScratch
   1670  fb3f		       c9 12		      cmp	#18
   1671  fb41		       b0 05		      bcs	.BMWHi19
   1672  fb43		       18		      clc
   1673  fb44		       69 02		      adc	#2
   1674  fb46		       90 02		      bcc	.BMWStoreHi
   1675  fb48				   .BMWHi19
   1676  fb48		       a9 13		      lda	#19
   1677  fb4a				   .BMWStoreHi
   1678  fb4a		       85 8c		      sta	CollisionCellX	; blast_hi (loop compares rect.x against it)
   1679  fb4c							; --- Phase 4: capture the strip's left col BEFORE the punch loop
   1680  fb4c							; (ClearPFColumn overwrites LineCount with rect rows). pL = 18+2n,
   1681  fb4c							; n = packed nibble (right_col+1); $FF = symmetric/none. BMWScratch is
   1682  fb4c							; free here (bomb col already folded into blast lo/hi).
   1683  fb4c		       a5 84		      lda	LineCount
   1684  fb4e		       f0 0b		      beq	.SBnocap
   1685  fb50		       4a		      lsr
   1686  fb51		       4a		      lsr
   1687  fb52		       4a		      lsr
   1688  fb53		       4a		      lsr		; n = right_col+1
