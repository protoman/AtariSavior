   1116  f7f8							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1117  f7f8							; X=0 positions P0, X=1 positions P1
   1118  f7f8							; A = pixel position (0-159)
   1119  f7f8							; ========================================================================
   1120  f7f8				   SetObjectXPos_b1
   1121  f7f8		       85 02		      sta	WSYNC
   1122  f7fa		       38		      sec
