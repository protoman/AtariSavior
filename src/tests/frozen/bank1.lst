   2255  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2256  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2257  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2258  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2259  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2260  fd68							; once per banner frame. Lives with the glyphs (bank1's pre-pad region is
   2261  fd68							; tight; the score section is a jsr here from MenuMain).
   2262  fd68				   SetupScorePointers
   2263  fd68							; --- Initialize score to 0 on first frame ---
   2264  fd68		       a5 ad		      lda	Temp
   2265  fd6a		       d0 0c		      bne	.scoreInitDone
   2266  fd6c		       e6 ad		      inc	Temp
   2267  fd6e		       a9 00		      lda	#0
   2268  fd70		       85 f3		      sta	ScoreTh
   2269  fd72		       85 f4		      sta	ScoreHu
   2270  fd74		       a9 00		      lda	#$00
   2271  fd76		       85 f5		      sta	ScoreTe
   2272  fd78				   .scoreInitDone
   2273  fd78
   2274  fd78							; --- Set up 6 digit pointers ---
   2275  fd78							; High bytes first (all $FD)
   2276  fd78		       a9 fd		      lda	#>DigitGfx
   2277  fd7a		       85 e1		      sta	scorePtr1+1
   2278  fd7c		       85 e3		      sta	scorePtr2+1
   2279  fd7e		       85 e5		      sta	scorePtr3+1
   2280  fd80		       85 e7		      sta	scorePtr4+1
   2281  fd82		       85 e9		      sta	scorePtr5+1
   2282  fd84		       85 eb		      sta	scorePtr6+1
   2283  fd86
   2284  fd86		       a5 f2		      lda	LevelShowTimer
   2285  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2286  fd8a		       f0 2e		      beq	.scoreLows
   2287  fd8c		       c6 f2		      dec	LevelShowTimer
   2288  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2289  fd90		       85 e0		      sta	scorePtr1
   2290  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2291  fd94		       85 e2		      sta	scorePtr2
   2292  fd96		       a9 00		      lda	#0	; hundreds '0'
   2293  fd98		       85 e4		      sta	scorePtr3
   2294  fd9a		       a5 a3		      lda	Level
   2295  fd9c		       18		      clc
   2296  fd9d		       69 01		      adc	#1	; 1-based level number
   2297  fd9f		       a2 00		      ldx	#0
   2298  fda1				   .LVTens
   2299  fda1		       c9 0a		      cmp	#10
   2300  fda3		       90 05		      bcc	.LVTensDone
   2301  fda5		       e9 0a		      sbc	#10
   2302  fda7		       e8		      inx
   2303  fda8		       d0 f7		      bne	.LVTens
   2304  fdaa				   .LVTensDone
   2305  fdaa		       0a		      asl
   2306  fdab		       0a		      asl
   2307  fdac		       0a		      asl		; ones * 8
   2308  fdad		       85 e8		      sta	scorePtr5
   2309  fdaf		       8a		      txa
   2310  fdb0		       0a		      asl
   2311  fdb1		       0a		      asl
   2312  fdb2		       0a		      asl		; tens * 8
