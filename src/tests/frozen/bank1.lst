   1545  faa4							; UpdateLaserSound — low "zoom" tone on channel 0 while fire is held.
   1546  faa4							; Call order in bank0 overscan: UpdateBombSound, UpdateJetSound, this — so
   1547  faa4							; AUDV0 is already forced to 0 by UpdateBombSound when BombSnd = 0, which is
   1548  faa4							; exactly what silence-on-release needs (this routine then does nothing).
   1549  faa4							; Bomb events own ch0 (BombSnd > 0 -> skip) so blip/explosion stay audible.
   1550  faa4							; Pitch sweeps AUDF 4..14 on the free-running frame clock: AUDC=2 divides by
   1551  faa4							; 15, so f = 31400/((AUDF+1)*15) = 419..140 Hz (low). Triangle, 8 steps x
   1552  faa4							; 8 frames = 1.07 s per cycle, no audible wrap jump.
   1553  faa4							; Clobbers A/X; Y preserved. No ZP writes.
   1554  faa4				   UpdateLaserSound
   1555  faa4		       a5 f1		      lda	BombSnd
   1556  faa6		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1557  faa8		       a5 c0		      lda	LaserState
   1558  faaa		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1559  faac		       a5 c2		      lda	EnemyRamP
   1560  faae		       4a		      lsr
   1561  faaf		       4a		      lsr
   1562  fab0		       4a		      lsr		; /8 frames per sweep step
   1563  fab1		       29 07		      and	#7
   1564  fab3		       aa		      tax
   1565  fab4		       bd c4 fa 	      lda	LaserFreqTable,X
   1566  fab7		       85 17		      sta	AUDF0
   1567  fab9		       a9 02		      lda	#LASER_AUD_C
   1568  fabb		       85 15		      sta	AUDC0
   1569  fabd		       a9 09		      lda	#LASER_AUD_V
   1570  fabf		       85 19		      sta	AUDV0
