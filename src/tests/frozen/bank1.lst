   2358  fde3							; ========================================================================
   2359  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2360  fde3							; ========================================================================
   2361  fde3					      .ds	$FDE3 - *, 0
   2362  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2363  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2364  fde3							; rails keep it inside the room
   2365  fde3		       00 83	   RAFTER_BASE =	131	; raft top when the tide is at 0: the 2-row
   2366  fde3							; surface (line 132) - 7, so its BOTTOM row
   2367  fde3							; sits exactly ON the surface. The live value is
   2368  fde3							; plank's BOTTOM row (top+1) lands on the water
   2369  fde3							; surface (132+off) — see the tide block below;
   2370  fde3							; never hard-code the Y: the surface MOVES.
   2371  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2372  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2373  fde3		       00 1c	   RAFTER_YSPAN =	28	; PLAYER_SPRITE_H+6: riding when the feet are
   2374  fde3							; from 22 px above the raft's top to 5 px into it
   2375  fde3		       00 16	   RAFTER_PINFIT =	22	; PLAYER_SPRITE_H: pin = raft top - this
   2376  fde3
   2377  fde3				   RaftBody
   2378  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2379  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2380  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2381  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2382  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
   2383  fde3							; This mirrors the VBL's
   2384  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2385  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2386  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2387  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2388  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2389  fde3		       a5 c2		      lda	EnemyRamP
   2390  fde5		       29 f0		      and	#$F0
   2391  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2392  fde9		       4a		      lsr
   2393  fdea		       4a		      lsr
   2394  fdeb		       4a		      lsr
   2395  fdec		       4a		      lsr		; A = p (1..15)
   2396  fded		       c9 08		      cmp	#8
   2397  fdef		       90 04		      bcc	.RaftTideTri
   2398  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2399  fdf3		       f0 09		      beq	.RaftTide	; always
   2400  fdf5				   .RaftTideTri
   2401  fdf5		       c9 04		      cmp	#4
   2402  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2403  fdf9		       49 ff		      eor	#$FF
   2404  fdfb		       38		      sec
   2405  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2406  fdfe				   .RaftTide
   2407  fdfe		       18		      clc
   2408  fdff		       69 83		      adc	#RAFTER_BASE	; + 131 -> the surface line (132+off) minus 1
   2409  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2410  fe03							; water line is what the raft floats on
   2411  fe03
   2412  fe03							; --- does the player count as "over the raft"? --------------------------
   2413  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2414  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2415  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2416  fe03							; block here is what makes it park; the pin/carry later still applies while
   2417  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2418  fe03							; raft he is actually standing on.
   2419  fe03		       a5 80		      lda	RoomX
   2420  fe05		       38		      sec
   2421  fe06		       f5 bd		      sbc	EnemyRamX,X
   2422  fe08		       18		      clc
   2423  fe09		       69 06		      adc	#RAFTER_XOFF
   2424  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2425  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2426  fe0f		       a5 81		      lda	RoomY
   2427  fe11		       38		      sec
   2428  fe12		       f5 e2		      sbc	EnemyRamY,X
   2429  fe14		       18		      clc
   2430  fe15		       69 16		      adc	#RAFTER_PINFIT
   2431  fe17		       c9 1c		      cmp	#RAFTER_YSPAN
   2432  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2433  fe1b		       a5 94		      lda	vyHi
   2434  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2435  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2436  fe22				   .RaftNoRide
   2437  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2438  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2439  fe22		       a5 f0		      lda	$F0
   2440  fe24		       29 07		      and	#%00000111
   2441  fe26		       85 f0		      sta	$F0
   2442  fe28		       4c f8 fb 	      jmp	ReturnPad
   2443  fe2b				   .RaftGo
   2444  fe2b							; --- pin FIRST: the rider stays on the raft even on a TURN frame --------
   2445  fe2b							; A raft boxed in by solid row-2 cells (or parked against a rail) turns
   2446  fe2b							; every frame and never moves; the turn path returns before the carry, so
   2447  fe2b							; pinning here is what keeps a rider standing on it. Without it he fell
   2448  fe2b							; through a stuck raft into the water kill line and respawned forever
   2449  fe2b							; (user report 2026-10-22: "player position keeps changing, zig-zags").
   2450  fe2b							; The vyHi < 0 escape is the gate's `.RaftNoRide` (rising is not a ride).
   2451  fe2b		       b5 e2		      lda	EnemyRamY,X
   2452  fe2d		       38		      sec
   2453  fe2e		       e9 16		      sbc	#RAFTER_PINFIT
   2454  fe30		       85 81		      sta	RoomY	; feet on the raft's top
   2455  fe32		       a9 00		      lda	#0
   2456  fe34		       85 93		      sta	vyLo
   2457  fe36		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2458  fe38							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2459  fe38							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2460  fe38							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2461  fe38							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2462  fe38							; it cannot borrow upward either (see the kernel EQU for the contract).
   2463  fe38							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2464  fe38							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2465  fe38							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2466  fe38		       a5 f0		      lda	$F0
   2467  fe3a		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2468  fe3c		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2469  fe3e		       f0 04		      beq	.RaftAtSpeed
   2470  fe40		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2471  fe42		       d0 07		      bne	.RaftHaveStep	; always
   2472  fe44				   .RaftAtSpeed
   2473  fe44		       a5 c2		      lda	EnemyRamP
   2474  fe46		       29 01		      and	#1
   2475  fe48		       18		      clc
   2476  fe49		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2477  fe4b				   .RaftHaveStep
   2478  fe4b		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2479  fe4d		       bd 4f f8 	      lda	RaftBitTab,X
   2480  fe50		       25 c1		      and	EnemyRamD
   2481  fe52		       f0 29		      beq	.RaftLeft
   2482  fe54							; ---- leading edge right: candidate = x + step ---------------------------
   2483  fe54		       b5 bd		      lda	EnemyRamX,X
   2484  fe56		       18		      clc
   2485  fe57		       65 88		      adc	$88
   2486  fe59		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2487  fe5b		       c9 94		      cmp	#RAFT_MAX_X
   2488  fe5d		       b0 14		      bcs	.RaftTurn	; right rail
   2489  fe5f		       18		      clc
   2490  fe60		       69 01		      adc	#1	; the cell just beyond the right edge
   2491  fe62		       4a		      lsr
   2492  fe63		       4a		      lsr
   2493  fe64		       20 31 f8 	      jsr	RaftCellSolid
   2494  fe67		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2495  fe69		       b5 bd		      lda	EnemyRamX,X
   2496  fe6b		       18		      clc
   2497  fe6c		       65 88		      adc	$88
   2498  fe6e		       95 bd		      sta	EnemyRamX,X
   2499  fe70		       4c 9d fe 	      jmp	.RaftRide
