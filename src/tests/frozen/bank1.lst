   2144  fc7a		       c9 04		      cmp	#4
   2145  fc7c		       b0 0c		      bcs	.IRDhi
   2146  fc7e		       18		      clc
   2147  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2148  fc81		       aa		      tax
   2149  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2150  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2151  fc87		       4c f8 fb 	      jmp	ReturnPad
   2152  fc8a				   .IRDhi
   2153  fc8a		       c9 08		      cmp	#8
   2154  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2155  fc8e		       aa		      tax
   2156  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2157  fc92		       4a		      lsr
   2158  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2159  fc94		       25 c0		      and	LaserState
   2160  fc96		       4c f8 fb 	      jmp	ReturnPad
   2161  fc99				   .IRDlit
   2162  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2163  fc9b		       4c f8 fb 	      jmp	ReturnPad
