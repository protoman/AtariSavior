   1183  f7a6		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1184  f7a8		       aa		      tax		; 2c — cache in X
   1185  f7a9		       85 02		      sta	WSYNC	; 3c
   1186  f7ab		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1187  f7ad		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1188  f7b0		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
