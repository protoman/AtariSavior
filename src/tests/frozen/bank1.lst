    568  f44f
    569  f44f							; ------------------------------------------------------------------------------
    570  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    571  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    572  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    573  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    574  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    575  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    576  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    577  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    578  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    579  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    580  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    581  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    582  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    583  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    584  f44f							; ------------------------------------------------------------------------------
    585  f44f				   TallyEntry
    586  f44f		       a5 8a		      lda	DropTarget
    587  f451		       f0 36		      beq	.TEArm
    588  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    589  f455		       d0 2d		      bne	.TEIdle
    590  f457		       a9 04		      lda	#4
    591  f459		       85 ad		      sta	TickCounter
    592  f45b		       c6 f2		      dec	TallyTicks
    593  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    594  f45f		       a5 f2		      lda	TallyTicks
    595  f461		       29 03		      and	#3
    596  f463		       d0 15		      bne	.TEOne	; tick only
    597  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    598  f467		       85 f1		      sta	BombSnd
    599  f469		       a9 04		      lda	#4
    600  f46b		       85 15		      sta	AUDC0	; square
    601  f46d		       a9 18		      lda	#24
    602  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    603  f471		       a9 08		      lda	#8
    604  f473		       85 19		      sta	AUDV0
    605  f475		       a9 03		      lda	#3	; tick + coin
    606  f477		       4c f8 fb 	      jmp	ReturnPad
    607  f47a				   .TEOne
    608  f47a		       a9 01		      lda	#1	; tick only
    609  f47c		       4c f8 fb 	      jmp	ReturnPad
    610  f47f				   .TEFinal
    611  f47f		       a9 07		      lda	#7	; tick + coin + done
    612  f481		       4c f8 fb 	      jmp	ReturnPad
    613  f484				   .TEIdle
    614  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    615  f486		       4c f8 fb 	      jmp	ReturnPad
    616  f489				   .TEArm
    617  f489		       a5 ae		      lda	BarLevel
    618  f48b		       18		      clc
    619  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    620  f48e		       a2 00		      ldx	#0
    621  f490				   .TEDiv
    622  f490		       c9 06		      cmp	#6
    623  f492		       90 06		      bcc	.TEDivSum
    624  f494		       38		      sec
