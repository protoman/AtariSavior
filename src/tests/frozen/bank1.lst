   1121  f6bc		       a2 00		      ldx	#0
   1122  f6be		       20 47 f8 	      jsr	SetObjectXPos_b1
   1123  f6c1		       a9 2f		      lda	#47	; P1: lives 5-8, flush right of P0 (12 + 4 x 8)
   1124  f6c3		       a2 01		      ldx	#1
   1125  f6c5		       20 47 f8 	      jsr	SetObjectXPos_b1
   1126  f6c8		       a9 84		      lda	#132	; the BALL: the key square, right side of the row
   1127  f6ca		       a2 04		      ldx	#4	; selector 4 = RESBL/HMBL
   1128  f6cc		       20 47 f8 	      jsr	SetObjectXPos_b1
