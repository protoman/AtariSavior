   1189  f78d							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1190  f78d							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1191  f78d							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1192  f78d							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1193  f78d							; ====================================================================
