   2308  fdce							; scorePtr5 = (ScoreTe >> 4) * 8  (tens digit)
   2309  fdce		       a5 f5		      lda	ScoreTe
   2310  fdd0		       4a		      lsr
   2311  fdd1		       4a		      lsr
   2312  fdd2		       4a		      lsr
   2313  fdd3		       4a		      lsr		; tens digit in low nibble
   2314  fdd4		       0a		      asl
   2315  fdd5		       0a		      asl
   2316  fdd6		       0a		      asl
