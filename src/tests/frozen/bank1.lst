   1973  fc92		       4a		      lsr
   1974  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   1975  fc94		       25 c0		      and	LaserState
   1976  fc96		       4c f8 fb 	      jmp	ReturnPad
   1977  fc99				   .IRDlit
