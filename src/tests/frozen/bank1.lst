   1571  faa8		       a5 c0		      lda	LaserState
   1572  faaa		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1573  faac		       a5 c2		      lda	EnemyRamP
   1574  faae		       4a		      lsr
   1575  faaf		       4a		      lsr
