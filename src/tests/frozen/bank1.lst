------- FILE bank1.asm
      3  10000 ????						; ==============================================================================
      4  10000 ????						; bank1 — HUD rendering + 6-digit score (F6 bankswitch, $F000-$FFFF)
      5  10000 ????						; ==============================================================================
      6  10000 ????						; Follows HERO/comparison pattern exactly:
      7  10000 ????						; - GRP0/GRP1 for indicator sprites (lives, bombs)
      8  10000 ????						; - 48-pixel sprite technique for score (NUSIZ copies + VDELP cross-buffer)
      9  10000 ????						; - SetObjectXPos for precise positioning
     10  10000 ????						; - Returns via fold-pad at $FC70
     11  10000 ????
     12  10000 ????		00 01	    VBLANK     =	$01
     13  10000 ????		00 02	    WSYNC      =	$02
     14  10000 ????		00 04	    NUSIZ0     =	$04
     15  10000 ????		00 05	    NUSIZ1     =	$05
     16  10000 ????		00 06	    COLUP0     =	$06
     17  10000 ????		00 07	    COLUP1     =	$07
     18  10000 ????		00 08	    COLUPF     =	$08
     19  10000 ????		00 09	    COLUBK     =	$09
     20  10000 ????		00 ac	    PlayerLives =	$AC
     21  10000 ????		00 f0	    PlayerBombs =	$F0
     22  10000 ????		00 a7	    LevelStartRoom =	$A7	; b7 = KeyHeld (bank0 owns it; read-only here)
     23  10000 ????		00 ae	    BarLevel   =	$AE
     24  10000 ????		00 9b	    BarIdx     =	$9B	; (BarLevel+7)>>3, synced by kernel overscan (D2)
     25  10000 ????		00 78	    BAR_MAX    =	120	; full bar (60 frames/step × 120 = 120s)
     26  10000 ????		00 08	    COLUPF     =	$08
     27  10000 ????		00 09	    COLUBK     =	$09
     28  10000 ????		00 0d	    PF0        =	$0D
     29  10000 ????		00 0e	    PF1        =	$0E
     30  10000 ????		00 0f	    PF2        =	$0F
     31  10000 ????		00 10	    RESP0      =	$10
     32  10000 ????		00 11	    RESP1      =	$11
     33  10000 ????		00 1b	    GRP0       =	$1B
     34  10000 ????		00 1c	    GRP1       =	$1C
     35  10000 ????		00 1d	    ENAM0      =	$1D
     36  10000 ????		00 1e	    ENAM1      =	$1E
     37  10000 ????		00 1f	    ENABL      =	$1F
     38  10000 ????		00 20	    HMP0       =	$20
     39  10000 ????		00 21	    HMP1       =	$21
     40  10000 ????		00 2a	    HMOVE      =	$2A
     41  10000 ????		00 0b	    REFP0      =	$0B
     42  10000 ????		00 0c	    REFP1      =	$0C
     43  10000 ????		00 0a	    CTRLPF     =	$0A
     44  10000 ????		00 25	    VDELP0     =	$25
     45  10000 ????		00 26	    VDELP1     =	$26
     46  10000 ????
     47  f000					      org	$F000
     48  f000
     49  f000							; --- power-up stub: the F6 latch powers up in an UNDEFINED bank on real
     50  f000							; hardware (Stella only randomises it with developer settings), so every
     51  f000							; bank must be able to start. This is 5 bytes on purpose: `sta $1FF4`
     52  f000							; switches to bank0, and the next fetch ($F005) then comes from BANK0,
     53  f000							; where a `jmp $F008` (GameStart) sits — the same 5-byte prefix bank2 and
     54  f000							; bank3 carry. Never shorten it to a bare `jmp`: that is what this bank had
     55  f000							; (a bank-select-less `jmp $F008` = BRK loop into zero fill).
     56  f000							; Guard: verify_build.check_boot_banks + tools/test_boot_banks.py.
     57  f000		       a9 00		      lda	#0
     58  f002		       8d f4 1f 	      sta	$1FF4	; select bank0 (hotspot: the DATA is ignored)
     59  f005
     60  f005							; --- ColOff/ColMask (plan 5.1b, 2026-10-20) ---
     61  f005							; The cell punch reads PF cells directly: PF0Buf/Y with ColOff,X (row
     62  f005							; base 0/3/6) and AND ColMask,X. Same 20-entry encoding as bank2's
     63  f005							; LaserWallClamp copy (cross-bank reads are impossible). These replace
     64  f005							; the ABW rect tables + BombMaskBit (the rect cache has no reader once
     65  f005							; the punch is cell-based). Parked in the $F003 fill gap, clear of the
     66  f005							; power-up stub's $F008 landing zone.
     67  f005		       00 00 00 00*	      .ds	$F010 - *, 0
     68  f010				   ColOff
     69  f010		       00 00 00 00*	      .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
     70  f024							; N=4: stride 4 → PF1/PF2 rows at +4/+8
     71  f024				   ColMask
     72  f024		       10 20 40 80*	      .byte.b	$10,$20,$40,$80, $80,$40,$20,$10,$08,$04,$02,$01
     73  f030		       01 02 04 08*	      .byte.b	$01,$02,$04,$08, $10,$20,$40,$80
     74  f038
     75  f038							; MothYDerive — moved from bank0 (leaf_move_plan Step 0, 2026-10-16). In
     76  f038							; Y = record+0, X = slot (preserved). Out A = live Y delta; the bank0
