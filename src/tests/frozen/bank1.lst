   1660  fadd		       98		      tya
   1661  fade		       05 ad		      ora	Temp
   1662  fae0		       85 ad		      sta	Temp	; both pair bits
   1663  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1664  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1665  fae2		       a4 84		      ldy	LineCount
   1666  fae4		       e0 04		      cpx	#4
   1667  fae6		       90 0a		      bcc	.pg0
