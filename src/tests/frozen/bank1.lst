   1292  f812							; ====================================================================
   1293  f812							; Pad remaining scanlines to reach exactly 48 total
   1294  f812							; Path A (PlayerLives > 0) — execution count:
   1295  f812							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1296  f812							;   Timer:    3 loop + 1 gap = 4
   1297  f812							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1298  f812							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
