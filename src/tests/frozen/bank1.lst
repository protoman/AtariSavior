   1234  f7ee							; ====================================================================
   1235  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1236  f7ee							; Path A (PlayerLives > 0) — execution count:
   1237  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1238  f7ee							;   Timer:    3 loop + 1 gap = 4
   1239  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1240  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1241  f7ee							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1242  f7ee							;   Subtotal: 6+4+8+11+10 = 39
   1243  f7ee							;   Pad:      48 - 39 = 9
   1244  f7ee							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1245  f7ee							; ====================================================================
   1246  f7ee		       a2 09		      ldx	#9
   1247  f7f0				   .HudPad
   1248  f7f0		       85 02		      sta	WSYNC
   1249  f7f2		       ca		      dex
   1250  f7f3		       d0 fb		      bne	.HudPad
   1251  f7f5
   1252  f7f5							; --- Return to bank0 via fold-pad ---
   1253  f7f5		       4c 70 fc 	      jmp	$FC70
   1254  f7f8
   1255  f7f8							; ========================================================================
   1256  f7f8							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1257  f7f8							; X=0 positions P0, X=1 positions P1
   1258  f7f8							; A = pixel position (0-159)
   1259  f7f8							; ========================================================================
   1260  f7f8				   SetObjectXPos_b1
   1261  f7f8		       85 02		      sta	WSYNC
   1262  f7fa		       38		      sec
   1263  f7fb				   .Div15Loop
   1264  f7fb		       e9 0f		      sbc	#15
   1265  f7fd		       b0 fc		      bcs	.Div15Loop
   1266  f7ff		       a8		      tay
   1267  f800		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1268  f803		       95 20		      sta	HMP0,X
   1269  f805		       95 10		      sta	RESP0,X
   1270  f807		       60		      rts
   1271  f808
   1272  f808							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1273  f808							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1274  f808							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1275  f808							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1276  f808							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1277  f808							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1278  f808				   BarDelayTable		; (B+7)>>3, 15 entries
   1279  f808		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1280  f817				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1281  f817		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
   1282  f826
   1283  f826							; ------------------------------------------------------------------------------
   1284  f826
   1285  f826							; ==============================================================================
   1286  f826							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1287  f826							; ==============================================================================
   1288  f826							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1289  f826							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1290  f826							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1291  f826							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1292  f826							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1293  f826							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1294  f826							; TickCounter — writing that would stall the game timer).
   1295  f826							;
   1296  f826							; User spec 2026-10-18: floats only on water; carries the player across and
   1297  f826							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1298  f826							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1299  f826							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1300  f826							;	       into CollisionX, kernel draws the strip as the band's last
   1301  f826							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1302  f826							;	       row sits exactly on the moving surface — it rides the wave the
   1303  f826							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1304  f826							;	       stays clear of the 125 water-kill line at every tide phase.
   1305  f826							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1306  f826							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1307  f826							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1308  f826							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1309  f826							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1310  f826							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1311  f826							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1312  f826							;	       flag+level, so the empty raft runs at full speed and the next
   1313  f826							;	       take-off ramps again. It also holds the frame it turns around on.
   1314  f826							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1315  f826							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1316  f826							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1317  f826							;	       exactly the open water span of the room.
   1318  f826							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1319  f826							;	       its upper rows; step off and it parks immediately (the ramp state
   1320  f826							;	       is cleared too, so the next take-off ramps again). While over it a
   1321  f826							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1322  f826							;	       zeroed (gravity must never accumulate into the water) and carried
   1323  f826							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1324  f826							;	       flying off is always possible. Leaving and re-entering the ROOM
   1325  f826							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1326  f826							;	       it), which is the "reset" the user asked for.
   1327  f826							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1328  f826							; ==============================================================================
   1329  f826							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1330  f826							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1331  f826							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1332  f826							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1333  f826							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1334  f826							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1335  f826							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1336  f826							;   cols 20-39 -> the mirrored half: source = 39-col
   1337  f826				   RaftCellSolid
   1338  f826		       c9 14		      cmp	#20
   1339  f828		       90 05		      bcc	.RCSrc
   1340  f82a		       49 ff		      eor	#$ff
   1341  f82c		       18		      clc
   1342  f82d		       69 28		      adc	#40
   1343  f82f				   .RCSrc
   1344  f82f		       a8		      tay
   1345  f830		       b9 48 f8 	      lda	RaftCellMasks,Y
   1346  f833		       c0 04		      cpy	#4
   1347  f835		       b0 03		      bcs	.RCPF1
   1348  f837		       25 c5		      and	$C5
   1349  f839		       60		      rts
   1350  f83a				   .RCPF1
   1351  f83a		       c0 0c		      cpy	#12
   1352  f83c		       b0 03		      bcs	.RCPF2
   1353  f83e		       25 c8		      and	$C8
   1354  f840		       60		      rts
   1355  f841				   .RCPF2
   1356  f841		       25 cb		      and	$CB
   1357  f843		       60		      rts
   1358  f844
   1359  f844				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1360  f844		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1361  f848
   1362  f848				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1363  f848		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1364  f84c		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
