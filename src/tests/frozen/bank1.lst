     81  f03e		       c9 08		      cmp	#8
     82  f040		       90 02		      bcc	.mUpB1
     83  f042		       49 0f		      eor	#15
     84  f044				   .mUpB1
     85  f044		       c9 07		      cmp	#7
     86  f046		       90 02		      bcc	.mOkB1
     87  f048		       a9 06		      lda	#6
     88  f04a				   .mOkB1
     89  f04a		       0a		      asl
     90  f04b		       69 fa		      adc	#$FA
     91  f04d		       4c f8 fb 	      jmp	ReturnPad
