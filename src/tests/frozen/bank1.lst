   1278  f7a5		       a4 ec		      ldy	<scbrdCnt	; 3c
   1279  f7a7		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1280  f7a9		       aa		      tax		; 2c — cache in X
   1281  f7aa		       85 02		      sta	WSYNC	; 3c
   1282  f7ac		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1283  f7ae		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1284  f7b1		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1285  f7b3		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1286  f7b5		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1287  f7b7		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1288  f7b9		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1289  f7bb		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1290  f7bd		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1291  f7bf		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1292  f7c1		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1293  f7c3		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1294  f7c5		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1295  f7c7		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1296  f7c9		       c6 ec		      dec	<scbrdCnt	; 5c
   1297  f7cb		       d0 d8		      bne	.ScoreLoop	; 3c
