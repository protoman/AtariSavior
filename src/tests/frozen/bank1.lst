   1273  f7a1							; ====================================================================
   1274  f7a1							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1275  f7a1							; Proven kernel from score48pix.asm
   1276  f7a1							; ====================================================================
