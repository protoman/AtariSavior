   2313  fde3							; ========================================================================
   2314  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2315  fde3							; ========================================================================
   2316  fde3					      .ds	$FDE3 - *, 0
   2317  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2318  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2319  fde3							; rails keep it inside the room
   2320  fde3		       00 7d	   RAFTER_BASE =	125	; raft top when the tide is at 0 = the water
   2321  fde3							; surface (line 132) - 7, so its BOTTOM row
   2322  fde3							; sits exactly ON the surface. The live value is
   2323  fde3							; RAFTER_BASE + off (see the tide block below) —
   2324  fde3							; never hard-code the Y: the surface MOVES.
   2325  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2326  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2327  fde3		       00 12	   RAFTER_YSPAN =	18	; PLAYER_SPRITE_H+6: riding when the feet are
   2328  fde3							; from 12 px above the raft's top to 5 px into it
   2329  fde3		       00 0c	   RAFTER_PINFIT =	12	; PLAYER_SPRITE_H: pin = raft top - this
   2330  fde3
   2331  fde3				   RaftBody
   2332  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2333  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2334  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2335  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2336  fde3							; (top+7) must land ON that line -> top = 125+off. This mirrors the VBL's
   2337  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2338  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2339  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2340  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2341  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2342  fde3		       a5 c2		      lda	EnemyRamP
   2343  fde5		       29 f0		      and	#$F0
   2344  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2345  fde9		       4a		      lsr
   2346  fdea		       4a		      lsr
   2347  fdeb		       4a		      lsr
   2348  fdec		       4a		      lsr		; A = p (1..15)
   2349  fded		       c9 08		      cmp	#8
   2350  fdef		       90 04		      bcc	.RaftTideTri
   2351  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2352  fdf3		       f0 09		      beq	.RaftTide	; always
   2353  fdf5				   .RaftTideTri
   2354  fdf5		       c9 04		      cmp	#4
   2355  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2356  fdf9		       49 ff		      eor	#$FF
   2357  fdfb		       38		      sec
   2358  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2359  fdfe				   .RaftTide
   2360  fdfe		       18		      clc
   2361  fdff		       69 7d		      adc	#RAFTER_BASE	; + 125 -> the surface line (132+off) minus 7
   2362  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2363  fe03							; water line is what the raft floats on
   2364  fe03							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2365  fe03							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2366  fe03							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2367  fe03							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2368  fe03							; it cannot borrow upward either (see the kernel EQU for the contract).
   2369  fe03							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2370  fe03							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2371  fe03							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2372  fe03		       a5 f0		      lda	$F0
   2373  fe05		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2374  fe07		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2375  fe09		       f0 04		      beq	.RaftAtSpeed
   2376  fe0b		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2377  fe0d		       d0 07		      bne	.RaftHaveStep	; always
   2378  fe0f				   .RaftAtSpeed
   2379  fe0f		       a5 c2		      lda	EnemyRamP
   2380  fe11		       29 01		      and	#1
   2381  fe13		       18		      clc
   2382  fe14		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2383  fe16				   .RaftHaveStep
   2384  fe16		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2385  fe18		       bd 44 f8 	      lda	RaftBitTab,X
   2386  fe1b		       25 c1		      and	EnemyRamD
   2387  fe1d		       f0 29		      beq	.RaftLeft
   2388  fe1f							; ---- leading edge right: candidate = x + step ---------------------------
   2389  fe1f		       b5 bd		      lda	EnemyRamX,X
   2390  fe21		       18		      clc
   2391  fe22		       65 88		      adc	$88
   2392  fe24		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2393  fe26		       c9 94		      cmp	#RAFT_MAX_X
   2394  fe28		       b0 14		      bcs	.RaftTurn	; right rail
