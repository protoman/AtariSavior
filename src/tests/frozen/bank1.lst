     82  f042		       49 0f		      eor	#15
     83  f044				   .mUpB1
     84  f044		       c9 07		      cmp	#7
     85  f046		       90 02		      bcc	.mOkB1
     86  f048		       a9 06		      lda	#6
     87  f04a				   .mOkB1
     88  f04a		       0a		      asl
     89  f04b		       69 fa		      adc	#$FA
