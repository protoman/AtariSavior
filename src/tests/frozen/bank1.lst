    525  f41f							; ------------------------------------------------------------------------------
    526  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    527  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    528  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    529  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    530  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    531  f41f							; Staging contract (both scratch bytes free in this flow):
    532  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    533  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    534  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    535  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    536  f41f							; ------------------------------------------------------------------------------
    537  f41f				   M1StripBlast
    538  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    539  f421		       c9 14		      cmp	#20
    540  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    541  f425		       a5 ba		      lda	EnemyDeadMask
    542  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    543  f429		       d0 15		      bne	.M1SBnone
    544  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    545  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    546  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    547  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    548  f433		       4a		      lsr
    549  f434		       4a		      lsr
    550  f435		       4a		      lsr
    551  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    552  f437							;   high end — StripBlastCheck rejects)
    553  f437		       38		      sec
    554  f438		       e9 01		      sbc	#1	; ℓ = left_col
    555  f43a		       0a		      asl		; 2ℓ = strip left dcol
    556  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    557  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    558  f440				   .M1SBnone
    559  f440		       a9 ff		      lda	#$FF
    560  f442		       85 92		      sta	RectCount	; no left strip this frame
    561  f444				   .M1SBdoorR
    562  f444		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
    563  f446		       10 04		      bpl	.M1SBout
    564  f448		       a0 ff		      ldy	#$FF
    565  f44a		       84 88		      sty	BMWScratch	; $88 = StripBlastCheck's "no strip"
    566  f44c				   .M1SBout
