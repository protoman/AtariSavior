   1554  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1555  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1556  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1557  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1558  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1559  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1560  facc							;   double-score guard for that slot only — first blast sees the pair
   1561  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1562  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1563  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1564  facc							;   Same-bank jsr legal (no pad nesting).
   1565  facc				   PairGone
   1566  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1567  face		       aa		      tax
   1568  facf		       bd 68 fa 	      lda	BombClearMask,X
   1569  fad2		       49 ff		      eor	#$FF
   1570  fad4		       a8		      tay		; Y = bit for col x
   1571  fad5		       e8		      inx
   1572  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1573  fad9		       49 ff		      eor	#$FF
   1574  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1575  fadd		       98		      tya
   1576  fade		       05 ad		      ora	Temp
   1577  fae0		       85 ad		      sta	Temp	; both pair bits
   1578  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1579  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1580  fae2		       a4 84		      ldy	LineCount
   1581  fae4		       e0 04		      cpx	#4
   1582  fae6		       90 0a		      bcc	.pg0
   1583  fae8		       e0 0c		      cpx	#12
   1584  faea		       90 0c		      bcc	.pg1
   1585  faec		       b9 c9 00 	      lda	PF2Buf,Y
   1586  faef		       25 ad		      and	Temp
   1587  faf1		       60		      rts
   1588  faf2				   .pg0
   1589  faf2		       b9 c3 00 	      lda	PF0Buf,Y
   1590  faf5		       25 ad		      and	Temp
   1591  faf7		       60		      rts
   1592  faf8				   .pg1
   1593  faf8		       b9 c6 00 	      lda	PF1Buf,Y
   1594  fafb		       25 ad		      and	Temp
   1595  fafd		       60		      rts
