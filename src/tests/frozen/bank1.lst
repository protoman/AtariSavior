   2330  fddd		       0a		      asl
   2331  fdde		       0a		      asl
   2332  fddf		       0a		      asl
   2333  fde0		       85 ea		      sta	scorePtr6
   2334  fde2		       60		      rts
   2335  fde3
   2336  fde3							; ========================================================================
   2337  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2338  fde3							; ========================================================================
   2339  fde3					      .ds	$FDE3 - *, 0
   2340  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2341  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2342  fde3							; rails keep it inside the room
   2343  fde3		       00 83	   RAFTER_BASE =	131	; raft top when the tide is at 0: the 2-row
   2344  fde3							; surface (line 132) - 7, so its BOTTOM row
   2345  fde3							; sits exactly ON the surface. The live value is
   2346  fde3							; plank's BOTTOM row (top+1) lands on the water
   2347  fde3							; surface (132+off) — see the tide block below;
   2348  fde3							; never hard-code the Y: the surface MOVES.
   2349  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2350  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2351  fde3		       00 1c	   RAFTER_YSPAN =	28	; PLAYER_SPRITE_H+6: riding when the feet are
   2352  fde3							; from 22 px above the raft's top to 5 px into it
   2353  fde3		       00 16	   RAFTER_PINFIT =	22	; PLAYER_SPRITE_H: pin = raft top - this
   2354  fde3
   2355  fde3				   RaftBody
   2356  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2357  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2358  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2359  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2360  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
   2361  fde3							; This mirrors the VBL's
   2362  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2363  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2364  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2365  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2366  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2367  fde3		       a5 c2		      lda	EnemyRamP
   2368  fde5		       29 f0		      and	#$F0
   2369  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2370  fde9		       4a		      lsr
   2371  fdea		       4a		      lsr
   2372  fdeb		       4a		      lsr
   2373  fdec		       4a		      lsr		; A = p (1..15)
   2374  fded		       c9 08		      cmp	#8
   2375  fdef		       90 04		      bcc	.RaftTideTri
   2376  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2377  fdf3		       f0 09		      beq	.RaftTide	; always
   2378  fdf5				   .RaftTideTri
   2379  fdf5		       c9 04		      cmp	#4
   2380  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2381  fdf9		       49 ff		      eor	#$FF
   2382  fdfb		       38		      sec
   2383  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2384  fdfe				   .RaftTide
   2385  fdfe		       18		      clc
   2386  fdff		       69 83		      adc	#RAFTER_BASE	; + 131 -> the surface line (132+off) minus 1
   2387  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2388  fe03							; water line is what the raft floats on
   2389  fe03
   2390  fe03							; --- does the player count as "over the raft"? --------------------------
   2391  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2392  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2393  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2394  fe03							; block here is what makes it park; the pin/carry later still applies while
   2395  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2396  fe03							; raft he is actually standing on.
   2397  fe03		       a5 80		      lda	RoomX
   2398  fe05		       38		      sec
   2399  fe06		       f5 bd		      sbc	EnemyRamX,X
   2400  fe08		       18		      clc
   2401  fe09		       69 06		      adc	#RAFTER_XOFF
   2402  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2403  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2404  fe0f		       a5 81		      lda	RoomY
   2405  fe11		       38		      sec
   2406  fe12		       f5 e2		      sbc	EnemyRamY,X
   2407  fe14		       18		      clc
   2408  fe15		       69 16		      adc	#RAFTER_PINFIT
   2409  fe17		       c9 1c		      cmp	#RAFTER_YSPAN
   2410  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2411  fe1b		       a5 94		      lda	vyHi
   2412  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2413  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2414  fe22				   .RaftNoRide
   2415  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2416  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2417  fe22		       a5 f0		      lda	$F0
   2418  fe24		       29 07		      and	#%00000111
   2419  fe26		       85 f0		      sta	$F0
   2420  fe28		       4c f8 fb 	      jmp	ReturnPad
   2421  fe2b				   .RaftGo
   2422  fe2b							; --- pin FIRST: the rider stays on the raft even on a TURN frame --------
   2423  fe2b							; A raft boxed in by solid row-2 cells (or parked against a rail) turns
   2424  fe2b							; every frame and never moves; the turn path returns before the carry, so
   2425  fe2b							; pinning here is what keeps a rider standing on it. Without it he fell
   2426  fe2b							; through a stuck raft into the water kill line and respawned forever
   2427  fe2b							; (user report 2026-10-22: "player position keeps changing, zig-zags").
   2428  fe2b							; The vyHi < 0 escape is the gate's `.RaftNoRide` (rising is not a ride).
   2429  fe2b		       b5 e2		      lda	EnemyRamY,X
   2430  fe2d		       38		      sec
   2431  fe2e		       e9 16		      sbc	#RAFTER_PINFIT
   2432  fe30		       85 81		      sta	RoomY	; feet on the raft's top
   2433  fe32		       a9 00		      lda	#0
   2434  fe34		       85 93		      sta	vyLo
   2435  fe36		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2436  fe38							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2437  fe38							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2438  fe38							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2439  fe38							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2440  fe38							; it cannot borrow upward either (see the kernel EQU for the contract).
   2441  fe38							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2442  fe38							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2443  fe38							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2444  fe38		       a5 f0		      lda	$F0
   2445  fe3a		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2446  fe3c		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2447  fe3e		       f0 04		      beq	.RaftAtSpeed
   2448  fe40		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2449  fe42		       d0 07		      bne	.RaftHaveStep	; always
   2450  fe44				   .RaftAtSpeed
   2451  fe44		       a5 c2		      lda	EnemyRamP
   2452  fe46		       29 01		      and	#1
   2453  fe48		       18		      clc
   2454  fe49		       69 01		      adc	#1	; 1 px even frames, 2 px odd = 1.5 px/frame
   2455  fe4b				   .RaftHaveStep
   2456  fe4b		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2457  fe4d		       bd 7e f8 	      lda	RaftBitTab,X
   2458  fe50		       25 c1		      and	EnemyRamD
   2459  fe52		       f0 29		      beq	.RaftLeft
   2460  fe54							; ---- leading edge right: candidate = x + step ---------------------------
   2461  fe54		       b5 bd		      lda	EnemyRamX,X
   2462  fe56		       18		      clc
   2463  fe57		       65 88		      adc	$88
   2464  fe59		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2465  fe5b		       c9 94		      cmp	#RAFT_MAX_X
   2466  fe5d		       b0 14		      bcs	.RaftTurn	; right rail
   2467  fe5f		       18		      clc
   2468  fe60		       69 01		      adc	#1	; the cell just beyond the right edge
   2469  fe62		       4a		      lsr
   2470  fe63		       4a		      lsr
   2471  fe64		       20 60 f8 	      jsr	RaftCellSolid
   2472  fe67		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2473  fe69		       b5 bd		      lda	EnemyRamX,X
   2474  fe6b		       18		      clc
   2475  fe6c		       65 88		      adc	$88
   2476  fe6e		       95 bd		      sta	EnemyRamX,X
   2477  fe70		       4c 9d fe 	      jmp	.RaftRide
   2478  fe73							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
   2479  fe73							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2480  fe73				   .RaftTurn
   2481  fe73		       bd 7e f8 	      lda	RaftBitTab,X
   2482  fe76		       45 c1		      eor	EnemyRamD
   2483  fe78		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2484  fe7a							; bank1's RoomDarkMask — must be preserved)
   2485  fe7a		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2486  fe7d							; ---- leading edge left --------------------------------------------------
   2487  fe7d				   .RaftLeft
   2488  fe7d		       b5 bd		      lda	EnemyRamX,X
   2489  fe7f		       38		      sec
   2490  fe80		       e5 88		      sbc	$88
   2491  fe82		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2492  fe84		       c9 08		      cmp	#RAFT_MIN_X
   2493  fe86		       90 eb		      bcc	.RaftTurn	; left rail
   2494  fe88		       38		      sec
   2495  fe89		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2496  fe8b		       b0 02		      bcs	.RaftLeftCol
   2497  fe8d		       a9 00		      lda	#0
   2498  fe8f				   .RaftLeftCol
   2499  fe8f		       4a		      lsr
   2500  fe90		       4a		      lsr
   2501  fe91		       20 60 f8 	      jsr	RaftCellSolid
   2502  fe94		       d0 dd		      bne	.RaftTurn
   2503  fe96		       b5 bd		      lda	EnemyRamX,X
   2504  fe98		       38		      sec
   2505  fe99		       e5 88		      sbc	$88
   2506  fe9b		       95 bd		      sta	EnemyRamX,X
   2507  fe9d							; ---- carry + pin while the player is aboard -----------------------------
   2508  fe9d				   .RaftRide
   2509  fe9d							; (the Y pin ran at .RaftGo — it must not depend on the raft moving)
   2510  fe9d							; ramp: arm the flag, and +1 level every 2nd frame (capped at 15)
   2511  fe9d		       a5 f0		      lda	$F0
   2512  fe9f		       09 80		      ora	#%10000000
   2513  fea1		       85 f0		      sta	$F0
   2514  fea3		       a5 c2		      lda	EnemyRamP
   2515  fea5		       4a		      lsr		; C = the frame-parity bit
   2516  fea6		       b0 0f		      bcs	.RaftCarry	; odd frame: flag only this time
   2517  fea8		       a5 f0		      lda	$F0
   2518  feaa		       29 78		      and	#%01111000
   2519  feac		       c9 78		      cmp	#%01111000
   2520  feae		       f0 07		      beq	.RaftCarry	; already spun up
   2521  feb0		       a5 f0		      lda	$F0
   2522  feb2		       18		      clc
   2523  feb3		       69 10		      adc	#%00010000
   2524  feb5		       85 f0		      sta	$F0
   2525  feb7				   .RaftCarry
   2526  feb7		       bd 7e f8 	      lda	RaftBitTab,X
   2527  feba		       25 c1		      and	EnemyRamD
   2528  febc		       f0 0a		      beq	.RaftCarryL
   2529  febe		       a5 80		      lda	RoomX
   2530  fec0		       18		      clc
   2531  fec1		       65 88		      adc	$88
   2532  fec3		       85 80		      sta	RoomX
   2533  fec5		       4c d2 fe 	      jmp	.RaftDone
   2534  fec8				   .RaftCarryL
   2535  fec8		       a5 80		      lda	RoomX
   2536  feca		       38		      sec
   2537  fecb		       e5 88		      sbc	$88
   2538  fecd		       85 80		      sta	RoomX
   2539  fecf		       4c d2 fe 	      jmp	.RaftDone
   2540  fed2				   .RaftDone
