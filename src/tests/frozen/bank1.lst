   2401  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2402  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2403  fe0f		       a5 81		      lda	RoomY
   2404  fe11		       38		      sec
   2405  fe12		       f5 e2		      sbc	EnemyRamY,X
   2406  fe14		       18		      clc
   2407  fe15		       69 16		      adc	#RAFTER_PINFIT
   2408  fe17		       c9 1c		      cmp	#RAFTER_YSPAN
   2409  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2410  fe1b		       a5 94		      lda	vyHi
   2411  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2412  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2413  fe22				   .RaftNoRide
   2414  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2415  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2416  fe22		       a5 f0		      lda	$F0
   2417  fe24		       29 07		      and	#%00000111
   2418  fe26		       85 f0		      sta	$F0
   2419  fe28		       4c f8 fb 	      jmp	ReturnPad
