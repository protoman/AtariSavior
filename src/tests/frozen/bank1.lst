   1229  f7ee							; ====================================================================
   1230  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1231  f7ee							; Path A (PlayerLives > 0) — execution count:
   1232  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1233  f7ee							;   Timer:    3 loop + 1 gap = 4
   1234  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1235  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1236  f7ee							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1237  f7ee							;   Subtotal: 6+4+8+11+10 = 39
   1238  f7ee							;   Pad:      48 - 39 = 9
   1239  f7ee							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1240  f7ee							; ====================================================================
   1241  f7ee		       a2 09		      ldx	#9
   1242  f7f0				   .HudPad
   1243  f7f0		       85 02		      sta	WSYNC
   1244  f7f2		       ca		      dex
   1245  f7f3		       d0 fb		      bne	.HudPad
   1246  f7f5
   1247  f7f5							; --- Return to bank0 via fold-pad ---
   1248  f7f5		       4c 70 fc 	      jmp	$FC70
   1249  f7f8
   1250  f7f8							; ========================================================================
   1251  f7f8							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1252  f7f8							; X=0 positions P0, X=1 positions P1
   1253  f7f8							; A = pixel position (0-159)
   1254  f7f8							; ========================================================================
   1255  f7f8				   SetObjectXPos_b1
   1256  f7f8		       85 02		      sta	WSYNC
   1257  f7fa		       38		      sec
   1258  f7fb				   .Div15Loop
   1259  f7fb		       e9 0f		      sbc	#15
   1260  f7fd		       b0 fc		      bcs	.Div15Loop
   1261  f7ff		       a8		      tay
   1262  f800		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1263  f803		       95 20		      sta	HMP0,X
   1264  f805		       95 10		      sta	RESP0,X
   1265  f807		       60		      rts
   1266  f808
   1267  f808							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1268  f808							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1269  f808							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1270  f808							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1271  f808							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1272  f808							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1273  f808				   BarDelayTable		; (B+7)>>3, 15 entries
   1274  f808		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1275  f817				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1276  f817		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
   1277  f826
   1278  f826							; ------------------------------------------------------------------------------
   1279  f826
   1280  f826							; ==============================================================================
   1281  f826							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1282  f826							; ==============================================================================
   1283  f826							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1284  f826							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1285  f826							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1286  f826							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1287  f826							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1288  f826							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1289  f826							; TickCounter — writing that would stall the game timer).
   1290  f826							;
   1291  f826							; User spec 2026-10-18: floats only on water; carries the player across and
   1292  f826							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1293  f826							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1294  f826							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1295  f826							;	       into CollisionX, kernel draws the strip as the band's last
   1296  f826							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1297  f826							;	       row sits exactly on the moving surface — it rides the wave the
   1298  f826							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1299  f826							;	       stays clear of the 125 water-kill line at every tide phase.
   1300  f826							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1301  f826							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1302  f826							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1303  f826							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1304  f826							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1305  f826							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1306  f826							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1307  f826							;	       flag+level, so the empty raft runs at full speed and the next
   1308  f826							;	       take-off ramps again. It also holds the frame it turns around on.
   1309  f826							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1310  f826							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1311  f826							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1312  f826							;	       exactly the open water span of the room.
   1313  f826							;   Ride    = while the player's box overlaps the raft's upper rows and he is not
   1314  f826							;	       rising (vyHi >= 0): pin RoomY to the raft's top, zero vy (gravity
   1315  f826							;	       must never accumulate into the water) and carry RoomX by the
   1316  f826							;	       raft's own step. Thrust up (vyHi < 0) skips the pin, so the player
   1317  f826							;	       can always fly off.
   1318  f826							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1319  f826							; ==============================================================================
   1320  f826							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1321  f826							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1322  f826							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1323  f826							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1324  f826							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1325  f826							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1326  f826							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1327  f826							;   cols 20-39 -> the mirrored half: source = 39-col
   1328  f826				   RaftCellSolid
   1329  f826		       c9 14		      cmp	#20
   1330  f828		       90 05		      bcc	.RCSrc
   1331  f82a		       49 ff		      eor	#$ff
   1332  f82c		       18		      clc
   1333  f82d		       69 28		      adc	#40
   1334  f82f				   .RCSrc
   1335  f82f		       a8		      tay
   1336  f830		       b9 48 f8 	      lda	RaftCellMasks,Y
   1337  f833		       c0 04		      cpy	#4
   1338  f835		       b0 03		      bcs	.RCPF1
   1339  f837		       25 c5		      and	$C5
   1340  f839		       60		      rts
   1341  f83a				   .RCPF1
   1342  f83a		       c0 0c		      cpy	#12
   1343  f83c		       b0 03		      bcs	.RCPF2
   1344  f83e		       25 c8		      and	$C8
   1345  f840		       60		      rts
   1346  f841				   .RCPF2
   1347  f841		       25 cb		      and	$CB
   1348  f843		       60		      rts
   1349  f844
   1350  f844				   RaftBitTab		; 1 << slot (EnemyBitTable is bank0's ROM, so a
   1351  f844		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; 4-byte copy keeps this body bank-local)
   1352  f848
   1353  f848				   RaftCellMasks		; mask for source column 0..19: PF0 cols 0-3 —
   1354  f848		       10 20 40 80	      .byte.b	$10, $20, $40, $80	; PF0 cols 0-3 (bit 4 = leftmost), then
   1355  f84c		       80 40 20 10	      .byte.b	$80, $40, $20, $10	; PF1 cols 4-11 (bit 7 = leftmost)
   1356  f850		       08 04 02 01	      .byte.b	$08, $04, $02, $01	; PF2 cols 12-19 (bit 0 = leftmost)
   1357  f854		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1358  f858		       10 20 40 80	      .byte.b	$10, $20, $40, $80
   1359  f85c							; ------------------------------------------------------------------------------
   1360  f85c							; CallPad_RaftBody twin — BYTE-IDENTICAL with kernel.asm's copy at $F8C0 (guard:
   1361  f85c							; verify_build.check_raft_tramp). bank0 executes `sta $1FF7` at $F8C0-$F8C2 and
   1362  f85c							; the fetch at $F8C3 comes from THIS bank: `jmp $FDE3` = RaftBody below. Neither
   1363  f85c							; bank runs the other's half — bank0's operand bytes are never fetched, bank1's
   1364  f85c							; `sta $1FF7` is never executed (it is only the swapped-out image's prefix).
   1365  f85c							; In bank1's $F822-$F936 fill, so the $F937 pin does not move.
   1366  f85c							; ------------------------------------------------------------------------------
   1367  f85c		       00 00 00 00*	      .ds	$F8C0 - *, 0
   1368  f8c0		       8d f7 1f 	      .byte.b	$8D, $F7, $1F	; sta $1FF7 (twin)
   1369  f8c3		       4c e3 fd 	      .byte.b	$4C, $E3, $FD	; jmp $FDE3 (twin — fetched post-switch)
   1370  f8c6
   1371  f8c6		       00 00 00 00*	      .ds	$F937 - *, 0	; pinned: bank2 M1StripBlast back-jmp operand
   1372  f937							; ($F937) — test_bomb_strip asserts both literals
   1373  f937							; StripBlastCheck — Phase 4: bomb blast vs the D6 patch strips. Tail-jumped
   1374  f937							; from BombMarkWalls .BMWDone, which now crosses to bank2 FIRST (M1 twin,
   1375  f937							; `sta $1FF8 / jmp $F970` — the meta lives in bank2's ROM) and comes back
   1376  f937							; here (`sta $1FF7 / jmp $F937`). Still 0 pushes (the jsr+pha version
   1377  f937							; measured SP $F7 < the $F8 gameplay guard, and the pha leaked on the
   1378  f937							; early-exit path -> runaway work -> 309-line frames in Stella 2026-10-04).
   1379  f937							; Every exit ends in ReturnPad with A = count.
   1380  f937							; In: BMWScratch = strip left col pL in RIGHT-half space ($FF = none/sym,
   1381  f937							; captured before the punch loop), CollisionEndX/CellX = blast window in
   1382  f937							; LEFT-half space (bomb col mirrored at BMW entry), CollisionX = count.
   1383  f937							; Overlap after mirroring (39-x) with the strip not yet dead → set
   1384  f937							; EnemyDeadMask b3 (ball strip; b4 = M1 strip, set by M1StripBlast) and
   1385  f937							; inc the count (caller's +75 loop scores it). The
   1386  f937							; kill bits die with the room (EnterRoom zeroes EnemyDeadMask) — same
   1387  f937							; lifecycle as WallMask holes (D1-B). P2b door models never
   1388  f937							; reach .SBtake: M1StripBlast (bank2, runs first) stashes BMWScratch :=
   1389  f937							; $FF when MetaB b7 — the take's window test then falls into .SBdone.
   1390  f937							; Key pickup (P5) sets b3/b4 for doors instead (key-only unlock).
   1391  f937							; ------------------------------------------------------------------------------
   1392  f937				   StripBlastCheck
   1393  f937							; --- P2b left strip take (staged by bank2 M1StripBlast) --------------
   1394  f937							; RectCount = 2ℓ left dcol, $FF = none / left door / right bomb.
   1395  f937							; Window is still LEFT-half here (the mirror below). Door models stage
   1396  f937							; $FF both ways (MetaA b3 / MetaB b7) so neither take runs — key (P5)
   1397  f937							; sets b3/b4 instead.
   1398  f937		       a5 92		      lda	RectCount
   1399  f939		       30 1e		      bmi	.SBright	; $FF → no left strip this frame
   1400  f93b		       a5 8c		      lda	CollisionCellX	; blast hi
   1401  f93d		       c5 92		      cmp	RectCount
   1402  f93f		       90 18		      bcc	.SBright	; hi < 2ℓ → strip right of the blast
   1403  f941		       a5 8e		      lda	CollisionEndX	; blast lo (C=1 from the hi cmp)
   1404  f943		       e5 92		      sbc	RectCount	; lo - 2ℓ (borrow ⇒ lo < 2ℓ)
   1405  f945		       90 04		      bcc	.SBleftTake	; blast starts left → overlap
   1406  f947		       c9 02		      cmp	#2
   1407  f949		       b0 0e		      bcs	.SBright	; lo >= 2ℓ+2 → blast ends left of strip
   1408  f94b							;   (A=0/1 falls into take = overlap)
   1409  f94b				   .SBleftTake
   1410  f94b		       a5 ba		      lda	EnemyDeadMask
   1411  f94d		       29 10		      and	#$10
   1412  f94f		       d0 08		      bne	.SBright	; already destroyed → no double score
   1413  f951		       a9 10		      lda	#$10
   1414  f953		       05 ba		      ora	EnemyDeadMask
   1415  f955		       85 ba		      sta	EnemyDeadMask	; b4 = M1 strip destroyed (room-scoped)
   1416  f957		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1417  f959				   .SBright
   1418  f959							; BMW blast cols are LEFT-frame; strip pL is RIGHT-frame → mirror the
   1419  f959							; window here (space is free in this gap): lo_r = 39-hi_l,
   1420  f959							; hi_r = 39-lo_l. Y holds hi_r (no stack push).
   1421  f959		       18		      clc
   1422  f95a		       a5 8e		      lda	CollisionEndX	; lo_l
   1423  f95c		       49 ff		      eor	#$FF
   1424  f95e		       69 28		      adc	#40	; hi_r = 39-lo_l
   1425  f960		       a8		      tay
   1426  f961		       18		      clc
   1427  f962		       a5 8c		      lda	CollisionCellX	; hi_l
   1428  f964		       49 ff		      eor	#$FF
   1429  f966		       69 28		      adc	#40	; lo_r = 39-hi_l
   1430  f968		       85 8e		      sta	CollisionEndX	; EndX := lo_r
   1431  f96a		       84 8c		      sty	CollisionCellX	; CellX := hi_r
   1432  f96c		       a5 8c		      lda	CollisionCellX	; hi
   1433  f96e		       38		      sec
   1434  f96f		       e5 88		      sbc	BMWScratch	; hi - pL
   1435  f971		       90 1d		      bcc	.SBdone	; hi < pL → strip right of the blast
   1436  f973		       a5 8e		      lda	CollisionEndX	; lo
   1437  f975		       c5 88		      cmp	BMWScratch
   1438  f977		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1439  f979		       f0 07		      beq	.SBtake	; lo == pL
   1440  f97b		       38		      sec
   1441  f97c		       e9 01		      sbc	#1
   1442  f97e		       c5 88		      cmp	BMWScratch
   1443  f980		       d0 0e		      bne	.SBdone	; lo >= pL+2 → blast ends left of the strip
   1444  f982				   .SBtake
   1445  f982		       a5 ba		      lda	EnemyDeadMask
   1446  f984		       29 08		      and	#$08
   1447  f986		       d0 08		      bne	.SBdone	; already destroyed → no double score
   1448  f988		       a9 08		      lda	#$08
   1449  f98a		       05 ba		      ora	EnemyDeadMask
   1450  f98c		       85 ba		      sta	EnemyDeadMask	; b3 = strip destroyed (in-room persistent)
   1451  f98e		       e6 8b		      inc	CollisionX	; +1 wall for the caller's score loop
   1452  f990				   .SBdone
   1453  f990		       a5 8b		      lda	CollisionX	; A = walls newly broken (caller contract)
   1454  f992		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (0 push)
