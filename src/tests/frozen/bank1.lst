   2521  feb4		       f0 07		      beq	.RaftCarry	; already spun up
   2522  feb6		       a5 f0		      lda	$F0
   2523  feb8		       18		      clc
   2524  feb9		       69 10		      adc	#%00010000
   2525  febb		       85 f0		      sta	$F0
   2526  febd				   .RaftCarry
   2527  febd		       bd 93 f8 	      lda	RaftBitTab,X
   2528  fec0		       25 c1		      and	EnemyRamD
   2529  fec2		       f0 0a		      beq	.RaftCarryL
   2530  fec4		       a5 80		      lda	RoomX
   2531  fec6		       18		      clc
   2532  fec7		       65 88		      adc	$88
   2533  fec9		       85 80		      sta	RoomX
   2534  fecb		       4c d8 fe 	      jmp	.RaftDone
   2535  fece				   .RaftCarryL
