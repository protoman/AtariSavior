    534  f41f							; ------------------------------------------------------------------------------
    535  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    536  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    537  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    538  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    539  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    540  f41f							; Staging contract (both scratch bytes free in this flow):
    541  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    542  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    543  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    544  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    545  f41f							; ------------------------------------------------------------------------------
    546  f41f				   M1StripBlast
    547  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    548  f421		       c9 14		      cmp	#20
    549  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    550  f425		       a5 ba		      lda	EnemyDeadMask
    551  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    552  f429		       d0 15		      bne	.M1SBnone
    553  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    554  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    555  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    556  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    557  f433		       4a		      lsr
    558  f434		       4a		      lsr
    559  f435		       4a		      lsr
    560  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    561  f437							;   high end — StripBlastCheck rejects)
    562  f437		       38		      sec
    563  f438		       e9 01		      sbc	#1	; ℓ = left_col
    564  f43a		       0a		      asl		; 2ℓ = strip left dcol
    565  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    566  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    567  f440				   .M1SBnone
