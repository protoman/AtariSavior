   2420  fe2b							; --- pin FIRST: the rider stays on the raft even on a TURN frame --------
   2421  fe2b							; A raft boxed in by solid row-2 cells (or parked against a rail) turns
   2422  fe2b							; every frame and never moves; the turn path returns before the carry, so
   2423  fe2b							; pinning here is what keeps a rider standing on it. Without it he fell
   2424  fe2b							; through a stuck raft into the water kill line and respawned forever
   2425  fe2b							; (user report 2026-10-22: "player position keeps changing, zig-zags").
   2426  fe2b							; The vyHi < 0 escape is the gate's `.RaftNoRide` (rising is not a ride).
   2427  fe2b		       b5 e2		      lda	EnemyRamY,X
   2428  fe2d		       38		      sec
   2429  fe2e		       e9 16		      sbc	#RAFTER_PINFIT
   2430  fe30		       85 81		      sta	RoomY	; feet on the raft's top
   2431  fe32		       a9 00		      lda	#0
   2432  fe34		       85 93		      sta	vyLo
   2433  fe36		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2434  fe38							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2435  fe38							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2436  fe38							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2437  fe38							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2438  fe38							; it cannot borrow upward either (see the kernel EQU for the contract).
   2439  fe38							; Riding advances the level every 2nd frame: the raft leaves at 0.5 px/frame
   2440  fe38							; and reaches the full 0.75 px/frame after ~30 frames (~0.5 s), the
   2441  fe38							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2442  fe38		       a5 f0		      lda	$F0
   2443  fe3a		       10 0b		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2444  fe3c		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2445  fe3e		       f0 07		      beq	.RaftAtSpeed
   2446  fe40		       a5 c2		      lda	EnemyRamP
   2447  fe42		       29 01		      and	#1	; still ramping: 1 px on odd frames = 0.5 px/frame
   2448  fe44		       4c 51 fe 	      jmp	.RaftHaveStep
   2449  fe47				   .RaftAtSpeed
   2450  fe47		       a5 c2		      lda	EnemyRamP
   2451  fe49		       29 03		      and	#3
   2452  fe4b		       c9 01		      cmp	#1	; C = (P&3) != 0
   2453  fe4d		       a9 00		      lda	#0
   2454  fe4f		       69 00		      adc	#0	; 1 px on 3 of 4 frames = 0.75 px/frame (user 2026-11-10:
   2455  fe51							; the raft was too quick to leave: HALF of 1.5)
   2456  fe51				   .RaftHaveStep
   2457  fe51		       85 88		      sta	$88	; bank0 Temp = this frame's step
   2458  fe53		       bd 93 f8 	      lda	RaftBitTab,X
   2459  fe56		       25 c1		      and	EnemyRamD
   2460  fe58		       f0 29		      beq	.RaftLeft
   2461  fe5a							; ---- leading edge right: candidate = x + step ---------------------------
   2462  fe5a		       b5 bd		      lda	EnemyRamX,X
   2463  fe5c		       18		      clc
   2464  fe5d		       65 88		      adc	$88
   2465  fe5f		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2466  fe61		       c9 94		      cmp	#RAFT_MAX_X
   2467  fe63		       b0 14		      bcs	.RaftTurn	; right rail
   2468  fe65		       18		      clc
   2469  fe66		       69 01		      adc	#1	; the cell just beyond the right edge
   2470  fe68		       4a		      lsr
   2471  fe69		       4a		      lsr
   2472  fe6a		       20 75 f8 	      jsr	RaftCellSolid
   2473  fe6d		       d0 0a		      bne	.RaftTurn	; solid ahead (ledge / room edge) -> turn
   2474  fe6f		       b5 bd		      lda	EnemyRamX,X
   2475  fe71		       18		      clc
   2476  fe72		       65 88		      adc	$88
   2477  fe74		       95 bd		      sta	EnemyRamX,X
   2478  fe76		       4c a3 fe 	      jmp	.RaftRide
   2479  fe79							; ---- turn-around (kept here: both arms branch to it, and the ramp pushed
   2480  fe79							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2481  fe79				   .RaftTurn
   2482  fe79		       bd 93 f8 	      lda	RaftBitTab,X
   2483  fe7c		       45 c1		      eor	EnemyRamD
   2484  fe7e		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2485  fe80							; bank1's RoomDarkMask — must be preserved)
   2486  fe80		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2487  fe83							; ---- leading edge left --------------------------------------------------
   2488  fe83				   .RaftLeft
   2489  fe83		       b5 bd		      lda	EnemyRamX,X
   2490  fe85		       38		      sec
   2491  fe86		       e5 88		      sbc	$88
   2492  fe88		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2493  fe8a		       c9 08		      cmp	#RAFT_MIN_X
   2494  fe8c		       90 eb		      bcc	.RaftTurn	; left rail
   2495  fe8e		       38		      sec
   2496  fe8f		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2497  fe91		       b0 02		      bcs	.RaftLeftCol
   2498  fe93		       a9 00		      lda	#0
   2499  fe95				   .RaftLeftCol
   2500  fe95		       4a		      lsr
   2501  fe96		       4a		      lsr
   2502  fe97		       20 75 f8 	      jsr	RaftCellSolid
   2503  fe9a		       d0 dd		      bne	.RaftTurn
   2504  fe9c		       b5 bd		      lda	EnemyRamX,X
   2505  fe9e		       38		      sec
   2506  fe9f		       e5 88		      sbc	$88
   2507  fea1		       95 bd		      sta	EnemyRamX,X
