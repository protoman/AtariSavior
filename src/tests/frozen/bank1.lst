   2052  fc78							; ========================================================================
   2053  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   2054  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   2055  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   2056  fc78							; check_callpads asserts they equal these labels.
   2057  fc78							; ------------------------------------------------------------------------
   2058  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2059  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2060  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2061  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2062  fc78							; survives the cross-bank return.
   2063  fc78				   IsRoomDark
   2064  fc78		       a5 98		      lda	RoomNo
   2065  fc7a		       c9 04		      cmp	#4
   2066  fc7c		       b0 0c		      bcs	.IRDhi
   2067  fc7e		       18		      clc
   2068  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2069  fc81		       aa		      tax
   2070  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2071  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2072  fc87		       4c f8 fb 	      jmp	ReturnPad
   2073  fc8a				   .IRDhi
   2074  fc8a		       c9 08		      cmp	#8
   2075  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2076  fc8e		       aa		      tax
   2077  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2078  fc92		       4a		      lsr
   2079  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2080  fc94		       25 c0		      and	LaserState
   2081  fc96		       4c f8 fb 	      jmp	ReturnPad
   2082  fc99				   .IRDlit
   2083  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2084  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2085  fc9e
   2086  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2087  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2088  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2089  fc9e				   SetRoomDark
   2090  fc9e		       a5 98		      lda	RoomNo
   2091  fca0		       c9 04		      cmp	#4
   2092  fca2		       b0 0e		      bcs	.SRDhi
   2093  fca4		       18		      clc
   2094  fca5		       69 04		      adc	#4
   2095  fca7		       aa		      tax
   2096  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2097  fcab		       05 c1		      ora	EnemyRamD
   2098  fcad		       85 c1		      sta	EnemyRamD
   2099  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2100  fcb2				   .SRDhi
   2101  fcb2		       c9 08		      cmp	#8
   2102  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2103  fcb6		       aa		      tax
   2104  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2105  fcba		       4a		      lsr
   2106  fcbb		       4a		      lsr
   2107  fcbc		       05 c0		      ora	LaserState
   2108  fcbe		       85 c0		      sta	LaserState
   2109  fcc0				   .SRDdone
   2110  fcc0		       4c f8 fb 	      jmp	ReturnPad
