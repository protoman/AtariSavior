   2416  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2417  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2418  fe0f		       a5 81		      lda	RoomY
   2419  fe11		       38		      sec
   2420  fe12		       f5 e2		      sbc	EnemyRamY,X
   2421  fe14		       18		      clc
