   1242  f776							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1243  f776							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1244  f776							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
