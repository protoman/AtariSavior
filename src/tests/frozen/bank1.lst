   1788  faa6		       85 17		      sta	AUDF0
   1789  faa8		       a9 02		      lda	#LASER_AUD_C
   1790  faaa		       85 15		      sta	AUDC0
   1791  faac		       a9 09		      lda	#LASER_AUD_V
   1792  faae		       85 19		      sta	AUDV0
   1793  fab0				   .ULSOut
