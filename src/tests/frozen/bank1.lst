   1210  f7d0		       85 1c		      sta	GRP1
   1211  f7d2		       85 04		      sta	NUSIZ0
   1212  f7d4		       85 05		      sta	NUSIZ1
   1213  f7d6		       85 25		      sta	VDELP0
   1214  f7d8		       85 26		      sta	VDELP1
