   2636  ff5e		       0a		      asl
   2637  ff5f		       0a		      asl
   2638  ff60		       85 e2		      sta	scorePtr2
   2639  ff62		       a5 f4		      lda	ScoreHu
   2640  ff64		       29 f0		      and	#$F0
   2641  ff66		       4a		      lsr
   2642  ff67		       85 e4		      sta	scorePtr3
   2643  ff69		       a5 f4		      lda	ScoreHu
   2644  ff6b		       29 0f		      and	#$0F
   2645  ff6d		       0a		      asl
   2646  ff6e		       0a		      asl
   2647  ff6f		       0a		      asl
   2648  ff70		       85 e6		      sta	scorePtr4
   2649  ff72		       a5 f5		      lda	ScoreTe
