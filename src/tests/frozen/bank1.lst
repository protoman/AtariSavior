   1526  f973		       a5 8e		      lda	CollisionEndX	; lo
   1527  f975		       c5 88		      cmp	BMWScratch
   1528  f977		       90 09		      bcc	.SBtake	; lo < pL (blast reaches right, hi >= pL)
   1529  f979		       f0 07		      beq	.SBtake	; lo == pL
