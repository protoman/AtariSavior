   1705  fa73		       ea		      nop		; byte-pin
   1706  fa74		       48		      pha		; save wrapped ScoreTe
   1707  fa75		       e6 f4		      inc	ScoreHu
   1708  fa77		       a5 f4		      lda	ScoreHu
   1709  fa79		       c9 0a		      cmp	#10
   1710  fa7b		       90 10		      bcc	.AShuOk
   1711  fa7d		       a9 00		      lda	#0
   1712  fa7f		       85 f4		      sta	ScoreHu
   1713  fa81		       e6 f3		      inc	ScoreTh
   1714  fa83		       a5 f3		      lda	ScoreTh
   1715  fa85		       c9 0a		      cmp	#10
