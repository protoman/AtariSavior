    590  f560							; ZP variables for score rendering (48-pixel sprite technique)
    591  f560		       00 e0	   scorePtr1  =	$E0	; pointer to digit 1 font data (hundred-thousands)
    592  f560		       00 e2	   scorePtr2  =	$E2	; pointer to digit 2 font data (ten-thousands)
    593  f560		       00 e4	   scorePtr3  =	$E4	; pointer to digit 3 font data (thousands)
    594  f560		       00 e6	   scorePtr4  =	$E6	; pointer to digit 4 font data (hundreds)
    595  f560		       00 e8	   scorePtr5  =	$E8	; pointer to digit 5 font data (tens)
    596  f560		       00 ea	   scorePtr6  =	$EA	; pointer to digit 6 font data (ones)
    597  f560		       00 ec	   scbrdCnt   =	$EC	; score render loop counter (7..0)
    598  f560		       00 ed	   scbrdTmp   =	$ED	; mid-scanline temp cache
    599  f560		       00 ee	   DelayCnt   =	$EE	; bar delay A preloaded once per frame (bank1; ColupfBuf+7)
    600  f560		       00 ef	   FineCnt    =	$EF	; bar fine delay cycles 0/2/3/4 (H3; bank1 only)
    601  f560		       00 ad	   Temp       =	$AD	; scratch variable
    602  f560							; Score digits live at $F3-$F6 — MUST match bank0 Score* EQUs.
    603  f560							; Old home $BF-$C2 collided with EnemyRamX[2]/[3]/D/P during game HUD.
    604  f560		       00 f3	   ScoreTh    =	$F3	; score thousands digit (must match bank0)
    605  f560		       00 f4	   ScoreHu    =	$F4	; score hundreds digit
    606  f560		       00 f5	   ScoreTe    =	$F5	; score tens+ones packed BCD
    607  f560		       00 a3	   Level      =	$A3	; #18 current level, 0-based (must match kernel)
    608  f560		       00 f2	   LevelShowTimer =	$F2	; #18 LV001 banner frames left (kernel sets, bank1 decs;
    609  f560							;  ALIAS of TallyTicks — banner = gameplay entry only,
    610  f560							;  tally = level-exit bonus; LoadLevel gates on $FD)
    611  f560							; $F6 is NOT ScoreOn — bank0 uses it as BombX. Do not write $F6 here.
    612  f560
    613  f560							; --- TIA/RIOT + ZP mirrors for relocated leaf routines (leaf_move_plan) ---
    614  f560							;     MUST match kernel.asm decls (hardware-fixed or frozen ZP addresses).
    615  f560		       00 15	   AUDC0      =	$15
    616  f560		       00 16	   AUDC1      =	$16
    617  f560		       00 17	   AUDF0      =	$17
    618  f560		       00 18	   AUDF1      =	$18
