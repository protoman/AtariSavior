   2350  fde3							; ========================================================================
   2351  fde3							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2352  fde3							; ========================================================================
   2353  fde3					      .ds	$FDE3 - *, 0
   2354  fde3		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2355  fde3		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2356  fde3							; rails keep it inside the room
   2357  fde3		       00 83	   RAFTER_BASE =	131	; raft top when the tide is at 0: the 2-row
   2358  fde3							; surface (line 132) - 7, so its BOTTOM row
   2359  fde3							; sits exactly ON the surface. The live value is
   2360  fde3							; plank's BOTTOM row (top+1) lands on the water
   2361  fde3							; surface (132+off) — see the tide block below;
   2362  fde3							; never hard-code the Y: the surface MOVES.
   2363  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2364  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2365  fde3		       00 1c	   RAFTER_YSPAN =	28	; PLAYER_SPRITE_H+6: riding when the feet are
   2366  fde3							; from 22 px above the raft's top to 5 px into it
   2367  fde3		       00 16	   RAFTER_PINFIT =	22	; PLAYER_SPRITE_H: pin = raft top - this
   2368  fde3
   2369  fde3				   RaftBody
   2370  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2371  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2372  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2373  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2374  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
   2375  fde3							; This mirrors the VBL's
   2376  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2377  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2378  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2379  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2380  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2381  fde3		       a5 c2		      lda	EnemyRamP
   2382  fde5		       29 f0		      and	#$F0
   2383  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2384  fde9		       4a		      lsr
   2385  fdea		       4a		      lsr
   2386  fdeb		       4a		      lsr
   2387  fdec		       4a		      lsr		; A = p (1..15)
   2388  fded		       c9 08		      cmp	#8
   2389  fdef		       90 04		      bcc	.RaftTideTri
