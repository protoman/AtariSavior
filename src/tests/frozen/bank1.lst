   2425  fe1b		       a5 94		      lda	vyHi
   2426  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2427  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2428  fe22				   .RaftNoRide
   2429  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2430  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2431  fe22		       a5 f0		      lda	$F0
