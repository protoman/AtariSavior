   2076  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2077  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2078  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2079  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2080  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2081  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2082  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2083  fd68				   SetupScorePointers
   2084  fd68							; --- Initialize score to 0 on first frame ---
   2085  fd68		       a5 ad		      lda	Temp
   2086  fd6a		       d0 0c		      bne	.scoreInitDone
   2087  fd6c		       e6 ad		      inc	Temp
   2088  fd6e		       a9 00		      lda	#0
   2089  fd70		       85 f3		      sta	ScoreTh
   2090  fd72		       85 f4		      sta	ScoreHu
   2091  fd74		       a9 00		      lda	#$00
   2092  fd76		       85 f5		      sta	ScoreTe
   2093  fd78				   .scoreInitDone
