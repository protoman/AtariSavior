   2055  fbce							; masked byte). Clobbers A/Y, preserves X. Same-bank jsr (no pad nesting);
   2056  fbce							; caller keeps its loop vars in ZP, so X/Y loss is invisible.
   2057  fbce				   BMWCellSolid
   2058  fbce		       18		      clc
   2059  fbcf		       7d 10 f0 	      adc	ColOff,X
   2060  fbd2		       a8		      tay
   2061  fbd3		       b9 c3 00 	      lda	PF0Buf,Y
   2062  fbd6		       3d 24 f0 	      and	ColMask,X
   2063  fbd9		       60		      rts
