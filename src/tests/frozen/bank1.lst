   2335  fd68							; CallPad_MothYDerive twin — byte-identical with kernel.asm at $FEE7
   2336  fd68							; ========================================================================
   2337  fd68		       00 00 00 00*	      .ds	$FDE3 - *, 0
   2338  fd68		       00 08	   RAFT_MIN_X =	8	; the raft's logical X is its lit span's right
   2339  fd68		       00 94	   RAFT_MAX_X =	148	; end, exactly like the player's [x-7,x]; these
   2340  fde3							; rails keep it inside the room
   2341  fde3		       00 83	   RAFTER_BASE =	131	; raft top when the tide is at 0: the 2-row
   2342  fde3							; surface (line 132) - 7, so its BOTTOM row
   2343  fde3							; sits exactly ON the surface. The live value is
   2344  fde3							; plank's BOTTOM row (top+1) lands on the water
   2345  fde3							; surface (132+off) — see the tide block below;
   2346  fde3							; never hard-code the Y: the surface MOVES.
   2347  fde3		       00 06	   RAFTER_XOFF =	6	; PLAYER_WIDTH-1: spawn x of the body span
   2348  fde3		       00 0e	   RAFTER_XSPAN =	14	; PLAYER_WIDTH+ENEMY_WIDTH-1: no-overlap gate
   2349  fde3		       00 1c	   RAFTER_YSPAN =	28	; PLAYER_SPRITE_H+6: riding when the feet are
   2350  fde3							; from 22 px above the raft's top to 5 px into it
   2351  fde3		       00 16	   RAFTER_PINFIT =	22	; PLAYER_SPRITE_H: pin = raft top - this
   2352  fde3
   2353  fde3				   RaftBody
   2354  fde3							; --- float ON the water surface, riding the TIDE ------------------------
   2355  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
   2356  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
   2357  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
   2358  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
   2359  fde3							; This mirrors the VBL's
   2360  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
   2361  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
   2362  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
   2363  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
   2364  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
   2365  fde3		       a5 c2		      lda	EnemyRamP
   2366  fde5		       29 f0		      and	#$F0
   2367  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
   2368  fde9		       4a		      lsr
   2369  fdea		       4a		      lsr
   2370  fdeb		       4a		      lsr
   2371  fdec		       4a		      lsr		; A = p (1..15)
   2372  fded		       c9 08		      cmp	#8
   2373  fdef		       90 04		      bcc	.RaftTideTri
   2374  fdf1		       a9 00		      lda	#0	; rest phase p8-15
   2375  fdf3		       f0 09		      beq	.RaftTide	; always
   2376  fdf5				   .RaftTideTri
   2377  fdf5		       c9 04		      cmp	#4
   2378  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
   2379  fdf9		       49 ff		      eor	#$FF
   2380  fdfb		       38		      sec
   2381  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
   2382  fdfe				   .RaftTide
   2383  fdfe		       18		      clc
   2384  fdff		       69 83		      adc	#RAFTER_BASE	; + 131 -> the surface line (132+off) minus 1
   2385  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
   2386  fe03							; water line is what the raft floats on
   2387  fe03
   2388  fe03							; --- does the player count as "over the raft"? --------------------------
   2389  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
   2390  fe03							; it, parks the moment he steps off, and its position resets on room entry
   2391  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
   2392  fe03							; block here is what makes it park; the pin/carry later still applies while
   2393  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
   2394  fe03							; raft he is actually standing on.
   2395  fe03		       a5 80		      lda	RoomX
   2396  fe05		       38		      sec
   2397  fe06		       f5 bd		      sbc	EnemyRamX,X
   2398  fe08		       18		      clc
   2399  fe09		       69 06		      adc	#RAFTER_XOFF
   2400  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
   2401  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
   2402  fe0f		       a5 81		      lda	RoomY
   2403  fe11		       38		      sec
   2404  fe12		       f5 e2		      sbc	EnemyRamY,X
   2405  fe14		       18		      clc
   2406  fe15		       69 16		      adc	#RAFTER_PINFIT
   2407  fe17		       c9 1c		      cmp	#RAFTER_YSPAN
   2408  fe19		       b0 07		      bcs	.RaftNoRide	; not in the raft's upper rows
   2409  fe1b		       a5 94		      lda	vyHi
   2410  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
   2411  fe1f		       4c 2b fe 	      jmp	.RaftGo
   2412  fe22				   .RaftNoRide
   2413  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
   2414  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
   2415  fe22		       a5 f0		      lda	$F0
