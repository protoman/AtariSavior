   2224  fd7c		       85 e3		      sta	scorePtr2+1
   2225  fd7e		       85 e5		      sta	scorePtr3+1
   2226  fd80		       85 e7		      sta	scorePtr4+1
   2227  fd82		       85 e9		      sta	scorePtr5+1
   2228  fd84		       85 eb		      sta	scorePtr6+1
   2229  fd86
   2230  fd86		       a5 f2		      lda	LevelShowTimer
   2231  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2232  fd8a		       f0 2e		      beq	.scoreLows
   2233  fd8c		       c6 f2		      dec	LevelShowTimer
   2234  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2235  fd90		       85 e0		      sta	scorePtr1
   2236  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2237  fd94		       85 e2		      sta	scorePtr2
   2238  fd96		       a9 00		      lda	#0	; hundreds '0'
   2239  fd98		       85 e4		      sta	scorePtr3
   2240  fd9a		       a5 a3		      lda	Level
   2241  fd9c		       18		      clc
   2242  fd9d		       69 01		      adc	#1	; 1-based level number
   2243  fd9f		       a2 00		      ldx	#0
   2244  fda1				   .LVTens
   2245  fda1		       c9 0a		      cmp	#10
   2246  fda3		       90 05		      bcc	.LVTensDone
   2247  fda5		       e9 0a		      sbc	#10
   2248  fda7		       e8		      inx
   2249  fda8		       d0 f7		      bne	.LVTens
   2250  fdaa				   .LVTensDone
   2251  fdaa		       0a		      asl
   2252  fdab		       0a		      asl
   2253  fdac		       0a		      asl		; ones * 8
   2254  fdad		       85 e8		      sta	scorePtr5
   2255  fdaf		       8a		      txa
   2256  fdb0		       0a		      asl
   2257  fdb1		       0a		      asl
   2258  fdb2		       0a		      asl		; tens * 8
