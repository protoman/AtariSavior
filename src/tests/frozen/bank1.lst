   1230  f7d0		       a9 00		      lda	#0
   1231  f7d2		       85 1b		      sta	GRP0
   1232  f7d4		       85 1c		      sta	GRP1
   1233  f7d6		       85 04		      sta	NUSIZ0
   1234  f7d8		       85 05		      sta	NUSIZ1
   1235  f7da		       85 25		      sta	VDELP0
