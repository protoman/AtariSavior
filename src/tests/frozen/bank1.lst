   2233  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2234  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2235  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2236  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2237  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2238  fd68							; once per banner frame. Lives with the glyphs (bank1's pre-pad region is
   2239  fd68							; tight; the score section is a jsr here from MenuMain).
   2240  fd68				   SetupScorePointers
   2241  fd68							; --- Initialize score to 0 on first frame ---
   2242  fd68		       a5 ad		      lda	Temp
   2243  fd6a		       d0 0c		      bne	.scoreInitDone
   2244  fd6c		       e6 ad		      inc	Temp
   2245  fd6e		       a9 00		      lda	#0
   2246  fd70		       85 f3		      sta	ScoreTh
   2247  fd72		       85 f4		      sta	ScoreHu
   2248  fd74		       a9 00		      lda	#$00
   2249  fd76		       85 f5		      sta	ScoreTe
   2250  fd78				   .scoreInitDone
   2251  fd78
   2252  fd78							; --- Set up 6 digit pointers ---
   2253  fd78							; High bytes first (all $FD)
   2254  fd78		       a9 fd		      lda	#>DigitGfx
   2255  fd7a		       85 e1		      sta	scorePtr1+1
   2256  fd7c		       85 e3		      sta	scorePtr2+1
   2257  fd7e		       85 e5		      sta	scorePtr3+1
   2258  fd80		       85 e7		      sta	scorePtr4+1
   2259  fd82		       85 e9		      sta	scorePtr5+1
   2260  fd84		       85 eb		      sta	scorePtr6+1
   2261  fd86
   2262  fd86		       a5 f2		      lda	LevelShowTimer
   2263  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2264  fd8a		       f0 2e		      beq	.scoreLows
   2265  fd8c		       c6 f2		      dec	LevelShowTimer
   2266  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2267  fd90		       85 e0		      sta	scorePtr1
   2268  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2269  fd94		       85 e2		      sta	scorePtr2
   2270  fd96		       a9 00		      lda	#0	; hundreds '0'
   2271  fd98		       85 e4		      sta	scorePtr3
   2272  fd9a		       a5 a3		      lda	Level
   2273  fd9c		       18		      clc
   2274  fd9d		       69 01		      adc	#1	; 1-based level number
   2275  fd9f		       a2 00		      ldx	#0
   2276  fda1				   .LVTens
   2277  fda1		       c9 0a		      cmp	#10
   2278  fda3		       90 05		      bcc	.LVTensDone
   2279  fda5		       e9 0a		      sbc	#10
   2280  fda7		       e8		      inx
   2281  fda8		       d0 f7		      bne	.LVTens
   2282  fdaa				   .LVTensDone
   2283  fdaa		       0a		      asl
   2284  fdab		       0a		      asl
   2285  fdac		       0a		      asl		; ones * 8
   2286  fdad		       85 e8		      sta	scorePtr5
   2287  fdaf		       8a		      txa
   2288  fdb0		       0a		      asl
   2289  fdb1		       0a		      asl
   2290  fdb2		       0a		      asl		; tens * 8
   2291  fdb3		       85 e6		      sta	scorePtr4
   2292  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2293  fdb7		       85 ea		      sta	scorePtr6
   2294  fdb9		       60		      rts
   2295  fdba
   2296  fdba							; scorePtr1..2 = leading zeros
   2297  fdba				   .scoreLows
   2298  fdba		       a9 00		      lda	#0
   2299  fdbc		       85 e0		      sta	scorePtr1
   2300  fdbe		       85 e2		      sta	scorePtr2
   2301  fdc0
   2302  fdc0							; scorePtr3 = ScoreTh * 8
   2303  fdc0		       a5 f3		      lda	ScoreTh
   2304  fdc2		       0a		      asl
   2305  fdc3		       0a		      asl
   2306  fdc4		       0a		      asl
   2307  fdc5		       85 e4		      sta	scorePtr3
   2308  fdc7
   2309  fdc7							; scorePtr4 = ScoreHu * 8
