   1251  f7ee							; ====================================================================
   1252  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1253  f7ee							; Path A (PlayerLives > 0) — execution count:
   1254  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1255  f7ee							;   Timer:    3 loop + 1 gap = 4
   1256  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1257  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1258  f7ee							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1259  f7ee							;   Subtotal: 6+4+8+11+10 = 39
   1260  f7ee							;   Pad:      48 - 39 = 9
   1261  f7ee							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1262  f7ee							; ====================================================================
   1263  f7ee		       a2 09		      ldx	#9
   1264  f7f0				   .HudPad
   1265  f7f0		       85 02		      sta	WSYNC
   1266  f7f2		       ca		      dex
   1267  f7f3		       d0 fb		      bne	.HudPad
   1268  f7f5
   1269  f7f5							; --- Return to bank0 via fold-pad ---
   1270  f7f5		       4c 70 fc 	      jmp	$FC70
