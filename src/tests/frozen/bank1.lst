   2005  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2006  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2007  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2008  fc78							; survives the cross-bank return.
   2009  fc78				   IsRoomDark
   2010  fc78		       a5 98		      lda	RoomNo
   2011  fc7a		       c9 04		      cmp	#4
   2012  fc7c		       b0 0c		      bcs	.IRDhi
   2013  fc7e		       18		      clc
   2014  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2015  fc81		       aa		      tax
   2016  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2017  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2018  fc87		       4c f8 fb 	      jmp	ReturnPad
   2019  fc8a				   .IRDhi
   2020  fc8a		       c9 08		      cmp	#8
   2021  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2022  fc8e		       aa		      tax
   2023  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2024  fc92		       4a		      lsr
   2025  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2026  fc94		       25 c0		      and	LaserState
   2027  fc96		       4c f8 fb 	      jmp	ReturnPad
   2028  fc99				   .IRDlit
   2029  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2030  fc9b		       4c f8 fb 	      jmp	ReturnPad
