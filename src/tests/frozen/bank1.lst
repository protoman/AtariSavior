   2421  fe2b							; --- pin FIRST: the rider stays on the raft even on a TURN frame --------
   2422  fe2b							; A raft boxed in by solid row-2 cells (or parked against a rail) turns
   2423  fe2b							; every frame and never moves; the turn path returns before the carry, so
   2424  fe2b							; pinning here is what keeps a rider standing on it. Without it he fell
   2425  fe2b							; through a stuck raft into the water kill line and respawned forever
   2426  fe2b							; (user report 2026-10-22: "player position keeps changing, zig-zags").
   2427  fe2b							; The vyHi < 0 escape is the gate's `.RaftNoRide` (rising is not a ride).
   2428  fe2b		       b5 e2		      lda	EnemyRamY,X
   2429  fe2d		       38		      sec
   2430  fe2e		       e9 16		      sbc	#RAFTER_PINFIT
   2431  fe30		       85 81		      sta	RoomY	; feet on the raft's top
   2432  fe32		       a9 00		      lda	#0
   2433  fe34		       85 93		      sta	vyLo
   2434  fe36		       85 94		      sta	vyHi	; landing kills the accumulated fall speed
   2435  fe38							; --- take-off ramp (inertia): heaviest right after boarding -------------
   2436  fe38							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
   2437  fe38							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
   2438  fe38							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
   2439  fe38							; it cannot borrow upward either (see the kernel EQU for the contract).
   2440  fe38							; Riding advances the level every 2nd frame: the raft leaves at 1 px/frame
   2441  fe38							; and reaches the full 1/2 parity (1.5 avg) after ~30 frames (~0.5 s), the
   2442  fe38							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
   2443  fe38		       a5 f0		      lda	$F0
   2444  fe3a		       10 08		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
   2445  fe3c		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
   2446  fe3e		       f0 04		      beq	.RaftAtSpeed
   2447  fe40		       a9 01		      lda	#1	; still ramping: 1 px/frame
   2448  fe42		       d0 07		      bne	.RaftHaveStep	; always
   2449  fe44				   .RaftAtSpeed
   2450  fe44		       a5 c2		      lda	EnemyRamP
