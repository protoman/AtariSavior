   2414  fe49		       18		      clc
   2415  fe4a		       65 88		      adc	$88
   2416  fe4c		       b0 18		      bcs	.RaftTurn	; wrapped past 255
   2417  fe4e		       c9 94		      cmp	#RAFT_MAX_X
   2418  fe50		       b0 14		      bcs	.RaftTurn	; right rail
