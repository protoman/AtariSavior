   1690  fb2e							; blast lo = max(col-2, 0)   (±2: player is 8px wide, so a bomb dropped
   1691  fb2e							; blast hi = min(col+2, 19)	flush-left sits 2 cols from the wall)
   1692  fb2e		       a5 88		      lda	BMWScratch
