   1385  f842							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1386  f842							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1387  f842							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1388  f842							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1389  f842							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1390  f842							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1391  f842				   BarDelayTable		; (B+7)>>3, 15 entries
   1392  f842		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1393  f851				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1394  f851		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
