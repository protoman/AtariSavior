    607  f41f							; ------------------------------------------------------------------------------
    608  f41f							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    609  f41f							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    610  f41f							; BMWScratch), so it runs here and the old two-hop pad chain
    611  f41f							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    612  f41f							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    613  f41f							; Staging contract (both scratch bytes free in this flow):
    614  f41f							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    615  f41f							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    616  f41f							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    617  f41f							;   sets b3/b4 for doors instead (comment hook at the takes).
    618  f41f							; ------------------------------------------------------------------------------
    619  f41f				   M1StripBlast
    620  f41f		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    621  f421		       c9 14		      cmp	#20
    622  f423		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    623  f425		       a5 ba		      lda	EnemyDeadMask
    624  f427		       29 10		      and	#$10	; b4 already set → nothing to stage
    625  f429		       d0 15		      bne	.M1SBnone
    626  f42b		       a5 99		      lda	RoomMetaA	; MetaA
    627  f42d		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    628  f42f		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    629  f431		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    630  f433		       4a		      lsr
    631  f434		       4a		      lsr
    632  f435		       4a		      lsr
    633  f436		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    634  f437							;   high end — StripBlastCheck rejects)
    635  f437		       38		      sec
    636  f438		       e9 01		      sbc	#1	; ℓ = left_col
    637  f43a		       0a		      asl		; 2ℓ = strip left dcol
    638  f43b		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    639  f43d		       4c 44 f4 	      jmp	.M1SBdoorR
    640  f440				   .M1SBnone
    641  f440		       a9 ff		      lda	#$FF
    642  f442		       85 92		      sta	RectCount	; no left strip this frame
    643  f444				   .M1SBdoorR
    644  f444		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
    645  f446		       10 04		      bpl	.M1SBout
    646  f448		       a0 ff		      ldy	#$FF
    647  f44a		       84 88		      sty	BMWScratch	; $88 = StripBlastCheck's "no strip"
    648  f44c				   .M1SBout
    649  f44c		       4c c6 f8 	      jmp	StripBlastCheck	; same bank now (was the $F9B2 pad)
    650  f44f
    651  f44f							; ------------------------------------------------------------------------------
    652  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    653  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    654  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    655  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    656  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    657  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    658  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    659  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    660  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    661  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    662  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    663  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    664  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    665  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    666  f44f							; ------------------------------------------------------------------------------
    667  f44f				   TallyEntry
    668  f44f		       a5 8a		      lda	DropTarget
    669  f451		       f0 36		      beq	.TEArm
    670  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    671  f455		       d0 2d		      bne	.TEIdle
    672  f457		       a9 04		      lda	#4
    673  f459		       85 ad		      sta	TickCounter
    674  f45b		       c6 f2		      dec	TallyTicks
    675  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    676  f45f		       a5 f2		      lda	TallyTicks
    677  f461		       29 03		      and	#3
    678  f463		       d0 15		      bne	.TEOne	; tick only
    679  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    680  f467		       85 f1		      sta	BombSnd
    681  f469		       a9 04		      lda	#4
    682  f46b		       85 15		      sta	AUDC0	; square
    683  f46d		       a9 18		      lda	#24
    684  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    685  f471		       a9 08		      lda	#8
    686  f473		       85 19		      sta	AUDV0
    687  f475		       a9 03		      lda	#3	; tick + coin
    688  f477		       4c f8 fb 	      jmp	ReturnPad
    689  f47a				   .TEOne
    690  f47a		       a9 01		      lda	#1	; tick only
    691  f47c		       4c f8 fb 	      jmp	ReturnPad
    692  f47f				   .TEFinal
    693  f47f		       a9 07		      lda	#7	; tick + coin + done
    694  f481		       4c f8 fb 	      jmp	ReturnPad
    695  f484				   .TEIdle
    696  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    697  f486		       4c f8 fb 	      jmp	ReturnPad
    698  f489				   .TEArm
    699  f489		       a5 ae		      lda	BarLevel
    700  f48b		       18		      clc
    701  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    702  f48e		       a2 00		      ldx	#0
    703  f490				   .TEDiv
    704  f490		       c9 06		      cmp	#6
    705  f492		       90 06		      bcc	.TEDivSum
    706  f494		       38		      sec
    707  f495		       e9 06		      sbc	#6
