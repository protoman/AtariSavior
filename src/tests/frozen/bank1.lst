    152  f071		       00 00 00 00*	      .ds	$F080 - *, 0	; TitleBand pin (CallPad_TitleBand literal)
    153  f080							; ==============================================================================
    154  f080							; TitleBand — merged title, bands 1-2 (2026-10-19 refactor).
    155  f080							; Band 0 is drawn by the CAVE kernel (stage PF + COLUPF from the room buffers,
    156  f080							; player via PlayerColTable/Grp0Ptr), so the title reuses the real kernel
    157  f080							; instead of duplicating its band rendering. The bank0 row-advance tail
    158  f080							; diverts here when DropTarget=$FF, exactly where band 1 would start.
    159  f080							; This routine: band 1 stage row + the 48px S.A.V.I.O.R. logo + the credit
    160  f080							; footer, then band 2's stage row + 48 lines, then the HUD band (score =
    161  f080							; level+1, lives/bombs/bar via MenuMain). No object is drawn on the title:
    162  f080							; DropArm .DATitle clears EnemyCount/LevelMinerRoom and the laser on every
    163  f080							; title LoadLevel, so SelectActiveObject parks GRP1.
    164  f080							; Entered via CallPad_TitleBand ($FC55). ZP: LineCount ($84) + Temp ($88) as
    165  f080							; loop counter/tmp — idle on title frames (cave overscan bypassed).
    166  f080							; ==============================================================================
    167  f080				   TitleBand
    168  f080							; ==================================================================
    169  f080							; Band 1 (48 lines): stage middle row + logo + credit footer.
    170  f080							; Same store order as the cave .Row (PF0, PF1, COLUPF, ENABL, PF2 last)
    171  f080							; so the band-transition line keeps the left half on band 0.
    172  f080							; ==================================================================
    173  f080							; Cave band 0 leaves the missiles latched (the .AfterRows clear is
    174  f080							; skipped on the title). The 48px footer sets NUSIZ=3, so a live M0/M1
    175  f080							; would draw 1-clock vertical lines through bands 1/2 — clear both here.
    176  f080		       a9 00		      lda	#0
    177  f082		       85 1d		      sta	ENAM0
    178  f084		       85 1e		      sta	ENAM1
    179  f086		       a5 c4		      lda	PF0Buf+1
    180  f088		       85 0d		      sta	PF0
    181  f08a		       a5 c8		      lda	PF1Buf+1
    182  f08c		       85 0e		      sta	PF1
    183  f08e		       a5 d4		      lda	ColupfBuf+1
    184  f090		       85 08		      sta	COLUPF
    185  f092		       a5 d0		      lda	BandTab+1
    186  f094		       85 1f		      sta	ENABL
    187  f096		       a5 cc		      lda	PF2Buf+1
    188  f098		       85 0f		      sta	PF2
    189  f09a		       a9 06		      lda	#6	; 3 copies, 32px pitch (48px logo)
    190  f09c		       85 04		      sta	NUSIZ0
    191  f09e		       85 05		      sta	NUSIZ1
    192  f0a0		       a9 01		      lda	#1	; VDEL cross-buffer
    193  f0a2		       85 25		      sta	VDELP0
    194  f0a4		       85 26		      sta	VDELP1
    195  f0a6		       a9 00		      lda	#0	; logo slots are not mirrored
    196  f0a8		       85 0b		      sta	REFP0
    197  f0aa		       85 0c		      sta	REFP1
    198  f0ac		       a2 00		      ldx	#0
    199  f0ae		       a9 29		      lda	#41
    200  f0b0		       20 32 f8 	      jsr	SetObjectXPos_b1
    201  f0b3		       a2 01		      ldx	#1
    202  f0b5		       a9 39		      lda	#57
