   1155  f808							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1156  f808							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1157  f808							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1158  f808							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1159  f808							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1160  f808							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1161  f808				   BarDelayTable		; (B+7)>>3, 15 entries
   1162  f808		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
