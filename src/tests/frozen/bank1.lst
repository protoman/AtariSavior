   1608  faa8		       a5 c0		      lda	LaserState
   1609  faaa		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1610  faac		       a5 c2		      lda	EnemyRamP
   1611  faae		       4a		      lsr
   1612  faaf		       4a		      lsr
   1613  fab0		       4a		      lsr		; /8 frames per sweep step
   1614  fab1		       29 07		      and	#7
   1615  fab3		       aa		      tax
   1616  fab4		       bd c4 fa 	      lda	LaserFreqTable,X
   1617  fab7		       85 17		      sta	AUDF0
   1618  fab9		       a9 02		      lda	#LASER_AUD_C
   1619  fabb		       85 15		      sta	AUDC0
   1620  fabd		       a9 09		      lda	#LASER_AUD_V
   1621  fabf		       85 19		      sta	AUDV0
   1622  fac1				   .ULSOut
   1623  fac1		       4c f8 fb 	      jmp	ReturnPad
