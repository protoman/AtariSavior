   2455  fe66							; ---- it past the 127-byte relative reach when it sat at the very end) ----
   2456  fe66				   .RaftTurn
   2457  fe66		       bd 44 f8 	      lda	RaftBitTab,X
   2458  fe69		       45 c1		      eor	EnemyRamD
   2459  fe6b		       85 c1		      sta	EnemyRamD	; flip this slot's dir bit (the high nibble is
   2460  fe6d							; bank1's RoomDarkMask — must be preserved)
   2461  fe6d		       4c f8 fb 	      jmp	ReturnPad	; and the turn costs this frame (the inertia)
   2462  fe70							; ---- leading edge left --------------------------------------------------
   2463  fe70				   .RaftLeft
   2464  fe70		       b5 bd		      lda	EnemyRamX,X
   2465  fe72		       38		      sec
   2466  fe73		       e5 88		      sbc	$88
   2467  fe75		       90 ef		      bcc	.RaftTurn	; wrapped below 0
   2468  fe77		       c9 08		      cmp	#RAFT_MIN_X
   2469  fe79		       90 eb		      bcc	.RaftTurn	; left rail
   2470  fe7b		       38		      sec
   2471  fe7c		       e9 08		      sbc	#8	; the cell just beyond the left edge
   2472  fe7e		       b0 02		      bcs	.RaftLeftCol
   2473  fe80		       a9 00		      lda	#0
   2474  fe82				   .RaftLeftCol
   2475  fe82		       4a		      lsr
   2476  fe83		       4a		      lsr
   2477  fe84		       20 26 f8 	      jsr	RaftCellSolid
   2478  fe87		       d0 dd		      bne	.RaftTurn
   2479  fe89		       b5 bd		      lda	EnemyRamX,X
   2480  fe8b		       38		      sec
   2481  fe8c		       e5 88		      sbc	$88
   2482  fe8e		       95 bd		      sta	EnemyRamX,X
