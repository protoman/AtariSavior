   2225  fd68							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2226  fd68							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2227  fd68							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2228  fd68							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2229  fd68							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2230  fd68							; once per banner frame. Lives with the glyphs: bank1 pre-pad $F937 pin
   2231  fd68							; has ~1B slack (score section is a jsr here from MenuMain).
   2232  fd68				   SetupScorePointers
   2233  fd68							; --- Initialize score to 0 on first frame ---
   2234  fd68		       a5 ad		      lda	Temp
   2235  fd6a		       d0 0c		      bne	.scoreInitDone
   2236  fd6c		       e6 ad		      inc	Temp
   2237  fd6e		       a9 00		      lda	#0
   2238  fd70		       85 f3		      sta	ScoreTh
   2239  fd72		       85 f4		      sta	ScoreHu
   2240  fd74		       a9 00		      lda	#$00
   2241  fd76		       85 f5		      sta	ScoreTe
   2242  fd78				   .scoreInitDone
   2243  fd78
   2244  fd78							; --- Set up 6 digit pointers ---
   2245  fd78							; High bytes first (all $FD)
   2246  fd78		       a9 fd		      lda	#>DigitGfx
   2247  fd7a		       85 e1		      sta	scorePtr1+1
   2248  fd7c		       85 e3		      sta	scorePtr2+1
   2249  fd7e		       85 e5		      sta	scorePtr3+1
   2250  fd80		       85 e7		      sta	scorePtr4+1
   2251  fd82		       85 e9		      sta	scorePtr5+1
   2252  fd84		       85 eb		      sta	scorePtr6+1
   2253  fd86
   2254  fd86		       a5 f2		      lda	LevelShowTimer
   2255  fd88		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2256  fd8a		       f0 2e		      beq	.scoreLows
   2257  fd8c		       c6 f2		      dec	LevelShowTimer
   2258  fd8e		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2259  fd90		       85 e0		      sta	scorePtr1
   2260  fd92		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2261  fd94		       85 e2		      sta	scorePtr2
   2262  fd96		       a9 00		      lda	#0	; hundreds '0'
   2263  fd98		       85 e4		      sta	scorePtr3
   2264  fd9a		       a5 a3		      lda	Level
   2265  fd9c		       18		      clc
   2266  fd9d		       69 01		      adc	#1	; 1-based level number
   2267  fd9f		       a2 00		      ldx	#0
   2268  fda1				   .LVTens
   2269  fda1		       c9 0a		      cmp	#10
   2270  fda3		       90 05		      bcc	.LVTensDone
   2271  fda5		       e9 0a		      sbc	#10
   2272  fda7		       e8		      inx
   2273  fda8		       d0 f7		      bne	.LVTens
   2274  fdaa				   .LVTensDone
   2275  fdaa		       0a		      asl
   2276  fdab		       0a		      asl
   2277  fdac		       0a		      asl		; ones * 8
   2278  fdad		       85 e8		      sta	scorePtr5
   2279  fdaf		       8a		      txa
   2280  fdb0		       0a		      asl
   2281  fdb1		       0a		      asl
   2282  fdb2		       0a		      asl		; tens * 8
   2283  fdb3		       85 e6		      sta	scorePtr4
   2284  fdb5		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2285  fdb7		       85 ea		      sta	scorePtr6
   2286  fdb9		       60		      rts
   2287  fdba
   2288  fdba							; scorePtr1..2 = leading zeros
   2289  fdba				   .scoreLows
   2290  fdba		       a9 00		      lda	#0
   2291  fdbc		       85 e0		      sta	scorePtr1
   2292  fdbe		       85 e2		      sta	scorePtr2
   2293  fdc0
   2294  fdc0							; scorePtr3 = ScoreTh * 8
   2295  fdc0		       a5 f3		      lda	ScoreTh
   2296  fdc2		       0a		      asl
   2297  fdc3		       0a		      asl
   2298  fdc4		       0a		      asl
   2299  fdc5		       85 e4		      sta	scorePtr3
   2300  fdc7
