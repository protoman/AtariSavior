    198  f0aa		       85 0c		      sta	REFP1
    199  f0ac		       a2 00		      ldx	#0
    200  f0ae		       a9 29		      lda	#41
    201  f0b0		       20 f8 f7 	      jsr	SetObjectXPos_b1
