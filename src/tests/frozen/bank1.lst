   2028  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   2029  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   2030  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   2031  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   2032  fc78							; survives the cross-bank return.
   2033  fc78				   IsRoomDark
   2034  fc78		       a5 98		      lda	RoomNo
   2035  fc7a		       c9 04		      cmp	#4
   2036  fc7c		       b0 0c		      bcs	.IRDhi
   2037  fc7e		       18		      clc
   2038  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   2039  fc81		       aa		      tax
   2040  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   2041  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   2042  fc87		       4c f8 fb 	      jmp	ReturnPad
   2043  fc8a				   .IRDhi
   2044  fc8a		       c9 08		      cmp	#8
   2045  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   2046  fc8e		       aa		      tax
   2047  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   2048  fc92		       4a		      lsr
   2049  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   2050  fc94		       25 c0		      and	LaserState
   2051  fc96		       4c f8 fb 	      jmp	ReturnPad
   2052  fc99				   .IRDlit
   2053  fc99		       a9 00		      lda	#0	; Z=1 → lit
   2054  fc9b		       4c f8 fb 	      jmp	ReturnPad
   2055  fc9e
   2056  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   2057  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   2058  fc9e							; simply stays lit). Cleared only by LoadLevel.
   2059  fc9e				   SetRoomDark
   2060  fc9e		       a5 98		      lda	RoomNo
   2061  fca0		       c9 04		      cmp	#4
   2062  fca2		       b0 0e		      bcs	.SRDhi
   2063  fca4		       18		      clc
   2064  fca5		       69 04		      adc	#4
   2065  fca7		       aa		      tax
   2066  fca8		       bd c3 fc 	      lda	BitMaskTable,X
   2067  fcab		       05 c1		      ora	EnemyRamD
   2068  fcad		       85 c1		      sta	EnemyRamD
   2069  fcaf		       4c f8 fb 	      jmp	ReturnPad
   2070  fcb2				   .SRDhi
   2071  fcb2		       c9 08		      cmp	#8
   2072  fcb4		       b0 0a		      bcs	.SRDdone	; rooms 8+: no bit to set (no crash)
   2073  fcb6		       aa		      tax
   2074  fcb7		       bd c3 fc 	      lda	BitMaskTable,X
   2075  fcba		       4a		      lsr
   2076  fcbb		       4a		      lsr
   2077  fcbc		       05 c0		      ora	LaserState
   2078  fcbe		       85 c0		      sta	LaserState
   2079  fcc0				   .SRDdone
   2080  fcc0		       4c f8 fb 	      jmp	ReturnPad
