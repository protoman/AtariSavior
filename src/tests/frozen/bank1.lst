   2065  fbda							; ColOff/ColMask live at $F010 (top-of-bank fill gap) — only BMWCellSolid and
   2066  fbda							; BeamMask-era code index them (abs,X); no cross-bank operand points here.
   2067  fbda
   2068  fbda							; ========================================================================
   2069  fbda							; Cross-bank call pads — 2026-10-20 (chunk 4): SPLIT across the banks, no
   2070  fbda							; twin. kernel.asm holds the eleven `sta $1FFx` halves compactly at
   2071  fbda							; $FBFC..$FC1C; after the switch the fetch at A+3 lands HERE, so this bank
   2072  fbda							; keeps only the `jmp` halves (at A+3, i.e. $FBFF onward). The reverse halves
   2073  fbda							; were dead bytes: no bank1/bank2/bank3 code calls a CallPad (guard:
   2074  fbda							; verify_build.check_callpads rejects any `jsr/jmp CallPad_*` outside
   2075  fbda							; kernel.asm). F6 hotspot ignores the written value, so a pad still passes
   2076  fbda							; A/X/Y/flags through untouched (`sta` affects no flag).
   2077  fbda							;   $FBFF <-$FBFC+3 UpdateBombSound	  $FC0E <-$FC0B+3 AddScore
   2078  fbda							;   $FC02 <-$FBFF+3 UpdateJetSound	  $FC11 <-$FC0E+3 IsRoomDark
   2079  fbda							;   $FC05 <-$FC02+3 BombSndDrop	  $FC14 <-$FC11+3 SetRoomDark
   2080  fbda							;   $FC08 <-$FC05+3 BombSndExplode	  $FC17 <-$FC14+3 UpdateLaserSound
   2081  fbda							;   ($FC0B retired by C3)		 $FC1D <-$FC1A+3 BombMarkWalls
   2082  fbda							; $FC1A (BuildColupF's +3) belongs to BANK3 — its pad is `sta $1FF7`.
   2083  fbda							; ========================================================================
   2084  fbda		       00 00 00 00*	      .ds	$FBF8 - *, 0
   2085  fbf8				   ReturnPad
   2086  fbf8		       8d f4 1f 	      sta	$1FF4	; the `rts` at $FBFB is served by bank0
   2087  fbfb		       00 00 00 00	      .ds	$FBFF - *, 0
   2088  fbff		       4c c0 f9 	      jmp	UpdateBombSound
   2089  fc02		       4c cf f9 	      jmp	UpdateJetSound
   2090  fc05		       4c 00 fa 	      jmp	BombSndDrop
   2091  fc08		       4c 13 fa 	      jmp	BombSndExplode
   2092  fc0b		       00 00 00 	      .byte.b	0,0,0	; $FC0B: GetConnIdx's half, retired by C3
   2093  fc0e		       4c 6b fa 	      jmp	AddScore	; label, not the literal: bank1 shifts move it
   2094  fc11		       4c 78 fc 	      jmp	IsRoomDark
   2095  fc14		       4c 9e fc 	      jmp	SetRoomDark
   2096  fc17		       4c 93 fa 	      jmp	UpdateLaserSound	; label, not the literal (bank1 shifts)
   2097  fc1a		       00 00 00 	      .ds	$FC1D - *, 0	; ($FC1A is bank3's BuildColupF image)
   2098  fc1d		       4c 10 fb 	      jmp	BombMarkWalls	; S5.2: body lives in bank1 ($FB10)
