   1118  f7a4							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1119  f7a4							; Proven kernel from score48pix.asm
   1120  f7a4							; ====================================================================
   1121  f7a4		       a0 07		      ldy	#7
   1122  f7a6		       84 ec		      sty	scbrdCnt
   1123  f7a8				   .ScoreLoop
   1124  f7a8		       a4 ec		      ldy	<scbrdCnt	; 3c
   1125  f7aa		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1126  f7ac		       aa		      tax		; 2c — cache in X
   1127  f7ad		       85 02		      sta	WSYNC	; 3c
   1128  f7af		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1129  f7b1		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1130  f7b4		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1131  f7b6		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1132  f7b8		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1133  f7ba		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1134  f7bc		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1135  f7be		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1136  f7c0		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1137  f7c2		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1138  f7c4		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1139  f7c6		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1140  f7c8		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1141  f7ca		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1142  f7cc		       c6 ec		      dec	<scbrdCnt	; 5c
   1143  f7ce		       d0 d8		      bne	.ScoreLoop	; 3c
