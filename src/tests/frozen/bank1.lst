   1244  f7ce		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1245  f7d0		       aa		      tax		; 2c — cache in X
   1246  f7d1		       85 02		      sta	WSYNC	; 3c
   1247  f7d3		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1248  f7d5		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1249  f7d8		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1250  f7da		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1251  f7dc		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1252  f7de		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1253  f7e0		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1254  f7e2		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1255  f7e4		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1256  f7e6		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1257  f7e8		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1258  f7ea		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1259  f7ec		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1260  f7ee		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1261  f7f0		       c6 ec		      dec	<scbrdCnt	; 5c
   1262  f7f2		       d0 d8		      bne	.ScoreLoop	; 3c
