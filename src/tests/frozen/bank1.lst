   2531  ff0f
   2532  ff0f							; ------------------------------------------------------------------------------
   2533  ff0f							; Tally entry tramp slice ($FFE6-$FFEB) — byte-identical with kernel.asm's
   2534  ff0f							; copy at the same address (F6 pad rule). bank0 executes `sta $1FF5` at
   2535  ff0f							; $FFE6-$FFE8; the fetch at $FFE9 comes from THIS bank = `jmp TallyEntry`
   2536  ff0f							; ($F44F — moved here from bank2, repack chunk 3, 2026-10-20). Neither bank
   2537  ff0f							; runs its other half. $FFF2-$FFF9 stay fill (hotspot mirrors).
   2538  ff0f							; ------------------------------------------------------------------------------
   2539  ff0f							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   2540  ff0f							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   2541  ff0f							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   2542  ff0f							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   2543  ff0f							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   2544  ff0f							; once per banner frame. Lives in the $FF0F fill since the 6-digit score
   2545  ff0f							; (2026-10-27) outgrew its old slot ending at $FDE3 (jsr here from MenuMain).
   2546  ff0f				   SetupScorePointers
   2547  ff0f							; --- Initialize score to 0 on first frame ---
   2548  ff0f		       a5 ad		      lda	Temp
   2549  ff11		       d0 0c		      bne	.scoreInitDone
   2550  ff13		       e6 ad		      inc	Temp
   2551  ff15		       a9 00		      lda	#0
   2552  ff17		       85 f3		      sta	ScoreTh
   2553  ff19		       85 f4		      sta	ScoreHu
   2554  ff1b		       a9 00		      lda	#$00
   2555  ff1d		       85 f5		      sta	ScoreTe
   2556  ff1f				   .scoreInitDone
   2557  ff1f
   2558  ff1f							; --- Set up 6 digit pointers ---
   2559  ff1f							; High bytes first (all $FD)
   2560  ff1f		       a9 fd		      lda	#>DigitGfx
   2561  ff21		       85 e1		      sta	scorePtr1+1
   2562  ff23		       85 e3		      sta	scorePtr2+1
   2563  ff25		       85 e5		      sta	scorePtr3+1
   2564  ff27		       85 e7		      sta	scorePtr4+1
   2565  ff29		       85 e9		      sta	scorePtr5+1
   2566  ff2b		       85 eb		      sta	scorePtr6+1
   2567  ff2d
   2568  ff2d		       a5 f2		      lda	LevelShowTimer
   2569  ff2f		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   2570  ff31		       f0 1f		      beq	.scoreLows
   2571  ff33		       c6 f2		      dec	LevelShowTimer
   2572  ff35		       a9 58		      lda	#<DigitGfx+88	; glyph 11 = L
   2573  ff37		       85 e0		      sta	scorePtr1
   2574  ff39		       a9 60		      lda	#<DigitGfx+96	; glyph 12 = V
   2575  ff3b		       85 e2		      sta	scorePtr2
   2576  ff3d		       a9 00		      lda	#0	; hundreds '0'
   2577  ff3f		       85 e4		      sta	scorePtr3
   2578  ff41		       a6 a3		      ldx	Level	; 0-based; tables hold the 1-based number's digits * 8
   2579  ff43		       bd 05 f8 	      lda	LvOnes8,X	; (a div-10 loop cost +12c per tens digit: level 20's
   2580  ff46		       85 e8		      sta	scorePtr5	;  banner ran a whole scanline long, 273-line frames)
   2581  ff48		       bd 19 f8 	      lda	LvTens8,X
   2582  ff4b		       85 e6		      sta	scorePtr4
   2583  ff4d		       a9 50		      lda	#<DigitGfx+80	; glyph 10 = blank (trailing slot)
   2584  ff4f		       85 ea		      sta	scorePtr6
   2585  ff51		       60		      rts
   2586  ff52
   2587  ff52				   .scoreLows
   2588  ff52							; Three packed-BCD bytes -> six digit pointers (hi nibble, lo nibble each):
   2589  ff52							; ScoreTh = ptr1/ptr2 (100k, 10k), ScoreHu = ptr3/ptr4, ScoreTe = ptr5/ptr6.
   2590  ff52							; Unrolled on purpose: hi digit * 8 = (b & $F0) >> 1, lo digit * 8 = (b & $0F) << 3.
   2591  ff52		       a5 f3		      lda	ScoreTh
   2592  ff54		       29 f0		      and	#$F0
   2593  ff56		       4a		      lsr
   2594  ff57		       85 e0		      sta	scorePtr1
   2595  ff59		       a5 f3		      lda	ScoreTh
   2596  ff5b		       29 0f		      and	#$0F
   2597  ff5d		       0a		      asl
   2598  ff5e		       0a		      asl
   2599  ff5f		       0a		      asl
   2600  ff60		       85 e2		      sta	scorePtr2
   2601  ff62		       a5 f4		      lda	ScoreHu
   2602  ff64		       29 f0		      and	#$F0
   2603  ff66		       4a		      lsr
   2604  ff67		       85 e4		      sta	scorePtr3
   2605  ff69		       a5 f4		      lda	ScoreHu
   2606  ff6b		       29 0f		      and	#$0F
   2607  ff6d		       0a		      asl
   2608  ff6e		       0a		      asl
   2609  ff6f		       0a		      asl
   2610  ff70		       85 e6		      sta	scorePtr4
   2611  ff72		       a5 f5		      lda	ScoreTe
   2612  ff74		       29 f0		      and	#$F0
   2613  ff76		       4a		      lsr
   2614  ff77		       85 e8		      sta	scorePtr5
   2615  ff79		       a5 f5		      lda	ScoreTe
   2616  ff7b		       29 0f		      and	#$0F
   2617  ff7d		       0a		      asl
   2618  ff7e		       0a		      asl
   2619  ff7f		       0a		      asl
   2620  ff80		       85 ea		      sta	scorePtr6
   2621  ff82		       60		      rts
   2622  ff83
   2623  ff83		       00 00 00 00*	      .ds	$FFE6 - *, 0
