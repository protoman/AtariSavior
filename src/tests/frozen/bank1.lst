   1627  fa6b							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1628  fa6b							; ScoreTh/ScoreHu = binary 0-9; ScoreTe = packed BCD. Clobbers A.
   1629  fa6b							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1630  fa6b							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1631  fa6b							; (the 2026-09-23 decimal-mode rule). The old BINARY `cmp #$A0 / sbc #$A0`
   1632  fa6b							; fix-up missed nibble-level overflow: $25+$75 = $9A stored raw -> ones
   1633  fa6b							; digit A -> glyph index 10 -> DigitGfx+80 (past the 10-glyph font) =
   1634  fa6b							; the solid-block score digit (screenshots/score_issue_002.png).
   1635  fa6b							; C=1 = BCD carry (sum >= 100) -> ScoreHu path.
   1636  fa6b							; SIZE PIN: routine runs $FA7D..$FAA4 exactly (UpdateLaserSound's pad
   1637  fa6b							; target is $FAA5). Old head = clc/adc/cmp/bcc/sbc = 9 bytes, new head =
   1638  fa6b							; sed/clc/adc/cld/bcc = 7, so the two nops restore the exact length —
   1639  fa6b							; without them every pad below shifts silently.
   1640  fa6b				   AddScore
   1641  fa6b		       f8		      sed
   1642  fa6c		       18		      clc
   1643  fa6d		       65 f5		      adc	ScoreTe
   1644  fa6f		       d8		      cld
   1645  fa70		       90 1c		      bcc	.ASstoreTe
   1646  fa72		       ea		      nop		; byte-pin (see SIZE PIN above)
   1647  fa73		       ea		      nop		; byte-pin
   1648  fa74		       48		      pha		; save wrapped ScoreTe
   1649  fa75		       e6 f4		      inc	ScoreHu
   1650  fa77		       a5 f4		      lda	ScoreHu
   1651  fa79		       c9 0a		      cmp	#10
   1652  fa7b		       90 10		      bcc	.AShuOk
   1653  fa7d		       a9 00		      lda	#0
   1654  fa7f		       85 f4		      sta	ScoreHu
   1655  fa81		       e6 f3		      inc	ScoreTh
   1656  fa83		       a5 f3		      lda	ScoreTh
   1657  fa85		       c9 0a		      cmp	#10
   1658  fa87		       90 04		      bcc	.ASthOk
   1659  fa89		       a9 09		      lda	#9
   1660  fa8b		       85 f3		      sta	ScoreTh
   1661  fa8d				   .ASthOk
   1662  fa8d				   .AShuOk
   1663  fa8d		       68		      pla
