   2482  feac		       a5 f0		      lda	$F0
   2483  feae		       29 78		      and	#%01111000
   2484  feb0		       c9 78		      cmp	#%01111000
   2485  feb2		       f0 07		      beq	.RaftCarry	; already spun up
   2486  feb4		       a5 f0		      lda	$F0
   2487  feb6		       18		      clc
   2488  feb7		       69 10		      adc	#%00010000
   2489  feb9		       85 f0		      sta	$F0
   2490  febb				   .RaftCarry
   2491  febb		       bd 44 f8 	      lda	RaftBitTab,X
   2492  febe		       25 c1		      and	EnemyRamD
   2493  fec0		       f0 0a		      beq	.RaftCarryL
   2494  fec2		       a5 80		      lda	RoomX
   2495  fec4		       18		      clc
   2496  fec5		       65 88		      adc	$88
