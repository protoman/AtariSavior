   1305  f7e4		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1306  f7e6		       aa		      tax		; 2c — cache in X
   1307  f7e7		       85 02		      sta	WSYNC	; 3c
   1308  f7e9		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1309  f7eb		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1310  f7ee		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1311  f7f0		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1312  f7f2		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1313  f7f4		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1314  f7f6		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1315  f7f8		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1316  f7fa		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1317  f7fc		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1318  f7fe		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1319  f800		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1320  f802		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1321  f804		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1322  f806		       c6 ec		      dec	<scbrdCnt	; 5c
