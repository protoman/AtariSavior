   1069  f769							; ====================================================================
   1070  f769							; Line 4: Score — 6-digit test ("012389") — 48-pixel sprite technique
   1071  f769							; NUSIZ0=3 (3 copies close) + NUSIZ1=3 (3 copies close)
   1072  f769							; Interleaved: P0c1 P1c1 P0c2 P1c2 P0c3 P1c3 = 6 digit slots
   1073  f769							; VDELP0=1, VDELP1=1 for cross-buffer pipeline
   1074  f769							; ====================================================================
   1075  f769
   1076  f769							; --- Setup sprites ---
   1077  f769		       a9 0e		      lda	#$0E	; white
   1078  f76b		       85 06		      sta	COLUP0
   1079  f76d		       85 07		      sta	COLUP1
   1080  f76f		       a9 03		      lda	#3	; NUSIZ = 3 copies close
   1081  f771		       85 04		      sta	NUSIZ0
   1082  f773		       85 05		      sta	NUSIZ1
   1083  f775		       a9 01		      lda	#1	; VDELP = ON (cross-buffer active)
   1084  f777		       85 25		      sta	VDELP0
   1085  f779		       85 26		      sta	VDELP1
   1086  f77b							; Flush both VDELP buffers + live registers to 0.
   1087  f77b							; Without this, stale buffer data from previous frame shows as
   1088  f77b							; white ghost copies during the positioning scanlines.
   1089  f77b		       a9 00		      lda	#0
   1090  f77d		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1091  f77f		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1092  f781		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
   1093  f783		       85 0b		      sta	REFP0
   1094  f785		       85 0c		      sta	REFP1
