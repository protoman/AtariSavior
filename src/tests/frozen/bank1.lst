   1591  facc							; PairGone — leaf in the pre-BMW free zone ($FACC..$FB0F). Called ONLY for
   1592  facc							;   rect idx4 (the sole maskless slot), so rect4.x is deref'd here directly
   1593  facc							;   (RcW1+16 = rect4.x — EQU-derived, not a magic number). Returns Z=1 iff
   1594  facc							;   cols (rect4.x, rect4.x+1) are BOTH clear in row LineCount (pair present
   1595  facc							;   anywhere in the span ⇒ Z=0). Rect idx4 has no WallMask bit (BombMaskBit
   1596  facc							;   is 4-wide, b3-6), so this single-row buffer read replaces the mask
   1597  facc							;   double-score guard for that slot only — first blast sees the pair
   1598  facc							;   solid, any re-blast sees it clear and skips (parity: idx0-3 keep the
   1599  facc							;   mask path untouched). Pair x is even (cell-aligned) and ≠0 (caller
   1600  facc							;   gates), so x and x+1 always share one PF buffer. Clobbers A,X,Y,Temp.
   1601  facc							;   Same-bank jsr legal (no pad nesting).
   1602  facc				   PairGone
   1603  facc		       a5 dc		      lda	RcW1+16	; rect4.x (ABWXTab,X with X=4)
   1604  face		       aa		      tax
   1605  facf		       bd 68 fa 	      lda	BombClearMask,X
   1606  fad2		       49 ff		      eor	#$FF
   1607  fad4		       a8		      tay		; Y = bit for col x
   1608  fad5		       e8		      inx
   1609  fad6		       bd 68 fa 	      lda	BombClearMask,X
   1610  fad9		       49 ff		      eor	#$FF
   1611  fadb		       85 ad		      sta	Temp	; bit for col x+1
   1612  fadd		       98		      tya
   1613  fade		       05 ad		      ora	Temp
   1614  fae0		       85 ad		      sta	Temp	; both pair bits
   1615  fae2							; X = x+1 here — buffer dispatch still selects correctly (pair x is
   1616  fae2							; even: PF0 iff x<4 ⟺ X<4; PF1 4..10 ⟺ X 5..11; PF2 x≥12 ⟺ X≥13).
   1617  fae2		       a4 84		      ldy	LineCount
   1618  fae4		       e0 04		      cpx	#4
   1619  fae6		       90 0a		      bcc	.pg0
   1620  fae8		       e0 0c		      cpx	#12
   1621  faea		       90 0c		      bcc	.pg1
   1622  faec		       b9 c9 00 	      lda	PF2Buf,Y
   1623  faef		       25 ad		      and	Temp
