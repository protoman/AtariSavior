   2513  ff00					      org	$FF00
   2514  ff00				   fineAdjustBegin_b1
   2515  ff00		       70		      .byte.b	%01110000
   2516  ff01		       60		      .byte.b	%01100000
   2517  ff02		       50		      .byte.b	%01010000
   2518  ff03		       40		      .byte.b	%01000000
   2519  ff04		       30		      .byte.b	%00110000
   2520  ff05		       20		      .byte.b	%00100000
   2521  ff06		       10		      .byte.b	%00010000
   2522  ff07		       00		      .byte.b	%00000000
   2523  ff08		       f0		      .byte.b	%11110000
   2524  ff09		       e0		      .byte.b	%11100000
   2525  ff0a		       d0		      .byte.b	%11010000
   2526  ff0b		       c0		      .byte.b	%11000000
   2527  ff0c		       b0		      .byte.b	%10110000
   2528  ff0d		       a0		      .byte.b	%10100000
   2529  ff0e		       90		      .byte.b	%10010000
