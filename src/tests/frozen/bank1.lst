   1204  f7a4							; ====================================================================
   1205  f7a4							; 8-scanline render loop (exactly 71 cycles + WSYNC = 74 per line)
   1206  f7a4							; Proven kernel from score48pix.asm
   1207  f7a4							; ====================================================================
   1208  f7a4		       a0 07		      ldy	#7
   1209  f7a6		       84 ec		      sty	scbrdCnt
   1210  f7a8				   .ScoreLoop
   1211  f7a8		       a4 ec		      ldy	<scbrdCnt	; 3c
   1212  f7aa		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1213  f7ac		       aa		      tax		; 2c — cache in X
   1214  f7ad		       85 02		      sta	WSYNC	; 3c
   1215  f7af		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1216  f7b1		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1217  f7b4		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1218  f7b6		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1219  f7b8		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1220  f7ba		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1221  f7bc		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1222  f7be		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1223  f7c0		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1224  f7c2		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1225  f7c4		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1226  f7c6		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1227  f7c8		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1228  f7ca		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1229  f7cc		       c6 ec		      dec	<scbrdCnt	; 5c
   1230  f7ce		       d0 d8		      bne	.ScoreLoop	; 3c
   1231  f7d0
   1232  f7d0							; --- Cleanup ---
   1233  f7d0		       a9 00		      lda	#0
   1234  f7d2		       85 1b		      sta	GRP0
   1235  f7d4		       85 1c		      sta	GRP1
   1236  f7d6		       85 04		      sta	NUSIZ0
   1237  f7d8		       85 05		      sta	NUSIZ1
   1238  f7da		       85 25		      sta	VDELP0
   1239  f7dc		       85 26		      sta	VDELP1
   1240  f7de
   1241  f7de							; --- Restore cave kernel settings ---
   1242  f7de		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + 8-clk ball (cave mode
   1243  f7e0							; since D6 — bank1 bar overwrote $05 during its band)
   1244  f7e0		       85 0a		      sta	CTRLPF
   1245  f7e2		       a9 00		      lda	#0
   1246  f7e4		       85 04		      sta	NUSIZ0
   1247  f7e6		       a9 00		      lda	#0
   1248  f7e8		       85 05		      sta	NUSIZ1
   1249  f7ea		       85 25		      sta	VDELP0
   1250  f7ec		       85 26		      sta	VDELP1
   1251  f7ee
   1252  f7ee							; ====================================================================
   1253  f7ee							; Pad remaining scanlines to reach exactly 48 total
   1254  f7ee							; Path A (PlayerLives > 0) — execution count:
   1255  f7ee							;   Top gap:  6 (4 + 2 former ball-pos lines — elements keep lines)
   1256  f7ee							;   Timer:    3 loop + 1 gap = 4
   1257  f7ee							;   Lives:    1 SetObjectXPos + 1 HMOVE + 5 render + 1 gap = 8
   1258  f7ee							;   Bombs:    2 SetObjectXPos + 1 HMOVE + 5 render + 3 gap = 11
   1259  f7ee							;   Score:    2 SetObjectXPos + 1 HMOVE + 7 ScoreLoop = 10
   1260  f7ee							;   Subtotal: 6+4+8+11+10 = 39
   1261  f7ee							;   Pad:      48 - 39 = 9
   1262  f7ee							; .NoLives blank path pads +2 WSYNC so both paths total 48.
   1263  f7ee							; ====================================================================
   1264  f7ee		       a2 09		      ldx	#9
   1265  f7f0				   .HudPad
   1266  f7f0		       85 02		      sta	WSYNC
   1267  f7f2		       ca		      dex
   1268  f7f3		       d0 fb		      bne	.HudPad
   1269  f7f5
   1270  f7f5							; --- Return to bank0 via fold-pad ---
   1271  f7f5		       4c 70 fc 	      jmp	$FC70
   1272  f7f8
   1273  f7f8							; ========================================================================
   1274  f7f8							; SetObjectXPos — Andrew Davie algorithm (page-aligned table)
   1275  f7f8							; X=0 positions P0, X=1 positions P1
   1276  f7f8							; A = pixel position (0-159)
   1277  f7f8							; ========================================================================
   1278  f7f8				   SetObjectXPos_b1
   1279  f7f8		       85 02		      sta	WSYNC
   1280  f7fa		       38		      sec
   1281  f7fb				   .Div15Loop
   1282  f7fb		       e9 0f		      sbc	#15
   1283  f7fd		       b0 fc		      bcs	.Div15Loop
   1284  f7ff		       a8		      tay
   1285  f800		       b9 0f fe 	      lda	fineAdjustTable_b1,Y
   1286  f803		       95 20		      sta	HMP0,X
   1287  f805		       95 10		      sta	RESP0,X
   1288  f807		       60		      rts
   1289  f808
   1290  f808							; Bar H3c tables (B=0..120): content ≤71c (WSYNC 3c fits in 76).
   1291  f808							; Paths (cycles after WSYNC → sty red): F=0 slim 12+5A; F=1 slim+nop 14+5A;
   1292  f808							; F=2 full 20+5A; F=3 full 30+5A; F=4 full 31+5A (A=0 special-cased).
   1293  f808							; D2 (2026-10-16): both tables were EXACTLY period-8 ([1-8],[9-16],…) so
   1294  f808							; they shrank 121→15 entries, indexed (B+7)>>3 (see the reader). Entry 0 =
   1295  f808							; B=0; entry g≥1 = B in [8(g-1)+1, 8g]. Verified against the old 121B blobs.
   1296  f808				   BarDelayTable		; (B+7)>>3, 15 entries
   1297  f808		       00 02 03 02*	      .byte.b	0, 2,3,2,4,5,2,5,7,8,5,8,10,11,8
   1298  f817				   BarFineTable 		; (B+7)>>3, 15 entries; ∈{0,1,2,3,4}
   1299  f817		       02 01 00 02*	      .byte.b	2, 1,0,2,1,0,4,2,1,0,4,2,1,0,4
   1300  f826
   1301  f826							; ------------------------------------------------------------------------------
   1302  f826
   1303  f826							; ==============================================================================
   1304  f826							; Raft (enemy type 7) — the moving, rideable platform. plans/raft_moving_plan.md
   1305  f826							; ==============================================================================
   1306  f826							; Entrance: bank0 UEDispatch -> CallPad_RaftBody (sta $1FF7 / jmp $F822) -> here;
   1307  f826							; exit: jmp ReturnPad ($FBF8, bank1's twin) -> bank0's jmp UE_Next.
   1308  f826							; CallPad rules honoured: no nested CallPad, no bank0 jsr, ZP is shared RAM.
   1309  f826							; ZP ALIAS WARNING: this code uses bank0's Temp at $88 (free here — every other
   1310  f826							; overscan Temp consumer, the joystick read and the hot-bump flag, ran before
   1311  f826							; UpdateEnemies). It must NEVER touch bank1's Temp symbol ($AD = bank0's
   1312  f826							; TickCounter — writing that would stall the game timer).
   1313  f826							;
   1314  f826							; User spec 2026-10-18: floats only on water; carries the player across and
   1315  f826							; returns; ~1.5x the player's 1 px/frame; inertia when it starts.
   1316  f826							;   Y	     = the water surface, NOT the authored y and NOT a constant: the
   1317  f826							;	       surface line drifts 0-3 lines with the TIDE (VBL stages 36+off
   1318  f826							;	       into CollisionX, kernel draws the strip as the band's last
   1319  f826							;	       (12-off) lines), so the raft is placed at 125+off and its bottom
   1320  f826							;	       row sits exactly on the moving surface — it rides the wave the
   1321  f826							;	       water does. The rider's pin (top-12 = 113+off, worst case 116)
   1322  f826							;	       stays clear of the 125 water-kill line at every tide phase.
   1323  f826							;	       This write lands after RefreshEnemyY, so the VBL draws it.
   1324  f826							;   Speed   = 1 px on even frames, 2 px on odd (EnemyRamP parity) = 1.5 px/frame.
   1325  f826							;   Inertia = a real spin-up ramp: 1 px/frame for ~30 frames (~0.5 s) then the
   1326  f826							;	       full 1/2 parity (1.5 avg), so the take-off is heavy. The state
   1327  f826							;	       lives in PlayerBombs' ($F0) spare high bits (b7 = ridden flag,
   1328  f826							;	       b6-b3 = level) — the ZP map has no free byte and the bomb count
   1329  f826							;	       keeps b2-0 (see the kernel EQU contract). Stepping off clears the
   1330  f826							;	       flag+level, so the empty raft runs at full speed and the next
   1331  f826							;	       take-off ramps again. It also holds the frame it turns around on.
   1332  f826							;   Range   = derived from the playfield, no data and no ZP: the model row-2
   1333  f826							;	       cell just beyond the raft's leading edge is read from the PF row-2
   1334  f826							;	       buffers and a SOLID cell turns it around, so the raft patrols
   1335  f826							;	       exactly the open water span of the room.
   1336  f826							;   Ride    = the raft is a FERRY: it moves ONLY while the player's box overlaps
   1337  f826							;	       its upper rows; step off and it parks immediately (the ramp state
   1338  f826							;	       is cleared too, so the next take-off ramps again). While over it a
   1339  f826							;	       non-rising player (vyHi >= 0) is pinned to the raft's top with vy
   1340  f826							;	       zeroed (gravity must never accumulate into the water) and carried
   1341  f826							;	       by the raft's step; thrust up skips the pin but keeps the carry, so
   1342  f826							;	       flying off is always possible. Leaving and re-entering the ROOM
   1343  f826							;	       resets the raft to its authored spawn x (LoadEnemyRam re-copies
   1344  f826							;	       it), which is the "reset" the user asked for.
   1345  f826							; In: X = enemy slot. Clobbers A/Y and bank0 Temp ($88).
   1346  f826							; ==============================================================================
   1347  f826							; RaftCellSolid — is the model row-2 (water row) playfield cell in display
   1348  f826							; column A solid? Reflect mapping: CTRLPF $35 (reflect) is the cave default and
   1349  f826							; a raft room has no door/bar band to switch it off. IN: A = display col 0..39.
   1350  f826							; OUT: Z=1 open (water) / Z=0 solid. Clobbers A/Y.
   1351  f826							;   cols 0-3	-> PF0 row 2 ($C5), bit 4+col (PF0 bit 4 = leftmost pixel)
   1352  f826							;   cols 4-11	-> PF1 row 2 ($C8), bit 7-(col-4)
   1353  f826							;   cols 12-19 -> PF2 row 2 ($CB), bit col-12
   1354  f826							;   cols 20-39 -> the mirrored half: source = 39-col
   1355  f826				   RaftCellSolid
   1356  f826		       c9 14		      cmp	#20
   1357  f828		       90 05		      bcc	.RCSrc
   1358  f82a		       49 ff		      eor	#$ff
   1359  f82c		       18		      clc
   1360  f82d		       69 28		      adc	#40
   1361  f82f				   .RCSrc
   1362  f82f		       a8		      tay
   1363  f830		       b9 48 f8 	      lda	RaftCellMasks,Y
   1364  f833		       c0 04		      cpy	#4
   1365  f835		       b0 03		      bcs	.RCPF1
   1366  f837		       25 c5		      and	$C5
   1367  f839		       60		      rts
