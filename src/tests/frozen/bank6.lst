------- FILE bank6.asm LEVEL 1 PASS 2
      1  fffe					      processor	6502
      2  10000 ????				       seg	code
      3  f000					      org	$F000
      4  f000							; ==============================================================================
      5  f000							; Bank6 - the GAMEPLAY CAVE KERNEL (HERO-style; plans/hero_style_kernel_plan.md)
      6  f000							; ------------------------------------------------------------------------------
      7  f000							; Entered from bank0's VBL tail (`sta $1FFA` at GoKernel6; the byte after it is
      8  f000							; `jmp Kernel6Entry` here). Runs the whole 144-line cave, then hands over to the
      9  f000							; bank1 HUD through the fold pad at $FC68 (its bytes live in table page $FC).
     10  f000							;
     11  f000							; The kernel lines, sprite tables and LUTs are GENERATED (tools/cave_kernel_gen.py;
     12  f000							; every scanline is a cycle-exact timeline asserted at generation time, the tables
     13  f000							; come from the art in kernel.asm). The prologue is bank6_prologue.inc, shared with the
     14  f000							; standalone test ROM in tools/proto.
     15  f000							;
     16  f000							; Zero page: the kernel-local state lives in bytes that are free while the cave runs
     17  f000							; (bank1-only HUD bytes, VBL/overscan scratch, and the stack bytes $F8-$FF: bank6 never
     18  f000							; calls). The map is tools/cave_kernel_gen.py KERNEL_ZP (generated/cave_zp.inc).
     19  f000							; ==============================================================================
     20  f000
     21  f000							; power-up stub (mandatory in EVERY bank: F4 powers up in an undefined bank)
     22  f000		       a9 00		      lda	#0
     23  f002		       8d f4 1f 	      sta	BK_GENERAL	; select bank0 - the fetch at $F005 is its jmp GameStart
     24  f005
------- FILE colors.inc LEVEL 2 PASS 2
