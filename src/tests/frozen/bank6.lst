------- FILE bank6.asm
------- FILE banks.inc LEVEL 2 PASS 2
      0  f005					      include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  f005							; ==============================================================================
      2  f005							; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  f005							; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  f005							; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  f005							;
      6  f005							; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  f005							; ==============================================================================
      8  f005		       00 00	   BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  f005		       00 01	   BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  f005		       00 02	   BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  f005		       00 03	   BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  f005		       00 04	   BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  f005		       00 05	   BKI_TRANS  =	5	; version header, blank transition frame, attract script
     14  f005		       00 06	   BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  f005		       00 07	   BKI_PROLOGUE =	7	; cave kernel start-up code
     16  f005		       00 04	   BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     17  f005
     18  f005		       1f f4	   BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  f005		       1f f5	   BK_HUD     =	$1FF4 + BKI_HUD
     20  f005		       1f f6	   BK_ROOMS   =	$1FF4 + BKI_ROOMS
     21  f005		       1f f7	   BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     22  f005		       1f f8	   BK_SAVE    =	$1FF4 + BKI_SAVE
     23  f005		       1f f9	   BK_TRANS   =	$1FF4 + BKI_TRANS
     24  f005		       1f fa	   BK_CAVE    =	$1FF4 + BKI_CAVE
     25  f005		       1f fb	   BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     26  f005		       1f f8	   BK_MODELS  =	$1FF4 + BKI_MODELS
