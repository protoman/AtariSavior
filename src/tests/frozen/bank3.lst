    363  f950		       bd 97 f9 	      lda	CrPfx2+1,X
    364  f953		       59 96 f9 	      eor	CrPfx2,Y
    365  f956		       85 8f		      sta	CollisionEndY
    366  f958		       60		      rts
    367  f959
    368  f959							; Prefix tables: P(n) for n pairs from pair 0 — n = 0..10.
    369  f959							; Pair → register: 0-1 PF0 ($30,$C0), 2-5 PF1 ($C0,$30,$0C,$03),
    370  f959							; 6-9 PF2 ($03,$0C,$30,$C0). PF0 maxes at n=2, PF1 at n=6, PF2 at n=10.
    371  f980					      org	$F980
    372  f980				   CrPfx0
    373  f980		       00 30 f0 f0*	      .byte.b	$00, $30, $F0, $F0, $F0, $F0, $F0, $F0, $F0, $F0, $F0
    374  f98b				   CrPfx1
