    156  f0a3							; ==============================================================================
    157  f0a3							; B3StageBand — StageBandTab, MOVED from bank2 (chunk A2, 2026-10-19).
    158  f0a3							;
    159  f0a3							; Tail-entered from bank2 BCFDarkRun at $F3A9:
    160  f0a3							;   jsr PhaseBlink   (stays bank2 — it walks the rect stream)
    161  f0a3							;   sta $1FF9
    162  f0a3							;   jmp $F0A3	      <- OPCODE fetched from THIS bank at $F3AF
    163  f0a3							; so bank3 MUST hold `jmp $F0A3` at $F3AF (pinned at the end of this block).
    164  f0a3							; Zero pushes end to end: this body ends `jmp $FBF8` (ReturnPad), whose
    165  f0a3							; `sta $1FF6 / rts` pops the ORIGINAL bank0 VBL jsr — the chain never nests.
    166  f0a3							;
    167  f0a3							; Reads ZP ONLY: RoomMetaA/B are staged at room entry (bank2 EnterRoomB2),
    168  f0a3							; so no level-data access and therefore no bank2 read tramp is needed.
    169  f0a3							;
    170  f0a3							; Packed meta (bugs.md 28 point 1): MetaA = (m1_col+1)<<4 | band_mask
    171  f0a3							; (b0-2 = band0/1/2 gates); MetaB = ball_col+1 (0 = feature absent).
    172  f0a3							; Expanded every VBL to:
    173  f0a3							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates
    174  f0a3							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 = symmetric -> skip)
    175  f0a3							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    176  f0a3							; Window: this VBL write -> cave read -> bank1 HUD stomps $ED-$EF after the
    177  f0a3							; cave read -> overscan rewrites $88 (joystick) after the ball read.
    178  f0a3							; ==============================================================================
    179  f0a3					      org	$F0A3
    180  f0a3				   B3StageBand
    181  f0a3							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    182  f0a3							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    183  f0a3							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    184  f0a3							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    185  f0a3							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    186  f0a3							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    187  f0a3							; no-ball path below blanks BandTab so it never enables the ball.
    188  f0a3							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    189  f0a3							; the pack uses $8F).
    190  f0a3		       a5 99		      lda	RoomMetaA	; MetaA
    191  f0a5		       29 01		      and	#$01
    192  f0a7		       aa		      tax
    193  f0a8		       bd 5c f1 	      lda	M1OffTab,X
    194  f0ab		       85 92		      sta	RectCount
    195  f0ad		       a5 99		      lda	RoomMetaA	; MetaA
    196  f0af		       4a		      lsr		; band0 bit -> carry
    197  f0b0		       a9 00		      lda	#0
    198  f0b2		       2a		      rol
    199  f0b3		       f0 02		      beq	.SBTb0z
    200  f0b5		       a9 ff		      lda	#$ff
    201  f0b7				   .SBTb0z
    202  f0b7		       85 ed		      sta	BandTab
    203  f0b9		       a5 99		      lda	RoomMetaA
    204  f0bb		       4a		      lsr
    205  f0bc		       4a		      lsr		; band1 bit -> carry
    206  f0bd		       a9 00		      lda	#0
    207  f0bf		       2a		      rol
    208  f0c0		       f0 02		      beq	.SBTb1z
    209  f0c2		       a9 ff		      lda	#$ff
    210  f0c4				   .SBTb1z
    211  f0c4		       85 ee		      sta	BandTab+1
    212  f0c6		       a5 99		      lda	RoomMetaA
    213  f0c8		       4a		      lsr
    214  f0c9		       4a		      lsr
    215  f0ca		       4a		      lsr		; band2 bit -> carry
    216  f0cb		       a9 00		      lda	#0
    217  f0cd		       2a		      rol
    218  f0ce		       f0 02		      beq	.SBTb2z
    219  f0d0		       a9 ff		      lda	#$ff
    220  f0d2				   .SBTb2z
    221  f0d2		       85 ef		      sta	BandTab+2
    222  f0d4							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
    223  f0d4							; set it this overscan) → blank all band gates so the cave renders no
    224  f0d4							; strip; the pack below then emits mask 0 → every overlay stays
    225  f0d4							; transparent too. BandTab restages from ROM next room entry. ---
    226  f0d4		       a5 ba		      lda	EnemyDeadMask
    227  f0d6		       29 08		      and	#$08
    228  f0d8		       f0 08		      beq	.SBTstripAlive
    229  f0da		       a9 00		      lda	#0
    230  f0dc		       85 ed		      sta	BandTab
    231  f0de		       85 ee		      sta	BandTab+1
    232  f0e0		       85 ef		      sta	BandTab+2
    233  f0e2				   .SBTstripAlive
    234  f0e2							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    235  f0e2							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    236  f0e2							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    237  f0e2							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    238  f0e2							; AFTER the cave read, so the alias never crosses a frame boundary.
    239  f0e2							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    240  f0e2							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    241  f0e2							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
    242  f0e2							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
    243  f0e2							; both overlay paths (PHM/blast) treat the strip as gone next frame.
    244  f0e2		       a5 99		      lda	RoomMetaA
    245  f0e4		       4a		      lsr
    246  f0e5		       4a		      lsr
    247  f0e6		       4a		      lsr
    248  f0e7		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
    249  f0e8		       f0 09		      beq	.M1zero
    250  f0ea		       0a		      asl
    251  f0eb		       0a		      asl
    252  f0ec		       0a		      asl		; *8
    253  f0ed		       18		      clc
    254  f0ee		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
    255  f0f0		       4c f5 f0 	      jmp	.M1got
    256  f0f3				   .M1zero
    257  f0f3		       a9 00		      lda	#0
    258  f0f5				   .M1got
    259  f0f5		       85 8e		      sta	CollisionEndX
    260  f0f7		       a5 ba		      lda	EnemyDeadMask
    261  f0f9		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    262  f0fb		       f0 04		      beq	.M1stage
    263  f0fd		       a9 00		      lda	#0
    264  f0ff		       85 8e		      sta	CollisionEndX
    265  f101				   .M1stage
    266  f101							; --- BallX staging: Temp ($88) ---
    267  f101							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    268  f101							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    269  f101							; GONE (user 2026-10-12: door must look like the plain async strip;
    270  f101							; only the key/bomb semantics differ). One write per VBL is the
    271  f101							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    272  f101		       a9 35		      lda	#$35
    273  f103		       85 0a		      sta	CTRLPF
    274  f105		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
    275  f107		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    276  f109							; (vcrunch) AND b6 (hot) — b6 used to survive
    277  f109							; and fake a 1-cell ball at x72-79 on a
    278  f109							; hot-without-ball model
