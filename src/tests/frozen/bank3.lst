    280  f10b		       0a		      asl
    281  f10c		       0a		      asl
    282  f10d		       0a		      asl		; *8
    283  f10e		       18		      clc
    284  f10f		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    285  f111							; calibrated SetObjectXPos arg (S6b: arg A
    286  f111							; draws clocks [A-7, A]; right_col c occupies
    287  f111							; [80+8c, 87+8c]). PHMOverlay recomputes this
    288  f111							; value independently (:1992) — the two MUST
    289  f111							; agree or the stripe draws beside its own
    290  f111							; collision cell (was #86 = +7px ≈ one cell
    291  f111							; right; user-spotted 2026-10-12).
    292  f111		       85 88		      sta	Temp
    293  f113		       4c 20 f1 	      jmp	.SBTballDone
    294  f116				   .SBTnoBall
    295  f116		       a9 00		      lda	#0
    296  f118		       85 88		      sta	Temp
    297  f11a							; --- No ball in this room → BE the ball gate off. ---------------------
    298  f11a							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    299  f11a							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    300  f11a							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    301  f11a							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    302  f11a							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    303  f11a							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    304  f11a		       85 ed		      sta	BandTab
    305  f11c		       85 ee		      sta	BandTab+1
    306  f11e		       85 ef		      sta	BandTab+2
    307  f120				   .SBTballDone
    308  f120							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
    309  f120							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
    310  f120							; (yellow $1C staged below), not width — the 4clk block read as "half
    311  f120							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
    312  f120		       a9 30		      lda	#$30
    313  f122		       85 05		      sta	NUSIZ1
    314  f124							; Door stripe color ($8D) is staged inside PhaseBlink (this window
    315  f124							; is full to the $F4C4 pin — the 14B staging block lives with the
    316  f124							; walk where there is hole).
    317  f124							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
    318  f124							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
    319  f124							; window $F3C4..$F4C4 was full; the data window has the only free
    320  f124							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
    321  f124							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
    322  f124							; it). The PF buffers ARE the collision map (cell walk + laser read
    323  f124							; them) — toggling the cell's two bits THERE makes render + PHM +
    324  f124							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
    325  f124							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
    326  f124							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
    327  f124							; staging above and before the pack below (VcrShutter overwrites
    328  f124							; Temp/BandTab for the shutter cell — running it earlier let SBT's own
    329  f124							; staging erase the shutter, and every crunch kill stopped latching).
    330  f124							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
    331  f124							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
    332  f124							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
    333  f124		       20 5e f4 	      jsr	PhaseBlink
    334  f127				   SBT_B
    335  f127							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
    336  f127							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
    337  f127							; (staged $8E != 0), 0 = symmetric. Cave never
    338  f127							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
    339  f127							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
    340  f127							; kernel's ball block reads it later this VBL).
    341  f127							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
    342  f127							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
    343  f127							; otherwise).
    344  f127		       a5 8e		      lda	CollisionEndX	; staged M1X (kill-gated above)
    345  f129		       f0 02		      beq	.M1nof	; 0 = no M1 → seed 0 (A is 0)
    346  f12b		       a9 08		      lda	#$08	; b3 = M1 present
    347  f12d				   .M1nof
    348  f12d		       85 8f		      sta	CollisionEndY
    349  f12f		       a5 88		      lda	Temp
    350  f131		       f0 26		      beq	.SBTPack	; no ball → keep b3-only (or 0) pack
    351  f133		       38		      sec
    352  f134		       e9 4f		      sbc	#79	; (BallX-79)>>3 = ball_col+1 (BallX =
    353  f136		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
    354  f137		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
    355  f138		       4a		      lsr
    356  f139		       0a		      asl
    357  f13a		       0a		      asl
    358  f13b		       0a		      asl
    359  f13c		       0a		      asl
    360  f13d		       05 8f		      ora	CollisionEndY	; merge with the b3 seed
    361  f13f		       85 8f		      sta	CollisionEndY
    362  f141							; BandTab bytes are $ff/$00 → their bit7 IS the gate.
    363  f141		       a9 00		      lda	#0
    364  f143		       24 ed		      bit	BandTab
    365  f145		       10 02		      bpl	.SBTp0
    366  f147		       09 01		      ora	#$01
    367  f149				   .SBTp0
    368  f149		       24 ee		      bit	BandTab+1
    369  f14b		       10 02		      bpl	.SBTp1
    370  f14d		       09 02		      ora	#$02
    371  f14f				   .SBTp1
    372  f14f		       24 ef		      bit	BandTab+2
    373  f151		       10 02		      bpl	.SBTp2
    374  f153		       09 04		      ora	#$04
    375  f155				   .SBTp2
    376  f155		       05 8f		      ora	CollisionEndY
    377  f157		       85 8f		      sta	CollisionEndY
    378  f159				   .SBTPack
    379  f159		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 VBLANK caller
    380  f15c				   M1OffTab		; Phase 5: MetaA b0 → M1 x-offset (left/right)
    381  f15c		       ff 4f		      .byte.b	$ff, $4f
    382  f15e
