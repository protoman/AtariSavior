    343  f92c							; ==============================================================================
    344  f92c							; CrunchMasks — PF pair-range masks via the prefix tables.
    345  f92c							;   In:  Y = first pair (0-9), X = last pair (0-9, ≥ Y)
    346  f92c							;   Out: LineCount = PF0 mask, CollisionCellX = PF1 mask,
    347  f92c							;	  CollisionEndY = PF2 mask
    348  f92c							;   Clobbers A/X/Y
    349  f92c							; mask(p0..p1) = P(p1+1) & ~P(p0) — P(n) = OR of pairs 0..n-1 per
    350  f92c							; register (CrPfx0/1/2, n = 0..10). Prefix-from-0 callers (hcrunch)
    351  f92c							; skip this and load CrPfx* directly.
    352  f92c							; ==============================================================================
    353  f940					      org	$F940
    354  f940				   CrunchMasks
    355  f940							; Prefix masks are cumulative-disjoint, so P(p1+1) ^ P(p0) ==
    356  f940							; P(p1+1) & ~P(p0) — the XOR form drops 2 insns/register (-21c).
    357  f940		       bd 81 f9 	      lda	CrPfx0+1,X
    358  f943		       59 80 f9 	      eor	CrPfx0,Y
    359  f946		       85 84		      sta	LineCount
    360  f948		       bd 8c f9 	      lda	CrPfx1+1,X
    361  f94b		       59 8b f9 	      eor	CrPfx1,Y
