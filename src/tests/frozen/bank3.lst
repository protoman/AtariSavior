    907  fb2c							; ==============================================================================
    908  fb2c							; PhVcApplyOR / PhVcApplyAND DELETED (2026-10-19) — same retired vcrunch
    909  fb2c							; tramp path. PhHcrEntry now stores the prefix mask directly (fixed 10).
    910  fb2c							; ==============================================================================
    911  fb2c							; ==============================================================================
    912  fb2c							; HcrClock — hcrunch animation clock (fixed full=10 since 2026-10-19).
    913  fb2c							;   In:  X = full extent (cells, ≥1); reads EnemyRamP (StartFrame-pinned)
    914  fb2c							;   Out: A = covered (1..full) — never 0 (always-solid stub)
    915  fb2c							;   Clobbers A (X/Y preserved — unlike CrunchClock). No latch: the kill
    916  fb2c							;   repeats on contact (DropArm respawns at the room top, so no loop).
    917  fb2c							; s = EnemyRamP>>4 (0..15, one 256f period = 16 buckets of 16f):
    918  fb2c							;   s 0-3   dwell at home  (eff 0)	  -> n=1, 64f stub
    919  fb2c							;   s 4-12  grow to center  (eff s-3)	  -> n 2..full (1..9 cells of
    920  fb2c							;	    8px — full=w>>1; w=20 record = center of the screen)
    921  fb2c							;   s 13-15 fast retract    (eff 3*(15-s) = 6,3,0) — wipe home in 3
    922  fb2c							;	    steps (the old instant far-end turn, stretched to center)
    923  fb2c							; covered = 1 + min(eff, full-1). CrunchClock (sc>>2 triangle, ~4f/step)
    924  fb2c							; stays for its VCR mirrors + verify_build token gate — only the two
    925  fb2c							; hcrunch call sites moved here (16f/step, grow-to-center ruling
    926  fb2c							; 2026-10-16). Both callers pass full=10 (PhHcrEntry stages it, HOV
    927  fb2c							; tests it); the latch freeze was removed with the 2026-10-19 contract.
    928  fb2c							; ==============================================================================
    929  fb2c				   HcrClock
    930  fb2c		       e0 01		      cpx	#1
    931  fb2e		       d0 03		      bne	.hcN
    932  fb30		       a9 01		      lda	#1	; full=1: n always 1
    933  fb32		       60		      rts
    934  fb33				   .hcN
    935  fb33		       a5 c2		      lda	EnemyRamP
    936  fb35		       4a		      lsr
    937  fb36		       4a		      lsr
    938  fb37		       4a		      lsr
    939  fb38		       4a		      lsr		; s = P>>4
    940  fb39		       c9 04		      cmp	#4
    941  fb3b		       b0 04		      bcs	.hcNd
    942  fb3d		       a9 00		      lda	#0	; s0-3 dwell: eff 0
    943  fb3f		       f0 11		      beq	.hcOut	; (always)
    944  fb41				   .hcNd
    945  fb41		       c9 0d		      cmp	#13
    946  fb43		       b0 05		      bcs	.hcNf
    947  fb45		       38		      sec
    948  fb46		       e9 03		      sbc	#3	; s4-12: eff = s-3 (1..9) — grow to center
    949  fb48		       b0 08		      bcs	.hcOut	; (always, no borrow)
    950  fb4a				   .hcNf
    951  fb4a		       49 0f		      eor	#$0F	; s13-15: t = 15-s (2,1,0) — fast retract
    952  fb4c		       85 8b		      sta	CollisionX
    953  fb4e		       0a		      asl
    954  fb4f		       18		      clc
