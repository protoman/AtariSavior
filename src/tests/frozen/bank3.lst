    510  f906		       f0 4d		      beq	.HOVstream	; bottom row 0 → box is above the hot band
    511  f908							; Sweep the box's display columns over PF row 1 — the SAME cell store the
    512  f908							; player walk reads (PF0Buf + row + ColOff[X], bit ColMask[X]). Reached
    513  f908							; only from a cell-walk hit, so this is "the wall I bumped is hot".
    514  f908		       a6 8e		      ldx	CollisionEndX	; min col
    515  f90a				   .HOVpfCol
