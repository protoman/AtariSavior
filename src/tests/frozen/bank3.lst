    829  fc77							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    830  fc77							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    831  fc77							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    832  fc77							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    833  fc77							; AFTER the cave read, so the alias never crosses a frame boundary.
    834  fc77							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    835  fc77							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    836  fc77							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
    837  fc77							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
    838  fc77							; both overlay paths (PHM/blast) treat the strip as gone next frame.
    839  fc77		       a5 99		      lda	RoomMetaA
    840  fc79		       4a		      lsr
    841  fc7a		       4a		      lsr
    842  fc7b		       4a		      lsr
    843  fc7c		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
    844  fc7d		       f0 09		      beq	.M1zero
    845  fc7f		       0a		      asl
    846  fc80		       0a		      asl
    847  fc81		       0a		      asl		; *8
    848  fc82		       18		      clc
    849  fc83		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
    850  fc85		       4c 8a fc 	      jmp	.M1got
    851  fc88				   .M1zero
    852  fc88		       a9 00		      lda	#0
    853  fc8a				   .M1got
    854  fc8a		       85 8e		      sta	CollisionEndX
    855  fc8c		       a5 ba		      lda	EnemyDeadMask
    856  fc8e		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    857  fc90		       f0 04		      beq	.M1stage
    858  fc92		       a9 00		      lda	#0
    859  fc94		       85 8e		      sta	CollisionEndX
    860  fc96				   .M1stage
    861  fc96							; --- BallX staging: Temp ($88) ---
    862  fc96							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    863  fc96							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    864  fc96							; GONE (user 2026-10-12: door must look like the plain async strip;
    865  fc96							; only the key/bomb semantics differ). One write per VBL is the
    866  fc96							; cave's value (the HUD's own $05/$35 dance runs after the cave).
