   1339  fae9							; A3 (2026-10-19): the pre-read/return tramp images are gone — PhaseBlink,
   1340  fae9							; VcrShutter, HotOverlapBody and the HOV feature dispatcher all live in
   1341  fae9							; bank3 now, so those paths are plain local jmps. What remains here are the
   1342  fae9							; two ENTRY images fetched after a bank0/bank1 `sta $1FF9`.
   1343  fae9							; ==============================================================================
   1344  fae9		       00 00 00 00*	      .ds	$FBEE - *, 0	; VCS3 return pad (twin of bank2 Bank2ReturnPad)
   1345  fbee		       8d f8 1f 	      sta	$1FF8	; $FBEE — sta executes bank3-side
   1346  fbf1		       60		      rts		; $FBF1 — fetched bank2-side post-switch
   1347  fbf2		       00 00 00 00*	      .ds	$FBF8 - *, 0	; B3StageBand/BuildColupF exit: jmp ReturnPad.
   1348  fbf8				   ReturnPad		;   The `sta $1FF6` runs HERE, the `rts` opcode
   1349  fbf8		       8d f6 1f 	      sta	$1FF6	;   is fetched from bank0 at $FBF9 -> pops the
   1350  fbfb		       60		      rts		;   bank0 VBL/jsr caller.
   1351  fbfc		       00 00 00 00*	      .ds	$FC35 - *, 0	; CallPad_BuildColupF entry image: bank0/bank1
