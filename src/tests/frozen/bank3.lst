   1013  fcb8				   B3StageBand
   1014  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1015  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1016  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1017  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1018  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1019  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1020  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1021  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1022  fcb8							; the pack uses $8F).
   1023  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1024  fcba		       29 01		      and	#$01
   1025  fcbc		       aa		      tax
   1026  fcbd		       bd 6d fd 	      lda	M1OffTab,X
   1027  fcc0		       85 92		      sta	RectCount
   1028  fcc2							; --- band gates: a 4-bit mask -> one $ff/$00 byte per band ------------
   1029  fcc2							; b0-2 = MetaA, b3 = MetaB b4 (N=4, 2026-10-24: MetaA b3 is the left-door
   1030  fcc2							; flag, so the bottom band needs its own bit). The old code unrolled three
   1031  fcc2							; shift/rol/store triples (~16c each); a 16-row x 4 B template copy costs
   1032  fcc2							; about the same and pays for the fourth band inside the VBL budget.
   1033  fcc2							; LineCount ($84) is VBL scratch here — PhaseBlink clobbers it anyway.
   1034  fcc2		       a5 99		      lda	RoomMetaA
   1035  fcc4		       29 07		      and	#$07
   1036  fcc6		       85 84		      sta	LineCount
   1037  fcc8		       a5 9a		      lda	RoomMetaB
   1038  fcca		       29 10		      and	#$10
   1039  fccc		       4a		      lsr		; b4 -> b3
   1040  fccd		       05 84		      ora	LineCount	; 4-bit gate mask
   1041  fccf		       0a		      asl
   1042  fcd0		       0a		      asl		; *4 -> template row
   1043  fcd1		       aa		      tax
   1044  fcd2		       bd 0d ff 	      lda	BandTpl+0,X
   1045  fcd5		       85 cf		      sta	BandTab
   1046  fcd7		       bd 0e ff 	      lda	BandTpl+1,X
   1047  fcda		       85 d0		      sta	BandTab+1
   1048  fcdc		       bd 0f ff 	      lda	BandTpl+2,X
   1049  fcdf		       85 d1		      sta	BandTab+2
   1050  fce1		       bd 10 ff 	      lda	BandTpl+3,X
   1051  fce4		       85 d2		      sta	BandTab+3
   1052  fce6							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
   1053  fce6							; set it this overscan) → blank all band gates so the cave renders no
   1054  fce6							; strip; the pack below then emits mask 0 → every overlay stays
   1055  fce6							; transparent too. BandTab restages from ROM next room entry. ---
   1056  fce6		       a5 ba		      lda	EnemyDeadMask
   1057  fce8		       29 08		      and	#$08
   1058  fcea		       f0 0a		      beq	.SBTstripAlive
   1059  fcec		       a9 00		      lda	#0
   1060  fcee		       85 cf		      sta	BandTab
   1061  fcf0		       85 d0		      sta	BandTab+1
   1062  fcf2		       85 d1		      sta	BandTab+2
