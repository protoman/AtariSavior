     65  f000		       00 82	   PlayerDir  =	$82
     66  f000		       00 84	   LineCount  =	$84	; OverlayTramp gate — packed byte copied
     67  f000							; from $8F at bank1 HUD entry each frame
     68  f000		       00 99	   RoomPF0Lo  =	$99	; TilePF0 pointer INSIDE EnterRoomB2 only.
     69  f000		       00 9a	   RoomPF0Hi  =	$9A	; After the 9-byte PF copy + meta read, entry
