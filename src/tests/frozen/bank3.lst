------- FILE bank3.asm LEVEL 1 PASS 2
      1  fffe					      processor	6502
      2  10000 ????						; ==============================================================================
      3  10000 ????						; Bank3 — power-up stub + Phase-4 crunch body (hcrunch)
      4  10000 ????						; ==============================================================================
      5  10000 ????						; Power-up bank (F6: selected at reset). The 5-byte stub switches to bank0
      6  10000 ????						; and the rest of the 4K was free until Phase 4 (2026-10-13) — bank0 has 1B
      7  10000 ????						; of pre-pad headroom and bank2's gaps are ~130B max, so the crunch PF
      8  10000 ????						; staging + kill bodies (~500B) live HERE, reached by sta $1FF9 tramp pads
      9  10000 ????						; and returned from via sta $1FF8 tails at the $FCC1 pad slots (bank2
     10  10000 ????						; mirrors the jmp images — F6 pad rule; see bank2.asm "Phase 4 bank3
     11  10000 ????						; return pads").
     12  10000 ????						;
     13  10000 ????						; Cross-bank contract (M1ToBank* pattern, 0 pushes — pads never nest):
     14  10000 ????						;   caller tramp @ T: sta $1FF9	  ; switch to bank3
     15  10000 ????						;		       jmp $Fxxx	  ; operand FETCHED bank3-side
     16  10000 ????						;   bank3 @ T+3:      jmp Body 	  ; byte-identical image required
     17  10000 ????						;   body tail:        sta $1FF6/$1FF8	  ; switch back (ReturnPad or pad)
     18  10000 ????						;
     19  10000 ????						; LIVE entry images (the `jmp` fetched after the caller's `sta $1FF9`):
     20  10000 ????						;   $F453  B3RoomBlocks      (bank2 ERBlocksPad, EnterRoom's data half)
     21  10000 ????						;   $FC3B  BuildColupF       (kernel/bank1 CallPad_BuildColupF)
     22  10000 ????						;   $FFEF  HotOverlapBody    (kernel AND bank2 `HotOverlapFlag` at $FFEC)
     23  10000 ????						; Live return tails: B3RoomBlocks `sta $1FF8` at $F458 -> bank2 $F45B;
     24  10000 ????						; everything else exits via bank3 ReturnPad ($FBF8 -> `sta $1FF6` + bank0 rts).
     25  10000 ????						;
     26  10000 ????						; A3/C2 retired the pre-read twins and the $FCC1-$FCD9 return pads: PhaseBlink,
     27  10000 ????						; BuildColupF, HotOverlapBody and the $82 dispatcher all live HERE now, so
     28  10000 ????						; those paths are local jmps (no pad, no switch, no stack shuttle).
     29  10000 ????						;
     30  10000 ????						; ZP EQUs hand-copied from kernel.asm/bank2.asm (check_equ_sync does not
     31  10000 ????						; scan bank3 — keep these correct by hand).
     32  10000 ????						; ==============================================================================
     33  10000 ????				       seg	code
     34  f000					      org	$F000
     35  f000
     36  f000							; --- 5-byte stub (unchanged) ---
