   1032  fc1d							; ------------------------------------------------------------------
   1033  fc1d							; C2 (2026-10-20): B3StageBand + M1OffTab (was bank3 $FC38-$FCF2).
   1034  fc1d							; Called from BCFDarkRun (`jmp B3StageBand`) and bank1's HUD fold; ends
   1035  fc1d							; `jmp ReturnPad`. ZP/TIA only — no level-data read.
   1036  fc1d							; ------------------------------------------------------------------
   1037  fc1d		       00 00 00 00*	      .ds	$FCB8 - *, 0
   1038  fcb8				   B3StageBand
   1039  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1040  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1041  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1042  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1043  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1044  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1045  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1046  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1047  fcb8							; the pack uses $8F).
   1048  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1049  fcba		       29 01		      and	#$01
   1050  fcbc		       aa		      tax
   1051  fcbd		       bd 6f fd 	      lda	M1OffTab,X
   1052  fcc0		       85 92		      sta	RectCount
   1053  fcc2							; --- band gates: a 4-bit mask -> one $ff/$00 byte per band ------------
   1054  fcc2							; b0-2 = MetaA, b3 = MetaB b4 (N=4, 2026-10-24: MetaA b3 is the left-door
   1055  fcc2							; flag, so the bottom band needs its own bit). The old code unrolled three
   1056  fcc2							; shift/rol/store triples (~16c each); a 16-row x 4 B template copy costs
   1057  fcc2							; about the same and pays for the fourth band inside the VBL budget.
   1058  fcc2							; LineCount ($84) is VBL scratch here — PhaseBlink clobbers it anyway.
   1059  fcc2		       a5 99		      lda	RoomMetaA
   1060  fcc4		       29 07		      and	#$07
   1061  fcc6		       85 84		      sta	LineCount
   1062  fcc8		       a5 9a		      lda	RoomMetaB
   1063  fcca		       29 10		      and	#$10
   1064  fccc		       4a		      lsr		; b4 -> b3
   1065  fccd		       05 84		      ora	LineCount	; 4-bit gate mask
   1066  fccf		       0a		      asl
   1067  fcd0		       0a		      asl		; *4 -> template row
   1068  fcd1		       aa		      tax
   1069  fcd2		       bd 0d ff 	      lda	BandTpl+0,X
   1070  fcd5		       85 cf		      sta	BandTab
   1071  fcd7		       bd 0e ff 	      lda	BandTpl+1,X
   1072  fcda		       85 d0		      sta	BandTab+1
   1073  fcdc		       bd 0f ff 	      lda	BandTpl+2,X
   1074  fcdf		       85 d1		      sta	BandTab+2
   1075  fce1		       bd 10 ff 	      lda	BandTpl+3,X
   1076  fce4		       85 d2		      sta	BandTab+3
   1077  fce6							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
   1078  fce6							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
   1079  fce6							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
   1080  fce6							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
   1081  fce6							; AFTER the cave read, so the alias never crosses a frame boundary.
   1082  fce6							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
   1083  fce6							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
   1084  fce6							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
   1085  fce6							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
   1086  fce6							; both overlay paths (PHM/blast) treat the strip as gone next frame.
   1087  fce6		       a5 99		      lda	RoomMetaA
   1088  fce8		       4a		      lsr
   1089  fce9		       4a		      lsr
   1090  fcea		       4a		      lsr
   1091  fceb		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
   1092  fcec		       f0 09		      beq	.M1zero
   1093  fcee		       0a		      asl
   1094  fcef		       0a		      asl
   1095  fcf0		       0a		      asl		; *8
   1096  fcf1		       18		      clc
   1097  fcf2		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   1098  fcf4		       4c f9 fc 	      jmp	.M1got
   1099  fcf7				   .M1zero
   1100  fcf7		       a9 00		      lda	#0
   1101  fcf9				   .M1got
   1102  fcf9		       85 8e		      sta	CollisionEndX
   1103  fcfb		       a5 ba		      lda	EnemyDeadMask
   1104  fcfd		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   1105  fcff		       f0 04		      beq	.M1stage
   1106  fd01		       a9 00		      lda	#0
   1107  fd03		       85 8e		      sta	CollisionEndX
   1108  fd05				   .M1stage
   1109  fd05							; --- BallX staging: Temp ($88) ---
   1110  fd05							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   1111  fd05							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   1112  fd05							; GONE (user 2026-10-12: door must look like the plain async strip;
   1113  fd05							; only the key/bomb semantics differ). One write per VBL is the
   1114  fd05							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   1115  fd05		       a9 35		      lda	#$35
   1116  fd07		       85 0a		      sta	CTRLPF
   1117  fd09		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
   1118  fd0b		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
   1119  fd0d							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
   1120  fd0d							; and fake a 1-cell ball at x72-79 on a
   1121  fd0d							; hot-without-ball model
   1122  fd0d		       f0 0b		      beq	.SBTnoBall
   1123  fd0f		       0a		      asl
   1124  fd10		       0a		      asl
   1125  fd11		       0a		      asl		; *8
   1126  fd12		       18		      clc
   1127  fd13		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
   1128  fd15							; calibrated SetObjectXPos arg (S6b: arg A
   1129  fd15							; draws clocks [A-7, A]; right_col c occupies
   1130  fd15							; [80+8c, 87+8c]). PHMOverlay recomputes this
   1131  fd15							; value independently (:1992) — the two MUST
   1132  fd15							; agree or the stripe draws beside its own
   1133  fd15							; collision cell (was #86 = +7px ≈ one cell
   1134  fd15							; right; user-spotted 2026-10-12).
