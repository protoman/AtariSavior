   1064  fcf6				   .SBTstripAlive
   1065  fcf6							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
   1066  fcf6							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
   1067  fcf6							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
   1068  fcf6							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
   1069  fcf6							; AFTER the cave read, so the alias never crosses a frame boundary.
   1070  fcf6							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
   1071  fcf6							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
   1072  fcf6							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
   1073  fcf6							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
   1074  fcf6							; both overlay paths (PHM/blast) treat the strip as gone next frame.
   1075  fcf6		       a5 99		      lda	RoomMetaA
   1076  fcf8		       4a		      lsr
   1077  fcf9		       4a		      lsr
   1078  fcfa		       4a		      lsr
   1079  fcfb		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
   1080  fcfc		       f0 09		      beq	.M1zero
   1081  fcfe		       0a		      asl
   1082  fcff		       0a		      asl
   1083  fd00		       0a		      asl		; *8
   1084  fd01		       18		      clc
   1085  fd02		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   1086  fd04		       4c 09 fd 	      jmp	.M1got
   1087  fd07				   .M1zero
   1088  fd07		       a9 00		      lda	#0
   1089  fd09				   .M1got
   1090  fd09		       85 8e		      sta	CollisionEndX
   1091  fd0b		       a5 ba		      lda	EnemyDeadMask
   1092  fd0d		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   1093  fd0f		       f0 04		      beq	.M1stage
   1094  fd11		       a9 00		      lda	#0
   1095  fd13		       85 8e		      sta	CollisionEndX
   1096  fd15				   .M1stage
   1097  fd15							; --- BallX staging: Temp ($88) ---
   1098  fd15							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   1099  fd15							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   1100  fd15							; GONE (user 2026-10-12: door must look like the plain async strip;
   1101  fd15							; only the key/bomb semantics differ). One write per VBL is the
   1102  fd15							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   1103  fd15		       a9 35		      lda	#$35
   1104  fd17		       85 0a		      sta	CTRLPF
   1105  fd19		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
   1106  fd1b		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
   1107  fd1d							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
   1108  fd1d							; and fake a 1-cell ball at x72-79 on a
   1109  fd1d							; hot-without-ball model
   1110  fd1d		       f0 0b		      beq	.SBTnoBall
   1111  fd1f		       0a		      asl
   1112  fd20		       0a		      asl
   1113  fd21		       0a		      asl		; *8
   1114  fd22		       18		      clc
   1115  fd23		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
   1116  fd25							; calibrated SetObjectXPos arg (S6b: arg A
   1117  fd25							; draws clocks [A-7, A]; right_col c occupies
   1118  fd25							; [80+8c, 87+8c]). PHMOverlay recomputes this
   1119  fd25							; value independently (:1992) — the two MUST
   1120  fd25							; agree or the stripe draws beside its own
   1121  fd25							; collision cell (was #86 = +7px ≈ one cell
   1122  fd25							; right; user-spotted 2026-10-12).
   1123  fd25		       85 88		      sta	Temp
   1124  fd27		       4c 36 fd 	      jmp	.SBTballDone
