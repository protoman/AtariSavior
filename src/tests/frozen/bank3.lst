    280  f116				   .SBTnoBall
    281  f116		       a9 00		      lda	#0
    282  f118		       85 88		      sta	Temp
    283  f11a							; --- No ball in this room → BE the ball gate off. ---------------------
    284  f11a							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    285  f11a							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    286  f11a							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    287  f11a							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    288  f11a							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    289  f11a							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    290  f11a		       85 ed		      sta	BandTab
    291  f11c		       85 ee		      sta	BandTab+1
    292  f11e		       85 ef		      sta	BandTab+2
    293  f120				   .SBTballDone
    294  f120							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
    295  f120							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
    296  f120							; (yellow $1C staged below), not width — the 4clk block read as "half
    297  f120							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
    298  f120		       a9 30		      lda	#$30
    299  f122		       85 05		      sta	NUSIZ1
    300  f124							; Door stripe color ($8D) is staged inside PhaseBlink (this window
    301  f124							; is full to the $F4C4 pin — the 14B staging block lives with the
    302  f124							; walk where there is hole).
    303  f124							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
    304  f124							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
    305  f124							; window $F3C4..$F4C4 was full; the data window has the only free
    306  f124							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
    307  f124							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
    308  f124							; it). The PF buffers ARE the collision map (cell walk + laser read
    309  f124							; them) — toggling the cell's two bits THERE makes render + PHM +
    310  f124							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
    311  f124							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
    312  f124							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
    313  f124							; staging above and before the pack below (the crunch walk overwrites
    314  f124							; Temp/BandTab for its cell — running it earlier let SBT's own staging
    315  f124							; erase the crunch mask, and every crunch kill stopped latching).
    316  f124							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
    317  f124							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
    318  f124							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
    319  f124		       20 5e f4 	      jsr	PhaseBlink
    320  f127				   SBT_B
    321  f127							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
    322  f127							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
    323  f127							; (staged $8E != 0), 0 = symmetric. Cave never
    324  f127							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
    325  f127							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
    326  f127							; kernel's ball block reads it later this VBL).
    327  f127							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
    328  f127							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
    329  f127							; otherwise).
    330  f127		       a5 8e		      lda	CollisionEndX	; staged M1X (kill-gated above)
    331  f129		       f0 02		      beq	.M1nof	; 0 = no M1 → seed 0 (A is 0)
    332  f12b		       a9 08		      lda	#$08	; b3 = M1 present
    333  f12d				   .M1nof
    334  f12d		       85 8f		      sta	CollisionEndY
    335  f12f		       a5 88		      lda	Temp
    336  f131		       f0 26		      beq	.SBTPack	; no ball → keep b3-only (or 0) pack
    337  f133		       38		      sec
    338  f134		       e9 4f		      sbc	#79	; (BallX-79)>>3 = ball_col+1 (BallX =
    339  f136		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
    340  f137		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
    341  f138		       4a		      lsr
    342  f139		       0a		      asl
    343  f13a		       0a		      asl
    344  f13b		       0a		      asl
    345  f13c		       0a		      asl
    346  f13d		       05 8f		      ora	CollisionEndY	; merge with the b3 seed
    347  f13f		       85 8f		      sta	CollisionEndY
    348  f141							; BandTab bytes are $ff/$00 → their bit7 IS the gate.
    349  f141		       a9 00		      lda	#0
    350  f143		       24 ed		      bit	BandTab
    351  f145		       10 02		      bpl	.SBTp0
    352  f147		       09 01		      ora	#$01
    353  f149				   .SBTp0
    354  f149		       24 ee		      bit	BandTab+1
    355  f14b		       10 02		      bpl	.SBTp1
    356  f14d		       09 02		      ora	#$02
    357  f14f				   .SBTp1
    358  f14f		       24 ef		      bit	BandTab+2
    359  f151		       10 02		      bpl	.SBTp2
    360  f153		       09 04		      ora	#$04
    361  f155				   .SBTp2
    362  f155		       05 8f		      ora	CollisionEndY
    363  f157		       85 8f		      sta	CollisionEndY
    364  f159				   .SBTPack
    365  f159		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 VBLANK caller
    366  f15c				   M1OffTab		; Phase 5: MetaA b0 → M1 x-offset (left/right)
    367  f15c		       ff 4f		      .byte.b	$ff, $4f
