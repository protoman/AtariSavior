    328  f127							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
    329  f127							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
    330  f127							; (staged $8E != 0), 0 = symmetric. Cave never
    331  f127							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
    332  f127							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
    333  f127							; kernel's ball block reads it later this VBL).
    334  f127							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
    335  f127							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
    336  f127							; otherwise).
    337  f127		       a5 8e		      lda	CollisionEndX	; staged M1X (kill-gated above)
    338  f129		       f0 02		      beq	.M1nof	; 0 = no M1 → seed 0 (A is 0)
    339  f12b		       a9 08		      lda	#$08	; b3 = M1 present
    340  f12d				   .M1nof
    341  f12d		       85 8f		      sta	CollisionEndY
    342  f12f		       a5 88		      lda	Temp
    343  f131		       f0 26		      beq	.SBTPack	; no ball → keep b3-only (or 0) pack
    344  f133		       38		      sec
    345  f134		       e9 4f		      sbc	#79	; (BallX-79)>>3 = ball_col+1 (BallX =
    346  f136		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
    347  f137		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
    348  f138		       4a		      lsr
    349  f139		       0a		      asl
    350  f13a		       0a		      asl
    351  f13b		       0a		      asl
    352  f13c		       0a		      asl
    353  f13d		       05 8f		      ora	CollisionEndY	; merge with the b3 seed
    354  f13f		       85 8f		      sta	CollisionEndY
    355  f141							; BandTab bytes are $ff/$00 → their bit7 IS the gate.
    356  f141		       a9 00		      lda	#0
    357  f143		       24 ed		      bit	BandTab
    358  f145		       10 02		      bpl	.SBTp0
    359  f147		       09 01		      ora	#$01
    360  f149				   .SBTp0
    361  f149		       24 ee		      bit	BandTab+1
    362  f14b		       10 02		      bpl	.SBTp1
    363  f14d		       09 02		      ora	#$02
    364  f14f				   .SBTp1
    365  f14f		       24 ef		      bit	BandTab+2
    366  f151		       10 02		      bpl	.SBTp2
    367  f153		       09 04		      ora	#$04
    368  f155				   .SBTp2
    369  f155		       05 8f		      ora	CollisionEndY
    370  f157		       85 8f		      sta	CollisionEndY
    371  f159				   .SBTPack
    372  f159		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 VBLANK caller
    373  f15c				   M1OffTab		; Phase 5: MetaA b0 → M1 x-offset (left/right)
    374  f15c		       ff 4f		      .byte.b	$ff, $4f
