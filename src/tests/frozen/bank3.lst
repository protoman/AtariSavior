    875  fca0		       0a		      asl
    876  fca1		       0a		      asl
    877  fca2		       0a		      asl		; *8
    878  fca3		       18		      clc
    879  fca4		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    880  fca6							; calibrated SetObjectXPos arg (S6b: arg A
    881  fca6							; draws clocks [A-7, A]; right_col c occupies
    882  fca6							; [80+8c, 87+8c]). PHMOverlay recomputes this
    883  fca6							; value independently (:1992) — the two MUST
    884  fca6							; agree or the stripe draws beside its own
    885  fca6							; collision cell (was #86 = +7px ≈ one cell
    886  fca6							; right; user-spotted 2026-10-12).
    887  fca6		       85 88		      sta	Temp
    888  fca8		       4c b5 fc 	      jmp	.SBTballDone
    889  fcab				   .SBTnoBall
    890  fcab		       a9 00		      lda	#0
    891  fcad		       85 88		      sta	Temp
    892  fcaf							; --- No ball in this room → BE the ball gate off. ---------------------
    893  fcaf							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    894  fcaf							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    895  fcaf							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    896  fcaf							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    897  fcaf							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    898  fcaf							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    899  fcaf		       85 ed		      sta	BandTab
    900  fcb1		       85 ee		      sta	BandTab+1
    901  fcb3		       85 ef		      sta	BandTab+2
    902  fcb5				   .SBTballDone
    903  fcb5							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
    904  fcb5							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
    905  fcb5							; (yellow $1C staged below), not width — the 4clk block read as "half
    906  fcb5							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
    907  fcb5		       a9 30		      lda	#$30
    908  fcb7		       85 05		      sta	NUSIZ1
    909  fcb9							; Door stripe color ($8D) is staged inside PhaseBlink (this window
    910  fcb9							; is full to the $F4C4 pin — the 14B staging block lives with the
    911  fcb9							; walk where there is hole).
    912  fcb9							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
    913  fcb9							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
    914  fcb9							; window $F3C4..$F4C4 was full; the data window has the only free
    915  fcb9							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
    916  fcb9							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
    917  fcb9							; it). The PF buffers ARE the collision map (cell walk + laser read
    918  fcb9							; them) — toggling the cell's two bits THERE makes render + PHM +
    919  fcb9							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
    920  fcb9							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
    921  fcb9							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
    922  fcb9							; staging above and before the pack below (the crunch walk overwrites
    923  fcb9							; Temp/BandTab for its cell — running it earlier let SBT's own staging
    924  fcb9							; erase the crunch mask, and every crunch kill stopped latching).
    925  fcb9							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
    926  fcb9							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
    927  fcb9							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
