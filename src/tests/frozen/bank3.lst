     60  f008		       00 9a	   RoomMetaB  =	$9A
     61  f008		       00 90	   RoomRectsLo =	$90	; rect stream ptr (bank2 EnterRoomB2 stages)
     62  f008		       00 91	   RoomRectsHi =	$91
     63  f008		       00 89	   RcBase     =	$89	; rect count for the ZP walk cache
     64  f008		       00 cc	   RcW1       =	$CC	; uniform 4B rect cache
     65  f008		       00 98	   RoomNo     =	$98
     66  f008		       00 aa	   LevelWallColor =	$AA	; BuildColupF stripe rows 0+2
     67  f008		       00 ab	   LevelWallColor2 =	$AB	; stripe row 1
     68  f008		       00 ad	   TickCounter =	$AD	; hot-pulse phase bit 4
     69  f008		       00 e7	   ColupfBuf  =	$E7
     70  f008		       00 00	   COLOR_CAVE_BG =	$00
     71  f008		       00 04	   COLOR_DARK_PF =	$04
     72  f008		       00 1c	   COLOR_HOT_Y =	$1C
     73  f008		       00 44	   COLOR_HOT_R =	$44
     74  f008		       00 03	   TILE_ROWS  =	3
     75  f008		       00 b5	   BombPacked =	$B5
     76  f008		       00 c0	   LaserState =	$C0
     77  f008		       00 c1	   EnemyRamD  =	$C1
     78  f008		       00 ed	   BandTab    =	$ED	; band gate bytes (B3StageBand writes)
     79  f008		       00 0a	   CTRLPF     =	$0A	; TIA (ball width $35 during staging)
     80  f008		       00 05	   NUSIZ1     =	$05	; TIA (P1 single, M1 8 clk)
     81  f008
     82  f008							; ==============================================================================
     83  f008							; B3StageBand — StageBandTab, MOVED from bank2 (chunk A2, 2026-10-19).
     84  f008							;
     85  f008							; Entered by LOCAL `jmp B3StageBand` from .BCFdarkDone (BCFDarkRun/PhaseBlink
     86  f008							; all live in THIS bank since A3), so no entry image or pin is needed any
     87  f008							; more: the old `.byte $4C,<B3StageBand` image at $F3AC was dead and got
     88  f008							; deleted with this relocation (repack chunk 5, 2026-10-20). The body moved
     89  f008							; from $F0A3 to $FC38 so the level-data window could start at $F0A3 (+189 B
     90  f008							; of headroom for generated blocks).
     91  f008							; Zero pushes end to end: this body ends `jmp $FBF8` (ReturnPad), whose
     92  f008							; `sta $1FF6 / rts` pops the ORIGINAL bank0 VBL jsr — the chain never nests.
     93  f008							;
     94  f008							; Reads ZP ONLY: RoomMetaA/B are staged at room entry (bank2 EnterRoomB2),
     95  f008							; so no level-data access and therefore no bank2 read tramp is needed.
     96  f008							;
     97  f008							; Packed meta (bugs.md 28 point 1): MetaA = (m1_col+1)<<4 | band_mask
     98  f008							; (b0-2 = band0/1/2 gates); MetaB = ball_col+1 (0 = feature absent).
     99  f008							; Expanded every VBL to:
    100  f008							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates
    101  f008							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 = symmetric -> skip)
    102  f008							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    103  f008							; Window: this VBL write -> cave read -> bank1 HUD stomps $ED-$EF after the
    104  f008							; cave read -> overscan rewrites $88 (joystick) after the ball read.
    105  f008							; ==============================================================================
    106  f008							; --- A3 level data (2026-10-19): shared model blocks + every per-room
    107  f008							;     PF/meta block. Emitted by convert_level --levels into
    108  f008							;     generated/spill_bank3.asm; bank2 keeps only the room TABLES (they
    109  f008							;     resolve these labels through generated/bank3_labels.asm).
    110  f008							;     Window moved from $F160 to $F0A3 (repack chunk 5, 2026-10-20) after
    111  f008							;     B3StageBand left for $FC38: 777 B of window, ~304 B used.
    112  f0a3					      org	$F0A3
