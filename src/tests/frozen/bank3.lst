   1316  ff4d							; ------------------------------------------------------------------
   1317  ff4d							; C2 (2026-10-20): HOVFeatEntry (was bank3 $FA40) — the $80 phase / $82
   1318  ff4d							; hcrunch dispatch for .HOVfeature; fields read from FetchPtr in-bank.
   1319  ff4d							; ------------------------------------------------------------------
   1320  ff4d		       00 00 00 00*	      .ds	$FF59 - *, 0
   1321  ff59				   HOVFeatEntry
   1322  ff59							; .HOVfeature dispatch. IN: A = record class, Y = record base,
   1323  ff59							; FetchPtr = record stream (all same-bank since A3). No field pre-read and
   1324  ff59							; no stack: fields are read at (FetchPtr),base+1..4 as needed. Returns to
   1325  ff59							; HOVnext / HOVlegHit (both pop the .HOVloop base) or HOVafterGate ($80,
   1326  ff59							; which needs Y = base — the $80 path never touches Y).
   1327  ff59		       c9 80		      cmp	#$80
   1328  ff5b		       d0 03		      bne	.HFnotPhase
   1329  ff5d		       4c ba ff 	      jmp	.HFphase	; (far trampoline; Y = base preserved)
   1330  ff60				   .HFnotPhase
   1331  ff60		       b1 e5		      lda	(FetchPtr),Y	; class byte
   1332  ff62		       c9 82		      cmp	#$82
   1333  ff64		       f0 03		      beq	.HFh_begin
   1334  ff66		       4c b7 ff 	      jmp	.HFmiss	; $81 and unknown classes are inert
   1335  ff69				   .HFh_begin
   1336  ff69
   1337  ff69							; ---------------- $82 hcrunch: band row from the record, fixed 10-cell prefix
   1338  ff69							; The record's band byte is the crunch row: 1 (band 2) or 2 (band 3), chosen
   1339  ff69							; by the generator from how the player first enters the room (user
   1340  ff69							; 2026-10-28). Prefix = always 10 cells (record x/w/h ignored). ALWAYS HOT
   1341  ff69							; from the SIDES: any overlap of the player box with the covered prefix
   1342  ff69							; kills, at any phase/extent. A VERTICAL touch is a plain wall: the feet
   1343  ff69							; reach the band's first line (landing on it) or the head its last line
   1344  ff69							; (bumping it from below). The walk steps 1 px at a time, so the first
   1345  ff69							; overlapping pixel is exact. A hot room's band 2 never gets here: the hot
   1346  ff69							; sweep in HotOverlapBody already killed.
   1347  ff69		       c8		      iny
   1348  ff6a		       c8		      iny
   1349  ff6b		       b1 e5		      lda	(FetchPtr),Y	; B = crunch row (1/2)
   1350  ff6d		       aa		      tax
   1351  ff6e		       c5 8d		      cmp	CollisionCellY
   1352  ff70		       90 45		      bcc	.HFmissD	; top row below the band → miss
   1353  ff72		       e4 8f		      cpx	CollisionEndY
   1354  ff74		       f0 02		      beq	.HFin
   1355  ff76		       b0 3f		      bcs	.HFmissD	; bottom row above the band → miss
   1356  ff78				   .HFin
   1357  ff78		       a5 9c		      lda	Hover
   1358  ff7a		       d0 3b		      bne	.HFmissD	; parked after a death: the prefix is harmless
   1359  ff7c		       a5 ba		      lda	EnemyDeadMask
   1360  ff7e		       30 37		      bmi	.HFmissD	; spent: it already killed him this visit
   1361  ff80		       a0 24		      ldy	#HCR_BAND_H
   1362  ff82		       e0 02		      cpx	#2
   1363  ff84		       90 02		      bcc	.HFb1
   1364  ff86		       a0 48		      ldy	#2*HCR_BAND_H	; first line of the band (36 or 72)
   1365  ff88				   .HFb1
   1366  ff88		       84 8b		      sty	CollisionX
   1367  ff8a		       a5 81		      lda	RoomY
   1368  ff8c		       18		      clc
   1369  ff8d		       69 15		      adc	#PLAYER_SPRITE_H - 1	; feet line
   1370  ff8f		       c5 8b		      cmp	CollisionX
   1371  ff91		       f0 24		      beq	.HFmissD	; feet on the first line: standing on it
   1372  ff93		       a5 81		      lda	RoomY
   1373  ff95		       38		      sec
   1374  ff96		       e9 23		      sbc	#HCR_BAND_H - 1	; head line - 35
   1375  ff98		       c5 8b		      cmp	CollisionX
   1376  ff9a		       f0 1b		      beq	.HFmissD	; head on the last line: touching from below
   1377  ff9c		       a2 0a		      ldx	#10
   1378  ff9e		       20 32 fb 	      jsr	HcrClock	; A = n covered cells; X/Y preserved
   1379  ffa1		       0a		      asl		; 2n = covered 4px cols from col 0
   1380  ffa2		       c5 8e		      cmp	CollisionEndX	; covered_w vs min col (strict >)
   1381  ffa4		       90 05		      bcc	.HFmissJ
   1382  ffa6		       f0 03		      beq	.HFmissJ
   1383  ffa8		       4c ae ff 	      jmp	.HFkill
   1384  ffab
   1385  ffab				   .HFmissJ
   1386  ffab		       4c b7 ff 	      jmp	.HFmissD
   1387  ffae
   1388  ffae				   .HFkill
   1389  ffae		       a5 ba		      lda	EnemyDeadMask
