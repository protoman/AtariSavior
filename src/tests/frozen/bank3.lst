    870  fc9c		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    871  fc9e							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
    872  fc9e							; and fake a 1-cell ball at x72-79 on a
    873  fc9e							; hot-without-ball model
