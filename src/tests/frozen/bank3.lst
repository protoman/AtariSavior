------- FILE bank3.asm
    193  f043		       00 00 00 00*	      .ds	$F453 - *, 0	; bank2's $F450 `sta $1FF7` fetch target
    194  f453							; ==============================================================================
    195  f453							; B3RoomBlocks — shape → PF0Buf + staged meta/extras (C7: bank2 tail-jumps
    196  f453							; here; ends `jmp ReturnPad`).
    197  f453							;
    198  f453							; Shape block (C11 2026-10-21) = EXACTLY 3 row-pool indices (band 0/1/2).
    199  f453							; Band 1's index byte carries b7 = mid_band_type (hot): hot cells only ever
    200  f453							; exist on model row 1, so the flag rides that band and the block needs no
    201  f453							; flags byte. MetaA/MetaB are NOT in the block: an owns-extras room reads its
    202  f453							; pair (+patches+features) from the level's async extras stream; every other
    203  f453							; room derives MetaA = 0 and MetaB = $40 iff the shape is hot.
    204  f453							; ==============================================================================
    205  f453				   B3RoomBlocks
    206  f453							; SHAPE STEP MOVED TO BANK7 (2026-11-10): the shape table, blocks and row pool
    207  f453							; live in bank7's big free area (this bank's 747 B window capped the library
    208  f453							; at ~100 shapes). `sta $1FFB` selects bank7 whose bytes at +3 are
    209  f453							; `jmp ShapeStep7`; it expands the shape into PF0Buf/PF1Buf/PF2Buf, stages
    210  f453							; RoomMetaB (hot flag) and ends with `sta $1FF7` at +6, so the next fetch
    211  f453							; (+9) is B3Meta below. FetchPtr/X/Y/A are scratch across the hop.
    212  f453		       8d f8 1f 	      sta	BK_MODELS
    213  f456		       00 00 00 	      .byte.b	0,0,0	; bank7: jmp ShapeStep7
    214  f459		       00 00 00 	      .byte.b	0,0,0	; bank7: sta $1FF7
    215  f45c				   B3Meta
    216  f45c							; C11: no stream by default - a room only gets one from its extras record
    217  f45c							; (feature records). RoomMetaB/RoomM1Hot are staged by bank7 / ExtrasLoad.
    218  f45c							; RoomRects points at a static $00 count byte so the walkers (overscan
    219  f45c							; HotOverlapBody / VBL PhaseBlink) read "empty stream", never TIA.
    220  f45c		       a9 00		      lda	#0
    221  f45e		       85 af		      sta	RoomM1Hot
    222  f460		       a9 b7		      lda	#<RoomNoStream
    223  f462		       85 90		      sta	RoomRectsLo
    224  f464		       a9 f8		      lda	#>RoomNoStream
    225  f466		       85 91		      sta	RoomRectsHi
    226  f468
    227  f468							; --- C5 meta source: the room's extras ordinal (LevelConnSpare, staged by
    228  f468							;     EnterRoomB2, 0 = none) -> the extras stream; otherwise MetaA = 0 and
    229  f468							;     MetaB = $40 iff the shape is hot (staged by bank7's ShapeStep7).
    230  f468		       a5 a2		      lda	LevelConnSpare
    231  f46a		       d0 07		      bne	.EBextras
    232  f46c		       a9 00		      lda	#0
    233  f46e		       85 99		      sta	RoomMetaA
    234  f470		       4c 89 f5 	      jmp	ERLoadDone
    235  f473				   .EBextras
    236  f473		       4c 76 f4 	      jmp	ExtrasLoad
    237  f476
    238  f476							; --- C5/C7: async extras loader (record layout: tools/convert_level.py) ---
    239  f476							; The stream lives in THIS bank, so the room's record is reached from the
    240  f476							; generated per-level base (LevExtrasLo/Hi) + the ordinal bank2 staged in
    241  f476							; LevelConnSpare. No counts-column sum here (that column is bank2 data).
    242  f476				   ExtrasLoad
