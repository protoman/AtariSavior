    143  f0a3							; B3StageBand — StageBandTab, MOVED from bank2 (chunk A2, 2026-10-19).
    144  f0a3							;
    145  f0a3							; Tail-entered from bank2 BCFDarkRun at $F3A9:
    146  f0a3							;   jsr PhaseBlink   (stays bank2 — it walks the rect stream)
    147  f0a3							;   sta $1FF9
    148  f0a3							;   jmp $F0A3	      <- OPCODE fetched from THIS bank at $F3AF
    149  f0a3							; so bank3 MUST hold `jmp $F0A3` at $F3AF (pinned at the end of this block).
    150  f0a3							; Zero pushes end to end: this body ends `jmp $FBF8` (ReturnPad), whose
    151  f0a3							; `sta $1FF6 / rts` pops the ORIGINAL bank0 VBL jsr — the chain never nests.
    152  f0a3							;
    153  f0a3							; Reads ZP ONLY: RoomMetaA/B are staged at room entry (bank2 EnterRoomB2),
    154  f0a3							; so no level-data access and therefore no bank2 read tramp is needed.
    155  f0a3							;
    156  f0a3							; Packed meta (bugs.md 28 point 1): MetaA = (m1_col+1)<<4 | band_mask
    157  f0a3							; (b0-2 = band0/1/2 gates); MetaB = ball_col+1 (0 = feature absent).
    158  f0a3							; Expanded every VBL to:
    159  f0a3							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates
    160  f0a3							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 = symmetric -> skip)
    161  f0a3							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    162  f0a3							; Window: this VBL write -> cave read -> bank1 HUD stomps $ED-$EF after the
    163  f0a3							; cave read -> overscan rewrites $88 (joystick) after the ball read.
    164  f0a3							; ==============================================================================
    165  f0a3					      org	$F0A3
    166  f0a3				   B3StageBand
    167  f0a3							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    168  f0a3							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    169  f0a3							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    170  f0a3							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    171  f0a3							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    172  f0a3							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    173  f0a3							; no-ball path below blanks BandTab so it never enables the ball.
    174  f0a3							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    175  f0a3							; the pack uses $8F).
    176  f0a3		       a5 99		      lda	RoomMetaA	; MetaA
    177  f0a5		       29 01		      and	#$01
    178  f0a7		       aa		      tax
    179  f0a8		       bd 5c f1 	      lda	M1OffTab,X
    180  f0ab		       85 92		      sta	RectCount
    181  f0ad		       a5 99		      lda	RoomMetaA	; MetaA
    182  f0af		       4a		      lsr		; band0 bit -> carry
    183  f0b0		       a9 00		      lda	#0
    184  f0b2		       2a		      rol
    185  f0b3		       f0 02		      beq	.SBTb0z
    186  f0b5		       a9 ff		      lda	#$ff
    187  f0b7				   .SBTb0z
    188  f0b7		       85 ed		      sta	BandTab
    189  f0b9		       a5 99		      lda	RoomMetaA
    190  f0bb		       4a		      lsr
    191  f0bc		       4a		      lsr		; band1 bit -> carry
    192  f0bd		       a9 00		      lda	#0
    193  f0bf		       2a		      rol
    194  f0c0		       f0 02		      beq	.SBTb1z
    195  f0c2		       a9 ff		      lda	#$ff
    196  f0c4				   .SBTb1z
    197  f0c4		       85 ee		      sta	BandTab+1
    198  f0c6		       a5 99		      lda	RoomMetaA
    199  f0c8		       4a		      lsr
    200  f0c9		       4a		      lsr
    201  f0ca		       4a		      lsr		; band2 bit -> carry
    202  f0cb		       a9 00		      lda	#0
    203  f0cd		       2a		      rol
    204  f0ce		       f0 02		      beq	.SBTb2z
    205  f0d0		       a9 ff		      lda	#$ff
    206  f0d2				   .SBTb2z
