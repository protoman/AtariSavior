    208  f0d4							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
    209  f0d4							; set it this overscan) → blank all band gates so the cave renders no
    210  f0d4							; strip; the pack below then emits mask 0 → every overlay stays
    211  f0d4							; transparent too. BandTab restages from ROM next room entry. ---
    212  f0d4		       a5 ba		      lda	EnemyDeadMask
    213  f0d6		       29 08		      and	#$08
    214  f0d8		       f0 08		      beq	.SBTstripAlive
    215  f0da		       a9 00		      lda	#0
