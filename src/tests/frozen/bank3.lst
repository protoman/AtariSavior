     90  f008							; ==============================================================================
     91  f008							; HcrPush — cold growth push (user 2026-10-16): while the hcrunch prefix
     92  f008							; ADVANCES it shoves the player toward center, so a cold shutter cannot
     93  f008							; trap them inside (hot = kill semantics, unchanged). Called from
     94  f008							; PhHcrEntry on the 16f grow-step edge (EnemyRamP & $0F == 0) with the
     95  f008							; spent (b7) latch filtered; this body re-checks the phase (s4-12).
     96  f008							; In:	CollisionX = 8n (prefix width px), CollisionCellX = band (0-2),
     97  f008							;	Y = hot (full MetaB byte, bank2-staged; masked here). Out: RoomX
     98  f008							;	clamped out of the left prefix [0,8n) / the TIA mirror [160-8n,160);
     99  f008							;	A/X/Y + CollisionX clobbered.
    100  f008							; ==============================================================================
    101  f010					      org	$F010
    102  f010				   HcrPush
    103  f010		       98		      tya		; hot (MetaB b6, $40/0 — bank2-side, passed in Y)
    104  f011		       29 40		      and	#$40
    105  f013		       d0 40		      bne	.Hpd	; hot: kill semantics own it — no push
    106  f015		       a5 c2		      lda	EnemyRamP
    107  f017		       4a		      lsr
    108  f018		       4a		      lsr
    109  f019		       4a		      lsr
    110  f01a		       4a		      lsr		; s = P>>4
    111  f01b		       c9 04		      cmp	#4
    112  f01d		       90 36		      bcc	.Hpd	; s0-3 dwell: stub static, no push
    113  f01f		       c9 0d		      cmp	#13
    114  f021		       b0 32		      bcs	.Hpd	; s13-15 retract: opening, no push
    115  f023		       a6 8c		      ldx	CollisionCellX
    116  f025		       18		      clc
    117  f026		       a5 81		      lda	RoomY
    118  f028		       69 0b		      adc	#11	; PLAYER_SPRITE_H-1
    119  f02a		       38		      sec
    120  f02b		       fd a0 f0 	      sbc	HcrBandLo,X	; bottom - band_lo (0/48/96)
    121  f02e		       90 25		      bcc	.Hpd	; entirely above the band
    122  f030		       c9 3b		      cmp	#59	; 48+11: bottom-band_lo >= 59 → entirely below
    123  f032		       b0 21		      bcs	.Hpd
    124  f034		       a5 8b		      lda	CollisionX	; 8n
    125  f036		       c9 50		      cmp	#80
    126  f038		       b0 1b		      bcs	.Hpd	; sealed (n>=10): no aperture — HOVhcrunch kills
    127  f03a		       18		      clc
    128  f03b		       69 07		      adc	#7	; aperture_lo = 8n+7
    129  f03d		       c5 80		      cmp	RoomX
    130  f03f		       90 04		      bcc	.Hrr	; clear of the left prefix
    131  f041		       f0 02		      beq	.Hrr	; flush = clear
    132  f043		       85 80		      sta	RoomX	; left overlap: clamp right
    133  f045				   .Hrr
    134  f045		       a5 8b		      lda	CollisionX	; 8n
    135  f047		       18		      clc
    136  f048		       65 80		      adc	RoomX
    137  f04a		       c9 a0		      cmp	#160
