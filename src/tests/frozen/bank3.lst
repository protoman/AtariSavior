    992  fcb8				   B3StageBand
    993  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    994  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    995  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    996  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    997  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    998  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    999  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1000  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1001  fcb8							; the pack uses $8F).
   1002  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1003  fcba		       29 01		      and	#$01
   1004  fcbc		       aa		      tax
   1005  fcbd		       bd 6d fd 	      lda	M1OffTab,X
   1006  fcc0		       85 92		      sta	RectCount
   1007  fcc2							; --- band gates: a 4-bit mask -> one $ff/$00 byte per band ------------
   1008  fcc2							; b0-2 = MetaA, b3 = MetaB b4 (N=4, 2026-10-24: MetaA b3 is the left-door
   1009  fcc2							; flag, so the bottom band needs its own bit). The old code unrolled three
   1010  fcc2							; shift/rol/store triples (~16c each); a 16-row x 4 B template copy costs
   1011  fcc2							; about the same and pays for the fourth band inside the VBL budget.
   1012  fcc2							; LineCount ($84) is VBL scratch here — PhaseBlink clobbers it anyway.
   1013  fcc2		       a5 99		      lda	RoomMetaA
   1014  fcc4		       29 07		      and	#$07
   1015  fcc6		       85 84		      sta	LineCount
   1016  fcc8		       a5 9a		      lda	RoomMetaB
   1017  fcca		       29 10		      and	#$10
   1018  fccc		       4a		      lsr		; b4 -> b3
   1019  fccd		       05 84		      ora	LineCount	; 4-bit gate mask
   1020  fccf		       0a		      asl
   1021  fcd0		       0a		      asl		; *4 -> template row
   1022  fcd1		       aa		      tax
   1023  fcd2		       bd 0d ff 	      lda	BandTpl+0,X
   1024  fcd5		       85 cf		      sta	BandTab
   1025  fcd7		       bd 0e ff 	      lda	BandTpl+1,X
   1026  fcda		       85 d0		      sta	BandTab+1
   1027  fcdc		       bd 0f ff 	      lda	BandTpl+2,X
   1028  fcdf		       85 d1		      sta	BandTab+2
   1029  fce1		       bd 10 ff 	      lda	BandTpl+3,X
   1030  fce4		       85 d2		      sta	BandTab+3
   1031  fce6							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
   1032  fce6							; set it this overscan) → blank all band gates so the cave renders no
   1033  fce6							; strip; the pack below then emits mask 0 → every overlay stays
   1034  fce6							; transparent too. BandTab restages from ROM next room entry. ---
   1035  fce6		       a5 ba		      lda	EnemyDeadMask
   1036  fce8		       29 08		      and	#$08
   1037  fcea		       f0 0a		      beq	.SBTstripAlive
   1038  fcec		       a9 00		      lda	#0
   1039  fcee		       85 cf		      sta	BandTab
