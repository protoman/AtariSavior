------- FILE bank3.asm LEVEL 1 PASS 2
      1  10000					       processor	6502
      2  10000 ????				       seg	code
      3  f000					      org	$F000
      4  f000							; ==============================================================================
      5  f000							; Bank3 — level-data SHAPES + the walkers that read them (C7 2026-10-20)
      6  f000							; ==============================================================================
      7  f000							; The level-data subsystem is SPLIT (docs/level_format_plan_2026-10-20.md §7):
      8  f000							;
      9  f000							;   bank2  level entries (LevelDataTable) + room tables (shapes/positions/
     10  f000							;	    counts) + enemy records + the EXTRAS ORDINAL — and every walker
     11  f000							;	    that reads THOSE (EnterRoomB2, exits, LoadLevelB2, moth, LWC/LHT,
     12  f000							;	    bomb blast). Their data is only ever read in-bank.
     13  f000							;   bank3  shape blocks + row pool + LEVEL_ShapeTable + the async EXTRAS
     14  f000							;	    streams + this file's walkers (B3RoomBlocks/ExtrasLoad,
     15  f000							;	    PhaseBlink/PhRec/BuildColupF/BCFDarkRun, HotOverlapBody,
     16  f000							;	    B3StageBand, PhHcrEntry/CrPfx/HcrClock, HOVFeatEntry).
     17  f000							;
     18  f000							; Why the extras move too: a feature room's hot stream lives INSIDE its
     19  f000							; extras record and is walked every VBL by PhaseBlink/BuildColupF/
     20  f000							; HotOverlapBody — a direct `lda (FetchPtr),Y` in the caller's bank (a fold
     21  f000							; would cost 25c on the VBL path). Record walkers and record data must share
     22  f000							; a bank, so the extras stream belongs with the shapes.
     23  f000							;
     24  f000							; Cross-bank contract (the ONLY one this file has):
     25  f000							;   bank2 EnterRoomB2 stages the ROM shapes byte in RoomPF0Lo ($99, loader
     26  f000							;   scratch) and, for an owns-extras room, the 1-based ordinal in
     27  f000							;   LevelConnSpare ($A2), then executes `sta $1FF9` at $F450. The opcode
     28  f000							;   fetch at $F453 already comes from THIS bank, so B3RoomBlocks MUST start
     29  f000							;   at $F453 (`check_bank3_entry` pins it). Every exit is `jmp ReturnPad`
     30  f000							;   ($FBF8 in this bank: `sta $1FF6`, rts fetched from bank0) — no return
     31  f000							;   pad, no twin, 0 extra stack pushes.
     32  f000							;
     33  f000							; `Level` ($A3) indexes this bank's per-level extras base table
     34  f000							; (LevExtrasLo/Hi, generated), so no counts-column arithmetic happens here.
     35  f000							; ==============================================================================
     36  f000
     37  f000		       00 e5	   FetchPtr   =	$E5	; must match kernel.asm (operand baked in;
     38  f000							; moved S3.2 from $E0 — frees $E0 for
     39  f000							; rect4.h in the uniform rect cache)
     40  f000		       00 02	   WSYNC      =	$02	; TIA — values must match kernel.asm (equ-sync)
     41  f000		       00 04	   NUSIZ0     =	$04
     42  f000		       00 05	   NUSIZ1     =	$05
     43  f000		       00 06	   COLUP0     =	$06
     44  f000		       00 07	   COLUP1     =	$07
     45  f000		       00 09	   COLUBK     =	$09	; kernel line 41
     46  f000		       00 0b	   REFP0      =	$0B	; kernel line 43
     47  f000		       00 48	   COLOR_PLAYER =	$48	; must match kernel.asm
     48  f000		       00 10	   RESP0      =	$10
     49  f000		       00 11	   RESP1      =	$11
     50  f000		       00 20	   HMP0       =	$20	; TIA — for the SetObjectXPos_t2 title copy
     51  f000		       00 21	   HMP1       =	$21
     52  f000		       00 12	   RESM0      =	$12
     53  f000		       00 13	   RESM1      =	$13
     54  f000		       00 1b	   GRP0       =	$1B
     55  f000		       00 1c	   GRP1       =	$1C
     56  f000		       00 1d	   ENAM0      =	$1D
     57  f000		       00 1e	   ENAM1      =	$1E
     58  f000		       00 1f	   ENABL      =	$1F
     59  f000		       00 0a	   CTRLPF     =	$0A
     60  f000		       00 25	   VDELP0     =	$25
     61  f000		       00 26	   VDELP1     =	$26
