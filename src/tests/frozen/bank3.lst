   1391  ffb2		       85 ba		      sta	EnemyDeadMask
   1392  ffb4		       4c ad f9 	      jmp	HOVlegHit	; loop Y still on the stack (popped there)
   1393  ffb7				   .HFmissD
   1394  ffb7				   .HFmiss
