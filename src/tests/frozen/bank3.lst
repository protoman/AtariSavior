    752  fe1b		       a5 94		      lda	vyHi
    753  fe1d		       30 03		      bmi	.RaftNoRide	; rising: let him fly away (no pin)
    754  fe1f		       4c 2b fe 	      jmp	.RaftGo
    755  fe22				   .RaftNoRide
    756  fe22							; nobody over the raft: PARK it (no motion) and clear the ramp state so the
    757  fe22							; next take-off ramps again; the bomb count in b2-0 is preserved
    758  fe22		       a5 f0		      lda	$F0
    759  fe24		       29 07		      and	#%00000111
    760  fe26		       85 f0		      sta	$F0
