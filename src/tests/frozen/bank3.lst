    296  f8fd							; ==============================================================================
    297  f8fd							; CrunchClock — ping-pong shutter clock (VCR mirrors + retired
    298  f8fd							; PhVcrEntry; the two hcrunch call sites moved to HcrClock 2026-10-16).
    299  f8fd							;   In:  X = full extent (cells, ≥1)
    300  f8fd							;   Out: A = covered (1..full) — never 0 (always-solid stub)
    301  f8fd							;   Clobbers A/X/Y (callers save what they need)
    302  f8fd							; sc = EnemyRamP>>2 (0..63); triangle tri = sc<32 ? sc : 63-sc (0..31..0);
    303  f8fd							; dwell: effective = max(0, tri-4) — a ~16f flat bottom at home (both
    304  f8fd							; ends of the sc wrap land in the dwell zone). covered = 1+min(eff,
    305  f8fd							; full-1). Sweep: eff climbs 0..27 over tri 4..31 = 28 sc steps × 4f ≈
    306  f8fd							; 112f out + 112f back + dwell — tunable via the #4/#32 constants
    307  f8fd							; (user CHECK: eyeball speed, 2026-10-13).
    308  f8fd							; ==============================================================================
    309  f900					      org	$F900
    310  f900				   CrunchClock
    311  f900		       e0 01		      cpx	#1
    312  f902		       d0 03		      bne	.ccNorm
    313  f904		       a9 01		      lda	#1	; full==1: covered is always 1 — skip the clock
    314  f906		       60		      rts
    315  f907				   .ccNorm
    316  f907		       a5 c2		      lda	EnemyRamP
    317  f909		       4a		      lsr
    318  f90a		       4a		      lsr		; sc 0..63
    319  f90b		       c9 20		      cmp	#32
    320  f90d		       90 02		      bcc	.ccF
    321  f90f		       49 3f		      eor	#$3F	; sc>=32: 63-sc (sc^63 — high bits don't overlap)
    322  f911				   .ccF
    323  f911		       c9 04		      cmp	#4
    324  f913		       90 02		      bcc	.ccZ	; dwell: tri<4 → 0
    325  f915		       e9 04		      sbc	#4	; C=1 from cmp
    326  f917				   .ccZ
    327  f917		       a8		      tay		; Y = eff
    328  f918		       8a		      txa
    329  f919		       38		      sec
    330  f91a		       e9 01		      sbc	#1	; A = full-1
    331  f91c		       48		      pha		; (stack as the min() temp — no ZP free)
