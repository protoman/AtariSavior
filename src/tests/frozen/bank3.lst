    131  f0a3							; PhVcrEntry — PhaseBlink $81 (vcrunch) tramp target.
    132  f0a3							; Record: $81, x (4px col), y (row), w (4px), h (rows). The covered TOP
    133  f0a3							; rows of the bbox keep/set their pair bits (shutter closed), the open
    134  f0a3							; rows clear them (shutter retracted). covered_h = CrunchClock(h) —
    135  f0a3							; ping-pong with a dwell at the home stub (always ≥1 row: never gone,
    136  f0a3							; user ruling 2026-10-13). Y = record class on entry; tail leaves
    137  f0a3							; Y = base+2 for PhNext. Clobbers A/X/Y + LineCount/CCX/CEY.
    138  f0a3							; ==============================================================================
    139  f0a3							; ==============================================================================
    140  f0a3							; PhVcrEntry RETIRED (2026-10-19) — bank2's PhVcrPre tail-jmps VcrShutter
    141  f0a3							; (bank2) since the Phase-B rework; no tramp targets $F800 anymore (the
    142  f0a3							; $FB57/$FE67 images are legacy fill). The whole $F800-$F87F block is free
    143  f0a3							; for data. Vcrunch's live path = bank2 VcrShutter (PF punch + Temp/BandTab)
    144  f0a3							; + bank3 VCS3 (kill); CrunchClock/CrunchMasks/PhVcApply* remain for it.
    145  f0a3							; ==============================================================================
    146  f0a3							; ==============================================================================
    147  f0a3							; PhHcrEntry — PhaseBlink $82 (hcrunch) tramp target.
    148  f0a3							; Record: $82, 0, band (row), w (4px = 2*cells), 1. Single-row band
    149  f0a3							; prefix from col 0: cells 0..n-1 covered (n = HcrClock(full)), the
    150  f0a3							; rest of the full bbox cleared. PF = (row & ~P(full)) | P(n) — fused in
    151  f0a3							; ONE pass (P(n) ⊆ P(full), so AND-then-OR collapses; one pass halves the
    152  f0a3							; buffer reads). Y = class on entry; tail leaves Y = base+2. Clobbers
    153  f0a3							; A/X/Y + LineCount/CCX/CEY.
    154  f0a3							; ==============================================================================
    155  f880					      org	$F880
    156  f880				   PhHcrEntry
    157  f880							; Entered from bank2 PhHcrPre: stack (top→) = h, w, y(band), x, <caller>.
    158  f880							; Hot (MetaB b6) is staged bank2-side in LineCount ($84) and read HERE,
    159  f880							; right after HcrClock, BEFORE the mask staging reuses LineCount. The
    160  f880							; push is deliberately the FIRST thing after n: it only needs n + band +
    161  f880							; hot, and reordering keeps the 4-field stack contract (no 5th push) so
    162  f880							; bank2's tramp stays aligned with this bank's twin.
    163  f880							; Y = base+4 on entry; saved for the .PhRec return.
    164  f880		       98		      tya
    165  f881		       48		      pha		; [base+4]
    166  f882		       ba		      tsx
    167  f883		       bd 04 01 	      lda	$0104,X	; y = band
    168  f886		       48		      pha		; [base+4, band]
    169  f887		       ba		      tsx
    170  f888		       bd 04 01 	      lda	$0104,X	; w
    171  f88b		       4a		      lsr		; full cells (w is even, 2*cells)
    172  f88c		       48		      pha		; [base+4, band, full]
    173  f88d		       aa		      tax		; X = full
    174  f88e		       20 a1 f9 	      jsr	HcrClock	; A = n covered cells (1..full); b7 → 1 (spent)
    175  f891		       48		      pha		; [base+4, band, full, n]
    176  f892							; cold growth push (user 2026-10-16). Split from the staging (option A):
    177  f892							; on the 16f grow-step edge (EnemyRamP & $0F == 0) we PUSH and SKIP the
    178  f892							; staging; every other frame we STAGE and never push. The PF buffer then
    179  f892							; shows last frame's prefix for the one step frame (the shutter renders
    180  f892							; one frame late on a step — invisible at 16f/step), but the ~90c staging
    181  f892							; and the ~65c push never share a frame, so the worst VBL is base +
    182  f892							; max(staging, push) instead of the sum (the flicker fix). Spent (b7)
    183  f892							; always stages (freeze at stub) and never pushes.
    184  f892		       a5 c2		      lda	EnemyRamP
    185  f894		       29 0f		      and	#$0F
    186  f896		       d0 1d		      bne	.HcStage	; not the step edge → stage the shutter
    187  f898		       a5 ba		      lda	EnemyDeadMask
    188  f89a		       29 80		      and	#$80
    189  f89c		       d0 17		      bne	.HcStage	; spent: stage the stub, never push
    190  f89e		       ba		      tsx
    191  f89f		       bd 03 01 	      lda	$0103,X	; band
    192  f8a2		       85 8c		      sta	CollisionCellX
    193  f8a4		       bd 01 01 	      lda	$0101,X	; n
    194  f8a7		       0a		      asl
    195  f8a8		       0a		      asl
    196  f8a9		       0a		      asl		; 8n (prefix width px) — HcrPush's only ext input
    197  f8aa		       85 8b		      sta	CollisionX
    198  f8ac		       a5 84		      lda	LineCount	; hot (MetaB b6, $40/0) — bank2 staged it
    199  f8ae		       a8		      tay		; Y = hot
    200  f8af		       20 10 f0 	      jsr	HcrPush
    201  f8b2		       4c f1 f8 	      jmp	.HcDrain	; push frame: skip the staging (see above)
    202  f8b5				   .HcStage
    203  f8b5							; Fused bbox-open + prefix-close, ONE band row (h is always 1 for $82):
    204  f8b5							;   PF[row] = (PF[row] & ~P(full)) | P(n)
    205  f8b5							; ~P(full) staged in LineCount/CCX/CEY; P(n) read from CrPfx*,Y inline.
    206  f8b5							; One pass replaces ApplyAND-then-ApplyOR (same result — P(n) ⊆ P(full)
    207  f8b5							; — but half the buffer reads); frees ~50c of the hcrunch VBL.
    208  f8b5		       ba		      tsx
    209  f8b6		       bc 02 01 	      ldy	$0102,X	; full
    210  f8b9		       b9 80 f9 	      lda	CrPfx0,Y
    211  f8bc		       49 ff		      eor	#$FF
    212  f8be		       85 84		      sta	LineCount
    213  f8c0		       b9 8b f9 	      lda	CrPfx1,Y
    214  f8c3		       49 ff		      eor	#$FF
    215  f8c5		       85 8c		      sta	CollisionCellX
    216  f8c7		       b9 96 f9 	      lda	CrPfx2,Y
    217  f8ca		       49 ff		      eor	#$FF
    218  f8cc		       85 8f		      sta	CollisionEndY
    219  f8ce		       ba		      tsx
    220  f8cf		       bc 01 01 	      ldy	$0101,X	; n → CrPfx index
    221  f8d2		       bd 03 01 	      lda	$0103,X	; band
    222  f8d5		       aa		      tax		; X = PF buffer row index
    223  f8d6		       b5 c3		      lda	PF0Buf,X
    224  f8d8		       25 84		      and	LineCount
    225  f8da		       19 80 f9 	      ora	CrPfx0,Y
    226  f8dd		       95 c3		      sta	PF0Buf,X
    227  f8df		       b5 c6		      lda	PF0Buf+3,X
    228  f8e1		       25 8c		      and	CollisionCellX
    229  f8e3		       19 8b f9 	      ora	CrPfx1,Y
    230  f8e6		       95 c6		      sta	PF0Buf+3,X
    231  f8e8		       b5 c9		      lda	PF0Buf+6,X
    232  f8ea		       25 8f		      and	CollisionEndY
    233  f8ec		       19 96 f9 	      ora	CrPfx2,Y
    234  f8ef		       95 c9		      sta	PF0Buf+6,X
    235  f8f1				   .HcDrain
    236  f8f1		       68		      pla		; n
    237  f8f2		       68		      pla		; full
