------- FILE bank3.asm
    191  f043		       00 00 00 00*	      .ds	$F453 - *, 0	; bank2's $F450 `sta $1FF7` fetch target
    192  f453							; ==============================================================================
    193  f453							; B3RoomBlocks — shape → PF0Buf + staged meta/extras (C7: bank2 tail-jumps
    194  f453							; here; ends `jmp ReturnPad`).
    195  f453							;
    196  f453							; Shape block (C11 2026-10-21) = EXACTLY 3 row-pool indices (band 0/1/2).
    197  f453							; Band 1's index byte carries b7 = mid_band_type (hot): hot cells only ever
    198  f453							; exist on model row 1, so the flag rides that band and the block needs no
    199  f453							; flags byte. MetaA/MetaB are NOT in the block: an owns-extras room reads its
    200  f453							; pair (+patches+features) from the level's async extras stream; every other
    201  f453							; room derives MetaA = 0 and MetaB = $40 iff the shape is hot.
    202  f453							; ==============================================================================
    203  f453				   B3RoomBlocks
    204  f453							; C7: the shape ADDRESS comes from THIS bank's LEVEL_ShapeTable, so bank2
    205  f453							; needs no bank3 label and no symbol export. RoomPF0Lo = the raw shapes
