    767  fa7f		       00 00 00 00*	      .ds	$FBF8 - *, 0	; B3StageBand/BuildColupF exit: jmp ReturnPad.
    768  fbf8				   ReturnPad		;   The `sta $1FF6` runs HERE, the `rts` opcode
    769  fbf8		       8d f6 1f 	      sta	$1FF6	;   is fetched from bank0 at $FBF9 -> pops the
    770  fbfb		       60		      rts		;   bank0 VBL/jsr caller.
