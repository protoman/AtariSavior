   1076  fd15							; --- BallX staging: Temp ($88) ---
   1077  fd15							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   1078  fd15							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   1079  fd15							; GONE (user 2026-10-12: door must look like the plain async strip;
   1080  fd15							; only the key/bomb semantics differ). One write per VBL is the
   1081  fd15							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   1082  fd15		       a9 35		      lda	#$35
   1083  fd17		       85 0a		      sta	CTRLPF
   1084  fd19		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
   1085  fd1b		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
   1086  fd1d							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
   1087  fd1d							; and fake a 1-cell ball at x72-79 on a
   1088  fd1d							; hot-without-ball model
   1089  fd1d		       f0 0b		      beq	.SBTnoBall
   1090  fd1f		       0a		      asl
   1091  fd20		       0a		      asl
   1092  fd21		       0a		      asl		; *8
   1093  fd22		       18		      clc
   1094  fd23		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
   1095  fd25							; calibrated SetObjectXPos arg (S6b: arg A
   1096  fd25							; draws clocks [A-7, A]; right_col c occupies
   1097  fd25							; [80+8c, 87+8c]). PHMOverlay recomputes this
   1098  fd25							; value independently (:1992) — the two MUST
   1099  fd25							; agree or the stripe draws beside its own
   1100  fd25							; collision cell (was #86 = +7px ≈ one cell
   1101  fd25							; right; user-spotted 2026-10-12).
   1102  fd25		       85 88		      sta	Temp
   1103  fd27		       4c 36 fd 	      jmp	.SBTballDone
