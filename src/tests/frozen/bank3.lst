   1105  fd2a		       a9 00		      lda	#0
   1106  fd2c		       85 88		      sta	Temp
   1107  fd2e							; --- No ball in this room → BE the ball gate off. ---------------------
   1108  fd2e							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
   1109  fd2e							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
   1110  fd2e							; flag — a door has no ball, so its bit0 must NOT enable one. Before
   1111  fd2e							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
   1112  fd2e							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
   1113  fd2e							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
   1114  fd2e		       85 cf		      sta	BandTab
   1115  fd30		       85 d0		      sta	BandTab+1
   1116  fd32		       85 d1		      sta	BandTab+2
   1117  fd34		       85 d2		      sta	BandTab+3
   1118  fd36				   .SBTballDone
   1119  fd36							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
   1120  fd36							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
   1121  fd36							; (yellow $1C staged below), not width — the 4clk block read as "half
   1122  fd36							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
   1123  fd36		       a9 30		      lda	#$30
   1124  fd38		       85 05		      sta	NUSIZ1
   1125  fd3a							; Door stripe color ($8D) is staged inside PhaseBlink (this window
   1126  fd3a							; was full to the $F4C4 pin, retired 2026-10-20 — the 14B staging
   1127  fd3a							; block lives with the walk where there is hole).
   1128  fd3a							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
   1129  fd3a							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
   1130  fd3a							; window $F3C4..$F4C4 was full; the data window has the only free
   1131  fd3a							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
   1132  fd3a							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
   1133  fd3a							; it). The PF buffers ARE the collision map (cell walk + laser read
   1134  fd3a							; them) — toggling the cell's two bits THERE makes render + PHM +
   1135  fd3a							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
   1136  fd3a							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
