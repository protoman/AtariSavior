    847  fc77							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    848  fc77							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    849  fc77							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    850  fc77							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    851  fc77							; AFTER the cave read, so the alias never crosses a frame boundary.
    852  fc77							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    853  fc77							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    854  fc77							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
