   1175  fd3c							; Door stripe color ($8D) is staged inside PhaseBlink (this window
   1176  fd3c							; was full to the $F4C4 pin, retired 2026-10-20 — the 14B staging
   1177  fd3c							; block lives with the walk where there is hole).
   1178  fd3c							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
   1179  fd3c							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
   1180  fd3c							; window $F3C4..$F4C4 was full; the data window has the only free
   1181  fd3c							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
   1182  fd3c							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
   1183  fd3c							; it). The PF buffers ARE the collision map (cell walk + laser read
   1184  fd3c							; them) — toggling the cell's two bits THERE makes render + PHM +
   1185  fd3c							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
   1186  fd3c							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
   1187  fd3c							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
   1188  fd3c							; staging above and before the pack below (the crunch walk overwrites
   1189  fd3c							; Temp/BandTab for its cell — running it earlier let SBT's own staging
   1190  fd3c							; erase the crunch mask, and every crunch kill stopped latching).
   1191  fd3c							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
   1192  fd3c							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
   1193  fd3c							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
   1194  fd3c		       20 d9 f9 	      jsr	PhaseBlink
   1195  fd3f				   SBT_B
   1196  fd3f							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
   1197  fd3f							; b4-b7 = right_col+1, b0-3 = the four ball band gates, 0 = symmetric.
   1198  fd3f							; When NO band is gated, b3 carries the M1-present flag instead, so an
   1199  fd3f							; M1-ONLY room still packs nonzero (the kernel's OverlayTramp gates on
   1200  fd3f							; LineCount != 0 — no M1 cross otherwise). The two uses cannot collide:
   1201  fd3f							; with a gate set, OvShutBand's mask comes from OvHead/OvTail, and a
   1202  fd3f							; player box in band 3 matches b3 only when a band-3 strip is drawn.
   1203  fd3f							; Cave never writes $8F; bank1 HUD entry copies it to LineCount ($84 —
   1204  fd3f							; cave .Row clobbers it) before overscan PHM reads. BallX in Temp stays
   1205  fd3f							; raw (the kernel's ball block reads it later this VBL).
   1206  fd3f							; Gate mask, rebuilt from the same two metas (PhaseBlink sits between the
   1207  fd3f							; staging and this pack and clobbers every other VBL scratch byte).
   1208  fd3f							; Temp = 0 means the room has NO ball column, so every gate is off —
   1209  fd3f							; that also keeps a DOOR room's MetaA b0 (the m1_right flag) from
   1210  fd3f							; reading as a band-0 gate.
   1211  fd3f		       a5 88		      lda	Temp
   1212  fd41		       f0 0f		      beq	.SBTmask0
   1213  fd43		       a5 99		      lda	RoomMetaA
   1214  fd45		       29 07		      and	#$07
   1215  fd47		       85 84		      sta	LineCount
   1216  fd49		       a5 9a		      lda	RoomMetaB
   1217  fd4b		       29 10		      and	#$10
   1218  fd4d		       4a		      lsr
   1219  fd4e		       05 84		      ora	LineCount
   1220  fd50		       d0 06		      bne	.SBTmask	; a gate is painted → keep the 4 bits
   1221  fd52				   .SBTmask0
   1222  fd52		       a5 8e		      lda	CollisionEndX	; no ball band: M1-only rooms need a nonzero
   1223  fd54		       f0 02		      beq	.SBTmask	;   pack (0 = nothing to overlay at all)
   1224  fd56		       a9 08		      lda	#$08	; b3 = M1 present
   1225  fd58				   .SBTmask
   1226  fd58		       85 8f		      sta	CollisionEndY
   1227  fd5a		       a5 88		      lda	Temp
   1228  fd5c		       f0 0e		      beq	.SBTPack	; no ball → keep the gate/M1 byte
   1229  fd5e		       38		      sec
   1230  fd5f		       e9 4f		      sbc	#79	; (BallX-79)>>3 = ball_col+1 (BallX =
   1231  fd61		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
   1232  fd62		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
   1233  fd63		       4a		      lsr
   1234  fd64		       0a		      asl
   1235  fd65		       0a		      asl
   1236  fd66		       0a		      asl
   1237  fd67		       0a		      asl
   1238  fd68		       05 8f		      ora	CollisionEndY
   1239  fd6a		       85 8f		      sta	CollisionEndY
   1240  fd6c				   .SBTPack
