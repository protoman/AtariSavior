   1171  fd50				   .SBTmask0
   1172  fd50		       a5 8e		      lda	CollisionEndX	; no ball band: M1-only rooms need a nonzero
   1173  fd52		       f0 02		      beq	.SBTmask	;   pack (0 = nothing to overlay at all)
   1174  fd54		       a9 08		      lda	#$08	; b3 = M1 present
