     84  f000		       00 bc	   RoomBandColor =	$BC	; band-color cache (kernel EQU, S3.1)
     85  f000		       00 cf	   BandTab    =	$CF	; N=4 band gate bytes ($CF-$D2) — staged here,
     86  f000							; read by kernel .Row in bank0
     87  f000		       00 c7	   PF1Buf     =	$C7	; N=4 stride-4 PF row buffers (kernel twins)
     88  f000		       00 cb	   PF2Buf     =	$CB
     89  f000		       00 8b	   CollisionX =	$8B
     90  f000		       00 8c	   CollisionCellX =	$8C	; max text column
     91  f000		       00 8d	   CollisionCellY =	$8D	; top tile row
     92  f000		       00 8e	   CollisionEndX =	$8E	; min text column
     93  f000		       00 8f	   CollisionEndY =	$8F	; bottom tile row
     94  f000		       00 92	   RectCount  =	$92
     95  f000		       00 b1	   EnemyDataLo =	$B1	; record base — restaged before every exit
     96  f000		       00 b2	   EnemyDataHi =	$B2
     97  f000		       00 b5	   BombPacked =	$B5	; b3-6 WallMask (destroyed rect skip)
     98  f000		       00 f6	   BombX      =	$F6	; hand-copy kernel EQU — title: 68 = no bomb,
     99  f000							;   140 = armed (TitleKernel P1 SOXP reads it)
    100  f000		       00 f7	   BombTimer  =	$F7	; hand-copy kernel EQU — title fuse/explode
    101  f000		       00 b9	   EnemyIndex =	$B9	; slot save around the col swap + rect walk
    102  f000							; (LevelStartRoom hand-copy retired 2026-10-20:
    103  f000							;   its readers OvM1Block/OvShutBand moved to
    104  f000							;   bank0, which reads the byte natively)
    105  f000		       00 ba	   EnemyDeadMask =	$BA	; b0-2 enemy kills; b3 = ball strip
    106  f000							; destroyed (bank1 StripBlastCheck); b4 = M1
    107  f000							; strip destroyed (M1StripBlast) — check_equ_sync
    108  f000							; pairs this with kernel's decl)
    109  f000		       00 bd	   EnemyRamX  =	$BD
    110  f000		       00 c0	   LaserState =	$C0	; b5-2 = RoomDarkMask rooms 4-7 (BCFDarkRun)
    111  f000		       00 c1	   EnemyRamD  =	$C1	; dir bits: 1 = right, 0 = left
    112  f000		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock
    113  f000		       00 e2	   EnemyRamY  =	$E2	; live Y (refreshed this overscan — after
    114  f000							; the bank1 HUD score-ptr stomp; S3.4)
    115  f000		       00 14	   TILE_COLUMNS =	20
    116  f000		       00 81	   RoomY      =	$81	; player Y — LaserHitTest vertical window
    117  f000		       00 c3	   PF0Buf     =	$C3	; PF render buffers rows 0-2 ($C3-$CF) —
    118  f000							; cell map read here; must match kernel.asm
    119  f000		       00 82	   PlayerDir  =	$82	; must match kernel.asm — S6 LWC tip direction
    120  f000		       00 b3	   EnemyCount =	$B3	; LaserHitTest loop bound
