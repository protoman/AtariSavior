    777  fe38							; --- take-off ramp (inertia): heaviest right after boarding -------------
    778  fe38							; State = PlayerBombs' ($F0) spare HIGH bits: b7 = "ridden last frame",
    779  fe38							; b6-b3 = the ramp level (0-15); b2-0 stay the bomb count. Adding $10 never
    780  fe38							; carries into b2-0, and the drop's `dec` is guarded by a non-zero count so
    781  fe38							; it cannot borrow upward either (see the kernel EQU for the contract).
    782  fe38							; Riding advances the level every 2nd frame: the raft leaves at 0.5 px/frame
    783  fe38							; and reaches the full 0.75 px/frame after ~30 frames (~0.5 s), the
    784  fe38							; heavy take-off. Empty (b7 clear) or level 15: full speed straight away.
    785  fe38		       a5 f0		      lda	$F0
    786  fe3a		       10 0b		      bpl	.RaftAtSpeed	; b7 clear = nobody aboard -> no ramp
    787  fe3c		       c9 f8		      cmp	#%11111000	; flag + all four level bits = spun up
    788  fe3e		       f0 07		      beq	.RaftAtSpeed
    789  fe40		       a5 c2		      lda	EnemyRamP
