------- FILE bank3.asm
------- FILE banks.inc LEVEL 2 PASS 2
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  10000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  10000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  10000 ????						;
      6  10000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  10000 ????						; ==============================================================================
      8  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  10000 ????		00 01	    BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  10000 ????		00 02	    BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  10000 ????		00 03	    BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  10000 ????		00 05	    BKI_TRANS  =	5	; version header, blank transition frame, attract script
     14  10000 ????		00 06	    BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  10000 ????		00 07	    BKI_PROLOGUE =	7	; cave kernel start-up code
     16  10000 ????		00 04	    BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     17  10000 ????
     18  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  10000 ????		1f f5	    BK_HUD     =	$1FF4 + BKI_HUD
     20  10000 ????		1f f6	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     21  10000 ????		1f f7	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     22  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     23  10000 ????		1f f9	    BK_TRANS   =	$1FF4 + BKI_TRANS
     24  10000 ????		1f fa	    BK_CAVE    =	$1FF4 + BKI_CAVE
     25  10000 ????		1f fb	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     26  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
------- FILE bank3.asm
      4  10000 ????				       seg	code
      5  f000					      org	$F000
      6  f000							; ==============================================================================
      7  f000							; Bank3 — level-data SHAPES + the walkers that read them (C7 2026-10-20)
      8  f000							; ==============================================================================
      9  f000							; The level-data subsystem is SPLIT (docs/level_format_plan_2026-10-20.md §7):
     10  f000							;
     11  f000							;   bank2  level entries (LevelDataTable) + room tables (shapes/positions/
     12  f000							;	    counts) + enemy records + the EXTRAS ORDINAL — and every walker
     13  f000							;	    that reads THOSE (EnterRoomB2, exits, LoadLevelB2, moth, LWC/LHT,
     14  f000							;	    bomb blast). Their data is only ever read in-bank.
     15  f000							;   bank3  shape blocks + row pool + LEVEL_ShapeTable + the async EXTRAS
     16  f000							;	    streams + this file's walkers (B3RoomBlocks/ExtrasLoad,
     17  f000							;	    PhaseBlink/PhRec/BuildColupF/BCFDarkRun, HotOverlapBody,
     18  f000							;	    B3StageBand, PhHcrEntry/CrPfx/HcrClock, HOVFeatEntry).
     19  f000							;
     20  f000							; Why the extras move too: a feature room's hot stream lives INSIDE its
     21  f000							; extras record and is walked every VBL by PhaseBlink/BuildColupF/
     22  f000							; HotOverlapBody — a direct `lda (FetchPtr),Y` in the caller's bank (a fold
     23  f000							; would cost 25c on the VBL path). Record walkers and record data must share
     24  f000							; a bank, so the extras stream belongs with the shapes.
     25  f000							;
     26  f000							; Cross-bank contract (the ONLY one this file has):
     27  f000							;   bank2 EnterRoomB2 stages the ROM shapes byte in RoomPF0Lo ($99, loader
     28  f000							;   scratch) and, for an owns-extras room, the 1-based ordinal in
     29  f000							;   LevelConnSpare ($A2), then executes `sta $1FF7` at $F450. The opcode
     30  f000							;   fetch at $F453 already comes from THIS bank, so B3RoomBlocks MUST start
     31  f000							;   at $F453 (`check_bank3_entry` pins it). Every exit is `jmp ReturnPad`
     32  f000							;   ($FBF8 in this bank: `sta $1FF4`, rts fetched from bank0) — no return
     33  f000							;   pad, no twin, 0 extra stack pushes.
     34  f000							;
     35  f000							; `Level` ($A3) indexes this bank's per-level extras base table
     36  f000							; (LevExtrasLo/Hi, generated), so no counts-column arithmetic happens here.
     37  f000							; ==============================================================================
     38  f000
     39  f000		       00 e5	   FetchPtr   =	$E5	; must match kernel.asm (operand baked in;
     40  f000							; moved S3.2 from $E0 — frees $E0 for
