   1077  fd16							; --- BallX staging: Temp ($88) ---
   1078  fd16							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   1079  fd16							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   1080  fd16							; GONE (user 2026-10-12: door must look like the plain async strip;
   1081  fd16							; only the key/bomb semantics differ). One write per VBL is the
   1082  fd16							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   1083  fd16		       a9 35		      lda	#$35
   1084  fd18		       85 0a		      sta	CTRLPF
   1085  fd1a		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
   1086  fd1c		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
   1087  fd1e							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
   1088  fd1e							; and fake a 1-cell ball at x72-79 on a
   1089  fd1e							; hot-without-ball model
   1090  fd1e		       f0 0b		      beq	.SBTnoBall
   1091  fd20		       0a		      asl
   1092  fd21		       0a		      asl
   1093  fd22		       0a		      asl		; *8
   1094  fd23		       18		      clc
   1095  fd24		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
   1096  fd26							; calibrated SetObjectXPos arg (S6b: arg A
   1097  fd26							; draws clocks [A-7, A]; right_col c occupies
   1098  fd26							; [80+8c, 87+8c]). PHMOverlay recomputes this
   1099  fd26							; value independently (:1992) — the two MUST
   1100  fd26							; agree or the stripe draws beside its own
   1101  fd26							; collision cell (was #86 = +7px ≈ one cell
   1102  fd26							; right; user-spotted 2026-10-12).
   1103  fd26		       85 88		      sta	Temp
   1104  fd28		       4c 35 fd 	      jmp	.SBTballDone
   1105  fd2b				   .SBTnoBall
   1106  fd2b		       a9 00		      lda	#0
   1107  fd2d		       85 88		      sta	Temp
   1108  fd2f							; --- No ball in this room → BE the ball gate off. ---------------------
   1109  fd2f							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
   1110  fd2f							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
   1111  fd2f							; flag — a door has no ball, so its bit0 must NOT enable one. Before
   1112  fd2f							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
   1113  fd2f							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
   1114  fd2f							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
   1115  fd2f		       85 ed		      sta	BandTab
   1116  fd31		       85 ee		      sta	BandTab+1
   1117  fd33		       85 ef		      sta	BandTab+2
