------- FILE bank3.asm LEVEL 1 PASS 1
      1  0000					      processor	6502
      2  0000 ????						; ==============================================================================
      3  0000 ????						; Bank3 — boot stub ONLY (C3 2026-10-20: the payload moved to bank2)
      4  0000 ????						; ==============================================================================
      5  0000 ????						; Power-up bank (F6: the latch is undefined at power-up, so ANY bank can be the
      6  0000 ????						; first fetched). This bank now holds nothing but the 5-byte "select bank0"
      7  0000 ????						; prefix and the three vectors — 11 emitted bytes total:
      8  0000 ????						;
      9  0000 ????						;   $F000  lda #0 / sta $1FF6	   ; selects bank0 (the write is what switches)
     10  0000 ????						;   $F005  (no byte needed)	   ; the fetch AFTER the sta is read from BANK0,
     11  0000 ????						;				   ;   where $F005 is `jmp GameStart` — so the
     12  0000 ????						;				   ;   old dead `jmp $F005` filler is gone
     13  0000 ????						;   $FFFA  NMI / RESET / IRQ	   ; all three point at $F000
     14  0000 ????						;
     15  0000 ????						; History: 2026-10-13 put the Phase-4 crunch/stage bodies here (bank0 had 1 B
     16  0000 ????						; of pre-pad headroom), and A3 2026-10-19 added the level-data blocks + their
     17  0000 ????						; walkers. C1-C3 2026-10-20 evacuated all of it into bank2 (see the slot map in
     18  0000 ????						; bank2.asm), so no pad switches here at run time.
     19  0000 ????						;
     20  0000 ????						; Keep this a VALID 4K image: the F6 vectors must exist, the $F000 prefix must
     21  0000 ????						; stay `lda #0 / sta $1FF6` (verify_build.check_boot_banks), and $FFF2-$FFF9
     22  0000 ????						; must stay fill — $FFF6-$FFF9 decode as F6 hotspot mirrors on PEEK (Stella
     23  0000 ????						; calls checkSwitchBank from peek; see kernel.asm MothExitPad's comment).
     24  0000 ????						; ==============================================================================
     25  0000 ????				      seg	code
     26  f000					      org	$F000
     27  f000
     28  f000							; --- 5-byte stub: select bank0, then the fetch at $F005 is bank0's ---
     29  f000		       a9 00		      lda	#0
     30  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
     31  f005
     32  f005		       00 00 00 00*	      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
     33  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0
     34  fffa
     35  fffa							; Interrupt vectors
     36  fffa		       00 f0		      .word.w	$F000	; NMI vector
     37  fffc		       00 f0		      .word.w	$F000	; RESET vector ← power-up entry
     38  fffe		       00 f0		      .word.w	$F000	; IRQ vector
