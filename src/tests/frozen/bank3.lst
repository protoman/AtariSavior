    213  f0e2							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    214  f0e2							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    215  f0e2							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    216  f0e2							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    217  f0e2							; AFTER the cave read, so the alias never crosses a frame boundary.
    218  f0e2							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    219  f0e2							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    220  f0e2							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
    221  f0e2							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
    222  f0e2							; both overlay paths (PHM/blast) treat the strip as gone next frame.
    223  f0e2		       a5 99		      lda	RoomMetaA
    224  f0e4		       4a		      lsr
    225  f0e5		       4a		      lsr
    226  f0e6		       4a		      lsr
    227  f0e7		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
    228  f0e8		       f0 09		      beq	.M1zero
    229  f0ea		       0a		      asl
    230  f0eb		       0a		      asl
    231  f0ec		       0a		      asl		; *8
    232  f0ed		       18		      clc
    233  f0ee		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
    234  f0f0		       4c f5 f0 	      jmp	.M1got
    235  f0f3				   .M1zero
    236  f0f3		       a9 00		      lda	#0
    237  f0f5				   .M1got
    238  f0f5		       85 8e		      sta	CollisionEndX
    239  f0f7		       a5 ba		      lda	EnemyDeadMask
    240  f0f9		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    241  f0fb		       f0 04		      beq	.M1stage
    242  f0fd		       a9 00		      lda	#0
    243  f0ff		       85 8e		      sta	CollisionEndX
    244  f101				   .M1stage
    245  f101							; --- BallX staging: Temp ($88) ---
    246  f101							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    247  f101							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    248  f101							; GONE (user 2026-10-12: door must look like the plain async strip;
    249  f101							; only the key/bomb semantics differ). One write per VBL is the
    250  f101							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    251  f101		       a9 35		      lda	#$35
    252  f103		       85 0a		      sta	CTRLPF
    253  f105		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
    254  f107		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    255  f109							; (vcrunch) AND b6 (hot) — b6 used to survive
    256  f109							; and fake a 1-cell ball at x72-79 on a
    257  f109							; hot-without-ball model
