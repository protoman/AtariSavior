    192  f043		       00 00 00 00*	      .ds	$F453 - *, 0	; bank2's $F450 `sta $1FF7` fetch target
    193  f453							; ==============================================================================
    194  f453							; B3RoomBlocks — shape → PF0Buf + staged meta/extras (C7: bank2 tail-jumps
    195  f453							; here; ends `jmp ReturnPad`).
    196  f453							;
    197  f453							; Shape block (C11 2026-10-21) = EXACTLY 3 row-pool indices (band 0/1/2).
    198  f453							; Band 1's index byte carries b7 = mid_band_type (hot): hot cells only ever
    199  f453							; exist on model row 1, so the flag rides that band and the block needs no
    200  f453							; flags byte. MetaA/MetaB are NOT in the block: an owns-extras room reads its
    201  f453							; pair (+patches+features) from the level's async extras stream; every other
    202  f453							; room derives MetaA = 0 and MetaB = $40 iff the shape is hot.
    203  f453							; ==============================================================================
    204  f453				   B3RoomBlocks
    205  f453							; C7: the shape ADDRESS comes from THIS bank's LEVEL_ShapeTable, so bank2
    206  f453							; needs no bank3 label and no symbol export. RoomPF0Lo = the raw shapes
    207  f453							; byte staged by EnterRoomB2 (idx b6-0 | band b7; LAYOUT 8 2026-10-24).
    208  f453		       a5 99		      lda	RoomPF0Lo
    209  f455		       29 7f		      and	#$7F	; shape index, 7 bits (128 shapes)
    210  f457		       0a		      asl		; *2: LEVEL_ShapeTable is a word table
    211  f458		       aa		      tax
    212  f459		       bd 1c f6 	      lda	LEVEL_ShapeTable,X	; block address = the table entry
    213  f45c		       85 e5		      sta	FetchPtr
    214  f45e		       bd 1d f6 	      lda	LEVEL_ShapeTable+1,X
    215  f461		       85 e6		      sta	FetchPtr+1
    216  f463							; C11: no stream by default — a room only gets one from its extras record
    217  f463							; (feature records). RoomMetaB/RoomM1Hot are staged below or by ExtrasLoad.
    218  f463							; RoomRects points at a static $00 count byte so the walkers (overscan
    219  f463							; HotOverlapBody / VBL PhaseBlink) read "empty stream", never TIA.
    220  f463		       a9 00		      lda	#0
    221  f465		       85 af		      sta	RoomM1Hot
    222  f467		       a9 b7		      lda	#<RoomNoStream
    223  f469		       85 90		      sta	RoomRectsLo
    224  f46b		       a9 f8		      lda	#>RoomNoStream
    225  f46d		       85 91		      sta	RoomRectsHi
    226  f46f
    227  f46f							; --- C3/C13 PF rebuild: 4 row-pool indices -> PF buffers (N=4, stride 4) ---
    228  f46f							;     Y = band (3..0) for BOTH the index read and the three PF stores;
    229  f46f							;     X = pool row. SoA columns, so one index register serves all three.
    230  f46f							;     C11: mask b7 (band 1's hot flag) before the pool lookup.
    231  f46f		       a0 03		      ldy	#TILE_ROWS-1
    232  f471				   .EBpf
    233  f471		       b1 e5		      lda	(FetchPtr),Y	; row index for this band
    234  f473		       29 7f		      and	#$7F
    235  f475		       aa		      tax
