    192  f043		       00 00 00 00*	      .ds	$F453 - *, 0	; bank2's $F450 `sta $1FF7` fetch target
    193  f453							; ==============================================================================
    194  f453							; B3RoomBlocks — shape → PF0Buf + staged meta/extras (C7: bank2 tail-jumps
    195  f453							; here; ends `jmp ReturnPad`).
    196  f453							;
    197  f453							; Shape block (C11 2026-10-21) = EXACTLY 3 row-pool indices (band 0/1/2).
    198  f453							; Band 1's index byte carries b7 = mid_band_type (hot): hot cells only ever
    199  f453							; exist on model row 1, so the flag rides that band and the block needs no
    200  f453							; flags byte. MetaA/MetaB are NOT in the block: an owns-extras room reads its
    201  f453							; pair (+patches+features) from the level's async extras stream; every other
    202  f453							; room derives MetaA = 0 and MetaB = $40 iff the shape is hot.
    203  f453							; ==============================================================================
    204  f453				   B3RoomBlocks
    205  f453							; SHAPE STEP MOVED TO BANK7 (2026-11-10): the shape table, blocks and row pool
    206  f453							; live in bank7's big free area (this bank's 747 B window capped the library
    207  f453							; at ~100 shapes). `sta $1FFB` selects bank7 whose bytes at +3 are
    208  f453							; `jmp ShapeStep7`; it expands the shape into PF0Buf/PF1Buf/PF2Buf, stages
    209  f453							; RoomMetaB (hot flag) and ends with `sta $1FF7` at +6, so the next fetch
    210  f453							; (+9) is B3Meta below. FetchPtr/X/Y/A are scratch across the hop.
    211  f453		       8d fb 1f 	      sta	$1FFB
    212  f456		       00 00 00 	      .byte.b	0,0,0	; bank7: jmp ShapeStep7
    213  f459		       00 00 00 	      .byte.b	0,0,0	; bank7: sta $1FF7
    214  f45c				   B3Meta
    215  f45c							; C11: no stream by default - a room only gets one from its extras record
    216  f45c							; (feature records). RoomMetaB/RoomM1Hot are staged by bank7 / ExtrasLoad.
    217  f45c							; RoomRects points at a static $00 count byte so the walkers (overscan
    218  f45c							; HotOverlapBody / VBL PhaseBlink) read "empty stream", never TIA.
    219  f45c		       a9 00		      lda	#0
    220  f45e		       85 af		      sta	RoomM1Hot
    221  f460		       a9 b7		      lda	#<RoomNoStream
    222  f462		       85 90		      sta	RoomRectsLo
