    992  fb4a		       4a		      lsr
    993  fb4b		       4a		      lsr
    994  fb4c		       4a		      lsr
    995  fb4d		       4a		      lsr		; s = P>>4
    996  fb4e		       c9 04		      cmp	#4
    997  fb50		       b0 04		      bcs	.hcNd
