    180  f2ac							; ---- ColOff/ColMask copies for BMWCellSolid (bank0 has the authoritative pair) -----------------
    181  f2c0					      org	$F2C0
    182  f2c0		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
    183  f2d4		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
