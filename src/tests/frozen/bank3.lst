   1119  fd35							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
   1120  fd35							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
   1121  fd35							; (yellow $1C staged below), not width — the 4clk block read as "half
   1122  fd35							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
   1123  fd35		       a9 30		      lda	#$30
   1124  fd37		       85 05		      sta	NUSIZ1
   1125  fd39							; Door stripe color ($8D) is staged inside PhaseBlink (this window
   1126  fd39							; was full to the $F4C4 pin, retired 2026-10-20 — the 14B staging
   1127  fd39							; block lives with the walk where there is hole).
   1128  fd39							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
   1129  fd39							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
   1130  fd39							; window $F3C4..$F4C4 was full; the data window has the only free
   1131  fd39							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
   1132  fd39							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
   1133  fd39							; it). The PF buffers ARE the collision map (cell walk + laser read
   1134  fd39							; them) — toggling the cell's two bits THERE makes render + PHM +
   1135  fd39							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
   1136  fd39							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
   1137  fd39							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
   1138  fd39							; staging above and before the pack below (the crunch walk overwrites
   1139  fd39							; Temp/BandTab for its cell — running it earlier let SBT's own staging
   1140  fd39							; erase the crunch mask, and every crunch kill stopped latching).
   1141  fd39							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
   1142  fd39							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
   1143  fd39							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
   1144  fd39		       20 d9 f9 	      jsr	PhaseBlink
   1145  fd3c				   SBT_B
   1146  fd3c							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
   1147  fd3c							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
   1148  fd3c							; (staged $8E != 0), 0 = symmetric. Cave never
   1149  fd3c							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
   1150  fd3c							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
   1151  fd3c							; kernel's ball block reads it later this VBL).
