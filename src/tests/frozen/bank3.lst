     43  f008		       00 84	   LineCount  =	$84
     44  f008		       00 88	   Temp       =	$88
     45  f008		       00 81	   RoomY      =	$81	; player Y — hcrunch kill endpoints
     46  f008		       00 8b	   CollisionX =	$8B
     47  f008		       00 8c	   CollisionCellX =	$8C	; max text column (player box)
     48  f008		       00 8e	   CollisionEndX =	$8E	; min text column (player box)
     49  f008		       00 8d	   CollisionCellY =	$8D	; top tile row (player box) — NOT scratch
     50  f008							; here (bank2 stages the door color in it)
     51  f008		       00 8f	   CollisionEndY =	$8F	; bottom tile row (player box) / mask scratch
     52  f008		       00 92	   RectCount  =	$92	; PHMOverlay scratch: BallX (right strip)
     53  f008		       00 ba	   EnemyDeadMask =	$BA	; b5 phase armed, b6 phase removed,
     54  f008							; b7 crunch-kill latch (EnterRoom zeroes)
     55  f008		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock
     56  f008		       00 c3	   PF0Buf     =	$C3	; PF buffers rows 0-2 (9B: +0/3/6 per reg)
     57  f008		       00 99	   RoomPF0Lo  =	$99	; TilePF0 pointer (MetaB at (ptr),10)
     58  f008		       00 9a	   RoomPF0Hi  =	$9A
