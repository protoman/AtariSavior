    129  f000							;   ($00 count) when it has none
    130  f000		       00 91	   RoomRectsHi =	$91
    131  f000		       00 af	   RoomM1Hot  =	$AF	; C11: hot-band M1 block cell = col+1
    132  f000							;   (0 = none), staged by ExtrasLoad from the
    133  f000							;   patch list — kernel decl LevelEnemySpare
    134  f000		       00 98	   RoomNo     =	$98
    135  f000		       00 aa	   LevelWallColor =	$AA	; stripe rows 0+2
    136  f000		       00 ab	   LevelWallColor2 =	$AB	; stripe row 1
    137  f000		       00 ad	   TickCounter =	$AD	; 60-frame game timer — hot-pulse phase bit 4
    138  f000		       00 e7	   ColupfBuf  =	$E7	; 12-byte COLUPF image (rows 0-2 used)
