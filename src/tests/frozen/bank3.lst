   1043  fcf6				   .SBTstripAlive
   1044  fcf6							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
   1045  fcf6							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
   1046  fcf6							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
   1047  fcf6							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
   1048  fcf6							; AFTER the cave read, so the alias never crosses a frame boundary.
   1049  fcf6							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
   1050  fcf6							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
   1051  fcf6							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
   1052  fcf6							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
   1053  fcf6							; both overlay paths (PHM/blast) treat the strip as gone next frame.
   1054  fcf6		       a5 99		      lda	RoomMetaA
   1055  fcf8		       4a		      lsr
   1056  fcf9		       4a		      lsr
   1057  fcfa		       4a		      lsr
   1058  fcfb		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
   1059  fcfc		       f0 09		      beq	.M1zero
   1060  fcfe		       0a		      asl
   1061  fcff		       0a		      asl
   1062  fd00		       0a		      asl		; *8
   1063  fd01		       18		      clc
   1064  fd02		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   1065  fd04		       4c 09 fd 	      jmp	.M1got
   1066  fd07				   .M1zero
   1067  fd07		       a9 00		      lda	#0
   1068  fd09				   .M1got
   1069  fd09		       85 8e		      sta	CollisionEndX
   1070  fd0b		       a5 ba		      lda	EnemyDeadMask
   1071  fd0d		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   1072  fd0f		       f0 04		      beq	.M1stage
   1073  fd11		       a9 00		      lda	#0
   1074  fd13		       85 8e		      sta	CollisionEndX
