   1128  fd3c							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
   1129  fd3c							; (staged $8E != 0), 0 = symmetric. Cave never
   1130  fd3c							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
   1131  fd3c							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
   1132  fd3c							; kernel's ball block reads it later this VBL).
   1133  fd3c							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
   1134  fd3c							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
   1135  fd3c							; otherwise).
