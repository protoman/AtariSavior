    992  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    993  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    994  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    995  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    996  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    997  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    998  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
    999  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1000  fcb8							; the pack uses $8F).
   1001  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1002  fcba		       29 01		      and	#$01
   1003  fcbc		       aa		      tax
   1004  fcbd		       bd 71 fd 	      lda	M1OffTab,X
   1005  fcc0		       85 92		      sta	RectCount
   1006  fcc2		       a5 99		      lda	RoomMetaA	; MetaA
   1007  fcc4		       4a		      lsr		; band0 bit -> carry
   1008  fcc5		       a9 00		      lda	#0
   1009  fcc7		       2a		      rol
   1010  fcc8		       f0 02		      beq	.SBTb0z
   1011  fcca		       a9 ff		      lda	#$ff
   1012  fccc				   .SBTb0z
   1013  fccc		       85 ed		      sta	BandTab
   1014  fcce		       a5 99		      lda	RoomMetaA
   1015  fcd0		       4a		      lsr
   1016  fcd1		       4a		      lsr		; band1 bit -> carry
   1017  fcd2		       a9 00		      lda	#0
   1018  fcd4		       2a		      rol
   1019  fcd5		       f0 02		      beq	.SBTb1z
   1020  fcd7		       a9 ff		      lda	#$ff
   1021  fcd9				   .SBTb1z
   1022  fcd9		       85 ee		      sta	BandTab+1
   1023  fcdb		       a5 99		      lda	RoomMetaA
   1024  fcdd		       4a		      lsr
   1025  fcde		       4a		      lsr
   1026  fcdf		       4a		      lsr		; band2 bit -> carry
   1027  fce0		       a9 00		      lda	#0
   1028  fce2		       2a		      rol
   1029  fce3		       f0 02		      beq	.SBTb2z
   1030  fce5		       a9 ff		      lda	#$ff
   1031  fce7				   .SBTb2z
