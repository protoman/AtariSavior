   1068  fd08		       a9 00		      lda	#0
   1069  fd0a				   .M1got
   1070  fd0a		       85 8e		      sta	CollisionEndX
   1071  fd0c		       a5 ba		      lda	EnemyDeadMask
   1072  fd0e		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   1073  fd10		       f0 04		      beq	.M1stage
   1074  fd12		       a9 00		      lda	#0
