    263  f10f		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    264  f111							; calibrated SetObjectXPos arg (S6b: arg A
    265  f111							; draws clocks [A-7, A]; right_col c occupies
    266  f111							; [80+8c, 87+8c]). PHMOverlay recomputes this
    267  f111							; value independently (:1992) — the two MUST
    268  f111							; agree or the stripe draws beside its own
    269  f111							; collision cell (was #86 = +7px ≈ one cell
    270  f111							; right; user-spotted 2026-10-12).
    271  f111		       85 88		      sta	Temp
    272  f113		       4c 20 f1 	      jmp	.SBTballDone
    273  f116				   .SBTnoBall
    274  f116		       a9 00		      lda	#0
    275  f118		       85 88		      sta	Temp
    276  f11a							; --- No ball in this room → BE the ball gate off. ---------------------
    277  f11a							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    278  f11a							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    279  f11a							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    280  f11a							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    281  f11a							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    282  f11a							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    283  f11a		       85 ed		      sta	BandTab
    284  f11c		       85 ee		      sta	BandTab+1
    285  f11e		       85 ef		      sta	BandTab+2
    286  f120				   .SBTballDone
    287  f120							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
    288  f120							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
    289  f120							; (yellow $1C staged below), not width — the 4clk block read as "half
    290  f120							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
    291  f120		       a9 30		      lda	#$30
    292  f122		       85 05		      sta	NUSIZ1
    293  f124							; Door stripe color ($8D) is staged inside PhaseBlink (this window
    294  f124							; is full to the $F4C4 pin — the 14B staging block lives with the
    295  f124							; walk where there is hole).
    296  f124							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
    297  f124							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
    298  f124							; window $F3C4..$F4C4 was full; the data window has the only free
    299  f124							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
    300  f124							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
    301  f124							; it). The PF buffers ARE the collision map (cell walk + laser read
    302  f124							; them) — toggling the cell's two bits THERE makes render + PHM +
    303  f124							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
    304  f124							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
    305  f124							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
    306  f124							; staging above and before the pack below (VcrShutter overwrites
    307  f124							; Temp/BandTab for the shutter cell — running it earlier let SBT's own
    308  f124							; staging erase the shutter, and every crunch kill stopped latching).
    309  f124							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
    310  f124							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
    311  f124		       4c 00 f8 	      jmp	$F800
    312  f127				   SBT_B
    313  f127							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
    314  f127							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
    315  f127							; (staged $8E != 0), 0 = symmetric. Cave never
    316  f127							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
    317  f127							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
    318  f127							; kernel's ball block reads it later this VBL).
    319  f127							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
    320  f127							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
