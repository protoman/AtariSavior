   1055  fcb8				   B3StageBand
   1056  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1057  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1058  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1059  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1060  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1061  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1062  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1063  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1064  fcb8							; the pack uses $8F).
   1065  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1066  fcba		       29 01		      and	#$01
   1067  fcbc		       aa		      tax
   1068  fcbd		       bd 6f fd 	      lda	M1OffTab,X
   1069  fcc0		       85 92		      sta	RectCount
   1070  fcc2							; --- band gates: a 4-bit mask -> one $ff/$00 byte per band ------------
   1071  fcc2							; b0-2 = MetaA, b3 = MetaB b4 (N=4, 2026-10-24: MetaA b3 is the left-door
   1072  fcc2							; flag, so the bottom band needs its own bit). The old code unrolled three
   1073  fcc2							; shift/rol/store triples (~16c each); a 16-row x 4 B template copy costs
   1074  fcc2							; about the same and pays for the fourth band inside the VBL budget.
   1075  fcc2							; LineCount ($84) is VBL scratch here — PhaseBlink clobbers it anyway.
   1076  fcc2		       a5 99		      lda	RoomMetaA
   1077  fcc4		       29 07		      and	#$07
   1078  fcc6		       85 84		      sta	LineCount
   1079  fcc8		       a5 9a		      lda	RoomMetaB
   1080  fcca		       29 10		      and	#$10
   1081  fccc		       4a		      lsr		; b4 -> b3
   1082  fccd		       05 84		      ora	LineCount	; 4-bit gate mask
   1083  fccf		       0a		      asl
   1084  fcd0		       0a		      asl		; *4 -> template row
   1085  fcd1		       aa		      tax
   1086  fcd2		       bd 0d ff 	      lda	BandTpl+0,X
   1087  fcd5		       85 cf		      sta	BandTab
   1088  fcd7		       bd 0e ff 	      lda	BandTpl+1,X
   1089  fcda		       85 d0		      sta	BandTab+1
   1090  fcdc		       bd 0f ff 	      lda	BandTpl+2,X
   1091  fcdf		       85 d1		      sta	BandTab+2
   1092  fce1		       bd 10 ff 	      lda	BandTpl+3,X
   1093  fce4		       85 d2		      sta	BandTab+3
   1094  fce6							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
   1095  fce6							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
   1096  fce6							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
   1097  fce6							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
   1098  fce6							; AFTER the cave read, so the alias never crosses a frame boundary.
   1099  fce6							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
   1100  fce6							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
   1101  fce6							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
   1102  fce6							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
   1103  fce6							; both overlay paths (PHM/blast) treat the strip as gone next frame.
   1104  fce6		       a5 99		      lda	RoomMetaA
   1105  fce8		       4a		      lsr
   1106  fce9		       4a		      lsr
   1107  fcea		       4a		      lsr
   1108  fceb		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
   1109  fcec		       f0 09		      beq	.M1zero
   1110  fcee		       0a		      asl
   1111  fcef		       0a		      asl
   1112  fcf0		       0a		      asl		; *8
   1113  fcf1		       18		      clc
   1114  fcf2		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   1115  fcf4		       4c f9 fc 	      jmp	.M1got
   1116  fcf7				   .M1zero
   1117  fcf7		       a9 00		      lda	#0
   1118  fcf9				   .M1got
   1119  fcf9		       85 8e		      sta	CollisionEndX
   1120  fcfb		       a5 ba		      lda	EnemyDeadMask
   1121  fcfd		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   1122  fcff		       f0 04		      beq	.M1stage
   1123  fd01		       a9 00		      lda	#0
   1124  fd03		       85 8e		      sta	CollisionEndX
