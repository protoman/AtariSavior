    776  fc38							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    777  fc38							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    778  fc38							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    779  fc38							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    780  fc38							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    781  fc38							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    782  fc38							; no-ball path below blanks BandTab so it never enables the ball.
    783  fc38							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    784  fc38							; the pack uses $8F).
    785  fc38		       a5 99		      lda	RoomMetaA	; MetaA
    786  fc3a		       29 01		      and	#$01
    787  fc3c		       aa		      tax
    788  fc3d		       bd f1 fc 	      lda	M1OffTab,X
    789  fc40		       85 92		      sta	RectCount
    790  fc42		       a5 99		      lda	RoomMetaA	; MetaA
    791  fc44		       4a		      lsr		; band0 bit -> carry
    792  fc45		       a9 00		      lda	#0
    793  fc47		       2a		      rol
    794  fc48		       f0 02		      beq	.SBTb0z
    795  fc4a		       a9 ff		      lda	#$ff
    796  fc4c				   .SBTb0z
    797  fc4c		       85 ed		      sta	BandTab
    798  fc4e		       a5 99		      lda	RoomMetaA
    799  fc50		       4a		      lsr
    800  fc51		       4a		      lsr		; band1 bit -> carry
    801  fc52		       a9 00		      lda	#0
    802  fc54		       2a		      rol
    803  fc55		       f0 02		      beq	.SBTb1z
    804  fc57		       a9 ff		      lda	#$ff
    805  fc59				   .SBTb1z
    806  fc59		       85 ee		      sta	BandTab+1
    807  fc5b		       a5 99		      lda	RoomMetaA
    808  fc5d		       4a		      lsr
    809  fc5e		       4a		      lsr
    810  fc5f		       4a		      lsr		; band2 bit -> carry
    811  fc60		       a9 00		      lda	#0
    812  fc62		       2a		      rol
    813  fc63		       f0 02		      beq	.SBTb2z
    814  fc65		       a9 ff		      lda	#$ff
