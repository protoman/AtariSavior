   1045  fcf7							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
   1046  fcf7							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
   1047  fcf7							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
   1048  fcf7							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
   1049  fcf7							; AFTER the cave read, so the alias never crosses a frame boundary.
   1050  fcf7							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
   1051  fcf7							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
   1052  fcf7							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
   1053  fcf7							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
   1054  fcf7							; both overlay paths (PHM/blast) treat the strip as gone next frame.
   1055  fcf7		       a5 99		      lda	RoomMetaA
   1056  fcf9		       4a		      lsr
   1057  fcfa		       4a		      lsr
   1058  fcfb		       4a		      lsr
   1059  fcfc		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
   1060  fcfd		       f0 09		      beq	.M1zero
   1061  fcff		       0a		      asl
   1062  fd00		       0a		      asl
   1063  fd01		       0a		      asl		; *8
   1064  fd02		       18		      clc
   1065  fd03		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   1066  fd05		       4c 0a fd 	      jmp	.M1got
