    167  f088							; ---- the cave kernel's PROLOGUE (bank6 has no room for it) ------------------------------
    168  f088							; Entered from bank6: `sta $1FFB` at Kernel6Entry, then the byte at +3 is the jmp below.
    169  f088							; Leaves with `sta $1FFA` at Kernel6Entry+6 (bank6 continues at +9, `Kernel6Back`).
    170  f088		       f0 ee	   Kernel6Entry =	Kernel6Pad + 3
    171  f0f1					      org	Kernel6Entry + 3
    172  f0f1		       4c 00 f1 	      jmp	Prologue7
    173  f0f4					      org	Kernel6Entry + 6
    174  f0f4		       8d f5 1f 	      sta	BK_CAVE
    175  f100					      org	$F100
    176  f100				   Prologue7
------- FILE bank6_prologue.inc LEVEL 2 PASS 2
      0  f100					      include	"bank6_prologue.inc"
      1  f100							; ==============================================================================
      2  f100							; Cave kernel PROLOGUE (VBL time) - shared by bank6.asm and tools/proto/main.asm.
      3  f100							; Reads the state the bank0 VBL staged (player frame pointer, the two GRP1 objects, door,
      4  f100							; tide, water) and fills the kernel's zero page: pointer pages, K values, the object
      5  f100							; contexts [slot 0, slot 1] and Slot1Band; then the generated core (cave_prologue.inc)
      6  f100							; computes the first segment. Needs: cave_zp.inc, cave_luts.inc, CaveFrameLo, CaveFineTab.
      7  f100							; Registers are free; no jsr (the stack bytes $F8-$FF double as kernel arrays).
      8  f100							; ==============================================================================
      9  f100					      MAC	finddesign
     10  f100					      lsr		; (the design offsets are unique in ObjBase >> 1)
     11  f100					      tax
     12  f100					      lda	CaveDesignIdx,X
     13  f100					      tax
     14  f100					      ENDM		; A = ObjBase-style offset -> X = design index (a table lookup)
     15  f100
     16  f100							; the VBL-tail inits the live kernel did right before its timer poll
     17  f100		       a9 01		      lda	#1
     18  f102		       85 25		      sta	VDELP0
     19  f104		       a9 00		      lda	#0
     20  f106		       85 26		      sta	VDELP1
     21  f108		       85 1f		      sta	ENABL
     22  f10a
     23  f10a							; ---- player frame: Grp0Ptr lo -> frame -> table page + K ----
     24  f10a		       a5 86		      lda	Grp0Ptr
     25  f10c		       a2 03		      ldx	#3
     26  f10e				   .frame
     27  f10e		       dd 84 f0 	      cmp	CaveFrameLo,X
     28  f111		       f0 04		      beq	.frameok
     29  f113		       ca		      dex
     30  f114		       10 f8		      bpl	.frame
     31  f116		       e8		      inx		; unknown pointer: frame 0
     32  f117				   .frameok
     33  f117		       bd 35 f0 	      lda	CaveFrameGHi,X
     34  f11a		       85 e1		      sta	G0+1
     35  f11c		       bd 39 f0 	      lda	CaveFrameKb,X
     36  f11f		       85 87		      sta	P0Kb
     37  f121		       a9 fc		      lda	#CAVE_P0CHI
     38  f123		       85 e3		      sta	C0+1
     39  f125
     40  f125							; ---- slot 0 object: ObjBase -> design -> pages + K; EC[0] = line of its row 0 ----
     41  f125		       a5 b6		      lda	ObjBase
     42  f127		       c9 ff		      cmp	#$FF
     43  f129		       f0 11		      beq	.none0
      0  f12b					      FINDDESIGN	0
      1  f12b		       4a		      lsr
      2  f12c		       aa		      tax
      3  f12d		       bd 4c f0 	      lda	CaveDesignIdx,X
      4  f130		       aa		      tax
     45  f131		       a5 bb		      lda	ObjTop
     46  f133		       18		      clc
     47  f134		       65 81		      adc	RoomY
     48  f136		       38		      sec
     49  f137		       e9 01		      sbc	#1	; ObjTop = line of row 0 - RoomY + 1
     50  f139		       4c 40 f1 	      jmp	.set0
