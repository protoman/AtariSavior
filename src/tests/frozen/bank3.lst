   1076  fa6d		       c8		      iny
   1077  fa6e		       b1 e5		      lda	(FetchPtr),Y	; w
   1078  fa70		       4a		      lsr		; full cells
   1079  fa71		       aa		      tax
   1080  fa72							; Rule (user 2026-10-16): cold kill while CLOSING (sc<52 = dwell+grow);
   1081  fa72							; hot (LineCount = MetaB, staged by PhaseBlink's $82 arm; asl×2 brings
   1082  fa72							; b6 to C) exempts — any phase/extent kills. Opening never kills.
