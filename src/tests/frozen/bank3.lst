    695  fde3
    696  fde3				   RaftBody
    697  fde3							; --- float ON the water surface, riding the TIDE ------------------------
    698  fde3							; The water band's surface drifts 0-3 lines (the tide): the VBL stages
    699  fde3							; 36+off into CollisionX and the kernel draws the strip as the band's last
    700  fde3							; (12-off) lines, so the surface line is 132+off. The raft's bottom row
    701  fde3							; (top+1, a 2-row plank) must land ON that line -> top = 131+off.
    702  fde3							; This mirrors the VBL's
    703  fde3							; triangle EXACTLY (p = EnemyRamP>>4: p0-3 down 0->3, p4-7 up 3->0,
    704  fde3							; p8-15 rest), and this frame's EnemyRamP inc runs before UpdateEnemies,
    705  fde3							; so both sides see the same p — the raft bobs with the water it floats on.
    706  fde3							; CollisionX itself is unusable here: the input rect-walks clobber it
    707  fde3							; before UpdateEnemies runs. Keep the two formulas in step (AGENTS).
    708  fde3		       a5 c2		      lda	EnemyRamP
    709  fde5		       29 f0		      and	#$F0
    710  fde7		       f0 15		      beq	.RaftTide	; p=0 -> off 0 (A already 0)
    711  fde9		       4a		      lsr
    712  fdea		       4a		      lsr
    713  fdeb		       4a		      lsr
    714  fdec		       4a		      lsr		; A = p (1..15)
    715  fded		       c9 08		      cmp	#8
    716  fdef		       90 04		      bcc	.RaftTideTri
    717  fdf1		       a9 00		      lda	#0	; rest phase p8-15
    718  fdf3		       f0 09		      beq	.RaftTide	; always
    719  fdf5				   .RaftTideTri
    720  fdf5		       c9 04		      cmp	#4
    721  fdf7		       90 05		      bcc	.RaftTide	; p1-3: off = p
    722  fdf9		       49 ff		      eor	#$FF
    723  fdfb		       38		      sec
    724  fdfc		       69 07		      adc	#7	; p4-7: off = 7-p
    725  fdfe				   .RaftTide
    726  fdfe		       18		      clc
    727  fdff		       69 83		      adc	#RAFTER_BASE	; + 131 -> the surface line (132+off) minus 1
    728  fe01		       95 e2		      sta	EnemyRamY,X	; the authored y is ignored on purpose: the
    729  fe03							; water line is what the raft floats on
    730  fe03
    731  fe03							; --- does the player count as "over the raft"? --------------------------
    732  fe03							; The raft is a FERRY (user rule 2026-10-18): it moves ONLY while he is over
    733  fe03							; it, parks the moment he steps off, and its position resets on room entry
    734  fe03							; (LoadEnemyRam re-copies the record's spawn x). Gating the whole motion
    735  fe03							; block here is what makes it park; the pin/carry later still applies while
    736  fe03							; riding. The test runs against the CURRENT x (before the step), i.e. the
    737  fe03							; raft he is actually standing on.
    738  fe03		       a5 80		      lda	RoomX
    739  fe05		       38		      sec
    740  fe06		       f5 bd		      sbc	EnemyRamX,X
    741  fe08		       18		      clc
    742  fe09		       69 06		      adc	#RAFTER_XOFF
    743  fe0b		       c9 0e		      cmp	#RAFTER_XSPAN
    744  fe0d		       b0 13		      bcs	.RaftNoRide	; no X overlap: nobody aboard
    745  fe0f		       a5 81		      lda	RoomY
    746  fe11		       38		      sec
    747  fe12		       f5 e2		      sbc	EnemyRamY,X
    748  fe14		       18		      clc
    749  fe15		       69 16		      adc	#RAFTER_PINFIT
    750  fe17		       c9 1c		      cmp	#RAFTER_YSPAN
