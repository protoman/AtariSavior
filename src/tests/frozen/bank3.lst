    433  f9fe							;	    8px — full=w>>1; w=20 record = center of the screen)
    434  f9fe							;   s 13-15 fast retract    (eff 3*(15-s) = 6,3,0) — wipe home in 3
    435  f9fe							;	    steps (the old instant far-end turn, stretched to center)
