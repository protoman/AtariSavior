    514  f8f8				   HotOverlapBody
    515  f8f8							; ==========================================================================
    516  f8f8							; C11 (2026-10-21): HOT DEATH IS DERIVED FROM THE PF BUFFERS.
    517  f8f8							; convert promotes EVERY row-1 wall cell of a mid_band_type=1 model, so a
    518  f8f8							; hot shape's hot cells ARE its solid row-1 PF cells; the C4 bomb punch
    519  f8f8							; clears PF0Buf cells, so a blasted (thin) parent cell stops being hot with
    520  f8f8							; no record stream and no parent gate. Hot cells never exist on rows 0/2.
    521  f8f8							; The per-shape 5 B/record stream is gone (LEVEL_FORMAT 6); MetaB b6 —
    522  f8f8							; staged at room load — gates the sweep so only hot rooms pay for it.
    523  f8f8							; ==========================================================================
    524  f8f8		       a5 9a		      lda	RoomMetaB
    525  f8fa		       29 40		      and	#$40	; b6 = mid_band_type hot
    526  f8fc		       f0 57		      beq	.HOVstream	; cold room: feature records only
    527  f8fe							; Hot cells only live on model row 1 → the box must include it.
    528  f8fe		       a5 8d		      lda	CollisionCellY	; top row
    529  f900		       c9 02		      cmp	#2
    530  f902		       b0 51		      bcs	.HOVstream	; top row 2 → box is below the hot band
    531  f904		       a5 8f		      lda	CollisionEndY	; bottom row
    532  f906		       f0 4d		      beq	.HOVstream	; bottom row 0 → box is above the hot band
    533  f908							; Sweep the box's display columns over PF row 1 — the SAME cell store the
    534  f908							; player walk reads (PF0Buf + row + ColOff[X], bit ColMask[X]). Reached
    535  f908							; only from a cell-walk hit, so this is "the wall I bumped is hot".
    536  f908		       a6 8e		      ldx	CollisionEndX	; min col
    537  f90a				   .HOVpfCol
