    899  fb2c							; ==============================================================================
    900  fb2c							; PhVcApplyOR / PhVcApplyAND DELETED (2026-10-19) — same retired vcrunch
    901  fb2c							; tramp path. PhHcrEntry now stores the prefix mask directly (fixed 10).
    902  fb2c							; ==============================================================================
    903  fb2c							; ==============================================================================
    904  fb2c							; HcrClock — hcrunch animation clock (fixed full=10 since 2026-10-19).
    905  fb2c							;   In:  X = full extent (cells, ≥1); reads EnemyRamP (StartFrame-pinned)
    906  fb2c							;   Out: A = covered (1..full) — never 0 (always-solid stub)
    907  fb2c							;   Clobbers A (X/Y preserved — unlike CrunchClock). No latch: the kill
    908  fb2c							;   repeats on contact (DropArm respawns at the room top, so no loop).
    909  fb2c							; s = EnemyRamP>>4 (0..15, one 256f period = 16 buckets of 16f):
    910  fb2c							;   s 0-3   dwell at home  (eff 0)	  -> n=1, 64f stub
    911  fb2c							;   s 4-12  grow to center  (eff s-3)	  -> n 2..full (1..9 cells of
    912  fb2c							;	    8px — full=w>>1; w=20 record = center of the screen)
    913  fb2c							;   s 13-15 fast retract    (eff 3*(15-s) = 6,3,0) — wipe home in 3
    914  fb2c							;	    steps (the old instant far-end turn, stretched to center)
    915  fb2c							; covered = 1 + min(eff, full-1). CrunchClock (sc>>2 triangle, ~4f/step)
    916  fb2c							; stays for its VCR mirrors + verify_build token gate — only the two
    917  fb2c							; hcrunch call sites moved here (16f/step, grow-to-center ruling
    918  fb2c							; 2026-10-16). Both callers pass full=10 (PhHcrEntry stages it, HOV
    919  fb2c							; tests it); the latch freeze was removed with the 2026-10-19 contract.
    920  fb2c							; ==============================================================================
    921  fb2c				   HcrClock
    922  fb2c		       e0 01		      cpx	#1
    923  fb2e		       d0 03		      bne	.hcN
    924  fb30		       a9 01		      lda	#1	; full=1: n always 1
    925  fb32		       60		      rts
    926  fb33				   .hcN
    927  fb33		       a5 c2		      lda	EnemyRamP
    928  fb35		       4a		      lsr
    929  fb36		       4a		      lsr
    930  fb37		       4a		      lsr
    931  fb38		       4a		      lsr		; s = P>>4
    932  fb39		       c9 04		      cmp	#4
    933  fb3b		       b0 04		      bcs	.hcNd
    934  fb3d		       a9 00		      lda	#0	; s0-3 dwell: eff 0
    935  fb3f		       f0 11		      beq	.hcOut	; (always)
    936  fb41				   .hcNd
    937  fb41		       c9 0d		      cmp	#13
    938  fb43		       b0 05		      bcs	.hcNf
    939  fb45		       38		      sec
    940  fb46		       e9 03		      sbc	#3	; s4-12: eff = s-3 (1..9) — grow to center
    941  fb48		       b0 08		      bcs	.hcOut	; (always, no borrow)
    942  fb4a				   .hcNf
    943  fb4a		       49 0f		      eor	#$0F	; s13-15: t = 15-s (2,1,0) — fast retract
    944  fb4c		       85 8b		      sta	CollisionX
    945  fb4e		       0a		      asl
    946  fb4f		       18		      clc
    947  fb50		       65 8b		      adc	CollisionX	; eff = 3t (6,3,0)
    948  fb52				   .hcOut
    949  fb52		       18		      clc
    950  fb53		       69 01		      adc	#1	; candidate = eff+1
    951  fb55		       85 8b		      sta	CollisionX	; scratch (HOV owns Temp; VBL path owns no consumer)
    952  fb57		       8a		      txa		; full
    953  fb58		       c5 8b		      cmp	CollisionX
    954  fb5a		       b0 01		      bcs	.hcR
    955  fb5c		       60		      rts		; full < candidate -> A = full already
    956  fb5d				   .hcR
    957  fb5d		       a5 8b		      lda	CollisionX
    958  fb5f		       60		      rts
