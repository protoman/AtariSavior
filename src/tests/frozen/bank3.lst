    149  f0a3							; ==============================================================================
    150  f0a3							; B3StageBand — StageBandTab, MOVED from bank2 (chunk A2, 2026-10-19).
    151  f0a3							;
    152  f0a3							; Tail-entered from bank2 BCFDarkRun at $F3A9:
    153  f0a3							;   jsr PhaseBlink   (stays bank2 — it walks the rect stream)
    154  f0a3							;   sta $1FF9
    155  f0a3							;   jmp $F0A3	      <- OPCODE fetched from THIS bank at $F3AF
    156  f0a3							; so bank3 MUST hold `jmp $F0A3` at $F3AF (pinned at the end of this block).
    157  f0a3							; Zero pushes end to end: this body ends `jmp $FBF8` (ReturnPad), whose
    158  f0a3							; `sta $1FF6 / rts` pops the ORIGINAL bank0 VBL jsr — the chain never nests.
    159  f0a3							;
    160  f0a3							; Reads ZP ONLY: RoomMetaA/B are staged at room entry (bank2 EnterRoomB2),
    161  f0a3							; so no level-data access and therefore no bank2 read tramp is needed.
    162  f0a3							;
    163  f0a3							; Packed meta (bugs.md 28 point 1): MetaA = (m1_col+1)<<4 | band_mask
    164  f0a3							; (b0-2 = band0/1/2 gates); MetaB = ball_col+1 (0 = feature absent).
    165  f0a3							; Expanded every VBL to:
    166  f0a3							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates
    167  f0a3							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 = symmetric -> skip)
    168  f0a3							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    169  f0a3							; Window: this VBL write -> cave read -> bank1 HUD stomps $ED-$EF after the
    170  f0a3							; cave read -> overscan rewrites $88 (joystick) after the ball read.
    171  f0a3							; ==============================================================================
    172  f0a3					      org	$F0A3
    173  f0a3				   B3StageBand
    174  f0a3							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    175  f0a3							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    176  f0a3							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    177  f0a3							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    178  f0a3							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    179  f0a3							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    180  f0a3							; no-ball path below blanks BandTab so it never enables the ball.
    181  f0a3							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    182  f0a3							; the pack uses $8F).
    183  f0a3		       a5 99		      lda	RoomMetaA	; MetaA
    184  f0a5		       29 01		      and	#$01
    185  f0a7		       aa		      tax
    186  f0a8		       bd 5c f1 	      lda	M1OffTab,X
    187  f0ab		       85 92		      sta	RectCount
    188  f0ad		       a5 99		      lda	RoomMetaA	; MetaA
    189  f0af		       4a		      lsr		; band0 bit -> carry
    190  f0b0		       a9 00		      lda	#0
    191  f0b2		       2a		      rol
    192  f0b3		       f0 02		      beq	.SBTb0z
    193  f0b5		       a9 ff		      lda	#$ff
    194  f0b7				   .SBTb0z
    195  f0b7		       85 ed		      sta	BandTab
    196  f0b9		       a5 99		      lda	RoomMetaA
    197  f0bb		       4a		      lsr
    198  f0bc		       4a		      lsr		; band1 bit -> carry
    199  f0bd		       a9 00		      lda	#0
    200  f0bf		       2a		      rol
    201  f0c0		       f0 02		      beq	.SBTb1z
    202  f0c2		       a9 ff		      lda	#$ff
    203  f0c4				   .SBTb1z
    204  f0c4		       85 ee		      sta	BandTab+1
    205  f0c6		       a5 99		      lda	RoomMetaA
    206  f0c8		       4a		      lsr
    207  f0c9		       4a		      lsr
    208  f0ca		       4a		      lsr		; band2 bit -> carry
    209  f0cb		       a9 00		      lda	#0
    210  f0cd		       2a		      rol
    211  f0ce		       f0 02		      beq	.SBTb2z
    212  f0d0		       a9 ff		      lda	#$ff
    213  f0d2				   .SBTb2z
    214  f0d2		       85 ef		      sta	BandTab+2
    215  f0d4							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
    216  f0d4							; set it this overscan) → blank all band gates so the cave renders no
    217  f0d4							; strip; the pack below then emits mask 0 → every overlay stays
    218  f0d4							; transparent too. BandTab restages from ROM next room entry. ---
    219  f0d4		       a5 ba		      lda	EnemyDeadMask
    220  f0d6		       29 08		      and	#$08
    221  f0d8		       f0 08		      beq	.SBTstripAlive
    222  f0da		       a9 00		      lda	#0
    223  f0dc		       85 ed		      sta	BandTab
    224  f0de		       85 ee		      sta	BandTab+1
    225  f0e0		       85 ef		      sta	BandTab+2
    226  f0e2				   .SBTstripAlive
    227  f0e2							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    228  f0e2							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    229  f0e2							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    230  f0e2							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    231  f0e2							; AFTER the cave read, so the alias never crosses a frame boundary.
    232  f0e2							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    233  f0e2							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    234  f0e2							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
    235  f0e2							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
    236  f0e2							; both overlay paths (PHM/blast) treat the strip as gone next frame.
    237  f0e2		       a5 99		      lda	RoomMetaA
    238  f0e4		       4a		      lsr
    239  f0e5		       4a		      lsr
    240  f0e6		       4a		      lsr
    241  f0e7		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
    242  f0e8		       f0 09		      beq	.M1zero
    243  f0ea		       0a		      asl
    244  f0eb		       0a		      asl
    245  f0ec		       0a		      asl		; *8
    246  f0ed		       18		      clc
    247  f0ee		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
    248  f0f0		       4c f5 f0 	      jmp	.M1got
    249  f0f3				   .M1zero
    250  f0f3		       a9 00		      lda	#0
    251  f0f5				   .M1got
    252  f0f5		       85 8e		      sta	CollisionEndX
    253  f0f7		       a5 ba		      lda	EnemyDeadMask
    254  f0f9		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    255  f0fb		       f0 04		      beq	.M1stage
    256  f0fd		       a9 00		      lda	#0
    257  f0ff		       85 8e		      sta	CollisionEndX
    258  f101				   .M1stage
    259  f101							; --- BallX staging: Temp ($88) ---
    260  f101							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    261  f101							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    262  f101							; GONE (user 2026-10-12: door must look like the plain async strip;
    263  f101							; only the key/bomb semantics differ). One write per VBL is the
    264  f101							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    265  f101		       a9 35		      lda	#$35
    266  f103		       85 0a		      sta	CTRLPF
    267  f105		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
    268  f107		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    269  f109							; (vcrunch) AND b6 (hot) — b6 used to survive
    270  f109							; and fake a 1-cell ball at x72-79 on a
    271  f109							; hot-without-ball model
    272  f109		       f0 0b		      beq	.SBTnoBall
    273  f10b		       0a		      asl
    274  f10c		       0a		      asl
    275  f10d		       0a		      asl		; *8
    276  f10e		       18		      clc
    277  f10f		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    278  f111							; calibrated SetObjectXPos arg (S6b: arg A
    279  f111							; draws clocks [A-7, A]; right_col c occupies
    280  f111							; [80+8c, 87+8c]). PHMOverlay recomputes this
    281  f111							; value independently (:1992) — the two MUST
    282  f111							; agree or the stripe draws beside its own
    283  f111							; collision cell (was #86 = +7px ≈ one cell
    284  f111							; right; user-spotted 2026-10-12).
    285  f111		       85 88		      sta	Temp
    286  f113		       4c 20 f1 	      jmp	.SBTballDone
    287  f116				   .SBTnoBall
    288  f116		       a9 00		      lda	#0
    289  f118		       85 88		      sta	Temp
    290  f11a							; --- No ball in this room → BE the ball gate off. ---------------------
    291  f11a							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    292  f11a							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    293  f11a							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    294  f11a							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    295  f11a							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    296  f11a							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    297  f11a		       85 ed		      sta	BandTab
    298  f11c		       85 ee		      sta	BandTab+1
    299  f11e		       85 ef		      sta	BandTab+2
    300  f120				   .SBTballDone
    301  f120							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
    302  f120							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
    303  f120							; (yellow $1C staged below), not width — the 4clk block read as "half
    304  f120							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
    305  f120		       a9 30		      lda	#$30
    306  f122		       85 05		      sta	NUSIZ1
    307  f124							; Door stripe color ($8D) is staged inside PhaseBlink (this window
    308  f124							; is full to the $F4C4 pin — the 14B staging block lives with the
    309  f124							; walk where there is hole).
    310  f124							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
    311  f124							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
    312  f124							; window $F3C4..$F4C4 was full; the data window has the only free
    313  f124							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
    314  f124							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
    315  f124							; it). The PF buffers ARE the collision map (cell walk + laser read
    316  f124							; them) — toggling the cell's two bits THERE makes render + PHM +
    317  f124							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
    318  f124							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
    319  f124							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
    320  f124							; staging above and before the pack below (VcrShutter overwrites
    321  f124							; Temp/BandTab for the shutter cell — running it earlier let SBT's own
    322  f124							; staging erase the shutter, and every crunch kill stopped latching).
    323  f124							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
    324  f124							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
    325  f124							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
    326  f124		       20 5e f4 	      jsr	PhaseBlink
