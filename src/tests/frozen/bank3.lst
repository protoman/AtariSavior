    186  f2e8							; ------------------------------------------------------------------------------
    187  f2e8							; M1StripBlast — Phase 4 M1 strip blast (moved from bank2 2026-10-20, repack
    188  f2e8							; chunk 2). Reads ZP ONLY (RectCount / RoomMetaA-B / EnemyDeadMask /
    189  f2e8							; BMWScratch), so it runs here and the old two-hop pad chain
    190  f2e8							; (.BMWDone -> pad $F9AC -> bank2 -> pad $F9B2) collapses to a same-bank
    191  f2e8							; jal: BombMarkWalls .BMWDone -> M1StripBlast -> StripBlastCheck, 0 switches.
    192  f2e8							; Staging contract (both scratch bytes free in this flow):
    193  f2e8							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    194  f2e8							;   BMWScratch ($88 = kernel Temp, NOT bank1's Temp $AD) := $FF when MetaB
    195  f2e8							;   b7 (right door) so the ball-strip take can never fire. Key pickup (P5)
    196  f2e8							;   sets b3/b4 for doors instead (comment hook at the takes).
    197  f2e8							; ------------------------------------------------------------------------------
    198  f2e8				   M1StripBlast
    199  f2e8		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
    200  f2ea		       c9 14		      cmp	#20
    201  f2ec		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
    202  f2ee		       a5 ba		      lda	EnemyDeadMask
    203  f2f0		       29 10		      and	#$10	; b4 already set → nothing to stage
    204  f2f2		       d0 15		      bne	.M1SBnone
    205  f2f4		       a5 99		      lda	RoomMetaA	; MetaA
    206  f2f6		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
    207  f2f8		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
    208  f2fa		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
    209  f2fc		       4a		      lsr
    210  f2fd		       4a		      lsr
    211  f2fe		       4a		      lsr
    212  f2ff		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
    213  f300							;   high end — StripBlastCheck rejects)
    214  f300		       38		      sec
    215  f301		       e9 01		      sbc	#1	; ℓ = left_col
    216  f303		       0a		      asl		; 2ℓ = strip left dcol
    217  f304		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
    218  f306		       4c 0d f3 	      jmp	.M1SBdoorR
    219  f309				   .M1SBnone
    220  f309		       a9 ff		      lda	#$FF
    221  f30b		       85 92		      sta	RectCount	; no left strip this frame
    222  f30d				   .M1SBdoorR
    223  f30d		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
    224  f30f		       10 04		      bpl	.M1SBout
    225  f311		       a0 ff		      ldy	#$FF
    226  f313		       84 88		      sty	BMWScratch	; $88 = StripBlastCheck's "no strip"
    227  f315				   .M1SBout
