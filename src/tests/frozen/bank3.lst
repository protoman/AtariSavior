    195  f850							; ==============================================================================
    196  f850							; PhHcrEntry — PhaseBlink $82 (hcrunch) tramp target.
    197  f850							; Record: $82, 0, band (row), w (4px = 2*cells), 1. Single-row band
    198  f850							; prefix from col 0: cells 0..n-1 covered (n = HcrClock(full)), the
    199  f850							; rest of the full bbox cleared. PF = (row & ~P(full)) | P(n) — fused in
    200  f850							; ONE pass (P(n) ⊆ P(full), so AND-then-OR collapses; one pass halves the
    201  f850							; buffer reads). Y = class on entry; tail leaves Y = base+2. Clobbers
    202  f850							; A/X/Y + LineCount/CCX/CEY.
    203  f850							; ==============================================================================
    204  f880					      org	$F880
    205  f880				   PhHcrEntry
    206  f880							; Entered from bank2 PhHcrPre: stack (top→) = h, w, y(band), x, <caller>.
    207  f880							; Hot (MetaB b6) is staged bank2-side in LineCount ($84) and read HERE,
    208  f880							; right after HcrClock, BEFORE the mask staging reuses LineCount. The
    209  f880							; push is deliberately the FIRST thing after n: it only needs n + band +
    210  f880							; hot, and reordering keeps the 4-field stack contract (no 5th push) so
    211  f880							; bank2's tramp stays aligned with this bank's twin.
    212  f880							; Y = base+4 on entry; saved for the .PhRec return.
    213  f880		       98		      tya
    214  f881		       48		      pha		; [base+4]
    215  f882		       ba		      tsx
    216  f883		       bd 04 01 	      lda	$0104,X	; y = band
    217  f886		       48		      pha		; [base+4, band]
    218  f887		       ba		      tsx
    219  f888		       bd 04 01 	      lda	$0104,X	; w
    220  f88b		       4a		      lsr		; full cells (w is even, 2*cells)
    221  f88c		       48		      pha		; [base+4, band, full]
    222  f88d		       aa		      tax		; X = full
    223  f88e		       20 fe f9 	      jsr	HcrClock	; A = n covered cells (1..full); b7 → 1 (spent)
    224  f891		       48		      pha		; [base+4, band, full, n]
    225  f892							; cold growth push (user 2026-10-16). Split from the staging (option A):
    226  f892							; on the 16f grow-step edge (EnemyRamP & $0F == 0) we PUSH and SKIP the
    227  f892							; staging; every other frame we STAGE and never push. The PF buffer then
    228  f892							; shows last frame's prefix for the one step frame (the shutter renders
    229  f892							; one frame late on a step — invisible at 16f/step), but the ~90c staging
    230  f892							; and the ~65c push never share a frame, so the worst VBL is base +
    231  f892							; max(staging, push) instead of the sum (the flicker fix). Spent (b7)
    232  f892							; always stages (freeze at stub) and never pushes.
    233  f892		       a5 c2		      lda	EnemyRamP
    234  f894		       29 0f		      and	#$0F
    235  f896		       d0 1d		      bne	.HcStage	; not the step edge → stage the shutter
    236  f898		       a5 ba		      lda	EnemyDeadMask
    237  f89a		       29 80		      and	#$80
    238  f89c		       d0 17		      bne	.HcStage	; spent: stage the stub, never push
    239  f89e		       ba		      tsx
    240  f89f		       bd 03 01 	      lda	$0103,X	; band
    241  f8a2		       85 8c		      sta	CollisionCellX
    242  f8a4		       bd 01 01 	      lda	$0101,X	; n
    243  f8a7		       0a		      asl
    244  f8a8		       0a		      asl
    245  f8a9		       0a		      asl		; 8n (prefix width px) — HcrPush's only ext input
    246  f8aa		       85 8b		      sta	CollisionX
    247  f8ac		       a5 84		      lda	LineCount	; hot (MetaB b6, $40/0) — bank2 staged it
    248  f8ae		       a8		      tay		; Y = hot
    249  f8af		       20 10 f0 	      jsr	HcrPush
    250  f8b2		       4c f1 f8 	      jmp	.HcDrain	; push frame: skip the staging (see above)
    251  f8b5				   .HcStage
    252  f8b5							; Fused bbox-open + prefix-close, ONE band row (h is always 1 for $82):
    253  f8b5							;   PF[row] = (PF[row] & ~P(full)) | P(n)
    254  f8b5							; ~P(full) staged in LineCount/CCX/CEY; P(n) read from CrPfx*,Y inline.
    255  f8b5							; One pass replaces ApplyAND-then-ApplyOR (same result — P(n) ⊆ P(full)
    256  f8b5							; — but half the buffer reads); frees ~50c of the hcrunch VBL.
    257  f8b5		       ba		      tsx
    258  f8b6		       bc 02 01 	      ldy	$0102,X	; full
    259  f8b9		       b9 80 f9 	      lda	CrPfx0,Y
    260  f8bc		       49 ff		      eor	#$FF
    261  f8be		       85 84		      sta	LineCount
    262  f8c0		       b9 8b f9 	      lda	CrPfx1,Y
    263  f8c3		       49 ff		      eor	#$FF
    264  f8c5		       85 8c		      sta	CollisionCellX
    265  f8c7		       b9 96 f9 	      lda	CrPfx2,Y
    266  f8ca		       49 ff		      eor	#$FF
    267  f8cc		       85 8f		      sta	CollisionEndY
    268  f8ce		       ba		      tsx
    269  f8cf		       bc 01 01 	      ldy	$0101,X	; n → CrPfx index
    270  f8d2		       bd 03 01 	      lda	$0103,X	; band
    271  f8d5		       aa		      tax		; X = PF buffer row index
    272  f8d6		       b5 c3		      lda	PF0Buf,X
    273  f8d8		       25 84		      and	LineCount
    274  f8da		       19 80 f9 	      ora	CrPfx0,Y
    275  f8dd		       95 c3		      sta	PF0Buf,X
    276  f8df		       b5 c6		      lda	PF0Buf+3,X
    277  f8e1		       25 8c		      and	CollisionCellX
    278  f8e3		       19 8b f9 	      ora	CrPfx1,Y
    279  f8e6		       95 c6		      sta	PF0Buf+3,X
    280  f8e8		       b5 c9		      lda	PF0Buf+6,X
    281  f8ea		       25 8f		      and	CollisionEndY
    282  f8ec		       19 96 f9 	      ora	CrPfx2,Y
    283  f8ef		       95 c9		      sta	PF0Buf+6,X
    284  f8f1				   .HcDrain
    285  f8f1		       68		      pla		; n
    286  f8f2		       68		      pla		; full
    287  f8f3		       68		      pla		; band
    288  f8f4		       68		      pla		; base+4 → A = base+4
    289  f8f5		       a8		      tay		; Y = base+4 (record end → .PhRec iny → next class)
    290  f8f6		       68		      pla
    291  f8f7		       68		      pla
    292  f8f8		       68		      pla
