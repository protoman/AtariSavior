     92  f000		       00 92	   RectCount  =	$92
     93  f000		       00 b1	   EnemyDataLo =	$B1	; record base — restaged before every exit
     94  f000		       00 b2	   EnemyDataHi =	$B2
     95  f000		       00 b5	   BombPacked =	$B5	; b3-6 WallMask (destroyed rect skip)
     96  f000		       00 f6	   BombX      =	$F6	; hand-copy kernel EQU — title: 68 = no bomb,
     97  f000							;   140 = armed (TitleKernel P1 SOXP reads it)
     98  f000		       00 f7	   BombTimer  =	$F7	; hand-copy kernel EQU — title fuse/explode
     99  f000		       00 b9	   EnemyIndex =	$B9	; slot save around the col swap + rect walk
    100  f000							; (LevelStartRoom hand-copy retired 2026-10-20:
    101  f000							;   its readers OvM1Block/OvShutBand moved to
    102  f000							;   bank0, which reads the byte natively)
    103  f000		       00 ba	   EnemyDeadMask =	$BA	; b0-2 enemy kills; b3 = ball strip
    104  f000							; destroyed (bank1 StripBlastCheck); b4 = M1
    105  f000							; strip destroyed (M1StripBlast) — check_equ_sync
    106  f000							; pairs this with kernel's decl)
    107  f000		       00 bd	   EnemyRamX  =	$BD
    108  f000		       00 c0	   LaserState =	$C0	; b5-2 = RoomDarkMask rooms 4-7 (BCFDarkRun)
    109  f000		       00 c1	   EnemyRamD  =	$C1	; dir bits: 1 = right, 0 = left
    110  f000		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock
    111  f000		       00 e2	   EnemyRamY  =	$E2	; live Y (refreshed this overscan — after
    112  f000							; the bank1 HUD score-ptr stomp; S3.4)
    113  f000		       00 14	   TILE_COLUMNS =	20
    114  f000		       00 81	   RoomY      =	$81	; player Y — LaserHitTest vertical window
    115  f000		       00 c3	   PF0Buf     =	$C3	; PF render buffers rows 0-2 ($C3-$CF) —
    116  f000							; cell map read here; must match kernel.asm
    117  f000		       00 82	   PlayerDir  =	$82	; must match kernel.asm — S6 LWC tip direction
    118  f000		       00 b3	   EnemyCount =	$B3	; LaserHitTest loop bound
    119  f000		       00 ba	   EnemyDeadMask =	$BA	; LaserHitTest dead bits (written on kill)
    120  f000							; Grp0Ptr/Grp0PtrHi/SWCHA/PlayerSprite*/PlayerWalk* EQUs retired 2026-10-20:
