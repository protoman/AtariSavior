    953  fb4a		       b0 08		      bcs	.hcOut	; (always, no borrow)
    954  fb4c				   .hcNf
    955  fb4c		       49 0f		      eor	#$0F	; s13-15: t = 15-s (2,1,0) — fast retract
    956  fb4e		       85 8b		      sta	CollisionX
    957  fb50		       0a		      asl
    958  fb51		       18		      clc
    959  fb52		       65 8b		      adc	CollisionX	; eff = 3t (6,3,0)
    960  fb54				   .hcOut
    961  fb54		       18		      clc
