     82  f008							; ==============================================================================
     83  f008							; B3StageBand — StageBandTab, MOVED from bank2 (chunk A2, 2026-10-19).
     84  f008							;
     85  f008							; Tail-entered from bank2 BCFDarkRun at $F3A9:
     86  f008							;   jsr PhaseBlink   (stays bank2 — it walks the rect stream)
     87  f008							;   sta $1FF9
     88  f008							;   jmp $F0A3	      <- OPCODE fetched from THIS bank at $F3AF
     89  f008							; so bank3 MUST hold `jmp $F0A3` at $F3AF (pinned at the end of this block).
     90  f008							; Zero pushes end to end: this body ends `jmp $FBF8` (ReturnPad), whose
     91  f008							; `sta $1FF6 / rts` pops the ORIGINAL bank0 VBL jsr — the chain never nests.
     92  f008							;
     93  f008							; Reads ZP ONLY: RoomMetaA/B are staged at room entry (bank2 EnterRoomB2),
     94  f008							; so no level-data access and therefore no bank2 read tramp is needed.
     95  f008							;
     96  f008							; Packed meta (bugs.md 28 point 1): MetaA = (m1_col+1)<<4 | band_mask
     97  f008							; (b0-2 = band0/1/2 gates); MetaB = ball_col+1 (0 = feature absent).
     98  f008							; Expanded every VBL to:
     99  f008							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates
    100  f008							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 = symmetric -> skip)
    101  f008							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    102  f008							; Window: this VBL write -> cave read -> bank1 HUD stomps $ED-$EF after the
    103  f008							; cave read -> overscan rewrites $88 (joystick) after the ball read.
    104  f008							; ==============================================================================
    105  f0a3					      org	$F0A3
    106  f0a3				   B3StageBand
    107  f0a3							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    108  f0a3							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    109  f0a3							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    110  f0a3							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    111  f0a3							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    112  f0a3							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    113  f0a3							; no-ball path below blanks BandTab so it never enables the ball.
    114  f0a3							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    115  f0a3							; the pack uses $8F).
    116  f0a3		       a5 99		      lda	RoomMetaA	; MetaA
    117  f0a5		       29 01		      and	#$01
    118  f0a7		       aa		      tax
    119  f0a8		       bd 5c f1 	      lda	M1OffTab,X
    120  f0ab		       85 92		      sta	RectCount
    121  f0ad		       a5 99		      lda	RoomMetaA	; MetaA
    122  f0af		       4a		      lsr		; band0 bit -> carry
    123  f0b0		       a9 00		      lda	#0
    124  f0b2		       2a		      rol
    125  f0b3		       f0 02		      beq	.SBTb0z
    126  f0b5		       a9 ff		      lda	#$ff
    127  f0b7				   .SBTb0z
    128  f0b7		       85 ed		      sta	BandTab
    129  f0b9		       a5 99		      lda	RoomMetaA
    130  f0bb		       4a		      lsr
    131  f0bc		       4a		      lsr		; band1 bit -> carry
    132  f0bd		       a9 00		      lda	#0
    133  f0bf		       2a		      rol
    134  f0c0		       f0 02		      beq	.SBTb1z
    135  f0c2		       a9 ff		      lda	#$ff
    136  f0c4				   .SBTb1z
    137  f0c4		       85 ee		      sta	BandTab+1
    138  f0c6		       a5 99		      lda	RoomMetaA
    139  f0c8		       4a		      lsr
    140  f0c9		       4a		      lsr
    141  f0ca		       4a		      lsr		; band2 bit -> carry
    142  f0cb		       a9 00		      lda	#0
    143  f0cd		       2a		      rol
    144  f0ce		       f0 02		      beq	.SBTb2z
    145  f0d0		       a9 ff		      lda	#$ff
    146  f0d2				   .SBTb2z
    147  f0d2		       85 ef		      sta	BandTab+2
    148  f0d4							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
    149  f0d4							; set it this overscan) → blank all band gates so the cave renders no
    150  f0d4							; strip; the pack below then emits mask 0 → every overlay stays
    151  f0d4							; transparent too. BandTab restages from ROM next room entry. ---
    152  f0d4		       a5 ba		      lda	EnemyDeadMask
    153  f0d6		       29 08		      and	#$08
    154  f0d8		       f0 08		      beq	.SBTstripAlive
    155  f0da		       a9 00		      lda	#0
    156  f0dc		       85 ed		      sta	BandTab
    157  f0de		       85 ee		      sta	BandTab+1
    158  f0e0		       85 ef		      sta	BandTab+2
    159  f0e2				   .SBTstripAlive
    160  f0e2							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    161  f0e2							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    162  f0e2							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    163  f0e2							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    164  f0e2							; AFTER the cave read, so the alias never crosses a frame boundary.
    165  f0e2							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    166  f0e2							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    167  f0e2							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
    168  f0e2							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
    169  f0e2							; both overlay paths (PHM/blast) treat the strip as gone next frame.
    170  f0e2		       a5 99		      lda	RoomMetaA
    171  f0e4		       4a		      lsr
    172  f0e5		       4a		      lsr
    173  f0e6		       4a		      lsr
    174  f0e7		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
    175  f0e8		       f0 09		      beq	.M1zero
    176  f0ea		       0a		      asl
    177  f0eb		       0a		      asl
    178  f0ec		       0a		      asl		; *8
    179  f0ed		       18		      clc
    180  f0ee		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
    181  f0f0		       4c f5 f0 	      jmp	.M1got
    182  f0f3				   .M1zero
    183  f0f3		       a9 00		      lda	#0
    184  f0f5				   .M1got
    185  f0f5		       85 8e		      sta	CollisionEndX
    186  f0f7		       a5 ba		      lda	EnemyDeadMask
    187  f0f9		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    188  f0fb		       f0 04		      beq	.M1stage
    189  f0fd		       a9 00		      lda	#0
    190  f0ff		       85 8e		      sta	CollisionEndX
    191  f101				   .M1stage
    192  f101							; --- BallX staging: Temp ($88) ---
    193  f101							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    194  f101							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    195  f101							; GONE (user 2026-10-12: door must look like the plain async strip;
    196  f101							; only the key/bomb semantics differ). One write per VBL is the
    197  f101							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    198  f101		       a9 35		      lda	#$35
    199  f103		       85 0a		      sta	CTRLPF
    200  f105		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
    201  f107		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    202  f109							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
    203  f109							; and fake a 1-cell ball at x72-79 on a
    204  f109							; hot-without-ball model
    205  f109		       f0 0b		      beq	.SBTnoBall
    206  f10b		       0a		      asl
    207  f10c		       0a		      asl
    208  f10d		       0a		      asl		; *8
    209  f10e		       18		      clc
    210  f10f		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    211  f111							; calibrated SetObjectXPos arg (S6b: arg A
    212  f111							; draws clocks [A-7, A]; right_col c occupies
    213  f111							; [80+8c, 87+8c]). PHMOverlay recomputes this
    214  f111							; value independently (:1992) — the two MUST
    215  f111							; agree or the stripe draws beside its own
    216  f111							; collision cell (was #86 = +7px ≈ one cell
    217  f111							; right; user-spotted 2026-10-12).
    218  f111		       85 88		      sta	Temp
    219  f113		       4c 20 f1 	      jmp	.SBTballDone
    220  f116				   .SBTnoBall
    221  f116		       a9 00		      lda	#0
    222  f118		       85 88		      sta	Temp
    223  f11a							; --- No ball in this room → BE the ball gate off. ---------------------
    224  f11a							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    225  f11a							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    226  f11a							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    227  f11a							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    228  f11a							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    229  f11a							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    230  f11a		       85 ed		      sta	BandTab
    231  f11c		       85 ee		      sta	BandTab+1
    232  f11e		       85 ef		      sta	BandTab+2
    233  f120				   .SBTballDone
    234  f120							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
    235  f120							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
    236  f120							; (yellow $1C staged below), not width — the 4clk block read as "half
    237  f120							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
    238  f120		       a9 30		      lda	#$30
    239  f122		       85 05		      sta	NUSIZ1
    240  f124							; Door stripe color ($8D) is staged inside PhaseBlink (this window
    241  f124							; is full to the $F4C4 pin — the 14B staging block lives with the
    242  f124							; walk where there is hole).
    243  f124							; --- Phase 3: phase-cell blink (PF buffer pokes) ----------------------
    244  f124							; Body moved after the level data (PhaseBlink, ~130B — the StageBandTab
    245  f124							; window $F3C4..$F4C4 was full; the data window has the only free
    246  f124							; hole). Contract: clobbers A/X/Y/FetchPtr/RectCount/LineCount/
    247  f124							; CollisionCellX/CollisionEndY ($8F scratch — the pack below rebuilds
    248  f124							; it). The PF buffers ARE the collision map (cell walk + laser read
    249  f124							; them) — toggling the cell's two bits THERE makes render + PHM +
    250  f124							; laser follow with zero kernel cost. 64f full cycle = EnemyRamP bit5
    251  f124							; (32 on + 32 off; clock-derived, no state bytes — locked plan).
    252  f124							; --- PhaseBlink ping-pong (chunk A2): it MUST run after the band/ball
    253  f124							; staging above and before the pack below (the crunch walk overwrites
    254  f124							; Temp/BandTab for its cell — running it earlier let SBT's own staging
    255  f124							; erase the crunch mask, and every crunch kill stopped latching).
    256  f124							; Leg 1: this `sta` runs here, the fetch at $F803 is bank2's
    257  f124							; `jmp PhBlinkTail` (byte-image pinned in bank2.asm).
    258  f124							; --- A3: PhaseBlink is LOCAL now (the record stream lives in bank3) ---
    259  f124		       20 5e f4 	      jsr	PhaseBlink
    260  f127				   SBT_B
    261  f127							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
    262  f127							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
    263  f127							; (staged $8E != 0), 0 = symmetric. Cave never
    264  f127							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
    265  f127							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
    266  f127							; kernel's ball block reads it later this VBL).
    267  f127							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
    268  f127							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
    269  f127							; otherwise).
    270  f127		       a5 8e		      lda	CollisionEndX	; staged M1X (kill-gated above)
    271  f129		       f0 02		      beq	.M1nof	; 0 = no M1 → seed 0 (A is 0)
    272  f12b		       a9 08		      lda	#$08	; b3 = M1 present
    273  f12d				   .M1nof
    274  f12d		       85 8f		      sta	CollisionEndY
    275  f12f		       a5 88		      lda	Temp
    276  f131		       f0 26		      beq	.SBTPack	; no ball → keep b3-only (or 0) pack
    277  f133		       38		      sec
    278  f134		       e9 4f		      sbc	#79	; (BallX-79)>>3 = ball_col+1 (BallX =
    279  f136		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
    280  f137		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
    281  f138		       4a		      lsr
    282  f139		       0a		      asl
    283  f13a		       0a		      asl
    284  f13b		       0a		      asl
    285  f13c		       0a		      asl
    286  f13d		       05 8f		      ora	CollisionEndY	; merge with the b3 seed
    287  f13f		       85 8f		      sta	CollisionEndY
    288  f141							; BandTab bytes are $ff/$00 → their bit7 IS the gate.
    289  f141		       a9 00		      lda	#0
    290  f143		       24 ed		      bit	BandTab
    291  f145		       10 02		      bpl	.SBTp0
    292  f147		       09 01		      ora	#$01
    293  f149				   .SBTp0
    294  f149		       24 ee		      bit	BandTab+1
    295  f14b		       10 02		      bpl	.SBTp1
    296  f14d		       09 02		      ora	#$02
    297  f14f				   .SBTp1
    298  f14f		       24 ef		      bit	BandTab+2
    299  f151		       10 02		      bpl	.SBTp2
    300  f153		       09 04		      ora	#$04
    301  f155				   .SBTp2
    302  f155		       05 8f		      ora	CollisionEndY
    303  f157		       85 8f		      sta	CollisionEndY
    304  f159				   .SBTPack
    305  f159		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 VBLANK caller
    306  f15c				   M1OffTab		; Phase 5: MetaA b0 → M1 x-offset (left/right)
    307  f15c		       ff 4f		      .byte.b	$ff, $4f
