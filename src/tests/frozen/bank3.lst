    268  f9a1							; ==============================================================================
    269  f9a1							; HcrClock — retuned shutter clock (hcrunch-only; 2026-10-16 retune).
    270  f9a1							;   In:  X = full extent (cells, ≥1); reads EnemyRamP (StartFrame-pinned)
    271  f9a1							;   Out: A = covered (1..full) — never 0 (always-solid stub)
    272  f9a1							;   Clobbers A (X/Y preserved — unlike CrunchClock)
    273  f9a1							; s = EnemyRamP>>4 (0..15, one 256f period = 16 buckets of 16f):
    274  f9a1							;   s 0-3   dwell at home  (eff 0)	  -> n=1, 64f stub
    275  f9a1							;   s 4-12  grow to center  (eff s-3)	  -> n 2..full (1..9 cells of
    276  f9a1							;	    8px — full=w>>1; w=20 record = center of the screen)
    277  f9a1							;   s 13-15 fast retract    (eff 3*(15-s) = 6,3,0) — wipe home in 3
    278  f9a1							;	    steps (the old instant far-end turn, stretched to center)
    279  f9a1							; covered = 1 + min(eff, full-1). CrunchClock (sc>>2 triangle, ~4f/step)
    280  f9a1							; stays for its VCR mirrors + verify_build token gate — only the two
    281  f9a1							; hcrunch call sites moved here (16f/step, grow-to-center ruling
    282  f9a1							; 2026-10-16).
    283  f9a1							; ==============================================================================
    284  f9a1				   HcrClock
    285  f9a1		       a5 ba		      lda	EnemyDeadMask
    286  f9a3		       29 80		      and	#$80	; b7: crunch kill latched this visit?
    287  f9a5		       f0 03		      beq	.hcLive
    288  f9a7		       a9 01		      lda	#1	; spent — freeze the shutter at the home stub
    289  f9a9		       60		      rts		;   (min width) for the rest of the visit
    290  f9aa				   .hcLive
    291  f9aa		       e0 01		      cpx	#1
    292  f9ac		       d0 03		      bne	.hcN
    293  f9ae		       a9 01		      lda	#1	; full=1: n always 1
    294  f9b0		       60		      rts
    295  f9b1				   .hcN
    296  f9b1		       a5 c2		      lda	EnemyRamP
    297  f9b3		       4a		      lsr
    298  f9b4		       4a		      lsr
    299  f9b5		       4a		      lsr
    300  f9b6		       4a		      lsr		; s = P>>4
    301  f9b7		       c9 04		      cmp	#4
    302  f9b9		       b0 04		      bcs	.hcNd
    303  f9bb		       a9 00		      lda	#0	; s0-3 dwell: eff 0
    304  f9bd		       f0 11		      beq	.hcOut	; (always)
    305  f9bf				   .hcNd
    306  f9bf		       c9 0d		      cmp	#13
    307  f9c1		       b0 05		      bcs	.hcNf
    308  f9c3		       38		      sec
    309  f9c4		       e9 03		      sbc	#3	; s4-12: eff = s-3 (1..9) — grow to center
    310  f9c6		       b0 08		      bcs	.hcOut	; (always, no borrow)
    311  f9c8				   .hcNf
    312  f9c8		       49 0f		      eor	#$0F	; s13-15: t = 15-s (2,1,0) — fast retract
    313  f9ca		       85 8b		      sta	CollisionX
    314  f9cc		       0a		      asl
    315  f9cd		       18		      clc
