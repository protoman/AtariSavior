    136  f0a3							; B3StageBand — StageBandTab, MOVED from bank2 (chunk A2, 2026-10-19).
    137  f0a3							;
    138  f0a3							; Tail-entered from bank2 BCFDarkRun at $F3A9:
    139  f0a3							;   jsr PhaseBlink   (stays bank2 — it walks the rect stream)
    140  f0a3							;   sta $1FF9
    141  f0a3							;   jmp $F0A3	      <- OPCODE fetched from THIS bank at $F3AF
    142  f0a3							; so bank3 MUST hold `jmp $F0A3` at $F3AF (pinned at the end of this block).
    143  f0a3							; Zero pushes end to end: this body ends `jmp $FBF8` (ReturnPad), whose
    144  f0a3							; `sta $1FF6 / rts` pops the ORIGINAL bank0 VBL jsr — the chain never nests.
    145  f0a3							;
    146  f0a3							; Reads ZP ONLY: RoomMetaA/B are staged at room entry (bank2 EnterRoomB2),
    147  f0a3							; so no level-data access and therefore no bank2 read tramp is needed.
    148  f0a3							;
    149  f0a3							; Packed meta (bugs.md 28 point 1): MetaA = (m1_col+1)<<4 | band_mask
    150  f0a3							; (b0-2 = band0/1/2 gates); MetaB = ball_col+1 (0 = feature absent).
    151  f0a3							; Expanded every VBL to:
    152  f0a3							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates
    153  f0a3							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 = symmetric -> skip)
    154  f0a3							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    155  f0a3							; Window: this VBL write -> cave read -> bank1 HUD stomps $ED-$EF after the
    156  f0a3							; cave read -> overscan rewrites $88 (joystick) after the ball read.
    157  f0a3							; ==============================================================================
    158  f0a3					      org	$F0A3
    159  f0a3				   B3StageBand
    160  f0a3							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    161  f0a3							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    162  f0a3							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    163  f0a3							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    164  f0a3							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    165  f0a3							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    166  f0a3							; no-ball path below blanks BandTab so it never enables the ball.
    167  f0a3							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    168  f0a3							; the pack uses $8F).
    169  f0a3		       a5 99		      lda	RoomMetaA	; MetaA
    170  f0a5		       29 01		      and	#$01
    171  f0a7		       aa		      tax
    172  f0a8		       bd 5c f1 	      lda	M1OffTab,X
    173  f0ab		       85 92		      sta	RectCount
    174  f0ad		       a5 99		      lda	RoomMetaA	; MetaA
    175  f0af		       4a		      lsr		; band0 bit -> carry
    176  f0b0		       a9 00		      lda	#0
    177  f0b2		       2a		      rol
    178  f0b3		       f0 02		      beq	.SBTb0z
    179  f0b5		       a9 ff		      lda	#$ff
    180  f0b7				   .SBTb0z
    181  f0b7		       85 ed		      sta	BandTab
    182  f0b9		       a5 99		      lda	RoomMetaA
    183  f0bb		       4a		      lsr
    184  f0bc		       4a		      lsr		; band1 bit -> carry
    185  f0bd		       a9 00		      lda	#0
    186  f0bf		       2a		      rol
    187  f0c0		       f0 02		      beq	.SBTb1z
    188  f0c2		       a9 ff		      lda	#$ff
    189  f0c4				   .SBTb1z
    190  f0c4		       85 ee		      sta	BandTab+1
    191  f0c6		       a5 99		      lda	RoomMetaA
    192  f0c8		       4a		      lsr
    193  f0c9		       4a		      lsr
    194  f0ca		       4a		      lsr		; band2 bit -> carry
    195  f0cb		       a9 00		      lda	#0
    196  f0cd		       2a		      rol
    197  f0ce		       f0 02		      beq	.SBTb2z
    198  f0d0		       a9 ff		      lda	#$ff
    199  f0d2				   .SBTb2z
    200  f0d2		       85 ef		      sta	BandTab+2
    201  f0d4							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
    202  f0d4							; set it this overscan) → blank all band gates so the cave renders no
    203  f0d4							; strip; the pack below then emits mask 0 → every overlay stays
    204  f0d4							; transparent too. BandTab restages from ROM next room entry. ---
    205  f0d4		       a5 ba		      lda	EnemyDeadMask
    206  f0d6		       29 08		      and	#$08
    207  f0d8		       f0 08		      beq	.SBTstripAlive
    208  f0da		       a9 00		      lda	#0
