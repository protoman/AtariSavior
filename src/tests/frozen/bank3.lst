    140  f000		       00 00	   COLOR_CAVE_BG =	$00
    141  f000		       00 04	   COLOR_DARK_PF =	$04	; dark-room fuse walls
    142  f000		       00 1c	   COLOR_HOT_Y =	$1C	; kernel COLOR_BLINK_Y
