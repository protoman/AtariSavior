    237  f479		       99 c3 00 	      sta	PF0Buf,Y
    238  f47c		       bd 04 f6 	      lda	RowPoolPF1,X
    239  f47f		       99 c7 00 	      sta	PF1Buf,Y
    240  f482		       bd 10 f6 	      lda	RowPoolPF2,X
    241  f485		       99 cb 00 	      sta	PF2Buf,Y
    242  f488		       88		      dey
    243  f489		       10 e6		      bpl	.EBpf
    244  f48b
    245  f48b							; --- C5 meta source: the room's extras ordinal (LevelConnSpare, staged by
    246  f48b							;     EnterRoomB2, 0 = none) → the extras stream; otherwise MetaA = 0 and
    247  f48b							;     MetaB = $40 iff the shape is hot (C11: the flag is band 1's b7).
