     97  f008							; ==============================================================================
     98  f008							; HcrPush — cold growth push (user 2026-10-16): while the hcrunch prefix
     99  f008							; ADVANCES it shoves the player toward center, so a cold shutter cannot
    100  f008							; trap them inside (hot = kill semantics, unchanged). Called from
    101  f008							; PhHcrEntry on the 16f grow-step edge (EnemyRamP & $0F == 0) with the
    102  f008							; spent (b7) latch filtered; this body re-checks the phase (s4-12).
    103  f008							; In:	CollisionX = 8n (prefix width px), CollisionCellX = band (0-2),
    104  f008							;	Y = hot (full MetaB byte, bank2-staged; masked here). Out: RoomX
    105  f008							;	clamped out of the left prefix [0,8n) / the TIA mirror [160-8n,160);
    106  f008							;	A/X/Y + CollisionX clobbered.
    107  f008							; ==============================================================================
    108  f010					      org	$F010
    109  f010				   HcrPush
    110  f010		       98		      tya		; hot (MetaB b6, $40/0 — bank2-side, passed in Y)
    111  f011		       29 40		      and	#$40
    112  f013		       d0 40		      bne	.Hpd	; hot: kill semantics own it — no push
    113  f015		       a5 c2		      lda	EnemyRamP
    114  f017		       4a		      lsr
    115  f018		       4a		      lsr
    116  f019		       4a		      lsr
    117  f01a		       4a		      lsr		; s = P>>4
    118  f01b		       c9 04		      cmp	#4
    119  f01d		       90 36		      bcc	.Hpd	; s0-3 dwell: stub static, no push
    120  f01f		       c9 0d		      cmp	#13
    121  f021		       b0 32		      bcs	.Hpd	; s13-15 retract: opening, no push
    122  f023		       a6 8c		      ldx	CollisionCellX
    123  f025		       18		      clc
    124  f026		       a5 81		      lda	RoomY
    125  f028		       69 0b		      adc	#11	; PLAYER_SPRITE_H-1
    126  f02a		       38		      sec
    127  f02b		       fd a0 f0 	      sbc	HcrBandLo,X	; bottom - band_lo (0/48/96)
    128  f02e		       90 25		      bcc	.Hpd	; entirely above the band
    129  f030		       c9 3b		      cmp	#59	; 48+11: bottom-band_lo >= 59 → entirely below
    130  f032		       b0 21		      bcs	.Hpd
    131  f034		       a5 8b		      lda	CollisionX	; 8n
    132  f036		       c9 50		      cmp	#80
    133  f038		       b0 1b		      bcs	.Hpd	; sealed (n>=10): no aperture — HOVhcrunch kills
    134  f03a		       18		      clc
    135  f03b		       69 07		      adc	#7	; aperture_lo = 8n+7
    136  f03d		       c5 80		      cmp	RoomX
    137  f03f		       90 04		      bcc	.Hrr	; clear of the left prefix
    138  f041		       f0 02		      beq	.Hrr	; flush = clear
