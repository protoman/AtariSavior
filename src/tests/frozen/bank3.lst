   1061  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1062  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1063  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1064  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1065  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1066  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1067  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1068  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1069  fcb8							; the pack uses $8F).
   1070  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1071  fcba		       29 01		      and	#$01
   1072  fcbc		       aa		      tax
   1073  fcbd		       bd 6f fd 	      lda	M1OffTab,X
   1074  fcc0		       85 92		      sta	RectCount
   1075  fcc2							; --- band gates: a 4-bit mask -> one $ff/$00 byte per band ------------
   1076  fcc2							; b0-2 = MetaA, b3 = MetaB b4 (N=4, 2026-10-24: MetaA b3 is the left-door
   1077  fcc2							; flag, so the bottom band needs its own bit). The old code unrolled three
   1078  fcc2							; shift/rol/store triples (~16c each); a 16-row x 4 B template copy costs
   1079  fcc2							; about the same and pays for the fourth band inside the VBL budget.
   1080  fcc2							; LineCount ($84) is VBL scratch here — PhaseBlink clobbers it anyway.
   1081  fcc2		       a5 99		      lda	RoomMetaA
   1082  fcc4		       29 07		      and	#$07
   1083  fcc6		       85 84		      sta	LineCount
   1084  fcc8		       a5 9a		      lda	RoomMetaB
   1085  fcca		       29 10		      and	#$10
   1086  fccc		       4a		      lsr		; b4 -> b3
   1087  fccd		       05 84		      ora	LineCount	; 4-bit gate mask
   1088  fccf		       0a		      asl
   1089  fcd0		       0a		      asl		; *4 -> template row
   1090  fcd1		       aa		      tax
   1091  fcd2		       bd 0d ff 	      lda	BandTpl+0,X
   1092  fcd5		       85 cf		      sta	BandTab
   1093  fcd7		       bd 0e ff 	      lda	BandTpl+1,X
   1094  fcda		       85 d0		      sta	BandTab+1
   1095  fcdc		       bd 0f ff 	      lda	BandTpl+2,X
   1096  fcdf		       85 d1		      sta	BandTab+2
   1097  fce1		       bd 10 ff 	      lda	BandTpl+3,X
   1098  fce4		       85 d2		      sta	BandTab+3
