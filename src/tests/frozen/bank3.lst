    906  fb0d							; Prefix tables: P(n) for n pairs from pair 0 — n = 0..10.
    907  fb0d							; Pair → register: 0-1 PF0 ($30,$C0), 2-5 PF1 ($C0,$30,$0C,$03),
    908  fb0d							; 6-9 PF2 ($03,$0C,$30,$C0). PF0 maxes at n=2, PF1 at n=6, PF2 at n=10.
    909  fb0d							; Coverage starts at PAIR 1: pair 0 (display cols 0-1 + their mirror 38-39)
    910  fb0d							; is never covered, so a crunch room keeps its side opening usable — the player
    911  fb0d							; arrives in an 8-px vestibule and must time the crush to leave it. The static
    912  fb0d							; row keeps cell 0 solid (the loader ORs the feature cells 0..9); the runtime
    913  fb0d							; prefix below is what makes the side live.
    914  fb0d				   CrPfx0
    915  fb0d		       00 c0 c0 c0*	      .byte.b	$00, $C0, $C0, $C0, $C0, $C0, $C0, $C0, $C0, $C0, $C0
