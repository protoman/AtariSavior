    746  f0dd							; Inline stripe+hot test was 84-109c; budget is 76c/scanline.
    747  f0dd		       b5 e7		      lda	ColupfBuf,X
    748  f0df		       85 08		      sta	COLUPF
    749  f0e1		       85 88		      sta	Temp	; A1 (line-budget plan): stage band color
    750  f0e3							; for .ObjZero's A==8 restore (moved up —
    751  f0e3							; same A; Temp has no other kernel reader)
    752  f0e3		       a5 8d		      lda	CollisionCellY	; P2b door color staged by bank2 VBL:
    753  f0e5							; $80 = no door / $1C = yellow stripe
    754  f0e5		       30 06		      bmi	.M1band
    755  f0e7		       85 07		      sta	COLUP1	; door: yellow (only visible on the door's
    756  f0e9							;   open bands — wall PF hides it elsewhere)
    757  f0e9		       85 88		      sta	Temp	; bugs.md #15: also stage the door color into
    758  f0eb							;   Temp, so .ObjZero's plain restore keeps
    759  f0eb							;   the stripe yellow (0 extra cycles on the
    760  f0eb							;   object line; +3c here on the setup line)
    761  f0eb		       10 04		      bpl	.M1done	; $1C b7=0 → always
