   2316  f7df		       d0 39		      bne	.BTDone
   2317  f7e1		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2318  f7e3		       29 fc		      and	#%11111100
   2319  f7e5		       85 b5		      sta	BombPacked
   2320  f7e7		       a9 00		      lda	#0
