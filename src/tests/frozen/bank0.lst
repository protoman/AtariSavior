   1026  f124		       38		      sec
   1027  f125		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
   1028  f127		       c5 9d		      cmp	ObjHeight	; per-type window (all 16 today). COST: a ZP
   1029  f129							;   compare is 3 c vs the immediate's 2 c, so
   1030  f129							;   the worst path is 60 -> 61 and the WSYNC
   1031  f129							;   store c68 -> c69 (contract <= 73; measured
