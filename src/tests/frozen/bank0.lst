   4072  fe05							; $F744 fill needed 11 B for the Slot1Hook HMOVE fix; both are read
   4073  fe05							; abs,X so their address is irrelevant) ---
   4074  fe05				   EnemyColorTable
   4075  fe05		       14		      .byte.b	$14	; spider — hue 1 luma 2 = dark yellow
   4076  fe06		       f2		      .byte.b	$f2	; bat — hue 15 luma 7 = brown
   4077  fe07		       c4		      .byte.b	$c4	; snake — hue 12 luma 2 = green
   4078  fe08		       0e		      .byte.b	$0e	; tentacle — hue 0 luma 7 = white
   4079  fe09		       22		      .byte.b	$22	; moth — hue 2 luma 1 = dark orange
   4080  fe0a		       0e		      .byte.b	$0e	; lamp (type 5) — white; dark rooms override to grey
   4081  fe0b		       1c		      .byte.b	$1C	; key (type 6) — yellow
   4082  fe0c		       c4		      .byte.b	$c4	; raft (type 7) — green, matching the SNAKE art
   4083  fe0d							; slot it borrows ($c4 = ObjColorTab slot 6). User
   4084  fe0d							; 2026-10-18: keep the SOLID block and read it as
   4085  fe0d							; a trunk/log — the solid art also looks bigger
