   2490  f864		       60 30 30 18	      .byte.b	$60,$30,$30,$18	;  (legs)
   2491  f868		       60 f0 f0 60*	      .byte.b	$60,$f0,$f0,$60,$90,$60,$90,$90	; OBJ_SPIDER
