   1838  f59d							;   respawn hover is armed only by LoseLife
   1839  f59d		       a5 c0		      lda	LaserState
   1840  f59f		       29 c7		      and	#%11000111	; clear RoomDarkMask rooms 4-7 (LaserState b5-2)
