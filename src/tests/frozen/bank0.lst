   2339  f752							; Slot1Hook — called from the .Row setup (X = RowIdx = band). Swaps the live
   2340  f752							; trio when slot 1 lives in this band, then repositions P1 and strobes HMOVE
   2341  f752							; on the following line's HBLANK. Preserves X (RowIdx) and Y (running-Y: the
   2342  f752							; .Line loop relies on it being untouched between rows).
   2343  f752				   Slot1Hook
   2344  f752		       98		      tya
   2345  f753		       48		      pha		; save running-Y (SetObjectXPos does `tay`)
   2346  f754		       a5 eb		      lda	ObjTop1
   2347  f756		       18		      clc
   2348  f757		       65 81		      adc	RoomY
   2349  f759		       38		      sec
   2350  f75a		       e9 01		      sbc	#1	; A = slot 1's absolute room Y
   2351  f75c		       dd 00 fe 	      cmp	BandStart,X
   2352  f75f		       90 24		      bcc	.SHout	; above this band
   2353  f761		       dd 01 fe 	      cmp	BandStart+1,X
   2354  f764		       b0 1f		      bcs	.SHout	; in a later band
   2355  f766		       a5 ea		      lda	ObjBase1
   2356  f768		       85 b6		      sta	ObjBase
   2357  f76a		       a5 eb		      lda	ObjTop1
   2358  f76c		       85 bb		      sta	ObjTop
   2359  f76e		       a5 ec		      lda	ObjX1
   2360  f770		       85 b7		      sta	ActiveObjectX
   2361  f772		       a2 01		      ldx	#1
   2362  f774		       20 0f ff 	      jsr	SetObjectXPos	; its own WSYNC starts the positioning line
   2363  f777							; The frame's ONE HMOVE already ran in the VBL; this second one exists only
   2364  f777							; for slot 1's own fine adjust. HMP0/HMM0/HMBL still hold the PLAYER's,
   2365  f777							; the laser's and the ball's fine values, and HMOVE would apply them a
   2366  f777							; second time — the player's fine adjust doubled (drawn X advanced 2 px per
   2367  f777							; 1 px of RoomX, sawing +/-15 px as the fine value cycled: the "raft
   2368  f777							; zig-zag", user 2026-10-22). Clear them; HMP1 stays (set above).
   2369  f777							; THESE CLEARS MUST SIT BEFORE THE `sta WSYNC` BELOW: they cost ~14 cycles,
   2370  f777							; and an HMOVE written after cycle 0 of HBLANK gives up part of the fine
   2371  f777							; shift (late-HMOVE penalty) — slot 1's sprite then snaps in ~4 px steps
   2372  f777							; (user 2026-10-22: "raft moves one tile at a time").
   2373  f777		       a9 00		      lda	#0
   2374  f779		       85 20		      sta	HMP0
   2375  f77b		       85 22		      sta	HMM0
   2376  f77d		       85 24		      sta	HMBL
   2377  f77f		       a6 92		      ldx	RowIdx
   2378  f781		       85 02		      sta	WSYNC	; end of the positioning line
   2379  f783		       85 2a		      sta	HMOVE	; cycle 0 of the next line = HBLANK
