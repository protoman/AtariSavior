   4040  ff40		       85 c0		      sta	LaserState
   4041  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4042  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4043  ff46							; below — moved here so the cap code could
