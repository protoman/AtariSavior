   1531  f3c8							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1532  f3c8							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1533  f3c8							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1534  f3c8							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1535  f3c8							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1536  f3c8							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1537  f3c8							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1538  f3c8							; so the first move is the retreat into its wall. Ignores editor range_* per
   1539  f3c8							; user 2026-09-23. No wall collision.
   1540  f3c8							; ------------------------------------------------------------------------------
   1541  f3c8				   UpdateEnemies
   1542  f3c8		       a5 b3		      lda	EnemyCount
   1543  f3ca		       d0 01		      bne	UE_Start
   1544  f3cc		       60		      rts
   1545  f3cd				   UE_Start
   1546  f3cd							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1547  f3cd							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1548  f3cd		       a5 b1		      lda	EnemyDataLo
   1549  f3cf		       85 e5		      sta	FetchPtr
   1550  f3d1		       a5 b2		      lda	EnemyDataHi
