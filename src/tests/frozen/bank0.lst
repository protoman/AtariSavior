    972  f17b							; than before (one line, ~15px of row7 dup) —
    973  f17b							; accepted to fit +1B headroom.
    974  f17b				   .ObjNoRes
    975  f17b		       a9 00		      lda	#0
    976  f17d		       85 1c		      sta	GRP1
