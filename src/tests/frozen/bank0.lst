   2197  f608							; ------------------------------------------------------------------------------
   2198  f608							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2199  f608							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2200  f608							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2201  f608							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2202  f608							; ------------------------------------------------------------------------------
   2203  f608				   UEDispatch
   2204  f608		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2205  f60a							;   the single type-compare entry. 2026-10-22:
   2206  f60a							;   a raft authored dir=right read $87, missed
   2207  f60a							;   `cmp #ENEMY_RAFT` and its body never ran
   2208  f60a							;   (no tide, no motion, no rider pin).
   2209  f60a		       c9 07		      cmp	#ENEMY_RAFT
   2210  f60c		       d0 06		      bne	.UEDNotRaft
   2211  f60e		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2212  f611		       4c 36 f4 	      jmp	UE_Next
   2213  f614				   .UEDNotRaft
   2214  f614		       c9 03		      cmp	#ENEMY_TENTACLE
   2215  f616		       d0 03		      bne	.UEDNotTent
   2216  f618		       4c 3d f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2217  f61b				   .UEDNotTent
   2218  f61b		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2219  f61d		       d0 03		      bne	.UEDNotMoth
   2220  f61f		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2221  f622				   .UEDNotMoth
   2222  f622		       c9 02		      cmp	#ENEMY_SNAKE
   2223  f624		       d0 03		      bne	.UEDNotSnake
   2224  f626		       4c f2 f3 	      jmp	UE_SnakeBody
   2225  f629				   .UEDNotSnake
   2226  f629		       4c 36 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2227  f62c							; (absolute jmps: this block is far from the
   2228  f62c							;  bodies — relative branches do not reach)
