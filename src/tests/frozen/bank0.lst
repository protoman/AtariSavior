   2670  f812		       49 01		      eor	#1
   2671  f814		       aa		      tax
   2672  f815		       c5 b3		      cmp	EnemyCount
   2673  f817		       b0 0c		      bcs	.SOSkipNone	; no such enemy
   2674  f819		       a5 ba		      lda	EnemyDeadMask
   2675  f81b		       3d c9 f3 	      and	EnemyBitTable,X
   2676  f81e		       d0 05		      bne	.SOSkipNone	; partner dead too
   2677  f820		       86 b9		      stx	EnemyIndex
   2678  f822		       4c f8 f6 	      jmp	.SOEnemyLive
   2679  f825				   .SOSkipNone
   2680  f825		       a9 ff		      lda	#$FF
   2681  f827		       85 b6		      sta	ObjBase
   2682  f829		       4c 44 f7 	      jmp	.SODone
