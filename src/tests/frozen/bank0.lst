   1799  f55e							; --- Fold batch (P2.7): LevelDataTable lives in bank2 at the frozen
   1800  f55e							; address. Stage FetchPtr immediately before the batch; FoldIndirect
   1801  f55e							; preserves X and Y (iny flow below unchanged), returns the byte in A.
   1802  f55e							; The ldx #0 is kept for callers that expect X clear on entry. ---
   1803  f55e		       a9 00		      lda	#<LEVEL_DATA_ADDR
   1804  f560		       85 e5		      sta	FetchPtr
