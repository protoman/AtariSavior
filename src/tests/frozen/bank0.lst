   1743  f494							; ------------------------------------------------------------------------------
   1744  f494							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1745  f494							; there is no free ZP byte for per-slot movement state (phase/direction live
   1746  f494							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1747  f494							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1748  f494							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1749  f494							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1750  f494							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1751  f494							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1752  f494							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1753  f494							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1754  f494							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1755  f494							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1756  f494							;	    the 60-frame game timer — gates from it wrap every second).
   1757  f494							; Other types: straight ROM y (their movement stages come later).
   1758  f494							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1759  f494							; ------------------------------------------------------------------------------
   1760  f494				   DeriveEnemyY
   1761  f494							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1762  f494							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1763  f494		       a5 b1		      lda	EnemyDataLo
   1764  f496		       85 e5		      sta	FetchPtr
   1765  f498		       a5 b2		      lda	EnemyDataHi
