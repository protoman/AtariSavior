   1507  f41f							; ------------------------------------------------------------------------------
   1508  f41f							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1509  f41f							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1510  f41f							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1511  f41f							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1512  f41f							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1513  f41f							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1514  f41f							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1515  f41f							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1516  f41f							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1517  f41f							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1518  f41f							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1519  f41f							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1520  f41f							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1521  f41f							; ------------------------------------------------------------------------------
   1522  f41f				   UE_Tentacle
   1523  f41f		       a5 ad		      lda	TickCounter
   1524  f421		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1525  f423							; = half the player's 1 px/frame (user
   1526  f423							; 2026-10-10: &3 read as chunky/slow)
   1527  f423		       d0 4b		      bne	.TentOut
   1528  f425		       b5 bd		      lda	EnemyRamX,X
   1529  f427		       c5 80		      cmp	RoomX
   1530  f429		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1531  f42b		       90 06		      bcc	.TentRight
   1532  f42d		       38		      sec
   1533  f42e		       e9 01		      sbc	#1	; step left
   1534  f430		       4c 36 f4 	      jmp	.TentProbe
   1535  f433				   .TentRight
   1536  f433		       18		      clc
   1537  f434		       69 01		      adc	#1	; step right
   1538  f436				   .TentProbe
   1539  f436		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1540  f438		       b0 36		      bcs	.TentOut
   1541  f43a		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1542  f43c							; Same-column cull: committed X is always probe-clear, so a candidate in
   1543  f43c							; the same 4px column covers the same collision cells → result is known
   1544  f43c							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1545  f43c		       a5 88		      lda	Temp
   1546  f43e		       55 bd		      eor	EnemyRamX,X
   1547  f440		       29 fc		      and	#$FC
   1548  f442		       f0 28		      beq	.TentCommit
   1549  f444		       a5 80		      lda	RoomX
   1550  f446		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1551  f448		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1552  f44a		       85 b8		      sta	ActiveObjectY
   1553  f44c		       a5 88		      lda	Temp
   1554  f44e		       c9 05		      cmp	#5
   1555  f450		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1556  f452							; PHM's negative visible-left wraps to 255
   1557  f452							; (col garbage / ColOff OOB walk). cand<=4
   1558  f452							; ink pokes off-screen anyway; RoomX=cand
   1559  f452							; already covers cell0.
   1560  f452		       38		      sec
   1561  f453		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1562  f455							; sits 5/7 px left of A (moth .Mvl convention,
   1563  f455							; bank2), but PHM's PLAYER prologue derives
   1564  f455							; lit-left = arg-4/arg-7 with the bin on
   1565  f455							; RoomX-PlayerDir → box missed the cell left
   1566  f455							; of the ink at cand 8/12 (sprite drew 1 px
   1567  f455							; into the wall — bugs.md #4). cand-1 shifts
   1568  f455							; the tested box 1 px left: cell-exact or 1 px
   1569  f455							; conservative for every cand/facing pair
   1570  f455							; (tools/test_cell_map.py tentacle section).
   1571  f455				   .TentProbeX
   1572  f455		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1573  f457		       b5 e2		      lda	EnemyRamY,X
   1574  f459		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1575  f45b		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1576  f45d							; (rect walk ldx/dex/tax) — slot was lost here
   1577  f45d		       20 26 f9 	      jsr	PlayerHitsMap
   1578  f460		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1579  f462		       a5 b8		      lda	ActiveObjectY
   1580  f464		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1581  f466		       a5 b7		      lda	ActiveObjectX
   1582  f468		       85 80		      sta	RoomX	; restore player X
   1583  f46a		       b0 04		      bcs	.TentOut	; wall → hold position
   1584  f46c				   .TentCommit
   1585  f46c		       a5 88		      lda	Temp
   1586  f46e		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1587  f470				   .TentOut
   1588  f470		       4c 1a f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1589  f473
   1590  f473							; ------------------------------------------------------------------------------
   1591  f473							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1592  f473							; there is no free ZP byte for per-slot movement state (phase/direction live
   1593  f473							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1594  f473							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1595  f473							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1596  f473							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1597  f473							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1598  f473							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1599  f473							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1600  f473							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1601  f473							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1602  f473							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1603  f473							;	    the 60-frame game timer — gates from it wrap every second).
   1604  f473							; Other types: straight ROM y (their movement stages come later).
   1605  f473							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1606  f473							; ------------------------------------------------------------------------------
   1607  f473				   DeriveEnemyY
   1608  f473							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1609  f473							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1610  f473		       a5 b1		      lda	EnemyDataLo
   1611  f475		       85 e5		      sta	FetchPtr
   1612  f477		       a5 b2		      lda	EnemyDataHi
   1613  f479		       85 e6		      sta	FetchPtr+1
   1614  f47b		       bc b2 f9 	      ldy	EnemyOffTable,X
   1615  f47e		       20 f6 fe 	      jsr	FoldIndirect	; type
   1616  f481		       c9 01		      cmp	#ENEMY_BAT
   1617  f483		       f0 18		      beq	.DEYTickNoShift
   1618  f485		       c9 03		      cmp	#ENEMY_TENTACLE
   1619  f487		       f0 1a		      beq	.DEYTickShift
   1620  f489		       c9 00		      cmp	#ENEMY_SPIDER
   1621  f48b		       f0 2e		      beq	.DEYSpiderTick
   1622  f48d		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1623  f48f		       d0 06		      bne	.DEYStatic
   1624  f491		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1625  f494		       4c b0 f4 	      jmp	DEYDelta
   1626  f497				   .DEYStatic
   1627  f497		       c8		      iny
   1628  f498		       c8		      iny
   1629  f499		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1630  f49c		       60		      rts
   1631  f49d				   .DEYTickNoShift
   1632  f49d		       a5 c2		      lda	EnemyRamP
   1633  f49f		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1634  f4a0		       4c a8 f4 	      jmp	.DEYBobTick
