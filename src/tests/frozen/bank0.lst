   2609  f961		       98		      tya		; A = visible_left
   2610  f962		       18		      clc
   2611  f963		       69 06		      adc	#PLAYER_WIDTH - 1
   2612  f965		       4a		      lsr
   2613  f966		       4a		      lsr
   2614  f967		       c9 14		      cmp	#TILE_COLUMNS
   2615  f969		       90 07		      bcc	.lastOk
   2616  f96b		       85 8b		      sta	CollisionX
   2617  f96d		       a9 27		      lda	#39
   2618  f96f		       38		      sec
   2619  f970		       e5 8b		      sbc	CollisionX
   2620  f972				   .lastOk
   2621  f972		       85 8c		      sta	CollisionCellX	; max text column
   2622  f974
   2623  f974							; Ensure min <= max (blocks 20+ reverse the column order)
   2624  f974		       a5 8e		      lda	CollisionEndX
   2625  f976		       c5 8c		      cmp	CollisionCellX
   2626  f978		       90 06		      bcc	.colsOk
