   2026  f5b1		       c6 f7		      dec	BombTimer
   2027  f5b3		       d0 2a		      bne	.BTDone
   2028  f5b5		       a5 b5		      lda	BombPacked	; 1 → 2
   2029  f5b7		       29 fc		      and	#%11111100
   2030  f5b9		       09 02		      ora	#%00000010
   2031  f5bb		       85 b5		      sta	BombPacked
   2032  f5bd		       a9 3c		      lda	#60
   2033  f5bf		       85 f7		      sta	BombTimer
   2034  f5c1		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2035  f5c4		       aa		      tax
   2036  f5c5		       f0 08		      beq	.BTNoScore
   2037  f5c7				   .BTScore
   2038  f5c7		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2039  f5c9		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2040  f5cc		       ca		      dex
   2041  f5cd		       d0 f8		      bne	.BTScore
   2042  f5cf				   .BTNoScore
   2043  f5cf		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2044  f5d2		       f0 05		      beq	.BTNoKill
   2045  f5d4		       a9 50		      lda	#$50	; +50 per kill — moved out of the pad body
   2046  f5d6		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2047  f5d9				   .BTNoKill
   2048  f5d9		       20 e0 f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2049  f5dc		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2050  f5df				   .BTDone
