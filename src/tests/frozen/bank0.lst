   1193  f26e							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1194  f26e		       a5 94		      lda	vyHi
   1195  f270		       30 0f		      bmi	.RiseClamp
   1196  f272		       c9 02		      cmp	#>MAX_FALL
   1197  f274		       90 17		      bcc	.Integrate
   1198  f276		       a9 02		      lda	#>MAX_FALL
   1199  f278		       85 94		      sta	vyHi
   1200  f27a		       a9 00		      lda	#<MAX_FALL
