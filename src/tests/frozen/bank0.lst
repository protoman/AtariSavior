   2254  f79d		       a5 b5		      lda	BombPacked	; 1 → 2
   2255  f79f		       29 fc		      and	#%11111100
   2256  f7a1		       09 02		      ora	#%00000010
   2257  f7a3		       85 b5		      sta	BombPacked
   2258  f7a5		       a9 3c		      lda	#60
   2259  f7a7		       85 f7		      sta	BombTimer
