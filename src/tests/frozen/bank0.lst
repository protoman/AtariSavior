    369 U00bc							; Jetpack physics constants (HERO-style)
    370 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    371 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    372 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    373 U00bc							; capped by the -$0100 rise clamp. From rest the
    374 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    375 U00bc							; take-off still eases in (~0.15 s); from a
    376 U00bc							; terminal 1.5 px/frame fall a held jet applies
    377 U00bc							; JET_MAX immediately and stops it in ~10 frames
