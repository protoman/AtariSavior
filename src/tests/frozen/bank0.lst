   1990  f54b		       c9 0e		      cmp	#PLAYER_WIDTH + ENEMY_WIDTH - 1
   1991  f54d		       b0 3e		      bcs	CEHNext	; no X overlap
   1992  f54f		       85 8b		      sta	CollisionX	; keep x-overlap span for lamp's narrower box
   1993  f551							; Y overlap: player [RoomY, +11] vs enemy [ActiveObjectY, +11] — exact
