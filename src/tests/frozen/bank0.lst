   1447  f3b3							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1448  f3b3							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1449  f3b3							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1450  f3b3							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1451  f3b3							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1452  f3b3							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1453  f3b3							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1454  f3b3							; so the first move is the retreat into its wall. Ignores editor range_* per
   1455  f3b3							; user 2026-09-23. No wall collision.
   1456  f3b3							; ------------------------------------------------------------------------------
   1457  f3b3				   UpdateEnemies
   1458  f3b3		       a5 b3		      lda	EnemyCount
   1459  f3b5		       d0 01		      bne	UE_Start
   1460  f3b7		       60		      rts
   1461  f3b8				   UE_Start
   1462  f3b8							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1463  f3b8							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1464  f3b8		       a5 b1		      lda	EnemyDataLo
   1465  f3ba		       85 e5		      sta	FetchPtr
   1466  f3bc		       a5 b2		      lda	EnemyDataHi
   1467  f3be		       85 e6		      sta	FetchPtr+1
   1468  f3c0		       a2 00		      ldx	#0
   1469  f3c2				   UE_Loop
   1470  f3c2		       e4 b3		      cpx	EnemyCount
   1471  f3c4		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1472  f3c6		       4c 21 f4 	      jmp	UE_Exit
   1473  f3c9				   UE_Alive
   1474  f3c9		       a5 ba		      lda	EnemyDeadMask
   1475  f3cb		       3d af f3 	      and	EnemyBitTable,X
   1476  f3ce		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1477  f3d0		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1478  f3d3		       20 f6 fe 	      jsr	FoldIndirect	; type
   1479  f3d6		       4c f0 f5 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1480  f3d9							; 18 B per-type compare chain with one 3 B jmp:
   1481  f3d9							; frees 15 B of pre-pad headroom and gives the
   1482  f3d9							; type tables room for the raft byte.
   1483  f3d9				   UE_SnakeBody
   1484  f3d9		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1485  f3db		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1486  f3dd		       d0 3e		      bne	UE_Next
   1487  f3df							; live dir bit: 1 = right, 0 = left
   1488  f3df		       bd af f3 	      lda	EnemyBitTable,X
   1489  f3e2		       25 c1		      and	EnemyRamD
   1490  f3e4		       d0 1d		      bne	UE_SnakeRight
   1491  f3e6				   UE_SnakeLeft
   1492  f3e6		       d6 bd		      dec	EnemyRamX,X
   1493  f3e8		       c8		      iny		; +1 = ROM spawn X
   1494  f3e9		       20 f6 fe 	      jsr	FoldIndirect
   1495  f3ec		       85 88		      sta	Temp
   1496  f3ee		       38		      sec
   1497  f3ef		       e9 04		      sbc	#SNAKE_PATROL	; rmin = spawn - SNAKE_PATROL: SYMMETRIC patrol
   1498  f3f1							; (user 2026-10-19) — no dir read needed, the
   1499  f3f1							; range is the placement ± one tile either way
   1500  f3f1		       85 88		      sta	Temp
   1501  f3f3		       b5 bd		      lda	EnemyRamX,X
   1502  f3f5		       c5 88		      cmp	Temp
   1503  f3f7		       b0 24		      bcs	UE_Next	; X >= rmin OK
   1504  f3f9		       a5 88		      lda	Temp
   1505  f3fb		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1506  f3fd		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1507  f400		       4c 1d f4 	      jmp	UE_Next
   1508  f403				   UE_SnakeRight
   1509  f403		       f6 bd		      inc	EnemyRamX,X
   1510  f405		       c8		      iny		; +1 = ROM spawn X
   1511  f406		       20 f6 fe 	      jsr	FoldIndirect
   1512  f409		       85 88		      sta	Temp
   1513  f40b		       18		      clc
   1514  f40c		       69 04		      adc	#SNAKE_PATROL	; rmax = spawn + SNAKE_PATROL (symmetric)
   1515  f40e		       85 88		      sta	Temp
   1516  f410		       b5 bd		      lda	EnemyRamX,X
   1517  f412		       c5 88		      cmp	Temp
   1518  f414		       90 07		      bcc	UE_Next	; X < rmax OK
   1519  f416		       a5 88		      lda	Temp
   1520  f418		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
