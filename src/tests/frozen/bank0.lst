    473  f031							; --- Set player color ---
    474  f031		       a9 48		      lda	#COLOR_PLAYER
    475  f033		       85 06		      sta	COLUP0
    476  f035
    477  f035							; --- Set playfield to reflected mode + priority ---
    478  f035							; D0=1 = reflect (left half mirrors to right)
    479  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    480  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    481  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    482  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    483  f037		       85 0a		      sta	CTRLPF
