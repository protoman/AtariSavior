    331 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    332 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    333 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    334 U00bc							; placed X, so the snake retreats a tile behind
    335 U00bc							; its placement and then comes out a tile — 2
    336 U00bc							; tiles of travel total. The editor cannot ask
    337 U00bc							; the user to place it 2 tiles from the border.
