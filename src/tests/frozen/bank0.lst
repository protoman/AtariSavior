   1686  f4a1		       f0 2e		      beq	.DEYSpiderTick
   1687  f4a3		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1688  f4a5		       d0 06		      bne	.DEYStatic
