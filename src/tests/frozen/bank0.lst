   3916  fcc1		       a5 8a		      lda	DropTarget
   3917  fcc3		       c9 fd		      cmp	#$FD
   3918  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3919  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3920  fcc7							;   tally cleared to 0 by TallyWork before its
   3921  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3922  fcc7		       a5 81		      lda	RoomY
   3923  fcc9		       85 8a		      sta	DropTarget
   3924  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3925  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3926  fccf		       a9 00		      lda	#0
   3927  fcd1		       85 81		      sta	RoomY
   3928  fcd3		       85 95		      sta	PlayerYSub
   3929  fcd5		       85 93		      sta	vyLo
   3930  fcd7		       85 94		      sta	vyHi
