   3290  fcf8		       20 08 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3291  fcfb		       a9 00		      lda	#0
   3292  fcfd		       85 f3		      sta	ScoreTh
   3293  fcff		       85 f4		      sta	ScoreHu
