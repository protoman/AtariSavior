   1781  f545		       4a		      lsr
   1782  f546		       4a		      lsr
   1783  f547		       4a		      lsr
   1784  f548		       29 0f		      and	#$0f
   1785  f54a		       c9 0f		      cmp	#$0f
   1786  f54c		       f0 07		      beq	.NoUp
