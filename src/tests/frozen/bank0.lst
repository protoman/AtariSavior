   3096  fd31							; ------------------------------------------------------------------------------
   3097  fd31							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3098  fd31							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3099  fd31							; selected level number (digits band) and the credits; the theme plays here.
   3100  fd31							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3101  fd31							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3102  fd31							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3103  fd31							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3104  fd31							;	    the intro exit ate the first press and made #2 read as dead)
   3105  fd31							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3106  fd31							;	    the real drop-in → gameplay starts
   3107  fd31							; ($FD reaches here directly — merged title, 2026-10-19.)
   3108  fd31							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3109  fd31							; title-owned; the first play frame rewrites it as the step budget).
   3110  fd31							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3111  fd31							; ------------------------------------------------------------------------------
   3112  fd31				   TitleWork
   3113  fd31							; --- SELECT edge (TitleSelect, fill region) ---
   3114  fd31		       20 4f fc 	      jsr	CallPad_TitleSelect
   3115  fd34		       90 03		      bcc	.TWselDone	; C=0: no edge
   3116  fd36		       20 2f f5 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3117  fd39				   .TWselDone
   3118  fd39							; --- RESET edge ---
   3119  fd39		       a5 97		      lda	StepsLeft
   3120  fd3b		       29 01		      and	#%00000001
   3121  fd3d		       f0 14		      beq	.TWrstDone
   3122  fd3f		       ad 82 02 	      lda	SWCHB
   3123  fd42		       29 01		      and	#%00000001
   3124  fd44		       d0 0d		      bne	.TWrstDone
   3125  fd46		       a9 00		      lda	#0
   3126  fd48		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3127  fd4a		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3128  fd4c		       85 f4		      sta	ScoreHu
   3129  fd4e		       85 f5		      sta	ScoreTe
   3130  fd50		       20 2f f5 	      jsr	LoadLevel
   3131  fd53				   .TWrstDone
   3132  fd53		       ad 82 02 	      lda	SWCHB
   3133  fd56		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3134  fd58							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3135  fd58							;     channel force-muted here — UpdateJetSound is skipped because
   3136  fd58							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3137  fd58							;     = 0, AUDV0 covered above). ---
   3138  fd58				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3139  fd58		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3140  fd5a		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3141  fd5c		       f0 0e		      beq	.TWmusic
   3142  fd5e		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3143  fd60		       20 94 f7 	      jsr	BombTick
   3144  fd63				   .TWnoTick
   3145  fd63		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3146  fd66		       a9 00		      lda	#0
   3147  fd68		       85 1a		      sta	AUDV1
   3148  fd6a		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3149  fd6c				   .TWmusic		; title: music wins the audio regs
   3150  fd6c		       20 61 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3151  fd6f				   .TWwait
   3152  fd6f		       ad 84 02 	      lda	INTIM
   3153  fd72		       d0 fb		      bne	.TWwait
   3154  fd74		       4c 39 f0 	      jmp	StartFrame
