   1889  f5e9							; ==============================================================================
   1890  f5e9							; SelectActiveObject — choose the single GRP1 object to draw this frame.
   1891  f5e9							; The TIA has one GRP1 sprite, so objects flicker by rotating slots each frame.
   1892  f5e9							; Sets ObjBase, ActiveObjectX, ActiveObjectY, ObjTop, COLUP1.
   1893  f5e9							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   1894  f5e9							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0
   1895  f5e9							; (~15 Hz); other frames normal miner/enemy rotation (FlickerFrame alone).
   1896  f5e9							; One GRP1: cannot draw bomb + entity same frame.
   1897  f5e9							; ------------------------------------------------------------------------------
   1898  f5e9				   SelectActiveObject
   1899  f5e9							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   1900  f5e9							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   1901  f5e9							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   1902  f5e9							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   1903  f5e9							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   1904  f5e9							; middle of the screen" the moment the points counting started).
   1905  f5e9		       a5 8a		      lda	DropTarget
   1906  f5eb		       c9 fe		      cmp	#$FE
   1907  f5ed		       d0 27		      bne	.SOFull
   1908  f5ef		       a9 00		      lda	#0
   1909  f5f1		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   1910  f5f3		       85 b6		      sta	ObjBase	; 0 = no object
   1911  f5f5		       a5 a4		      lda	LevelMinerRoom
   1912  f5f7		       29 7f		      and	#$7f
   1913  f5f9		       c5 98		      cmp	RoomNo
   1914  f5fb		       f0 03		      beq	.SOTallyMiner
   1915  f5fd		       4c e5 f6 	      jmp	.SODone	; miner not here -> nothing drawn
   1916  f600				   .SOTallyMiner
   1917  f600		       a9 38		      lda	#OBJ_MINER
   1918  f602		       85 b6		      sta	ObjBase
   1919  f604		       a5 a5		      lda	MinerX
   1920  f606		       85 b7		      sta	ActiveObjectX
   1921  f608		       a5 a6		      lda	MinerY
   1922  f60a		       18		      clc
   1923  f60b		       69 03		      adc	#3	; same 3px offset as the normal miner path
   1924  f60d		       85 b8		      sta	ActiveObjectY
   1925  f60f		       a9 66		      lda	#$66	; purple (hue 6, luma 3)
   1926  f611		       85 07		      sta	COLUP1
   1927  f613		       4c e5 f6 	      jmp	.SODone
   1928  f616				   .SOFull
   1929  f616		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   1930  f618							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   1931  f618		       a5 b5		      lda	BombPacked
   1932  f61a		       29 03		      and	#%00000011
   1933  f61c		       c9 01		      cmp	#1
   1934  f61e		       d0 19		      bne	.SOCount
   1935  f620		       a5 f7		      lda	BombTimer
   1936  f622		       29 03		      and	#3
   1937  f624		       d0 13		      bne	.SOCount	; 3 of 4 -> miner/enemy
   1938  f626		       a9 40		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   1939  f628		       85 b6		      sta	ObjBase
   1940  f62a		       a5 f6		      lda	BombX
   1941  f62c		       85 b7		      sta	ActiveObjectX
   1942  f62e		       a5 85		      lda	BombY
   1943  f630		       85 b8		      sta	ActiveObjectY
   1944  f632		       a9 46		      lda	#COLOR_BOMBS	; $46 red (P1 X set by the .SODone tail)
   1945  f634		       85 07		      sta	COLUP1
   1946  f636		       4c e5 f6 	      jmp	.SODone	; ObjTop/Bot from ActiveObjectY
   1947  f639				   .SOCount
   1948  f639							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   1949  f639		       a5 b3		      lda	EnemyCount
   1950  f63b		       85 88		      sta	Temp
   1951  f63d		       a5 a4		      lda	LevelMinerRoom
   1952  f63f		       29 7f		      and	#$7f
   1953  f641		       c5 98		      cmp	RoomNo
   1954  f643		       d0 02		      bne	.SONoMiner
   1955  f645		       e6 88		      inc	Temp	; miner counts as a slot
   1956  f647				   .SONoMiner
   1957  f647		       a5 88		      lda	Temp
   1958  f649		       d0 09		      bne	.SONotNothing
   1959  f64b							; No objects this frame: A = Temp = 0. Blank the sprite AND reset the
   1960  f64b							; flicker counter — with no objects the modulo below never runs, so
   1961  f64b							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   1962  f64b							; would run O(FlickerFrame) iterations in the VBL on the next room with
   1963  f64b							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   1964  f64b		       85 b4		      sta	FlickerFrame
   1965  f64d		       a9 ff		      lda	#$FF
   1966  f64f		       85 b6		      sta	ObjBase
   1967  f651		       4c e5 f6 	      jmp	.SODone
