   2568  f926							; PlayerHitsMap — check player bounding box against the room's PF map
   2569  f926							; ==============================================================================
   2570  f926							; Boxes are in tile coordinates (col 0-19, row 0-2); the walk tests the
   2571  f926							; PF0/1/2Buf cell bits directly (cell_collision_plan 2.1) — no rect cache,
   2572  f926							; no rect-count limit. The playfield is reflected, so right-half display
   2573  f926							; cols mirror via 39-col IN THE PROLOGUE (walk sees left-half only).
   2574  f926							; Returns C=0 if clear, C=1 if blocked.
   2575  f926				   PlayerHitsMap
   2576  f926							; --- Tile row range (top, bottom) ---
   2577  f926							; Inlined row lookup: saves 2 JSR stack push levels (4B on stack) to keep SP >= $F8
   2578  f926		       a5 81		      lda	RoomY
   2579  f928		       4a		      lsr
   2580  f929		       4a		      lsr		; A = scanline >> 2
