    483 U00bc							; ==============================================================================
    484 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    485 U00bc							; ==============================================================================
    486 U00bc							; Bank3 is the power-up bank. Its stub does:
    487 U00bc							;   lda #0 / sta $1FF4 → selects bank0
    488 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    489 U00bc							; ==============================================================================
    490  10000 ????				       seg	code
    491  f000					      org	$F000
    492  f000
    493  f000							; --- 5-byte bankswitching pad ---
    494  f000							; After bank3's stub selects us, CPU arrives here.
    495  f000							; We jump over the pad into the real init code.
    496  f000		       a9 00		      lda	#0
    497  f002		       8d f4 1f 	      sta	$1FF4	; ensure bank0 selected (idempotent)
    498  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    499  f008							; (NOT deletable: $F008 = GameStart is a
    500  f008							;  hardcoded cross-bank entry — bank1
    501  f008							;  stub `jmp $F008`; this jmp also keeps
    502  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    503  f008							;  fold-pad byte guard fires when it moves)
    504  f008							;  + F0xx landmarks fixed)
    505  f008
    506  f008				   GameStart
    507  f008		       78		      sei		; disable interrupts
    508  f009		       d8		      cld		; clear decimal mode
    509  f00a		       a2 ff		      ldx	#$FF
    510  f00c		       9a		      txs		; stack pointer = $FF
    511  f00d
    512  f00d							; --- Clear zero-page RAM ---
    513  f00d		       a9 00		      lda	#0
    514  f00f		       a2 80		      ldx	#$80
    515  f011				   .ClearZP
    516  f011		       95 00		      sta	$00,X
    517  f013		       e8		      inx
    518  f014		       d0 fb		      bne	.ClearZP
    519  f016
    520  f016							; --- Initialize game state ---
    521  f016		       a9 00		      lda	#0
    522  f018		       85 a3		      sta	Level
    523  f01a		       a9 03		      lda	#3
    524  f01c		       85 ac		      sta	PlayerLives
    525  f01e		       a9 05		      lda	#BOMBS_MAX
    526  f020		       85 f0		      sta	PlayerBombs
    527  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    528  f022		       a9 3c		      lda	#60
    529  f024		       85 ad		      sta	TickCounter
    530  f026		       a9 78		      lda	#120
    531  f028		       85 ae		      sta	BarLevel	; bar starts full
    532  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    533  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    534  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    535  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    536  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    537  f02a		       a9 ff		      lda	#$FF
    538  f02c		       85 8a		      sta	DropTarget
    539  f02e
    540  f02e							; --- Load first level (the title previews it on the live stage:
    541  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    542  f02e		       20 20 fc 	      jsr	LoadLevel
    543  f031
    544  f031							; --- Set player color ---
    545  f031		       a9 48		      lda	#COLOR_PLAYER
    546  f033		       85 06		      sta	COLUP0
    547  f035
    548  f035							; --- Set playfield to reflected mode + priority ---
    549  f035							; D0=1 = reflect (left half mirrors to right)
    550  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    551  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    552  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    553  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    554  f037		       85 0a		      sta	CTRLPF
    555  f039
    556  f039							; ==============================================================================
    557  f039							; Frame loop
    558  f039							; ==============================================================================
    559  f039				   StartFrame
    560  f039
    561  f039							; ------------------------------------------------------------------------------
    562  f039							; VSYNC (3 scanlines)
    563  f039							; ------------------------------------------------------------------------------
    564  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    565  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    566  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    567  f039							; does not advance the wall clock to the next scanline boundary (it is already
    568  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    569  f039							; fraction depends on where the previous frame's overscan happened to end) —
    570  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    571  f039							;
    572  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    573  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    574  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    575  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    576  f039							; the sim wall-model target is updated to match.
    577  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    578  f03b		       a9 02		      lda	#2
    579  f03d		       85 00		      sta	VSYNC
    580  f03f		       85 02		      sta	WSYNC
    581  f041		       85 02		      sta	WSYNC
    582  f043		       85 02		      sta	WSYNC
    583  f045		       a9 00		      lda	#0
    584  f047		       85 00		      sta	VSYNC
    585  f049
    586  f049							; ------------------------------------------------------------------------------
    587  f049							; VBLANK (37 scanlines)
    588  f049							; ------------------------------------------------------------------------------
    589  f049		       a9 02		      lda	#2
    590  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    591  f04d
    592  f04d							; --- Set TIM64T for VBLANK ---
    593  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    594  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    595  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    596  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    597  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    598  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    599  f04d							; Worst 1059c of the 1472c window = 413c margin.
    600  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    601  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    602  f04d							; 2026-10-25: #23 -> #31 (flicker hunt, bugs.md #16). With #23 a room whose
    603  f04d							; GRP1 objects alternate (FlickerFrame) ran the heavy VBL path ~35c PAST
    604  f04d							; the timer on every other frame: the SOXP WSYNC straddled a line edge, the
    605  f04d							; poll exited at once, the entry anchor took the NEXT line -> 270/271 line
    606  f04d							; frames alternating = visible flicker. #24 (+64c) fixed that room, but the
    607  f04d							; two-object phase rooms (level 6 room 4) still overran ~40c on a 16-frame
    608  f04d							; cycle (the object X moves the div15 count) and flipped 271<->272 in
    609  f04d							; blocks. Then the whole-stage sweep (211 rooms) showed ~60 rooms with
    610  f04d							; two enemies + M1/ball patches overrunning by up to 5 lines (4 positioning
    611  f04d							; WSYNCs + the slot-1 staging ~ 1830c effective). The overscan real work is
    612  f04d							; only ~1520c of its 3200c, so the split moved: V #25->#31, O #50->#44 (the
    613  f04d							; V+O sum stays 75 = 272 lines). Result: every shipped room is a constant
    614  f04d							; 272 lines (level 20: constant 273), worst VBL poll slack ~107c.
    615  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    616  f04d		       a9 1f		      lda	#31
    617  f04f		       8d 96 02 	      sta	TIM64T
    618  f052
    619  f052							; --- Position player sprite horizontally ---
    620  f052		       a5 80		      lda	RoomX
    621  f054		       38		      sec
    622  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    623  f057		       a2 00		      ldx	#0	; X=0 = player0
    624  f059		       20 0f ff 	      jsr	SetObjectXPos
    625  f05c
    626  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    627  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    628  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    629  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    630  f05c
    631  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    632  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    633  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    634  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    635  f05c
    636  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    637  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    638  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    639  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    640  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    641  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    642  f05c		       20 2a f6 	      jsr	SelectActiveObject
    643  f05f
    644  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    645  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
