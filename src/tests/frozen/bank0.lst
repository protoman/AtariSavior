   4367  fecf		       a9 00		      lda	#0
   4368  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   4369  fed3				   .TWait
   4370  fed3		       ad 84 02 	      lda	INTIM
   4371  fed6		       d0 fb		      bne	.TWait
   4372  fed8		       4c 39 f0 	      jmp	StartFrame
