   2493  f874		       f0 f0 60 60*	      .byte.b	$f0,$f0,$60,$60,$f0,$f0,$f0,$60	; OBJ_LAMP
   2494  f87c		       60 60 60 60	      .byte.b	$60,$60,$60,$60	;  (post / base)
   2495  f880		       60 90 80 60*	      .byte.b	$60,$90,$80,$60,$30,$30,$30,$30	; OBJ_TENTACLE
