   2598  f7d5							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2599  f7d5							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF5`
   2600  f7d5							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2601  f7d5							; not from here. That is the same FoldIndirect discipline every other tramp
   2602  f7d5							; uses — the twin cannot be skipped or shortened.
   2603  f7d5							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2604  f7d5							; ------------------------------------------------------------------------------
   2605  f7d5							; M1ColFromMeta — A = the async M1 sprite column (M1X) for this room, or 0 when
   2606  f7d5							; the room carries no side-1 patch.
   2607  f7d5							; MetaA ($99, RoomPF0Lo here) = ((m1_col+1) << 4) | band_mask | b3, written
   2608  f7d5							; convert_room.meta_bytes; M1X = 8*col + 7 is that field's inverse. Deriving it
   2609  f7d5							; here (instead of staging at room load) keeps bank3's pinned code untouched,
   2610  f7d5							; and it feeds the hot-overlap box test too, which reads M1X.
   2611  f7d5							; Flags: Z is left SET when A = 0, so the caller can branch right after.
   2612  f7d5							; ------------------------------------------------------------------------------
   2613  f7d5							; ------------------------------------------------------------------------------
   2614  f7d5							; DoorLocked — a locked door (M1 patch cell, PF-open) hit by the player.
   2615  f7d5							; In: nothing new (the overlay's box scratch is live). Out: C=1 blocked, or a
   2616  f7d5							; tail jump into HotOverlapFlag when the room is HOT, where the overlap body
   2617  f7d5							; also gets to apply the hot hit.
   2618  f7d5							; Why: the locked case used to jump straight to HotOverlapFlag, and its bank3
   2619  f7d5							; body returns C=0 when the hot stream has no hit — a cold room's door was
   2620  f7d5							; therefore walk-through (user report: "door is not solid, neither with nor
   2621  f7d5							; without the key").
   2622  f7d5							; ------------------------------------------------------------------------------
   2623  f7d5				   DoorLocked
   2624  f7d5		       a5 9a		      lda	RoomPF0Hi	; staged MetaB
   2625  f7d7		       29 40		      and	#$40	; b6 = mid_band_type hot shape
   2626  f7d9		       d0 02		      bne	.DLhot
   2627  f7db		       38		      sec		; cold room: the door is simply solid
   2628  f7dc		       60		      rts
   2629  f7dd				   .DLhot
   2630  f7dd		       4c ec ff 	      jmp	HotOverlapFlag	; hot band: overlap body owns the hit (C=1)
   2631  f7e0
   2632  f7e0				   M1ColFromMeta
   2633  f7e0		       a5 ba		      lda	EnemyDeadMask
   2634  f7e2		       29 10		      and	#$10	; b4 = M1 strip destroyed -> transparent
   2635  f7e4		       d0 1c		      bne	.M1Cgone	;   (the collision overlay honours the same
   2636  f7e6							;   bit, so the sprite now dies with it)
   2637  f7e6		       a5 99		      lda	RoomPF0Lo	; bank3 stages MetaA over this dead pointer byte
   2638  f7e8		       4a		      lsr
   2639  f7e9		       4a		      lsr
   2640  f7ea		       4a		      lsr
   2641  f7eb		       4a		      lsr		; A = m1_col+1 (0 = no side-1 strip)
   2642  f7ec		       f0 18		      beq	.M1Cnone
   2643  f7ee		       0a		      asl
   2644  f7ef		       0a		      asl
   2645  f7f0		       0a		      asl		; 8*(col+1)
   2646  f7f1		       38		      sec
   2647  f7f2		       e9 01		      sbc	#1	; 8*col+7 = the LEFT-half M1 column
   2648  f7f4		       48		      pha
   2649  f7f5		       a5 99		      lda	RoomPF0Lo
   2650  f7f7		       29 01		      and	#$01	; MetaA b0 = strip on the RIGHT half
   2651  f7f9		       f0 05		      beq	.M1Cleft
   2652  f7fb		       68		      pla
   2653  f7fc		       18		      clc
   2654  f7fd		       69 50		      adc	#80	; right half: 87 + 8*col
   2655  f7ff		       60		      rts		; Z clear
   2656  f800				   .M1Cleft
   2657  f800		       68		      pla
   2658  f801		       60		      rts		; A = 7 + 8*col, Z clear
   2659  f802				   .M1Cgone
   2660  f802		       a9 00		      lda	#0
   2661  f804		       85 b0		      sta	M1X	; strip destroyed: keep the byte honest too
   2662  f806				   .M1Cnone
   2663  f806		       60		      rts		; A = 0, Z set -> caller skips the sprite
   2664  f807
