   1664  f446		       e9 01		      sbc	#1	; step left
   1665  f448		       4c 4e f4 	      jmp	.TentProbe
   1666  f44b				   .TentRight
   1667  f44b		       18		      clc
   1668  f44c		       69 01		      adc	#1	; step right
   1669  f44e				   .TentProbe
