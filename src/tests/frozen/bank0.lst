   1721  f516				   ExitRoomRight
   1722  f516		       20 14 fc 	      jsr	CallPad_GetConnIdx
   1723  f519		       c8		      iny		; +1 = left/right byte
   1724  f51a		       20 f6 fe 	      jsr	FoldIndirect
   1725  f51d		       4a		      lsr		; right = high nibble -> low
   1726  f51e		       4a		      lsr
   1727  f51f		       4a		      lsr
   1728  f520		       4a		      lsr
   1729  f521		       29 0f		      and	#$0f
   1730  f523		       c9 0f		      cmp	#$0f
   1731  f525		       f0 07		      beq	.NoRight
   1732  f527		       20 d0 fb 	      jsr	EnterRoom
   1733  f52a		       a9 04		      lda	#PLAYER_MIN_X
