   3633  fedb							; BeamMask — per-scanline ENAM0 values for the in-window kernel path (S2.2).
   3634  fedb							; Indexed by Y = A0 = Scanline - RoomY, rows 0-11 only.
   3635  fedb							; Rows 2-3 = $02 (beam on: RoomY+2..RoomY+3 = eye rows — yellow face row 2 +
   3636  fedb							; red row 3 = two-tone beam; kept per user decision: single-red rows could
   3637  fedb							; not also reach floor-standing enemies without kill-window churn); rest $00.
   3638  fedb							; 2026-10-08 user directive: ONE strip, yellow — row 2 only ($02 at index 2),
   3639  fedb							; row 3 dropped. Kill window in LaserHitTestBody stays rows RoomY+2..3 = a
   3640  fedb							; superset of the 1-line draw (floor-standing reach preserved).
   3641  fedb							; Lives in the $FExx page: `lda BeamMask,Y` from .Line ($F1xx) fetches in
   3642  fedb							; 4c when operand+11 stays in-page (1c reclaim toward the ObjColorTab
   3643  fedb							; write; verify_build asserts the no-cross operand range).
   3644  fedb							; ------------------------------------------------------------------------------
   3645  fedb				   BeamMask
   3646  fedb		       00 00 02 00*	      .byte.b	0,0,2,0,0,0,0,0,0,0,0,0
   3647  fee7
