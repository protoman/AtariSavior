    333 U00bc							; ==============================================================================
    334 U00bc							; Constants
    335 U00bc							; ==============================================================================
    336 U00bc		       00 16	   PLAYER_HEIGHT =	22	; player-vs-object HIT BOX rows. User ruling
    337 U00bc							;   2026-10-22: the box FOLLOWS the player art
    338 U00bc							;   (22 rows), so the tall sprite is solid over
    339 U00bc							;   its whole height. GRP1 objects keep their
    340 U00bc							;   own per-type draw window (ObjHeightTab) —
    341 U00bc							;   their boxes stay PLAYER_HEIGHT-based.
    342 U00bc		       00 10	   OBJ_WINDOW =	16	; GRP1 drawing window rows: the .Line test
    343 U00bc							;   `Y - ObjTop < OBJ_WINDOW`. Every design's
    344 U00bc							;   art + colour rows are sized to this
    345 U00bc							;   (ObjSprites/ObjColorTab, 9 x 16 = 144 B
    346 U00bc							;   each). Growing a design's ART past its old
    347 U00bc							;   12 rows is a per-type art change; the
    348 U00bc							;   window has the room reserved already.
    349 U00bc		       00 16	   PLAYER_SPRITE_H =	22	; player art height (8x22, user design 2026-10-22)
    350 U00bc		       00 07	   PLAYER_WIDTH =	7	; lit player sprite spans 7 pixels; REFP0 shift handled
    351 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    352 U00bc		       00 04	   LAMP_WIDTH =	4	; OBJ_LAMP uses GRP1's leftmost 4 lit pixels
    353 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    354 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    355 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    356 U00bc							; placed X, so the snake retreats a tile behind
    357 U00bc							; its placement and then comes out a tile — 2
    358 U00bc							; tiles of travel total. The editor cannot ask
    359 U00bc							; the user to place it 2 tiles from the border.
    360 U00bc		       00 14	   TILE_COLUMNS =	20	; columns per half (reflected playfield)
    361 U00bc		       00 03	   TILE_ROWS  =	3	; number of playable color bands
    362 U00bc		       00 30	   LINES_PER_TILE =	48	; scanlines per tile row
    363 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    364 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE
    365 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × LINES_PER_TILE)
