   1751  f535							; ==============================================================================
   1752  f535							; Level management
   1753  f535							; ==============================================================================
   1754  f535							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1755  f535							; LevelDataTable stride: 7 bytes (C4 2026-10-20: the Connections / RoomEnemies
   1756  f535							; word pointers were redundant — both are fixed offsets inside the level block,
   1757  f535							; see the layout comment in generated/levels_index.asm. start_x/y dropped
   1758  f535							; 2026-10-19 (constants 32/24); start_room and miner_y dropped 2026-10-20
   1759  f535							; (constants 0 / 84) — the converter rejects any other value)
   1760  f535							;   +0: miner_room (b7 = faces right)
   1761  f535							;   +1: miner_x
   1762  f535							;   +2..+3: wall colors
   1763  f535							;   +4..+5: level block base (RoomDataTable)
   1764  f535							;   +6: room count n — readers derive Connections (+2n), RoomEnemies (+4n)
   1765  f535							;	 and the enemy records (+5n — 1 B/room since 2026-10-20) from it (C2/C3)
   1766  f535							; ------------------------------------------------------------------------------
   1767  f535				   LoadLevel
   1768  f535							; Stage leave/reload/advance: walls return + bombs refill to 5
   1769  f535		       a9 00		      lda	#0
