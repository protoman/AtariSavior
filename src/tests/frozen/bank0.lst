   3225  fda8							; ------------------------------------------------------------------------------
   3226  fda8							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3227  fda8							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3228  fda8							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3229  fda8							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3230  fda8							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3231  fda8							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3232  fda8							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3233  fda8							;   tools/test_cell_map.py).
   3234  fda8							;   (The standalone CellSolid leaf that lived here moved INTO
   3235  fda8							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3236  fda8							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3237  fda8							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3238  fda8							; ------------------------------------------------------------------------------
   3239  fda8		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3240  fdbc		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3241  fdc8		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3242  fdd0
   3243  fdd0							; ------------------------------------------------------------------------------
   3244  fdd0							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3245  fdd0							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3246  fdd0							; is fetched from bank2's byte-identical mirror at this same address and
   3247  fdd0							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3248  fdd0							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3249  fdd0							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3250  fdd0							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3251  fdd0							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3252  fdd0							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3253  fdd0							; .HOVdone). The PickPlayerFrame `.ds $FDE1` below absorbs the size.
   3254  fdd0							; ------------------------------------------------------------------------------
   3255  fdd0		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3256  fdd8				   BombEnemyBlast
   3257  fdd8		       8d f8 1f 	      sta	$1FF8
   3258  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3259  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3260  fdde							;   span)
   3261  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3262  fdde							;   latch + feature gate pushed +14; same day
   3263  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3264  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3265  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3266  fdde							;   garbage path's `inc $4A,X` set wall bits
   3267  fdde							;   via $CA)
