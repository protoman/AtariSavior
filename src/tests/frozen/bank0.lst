   3857  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3858  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3859  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3860  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3861  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3862  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3863  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3864  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3865  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3866  fe9c							; ------------------------------------------------------------------------------
   3867  fe9c				   TallyWork
   3868  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3869  fe9f		       a8		      tay
   3870  fea0		       29 01		      and	#1
   3871  fea2		       f0 05		      beq	.TNoScore
   3872  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3873  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3874  fea9				   .TNoScore
   3875  fea9		       98		      tya
   3876  feaa		       29 04		      and	#4
   3877  feac		       f0 1e		      beq	.TLive
   3878  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3879  feb0		       a5 a3		      lda	Level
   3880  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3881  feb4		       d0 04		      bne	.TNotWrap
   3882  feb6		       a9 00		      lda	#0	; wrap past last level
   3883  feb8		       85 a3		      sta	Level
   3884  feba				   .TNotWrap
   3885  feba		       a9 00		      lda	#0
   3886  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3887  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3888  febe							;   pose ($FE must take the real-fall path)
   3889  febe		       20 20 fc 	      jsr	LoadLevel
   3890  fec1		       a9 78		      lda	#120	; reset timer for new level
   3891  fec3		       85 ae		      sta	BarLevel
   3892  fec5		       a9 3c		      lda	#60
   3893  fec7		       85 ad		      sta	TickCounter
   3894  fec9		       4c 30 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3895  fecc				   .TLive
