   4193  fff2							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   4194  fff2							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   4195  fff2							; ==============================================================================
   4196  fff2							; ==============================================================================
   4197  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   4198  fffa
   4199  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   4200  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   4201  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
