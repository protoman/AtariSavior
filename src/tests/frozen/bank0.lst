    705  f0d2							; ==============================================================================
    706  f0d2							; Kernel: 192 visible scanlines
    707  f0d2							; ==============================================================================
    708  f0d2							; Structure:
    709  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    710  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    711  f0d2							;
    712  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    713  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
