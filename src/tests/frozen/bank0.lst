   1164  f228		       a5 96		      lda	JetPower
   1165  f22a		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1166  f22c		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1167  f22e		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1168  f230		       05 93		      ora	vyLo
   1169  f232		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1170  f234							;   climb to stop, do NOT float
