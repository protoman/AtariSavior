    363 U00bc							; Jetpack physics constants (HERO-style)
    364 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    365 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    366 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    367 U00bc							; capped by the -$0100 rise clamp. From rest the
    368 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    369 U00bc							; take-off still eases in (~0.15 s); from a
    370 U00bc							; terminal 1.5 px/frame fall a held jet applies
    371 U00bc							; JET_MAX immediately and stops it in ~10 frames
    372 U00bc							; (HERO feel, user report 2026-10-22 — the old
    373 U00bc							; ÷4 gate needed ~80 frames to beat gravity).
    374 U00bc		       01 80	   MAX_FALL   =	$0180	; max fall speed (positive = down). Was $0200
    375 U00bc							; (2.0 px/frame) — the terminal fall felt too
    376 U00bc							; fast (user report 2026-10-21): 1.5 px/frame.
    377 U00bc
    378 U00bc		       00 0f	   JET_AUD_BASE =	$0F	; engine AUDF base: freq = base - JetPower/8 - sputter
    379 U00bc		       00 08	   JET_AUD_VOL =	$08	; engine volume while Up is held
    380 U00bc		       00 02	   LASER_AUD_C =	2	; laser ch0 control: div-15 tone = low pitch
    381 U00bc		       00 09	   LASER_AUD_V =	9	; laser ch0 volume while fire held
