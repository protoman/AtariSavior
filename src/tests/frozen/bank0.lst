   2107  f604							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2108  f604							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2109  f604							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2110  f604							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2111  f604							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2112  f604							; this region is upstream of the pin, so it costs nothing at $FC67.
   2113  f604							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2114  f604							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2115  f604							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2116  f604							; and normal deaths, resets on game-over reload.
   2117  f604							; ------------------------------------------------------------------------------
   2118  f604				   CEH_Key
   2119  f604		       a5 ba		      lda	EnemyDeadMask
   2120  f606		       1d cd f3 	      ora	EnemyBitTable,X
   2121  f609		       85 ba		      sta	EnemyDeadMask
   2122  f60b		       a5 a7		      lda	LevelStartRoom
   2123  f60d		       09 80		      ora	#$80	; KeyHeld = b7
   2124  f60f		       85 a7		      sta	LevelStartRoom
   2125  f611		       60		      rts
