   1809  f495							; ------------------------------------------------------------------------------
   1810  f495							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1811  f495							; there is no free ZP byte for per-slot movement state (phase/direction live
   1812  f495							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1813  f495							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1814  f495							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1815  f495							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1816  f495							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1817  f495							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1818  f495							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1819  f495							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1820  f495							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1821  f495							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1822  f495							;	    the 60-frame game timer — gates from it wrap every second).
   1823  f495							; Other types: straight ROM y (their movement stages come later).
   1824  f495							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1825  f495							; ------------------------------------------------------------------------------
   1826  f495				   DeriveEnemyY
   1827  f495							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1828  f495							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1829  f495		       a5 b1		      lda	EnemyDataLo
   1830  f497		       85 e5		      sta	FetchPtr
   1831  f499		       a5 b2		      lda	EnemyDataHi
   1832  f49b		       85 e6		      sta	FetchPtr+1
   1833  f49d		       bc 77 f9 	      ldy	EnemyOffTable,X
   1834  f4a0		       20 f6 fe 	      jsr	FoldIndirect	; type
   1835  f4a3		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1836  f4a5							;   missed and a dir-left enemy fell through to
   1837  f4a5							;   .DEYStatic (no bob)
   1838  f4a5		       c9 01		      cmp	#ENEMY_BAT
   1839  f4a7		       f0 18		      beq	.DEYTickNoShift
   1840  f4a9		       c9 03		      cmp	#ENEMY_TENTACLE
   1841  f4ab		       f0 1a		      beq	.DEYTickShift
   1842  f4ad		       c9 00		      cmp	#ENEMY_SPIDER
   1843  f4af		       f0 2e		      beq	.DEYSpiderTick
   1844  f4b1		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1845  f4b3		       d0 06		      bne	.DEYStatic
   1846  f4b5		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1847  f4b8		       4c d4 f4 	      jmp	DEYDelta
   1848  f4bb				   .DEYStatic
   1849  f4bb		       c8		      iny
   1850  f4bc		       c8		      iny
   1851  f4bd		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1852  f4c0		       60		      rts
   1853  f4c1				   .DEYTickNoShift
   1854  f4c1		       a5 d7		      lda	EnemyClk
   1855  f4c3		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1856  f4c4		       4c cc f4 	      jmp	.DEYBobTick
