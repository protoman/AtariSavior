   1375  f359		       b0 1d		      bcs	.SDBottom
   1376  f35b		       e6 81		      inc	RoomY
   1377  f35d		       20 26 f9 	      jsr	PlayerHitsMap
   1378  f360		       90 0f		      bcc	.SDAir
