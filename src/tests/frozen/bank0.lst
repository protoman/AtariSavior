   2925  f945							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2926  f945							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2927  f945							; mirror; bank2 display-space walkers add their own when they convert).
   2928  f945							; RectCount = running row, CollisionX = running col (both were walk temps
   2929  f945							; before — same ZP, no new allocation).
   2930  f945							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2931  f945							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
