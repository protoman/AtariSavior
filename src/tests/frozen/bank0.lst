   2621  f9b2		       00 04 08 	      .byte.b	0,4,8	; enemy index * 4 (stride S4.1; offset into
   2622  f9b5							; enemy data type,x,y,dir)
   2623  f9b5
   2624  f9b5							; BitMaskTable moved to bank1 with IsRoomDark/SetRoomDark (leaf_move_plan).
   2625  f9b5
   2626  f9b5							; ------------------------------------------------------------------------------
   2627  f9b5							; RefreshEnemyY moved post-pad (after TitleWork) — 2026-10-02, so its SELECT
   2628  f9b5							; → title check costs 0 pre-pad bytes (headroom 1B). Pins .ds $FBF8/$FC49
   2629  f9b5							; keep every downstream pre-pad address unchanged.
   2630  f9b5							; ------------------------------------------------------------------------------
   2631  f9b5
   2632  f9b5							; ==============================================================================
   2633  f9b5							; E4 moth exit tramp ($FC49-$FC4E) — bank2 executes `sta $1FF6` at $FC49
   2634  f9b5							; (byte-identical slice, guard: verify_build), then the fetch at $FC4C comes
   2635  f9b5							; from bank0 = `jmp UE_Next` (real label here — no cross-bank address sync).
   2636  f9b5							; bank0's `sta $1FF6` copy never runs; bank2's bytes from $FC4C never run.
   2637  f9b5							;
   2638  f9b5							; MUST stay off $FFF6-$FFF9: those are the ONLY addresses in code space where
   2639  f9b5							; (addr & $1FFF) lands in $1FF6-$1FF9 = F6 hotspot mirrors. Stella's
   2640  f9b5							; CartridgeEnhanced::peek (CartEnh.cxx:157, ADDR_MASK=$1FFF) calls
   2641  f9b5							; checkSwitchBank on READS — the old $FFF2 placement fetched the `jmp`
   2642  f9b5							; operands at $FFF6/$FFF7 and flipped banks mid-instruction (operand hi from
   2643  f9b5							; bank1 = $00 -> jmp $007D -> HUD runaway, 359/360-line frames, 5-byte stack
   2644  f9b5							; leak per rogue Overscan entry -> SP decayed to $E1 -> frame-3 crash where
   2645  f9b5							; jsr RefreshEnemyY's return landed on FetchPtr). Real F6 is write-only, but
   2646  f9b5							; no fetched byte may ever sit in the mirror zone.
   2647  f9b5							; ==============================================================================
   2648  f9b5							; ==============================================================================
   2649  f9b5							; Cross-bank call pads (docs/leaf_move_plan.md) — byte-identical copies live in
   2650  f9b5							; bank1 at the SAME addresses. F6 hotspots switch on ANY write — the written
   2651  f9b5							; value is ignored (proven by FoldIndirect's `sta $1FF6` carrying data bytes) —
   2652  f9b5							; so the pads `sta $1FF7`/`sta $1FF6` with A AS-IS: A/X/Y/flags pass through
   2653  f9b5							; unchanged, making the pad equivalent to the original inlined `jsr`.
   2654  f9b5							; (2026-09-30 bug: `lda #1` before `sta $1FF7` clobbered A — ClearPFColumn
   2655  f9b5							; punched col 1 instead of the bomb's col, AddScore added +1 instead of
   2656  f9b5							; +50/+75. Hole appeared at screen col 1 + mirror col 18 = "second tile from
   2657  f9b5							; each edge"; collision stayed correct because WallMask is separate.)
   2658  f9b5							; `sta` does not touch flags — IsRoomDark's `beq` contract survives the
   2659  f9b5							; return. Carry survives. No stack use.
   2660  f9b5							; ==============================================================================
   2661  f9b5		       00 00 00 	      .ds	$F9B8 - *, 0	; Phase 4 overlay tramp — shared address with
   2662  f9b8							; bank2's twin image (40B bank2 hole before
   2663  f9b8							; org $F9D9); F6-safe ($F9B1 & $1FFF ∉ hotspots)
