   1043  f1a3				   .NormalGame
   1044  f1a3
   1045  f1a3							; --- Bomb: edge-detect Down (D1, 0=pressed) ---
   1046  f1a3		       a5 88		      lda	Temp
   1047  f1a5		       29 02		      and	#%00000010
   1048  f1a7		       f0 09		      beq	.BombHeld
   1049  f1a9		       a5 b5		      lda	BombPacked	; released: clear DownPrev (b2), keep state/mask
   1050  f1ab		       29 fb		      and	#%11111011
   1051  f1ad		       85 b5		      sta	BombPacked
   1052  f1af		       4c f1 f1 	      jmp	.BombInDone
   1053  f1b2				   .BombHeld
   1054  f1b2		       a5 b5		      lda	BombPacked
   1055  f1b4		       29 04		      and	#%00000100
   1056  f1b6		       d0 39		      bne	.BombInDone	; held since last frame — no edge
   1057  f1b8		       a5 b5		      lda	BombPacked
   1058  f1ba		       29 03		      and	#%00000011
   1059  f1bc		       d0 2d		      bne	.BombMarkDown	; bomb already active: just set DownPrev
   1060  f1be		       a5 f0		      lda	PlayerBombs
   1061  f1c0		       29 07		      and	#%00000111	; b2-0 = bombs; b7-3 are the raft's ramp state
   1062  f1c2		       f0 27		      beq	.BombMarkDown	; no bombs left: swallow edge, keep DownPrev
   1063  f1c4		       a5 b5		      lda	BombPacked
   1064  f1c6		       29 80		      and	#%10000000	; b7 OnGround — drop only when standing
   1065  f1c8		       f0 21		      beq	.BombMarkDown	; flying/falling: swallow edge, keep DownPrev
   1066  f1ca		       c6 f0		      dec	PlayerBombs
