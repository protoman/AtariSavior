   3794  fd24		       a9 04		      lda	#4
   3795  fd26		       20 08 fc 	      jsr	CallPad_SaveKey	; stage number <-> high score in the HUD score window
   3796  fd29							;   (here DropTarget is still $FF: a RESET below
   3797  fd29							;   zeroes the score; the op does no I2C)
   3798  fd29							; --- SELECT/UP/DOWN edge + RESET/FIRE edge (TitleSelect, bank1) ---
   3799  fd29							;     It samples console + joystick, stores the sample in StepsLeft for
   3800  fd29							;     next frame's edges, and returns A != 0 for a RESET/FIRE start edge,
   3801  fd29							;     else A = 0 with C = level changed (Z/C survive the pad).
   3802  fd29		       20 4f fc 	      jsr	CallPad_TitleSelect
