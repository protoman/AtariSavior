   4634  ff38				   .LaserFire
   4635  ff38		       a5 c0		      lda	LaserState
   4636  ff3a		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4637  ff3c		       85 c0		      sta	LaserState
   4638  ff3e		       8a		      txa
   4639  ff3f		       29 80		      and	#LASER_HELD
   4640  ff41		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4641  ff43							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4642  ff43							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4643  ff43							; step would jump out of the 8px wall with no candidate ever inside it
   4644  ff43							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4645  ff43							; here (b7 held from the ora above). Open-hold cadence alternates
   4646  ff43							; travel-consume / eye-retest = 1 LWC per frame, same as before.
