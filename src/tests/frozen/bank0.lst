   1206  f256		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1207  f258				   .FRActive
   1208  f258		       a5 94		      lda	vyHi
   1209  f25a		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1210  f25c		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1211  f25e		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
