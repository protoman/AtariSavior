   2176  f5f6							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2177  f5f6							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2178  f5f6							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2179  f5f6							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2180  f5f6							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2181  f5f6							; this region is upstream of the pin, so it costs nothing at $FC67.
   2182  f5f6							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2183  f5f6							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2184  f5f6							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2185  f5f6							; and normal deaths, resets on game-over reload.
   2186  f5f6							; ------------------------------------------------------------------------------
   2187  f5f6				   CEH_Key
   2188  f5f6		       a5 ba		      lda	EnemyDeadMask
   2189  f5f8		       1d c5 f3 	      ora	EnemyBitTable,X
   2190  f5fb		       85 ba		      sta	EnemyDeadMask
   2191  f5fd		       a5 a7		      lda	LevelStartRoom
   2192  f5ff		       09 80		      ora	#$80	; KeyHeld = b7
   2193  f601		       85 a7		      sta	LevelStartRoom
   2194  f603		       a9 09		      lda	#9	; pickup blip (pitch 9)
   2195  f605		       4c 3c fc 	      jmp	PickupSnd
