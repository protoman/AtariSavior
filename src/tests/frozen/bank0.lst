   1993  f5a8		       d0 2a		      bne	.BTDone
   1994  f5aa		       a5 b5		      lda	BombPacked	; 1 → 2
   1995  f5ac		       29 fc		      and	#%11111100
   1996  f5ae		       09 02		      ora	#%00000010
   1997  f5b0		       85 b5		      sta	BombPacked
   1998  f5b2		       a9 3c		      lda	#60
   1999  f5b4		       85 f7		      sta	BombTimer
