   1862  f5b1							; Miner pickup — check if player overlaps miner, advance to next level
   1863  f5b1							; ==============================================================================
   1864  f5b1				   CheckMinerPickup
   1865  f5b1		       a5 a4		      lda	LevelMinerRoom
   1866  f5b3		       29 7f		      and	#$7f
   1867  f5b5		       c5 98		      cmp	RoomNo
   1868  f5b7		       d0 1b		      bne	.CMPDone	; not in miner's room
   1869  f5b9							; X overlap: player [RoomX, +6] vs 4px miner.
   1870  f5b9							; Accept iff RoomX - MinerX in [-6, +3].
   1871  f5b9		       a5 80		      lda	RoomX
   1872  f5bb		       38		      sec
   1873  f5bc		       e5 a5		      sbc	MinerX
   1874  f5be		       18		      clc
   1875  f5bf		       69 06		      adc	#PLAYER_WIDTH - 1
   1876  f5c1		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1877  f5c3		       b0 0f		      bcs	.CMPDone	; no X overlap
   1878  f5c5							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1879  f5c5							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1880  f5c5		       a5 81		      lda	RoomY
