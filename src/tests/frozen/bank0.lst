    957  f112							; --- Player sprite: color for THIS line, graphics byte for NEXT line ---
    958  f112							; GRP0 written on line S displays on line S+1 (latched at the sprite's
    959  f112							; window start after the write) — index graphics with A0+1 ($ff wraps
    960  f112							; to 0 = row0 on the line before the sprite).
    961  f112							; CORRECTED 2026-10-22 (Phase 4): that "line S+1" is only true for a
    962  f112							; sprite whose pixels come AFTER the store. Per Stella's Player::grp /
    963  f112							; updatePattern, a GRP write lands in myPatternNew and renders at once, so
    964  f112							; the boundary is the sprite's own pixel start (cycle ~(61+X)/3). With
    965  f112							; VDELP0=1 (set in the VBL, see the comment there) the live pattern is
    966  f112							; `myPatternOld`, latched by the GRP1 store at c58, so P0 is correct for
    967  f112							; every X < 113 px and its art row r sits on the SAME scanline as
    968  f112							; PlayerColTable[r] (COLUP0 lands at c19, before all pixels) — i.e. the
    969  f112							; art and its per-row colours finally agree. Do not reorder the colour
    970  f112							; path behind the graphics: COLUP0 must stay the first store in the body.
    971  f112							; Running-Y: Y = A0 = Scanline - RoomY is computed ONCE at kernel entry
    972  f112							; (sec/sbc RoomY/tay); .Line's iny advances it (Y = A0+1 after the
    973  f112							; graphics write = A0 of the next line). Nothing between rows may touch
    974  f112							; Y — the water-strip band-color read is an inlined `lda` (Y untouched).
    975  f112							; Cycle budget — MEASURED (sim_frame_budget, bugs.md #29 Class A):
    976  f112							; the old worst path (in-window color/beam/GRP0 + object in-range) was
    977  f112							; 78c: WSYNC write landed 2c into the next line -> full-line stall ->
    978  f112							; +1 scanline on every frame whose object window overlapped the A0=11
    979  f112							; line (24 stalls in the SIM_LEVEL=2 window, always even frames —
    980  f112							; SelectActiveObject parity rotation). Root fix: the color/beam gate
    981  f112							; below stops at A0=10; row 11 inherits row 10's COLUP0/ENAM0 writes
    982  f112							; (PlayerColTable [10]==[11], verify_build asserts) because
    983  f112							; GRP0 row11 is fetched on line A0=10 already ("row11 shows via
    984  f112							; line10"). Worst path measured 2026-10-15 (vcrunch jitter hunt):
    985  f112							; in-window color/beam/GRP0 + object in-range = 69c between WSs,
    986  f112							; start-to-start d=72 — was 73/76 (= stall zone 74-76, whole-screen
    987  f112							; +1-line jitter) until the dead `cpy #12 / bcs .GrpZero` (4c, never
    988  f112							; taken on the A0<=10 color path) moved to .GrpSkip. Budget: work
    989  f112							; <= 70c / d <= 73 — a 74-76 segment stalls a full scanline.
    990  f112							; ObjSprites+107 must stay in ONE page (else lda ObjSprites,X
    991  f112							; page-crosses, +1c on the GRP1 fetch) — verify_build enforces this.
    992  f112							; Branch targets all same-page (3c taken) and PlayerColTable in $F8xx
    993  f112							; (verify_build guards the A0=10 page-cross budget).
    994  f112							; GRP1 object section clobbers X (ObjSprites index) — row counter lives in
    995  f112							; RowIdx and X is reloaded after bne. Row-advance +6c on the .Row setup
    996  f112							; scanline (segment 63c -> 69c <= 76c): frame length unchanged.
    997  f112							; The old Scanline/sec/sbc/tay prefix cost 10c more (body 66c -> WSYNC
    998  f112							; write on cycle 76 = one cycle late): WSYNC stalled a full line per
    999  f112							; overlapping scanline — stretched cave row, HUD pushed down, and with
   1000  f112							; GRP1 flicker rotation the frame length alternated (one-tile oscillation).
   1001  f112							; Keep the hot path at <= 70c work: an overrun duplicates the scanline.
   1002  f112		       c0 15		      cpy	#PLAYER_SPRITE_H - 1
   1003  f114		       b0 3d		      bcs	.GrpSkip	; A0 >= 11 (incl $ff): no color/beam this line.
   1004  f116							; A0=11 skips too (Class-A stall line): rows
   1005  f116							; 10/11 share color+beam bytes, so row 10's
   1006  f116							; writes are still in effect here.
   1007  f116							; --- Laser S2.2: ENAM0 = PlayerColTable bit1 & LaserState.b1 ----------
   1008  f116							; Phase 0 (2026-10-21): the retired BeamMask table duplicated bit 1 of
   1009  f116							; PlayerColTable for a separate 4c fetch. One yellow strip on RoomY+2
   1010  f116							; only (user directive 2026-10-08: the red row-3 strip is gone; the kill
   1011  f116							; window in LaserHitTestBody keeps rows RoomY+2..3 = superset of the
   1012  f116							; draw). In-window path only (Y<=11), so outside the window ENAM0 keeps
   1013  f116							; its last write ($00 at A0=10) — no HUD artifact. verify_build asserts
   1014  f116							; bit1 is set at index 2 and nowhere else, and that rows 10/11 stay equal
   1015  f116							; (the A0=11 gate skip inherits row 10's writes).
   1016  f116		       b9 65 fe 	      lda	PlayerColTable,Y	; 4c — per-row color; bit 1 = ENAM0 enable
   1017  f119		       85 06		      sta	COLUP0	; applies to this line (colour bit0 = don't-care)
   1018  f11b		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
   1019  f11d		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
   1020  f11f		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
   1021  f120							;   Color/beam gate entered only with A0<=10
   1022  f120							;   -> after iny Y<=11: always fetchable, so
   1023  f120							;   the old `cpy #PLAYER_SPRITE_H / bcs
   1024  f120							;   .GrpZero` here was DEAD 4c on the worst
   1025  f120							;   path (2+2, never taken — A0=11+ never
   1026  f120							;   reaches it, it goes to bcs .GrpSkip).
   1027  f120		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
   1028  f122		       85 1b		      sta	GRP0
