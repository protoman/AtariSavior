   2271  f6c3							; This slot is the miner
   2272  f6c3		       a9 55		      lda	#OBJ_MINER	; miner design offset into ObjSprites
   2273  f6c5		       85 b6		      sta	ObjBase
   2274  f6c7		       a9 10		      lda	#OBJ_WINDOW	; miner design height
   2275  f6c9		       85 9d		      sta	ObjHeight
   2276  f6cb		       a5 a5		      lda	MinerX
   2277  f6cd		       85 b7		      sta	ActiveObjectX
   2278  f6cf		       a5 a6		      lda	MinerY
   2279  f6d1		       18		      clc
