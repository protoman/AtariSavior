   3995  fd36							; ------------------------------------------------------------------------------
   3996  fd36							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3997  fd36							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3998  fd36							; selected level number (digits band) and the credits; the theme plays here.
   3999  fd36							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   4000  fd36							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   4001  fd36							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   4002  fd36							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   4003  fd36							;	    the intro exit ate the first press and made #2 read as dead)
   4004  fd36							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   4005  fd36							;	    the real drop-in → gameplay starts
   4006  fd36							; ($FD reaches here directly — merged title, 2026-10-19.)
   4007  fd36							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   4008  fd36							; title-owned; the first play frame rewrites it as the step budget).
   4009  fd36							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   4010  fd36							; ------------------------------------------------------------------------------
   4011  fd36				   TitleWork
   4012  fd36							; --- SELECT edge (TitleSelect, fill region) ---
   4013  fd36		       20 4f fc 	      jsr	CallPad_TitleSelect
   4014  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   4015  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   4016  fd3e				   .TWselDone
   4017  fd3e							; --- RESET edge ---
   4018  fd3e		       a5 97		      lda	StepsLeft
   4019  fd40		       29 01		      and	#%00000001
   4020  fd42		       f0 14		      beq	.TWrstDone
   4021  fd44		       ad 82 02 	      lda	SWCHB
   4022  fd47		       29 01		      and	#%00000001
   4023  fd49		       d0 0d		      bne	.TWrstDone
   4024  fd4b		       a9 00		      lda	#0
   4025  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   4026  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   4027  fd51		       85 f4		      sta	ScoreHu
   4028  fd53		       85 f5		      sta	ScoreTe
   4029  fd55		       20 20 fc 	      jsr	LoadLevel
   4030  fd58				   .TWrstDone
   4031  fd58		       ad 82 02 	      lda	SWCHB
   4032  fd5b		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   4033  fd5d							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   4034  fd5d							;     channel force-muted here — UpdateJetSound is skipped because
   4035  fd5d							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   4036  fd5d							;     = 0, AUDV0 covered above). ---
   4037  fd5d				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   4038  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   4039  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   4040  fd61		       f0 0e		      beq	.TWmusic
   4041  fd63		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   4042  fd65		       20 8d f5 	      jsr	BombTick
   4043  fd68				   .TWnoTick
