   1772  f529		       4a		      lsr
   1773  f52a		       4a		      lsr
   1774  f52b		       4a		      lsr
   1775  f52c		       29 0f		      and	#$0f
   1776  f52e		       c9 0f		      cmp	#$0f
   1777  f530		       f0 07		      beq	.NoUp
   1778  f532		       20 d0 fb 	      jsr	EnterRoom
   1779  f535		       a9 84		      lda	#PLAYER_MAX_Y
   1780  f537		       85 81		      sta	RoomY	; enter at the bottom edge
   1781  f539				   .NoUp
