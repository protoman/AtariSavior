   2366  f816		       d0 06		      bne	.UEDNotRaft
   2367  f818		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2368  f81b		       4c 20 f4 	      jmp	UE_Next
   2369  f81e				   .UEDNotRaft
   2370  f81e		       c9 03		      cmp	#ENEMY_TENTACLE
   2371  f820		       d0 03		      bne	.UEDNotTent
