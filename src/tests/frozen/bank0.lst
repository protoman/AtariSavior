   4208  ff68				   .LAdvS
   4209  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   4210  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4211  ff6c		       90 03		      bcc	.LAdvCap
   4212  ff6e		       4c 9a ff 	      jmp	.LaserInit
   4213  ff71				   .LAdvCap
   4214  ff71		       a5 82		      lda	PlayerDir
   4215  ff73		       d0 0c		      bne	.LAdvCapL
   4216  ff75		       a5 80		      lda	RoomX
   4217  ff77		       18		      clc
