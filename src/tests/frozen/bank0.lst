   3610  fd78							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3611  fd78							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3612  fd78							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3613  fd78							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3614  fd78							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3615  fd78							; DeriveEnemyY — no persistent movement state exists in RAM.
   3616  fd78							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3617  fd78							; block after the pads; pre-pad headroom is 1B).
   3618  fd78							; ------------------------------------------------------------------------------
   3619  fd78				   RefreshEnemyY
   3620  fd78
   3621  fd78		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3622  fd7a							; TickCounter is the 60-frame GAME timer
   3623  fd7a							; (decrements 60->1, reloads) — gates derived
   3624  fd7a							; from it wrapped every second (spider
   3625  fd7a							; "teleported": (TC>>3)&63 only ever saw
   3626  fd7a							; 0..7 and counted DOWN 0->7 = jump).
   3627  fd7a		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3628  fd7c		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3629  fd7e				   .REYLoop		; every reader runs after refresh completes)
   3630  fd7e		       ca		      dex
   3631  fd7f		       20 8b f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3632  fd82		       95 e2		      sta	EnemyRamY,X
   3633  fd84		       8a		      txa		; N/Z must come from X: flags after jsr are
   3634  fd85		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3635  fd87				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3636  fd87							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3637  fd87							; black rooms, broken PF, invisible sprites)
   3638  fd87							; --- SELECT or RESET held → back to the old title / level-select screen
   3639  fd87							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3640  fd87							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3641  fd87							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3642  fd87							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3643  fd87							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3644  fd87							;     RESET held past LANDING still re-fires — press must be released
   3645  fd87							;     before the drop-in finishes. ---
   3646  fd87		       a5 8a		      lda	DropTarget
   3647  fd89		       d0 17		      bne	.REYRts	; not idle: not ours
   3648  fd8b		       ad 82 02 	      lda	SWCHB
   3649  fd8e		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3650  fd90		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3651  fd92		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3652  fd94		       f0 0c		      beq	.REYRts	; neither pressed
   3653  fd96		       a9 ff		      lda	#$FF
   3654  fd98		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3655  fd9a		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3656  fd9d		       68		      pla		; drop OUR return address (LoadLevel already
   3657  fd9e		       68		      pla		;   popped its own) — tail into TitleWork
   3658  fd9f		       4c 32 fd 	      jmp	TitleWork
