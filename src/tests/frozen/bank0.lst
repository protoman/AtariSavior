   2238  f7a0		       d0 39		      bne	.BTDone
   2239  f7a2		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2240  f7a4		       29 fc		      and	#%11111100
   2241  f7a6		       85 b5		      sta	BombPacked
   2242  f7a8		       a9 00		      lda	#0
