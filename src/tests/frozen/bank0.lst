   1768  f53f		       20 f6 fe 	      jsr	FoldIndirect
   1769  f542		       4a		      lsr		; up = high nibble -> low
   1770  f543		       4a		      lsr
   1771  f544		       4a		      lsr
   1772  f545		       4a		      lsr
   1773  f546		       29 0f		      and	#$0f
   1774  f548		       c9 0f		      cmp	#$0f
   1775  f54a		       f0 07		      beq	.NoUp
   1776  f54c		       20 d0 fb 	      jsr	EnterRoom
   1777  f54f		       a9 84		      lda	#PLAYER_MAX_Y
   1778  f551		       85 81		      sta	RoomY	; enter at the bottom edge
   1779  f553				   .NoUp
