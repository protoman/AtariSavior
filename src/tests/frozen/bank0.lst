   3756  ff20				   SetObjReflection
   3757  ff20		       a9 00		      lda	#0
   3758  ff22		       85 0c		      sta	REFP1
   3759  ff24		       a5 b6		      lda	ObjBase
   3760  ff26		       c9 38		      cmp	#OBJ_MINER
   3761  ff28		       d0 08		      bne	.SORdone
   3762  ff2a		       a5 a4		      lda	LevelMinerRoom
   3763  ff2c		       10 04		      bpl	.SORdone
   3764  ff2e		       a9 08		      lda	#$08
   3765  ff30		       85 0c		      sta	REFP1
   3766  ff32				   .SORdone
   3767  ff32		       60		      rts
