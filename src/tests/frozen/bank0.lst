   1369  f36a		       60		      rts
   1370  f36b				   .SDAir
   1371  f36b		       a5 b5		      lda	BombPacked
   1372  f36d		       29 7f		      and	#%01111111	; still falling — not ground
   1373  f36f		       85 b5		      sta	BombPacked
   1374  f371		       60		      rts
   1375  f372				   .SDBottom
   1376  f372		       20 d5 f4 	      jsr	ExitRoomDown
   1377  f375		       a5 81		      lda	RoomY
   1378  f377		       c9 84		      cmp	#PLAYER_MAX_Y
   1379  f379		       d0 0c		      bne	.SDDone	; changed room (EnterRoom cleared b7)
   1380  f37b		       a5 b5		      lda	BombPacked
   1381  f37d		       09 80		      ora	#%10000000	; no down exit — standing on floor
   1382  f37f		       85 b5		      sta	BombPacked
   1383  f381		       a9 00		      lda	#0
