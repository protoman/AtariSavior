   1127  f201							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1128  f201							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1129  f201							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1130  f201							;	   catches the fall in ~10 frames from terminal $0180.
   1131  f201							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1132  f201							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1133  f201							;	   gone: it kept thrust below gravity for ~32 frames.
   1134  f201							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1135  f201							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1136  f201							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1137  f201							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1138  f201							;	   1.0s hover was too long — halved); then the flag clears and
   1139  f201							;	   normal gravity resumes (fall ~0.85s after release). State
   1140  f201							;	   lives in JetPower, NOT
   1141  f201							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1142  f201							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1143  f201							;	   rising frame — both clobbered a StepsLeft-based float.
   1144  f201							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1145  f201							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1146  f201							;	   (headroom stays $FC67).
   1147  f201							; ------------------------------------------------------------------------------
   1148  f201		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1149  f203		       24 88		      bit	Temp
   1150  f205		       d0 25		      bne	.JetDecay
   1151  f207		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1152  f209		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1153  f20b		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1154  f20d		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1155  f20f				   .JetRamp
   1156  f20f							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1157  f20f							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1158  f20f							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1159  f20f							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1160  f20f							; ~80 frames = more than a room height of extra falling). The ramp only
   1161  f20f							; applies from rest / while already rising, so take-off still eases in.
   1162  f20f		       a5 94		      lda	vyHi
   1163  f211		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1164  f213		       05 93		      ora	vyLo
   1165  f215		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1166  f217		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1167  f219		       85 96		      sta	JetPower
   1168  f21b		       4c 58 f2 	      jmp	.Gravity
   1169  f21e				   .JetClimb
   1170  f21e		       a5 96		      lda	JetPower
   1171  f220		       c9 30		      cmp	#JET_MAX
   1172  f222		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1173  f224		       18		      clc
   1174  f225		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1175  f227		       85 96		      sta	JetPower
   1176  f229		       4c 58 f2 	      jmp	.Gravity
   1177  f22c				   .JetDecay		; Up NOT held this frame
   1178  f22c		       a5 96		      lda	JetPower
   1179  f22e		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1180  f230		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1181  f232		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1182  f234		       05 93		      ora	vyLo
   1183  f236		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1184  f238							;   climb to stop, do NOT float
   1185  f238		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1186  f23a		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1187  f23c		       4c 58 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1188  f23f				   .FloatRun
   1189  f23f		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1190  f241		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1191  f243		       29 7f		      and	#$7F
   1192  f245		       d0 04		      bne	.FRActive
   1193  f247		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1194  f249		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1195  f24b				   .FRActive
   1196  f24b		       a5 94		      lda	vyHi
   1197  f24d		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1198  f24f		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1199  f251		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1200  f253		       85 94		      sta	vyHi
   1201  f255		       4c 9d f2 	      jmp	.Integrate
   1202  f258
   1203  f258							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1204  f258							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1205  f258							;     only — subtracting $80+ would blast the player upward.
   1206  f258				   .Gravity
   1207  f258		       18		      clc
   1208  f259		       a5 93		      lda	vyLo
   1209  f25b		       69 08		      adc	#<GRAVITY
   1210  f25d		       85 93		      sta	vyLo
   1211  f25f		       a5 94		      lda	vyHi
   1212  f261		       69 00		      adc	#>GRAVITY
   1213  f263		       85 94		      sta	vyHi
   1214  f265		       a5 96		      lda	JetPower
   1215  f267		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1216  f269		       38		      sec
   1217  f26a		       a5 93		      lda	vyLo
