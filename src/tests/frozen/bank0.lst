    325 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    326 U00bc		       00 04	   LAMP_WIDTH =	4	; OBJ_LAMP uses GRP1's leftmost 4 lit pixels
    327 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    328 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    329 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    330 U00bc							; placed X, so the snake retreats a tile behind
    331 U00bc							; its placement and then comes out a tile — 2
    332 U00bc							; tiles of travel total. The editor cannot ask
    333 U00bc							; the user to place it 2 tiles from the border.
