   4285  feb8		       a9 78		      lda	#120	; reset timer for new level
   4286  feba		       85 ae		      sta	BarLevel
   4287  febc		       a9 3c		      lda	#TICKS_PER_SEC
   4288  febe		       85 ad		      sta	TickCounter
   4289  fec0		       4c 31 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4290  fec3				   .TLive
   4291  fec3		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   4292  fec6		       a9 00		      lda	#0
