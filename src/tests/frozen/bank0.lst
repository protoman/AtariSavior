   2691  f9c4		       a5 88		      lda	Temp
   2692  f9c6		       f0 08		      beq	.M1
   2693  f9c8		       18		      clc
   2694  f9c9		       69 01		      adc	#1	; #9: Stella draws ball/missile 1 clock left of
   2695  f9cb							;   the player contract — Ball.hxx/Missile.hxx
   2696  f9cb							;   renderCounterOffset=-4 vs Player.hxx=-5
   2697  f9cb							;   (same class as the M1 +1 below)
   2698  f9cb		       a2 04		      ldx	#4	; selector 4: HMP0+4=HMBL, RESP0+4=RESPBL
   2699  f9cd		       20 0f ff 	      jsr	SetObjectXPos
   2700  f9d0				   .M1
   2701  f9d0		       a5 8e		      lda	CollisionEndX
   2702  f9d2		       f0 0c		      beq	.Done
   2703  f9d4		       18		      clc
   2704  f9d5		       69 01		      adc	#1	; Stella renders 8-wide M1 one clock left of
   2705  f9d7							;   the [A-7,A] contract (pixel-measured 2026-10-06,
   2706  f9d7							;   screenshots/assymetric/bug_adjust_collision.png:
   2707  f9d7							;   staged 71 -> drawn [63,70], needs [64,71])
   2708  f9d7		       a2 03		      ldx	#3	; selector 3: HMP0+3=HMM1, RESP0+3=RESM1
   2709  f9d9		       20 0f ff 	      jsr	SetObjectXPos
   2710  f9dc		       a9 02		      lda	#$02	; missile enable D1 (same encoding the laser
   2711  f9de		       85 1e		      sta	ENAM1	;   beam uses for ENAM0)
   2712  f9e0				   .Done
