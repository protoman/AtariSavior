   3209  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3210  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3211  fce7		       85 83		      sta	LaserX
   3212  fce9		       18		      clc
