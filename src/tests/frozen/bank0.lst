    838  f0d7							; --- Set PF registers for this tile row (TIA persists) ---
    839  f0d7							; Store ORDER is cycle-critical (thin-yellow-line fix, 2026-10-01): the
    840  f0d7							; stores land mid-visible (advance block then these pairs), so on the
    841  f0d7							; row1→row2 band-transition line the left half must keep the OLD band's
    842  f0d7							; PF+color while the right half may show the NEW band. Write cycles
    843  f0d7							; (cN = CPU cycles on the setup line, x = pixel at 4x, HBLANK ends c22.7):
    844  f0d7							;   PF0 w c34 x136 | PF1 w c41 x222 | COLUPF w c48 x296 |
    845  f0d7							;   COLUP1 w c51 x332 (D6 M1 band color — AFTER the left half, so the
    846  f0d7							;     transition line keeps the OLD band's M1/P1 color on the left, same
    847  f0d7							;     rule as COLUPF) |
    848  f0d7							;   ENABL w c58 (BandTab gate, +1c vs the old COLUBK pair) |
    849  f0d7							;   PF2 w c65 x500 (moved +3c — still past right-half PF2 pixels x449)
    850  f0d7							; COLUPF 3rd: color flips at x296 = past ALL left ON-pixels (PF1 ends
    851  f0d7							; x187, PF2 cell17 ends x287); cells18-19 (x288-319) are never ON in any
    852  f0d7							; model row (PF2 bits6/7 always 0) so the flip there is invisible (BG =
    853  f0d7							; COLUBK). PF2 LAST: store lands past every right-half PF2 pixel (x449)
    854  f0d7							; → right PF2 keeps OLD band (= BG post-blast = no yellow; pre-blast
    855  f0d7							; cell17 = new pattern's wall = looks new). Old order (PF2 3rd = w c48,
    856  f0d7							; COLUPF last = w c61 x447) painted right PF2 (x350-446) NEW pattern
    857  f0d7							; under OLD hot color = the blinking thin yellow line at y191/192.
    858  f0d7		       b5 c3		      lda	PF0Buf,X
    859  f0d9		       85 0d		      sta	PF0
    860  f0db		       b5 c7		      lda	PF1Buf,X
