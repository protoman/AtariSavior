   1558  f42d							; ------------------------------------------------------------------------------
   1559  f42d							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1560  f42d							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1561  f42d							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1562  f42d							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1563  f42d							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1564  f42d							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1565  f42d							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1566  f42d							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1567  f42d							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1568  f42d							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1569  f42d							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1570  f42d							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1571  f42d							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1572  f42d							; ------------------------------------------------------------------------------
   1573  f42d				   UE_Tentacle
   1574  f42d		       a5 ad		      lda	TickCounter
   1575  f42f		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1576  f431							; = half the player's 1 px/frame (user
   1577  f431							; 2026-10-10: &3 read as chunky/slow)
   1578  f431		       d0 4b		      bne	.TentOut
   1579  f433		       b5 bd		      lda	EnemyRamX,X
   1580  f435		       c5 80		      cmp	RoomX
   1581  f437		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1582  f439		       90 06		      bcc	.TentRight
   1583  f43b		       38		      sec
   1584  f43c		       e9 01		      sbc	#1	; step left
   1585  f43e		       4c 44 f4 	      jmp	.TentProbe
   1586  f441				   .TentRight
   1587  f441		       18		      clc
   1588  f442		       69 01		      adc	#1	; step right
   1589  f444				   .TentProbe
   1590  f444		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1591  f446		       b0 36		      bcs	.TentOut
   1592  f448		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1593  f44a							; Same-column cull: committed X is always probe-clear, so a candidate in
   1594  f44a							; the same 4px column covers the same collision cells → result is known
   1595  f44a							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1596  f44a		       a5 88		      lda	Temp
   1597  f44c		       55 bd		      eor	EnemyRamX,X
   1598  f44e		       29 fc		      and	#$FC
   1599  f450		       f0 28		      beq	.TentCommit
   1600  f452		       a5 80		      lda	RoomX
   1601  f454		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1602  f456		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1603  f458		       85 b8		      sta	ActiveObjectY
   1604  f45a		       a5 88		      lda	Temp
   1605  f45c		       c9 05		      cmp	#5
   1606  f45e		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1607  f460							; PHM's negative visible-left wraps to 255
   1608  f460							; (col garbage / ColOff OOB walk). cand<=4
   1609  f460							; ink pokes off-screen anyway; RoomX=cand
   1610  f460							; already covers cell0.
   1611  f460		       38		      sec
   1612  f461		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1613  f463							; sits 5/7 px left of A (moth .Mvl convention,
   1614  f463							; bank2), but PHM's PLAYER prologue derives
   1615  f463							; lit-left = arg-4/arg-7 with the bin on
   1616  f463							; RoomX-PlayerDir → box missed the cell left
   1617  f463							; of the ink at cand 8/12 (sprite drew 1 px
   1618  f463							; into the wall — bugs.md #4). cand-1 shifts
   1619  f463							; the tested box 1 px left: cell-exact or 1 px
   1620  f463							; conservative for every cand/facing pair
   1621  f463							; (tools/test_cell_map.py tentacle section).
   1622  f463				   .TentProbeX
   1623  f463		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1624  f465		       b5 e2		      lda	EnemyRamY,X
   1625  f467		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1626  f469		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1627  f46b							; (rect walk ldx/dex/tax) — slot was lost here
   1628  f46b		       20 26 f9 	      jsr	PlayerHitsMap
   1629  f46e		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1630  f470		       a5 b8		      lda	ActiveObjectY
   1631  f472		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1632  f474		       a5 b7		      lda	ActiveObjectX
   1633  f476		       85 80		      sta	RoomX	; restore player X
   1634  f478		       b0 04		      bcs	.TentOut	; wall → hold position
   1635  f47a				   .TentCommit
   1636  f47a		       a5 88		      lda	Temp
   1637  f47c		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1638  f47e				   .TentOut
   1639  f47e		       4c 28 f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1640  f481
   1641  f481							; ------------------------------------------------------------------------------
   1642  f481							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1643  f481							; there is no free ZP byte for per-slot movement state (phase/direction live
   1644  f481							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1645  f481							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1646  f481							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1647  f481							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1648  f481							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1649  f481							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1650  f481							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1651  f481							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1652  f481							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1653  f481							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1654  f481							;	    the 60-frame game timer — gates from it wrap every second).
   1655  f481							; Other types: straight ROM y (their movement stages come later).
   1656  f481							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1657  f481							; ------------------------------------------------------------------------------
   1658  f481				   DeriveEnemyY
   1659  f481							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1660  f481							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1661  f481		       a5 b1		      lda	EnemyDataLo
   1662  f483		       85 e5		      sta	FetchPtr
   1663  f485		       a5 b2		      lda	EnemyDataHi
   1664  f487		       85 e6		      sta	FetchPtr+1
   1665  f489		       bc b2 f9 	      ldy	EnemyOffTable,X
   1666  f48c		       20 f6 fe 	      jsr	FoldIndirect	; type
   1667  f48f		       c9 01		      cmp	#ENEMY_BAT
   1668  f491		       f0 18		      beq	.DEYTickNoShift
   1669  f493		       c9 03		      cmp	#ENEMY_TENTACLE
   1670  f495		       f0 1a		      beq	.DEYTickShift
   1671  f497		       c9 00		      cmp	#ENEMY_SPIDER
   1672  f499		       f0 2e		      beq	.DEYSpiderTick
   1673  f49b		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1674  f49d		       d0 06		      bne	.DEYStatic
   1675  f49f		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1676  f4a2		       4c be f4 	      jmp	DEYDelta
   1677  f4a5				   .DEYStatic
   1678  f4a5		       c8		      iny
   1679  f4a6		       c8		      iny
   1680  f4a7		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1681  f4aa		       60		      rts
   1682  f4ab				   .DEYTickNoShift
   1683  f4ab		       a5 c2		      lda	EnemyRamP
   1684  f4ad		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1685  f4ae		       4c b6 f4 	      jmp	.DEYBobTick
   1686  f4b1				   .DEYTickShift
   1687  f4b1		       a5 c2		      lda	EnemyRamP
   1688  f4b3		       4a		      lsr
   1689  f4b4		       4a		      lsr
   1690  f4b5		       4a		      lsr		; ÷8 gate
   1691  f4b6				   .DEYBobTick		; shared bob delta: triangle(p&3) = 0,1,2,1
   1692  f4b6		       29 03		      and	#3
   1693  f4b8		       c9 03		      cmp	#3
   1694  f4ba		       d0 02		      bne	DEYDelta
   1695  f4bc		       a9 01		      lda	#1	; 3 -> 1
   1696  f4be							; (dead `jmp DEYDelta` removed — target was
   1697  f4be							;  the very next instruction)
   1698  f4be				   DEYDelta		; A = delta, then add ROM spawn y
   1699  f4be		       85 88		      sta	Temp
   1700  f4c0		       c8		      iny
   1701  f4c1		       c8		      iny
   1702  f4c2		       20 f6 fe 	      jsr	FoldIndirect	; ROM spawn y
   1703  f4c5		       18		      clc
   1704  f4c6		       65 88		      adc	Temp
   1705  f4c8		       60		      rts
   1706  f4c9				   .DEYSpiderTick
   1707  f4c9		       a5 c2		      lda	EnemyRamP
   1708  f4cb		       4a		      lsr
   1709  f4cc		       4a		      lsr		; ÷4 gate (1 px per 4 frames)
   1710  f4cd		       29 3f		      and	#$3F	; p = 0..63
   1711  f4cf		       c9 30		      cmp	#48
   1712  f4d1		       90 04		      bcc	.DEYSUp
   1713  f4d3		       a9 00		      lda	#0	; dwell: p 48..63 (clock wrap lands here)
   1714  f4d5		       f0 e7		      beq	DEYDelta	; always
   1715  f4d7				   .DEYSUp
   1716  f4d7		       c9 19		      cmp	#25
   1717  f4d9		       90 e3		      bcc	DEYDelta	; p <= 24: delta = p (down, 0..24)
   1718  f4db		       49 ff		      eor	#$FF
   1719  f4dd		       38		      sec
   1720  f4de		       e9 cf		      sbc	#$CF	; 48-p = (255-p)-207, up phase (p 25..47)
   1721  f4e0		       4c be f4 	      jmp	DEYDelta
