   3923  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3924  febe							;   pose ($FE must take the real-fall path)
   3925  febe		       20 20 fc 	      jsr	LoadLevel
   3926  fec1		       a9 78		      lda	#120	; reset timer for new level
   3927  fec3		       85 ae		      sta	BarLevel
   3928  fec5		       a9 3c		      lda	#60
