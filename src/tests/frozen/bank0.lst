   1377  f366		       85 93		      sta	vyLo
   1378  f368		       85 94		      sta	vyHi
   1379  f36a		       a5 b5		      lda	BombPacked
   1380  f36c		       09 80		      ora	#%10000000	; landed — OnGround
   1381  f36e		       85 b5		      sta	BombPacked
   1382  f370		       60		      rts
   1383  f371				   .SDAir
   1384  f371		       a5 b5		      lda	BombPacked
   1385  f373		       29 7f		      and	#%01111111	; still falling — not ground
   1386  f375		       85 b5		      sta	BombPacked
   1387  f377		       60		      rts
   1388  f378				   .SDBottom
   1389  f378		       20 db f4 	      jsr	ExitRoomDown
   1390  f37b		       a5 81		      lda	RoomY
   1391  f37d		       c9 84		      cmp	#PLAYER_MAX_Y
   1392  f37f		       d0 0c		      bne	.SDDone	; changed room (EnterRoom cleared b7)
   1393  f381		       a5 b5		      lda	BombPacked
   1394  f383		       09 80		      ora	#%10000000	; no down exit — standing on floor
   1395  f385		       85 b5		      sta	BombPacked
   1396  f387		       a9 00		      lda	#0
   1397  f389		       85 93		      sta	vyLo
   1398  f38b		       85 94		      sta	vyHi
