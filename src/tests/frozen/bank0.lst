   2155  f600							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2156  f600							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2157  f600							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2158  f600							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2159  f600							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2160  f600							; this region is upstream of the pin, so it costs nothing at $FC67.
   2161  f600							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2162  f600							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2163  f600							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2164  f600							; and normal deaths, resets on game-over reload.
   2165  f600							; ------------------------------------------------------------------------------
   2166  f600				   CEH_Key
   2167  f600		       a5 ba		      lda	EnemyDeadMask
   2168  f602		       1d c9 f3 	      ora	EnemyBitTable,X
   2169  f605		       85 ba		      sta	EnemyDeadMask
   2170  f607		       a5 a7		      lda	LevelStartRoom
   2171  f609		       09 80		      ora	#$80	; KeyHeld = b7
   2172  f60b		       85 a7		      sta	LevelStartRoom
   2173  f60d		       60		      rts
