   3869  fcfc		       20 12 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3870  fcff		       a9 00		      lda	#0
   3871  fd01		       85 f3		      sta	ScoreTh
   3872  fd03		       85 f4		      sta	ScoreHu
   3873  fd05		       18		      clc
   3874  fd06		       60		      rts
