   3969  fd7c							; ------------------------------------------------------------------------------
   3970  fd7c							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3971  fd7c							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3972  fd7c							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3973  fd7c							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3974  fd7c							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3975  fd7c							; DeriveEnemyY — no persistent movement state exists in RAM.
   3976  fd7c							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3977  fd7c							; block after the pads; pre-pad headroom is 1B).
   3978  fd7c							; ------------------------------------------------------------------------------
   3979  fd7c				   RefreshEnemyY
   3980  fd7c
   3981  fd7c		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3982  fd7e							; TickCounter is the 60-frame GAME timer
   3983  fd7e							; (decrements 60->1, reloads) — gates derived
   3984  fd7e							; from it wrapped every second (spider
   3985  fd7e							; "teleported": (TC>>3)&63 only ever saw
   3986  fd7e							; 0..7 and counted DOWN 0->7 = jump).
   3987  fd7e		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3988  fd80		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3989  fd82				   .REYLoop		; every reader runs after refresh completes)
   3990  fd82		       ca		      dex
   3991  fd83		       20 90 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3992  fd86		       95 e2		      sta	EnemyRamY,X
   3993  fd88		       8a		      txa		; N/Z must come from X: flags after jsr are
   3994  fd89		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3995  fd8b				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3996  fd8b							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3997  fd8b							; black rooms, broken PF, invisible sprites)
   3998  fd8b							; --- SELECT or RESET held → back to the old title / level-select screen
   3999  fd8b							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   4000  fd8b							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   4001  fd8b							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   4002  fd8b							;     through TitleWork RESET, level-triggered here) cannot bounce back
   4003  fd8b							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   4004  fd8b							;     RESET held past LANDING still re-fires — press must be released
   4005  fd8b							;     before the drop-in finishes. ---
   4006  fd8b		       a5 8a		      lda	DropTarget
   4007  fd8d		       d0 1d		      bne	.REYRts	; not idle: not ours
   4008  fd8f		       ad 82 02 	      lda	SWCHB
   4009  fd92		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   4010  fd94		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   4011  fd96		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   4012  fd98		       f0 12		      beq	.REYRts	; neither pressed
   4013  fd9a		       a9 ff		      lda	#$FF
   4014  fd9c		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   4015  fd9e		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   4016  fda0		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   4017  fda2		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   4018  fda4							;   game must clear them for a clean melody
   4019  fda4		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   4020  fda7		       68		      pla		; drop OUR return address (LoadLevel already
   4021  fda8		       68		      pla		;   popped its own) — tail into TitleWork
   4022  fda9		       4c 36 fd 	      jmp	TitleWork
   4023  fdac				   .REYRts
   4024  fdac		       60		      rts
