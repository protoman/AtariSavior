   1492  f3cb							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1493  f3cb							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1494  f3cb							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1495  f3cb							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1496  f3cb							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1497  f3cb							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1498  f3cb							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1499  f3cb							; so the first move is the retreat into its wall. Ignores editor range_* per
   1500  f3cb							; user 2026-09-23. No wall collision.
   1501  f3cb							; ------------------------------------------------------------------------------
   1502  f3cb				   UpdateEnemies
   1503  f3cb		       a5 b3		      lda	EnemyCount
   1504  f3cd		       d0 01		      bne	UE_Start
   1505  f3cf		       60		      rts
   1506  f3d0				   UE_Start
   1507  f3d0							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1508  f3d0							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1509  f3d0		       a5 b1		      lda	EnemyDataLo
   1510  f3d2		       85 e5		      sta	FetchPtr
   1511  f3d4		       a5 b2		      lda	EnemyDataHi
   1512  f3d6		       85 e6		      sta	FetchPtr+1
   1513  f3d8		       a2 00		      ldx	#0
   1514  f3da				   UE_Loop
   1515  f3da		       e4 b3		      cpx	EnemyCount
   1516  f3dc		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1517  f3de		       4c 39 f4 	      jmp	UE_Exit
   1518  f3e1				   UE_Alive
   1519  f3e1		       a5 ba		      lda	EnemyDeadMask
   1520  f3e3		       3d c7 f3 	      and	EnemyBitTable,X
   1521  f3e6		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1522  f3e8		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1523  f3eb		       20 f6 fe 	      jsr	FoldIndirect	; type
   1524  f3ee		       4c 29 f8 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1525  f3f1							; 18 B per-type compare chain with one 3 B jmp:
   1526  f3f1							; frees 15 B of pre-pad headroom and gives the
   1527  f3f1							; type tables room for the raft byte.
   1528  f3f1				   UE_SnakeBody
