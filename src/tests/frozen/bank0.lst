   3406  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3407  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3408  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3409  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3410  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3411  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3412  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3413  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3414  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3415  fe9c							; ------------------------------------------------------------------------------
   3416  fe9c				   TallyWork
   3417  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3418  fe9f		       a8		      tay
   3419  fea0		       29 01		      and	#1
   3420  fea2		       f0 05		      beq	.TNoScore
   3421  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3422  fea6		       20 1a fc 	      jsr	CallPad_AddScore
   3423  fea9				   .TNoScore
   3424  fea9		       98		      tya
   3425  feaa		       29 04		      and	#4
   3426  feac		       f0 1e		      beq	.TLive
   3427  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3428  feb0		       a5 a3		      lda	Level
   3429  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3430  feb4		       d0 04		      bne	.TNotWrap
   3431  feb6		       a9 00		      lda	#0	; wrap past last level
   3432  feb8		       85 a3		      sta	Level
   3433  feba				   .TNotWrap
   3434  feba		       a9 00		      lda	#0
   3435  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3436  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3437  febe							;   pose ($FE must take the real-fall path)
   3438  febe		       20 2f f5 	      jsr	LoadLevel
   3439  fec1		       a9 78		      lda	#120	; reset timer for new level
   3440  fec3		       85 ae		      sta	BarLevel
   3441  fec5		       a9 3c		      lda	#60
   3442  fec7		       85 ad		      sta	TickCounter
   3443  fec9		       4c 18 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3444  fecc				   .TLive
   3445  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3446  fecf		       a9 00		      lda	#0
   3447  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3448  fed3				   .TWait
   3449  fed3		       ad 84 02 	      lda	INTIM
   3450  fed6		       d0 fb		      bne	.TWait
   3451  fed8		       4c 39 f0 	      jmp	StartFrame
