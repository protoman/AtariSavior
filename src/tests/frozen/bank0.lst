   2167  f5fa							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2168  f5fa							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2169  f5fa							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2170  f5fa							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2171  f5fa							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2172  f5fa							; this region is upstream of the pin, so it costs nothing at $FC67.
   2173  f5fa							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2174  f5fa							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2175  f5fa							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2176  f5fa							; and normal deaths, resets on game-over reload.
   2177  f5fa							; ------------------------------------------------------------------------------
   2178  f5fa				   CEH_Key
   2179  f5fa		       a5 ba		      lda	EnemyDeadMask
   2180  f5fc		       1d ca f3 	      ora	EnemyBitTable,X
   2181  f5ff		       85 ba		      sta	EnemyDeadMask
   2182  f601		       a5 a7		      lda	LevelStartRoom
   2183  f603		       09 80		      ora	#$80	; KeyHeld = b7
   2184  f605		       85 a7		      sta	LevelStartRoom
   2185  f607		       a9 09		      lda	#9	; pickup blip (pitch 9)
   2186  f609		       4c 3c fc 	      jmp	PickupSnd
   2187  f60c
   2188  f60c							; ------------------------------------------------------------------------------
   2189  f60c							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2190  f60c							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2191  f60c							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2192  f60c							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2193  f60c							; ------------------------------------------------------------------------------
   2194  f60c				   UEDispatch
   2195  f60c		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2196  f60e							;   the single type-compare entry. 2026-10-22:
   2197  f60e							;   a raft authored dir=right read $87, missed
   2198  f60e							;   `cmp #ENEMY_RAFT` and its body never ran
   2199  f60e							;   (no tide, no motion, no rider pin).
   2200  f60e		       c9 07		      cmp	#ENEMY_RAFT
   2201  f610		       d0 06		      bne	.UEDNotRaft
   2202  f612		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2203  f615		       4c 3b f4 	      jmp	UE_Next
   2204  f618				   .UEDNotRaft
   2205  f618		       c9 03		      cmp	#ENEMY_TENTACLE
   2206  f61a		       d0 03		      bne	.UEDNotTent
   2207  f61c		       4c 42 f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2208  f61f				   .UEDNotTent
   2209  f61f		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2210  f621		       d0 03		      bne	.UEDNotMoth
   2211  f623		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2212  f626				   .UEDNotMoth
   2213  f626		       c9 02		      cmp	#ENEMY_SNAKE
   2214  f628		       d0 03		      bne	.UEDNotSnake
   2215  f62a		       4c f7 f3 	      jmp	UE_SnakeBody
   2216  f62d				   .UEDNotSnake
   2217  f62d		       4c 3b f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2218  f630							; (absolute jmps: this block is far from the
   2219  f630							;  bodies — relative branches do not reach)
