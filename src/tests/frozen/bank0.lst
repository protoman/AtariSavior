   3568  fedb							; BeamMask — per-scanline ENAM0 values for the in-window kernel path (S2.2).
   3569  fedb							; Indexed by Y = A0 = Scanline - RoomY, rows 0-11 only.
   3570  fedb							; Rows 2-3 = $02 (beam on: RoomY+2..RoomY+3 = eye rows — yellow face row 2 +
   3571  fedb							; red row 3 = two-tone beam; kept per user decision: single-red rows could
   3572  fedb							; not also reach floor-standing enemies without kill-window churn); rest $00.
   3573  fedb							; 2026-10-08 user directive: ONE strip, yellow — row 2 only ($02 at index 2),
   3574  fedb							; row 3 dropped. Kill window in LaserHitTestBody stays rows RoomY+2..3 = a
   3575  fedb							; superset of the 1-line draw (floor-standing reach preserved).
   3576  fedb							; Lives in the $FExx page: `lda BeamMask,Y` from .Line ($F1xx) fetches in
   3577  fedb							; 4c when operand+11 stays in-page (1c reclaim toward the ObjColorTab
   3578  fedb							; write; verify_build asserts the no-cross operand range).
   3579  fedb							; ------------------------------------------------------------------------------
   3580  fedb				   BeamMask
   3581  fedb		       00 00 02 00*	      .byte.b	0,0,2,0,0,0,0,0,0,0,0,0
   3582  fee7
   3583  fee7
   3584  fee7					      .ds	$FEE7 - *, 0	; bank0↔bank1 CallPad (leaf_move_plan Step 0)
