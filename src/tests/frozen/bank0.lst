    841  f118				   .Line
    842  f118				   SliceReentry 		; global alias ON .Line — RowSlice's tail
    843  f118							;   jmp lands here (its scope can't see .Line)
    844  f118							; --- Player sprite: color for THIS line, graphics byte for NEXT line ---
    845  f118							; GRP0 written on line S displays on line S+1 (latched at the sprite's
    846  f118							; window start after the write) — index graphics with A0+1 ($ff wraps
    847  f118							; to 0 = row0 on the line before the sprite).
    848  f118							; Running-Y: Y = A0 = Scanline - RoomY is computed ONCE at kernel entry
    849  f118							; (sec/sbc RoomY/tay); .Line's iny advances it (Y = A0+1 after the
    850  f118							; graphics write = A0 of the next line). Nothing between rows may touch
    851  f118							; Y — the water-strip band-color read is an inlined `lda` (Y untouched).
    852  f118							; Cycle budget — MEASURED (sim_frame_budget, bugs.md #29 Class A):
    853  f118							; the old worst path (in-window color/beam/GRP0 + object in-range) was
    854  f118							; 78c: WSYNC write landed 2c into the next line -> full-line stall ->
    855  f118							; +1 scanline on every frame whose object window overlapped the A0=11
    856  f118							; line (24 stalls in the SIM_LEVEL=2 window, always even frames —
    857  f118							; SelectActiveObject parity rotation). Root fix: the color/beam gate
    858  f118							; below stops at A0=10; row 11 inherits row 10's COLUP0/ENAM0 writes
    859  f118							; (PlayerColTable/BeamMask [10]==[11], verify_build asserts) because
    860  f118							; GRP0 row11 is fetched on line A0=10 already ("row11 shows via
    861  f118							; line10"). Worst path measured 2026-10-15 (vcrunch jitter hunt):
    862  f118							; in-window color/beam/GRP0 + object in-range = 69c between WSs,
    863  f118							; start-to-start d=72 — was 73/76 (= stall zone 74-76, whole-screen
    864  f118							; +1-line jitter) until the dead `cpy #12 / bcs .GrpZero` (4c, never
    865  f118							; taken on the A0<=10 color path) moved to .GrpSkip. Budget: work
    866  f118							; <= 70c / d <= 73 — a 74-76 segment stalls a full scanline.
    867  f118							; ObjSprites+71 must stay in the $FExx page (else lda ObjSprites,X
    868  f118							; page-crosses, +1c on the GRP1 fetch) — verify_build enforces this.
    869  f118							; Branch targets all same-page (3c taken) and BeamMask operand in $FExx
    870  f118							; (4c fetch, no-cross — verify_build S2.2 guard).
    871  f118							; GRP1 object section clobbers X (ObjSprites index) — row counter lives in
    872  f118							; RowIdx and X is reloaded after bne. Row-advance +6c on the .Row setup
    873  f118							; scanline (segment 63c -> 69c <= 76c): frame length unchanged.
    874  f118							; The old Scanline/sec/sbc/tay prefix cost 10c more (body 66c -> WSYNC
    875  f118							; write on cycle 76 = one cycle late): WSYNC stalled a full line per
    876  f118							; overlapping scanline — stretched cave row, HUD pushed down, and with
    877  f118							; GRP1 flicker rotation the frame length alternated (one-tile oscillation).
    878  f118							; Keep the hot path at <= 70c work: an overrun duplicates the scanline.
    879  f118		       c0 0b		      cpy	#PLAYER_SPRITE_H - 1
    880  f11a		       b0 49		      bcs	.GrpSkip	; A0 >= 11 (incl $ff): no color/beam this line.
    881  f11c							; A0=11 skips too (Class-A stall line): rows
    882  f11c							; 10/11 share color+beam bytes, so row 10's
    883  f11c							; writes are still in effect here.
    884  f11c		       b9 f5 f8 	      lda	PlayerColTable,Y	; 4c — per-row color from ROM
    885  f11f		       85 06		      sta	COLUP0	; COLUP0 has no latch: applies to this line
    886  f121							; --- Laser S2.2: ENAM0 = beam mask for THIS line (in-window only) ---
    887  f121							; BeamMask = {0,0,2,0,0...} → ENAM0 on RoomY+2 only (single yellow
    888  f121							; strip — user directive 2026-10-08: the red row-3 strip is gone;
    889  f121							; kill window in LaserHitTestBody keeps rows RoomY+2..3 = superset).
    890  f121							; In-window path is the only safe place (Y<11 guaranteed); outside the
    891  f121							; window ENAM0 keeps its last in-window write ($00 at A0=10) — no HUD
    892  f121							; artifact. Table lives in $FExx (no-cross = 4c, verify_build guard).
    893  f121		       b9 db fe 	      lda	BeamMask,Y	; 4c (no-cross $FExx) — table MUST stay $FExx
    894  f124		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
    895  f126		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
    896  f128		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
    897  f129							;   Color/beam gate entered only with A0<=10
    898  f129							;   -> after iny Y<=11: always fetchable, so
    899  f129							;   the old `cpy #PLAYER_SPRITE_H / bcs
    900  f129							;   .GrpZero` here was DEAD 4c on the worst
    901  f129							;   path (2+2, never taken — A0=11+ never
    902  f129							;   reaches it, it goes to bcs .GrpSkip).
    903  f129		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
