   3934  fd21		       85 95		      sta	PlayerYSub
   3935  fd23		       90 0e		      bcc	.DSdone	; subpixel: no whole pixel yet this frame
   3936  fd25		       e6 81		      inc	RoomY
   3937  fd27		       a5 81		      lda	RoomY
   3938  fd29		       c5 8a		      cmp	DropTarget
   3939  fd2b		       90 06		      bcc	.DSdone
   3940  fd2d		       a9 00		      lda	#0
   3941  fd2f		       85 8a		      sta	DropTarget	; arrived — input/physics resume next frame
   3942  fd31		       85 96		      sta	JetPower	; clean resume (no phantom thrust hop)
   3943  fd33				   .DSdone
