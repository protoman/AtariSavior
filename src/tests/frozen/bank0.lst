   1965  f642							; ==============================================================================
   1966  f642							; SelectActiveObject — choose the single GRP1 object to draw this frame.
   1967  f642							; The TIA has one GRP1 sprite, so objects flicker by rotating slots each frame.
   1968  f642							; Sets ObjBase, ActiveObjectX, ActiveObjectY, ObjTop, COLUP1.
   1969  f642							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   1970  f642							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0
   1971  f642							; (~15 Hz); other frames normal miner/enemy rotation (FlickerFrame alone).
   1972  f642							; One GRP1: cannot draw bomb + entity same frame.
   1973  f642							; ------------------------------------------------------------------------------
   1974  f642				   SelectActiveObject
   1975  f642		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   1976  f644							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   1977  f644		       a5 b5		      lda	BombPacked
   1978  f646		       29 03		      and	#%00000011
   1979  f648		       c9 01		      cmp	#1
   1980  f64a		       d0 19		      bne	.SOCount
   1981  f64c		       a5 f7		      lda	BombTimer
   1982  f64e		       29 03		      and	#3
   1983  f650		       d0 13		      bne	.SOCount	; 3 of 4 -> miner/enemy
   1984  f652		       a9 40		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   1985  f654		       85 b6		      sta	ObjBase
