   4654  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4655  ff27		       8a		      txa
   4656  ff28		       29 80		      and	#LASER_HELD
   4657  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4658  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4659  ff2d		       85 c0		      sta	LaserState
   4660  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4661  ff31		       45 dd		      eor	DemoOn	; demo script presses (b7; 0 = no effect)
   4662  ff33		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4663  ff35							; below — moved here so the cap code could
   4664  ff35							; not push .LaserReleased past bmi's ±127)
   4665  ff35				   .LaserReleased
   4666  ff35		       a9 00		      lda	#0
