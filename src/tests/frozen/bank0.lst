   1980  f646		       38		      sec
   1981  f647		       e5 88		      sbc	Temp
   1982  f649		       85 b4		      sta	FlickerFrame
   1983  f64b		       4c 40 f6 	      jmp	.SOModLoop
   1984  f64e				   .SOModDone
