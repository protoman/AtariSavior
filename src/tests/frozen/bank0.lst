   2523  f93e		       a5 80		      lda	RoomX
   2524  f940		       e5 82		      sbc	PlayerDir
   2525  f942		       c9 0f		      cmp	#15
   2526  f944		       b0 06		      bcs	.off7
   2527  f946		       38		      sec
   2528  f947		       e9 04		      sbc	#4	; P0 target <15: visible left = X - 4
   2529  f949		       4c 4e f9 	      jmp	.gotVL
   2530  f94c				   .off7
   2531  f94c		       e9 07		      sbc	#7	; P0 target >=15: visible left = X - 7
   2532  f94e				   .gotVL
   2533  f94e		       18		      clc
   2534  f94f		       65 82		      adc	PlayerDir	; reflected sprite's first lit bit is column 1
   2535  f951							; first block = visible_left / 4 -> text column
   2536  f951		       a8		      tay		; Y = visible_left
   2537  f952		       4a		      lsr
   2538  f953		       4a		      lsr
   2539  f954		       c9 14		      cmp	#TILE_COLUMNS
   2540  f956		       90 07		      bcc	.firstOk
   2541  f958		       85 8b		      sta	CollisionX
   2542  f95a		       a9 27		      lda	#39
   2543  f95c		       38		      sec
   2544  f95d		       e5 8b		      sbc	CollisionX
   2545  f95f				   .firstOk
   2546  f95f		       85 8e		      sta	CollisionEndX	; min text column
   2547  f961
   2548  f961							; last block = (visible_left + PLAYER_WIDTH - 1) / 4 -> text column
   2549  f961		       98		      tya		; A = visible_left
   2550  f962		       18		      clc
   2551  f963		       69 06		      adc	#PLAYER_WIDTH - 1
   2552  f965		       4a		      lsr
   2553  f966		       4a		      lsr
   2554  f967		       c9 14		      cmp	#TILE_COLUMNS
   2555  f969		       90 07		      bcc	.lastOk
   2556  f96b		       85 8b		      sta	CollisionX
   2557  f96d		       a9 27		      lda	#39
   2558  f96f		       38		      sec
   2559  f970		       e5 8b		      sbc	CollisionX
   2560  f972				   .lastOk
   2561  f972		       85 8c		      sta	CollisionCellX	; max text column
   2562  f974
   2563  f974							; Ensure min <= max (blocks 20+ reverse the column order)
   2564  f974		       a5 8e		      lda	CollisionEndX
   2565  f976		       c5 8c		      cmp	CollisionCellX
   2566  f978		       90 06		      bcc	.colsOk
   2567  f97a		       a6 8c		      ldx	CollisionCellX
