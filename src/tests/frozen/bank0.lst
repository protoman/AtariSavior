   3401  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3402  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3403  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3404  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3405  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3406  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3407  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3408  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3409  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3410  fe9c							; ------------------------------------------------------------------------------
   3411  fe9c				   TallyWork
   3412  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3413  fe9f		       a8		      tay
   3414  fea0		       29 01		      and	#1
   3415  fea2		       f0 05		      beq	.TNoScore
   3416  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3417  fea6		       20 1a fc 	      jsr	CallPad_AddScore
   3418  fea9				   .TNoScore
   3419  fea9		       98		      tya
   3420  feaa		       29 04		      and	#4
   3421  feac		       f0 1e		      beq	.TLive
   3422  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3423  feb0		       a5 a3		      lda	Level
   3424  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3425  feb4		       d0 04		      bne	.TNotWrap
   3426  feb6		       a9 00		      lda	#0	; wrap past last level
   3427  feb8		       85 a3		      sta	Level
   3428  feba				   .TNotWrap
   3429  feba		       a9 00		      lda	#0
   3430  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3431  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3432  febe							;   pose ($FE must take the real-fall path)
   3433  febe		       20 35 f5 	      jsr	LoadLevel
   3434  fec1		       a9 78		      lda	#120	; reset timer for new level
   3435  fec3		       85 ae		      sta	BarLevel
   3436  fec5		       a9 3c		      lda	#60
   3437  fec7		       85 ad		      sta	TickCounter
   3438  fec9		       4c 1e f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3439  fecc				   .TLive
