   3046  fceb							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3047  fceb							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3048  fceb							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3049  fceb		       a9 00		      lda	#0
