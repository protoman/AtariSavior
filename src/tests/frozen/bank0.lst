   1829  f56c		       85 f7		      sta	BombTimer
   1830  f56e		       85 c1		      sta	EnemyRamD	; clear dir + RoomDarkMask (bits 4-7) — level reset
   1831  f570		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1832  f572							;  game-over restart = LoseLife->ReloadLevel->
   1833  f572							;  here; same-stage respawn keeps facing)
   1834  f572		       85 9c		      sta	Hover	; bugs.md #1: stage entry lands normally; the
   1835  f574							;   respawn hover is armed only by LoseLife
   1836  f574		       a5 c0		      lda	LaserState
