   1266  f2c0							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1267  f2c0							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1268  f2c0							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1269  f2c0							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1270  f2c0							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1271  f2c0							;     resumes (he lifts off). No Up -> hovers in place.
   1272  f2c0				   .Integrate
   1273  f2c0		       a5 9c		      lda	Hover
   1274  f2c2		       f0 13		      beq	.DoInt
   1275  f2c4		       a5 96		      lda	JetPower
