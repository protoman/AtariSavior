   1815  f582							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1816  f582							; LevelDataTable stride: 14 bytes
   1817  f582							;   +0..+2: start_room, start_x, start_y
   1818  f582							;   +3..+5: miner_room (b7 = faces right), miner_x, miner_y
   1819  f582							;   +6..+7: pfdata ptr (lo, hi)
   1820  f582							;   +8..+9: conn ptr (lo, hi)
   1821  f582							;  +10..+11: enemy ptr (lo, hi)
