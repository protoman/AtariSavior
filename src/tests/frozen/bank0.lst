   2579  f901							; fund the HERO kernel plan (bank0 eviction);
   2580  f901							; the 20-level stage is kept at
   2581  f901							; src/tests/stages/stage_20_levels.json
   2582  f901		       f3 07	   LEVEL_DATA_ADDR =	$F307	; frozen address of bank2's LevelDataTable
   2583  f901							; (S4.1 −$FAFA, S4.2 −$FA8E, 2026-10-02
   2584  f901							;  −$FA86 as the ≤2-object room migration
   2585  f901							;  shrank the tables; check_frozen_addrs
   2586  f901							;  enforces)
   2587  f901							; (test asserts bank2.lst label == this)
   2588  f901		       00 06	   LEVEL_FORMAT =	$06	; C11 2026-10-21: room-record + shape format. 6 =
   2589  f901							; 4 (shape index b5-0 | band b6 | owns-extras
   2590  f901							; b7, position byte, enemy count <<6 | extras
   2591  f901							; ordinal, then the level's AsyncExtras stream)
   2592  f901							; + shape blocks store 3 row-pool indices
   2593  f901							; instead of 9 raw PF bytes (C3 row dictionary).
   2594  f901							; Hand copy of the generated EQU (bank1 carries
   2595  f901							; the twin — check_equ_sync; verify_build
   2596  f901							; compares both to generated/levels_index.asm)
   2597  f901							; ==============================================================================
   2598  f901							; YToRowTable — convert scanline to 48-line band row (0-2), idx A>>2
   2599  f901							; ==============================================================================
   2600  f901							; The jsr wrapper that used to live here was dead (PlayerHitsMap inlines the
   2601  f901							; lsr/lsr/tay/lda lookup — saves 2 JSR stack push levels to keep SP >= $F8)
   2602  f901							; and was removed in S1.6. Table rationale: the old subtract loop grew
   2603  f901							; linearly with RoomY and made 3× PlayerHitsMap (fall 2 + L/R 1) exceed
   2604  f901							; overscan TIM64T=35 (~2240c) in 4-rect rooms → frame >262 lines → vertical
   2605  f901							; roll when strafing while falling.
   2606  f901							; Indexed by A>>2: 37 entries (idx 0-35 = A 0-143 = the player envelope
   2607  f901							; "Max A = PLAYER_MAX_Y+11 = 143", + idx36 = the tentacle-bob clamp, below).
   2608  f901							; Costs +4c/call vs the 192-entry table, saves 144 ROM bytes.
   2609  f901							; Row = idx/12 = scanline/48 (3 cave bands of 48 lines = rows 0-2).
   2610  f901							;
   2611  f901							; 36 entries: 12 each of 0,1,2 (value = index/12 = scanline/48) +
   2612  f901							; idx36 = 2: tentacle RoomY 133/134 (bob on spawn y=132) → A=(Y+11)>>2 =
   2613  f901							; 36 — WITHOUT this byte the lookup reads the OOB opcode ($A5 = `lda
   2614  f901							; RoomY`) → CollisionEndY garbage → cell walk false-hits ~24/32 bob
   2615  f901							; frames → measured 0.125 px/f vs the &1 gate's 0.5 (bugs.md #13).
   2616  f901							; Clamped value 2 = last cave row: box bottom (line 144-145) past the
