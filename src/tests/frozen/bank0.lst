   4044  fd6f							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   4045  fd6f							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   4046  fd6f							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   4047  fd6f							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   4048  fd6f							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   4049  fd6f							; DeriveEnemyY — no persistent movement state exists in RAM.
   4050  fd6f							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   4051  fd6f							; block after the pads; pre-pad headroom is 1B).
   4052  fd6f							; ------------------------------------------------------------------------------
   4053  fd6f				   RefreshEnemyY
   4054  fd6f
   4055  fd6f		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   4056  fd71							; TickCounter is the 60-frame GAME timer
   4057  fd71							; (decrements 60->1, reloads) — gates derived
   4058  fd71							; from it wrapped every second (spider
   4059  fd71							; "teleported": (TC>>3)&63 only ever saw
   4060  fd71							; 0..7 and counted DOWN 0->7 = jump).
   4061  fd71		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   4062  fd73		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   4063  fd75				   .REYLoop		; every reader runs after refresh completes)
   4064  fd75		       ca		      dex
   4065  fd76		       20 96 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   4066  fd79		       95 e2		      sta	EnemyRamY,X
   4067  fd7b		       8a		      txa		; N/Z must come from X: flags after jsr are
   4068  fd7c		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   4069  fd7e				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   4070  fd7e							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   4071  fd7e							; black rooms, broken PF, invisible sprites)
   4072  fd7e							; --- SELECT or RESET held → back to the old title / level-select screen
   4073  fd7e							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   4074  fd7e							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   4075  fd7e							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   4076  fd7e							;     through TitleWork RESET, level-triggered here) cannot bounce back
   4077  fd7e							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   4078  fd7e							;     RESET held past LANDING still re-fires — press must be released
   4079  fd7e							;     before the drop-in finishes. ---
   4080  fd7e		       a5 8a		      lda	DropTarget
   4081  fd80		       d0 1d		      bne	.REYRts	; not idle: not ours
   4082  fd82		       ad 82 02 	      lda	SWCHB
   4083  fd85		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   4084  fd87		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   4085  fd89		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   4086  fd8b		       f0 12		      beq	.REYRts	; neither pressed
   4087  fd8d		       a9 ff		      lda	#$FF
   4088  fd8f		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   4089  fd91		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   4090  fd93		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   4091  fd95		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   4092  fd97							;   game must clear them for a clean melody
   4093  fd97		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   4094  fd9a		       68		      pla		; drop OUR return address (LoadLevel already
   4095  fd9b		       68		      pla		;   popped its own) — tail into TitleWork
   4096  fd9c		       4c 24 fd 	      jmp	TitleWork
   4097  fd9f				   .REYRts
