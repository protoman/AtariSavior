    417 U00bc							; ==============================================================================
    418 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    419 U00bc							; ==============================================================================
    420 U00bc							; Bank3 is the power-up bank. Its stub does:
    421 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    422 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    423 U00bc							; ==============================================================================
    424  10000 ????				       seg	code
    425  f000					      org	$F000
    426  f000
    427  f000							; --- 5-byte bankswitching pad ---
    428  f000							; After bank3's stub selects us, CPU arrives here.
    429  f000							; We jump over the pad into the real init code.
    430  f000		       a9 00		      lda	#0
    431  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    432  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    433  f008							; (NOT deletable: $F008 = GameStart is a
    434  f008							;  hardcoded cross-bank entry — bank1
    435  f008							;  stub `jmp $F008`; this jmp also keeps
    436  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    437  f008							;  fold-pad byte guard fires when it moves)
    438  f008							;  + F0xx landmarks fixed)
    439  f008
    440  f008				   GameStart
    441  f008		       78		      sei		; disable interrupts
    442  f009		       d8		      cld		; clear decimal mode
    443  f00a		       a2 ff		      ldx	#$FF
    444  f00c		       9a		      txs		; stack pointer = $FF
    445  f00d
    446  f00d							; --- Clear zero-page RAM ---
    447  f00d		       a9 00		      lda	#0
    448  f00f		       a2 80		      ldx	#$80
    449  f011				   .ClearZP
    450  f011		       95 00		      sta	$00,X
    451  f013		       e8		      inx
    452  f014		       d0 fb		      bne	.ClearZP
    453  f016
    454  f016							; --- Initialize game state ---
    455  f016		       a9 00		      lda	#0
    456  f018		       85 a3		      sta	Level
    457  f01a		       a9 03		      lda	#3
    458  f01c		       85 ac		      sta	PlayerLives
    459  f01e		       a9 05		      lda	#BOMBS_MAX
    460  f020		       85 f0		      sta	PlayerBombs
    461  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    462  f022		       a9 3c		      lda	#60
    463  f024		       85 ad		      sta	TickCounter
    464  f026		       a9 78		      lda	#120
    465  f028		       85 ae		      sta	BarLevel	; bar starts full
    466  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    467  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    468  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    469  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    470  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    471  f02a		       a9 ff		      lda	#$FF
    472  f02c		       85 8a		      sta	DropTarget
    473  f02e
    474  f02e							; --- Load first level (the title previews it on the live stage:
    475  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    476  f02e		       20 20 fc 	      jsr	LoadLevel
    477  f031
    478  f031							; --- Set player color ---
    479  f031		       a9 48		      lda	#COLOR_PLAYER
    480  f033		       85 06		      sta	COLUP0
    481  f035
    482  f035							; --- Set playfield to reflected mode + priority ---
    483  f035							; D0=1 = reflect (left half mirrors to right)
    484  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    485  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    486  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    487  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    488  f037		       85 0a		      sta	CTRLPF
