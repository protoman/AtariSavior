------- FILE banks.inc LEVEL 2 PASS 2
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  10000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  10000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  10000 ????						;
      6  10000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  10000 ????						; ==============================================================================
      8  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  10000 ????		00 01	    BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  10000 ????		00 02	    BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  10000 ????		00 03	    BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  10000 ????		00 05	    BKI_TRANS  =	5	; version header, blank transition frame, attract script
     14  10000 ????		00 06	    BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  10000 ????		00 07	    BKI_PROLOGUE =	7	; cave kernel start-up code
     16  10000 ????		00 04	    BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     17  10000 ????
     18  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  10000 ????		1f f5	    BK_HUD     =	$1FF4 + BKI_HUD
     20  10000 ????		1f f6	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     21  10000 ????		1f f7	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     22  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     23  10000 ????		1f f9	    BK_TRANS   =	$1FF4 + BKI_TRANS
     24  10000 ????		1f fa	    BK_CAVE    =	$1FF4 + BKI_CAVE
     25  10000 ????		1f fb	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     26  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
------- FILE kernel.asm
      4  10000 ????
      5  10000 ????						; ==============================================================================
      6  10000 ????						; savior kernel — HERO-style fixed-time rendering kernel
      7  10000 ????						; ==============================================================================
      8  10000 ????						; A from-scratch Atari 2600 kernel modeled after Activision's HERO.
      9  10000 ????						;
     10  10000 ????						; Architecture:
     11  10000 ????						;   - 4K ROM at $F000-$FFFF (no bankswitching)
     12  10000 ????						;   - Kernel renders 192 visible scanlines: 144 cave + 48 HUD
     13  10000 ????						;   - Cave: 3 tile rows × 48 scanlines each
     14  10000 ????						;   - Reflected playfield (CTRLPF D0=1) — symmetric cave
     15  10000 ????						;   - GRP0 = player (square sprite), GRP1 = future objects
     16  10000 ????						;   - Per-scanline kernel with WSYNC for stable timing
     17  10000 ????						;   - PF registers written ONCE per tile row (TIA persists)
     18  10000 ????						;   - Overscan: input handling + game logic
     19  10000 ????						;
     20  10000 ????						; Frame timing (262 scanlines @ 60Hz NTSC):
     21  10000 ????						;   VSYNC     3 lines
     22  10000 ????						;   VBLANK   37 lines	(game logic + positioning)
     23  10000 ????						;   Kernel  192 lines	(144 cave + 48 HUD)
     24  10000 ????						;   Overscan  30 lines (input + movement)
     25  10000 ????						;   Total   262 lines
     26  10000 ????						;
     27  10000 ????						; Key difference from naive kernels:
     28  10000 ????						;   The inner .Line loop is UNCONDITIONAL — no per-scanline branches for
     29  10000 ????						;   sprite visibility. The player check uses a compare+branch that costs
     30  10000 ????						;   16c (off-screen) or 19c (on-screen), both well within the 76-cycle
     31  10000 ????						;   budget. PF registers are written once per tile row, not per scanline.
     32  10000 ????						; ==============================================================================
     33  10000 ????
     34  10000 ????						; --- TIA write addresses ---
     35  10000 ????		00 00	    VSYNC      =	$00
     36  10000 ????		00 01	    VBLANK     =	$01
     37  10000 ????		00 02	    WSYNC      =	$02
     38  10000 ????		00 04	    NUSIZ0     =	$04
     39  10000 ????		00 05	    NUSIZ1     =	$05
     40  10000 ????		00 06	    COLUP0     =	$06
     41  10000 ????		00 07	    COLUP1     =	$07
     42  10000 ????		00 08	    COLUPF     =	$08
     43  10000 ????		00 09	    COLUBK     =	$09
     44  10000 ????		00 0a	    CTRLPF     =	$0A
     45  10000 ????		00 0b	    REFP0      =	$0B
     46  10000 ????		00 0c	    REFP1      =	$0C
     47  10000 ????		00 0d	    PF0        =	$0D
