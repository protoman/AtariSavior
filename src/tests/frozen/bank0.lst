   4064  fd7c							; ------------------------------------------------------------------------------
   4065  fd7c							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   4066  fd7c							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   4067  fd7c							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   4068  fd7c							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   4069  fd7c							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   4070  fd7c							; DeriveEnemyY — no persistent movement state exists in RAM.
   4071  fd7c							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   4072  fd7c							; block after the pads; pre-pad headroom is 1B).
   4073  fd7c							; ------------------------------------------------------------------------------
   4074  fd7c				   RefreshEnemyY
   4075  fd7c
   4076  fd7c		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   4077  fd7e							; TickCounter is the 60-frame GAME timer
   4078  fd7e							; (decrements 60->1, reloads) — gates derived
   4079  fd7e							; from it wrapped every second (spider
   4080  fd7e							; "teleported": (TC>>3)&63 only ever saw
   4081  fd7e							; 0..7 and counted DOWN 0->7 = jump).
   4082  fd7e		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   4083  fd80		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   4084  fd82				   .REYLoop		; every reader runs after refresh completes)
   4085  fd82		       ca		      dex
   4086  fd83		       20 95 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   4087  fd86		       95 e2		      sta	EnemyRamY,X
   4088  fd88		       8a		      txa		; N/Z must come from X: flags after jsr are
   4089  fd89		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   4090  fd8b				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   4091  fd8b							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   4092  fd8b							; black rooms, broken PF, invisible sprites)
   4093  fd8b							; --- SELECT or RESET held → back to the old title / level-select screen
   4094  fd8b							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   4095  fd8b							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   4096  fd8b							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   4097  fd8b							;     through TitleWork RESET, level-triggered here) cannot bounce back
   4098  fd8b							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   4099  fd8b							;     RESET held past LANDING still re-fires — press must be released
   4100  fd8b							;     before the drop-in finishes. ---
   4101  fd8b		       a5 8a		      lda	DropTarget
   4102  fd8d		       d0 1d		      bne	.REYRts	; not idle: not ours
