   4272  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   4273  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   4274  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   4275  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   4276  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   4277  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   4278  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   4279  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   4280  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   4281  fe9c							; ------------------------------------------------------------------------------
   4282  fe9c				   TallyWork
   4283  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   4284  fe9f		       a8		      tay
   4285  fea0		       29 01		      and	#1
   4286  fea2		       f0 05		      beq	.TNoScore
   4287  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4288  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4289  fea9				   .TNoScore
   4290  fea9		       98		      tya
   4291  feaa		       29 04		      and	#4
   4292  feac		       f0 1e		      beq	.TLive
   4293  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4294  feb0		       a5 a3		      lda	Level
   4295  feb2		       c9 04		      cmp	#LEVEL_COUNT
   4296  feb4		       d0 04		      bne	.TNotWrap
   4297  feb6		       a9 00		      lda	#0	; wrap past last level
   4298  feb8		       85 a3		      sta	Level
   4299  feba				   .TNotWrap
   4300  feba		       a9 00		      lda	#0
   4301  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4302  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4303  febe							;   pose ($FE must take the real-fall path)
   4304  febe		       20 20 fc 	      jsr	LoadLevel
   4305  fec1		       a9 78		      lda	#120	; reset timer for new level
   4306  fec3		       85 ae		      sta	BarLevel
   4307  fec5		       a9 3c		      lda	#60
   4308  fec7		       85 ad		      sta	TickCounter
   4309  fec9		       4c 35 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4310  fecc				   .TLive
   4311  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   4312  fecf		       a9 00		      lda	#0
   4313  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   4314  fed3				   .TWait
   4315  fed3		       ad 84 02 	      lda	INTIM
   4316  fed6		       d0 fb		      bne	.TWait
   4317  fed8		       4c 39 f0 	      jmp	StartFrame
   4318  fedb
