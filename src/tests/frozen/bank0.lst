   2128  f612							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2129  f612							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2130  f612							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2131  f612							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2132  f612							; ------------------------------------------------------------------------------
   2133  f612				   UEDispatch
   2134  f612		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2135  f614							;   the single type-compare entry. 2026-10-22:
   2136  f614							;   a raft authored dir=right read $87, missed
   2137  f614							;   `cmp #ENEMY_RAFT` and its body never ran
   2138  f614							;   (no tide, no motion, no rider pin).
   2139  f614		       c9 07		      cmp	#ENEMY_RAFT
   2140  f616		       d0 06		      bne	.UEDNotRaft
   2141  f618		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2142  f61b		       4c 3b f4 	      jmp	UE_Next
   2143  f61e				   .UEDNotRaft
   2144  f61e		       c9 03		      cmp	#ENEMY_TENTACLE
   2145  f620		       d0 03		      bne	.UEDNotTent
   2146  f622		       4c 40 f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2147  f625				   .UEDNotTent
   2148  f625		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2149  f627		       d0 03		      bne	.UEDNotMoth
   2150  f629		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2151  f62c				   .UEDNotMoth
