    928  f14d		       c8		      iny		;   this line — advance running Y, then blank
    929  f14e		       4c 6b f1 	      jmp	.GrpZero	;   GRP0 for the next line. Relocated here
    930  f151							;   (was inline after sta ENAM0) so the color
