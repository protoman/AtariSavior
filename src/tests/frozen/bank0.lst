   3511  ff08		       f0		      .byte.b	%11110000	; right 1
   3512  ff09		       e0		      .byte.b	%11100000	; right 2
   3513  ff0a		       d0		      .byte.b	%11010000	; right 3
   3514  ff0b		       c0		      .byte.b	%11000000	; right 4
   3515  ff0c		       b0		      .byte.b	%10110000	; right 5
