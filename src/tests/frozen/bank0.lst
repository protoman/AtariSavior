   2672  f80f		       49 01		      eor	#1
   2673  f811		       aa		      tax
   2674  f812		       c5 b3		      cmp	EnemyCount
   2675  f814		       b0 0c		      bcs	.SOSkipNone	; no such enemy
   2676  f816		       a5 ba		      lda	EnemyDeadMask
   2677  f818		       3d c9 f3 	      and	EnemyBitTable,X
   2678  f81b		       d0 05		      bne	.SOSkipNone	; partner dead too
   2679  f81d		       86 b9		      stx	EnemyIndex
   2680  f81f		       4c f0 f6 	      jmp	.SOEnemyLive
   2681  f822				   .SOSkipNone
   2682  f822		       a9 ff		      lda	#$FF
