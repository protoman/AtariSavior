   1689  f4e1		       29 0f		      and	#$0f	; down = low nibble
   1690  f4e3		       c9 0f		      cmp	#$0f
   1691  f4e5		       f0 07		      beq	.NoDown
   1692  f4e7		       20 d0 fb 	      jsr	EnterRoom
   1693  f4ea		       a9 00		      lda	#PLAYER_MIN_Y
