    997  f184							; ==============================================================================
    998  f184							; HUD band: 48 scanlines (144-191)
    999  f184							; Uses 13+2 sprite technique via bank1 (fold-pad trampoline)
   1000  f184							; ==============================================================================
   1001  f184
   1002  f184							; --- Call bank1 for 13+2 HUD rendering via fold-pad at $FC68 ---
   1003  f184							; The fold-pad at $FC68 has identical bytes in bank0 and bank1:
   1004  f184							;   $FC68: lda #1 / sta $1FF7 / jmp $F540
   1005  f184							; After sta $1FF7, CPU reads next instruction from bank1 at $FC6D.
   1006  f184							; Bank1's $FC6D has the same jmp $F540 → seamless bank switch.
   1007  f184		       4c 68 fc 	      jmp	$FC68	; jump to fold-pad (switches to bank1, runs MenuMain)
   1008  f187							; Bank1's MenuMain returns to bank0 via: lda #0 / sta $1FF6 / jmp Overscan
   1009  f187
   1010  f187							; ==============================================================================
   1011  f187							; Overscan (30 scanlines) — input handling + game logic
   1012  f187							; ==============================================================================
   1013  f187				   Overscan
   1014  f187		       a9 02		      lda	#2
