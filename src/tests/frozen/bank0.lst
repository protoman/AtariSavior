    490  f039							; ==============================================================================
    491  f039							; Frame loop
    492  f039							; ==============================================================================
    493  f039				   StartFrame
    494  f039
    495  f039							; ------------------------------------------------------------------------------
    496  f039							; VSYNC (3 scanlines)
    497  f039							; ------------------------------------------------------------------------------
    498  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    499  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    500  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    501  f039							; does not advance the wall clock to the next scanline boundary (it is already
    502  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    503  f039							; fraction depends on where the previous frame's overscan happened to end) —
    504  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    505  f039							;
    506  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    507  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    508  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    509  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    510  f039							; the sim wall-model target is updated to match.
    511  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    512  f03b		       a9 02		      lda	#2
    513  f03d		       85 00		      sta	VSYNC
    514  f03f		       85 02		      sta	WSYNC
    515  f041		       85 02		      sta	WSYNC
    516  f043		       85 02		      sta	WSYNC
    517  f045		       a9 00		      lda	#0
    518  f047		       85 00		      sta	VSYNC
    519  f049
    520  f049							; ------------------------------------------------------------------------------
    521  f049							; VBLANK (37 scanlines)
    522  f049							; ------------------------------------------------------------------------------
    523  f049		       a9 02		      lda	#2
    524  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    525  f04d
    526  f04d							; --- Set TIM64T for VBLANK ---
    527  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    528  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    529  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    530  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    531  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    532  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    533  f04d							; Worst 1059c of the 1472c window = 413c margin.
    534  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    535  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    536  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    537  f04d		       a9 17		      lda	#23
    538  f04f		       8d 96 02 	      sta	TIM64T
    539  f052
    540  f052							; --- Position player sprite horizontally ---
    541  f052		       a5 80		      lda	RoomX
    542  f054		       38		      sec
    543  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    544  f057		       a2 00		      ldx	#0	; X=0 = player0
    545  f059		       20 0f ff 	      jsr	SetObjectXPos
    546  f05c
    547  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    548  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    549  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    550  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    551  f05c
    552  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    553  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    554  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    555  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    556  f05c
    557  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    558  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    559  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    560  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    561  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    562  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    563  f05c		       20 12 f6 	      jsr	SelectActiveObject
    564  f05f
    565  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    566  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    567  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    568  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    569  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    570  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    571  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    572  f062
    573  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    574  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    575  f062							; 2026-10-04 up-exit fix). The
    576  f062							; old per-frame VBL fold that re-read the same ROM byte is
    577  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    578  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    579  f062							; the VBL path (the read that made a bank3 data move need another
    580  f062							; reader). test_band_restage covers the contract.
    581  f062
    582  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    583  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    584  f062							; Dark room: black except the existing explosion blink (state=2).
    585  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    586  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    587  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    588  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    589  f062		       a5 b5		      lda	BombPacked
    590  f064		       29 03		      and	#%00000011
    591  f066		       c9 02		      cmp	#2
    592  f068		       f0 0a		      beq	.BgBlink
    593  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    594  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    595  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    596  f071		       4c 84 f0 	      jmp	.BgStore
    597  f074				   .BgBlink
    598  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    599  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    600  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    601  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    602  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    603  f074		       a9 3c		      lda	#60
    604  f076		       38		      sec
    605  f077		       e5 f7		      sbc	BombTimer
    606  f079		       29 03		      and	#3
    607  f07b		       a8		      tay
    608  f07c		       b9 de f5 	      lda	BombBlinkColors,Y
    609  f07f		       4c 84 f0 	      jmp	.BgStore
    610  f082				   .BgIdle
    611  f082		       a9 00		      lda	#COLOR_CAVE_BG
    612  f084				   .BgStore
