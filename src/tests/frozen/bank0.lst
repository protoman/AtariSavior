   2201  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2202  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2203  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2204  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2205  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2206  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2207  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2208  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2209  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2210  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2211  f980							; before — same ZP, no new allocation).
   2212  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2213  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2214  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2215  f980		       a5 8d		      lda	CollisionCellY
   2216  f982		       85 92		      sta	RectCount
   2217  f984				   .CWRow
   2218  f984		       a5 8e		      lda	CollisionEndX
   2219  f986		       85 8b		      sta	CollisionX
   2220  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2221  f989							;   was re-loaded every cell — −8c/cell walk
   2222  f989							;   trim for the falling+probe heavy frame)
   2223  f989				   .CWCol
   2224  f989		       a4 92		      ldy	RectCount
   2225  f98b		       98		      tya
   2226  f98c		       18		      clc
   2227  f98d		       7d a8 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2228  f990		       a8		      tay
   2229  f991		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2230  f994		       3d bc fd 	      and	ColMask,X	; bit for this source col
   2231  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2232  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2233  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2234  f99d		       e8		      inx
   2235  f99e		       86 8b		      stx	CollisionX
   2236  f9a0		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
   2237  f9a2				   .CWRowDone
   2238  f9a2		       a5 92		      lda	RectCount
   2239  f9a4		       c5 8f		      cmp	CollisionEndY	; row == bottom?
   2240  f9a6		       f0 07		      beq	.CWNoHit
   2241  f9a8		       e6 92		      inc	RectCount
   2242  f9aa		       d0 d8		      bne	.CWRow	; always (row never wraps to 0)
   2243  f9ac				   .CWHit
   2244  f9ac		       4c ec ff 	      jmp	HotOverlapFlag	; C=1 contract; hot rects unchanged (ROM stream)
   2245  f9af				   .CWNoHit
