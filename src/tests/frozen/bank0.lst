   1586  f481							; ------------------------------------------------------------------------------
   1587  f481							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1588  f481							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1589  f481							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1590  f481							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1591  f481							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1592  f481							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1593  f481							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1594  f481							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1595  f481							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1596  f481							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1597  f481							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1598  f481							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1599  f481							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1600  f481							; ------------------------------------------------------------------------------
   1601  f481				   UE_Tentacle
   1602  f481		       a5 ad		      lda	TickCounter
   1603  f483		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1604  f485							; = half the player's 1 px/frame (user
   1605  f485							; 2026-10-10: &3 read as chunky/slow)
   1606  f485		       d0 4b		      bne	.TentOut
   1607  f487		       b5 bd		      lda	EnemyRamX,X
   1608  f489		       c5 80		      cmp	RoomX
   1609  f48b		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1610  f48d		       90 06		      bcc	.TentRight
   1611  f48f		       38		      sec
   1612  f490		       e9 01		      sbc	#1	; step left
   1613  f492		       4c 98 f4 	      jmp	.TentProbe
   1614  f495				   .TentRight
   1615  f495		       18		      clc
   1616  f496		       69 01		      adc	#1	; step right
   1617  f498				   .TentProbe
   1618  f498		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1619  f49a		       b0 36		      bcs	.TentOut
   1620  f49c		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1621  f49e							; Same-column cull: committed X is always probe-clear, so a candidate in
   1622  f49e							; the same 4px column covers the same collision cells → result is known
   1623  f49e							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1624  f49e		       a5 88		      lda	Temp
   1625  f4a0		       55 bd		      eor	EnemyRamX,X
   1626  f4a2		       29 fc		      and	#$FC
   1627  f4a4		       f0 28		      beq	.TentCommit
   1628  f4a6		       a5 80		      lda	RoomX
   1629  f4a8		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1630  f4aa		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1631  f4ac		       85 b8		      sta	ActiveObjectY
   1632  f4ae		       a5 88		      lda	Temp
   1633  f4b0		       c9 05		      cmp	#5
   1634  f4b2		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1635  f4b4							; PHM's negative visible-left wraps to 255
   1636  f4b4							; (col garbage / ColOff OOB walk). cand<=4
   1637  f4b4							; ink pokes off-screen anyway; RoomX=cand
