   1391  f36e				   .SDAir
   1392  f36e		       a5 b5		      lda	BombPacked
   1393  f370		       29 7f		      and	#%01111111	; still falling — not ground
   1394  f372		       85 b5		      sta	BombPacked
   1395  f374		       60		      rts
   1396  f375				   .SDBottom
   1397  f375		       20 d9 fb 	      jsr	ExitRoomDown
