   1513  f425							; ------------------------------------------------------------------------------
   1514  f425							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1515  f425							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1516  f425							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1517  f425							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1518  f425							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1519  f425							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1520  f425							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1521  f425							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1522  f425							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1523  f425							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1524  f425							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1525  f425							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1526  f425							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1527  f425							; ------------------------------------------------------------------------------
   1528  f425				   UE_Tentacle
   1529  f425		       a5 ad		      lda	TickCounter
   1530  f427		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1531  f429							; = half the player's 1 px/frame (user
   1532  f429							; 2026-10-10: &3 read as chunky/slow)
   1533  f429		       d0 4b		      bne	.TentOut
   1534  f42b		       b5 bd		      lda	EnemyRamX,X
   1535  f42d		       c5 80		      cmp	RoomX
   1536  f42f		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1537  f431		       90 06		      bcc	.TentRight
   1538  f433		       38		      sec
   1539  f434		       e9 01		      sbc	#1	; step left
   1540  f436		       4c 3c f4 	      jmp	.TentProbe
   1541  f439				   .TentRight
   1542  f439		       18		      clc
   1543  f43a		       69 01		      adc	#1	; step right
   1544  f43c				   .TentProbe
   1545  f43c		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1546  f43e		       b0 36		      bcs	.TentOut
   1547  f440		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1548  f442							; Same-column cull: committed X is always probe-clear, so a candidate in
   1549  f442							; the same 4px column covers the same collision cells → result is known
   1550  f442							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1551  f442		       a5 88		      lda	Temp
   1552  f444		       55 bd		      eor	EnemyRamX,X
   1553  f446		       29 fc		      and	#$FC
   1554  f448		       f0 28		      beq	.TentCommit
   1555  f44a		       a5 80		      lda	RoomX
   1556  f44c		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1557  f44e		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1558  f450		       85 b8		      sta	ActiveObjectY
   1559  f452		       a5 88		      lda	Temp
   1560  f454		       c9 05		      cmp	#5
   1561  f456		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1562  f458							; PHM's negative visible-left wraps to 255
   1563  f458							; (col garbage / ColOff OOB walk). cand<=4
   1564  f458							; ink pokes off-screen anyway; RoomX=cand
   1565  f458							; already covers cell0.
   1566  f458		       38		      sec
   1567  f459		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1568  f45b							; sits 5/7 px left of A (moth .Mvl convention,
   1569  f45b							; bank2), but PHM's PLAYER prologue derives
   1570  f45b							; lit-left = arg-4/arg-7 with the bin on
   1571  f45b							; RoomX-PlayerDir → box missed the cell left
   1572  f45b							; of the ink at cand 8/12 (sprite drew 1 px
   1573  f45b							; into the wall — bugs.md #4). cand-1 shifts
   1574  f45b							; the tested box 1 px left: cell-exact or 1 px
   1575  f45b							; conservative for every cand/facing pair
   1576  f45b							; (tools/test_cell_map.py tentacle section).
   1577  f45b				   .TentProbeX
   1578  f45b		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1579  f45d		       b5 e2		      lda	EnemyRamY,X
   1580  f45f		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1581  f461		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1582  f463							; (rect walk ldx/dex/tax) — slot was lost here
   1583  f463		       20 26 f9 	      jsr	PlayerHitsMap
   1584  f466		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1585  f468		       a5 b8		      lda	ActiveObjectY
   1586  f46a		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1587  f46c		       a5 b7		      lda	ActiveObjectX
   1588  f46e		       85 80		      sta	RoomX	; restore player X
   1589  f470		       b0 04		      bcs	.TentOut	; wall → hold position
   1590  f472				   .TentCommit
   1591  f472		       a5 88		      lda	Temp
   1592  f474		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1593  f476				   .TentOut
   1594  f476		       4c 20 f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1595  f479
   1596  f479							; ------------------------------------------------------------------------------
   1597  f479							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1598  f479							; there is no free ZP byte for per-slot movement state (phase/direction live
   1599  f479							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1600  f479							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1601  f479							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1602  f479							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1603  f479							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1604  f479							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1605  f479							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1606  f479							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1607  f479							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1608  f479							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1609  f479							;	    the 60-frame game timer — gates from it wrap every second).
   1610  f479							; Other types: straight ROM y (their movement stages come later).
   1611  f479							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1612  f479							; ------------------------------------------------------------------------------
   1613  f479				   DeriveEnemyY
   1614  f479							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1615  f479							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1616  f479		       a5 b1		      lda	EnemyDataLo
   1617  f47b		       85 e5		      sta	FetchPtr
   1618  f47d		       a5 b2		      lda	EnemyDataHi
   1619  f47f		       85 e6		      sta	FetchPtr+1
   1620  f481		       bc b2 f9 	      ldy	EnemyOffTable,X
   1621  f484		       20 f6 fe 	      jsr	FoldIndirect	; type
   1622  f487		       c9 01		      cmp	#ENEMY_BAT
   1623  f489		       f0 18		      beq	.DEYTickNoShift
   1624  f48b		       c9 03		      cmp	#ENEMY_TENTACLE
   1625  f48d		       f0 1a		      beq	.DEYTickShift
   1626  f48f		       c9 00		      cmp	#ENEMY_SPIDER
   1627  f491		       f0 2e		      beq	.DEYSpiderTick
   1628  f493		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1629  f495		       d0 06		      bne	.DEYStatic
   1630  f497		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1631  f49a		       4c b6 f4 	      jmp	DEYDelta
   1632  f49d				   .DEYStatic
   1633  f49d		       c8		      iny
   1634  f49e		       c8		      iny
   1635  f49f		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1636  f4a2		       60		      rts
   1637  f4a3				   .DEYTickNoShift
