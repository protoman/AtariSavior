   1895  f4fa							; ==============================================================================
   1896  f4fa							; Room exit handlers — check connection table, switch rooms, reposition player
   1897  f4fa							; ==============================================================================
   1898  f4fa							; ------------------------------------------------------------------------------
   1899  f4fa							; C3 (2026-10-20): the four handlers MOVED to bank2 ($FC4F cluster) — the
   1900  f4fa							; connection table is level data in bank2, so each handler now reads its own
   1901  f4fa							; 2-byte conn record directly (bank1 GetConnIdx + FoldIndirect hops gone).
   1902  f4fa							; bank0 keeps only the entry pads at $FBD9-$FBE4 (3 B each, `sta $1FF6`;
   1903  f4fa							; bank2 serves the `jmp` at A+3). The OPPOSITE-EDGE placement is written
   1904  f4fa							; BEFORE `jmp EnterRoomB2`, because EnterRoom never touches RoomX/RoomY
   1905  f4fa							; (checked: EnterRoomB2 + B3RoomBlocks read neither) — that keeps the whole
   1906  f4fa							; tail in bank2 with 0 pushes: EnterRoomB2's `jmp ReturnPad` pops the
   1907  f4fa							; ORIGINAL `jsr ExitRoomXxx` frame, exactly like the old in-bank return.
   1908  f4fa							; Guard: verify_build.CORRIDOR_PADS (4 pads) + check_exit_handlers (edge
   1909  f4fa							; placement precedes the EnterRoomB2 tail; no-exit path ends in ReturnPad).
   1910  f4fa							; ------------------------------------------------------------------------------
   1911  f4fa
   1912  f4fa							; ==============================================================================
   1913  f4fa							; Level management
   1914  f4fa							; ==============================================================================
   1915  f4fa							; LoadLevel MOVED to bank2 (C2, 2026-10-20) — body = LoadLevelB2 ($F640).
   1916  f4fa							; The level index/table lives in bank2 (level data), so the old body paid 7
   1917  f4fa							; `jsr FoldIndirect` (7 x 25c + 14 bank switches) to read a 7-byte entry that
   1918  f4fa							; an in-bank (FetchPtr),Y read now fetches directly. Both halves are split
   1919  f4fa							; pads (same discipline as CallPad_SelectObject):
   1920  f4fa							;   A=$FC20  CallPad_LoadLevel / LoadLevel: `sta $1FF6`   (bank0 runs this)
   1921  f4fa							;   A+3=$FC23	bank2 `jmp LoadLevelB2` 		   (fetched after it)
   1922  f4fa							;   body tail `jmp $FC26` -> bank2 `sta $1FF4` at $FC26 -> the fetch at $FC29
   1923  f4fa							;   comes from HERE: `jmp LF_B0Tail`, i.e. the drop-in tail (EnterRoom call,
   1924  f4fa							;   level-start placement, `jmp DropArm`) stays in bank0 so the call chain and
   1925  f4fa							;   the measured stack depth are UNCHANGED (0 extra jsr levels, 0 pushes).
   1926  f4fa							; Entry layout: stride 7 = miner_room (b7 = faces right), miner_x, wall color,
   1927  f4fa							; wall color 2, block base word (RoomShapes), room count n (the RoomPositions
   1928  f4fa							; /RoomCounts/enemy-record bases are that block's +n/+2n/+3n offsets, C2).
   1929  f4fa							; Guards: verify_build.check_callpads pins the entry pad bytes + operand,
   1930  f4fa							; check_loadlevel_tramp pins the return half; tools/test_respawn_hover.py,
   1931  f4fa							; test_room_dark.py and test_level_bank.py read the bank2 body.
   1932  f4fa
   1933  f4fa							; ==============================================================================
   1934  f4fa							; Miner pickup — check if player overlaps miner, advance to next level
   1935  f4fa							; ==============================================================================
   1936  f4fa				   CheckMinerPickup
   1937  f4fa		       a5 a4		      lda	LevelMinerRoom
   1938  f4fc		       29 7f		      and	#$7f
   1939  f4fe		       c5 98		      cmp	RoomNo
   1940  f500		       d0 1b		      bne	.CMPDone	; not in miner's room
   1941  f502							; X overlap: player [RoomX, +6] vs 4px miner.
   1942  f502							; Accept iff RoomX - MinerX in [-6, +3].
   1943  f502		       a5 80		      lda	RoomX
   1944  f504		       38		      sec
   1945  f505		       e5 a5		      sbc	MinerX
   1946  f507		       18		      clc
   1947  f508		       69 06		      adc	#PLAYER_WIDTH - 1
   1948  f50a		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1949  f50c		       b0 0f		      bcs	.CMPDone	; no X overlap
   1950  f50e							; Y overlap: player [RoomY, +11] vs miner [MinerY, +11]
   1951  f50e							; accept iff RoomY - MinerY in [-11, +11]  (add 11, compare 23)
   1952  f50e		       a5 81		      lda	RoomY
   1953  f510		       38		      sec
   1954  f511		       e5 a6		      sbc	MinerY
   1955  f513		       18		      clc
   1956  f514		       69 15		      adc	#PLAYER_SPRITE_H - 1
   1957  f516		       c9 2b		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1958  f518		       b0 03		      bcs	.CMPDone	; no Y overlap
   1959  f51a							; Pickup! Arm the level-bonus tally (frozen count-up, then advance).
   1960  f51a							; TallyArm (bank2, via TallyTramp) snapshots time/bombs/lives into
   1961  f51a							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
   1962  f51a							; TallyWork, whose done path does the old tail (level++/LoadLevel/bar).
   1963  f51a		       20 98 f9 	      jsr	RescuePrimary	; clears the primary's bit; the tally runs only when
   1964  f51d							;   it was the last miner (RescuePrimary/MinerRescued)
   1965  f51d				   .CMPDone
   1966  f51d		       60		      rts
