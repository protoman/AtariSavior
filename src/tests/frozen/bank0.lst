   1738  f4de		       d0 1b		      bne	.CMPDone	; not in miner's room
   1739  f4e0							; X overlap: player [RoomX, +6] vs 4px miner.
   1740  f4e0							; Accept iff RoomX - MinerX in [-6, +3].
   1741  f4e0		       a5 80		      lda	RoomX
   1742  f4e2		       38		      sec
   1743  f4e3		       e5 a5		      sbc	MinerX
   1744  f4e5		       18		      clc
   1745  f4e6		       69 06		      adc	#PLAYER_WIDTH - 1
