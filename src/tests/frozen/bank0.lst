   2666  f945							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2667  f945							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2668  f945							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2669  f945							; into them), so room complexity is unbounded and geometry parity is proven
   2670  f945							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2671  f945							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2672  f945							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2673  f945							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2674  f945							; mirror; bank2 display-space walkers add their own when they convert).
   2675  f945							; RectCount = running row, CollisionX = running col (both were walk temps
   2676  f945							; before — same ZP, no new allocation).
   2677  f945							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2678  f945							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2679  f945							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2680  f945		       a5 8d		      lda	CollisionCellY
   2681  f947		       85 92		      sta	RectCount
   2682  f949				   .CWRow
   2683  f949		       a5 8e		      lda	CollisionEndX
   2684  f94b		       85 8b		      sta	CollisionX
   2685  f94d		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2686  f94e							;   was re-loaded every cell — −8c/cell walk
   2687  f94e							;   trim for the falling+probe heavy frame)
