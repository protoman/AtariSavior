   4049  ff00							; ==============================================================================
   4050  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   4051  ff00							; ==============================================================================
   4052  ff00					      org	$FF00
   4053  ff00				   fineAdjustBegin
   4054  ff00		       70		      .byte.b	%01110000	; left 7
   4055  ff01		       60		      .byte.b	%01100000	; left 6
   4056  ff02		       50		      .byte.b	%01010000	; left 5
   4057  ff03		       40		      .byte.b	%01000000	; left 4
   4058  ff04		       30		      .byte.b	%00110000	; left 3
   4059  ff05		       20		      .byte.b	%00100000	; left 2
   4060  ff06		       10		      .byte.b	%00010000	; left 1
   4061  ff07		       00		      .byte.b	%00000000	; no movement
   4062  ff08		       f0		      .byte.b	%11110000	; right 1
   4063  ff09		       e0		      .byte.b	%11100000	; right 2
   4064  ff0a		       d0		      .byte.b	%11010000	; right 3
   4065  ff0b		       c0		      .byte.b	%11000000	; right 4
   4066  ff0c		       b0		      .byte.b	%10110000	; right 5
   4067  ff0d		       a0		      .byte.b	%10100000	; right 6
   4068  ff0e		       90		      .byte.b	%10010000	; right 7
   4069  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
