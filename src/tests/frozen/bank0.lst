   3335  fd5e		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3336  fd60		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3337  fd62		       f0 0e		      beq	.TWmusic
