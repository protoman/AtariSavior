    491  f039							; ==============================================================================
    492  f039							; Frame loop
    493  f039							; ==============================================================================
    494  f039				   StartFrame
    495  f039
    496  f039							; ------------------------------------------------------------------------------
    497  f039							; VSYNC (3 scanlines)
    498  f039							; ------------------------------------------------------------------------------
    499  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    500  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    501  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    502  f039							; does not advance the wall clock to the next scanline boundary (it is already
    503  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    504  f039							; fraction depends on where the previous frame's overscan happened to end) —
    505  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    506  f039							;
    507  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    508  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    509  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    510  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    511  f039							; the sim wall-model target is updated to match.
    512  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    513  f03b		       a9 02		      lda	#2
    514  f03d		       85 00		      sta	VSYNC
    515  f03f		       85 02		      sta	WSYNC
    516  f041		       85 02		      sta	WSYNC
    517  f043		       85 02		      sta	WSYNC
    518  f045		       a9 00		      lda	#0
    519  f047		       85 00		      sta	VSYNC
    520  f049
    521  f049							; ------------------------------------------------------------------------------
    522  f049							; VBLANK (37 scanlines)
    523  f049							; ------------------------------------------------------------------------------
    524  f049		       a9 02		      lda	#2
    525  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    526  f04d
    527  f04d							; --- Set TIM64T for VBLANK ---
    528  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    529  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    530  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    531  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    532  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    533  f04d		       a9 17		      lda	#23
    534  f04f		       8d 96 02 	      sta	TIM64T
    535  f052
    536  f052							; --- Position player sprite horizontally ---
    537  f052		       a5 80		      lda	RoomX
    538  f054		       38		      sec
    539  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    540  f057		       a2 00		      ldx	#0	; X=0 = player0
    541  f059		       20 0f ff 	      jsr	SetObjectXPos
    542  f05c
    543  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    544  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    545  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    546  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    547  f05c
    548  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    549  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    550  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    551  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    552  f05c
    553  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    554  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    555  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    556  f05c		       20 d5 f5 	      jsr	SelectActiveObject
    557  f05f
    558  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    559  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    560  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    561  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    562  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    563  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    564  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    565  f062
    566  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    567  f062							; EnterRoomB2 (byte +1 of the 2-byte RoomEnemies record since C2, which
    568  f062							; replaced the 4-byte per-room record; the 2026-10-04 up-exit fix). The
    569  f062							; old per-frame VBL fold that re-read the same ROM byte is
    570  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    571  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    572  f062							; the VBL path (the read that made a bank3 data move need another
    573  f062							; reader). test_band_restage covers the contract.
    574  f062
    575  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    576  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    577  f062							; Dark room: black except the existing explosion blink (state=2).
    578  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    579  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    580  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    581  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    582  f062		       a5 b5		      lda	BombPacked
    583  f064		       29 03		      and	#%00000011
    584  f066		       c9 02		      cmp	#2
    585  f068		       f0 0a		      beq	.BgBlink
    586  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    587  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    588  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    589  f071		       4c 84 f0 	      jmp	.BgStore
    590  f074				   .BgBlink
    591  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    592  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    593  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    594  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    595  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    596  f074		       a9 3c		      lda	#60
    597  f076		       38		      sec
    598  f077		       e5 f7		      sbc	BombTimer
    599  f079		       29 03		      and	#3
    600  f07b		       a8		      tay
    601  f07c		       b9 e8 f7 	      lda	BombBlinkColors,Y
    602  f07f		       4c 84 f0 	      jmp	.BgStore
    603  f082				   .BgIdle
    604  f082		       a9 00		      lda	#COLOR_CAVE_BG
    605  f084				   .BgStore
    606  f084		       85 09		      sta	COLUBK
    607  f086
    608  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    609  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    610  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    611  f086							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    612  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    613  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    614  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    615  f086		       20 c1 f9 	      jsr	PositionBallM1
    616  f089
    617  f089							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    618  f089							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    619  f089							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    620  f089							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    621  f089							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    622  f089							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    623  f089							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    624  f089							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    625  f089		       a5 c2		      lda	EnemyRamP
    626  f08b		       29 f0		      and	#$F0
    627  f08d		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    628  f08f		       4a		      lsr
    629  f090		       4a		      lsr
    630  f091		       4a		      lsr
    631  f092		       4a		      lsr		; A = p (1..15)
    632  f093		       c9 08		      cmp	#8
    633  f095		       90 04		      bcc	.TideTri
    634  f097		       a9 00		      lda	#0	; rest phase p8-15
    635  f099		       f0 09		      beq	.TideBase	; always
    636  f09b				   .TideTri
    637  f09b		       c9 04		      cmp	#4
    638  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    639  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    640  f0a1		       38		      sec
    641  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
    642  f0a4				   .TideBase
    643  f0a4		       18		      clc
    644  f0a5		       69 24		      adc	#36
    645  f0a7		       85 8b		      sta	CollisionX
