   4242  fea2		       f0 05		      beq	.TNoScore
   4243  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4244  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4245  fea9				   .TNoScore
   4246  fea9		       98		      tya
