   1840  f57c		       85 f0		      sta	PlayerBombs
   1841  f57e		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the boot
   1842  f580		       c9 fd		      cmp	#$FD	; intro call ($FD = attract pending — TallyTicks
   1843  f582		       f0 04		      beq	.NoBanner	; alias must stay 0 for the intro phase machine)
   1844  f584		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1845  f586		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
