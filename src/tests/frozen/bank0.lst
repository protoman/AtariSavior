   2650  f805							; SOSkipTail — the rotation slot picked a DEAD enemy (or a taken key). It used
   2651  f805							; to draw nothing, so the survivor showed only every 2nd frame: kill the enemy
   2652  f805							; next to the miner and the MINER started flickering (user 2026-10-25), and a
   2653  f805							; two-enemy room flickered its survivor. Hand the slot on instead:
   2654  f805							;   1. the miner is here -> draw the miner (every frame once the enemy is gone);
   2655  f805							;   2. else the room's other enemy (index ^ 1) if it exists and is alive;
   2656  f805							;   3. else nothing.
   2657  f805							; Terminates: step 2 jumps into the live path only for a LIVE partner, and a
   2658  f805							; taken key can re-enter here only once per frame (its partner is then dead).
   2659  f805							; ------------------------------------------------------------------------------
   2660  f805				   SOSkipTail
   2661  f805		       a5 a4		      lda	LevelMinerRoom
   2662  f807		       29 7f		      and	#$7f
   2663  f809		       c5 98		      cmp	RoomNo
   2664  f80b		       d0 03		      bne	.SOSkipOther
   2665  f80d		       4c bf f6 	      jmp	.SOMinerDraw
   2666  f810				   .SOSkipOther
   2667  f810		       a5 b9		      lda	EnemyIndex
   2668  f812		       49 01		      eor	#1
   2669  f814		       aa		      tax
   2670  f815		       c5 b3		      cmp	EnemyCount
   2671  f817		       b0 0c		      bcs	.SOSkipNone	; no such enemy
   2672  f819		       a5 ba		      lda	EnemyDeadMask
   2673  f81b		       3d c9 f3 	      and	EnemyBitTable,X
   2674  f81e		       d0 05		      bne	.SOSkipNone	; partner dead too
   2675  f820		       86 b9		      stx	EnemyIndex
   2676  f822		       4c f8 f6 	      jmp	.SOEnemyLive
   2677  f825				   .SOSkipNone
   2678  f825		       a9 ff		      lda	#$FF
   2679  f827		       85 b6		      sta	ObjBase
   2680  f829		       4c 45 f7 	      jmp	.SODone
