   2006  f53e		       b9 bd 00 	      lda	EnemyRamX,Y
   2007  f541		       85 b7		      sta	ActiveObjectX
   2008  f543		       b9 e2 00 	      lda	EnemyRamY,Y
   2009  f546		       85 b8		      sta	ActiveObjectY
   2010  f548							; Broad object bounds; lamp gets its 4px lit-width check after Y overlap.
   2011  f548		       a5 80		      lda	RoomX
   2012  f54a		       38		      sec
   2013  f54b		       e5 b7		      sbc	ActiveObjectX
   2014  f54d		       18		      clc
