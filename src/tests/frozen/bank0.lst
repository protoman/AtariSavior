   4029  fd42		       f0 14		      beq	.TWrstDone
   4030  fd44		       ad 82 02 	      lda	SWCHB
   4031  fd47		       29 01		      and	#%00000001
   4032  fd49		       d0 0d		      bne	.TWrstDone
   4033  fd4b		       a9 00		      lda	#0
   4034  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   4035  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   4036  fd51		       85 f4		      sta	ScoreHu
   4037  fd53		       85 f5		      sta	ScoreTe
   4038  fd55		       20 20 fc 	      jsr	LoadLevel
