    492 U00bc							; ==============================================================================
    493 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    494 U00bc							; ==============================================================================
    495 U00bc							; Bank3 is the power-up bank. Its stub does:
    496 U00bc							;   lda #0 / sta $1FF4 → selects bank0
    497 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    498 U00bc							; ==============================================================================
    499  10000 ????				       seg	code
    500  f000					      org	$F000
    501  f000
    502  f000							; --- 5-byte bankswitching pad ---
    503  f000							; After bank3's stub selects us, CPU arrives here.
    504  f000							; We jump over the pad into the real init code.
    505  f000		       a9 00		      lda	#0
    506  f002		       8d f4 1f 	      sta	$1FF4	; ensure bank0 selected (idempotent)
    507  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    508  f008							; (NOT deletable: $F008 = GameStart is a
    509  f008							;  hardcoded cross-bank entry — bank1
    510  f008							;  stub `jmp $F008`; this jmp also keeps
    511  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    512  f008							;  fold-pad byte guard fires when it moves)
    513  f008							;  + F0xx landmarks fixed)
    514  f008
    515  f008				   GameStart
    516  f008		       78		      sei		; disable interrupts
    517  f009		       d8		      cld		; clear decimal mode
    518  f00a		       a2 ff		      ldx	#$FF
    519  f00c		       9a		      txs		; stack pointer = $FF
    520  f00d
    521  f00d							; --- Clear zero-page RAM ---
    522  f00d		       a9 00		      lda	#0
    523  f00f		       a2 80		      ldx	#$80
    524  f011				   .ClearZP
    525  f011		       95 00		      sta	$00,X
    526  f013		       e8		      inx
    527  f014		       d0 fb		      bne	.ClearZP
    528  f016
    529  f016							; --- Initialize game state --- (ClearZP left A = 0 and Level = 0)
    530  f016		       a9 03		      lda	#3
    531  f018		       85 ac		      sta	PlayerLives
    532  f01a		       a9 05		      lda	#BOMBS_MAX
    533  f01c		       85 f0		      sta	PlayerBombs
    534  f01e							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    535  f01e		       a9 3c		      lda	#60
    536  f020		       85 ad		      sta	TickCounter
    537  f022		       a9 78		      lda	#120
    538  f024		       85 ae		      sta	BarLevel	; bar starts full
    539  f026		       a9 00		      lda	#0
    540  f028		       20 08 fc 	      jsr	CallPad_SaveKey	; SaveKey BOOT: Level := the saved stage (the
    541  f02b							;   title then comes up on it); no key = no-op
    542  f02b							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    543  f02b							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    544  f02b							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    545  f02b							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    546  f02b							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    547  f02b		       a9 ff		      lda	#$FF
    548  f02d		       85 8a		      sta	DropTarget
    549  f02f
    550  f02f							; --- Load first level (the title previews it on the live stage:
    551  f02f							;     LoadLevel leaves the player at the level start, no flight) ---
    552  f02f		       20 20 fc 	      jsr	LoadLevel
    553  f032
    554  f032							; --- Set player color ---
    555  f032		       a9 48		      lda	#COLOR_PLAYER
    556  f034		       85 06		      sta	COLUP0
    557  f036
    558  f036							; --- Set playfield to reflected mode + priority ---
    559  f036							; D0=1 = reflect (left half mirrors to right)
    560  f036							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    561  f036							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    562  f036							; disabled at kernel entry, size only matters once Phase 3 enables it)
    563  f036		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    564  f038		       85 0a		      sta	CTRLPF
    565  f03a
    566  f03a							; ==============================================================================
    567  f03a							; Frame loop
    568  f03a							; ==============================================================================
    569  f03a				   StartFrame
    570  f03a
    571  f03a							; ------------------------------------------------------------------------------
    572  f03a							; VSYNC (3 scanlines)
    573  f03a							; ------------------------------------------------------------------------------
    574  f03a							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    575  f03a							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    576  f03a							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    577  f03a							; does not advance the wall clock to the next scanline boundary (it is already
    578  f03a							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    579  f03a							; fraction depends on where the previous frame's overscan happened to end) —
    580  f03a							; the whole screen shifted up 1 scanline on those frames = the jitter.
    581  f03a							;
    582  f03a							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    583  f03a							; the next scanline boundary (even if we were already at it — the store is 3c
    584  f03a							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    585  f03a							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    586  f03a							; the sim wall-model target is updated to match.
    587  f03a		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    588  f03c		       a9 02		      lda	#2
    589  f03e		       85 00		      sta	VSYNC
    590  f040		       85 02		      sta	WSYNC
    591  f042		       85 02		      sta	WSYNC
    592  f044		       85 02		      sta	WSYNC
    593  f046		       a9 00		      lda	#0
    594  f048		       85 00		      sta	VSYNC
    595  f04a
    596  f04a							; ------------------------------------------------------------------------------
    597  f04a							; VBLANK (37 scanlines)
    598  f04a							; ------------------------------------------------------------------------------
    599  f04a		       a9 02		      lda	#2
    600  f04c		       85 01		      sta	VBLANK	; turn on VBLANK
    601  f04e
    602  f04e							; --- Set TIM64T for VBLANK ---
    603  f04e							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    604  f04e							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    605  f04e							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    606  f04e							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    607  f04e							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    608  f04e							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    609  f04e							; Worst 1059c of the 1472c window = 413c margin.
    610  f04e							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    611  f04e							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    612  f04e							; 2026-10-25: #23 -> #31 (flicker hunt, bugs.md #16). With #23 a room whose
    613  f04e							; GRP1 objects alternate (FlickerFrame) ran the heavy VBL path ~35c PAST
    614  f04e							; the timer on every other frame: the SOXP WSYNC straddled a line edge, the
    615  f04e							; poll exited at once, the entry anchor took the NEXT line -> 270/271 line
    616  f04e							; frames alternating = visible flicker. #24 (+64c) fixed that room, but the
    617  f04e							; two-object phase rooms (level 6 room 4) still overran ~40c on a 16-frame
    618  f04e							; cycle (the object X moves the div15 count) and flipped 271<->272 in
    619  f04e							; blocks. Then the whole-stage sweep (211 rooms) showed ~60 rooms with
    620  f04e							; two enemies + M1/ball patches overrunning by up to 5 lines (4 positioning
    621  f04e							; WSYNCs + the slot-1 staging ~ 1830c effective). The overscan real work is
    622  f04e							; only ~1520c of its 3200c, so the split moved: V #25->#31, O #50->#44 (the
    623  f04e							; V+O sum stays 75 = 272 lines). Result: every shipped room is a constant
    624  f04e							; 272 lines (level 20: constant 273), worst VBL poll slack ~107c.
    625  f04e				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    626  f04e		       a9 1f		      lda	#31
    627  f050		       8d 96 02 	      sta	TIM64T
    628  f053
    629  f053							; --- Position player sprite horizontally ---
    630  f053		       a5 80		      lda	RoomX
    631  f055		       38		      sec
    632  f056		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    633  f058		       a2 00		      ldx	#0	; X=0 = player0
    634  f05a		       20 0f ff 	      jsr	SetObjectXPos
    635  f05d
    636  f05d							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    637  f05d							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    638  f05d							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    639  f05d							; now stages BallX into Temp; this block reads the staged copy. ---
    640  f05d
    641  f05d							; --- No sprite copy needed — kernel reads directly from ROM ---
