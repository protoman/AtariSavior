   3844  fce5							; Title: player already placed at level start by LoadLevel. Hide all
   3845  fce5							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3846  fce5							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3847  fce5							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3848  fce5		       a9 00		      lda	#0
   3849  fce7		       85 b3		      sta	EnemyCount
   3850  fce9		       a9 ff		      lda	#$FF
   3851  fceb		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3852  fced							; Preview seat (user 2026-10-24): the title draws the REAL cave in band 0
   3853  fced							; and seats the player 6 px down from the very top, so his head is not
   3854  fced							; clipped by the top of the screen (RoomY = 0 cut it). (RoomY = 36 put him
   3855  fced							; inside band 1's wall: the playfield has priority over sprites, so he
   3856  fced							; showed as a sliver.)
   3857  fced		       a9 06		      lda	#6
   3858  fcef		       85 81		      sta	RoomY
   3859  fcf1							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3860  fcf1							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3861  fcf1							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3862  fcf1							; preview still renders dark.
   3863  fcf1		       a5 c0		      lda	LaserState
   3864  fcf3		       29 3d		      and	#LASER_KEEP
   3865  fcf5		       85 c0		      sta	LaserState
