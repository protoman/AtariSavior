   2367  f81f				   .UEDNotTent
   2368  f81f		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2369  f821		       d0 03		      bne	.UEDNotMoth
   2370  f823		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2371  f826				   .UEDNotMoth
   2372  f826		       c9 02		      cmp	#ENEMY_SNAKE
   2373  f828		       d0 03		      bne	.UEDNotSnake
   2374  f82a		       4c d6 f3 	      jmp	UE_SnakeBody
   2375  f82d				   .UEDNotSnake
   2376  f82d		       4c 1a f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2377  f830							; (absolute jmps: this block is far from the
