   1575  f442							; ------------------------------------------------------------------------------
   1576  f442							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1577  f442							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1578  f442							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1579  f442							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1580  f442							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1581  f442							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1582  f442							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1583  f442							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1584  f442							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1585  f442							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1586  f442							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1587  f442							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1588  f442							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1589  f442							; ------------------------------------------------------------------------------
   1590  f442				   UE_Tentacle
   1591  f442		       a5 ad		      lda	TickCounter
   1592  f444		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1593  f446							; = half the player's 1 px/frame (user
   1594  f446							; 2026-10-10: &3 read as chunky/slow)
   1595  f446		       d0 4b		      bne	.TentOut
   1596  f448		       b5 bd		      lda	EnemyRamX,X
   1597  f44a		       c5 80		      cmp	RoomX
   1598  f44c		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1599  f44e		       90 06		      bcc	.TentRight
   1600  f450		       38		      sec
   1601  f451		       e9 01		      sbc	#1	; step left
   1602  f453		       4c 59 f4 	      jmp	.TentProbe
   1603  f456				   .TentRight
   1604  f456		       18		      clc
   1605  f457		       69 01		      adc	#1	; step right
   1606  f459				   .TentProbe
   1607  f459		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1608  f45b		       b0 36		      bcs	.TentOut
   1609  f45d		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1610  f45f							; Same-column cull: committed X is always probe-clear, so a candidate in
   1611  f45f							; the same 4px column covers the same collision cells → result is known
   1612  f45f							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1613  f45f		       a5 88		      lda	Temp
   1614  f461		       55 bd		      eor	EnemyRamX,X
   1615  f463		       29 fc		      and	#$FC
   1616  f465		       f0 28		      beq	.TentCommit
   1617  f467		       a5 80		      lda	RoomX
   1618  f469		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1619  f46b		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1620  f46d		       85 b8		      sta	ActiveObjectY
   1621  f46f		       a5 88		      lda	Temp
   1622  f471		       c9 05		      cmp	#5
   1623  f473		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1624  f475							; PHM's negative visible-left wraps to 255
   1625  f475							; (col garbage / ColOff OOB walk). cand<=4
   1626  f475							; ink pokes off-screen anyway; RoomX=cand
   1627  f475							; already covers cell0.
   1628  f475		       38		      sec
   1629  f476		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1630  f478							; sits 5/7 px left of A (moth .Mvl convention,
   1631  f478							; bank2), but PHM's PLAYER prologue derives
   1632  f478							; lit-left = arg-4/arg-7 with the bin on
   1633  f478							; RoomX-PlayerDir → box missed the cell left
   1634  f478							; of the ink at cand 8/12 (sprite drew 1 px
   1635  f478							; into the wall — bugs.md #4). cand-1 shifts
   1636  f478							; the tested box 1 px left: cell-exact or 1 px
   1637  f478							; conservative for every cand/facing pair
