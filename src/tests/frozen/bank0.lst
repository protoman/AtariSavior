   1744  f465		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1745  f467		       85 b8		      sta	ActiveObjectY
   1746  f469		       a5 88		      lda	Temp
   1747  f46b		       c9 05		      cmp	#5
   1748  f46d		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1749  f46f							; PHM's negative visible-left wraps to 255
   1750  f46f							; (col garbage / ColOff OOB walk). cand<=4
   1751  f46f							; ink pokes off-screen anyway; RoomX=cand
   1752  f46f							; already covers cell0.
   1753  f46f		       38		      sec
   1754  f470		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1755  f472							; sits 5/7 px left of A (moth .Mvl convention,
   1756  f472							; bank2), but PHM's PLAYER prologue derives
   1757  f472							; lit-left = arg-4/arg-7 with the bin on
   1758  f472							; RoomX-PlayerDir → box missed the cell left
   1759  f472							; of the ink at cand 8/12 (sprite drew 1 px
   1760  f472							; into the wall — bugs.md #4). cand-1 shifts
   1761  f472							; the tested box 1 px left: cell-exact or 1 px
   1762  f472							; conservative for every cand/facing pair
   1763  f472							; (tools/test_cell_map.py tentacle section).
   1764  f472				   .TentProbeX
