    374 U00bc		       00 37	   OBJ_TENTACLE =	55	; SPIDER 15, LAMP 10, TENTACLE 14, BAT 10,
    375 U00bc		       00 45	   OBJ_BAT    =	69	; SNAKE 6, MINER 16, BOMB 8, RAFT 2, KEY 16.
