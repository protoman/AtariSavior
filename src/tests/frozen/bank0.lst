   4654  ff57		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4655  ff59		       90 03		      bcc	.LAdvCap
   4656  ff5b		       4c 87 ff 	      jmp	.LaserInit
   4657  ff5e				   .LAdvCap
