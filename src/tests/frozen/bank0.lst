   2426  f815							; Slot1Hook — called from the .Row setup (X = RowIdx = band). Swaps the live
   2427  f815							; trio when slot 1 lives in this band, then repositions P1 and strobes HMOVE
   2428  f815							; on the following line's HBLANK. Preserves X (RowIdx) and Y (running-Y: the
   2429  f815							; .Line loop relies on it being untouched between rows).
   2430  f815				   Slot1Hook
   2431  f815		       98		      tya
   2432  f816		       48		      pha		; save running-Y (SetObjectXPos does `tay`)
   2433  f817		       a5 eb		      lda	ObjTop1
   2434  f819		       18		      clc
   2435  f81a		       65 81		      adc	RoomY
   2436  f81c		       38		      sec
   2437  f81d		       e9 01		      sbc	#1	; A = slot 1's absolute room Y
   2438  f81f		       dd 00 fe 	      cmp	BandStart,X
   2439  f822		       90 24		      bcc	.SHout	; above this band
   2440  f824		       dd 01 fe 	      cmp	BandStart+1,X
   2441  f827		       b0 1f		      bcs	.SHout	; in a later band
   2442  f829		       a5 ea		      lda	ObjBase1
   2443  f82b		       85 b6		      sta	ObjBase
   2444  f82d		       a5 eb		      lda	ObjTop1
   2445  f82f		       85 bb		      sta	ObjTop
   2446  f831		       a5 ec		      lda	ObjX1
   2447  f833		       85 b7		      sta	ActiveObjectX
   2448  f835		       a2 01		      ldx	#1
   2449  f837		       20 0f ff 	      jsr	SetObjectXPos	; its own WSYNC starts the positioning line
   2450  f83a							; The frame's ONE HMOVE already ran in the VBL; this second one exists only
   2451  f83a							; for slot 1's own fine adjust. HMP0/HMM0/HMBL still hold the PLAYER's,
   2452  f83a							; the laser's and the ball's fine values, and HMOVE would apply them a
   2453  f83a							; second time — the player's fine adjust doubled (drawn X advanced 2 px per
   2454  f83a							; 1 px of RoomX, sawing +/-15 px as the fine value cycled: the "raft
   2455  f83a							; zig-zag", user 2026-10-22). Clear them; HMP1 stays (set above).
   2456  f83a							; THESE CLEARS MUST SIT BEFORE THE `sta WSYNC` BELOW: they cost ~14 cycles,
   2457  f83a							; and an HMOVE written after cycle 0 of HBLANK gives up part of the fine
   2458  f83a							; shift (late-HMOVE penalty) — slot 1's sprite then snaps in ~4 px steps
   2459  f83a							; (user 2026-10-22: "raft moves one tile at a time").
   2460  f83a		       a9 00		      lda	#0
   2461  f83c		       85 20		      sta	HMP0
   2462  f83e		       85 22		      sta	HMM0
   2463  f840		       85 24		      sta	HMBL
   2464  f842		       a6 92		      ldx	RowIdx
   2465  f844		       85 02		      sta	WSYNC	; end of the positioning line
   2466  f846		       85 2a		      sta	HMOVE	; cycle 0 of the next line = HBLANK
   2467  f848				   .SHout
   2468  f848		       68		      pla
   2469  f849		       a8		      tay
