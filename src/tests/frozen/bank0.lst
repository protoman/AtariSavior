   1132  f201
   1133  f201							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1134  f201							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1135  f201							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1136  f201							;	   catches the fall in ~10 frames from terminal $0180.
   1137  f201							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1138  f201							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1139  f201							;	   gone: it kept thrust below gravity for ~32 frames.
   1140  f201							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1141  f201							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1142  f201							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1143  f201							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1144  f201							;	   1.0s hover was too long — halved); then the flag clears and
   1145  f201							;	   normal gravity resumes (fall ~0.85s after release). State
   1146  f201							;	   lives in JetPower, NOT
   1147  f201							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1148  f201							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1149  f201							;	   rising frame — both clobbered a StepsLeft-based float.
   1150  f201							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1151  f201							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1152  f201							;	   (headroom stays $FC67).
   1153  f201							; ------------------------------------------------------------------------------
   1154  f201		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1155  f203		       24 88		      bit	Temp
   1156  f205		       d0 25		      bne	.JetDecay
   1157  f207		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1158  f209		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1159  f20b		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1160  f20d		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1161  f20f				   .JetRamp
   1162  f20f							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1163  f20f							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1164  f20f							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1165  f20f							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1166  f20f							; ~80 frames = more than a room height of extra falling). The ramp only
   1167  f20f							; applies from rest / while already rising, so take-off still eases in.
   1168  f20f		       a5 94		      lda	vyHi
   1169  f211		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1170  f213		       05 93		      ora	vyLo
   1171  f215		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1172  f217		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1173  f219		       85 96		      sta	JetPower
   1174  f21b		       4c 58 f2 	      jmp	.Gravity
   1175  f21e				   .JetClimb
   1176  f21e		       a5 96		      lda	JetPower
   1177  f220		       c9 30		      cmp	#JET_MAX
   1178  f222		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1179  f224		       18		      clc
   1180  f225		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1181  f227		       85 96		      sta	JetPower
   1182  f229		       4c 58 f2 	      jmp	.Gravity
   1183  f22c				   .JetDecay		; Up NOT held this frame
   1184  f22c		       a5 96		      lda	JetPower
   1185  f22e		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1186  f230		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1187  f232		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1188  f234		       05 93		      ora	vyLo
   1189  f236		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1190  f238							;   climb to stop, do NOT float
   1191  f238		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1192  f23a		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1193  f23c		       4c 58 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1194  f23f				   .FloatRun
   1195  f23f		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1196  f241		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1197  f243		       29 7f		      and	#$7F
   1198  f245		       d0 04		      bne	.FRActive
   1199  f247		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1200  f249		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1201  f24b				   .FRActive
   1202  f24b		       a5 94		      lda	vyHi
   1203  f24d		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1204  f24f		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1205  f251		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1206  f253		       85 94		      sta	vyHi
   1207  f255		       4c 9d f2 	      jmp	.Integrate
   1208  f258
   1209  f258							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1210  f258							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1211  f258							;     only — subtracting $80+ would blast the player upward.
   1212  f258				   .Gravity
   1213  f258		       18		      clc
   1214  f259		       a5 93		      lda	vyLo
   1215  f25b		       69 08		      adc	#<GRAVITY
   1216  f25d		       85 93		      sta	vyLo
   1217  f25f		       a5 94		      lda	vyHi
   1218  f261		       69 00		      adc	#>GRAVITY
   1219  f263		       85 94		      sta	vyHi
   1220  f265		       a5 96		      lda	JetPower
   1221  f267		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1222  f269		       38		      sec
   1223  f26a		       a5 93		      lda	vyLo
   1224  f26c		       e5 96		      sbc	JetPower
   1225  f26e		       85 93		      sta	vyLo
   1226  f270		       a5 94		      lda	vyHi
   1227  f272		       e9 00		      sbc	#0
   1228  f274		       85 94		      sta	vyHi
   1229  f276				   .ThrustSkip
   1230  f276
   1231  f276							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1232  f276							; The high byte alone is NOT enough (2026-10-22): `cmp #>MAX_FALL` with vyHi
   1233  f276							; == $01 is EQUAL, so the old code rewrote vy to exactly $0180 for every speed
   1234  f276							; in $0100..$017F — a falling player's thrust was computed and then thrown
   1235  f276							; away every frame (vy: $0180 -> $0188 -> $0158 -> clamped back to $0180), so
   1236  f276							; the jet could not slow a fall at all. Compare the low byte when the high
   1237  f276							; bytes match.
   1238  f276		       a5 94		      lda	vyHi
   1239  f278		       30 17		      bmi	.RiseClamp
   1240  f27a		       c9 01		      cmp	#>MAX_FALL
   1241  f27c		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1242  f27e		       d0 06		      bne	.FallClamp	; above: clamp
   1243  f280		       a5 93		      lda	vyLo
   1244  f282		       c9 80		      cmp	#<MAX_FALL
   1245  f284		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1246  f286				   .FallClamp
   1247  f286		       a9 01		      lda	#>MAX_FALL
   1248  f288		       85 94		      sta	vyHi
   1249  f28a		       a9 80		      lda	#<MAX_FALL
   1250  f28c		       85 93		      sta	vyLo
   1251  f28e		       4c 9d f2 	      jmp	.Integrate
   1252  f291				   .RiseClamp
   1253  f291		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1254  f293		       b0 08		      bcs	.Integrate
   1255  f295		       a9 ff		      lda	#$ff
   1256  f297		       85 94		      sta	vyHi
   1257  f299		       a9 00		      lda	#$00
   1258  f29b		       85 93		      sta	vyLo	; vy = -$0100
   1259  f29d
   1260  f29d							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1261  f29d							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1262  f29d							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1263  f29d							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1264  f29d							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1265  f29d							;     resumes (he lifts off). No Up -> hovers in place.
   1266  f29d				   .Integrate
   1267  f29d		       a5 9c		      lda	Hover
   1268  f29f		       f0 13		      beq	.DoInt
   1269  f2a1		       a5 96		      lda	JetPower
   1270  f2a3		       c9 09		      cmp	#GRAVITY + 1
   1271  f2a5		       b0 09		      bcs	.HoverEnd
   1272  f2a7		       a9 00		      lda	#0
   1273  f2a9		       85 93		      sta	vyLo
   1274  f2ab		       85 94		      sta	vyHi
   1275  f2ad		       4c b4 f2 	      jmp	.DoInt
   1276  f2b0				   .HoverEnd
   1277  f2b0		       a9 00		      lda	#0
   1278  f2b2		       85 9c		      sta	Hover
   1279  f2b4				   .DoInt
   1280  f2b4		       18		      clc
