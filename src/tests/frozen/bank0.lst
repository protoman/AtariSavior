   1255  f208							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1256  f208							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1257  f208							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1258  f208							;	   catches the fall in ~10 frames from terminal $0180.
   1259  f208							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1260  f208							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1261  f208							;	   gone: it kept thrust below gravity for ~32 frames.
   1262  f208							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1263  f208							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1264  f208							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1265  f208							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1266  f208							;	   1.0s hover was too long — halved); then the flag clears and
   1267  f208							;	   normal gravity resumes (fall ~0.85s after release). State
   1268  f208							;	   lives in JetPower, NOT
   1269  f208							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1270  f208							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1271  f208							;	   rising frame — both clobbered a StepsLeft-based float.
   1272  f208							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1273  f208							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1274  f208							;	   (headroom stays $FC67).
   1275  f208							; ------------------------------------------------------------------------------
   1276  f208		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1277  f20a		       24 88		      bit	Temp
   1278  f20c		       d0 25		      bne	.JetDecay
   1279  f20e		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1280  f210		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1281  f212		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1282  f214		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1283  f216				   .JetRamp
   1284  f216							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1285  f216							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1286  f216							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1287  f216							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1288  f216							; ~80 frames = more than a room height of extra falling). The ramp only
   1289  f216							; applies from rest / while already rising, so take-off still eases in.
   1290  f216		       a5 94		      lda	vyHi
   1291  f218		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1292  f21a		       05 93		      ora	vyLo
   1293  f21c		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1294  f21e		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1295  f220		       85 96		      sta	JetPower
   1296  f222		       4c 5f f2 	      jmp	.Gravity
   1297  f225				   .JetClimb
   1298  f225		       a5 96		      lda	JetPower
   1299  f227		       c9 30		      cmp	#JET_MAX
   1300  f229		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1301  f22b		       18		      clc
   1302  f22c		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1303  f22e		       85 96		      sta	JetPower
   1304  f230		       4c 5f f2 	      jmp	.Gravity
   1305  f233				   .JetDecay		; Up NOT held this frame
   1306  f233		       a5 96		      lda	JetPower
   1307  f235		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1308  f237		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1309  f239		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1310  f23b		       05 93		      ora	vyLo
   1311  f23d		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1312  f23f							;   climb to stop, do NOT float
   1313  f23f		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1314  f241		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1315  f243		       4c 5f f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1316  f246				   .FloatRun
