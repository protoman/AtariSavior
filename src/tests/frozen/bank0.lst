   1771  f539		       85 f7		      sta	BombTimer
   1772  f53b		       85 c1		      sta	EnemyRamD	; clear dir + RoomDarkMask (bits 4-7) — level reset
   1773  f53d		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1774  f53f							;  game-over restart = LoseLife->ReloadLevel->
   1775  f53f							;  here; same-stage respawn keeps facing)
   1776  f53f		       85 9c		      sta	Hover	; bugs.md #1: stage entry lands normally; the
   1777  f541							;   respawn hover is armed only by LoseLife
   1778  f541		       a5 c0		      lda	LaserState
   1779  f543		       29 c7		      and	#%11000111	; clear RoomDarkMask rooms 4-7 (LaserState b5-2)
   1780  f545		       85 c0		      sta	LaserState
   1781  f547		       a9 05		      lda	#BOMBS_MAX
   1782  f549		       85 f0		      sta	PlayerBombs
   1783  f54b		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the
   1784  f54d		       c9 ff		      cmp	#$FF	; title preview (HUD score shows level+1)
   1785  f54f		       f0 04		      beq	.NoBanner
   1786  f551		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1787  f553		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
   1788  f555				   .NoBanner
   1789  f555							; Compute LevelDataTable pointer: base + Level * 7
   1790  f555							; Stride 7: miner(2) + wall_colors(2) + base ptr(2) + rooms(1)
   1791  f555		       a5 a3		      lda	Level
   1792  f557		       0a		      asl		; *2
   1793  f558		       0a		      asl		; *4
   1794  f559		       0a		      asl		; *8
   1795  f55a		       38		      sec
   1796  f55b		       e5 a3		      sbc	Level	; *7
   1797  f55d		       a8		      tay		; Y = Level * 7
