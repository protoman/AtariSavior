   4436  fe9c							; ------------------------------------------------------------------------------
   4437  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   4438  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   4439  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   4440  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   4441  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   4442  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   4443  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   4444  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   4445  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   4446  fe9c							; ------------------------------------------------------------------------------
   4447  fe9c				   TallyWork
   4448  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   4449  fe9f		       a8		      tay
   4450  fea0		       29 01		      and	#1
   4451  fea2		       f0 05		      beq	.TNoScore
   4452  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4453  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4454  fea9				   .TNoScore
   4455  fea9		       98		      tya
   4456  feaa		       29 04		      and	#4
   4457  feac		       f0 19		      beq	.TLive
   4458  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4459  feb0		       a9 00		      lda	#0
   4460  feb2		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4461  feb4							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4462  feb4							;   pose ($FE must take the real-fall path)
   4463  feb4		       a9 02		      lda	#2
   4464  feb6		       20 08 fc 	      jsr	CallPad_SaveKey	; SaveKey CHECKPOINT: {Level, lives, score} at the
   4465  feb9							;   start of the new stage. Past the last stage
   4466  feb9							;   (Level == LEVEL_COUNT) the op commits the high
   4467  feb9							;   score, erases the save and RESTARTS at the
   4468  feb9							;   title - it does not return (was: wrap to 0)
   4469  feb9		       20 20 fc 	      jsr	LoadLevel
   4470  febc		       a9 78		      lda	#120	; reset timer for new level
   4471  febe		       85 ae		      sta	BarLevel
   4472  fec0		       a9 3c		      lda	#60
   4473  fec2		       85 ad		      sta	TickCounter
   4474  fec4		       4c 36 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4475  fec7				   .TLive
   4476  fec7		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   4477  feca		       a9 00		      lda	#0
   4478  fecc		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   4479  fece				   .TWait
   4480  fece		       ad 84 02 	      lda	INTIM
   4481  fed1		       d0 fb		      bne	.TWait
   4482  fed3		       4c 3a f0 	      jmp	StartFrame
