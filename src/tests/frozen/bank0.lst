   2543  f961		       98		      tya		; A = visible_left
   2544  f962		       18		      clc
   2545  f963		       69 06		      adc	#PLAYER_WIDTH - 1
   2546  f965		       4a		      lsr
   2547  f966		       4a		      lsr
   2548  f967		       c9 14		      cmp	#TILE_COLUMNS
   2549  f969		       90 07		      bcc	.lastOk
   2550  f96b		       85 8b		      sta	CollisionX
   2551  f96d		       a9 27		      lda	#39
   2552  f96f		       38		      sec
   2553  f970		       e5 8b		      sbc	CollisionX
   2554  f972				   .lastOk
   2555  f972		       85 8c		      sta	CollisionCellX	; max text column
   2556  f974
