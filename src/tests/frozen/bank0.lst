    894  f129		       65 b6		      adc	ObjBase
    895  f12b		       aa		      tax
    896  f12c		       bd 48 fe 	      lda	ObjSprites,X
    897  f12f		       85 1c		      sta	GRP1
    898  f131		       bd 00 fe 	      lda	ObjColorTab,X	; per-row object color (+5c cross — the cycle sum
