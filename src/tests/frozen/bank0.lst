    995  f187							; ==============================================================================
    996  f187							; HUD band: 48 scanlines (144-191)
    997  f187							; Uses 13+2 sprite technique via bank1 (fold-pad trampoline)
    998  f187							; ==============================================================================
    999  f187
   1000  f187							; --- Call bank1 for 13+2 HUD rendering via fold-pad at $FC68 ---
   1001  f187							; The fold-pad at $FC68 has identical bytes in bank0 and bank1:
   1002  f187							;   $FC68: lda #1 / sta $1FF7 / jmp $F540
   1003  f187							; After sta $1FF7, CPU reads next instruction from bank1 at $FC6D.
   1004  f187							; Bank1's $FC6D has the same jmp $F540 → seamless bank switch.
   1005  f187		       4c 68 fc 	      jmp	$FC68	; jump to fold-pad (switches to bank1, runs MenuMain)
   1006  f18a							; Bank1's MenuMain returns to bank0 via: lda #0 / sta $1FF6 / jmp Overscan
   1007  f18a
   1008  f18a							; ==============================================================================
   1009  f18a							; Overscan (30 scanlines) — input handling + game logic
   1010  f18a							; ==============================================================================
   1011  f18a				   Overscan
   1012  f18a		       a9 02		      lda	#2
   1013  f18c		       85 01		      sta	VBLANK	; turn on VBLANK during overscan
   1014  f18e
   1015  f18e							; --- Set TIM64T for overscan ---
   1016  f18e							; P3.4: overscan work worst 2104c (heavy, enemy room, rect cache in) →
   1017  f18e							; #50 = 3200c = 1096c headroom (was #35 = 2240c = 136c — positive but
   1018  f18e							; too tight for transition frames). V(#23)+O(#50) = 73 units = 262 lines.
   1019  f18e		       a9 32		      lda	#50
   1020  f190		       8d 96 02 	      sta	TIM64T
   1021  f193
   1022  f193							; --- Write live Y → EnemyRamY ($E2-$E4; window-safe since S3.4: this
   1023  f193							; runs after the HUD score-ptr stomp, before every reader) ---
