   2699  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2700  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2701  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2702  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2703  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2704  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2705  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2706  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2707  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2708  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2709  f980							; before — same ZP, no new allocation).
   2710  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2711  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2712  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2713  f980		       a5 8d		      lda	CollisionCellY
   2714  f982		       85 92		      sta	RectCount
   2715  f984				   .CWRow
   2716  f984		       a5 8e		      lda	CollisionEndX
   2717  f986		       85 8b		      sta	CollisionX
   2718  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2719  f989							;   was re-loaded every cell — −8c/cell walk
   2720  f989							;   trim for the falling+probe heavy frame)
   2721  f989				   .CWCol
   2722  f989		       a4 92		      ldy	RectCount
   2723  f98b		       98		      tya
   2724  f98c		       18		      clc
   2725  f98d		       7d a3 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2726  f990		       a8		      tay
