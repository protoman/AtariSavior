   1091  f1f4							; ------------------------------------------------------------------------------
   1092  f1f4							; Vertical movement — HERO-style jetpack physics
   1093  f1f4							; ------------------------------------------------------------------------------
   1094  f1f4							; Gravity pulls down, holding Up fires jetpack (JetPower ramps with inertia).
   1095  f1f4							; Velocity is integrated through PlayerYSub and walked pixel-by-pixel via
   1096  f1f4							; StepDown/StepUp so collision stops flush at walls/doorways.
   1097  f1f4							; ------------------------------------------------------------------------------
   1098  f1f4				   UpdateP0Vertical
   1099  f1f4							; --- Clear HotBump (Temp b7) — set again only if this frame bumps hot rock ---
   1100  f1f4		       a5 88		      lda	Temp
   1101  f1f6		       29 7f		      and	#%01111111
   1102  f1f8		       85 88		      sta	Temp
   1103  f1fa
   1104  f1fa							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1105  f1fa							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1106  f1fa							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1107  f1fa							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1108  f1fa							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1109  f1fa							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1110  f1fa							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1111  f1fa							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1112  f1fa							;	   1.0s hover was too long — halved); then the flag clears and
   1113  f1fa							;	   normal gravity resumes (fall ~0.85s after release). State
   1114  f1fa							;	   lives in JetPower, NOT
   1115  f1fa							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1116  f1fa							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1117  f1fa							;	   rising frame — both clobbered a StepsLeft-based float.
   1118  f1fa							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1119  f1fa							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1120  f1fa							;	   (headroom stays $FC67).
   1121  f1fa							; ------------------------------------------------------------------------------
   1122  f1fa		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1123  f1fc		       24 88		      bit	Temp
   1124  f1fe		       d0 21		      bne	.JetDecay
   1125  f200		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1126  f202		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1127  f204		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1128  f206		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1129  f208				   .RampStart
   1130  f208		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1131  f20a		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1132  f20c		       d0 3f		      bne	.Gravity
   1133  f20e		       a5 96		      lda	JetPower
   1134  f210		       c9 14		      cmp	#JET_MAX
   1135  f212		       b0 06		      bcs	.JetCapped
   1136  f214		       18		      clc
   1137  f215		       69 01		      adc	#1
   1138  f217		       4c 1c f2 	      jmp	.JetSet
   1139  f21a				   .JetCapped
   1140  f21a		       a9 14		      lda	#JET_MAX
   1141  f21c				   .JetSet
   1142  f21c		       85 96		      sta	JetPower
   1143  f21e		       4c 4d f2 	      jmp	.Gravity
   1144  f221				   .JetDecay		; Up NOT held this frame
   1145  f221		       a5 96		      lda	JetPower
   1146  f223		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1147  f225		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1148  f227		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1149  f229		       05 93		      ora	vyLo
   1150  f22b		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1151  f22d							;   climb to stop, do NOT float
   1152  f22d		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1153  f22f		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1154  f231		       4c 4d f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1155  f234				   .FloatRun
   1156  f234		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1157  f236		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1158  f238		       29 7f		      and	#$7F
   1159  f23a		       d0 04		      bne	.FRActive
   1160  f23c		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1161  f23e		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1162  f240				   .FRActive
   1163  f240		       a5 94		      lda	vyHi
   1164  f242		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1165  f244		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1166  f246		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1167  f248		       85 94		      sta	vyHi
   1168  f24a		       4c 8a f2 	      jmp	.Integrate
   1169  f24d
   1170  f24d							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1171  f24d							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1172  f24d							;     only — subtracting $80+ would blast the player upward.
   1173  f24d				   .Gravity
   1174  f24d		       18		      clc
   1175  f24e		       a5 93		      lda	vyLo
   1176  f250		       69 08		      adc	#<GRAVITY
   1177  f252		       85 93		      sta	vyLo
   1178  f254		       a5 94		      lda	vyHi
   1179  f256		       69 00		      adc	#>GRAVITY
   1180  f258		       85 94		      sta	vyHi
   1181  f25a		       a5 96		      lda	JetPower
   1182  f25c		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1183  f25e		       38		      sec
   1184  f25f		       a5 93		      lda	vyLo
   1185  f261		       e5 96		      sbc	JetPower
   1186  f263		       85 93		      sta	vyLo
   1187  f265		       a5 94		      lda	vyHi
   1188  f267		       e9 00		      sbc	#0
   1189  f269		       85 94		      sta	vyHi
   1190  f26b				   .ThrustSkip
   1191  f26b
   1192  f26b							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1193  f26b		       a5 94		      lda	vyHi
   1194  f26d		       30 0f		      bmi	.RiseClamp
   1195  f26f		       c9 01		      cmp	#>MAX_FALL
   1196  f271		       90 17		      bcc	.Integrate
   1197  f273		       a9 01		      lda	#>MAX_FALL
   1198  f275		       85 94		      sta	vyHi
   1199  f277		       a9 80		      lda	#<MAX_FALL
   1200  f279		       85 93		      sta	vyLo
   1201  f27b		       4c 8a f2 	      jmp	.Integrate
   1202  f27e				   .RiseClamp
   1203  f27e		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1204  f280		       b0 08		      bcs	.Integrate
   1205  f282		       a9 ff		      lda	#$ff
   1206  f284		       85 94		      sta	vyHi
   1207  f286		       a9 00		      lda	#$00
   1208  f288		       85 93		      sta	vyLo	; vy = -$0100
   1209  f28a
   1210  f28a							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1211  f28a							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1212  f28a							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1213  f28a							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1214  f28a							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1215  f28a							;     resumes (he lifts off). No Up -> hovers in place.
   1216  f28a				   .Integrate
   1217  f28a		       a5 9c		      lda	Hover
   1218  f28c		       f0 13		      beq	.DoInt
   1219  f28e		       a5 96		      lda	JetPower
   1220  f290		       c9 09		      cmp	#GRAVITY + 1
   1221  f292		       b0 09		      bcs	.HoverEnd
   1222  f294		       a9 00		      lda	#0
   1223  f296		       85 93		      sta	vyLo
   1224  f298		       85 94		      sta	vyHi
   1225  f29a		       4c a1 f2 	      jmp	.DoInt
   1226  f29d				   .HoverEnd
   1227  f29d		       a9 00		      lda	#0
   1228  f29f		       85 9c		      sta	Hover
   1229  f2a1				   .DoInt
   1230  f2a1		       18		      clc
   1231  f2a2		       a5 95		      lda	PlayerYSub
   1232  f2a4		       65 93		      adc	vyLo
   1233  f2a6		       85 95		      sta	PlayerYSub
   1234  f2a8		       a9 00		      lda	#0
   1235  f2aa		       65 94		      adc	vyHi
   1236  f2ac		       f0 1c		      beq	.NoVMove
   1237  f2ae		       30 0c		      bmi	.UpSteps
   1238  f2b0		       85 97		      sta	StepsLeft	; positive = falling (down)
   1239  f2b2				   .JFalling
   1240  f2b2		       20 52 f3 	      jsr	StepDown
   1241  f2b5		       c6 97		      dec	StepsLeft
   1242  f2b7		       d0 f9		      bne	.JFalling
   1243  f2b9		       4c ca f2 	      jmp	.NoVMove
   1244  f2bc				   .UpSteps
   1245  f2bc		       49 ff		      eor	#$ff
   1246  f2be		       18		      clc
   1247  f2bf		       69 01		      adc	#1	; magnitude of upward displacement
   1248  f2c1		       85 97		      sta	StepsLeft
