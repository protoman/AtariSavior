   3727  fda9							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3728  fda9							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3729  fda9							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3730  fda9							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3731  fda9							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3732  fda9							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3733  fda9							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3734  fda9							;   tools/test_cell_map.py).
   3735  fda9							;   (The standalone CellSolid leaf that lived here moved INTO
   3736  fda9							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3737  fda9							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3738  fda9							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3739  fda9							; ------------------------------------------------------------------------------
   3740  fda9		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3741  fdbd		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3742  fdc9		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3743  fdd1
   3744  fdd1							; ------------------------------------------------------------------------------
   3745  fdd1							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3746  fdd1							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3747  fdd1							; is fetched from bank2's byte-identical mirror at this same address and
   3748  fdd1							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3749  fdd1							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3750  fdd1							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3751  fdd1							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3752  fdd1							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3753  fdd1							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3754  fdd1							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3755  fdd1							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3756  fdd1							; ------------------------------------------------------------------------------
   3757  fdd1		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3758  fdd8				   BombEnemyBlast
