   2266  f65e		       85 07		      sta	COLUP1
   2267  f660		       4c 41 f7 	      jmp	.SODone
   2268  f663				   .SOFull
   2269  f663		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2270  f665							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2271  f665		       a5 b5		      lda	BombPacked
   2272  f667		       29 03		      and	#%00000011
   2273  f669		       c9 01		      cmp	#1
