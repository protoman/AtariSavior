   1877  f4f4							; Room exit handlers — check connection table, switch rooms, reposition player
   1878  f4f4							; ==============================================================================
   1879  f4f4							; ------------------------------------------------------------------------------
   1880  f4f4							; C3 (2026-10-20): the four handlers MOVED to bank2 ($FC4F cluster) — the
   1881  f4f4							; connection table is level data in bank2, so each handler now reads its own
   1882  f4f4							; 2-byte conn record directly (bank1 GetConnIdx + FoldIndirect hops gone).
   1883  f4f4							; bank0 keeps only the entry pads at $FBD9-$FBE4 (3 B each, `sta $1FF6`;
   1884  f4f4							; bank2 serves the `jmp` at A+3). The OPPOSITE-EDGE placement is written
   1885  f4f4							; BEFORE `jmp EnterRoomB2`, because EnterRoom never touches RoomX/RoomY
   1886  f4f4							; (checked: EnterRoomB2 + B3RoomBlocks read neither) — that keeps the whole
   1887  f4f4							; tail in bank2 with 0 pushes: EnterRoomB2's `jmp ReturnPad` pops the
   1888  f4f4							; ORIGINAL `jsr ExitRoomXxx` frame, exactly like the old in-bank return.
   1889  f4f4							; Guard: verify_build.CORRIDOR_PADS (4 pads) + check_exit_handlers (edge
   1890  f4f4							; placement precedes the EnterRoomB2 tail; no-exit path ends in ReturnPad).
   1891  f4f4							; ------------------------------------------------------------------------------
   1892  f4f4
   1893  f4f4							; ==============================================================================
   1894  f4f4							; Level management
   1895  f4f4							; ==============================================================================
   1896  f4f4							; LoadLevel MOVED to bank2 (C2, 2026-10-20) — body = LoadLevelB2 ($F640).
   1897  f4f4							; The level index/table lives in bank2 (level data), so the old body paid 7
   1898  f4f4							; `jsr FoldIndirect` (7 x 25c + 14 bank switches) to read a 7-byte entry that
   1899  f4f4							; an in-bank (FetchPtr),Y read now fetches directly. Both halves are split
   1900  f4f4							; pads (same discipline as CallPad_SelectObject):
   1901  f4f4							;   A=$FC20  CallPad_LoadLevel / LoadLevel: `sta $1FF6`   (bank0 runs this)
   1902  f4f4							;   A+3=$FC23	bank2 `jmp LoadLevelB2` 		   (fetched after it)
   1903  f4f4							;   body tail `jmp $FC26` -> bank2 `sta $1FF4` at $FC26 -> the fetch at $FC29
   1904  f4f4							;   comes from HERE: `jmp LF_B0Tail`, i.e. the drop-in tail (EnterRoom call,
   1905  f4f4							;   level-start placement, `jmp DropArm`) stays in bank0 so the call chain and
   1906  f4f4							;   the measured stack depth are UNCHANGED (0 extra jsr levels, 0 pushes).
   1907  f4f4							; Entry layout: stride 7 = miner_room (b7 = faces right), miner_x, wall color,
   1908  f4f4							; wall color 2, block base word (RoomShapes), room count n (the RoomPositions
   1909  f4f4							; /RoomCounts/enemy-record bases are that block's +n/+2n/+3n offsets, C2).
   1910  f4f4							; Guards: verify_build.check_callpads pins the entry pad bytes + operand,
   1911  f4f4							; check_loadlevel_tramp pins the return half; tools/test_respawn_hover.py,
   1912  f4f4							; test_room_dark.py and test_level_bank.py read the bank2 body.
   1913  f4f4
   1914  f4f4							; ==============================================================================
   1915  f4f4							; Miner pickup — check if player overlaps miner, advance to next level
   1916  f4f4							; ==============================================================================
   1917  f4f4				   CheckMinerPickup
   1918  f4f4		       a5 a4		      lda	LevelMinerRoom
   1919  f4f6		       29 7f		      and	#$7f
   1920  f4f8		       c5 98		      cmp	RoomNo
   1921  f4fa		       d0 1b		      bne	.CMPDone	; not in miner's room
   1922  f4fc							; X overlap: player [RoomX, +6] vs 4px miner.
   1923  f4fc							; Accept iff RoomX - MinerX in [-6, +3].
   1924  f4fc		       a5 80		      lda	RoomX
   1925  f4fe		       38		      sec
   1926  f4ff		       e5 a5		      sbc	MinerX
   1927  f501		       18		      clc
