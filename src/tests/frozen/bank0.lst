   4452  ff20							; ------------------------------------------------------------------------------
   4453  ff20							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4454  ff20							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4455  ff20							; the facing until contact, then resets to the eye (single missile, KISS —
   4456  ff20							; user spec: no piercing, no HERO comparison needed).
   4457  ff20							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4458  ff20							;						  left	RoomX-4)
   4459  ff20							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4460  ff20							;     wrap) -> reset to eye (unsigned check catches both)
   4461  ff20							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4462  ff20							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4463  ff20							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4464  ff20							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4465  ff20							;     priority over M0 anyway).
   4466  ff20							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4467  ff20							;     press edge re-anchors).
   4468  ff20							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4469  ff20							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4470  ff20							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4471  ff20							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4472  ff20							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4473  ff20							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4474  ff20							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4475  ff20							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4476  ff20							; ------------------------------------------------------------------------------
   4477  ff20				   LaserInput
   4478  ff20		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4479  ff22		       8a		      txa
   4480  ff23		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4481  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4482  ff27		       8a		      txa
   4483  ff28		       29 80		      and	#LASER_HELD
   4484  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4485  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4486  ff2d		       85 c0		      sta	LaserState
   4487  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4488  ff31		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4489  ff33							; below — moved here so the cap code could
   4490  ff33							; not push .LaserReleased past bmi's ±127)
   4491  ff33				   .LaserReleased
   4492  ff33		       a9 00		      lda	#0
   4493  ff35		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4494  ff37							; otherwise -> bars slid across screen
   4495  ff37		       60		      rts		; LaserX kept; next press edge re-anchors
   4496  ff38				   .LaserFire
   4497  ff38		       a5 c0		      lda	LaserState
   4498  ff3a		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4499  ff3c		       85 c0		      sta	LaserState
   4500  ff3e		       8a		      txa
   4501  ff3f		       29 80		      and	#LASER_HELD
   4502  ff41		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4503  ff43							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4504  ff43							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4505  ff43							; step would jump out of the 8px wall with no candidate ever inside it
   4506  ff43							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4507  ff43							; here (b7 held from the ora above). Open-hold cadence alternates
   4508  ff43							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4509  ff43		       a5 c0		      lda	LaserState
   4510  ff45		       29 01		      and	#LASER_REARM
