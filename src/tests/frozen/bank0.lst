   1089  f1f7							; ------------------------------------------------------------------------------
   1090  f1f7							; Vertical movement — HERO-style jetpack physics
   1091  f1f7							; ------------------------------------------------------------------------------
   1092  f1f7							; Gravity pulls down, holding Up fires jetpack (JetPower ramps with inertia).
   1093  f1f7							; Velocity is integrated through PlayerYSub and walked pixel-by-pixel via
   1094  f1f7							; StepDown/StepUp so collision stops flush at walls/doorways.
   1095  f1f7							; ------------------------------------------------------------------------------
   1096  f1f7				   UpdateP0Vertical
   1097  f1f7							; --- Clear HotBump (Temp b7) — set again only if this frame bumps hot rock ---
   1098  f1f7		       a5 88		      lda	Temp
   1099  f1f9		       29 7f		      and	#%01111111
   1100  f1fb		       85 88		      sta	Temp
   1101  f1fd
   1102  f1fd							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1103  f1fd							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1104  f1fd							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1105  f1fd							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1106  f1fd							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1107  f1fd							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1108  f1fd							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1109  f1fd							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1110  f1fd							;	   1.0s hover was too long — halved); then the flag clears and
   1111  f1fd							;	   normal gravity resumes (fall ~0.85s after release). State
   1112  f1fd							;	   lives in JetPower, NOT
   1113  f1fd							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1114  f1fd							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1115  f1fd							;	   rising frame — both clobbered a StepsLeft-based float.
   1116  f1fd							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1117  f1fd							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1118  f1fd							;	   (headroom stays $FC67).
   1119  f1fd							; ------------------------------------------------------------------------------
   1120  f1fd		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1121  f1ff		       24 88		      bit	Temp
   1122  f201		       d0 21		      bne	.JetDecay
   1123  f203		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1124  f205		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1125  f207		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1126  f209		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1127  f20b				   .RampStart
   1128  f20b		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1129  f20d		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1130  f20f		       d0 3f		      bne	.Gravity
   1131  f211		       a5 96		      lda	JetPower
   1132  f213		       c9 14		      cmp	#JET_MAX
   1133  f215		       b0 06		      bcs	.JetCapped
   1134  f217		       18		      clc
   1135  f218		       69 01		      adc	#1
   1136  f21a		       4c 1f f2 	      jmp	.JetSet
   1137  f21d				   .JetCapped
   1138  f21d		       a9 14		      lda	#JET_MAX
   1139  f21f				   .JetSet
   1140  f21f		       85 96		      sta	JetPower
   1141  f221		       4c 50 f2 	      jmp	.Gravity
   1142  f224				   .JetDecay		; Up NOT held this frame
   1143  f224		       a5 96		      lda	JetPower
   1144  f226		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1145  f228		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1146  f22a		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1147  f22c		       05 93		      ora	vyLo
   1148  f22e		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1149  f230							;   climb to stop, do NOT float
   1150  f230		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1151  f232		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1152  f234		       4c 50 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1153  f237				   .FloatRun
   1154  f237		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1155  f239		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1156  f23b		       29 7f		      and	#$7F
   1157  f23d		       d0 04		      bne	.FRActive
   1158  f23f		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1159  f241		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1160  f243				   .FRActive
   1161  f243		       a5 94		      lda	vyHi
   1162  f245		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1163  f247		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1164  f249		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1165  f24b		       85 94		      sta	vyHi
   1166  f24d		       4c 8d f2 	      jmp	.Integrate
   1167  f250
   1168  f250							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1169  f250							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1170  f250							;     only — subtracting $80+ would blast the player upward.
   1171  f250				   .Gravity
   1172  f250		       18		      clc
   1173  f251		       a5 93		      lda	vyLo
   1174  f253		       69 08		      adc	#<GRAVITY
   1175  f255		       85 93		      sta	vyLo
   1176  f257		       a5 94		      lda	vyHi
   1177  f259		       69 00		      adc	#>GRAVITY
   1178  f25b		       85 94		      sta	vyHi
   1179  f25d		       a5 96		      lda	JetPower
   1180  f25f		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1181  f261		       38		      sec
   1182  f262		       a5 93		      lda	vyLo
   1183  f264		       e5 96		      sbc	JetPower
   1184  f266		       85 93		      sta	vyLo
   1185  f268		       a5 94		      lda	vyHi
   1186  f26a		       e9 00		      sbc	#0
   1187  f26c		       85 94		      sta	vyHi
   1188  f26e				   .ThrustSkip
   1189  f26e
   1190  f26e							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1191  f26e		       a5 94		      lda	vyHi
   1192  f270		       30 0f		      bmi	.RiseClamp
   1193  f272		       c9 02		      cmp	#>MAX_FALL
   1194  f274		       90 17		      bcc	.Integrate
   1195  f276		       a9 02		      lda	#>MAX_FALL
   1196  f278		       85 94		      sta	vyHi
   1197  f27a		       a9 00		      lda	#<MAX_FALL
   1198  f27c		       85 93		      sta	vyLo
   1199  f27e		       4c 8d f2 	      jmp	.Integrate
   1200  f281				   .RiseClamp
   1201  f281		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1202  f283		       b0 08		      bcs	.Integrate
   1203  f285		       a9 ff		      lda	#$ff
   1204  f287		       85 94		      sta	vyHi
   1205  f289		       a9 00		      lda	#$00
   1206  f28b		       85 93		      sta	vyLo	; vy = -$0100
   1207  f28d
   1208  f28d							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1209  f28d							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1210  f28d							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1211  f28d							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1212  f28d							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1213  f28d							;     resumes (he lifts off). No Up -> hovers in place.
   1214  f28d				   .Integrate
   1215  f28d		       a5 9c		      lda	Hover
   1216  f28f		       f0 13		      beq	.DoInt
   1217  f291		       a5 96		      lda	JetPower
   1218  f293		       c9 09		      cmp	#GRAVITY + 1
   1219  f295		       b0 09		      bcs	.HoverEnd
   1220  f297		       a9 00		      lda	#0
   1221  f299		       85 93		      sta	vyLo
   1222  f29b		       85 94		      sta	vyHi
   1223  f29d		       4c a4 f2 	      jmp	.DoInt
   1224  f2a0				   .HoverEnd
   1225  f2a0		       a9 00		      lda	#0
   1226  f2a2		       85 9c		      sta	Hover
   1227  f2a4				   .DoInt
   1228  f2a4		       18		      clc
   1229  f2a5		       a5 95		      lda	PlayerYSub
   1230  f2a7		       65 93		      adc	vyLo
   1231  f2a9		       85 95		      sta	PlayerYSub
   1232  f2ab		       a9 00		      lda	#0
   1233  f2ad		       65 94		      adc	vyHi
   1234  f2af		       f0 1c		      beq	.NoVMove
   1235  f2b1		       30 0c		      bmi	.UpSteps
   1236  f2b3		       85 97		      sta	StepsLeft	; positive = falling (down)
   1237  f2b5				   .JFalling
   1238  f2b5		       20 55 f3 	      jsr	StepDown
   1239  f2b8		       c6 97		      dec	StepsLeft
   1240  f2ba		       d0 f9		      bne	.JFalling
   1241  f2bc		       4c cd f2 	      jmp	.NoVMove
   1242  f2bf				   .UpSteps
   1243  f2bf		       49 ff		      eor	#$ff
   1244  f2c1		       18		      clc
   1245  f2c2		       69 01		      adc	#1	; magnitude of upward displacement
   1246  f2c4		       85 97		      sta	StepsLeft
   1247  f2c6				   .JRising
   1248  f2c6		       20 8e f3 	      jsr	StepUp
   1249  f2c9		       c6 97		      dec	StepsLeft
   1250  f2cb		       d0 f9		      bne	.JRising
   1251  f2cd				   .NoVMove
   1252  f2cd							; fall through to CheckP0Left (removed redundant jmp — target was next insn, 3c/frame)
   1253  f2cd
