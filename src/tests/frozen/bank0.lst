   2161  f636							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2162  f636							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2163  f636							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2164  f636							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2165  f636							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2166  f636							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2167  f636							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2168  f636							; ==============================================================================
   2169  f636				   SelectActiveObject
   2170  f636							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2171  f636							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2172  f636							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2173  f636							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2174  f636							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2175  f636							; middle of the screen" the moment the points counting started).
   2176  f636		       a5 8a		      lda	DropTarget
   2177  f638		       c9 fe		      cmp	#$FE
   2178  f63a		       d0 2d		      bne	.SOFull
   2179  f63c		       a9 00		      lda	#0
   2180  f63e		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2181  f640		       a9 ff		      lda	#$FF
   2182  f642		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2183  f644							;   `0 = no object` comment was wrong and the
   2184  f644							;   tally-without-miner frame staged ObjTop from
   2185  f644							;   a stale Y, i.e. a stray key sprite)
   2186  f644		       a5 a4		      lda	LevelMinerRoom
   2187  f646		       29 7f		      and	#$7f
   2188  f648		       c5 98		      cmp	RoomNo
   2189  f64a		       f0 03		      beq	.SOTallyMiner
