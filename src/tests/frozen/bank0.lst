   1583  f458							; ------------------------------------------------------------------------------
   1584  f458							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1585  f458							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1586  f458							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1587  f458							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1588  f458							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1589  f458							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1590  f458							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1591  f458							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1592  f458							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1593  f458							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1594  f458							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1595  f458							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1596  f458							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1597  f458							; ------------------------------------------------------------------------------
   1598  f458				   UE_Tentacle
   1599  f458		       a5 ad		      lda	TickCounter
   1600  f45a		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1601  f45c							; = half the player's 1 px/frame (user
   1602  f45c							; 2026-10-10: &3 read as chunky/slow)
   1603  f45c		       d0 4b		      bne	.TentOut
   1604  f45e		       b5 bd		      lda	EnemyRamX,X
   1605  f460		       c5 80		      cmp	RoomX
   1606  f462		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1607  f464		       90 06		      bcc	.TentRight
   1608  f466		       38		      sec
   1609  f467		       e9 01		      sbc	#1	; step left
   1610  f469		       4c 6f f4 	      jmp	.TentProbe
   1611  f46c				   .TentRight
   1612  f46c		       18		      clc
   1613  f46d		       69 01		      adc	#1	; step right
   1614  f46f				   .TentProbe
   1615  f46f		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1616  f471		       b0 36		      bcs	.TentOut
   1617  f473		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1618  f475							; Same-column cull: committed X is always probe-clear, so a candidate in
   1619  f475							; the same 4px column covers the same collision cells → result is known
   1620  f475							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1621  f475		       a5 88		      lda	Temp
   1622  f477		       55 bd		      eor	EnemyRamX,X
   1623  f479		       29 fc		      and	#$FC
   1624  f47b		       f0 28		      beq	.TentCommit
   1625  f47d		       a5 80		      lda	RoomX
   1626  f47f		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1627  f481		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1628  f483		       85 b8		      sta	ActiveObjectY
   1629  f485		       a5 88		      lda	Temp
   1630  f487		       c9 05		      cmp	#5
   1631  f489		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1632  f48b							; PHM's negative visible-left wraps to 255
   1633  f48b							; (col garbage / ColOff OOB walk). cand<=4
   1634  f48b							; ink pokes off-screen anyway; RoomX=cand
   1635  f48b							; already covers cell0.
