   2275  f6bf							; This slot is the miner
   2276  f6bf		       a9 55		      lda	#OBJ_MINER	; miner design offset into ObjSprites
   2277  f6c1		       85 b6		      sta	ObjBase
   2278  f6c3		       a9 10		      lda	#OBJ_WINDOW	; miner design height
   2279  f6c5		       85 9d		      sta	ObjHeight
