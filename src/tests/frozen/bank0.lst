   2276  f66f		       29 03		      and	#3
   2277  f671		       d0 17		      bne	.SOCount	; 3 of 4 -> miner/enemy
   2278  f673		       a9 65		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   2279  f675		       85 b6		      sta	ObjBase
   2280  f677		       a9 08		      lda	#OBJ_BOMB_H	; bomb design height (8-row art; OBJ_WINDOW
   2281  f679							;   would draw the RAFT rows underneath)
   2282  f679		       85 9d		      sta	ObjHeight
   2283  f67b		       a5 f6		      lda	BombX
