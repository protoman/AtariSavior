    993  f187							; ==============================================================================
    994  f187							; HUD band: 48 scanlines (144-191)
    995  f187							; Uses 13+2 sprite technique via bank1 (fold-pad trampoline)
    996  f187							; ==============================================================================
    997  f187
    998  f187							; --- Call bank1 for 13+2 HUD rendering via fold-pad at $FC68 ---
    999  f187							; The fold-pad at $FC68 has identical bytes in bank0 and bank1:
   1000  f187							;   $FC68: lda #1 / sta $1FF7 / jmp $F540
   1001  f187							; After sta $1FF7, CPU reads next instruction from bank1 at $FC6D.
   1002  f187							; Bank1's $FC6D has the same jmp $F540 → seamless bank switch.
   1003  f187		       4c 68 fc 	      jmp	$FC68	; jump to fold-pad (switches to bank1, runs MenuMain)
   1004  f18a							; Bank1's MenuMain returns to bank0 via: lda #0 / sta $1FF6 / jmp Overscan
   1005  f18a
   1006  f18a							; ==============================================================================
   1007  f18a							; Overscan (30 scanlines) — input handling + game logic
   1008  f18a							; ==============================================================================
   1009  f18a				   Overscan
   1010  f18a		       a9 02		      lda	#2
   1011  f18c		       85 01		      sta	VBLANK	; turn on VBLANK during overscan
   1012  f18e
   1013  f18e							; --- Set TIM64T for overscan ---
   1014  f18e							; P3.4: overscan work worst 2104c (heavy, enemy room, rect cache in) →
   1015  f18e							; #50 = 3200c = 1096c headroom (was #35 = 2240c = 136c — positive but
   1016  f18e							; too tight for transition frames). V(#23)+O(#50) = 73 units = 262 lines.
   1017  f18e		       a9 32		      lda	#50
   1018  f190		       8d 96 02 	      sta	TIM64T
   1019  f193
   1020  f193							; --- Write live Y → EnemyRamY ($E2-$E4; window-safe since S3.4: this
   1021  f193							; runs after the HUD score-ptr stomp, before every reader) ---
   1022  f193		       20 7e fd 	      jsr	RefreshEnemyY
   1023  f196
   1024  f196							; --- Read joystick ---
   1025  f196							; SWCHA bits: D4=up, D5=down, D6=left, D7=right (0=pressed)
   1026  f196							; After 4x LSR: D0=up, D1=down, D2=left, D3=right
   1027  f196		       ad 80 02 	      lda	SWCHA
   1028  f199		       4a		      lsr		; shift joystick 0 bits to D0-D3
   1029  f19a		       4a		      lsr
   1030  f19b		       4a		      lsr
   1031  f19c		       4a		      lsr
   1032  f19d		       85 88		      sta	Temp	; save shifted joystick bits
   1033  f19f
   1034  f19f							; --- Spawn drop-in gate: while falling from the top (DropTarget != 0)
   1035  f19f							;     ALL input/physics/collision is bypassed -> DropStep only. ---
   1036  f19f		       a5 8a		      lda	DropTarget
   1037  f1a1		       f0 03		      beq	.NormalGame	; idle -> normal play (adjacent, 3c/2c)
   1038  f1a3		       4c 09 fd 	      jmp	DropStep	; tail-jumps back to OverscanAudio
   1039  f1a6				   .NormalGame
   1040  f1a6
   1041  f1a6							; --- Bomb: edge-detect Down (D1, 0=pressed) ---
   1042  f1a6		       a5 88		      lda	Temp
   1043  f1a8		       29 02		      and	#%00000010
   1044  f1aa		       f0 09		      beq	.BombHeld
   1045  f1ac		       a5 b5		      lda	BombPacked	; released: clear DownPrev (b2), keep state/mask
   1046  f1ae		       29 fb		      and	#%11111011
   1047  f1b0		       85 b5		      sta	BombPacked
   1048  f1b2		       4c f4 f1 	      jmp	.BombInDone
   1049  f1b5				   .BombHeld
   1050  f1b5		       a5 b5		      lda	BombPacked
   1051  f1b7		       29 04		      and	#%00000100
   1052  f1b9		       d0 39		      bne	.BombInDone	; held since last frame — no edge
   1053  f1bb		       a5 b5		      lda	BombPacked
   1054  f1bd		       29 03		      and	#%00000011
   1055  f1bf		       d0 2d		      bne	.BombMarkDown	; bomb already active: just set DownPrev
   1056  f1c1		       a5 f0		      lda	PlayerBombs
   1057  f1c3		       29 07		      and	#%00000111	; b2-0 = bombs; b7-3 are the raft's ramp state
   1058  f1c5		       f0 27		      beq	.BombMarkDown	; no bombs left: swallow edge, keep DownPrev
   1059  f1c7		       a5 b5		      lda	BombPacked
   1060  f1c9		       29 80		      and	#%10000000	; b7 OnGround — drop only when standing
   1061  f1cb		       f0 21		      beq	.BombMarkDown	; flying/falling: swallow edge, keep DownPrev
   1062  f1cd		       c6 f0		      dec	PlayerBombs
   1063  f1cf		       a5 b5		      lda	BombPacked	; rising edge, state=0 → drop
   1064  f1d1		       09 05		      ora	#%00000101	; state=1 + DownPrev
   1065  f1d3		       85 b5		      sta	BombPacked
   1066  f1d5		       a5 80		      lda	RoomX
   1067  f1d7		       85 f6		      sta	BombX
   1068  f1d9		       a5 81		      lda	RoomY
   1069  f1db		       85 85		      sta	BombY
   1070  f1dd		       a9 b4		      lda	#180
   1071  f1df		       85 f7		      sta	BombTimer
   1072  f1e1		       a5 f6		      lda	BombX	; position P1 ONCE here (overscan, timer-gated);
   1073  f1e3		       a2 01		      ldx	#1	;   bomb X is constant during the straight fall,
   1074  f1e5		       20 0f ff 	      jsr	SetObjectXPos	;   so VBL bomb path skips SOXP (its WSYNC shifted
   1075  f1e8							;   the re-anchor phase = +1-line pump on bt0)
   1076  f1e8		       20 02 fc 	      jsr	CallPad_BombSndDrop	; S10: short blip on place
   1077  f1eb		       4c f4 f1 	      jmp	.BombInDone
   1078  f1ee				   .BombMarkDown
   1079  f1ee		       a5 b5		      lda	BombPacked
   1080  f1f0		       09 04		      ora	#%00000100
   1081  f1f2		       85 b5		      sta	BombPacked
   1082  f1f4				   .BombInDone
