   2075  f59a		       d0 39		      bne	.BTDone
   2076  f59c		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2077  f59e		       29 fc		      and	#%11111100
   2078  f5a0		       85 b5		      sta	BombPacked
   2079  f5a2		       a9 00		      lda	#0
   2080  f5a4		       85 f7		      sta	BombTimer
   2081  f5a6		       60		      rts
   2082  f5a7				   .BTFuse
   2083  f5a7		       c6 f7		      dec	BombTimer
   2084  f5a9		       d0 2a		      bne	.BTDone
   2085  f5ab		       a5 b5		      lda	BombPacked	; 1 → 2
   2086  f5ad		       29 fc		      and	#%11111100
   2087  f5af		       09 02		      ora	#%00000010
   2088  f5b1		       85 b5		      sta	BombPacked
   2089  f5b3		       a9 3c		      lda	#60
   2090  f5b5		       85 f7		      sta	BombTimer
   2091  f5b7		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2092  f5ba		       aa		      tax
   2093  f5bb		       f0 08		      beq	.BTNoScore
   2094  f5bd				   .BTScore
   2095  f5bd		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2096  f5bf		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2097  f5c2		       ca		      dex
   2098  f5c3		       d0 f8		      bne	.BTScore
   2099  f5c5				   .BTNoScore
   2100  f5c5		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
