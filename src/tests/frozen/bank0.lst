   4541  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4542  ff27		       8a		      txa
   4543  ff28		       29 80		      and	#LASER_HELD
   4544  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4545  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4546  ff2d		       85 c0		      sta	LaserState
   4547  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4548  ff31		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4549  ff33							; below — moved here so the cap code could
