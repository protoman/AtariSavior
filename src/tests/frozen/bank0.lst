   4467  feb4							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4468  feb4							;   pose ($FE must take the real-fall path)
   4469  feb4		       a9 02		      lda	#2
   4470  feb6		       20 08 fc 	      jsr	CallPad_SaveKey	; SaveKey CHECKPOINT: {Level, lives, score} at the
   4471  feb9							;   start of the new stage. Past the last stage
