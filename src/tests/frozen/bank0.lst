    436 U00bc		       00 00	   COLOR_CAVE_BG =	$00	; black interior
    437 U00bc		       00 84	   COLOR_CAVE_WALL =	$84	; hue 8 luma 2 = dark grey-blue
    438 U00bc		       00 06	   COLOR_HUD_BG =	$06	; hue 0 luma 3 = grey
    439 U00bc		       00 1e	   COLOR_TIMER =	$1E	; hue 1 luma 7 = yellow
    440 U00bc		       00 c6	   COLOR_LIVES =	$C6	; hue 12 luma 3 = green
    441 U00bc		       00 46	   COLOR_BOMBS =	$46	; hue 4 luma 3 = red
    442 U00bc		       00 0e	   COLOR_SCORE =	$0E	; hue 0 luma 7 = white
    443 U00bc		       00 6a	   COLOR_TITLE =	$6A	; hue 6 luma 5 = purple (title text)
