   3718  ffe0		       00 00 00 00*	      .ds	$FFE6 - *, 0	; pin TallyTramp (BeamMask moved to $FExx
   3719  ffe6							; freed 12B here — drift must not move it)
   3720  ffe6							; ------------------------------------------------------------------------------
   3721  ffe6							; TallyTramp ($FFE6, byte-identical with bank2 — guard: check_moth_tramp).
   3722  ffe6							; bank0 jsr's here (CheckMinerPickup arm / TallyWork step): `sta $1FF8`
   3723  ffe6							; selects bank2, then the jmp operand is fetched from bank2's image at the
   3724  ffe6							; same PC (FoldIndirect discipline). The bank2 body tail-jmps ReturnPad
   3725  ffe6							; ($FBF8) -> rts back to the bank0 jsr. Ends $FFEB — $FFF2-$FFF9 stay fill
   3726  ffe6							; (F6 hotspot mirrors).
   3727  ffe6							; ------------------------------------------------------------------------------
   3728  ffe6		       f3 13	   TallyEntry =	$F313	; bank2 TallyEntry — operand must match label
   3729  ffe6				   TallyTramp
   3730  ffe6		       8d f8 1f 	      sta	$1FF8
   3731  ffe9		       4c 13 f3 	      jmp	TallyEntry
   3732  ffec
   3733  ffec							; ------------------------------------------------------------------------------
   3734  ffec							; HotOverlapFlag — bank3 entry tramp (A3 2026-10-19). Moved off $FE90 (bank3
   3735  ffec							; $FE93 belongs to OvShutBand's .OSline) into the 6-byte gap after
   3736  ffec							; TallyTramp. bank0 executes `sta $1FF9`; the `jmp` at +3 is fetched from
   3737  ffec							; bank3's image at $FFEF (guard: check_moth_tramp).
   3738  ffec							; ------------------------------------------------------------------------------
   3739  ffec					      .ds	$FFEC - *, 0
