   2010  f598				   BombTick   subroutine
   2011  f598		       a5 b5		      lda	BombPacked
   2012  f59a		       29 03		      and	#%00000011	; state
   2013  f59c		       f0 41		      beq	.BTDone	; none
   2014  f59e		       c9 01		      cmp	#1
   2015  f5a0		       f0 0f		      beq	.BTFuse
   2016  f5a2							; state 2 — exploding
   2017  f5a2		       c6 f7		      dec	BombTimer
   2018  f5a4		       d0 39		      bne	.BTDone
   2019  f5a6		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2020  f5a8		       29 fc		      and	#%11111100
   2021  f5aa		       85 b5		      sta	BombPacked
   2022  f5ac		       a9 00		      lda	#0
