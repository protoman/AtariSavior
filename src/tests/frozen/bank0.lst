   3907  fea2		       f0 05		      beq	.TNoScore
   3908  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3909  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3910  fea9				   .TNoScore
   3911  fea9		       98		      tya
   3912  feaa		       29 04		      and	#4
   3913  feac		       f0 1e		      beq	.TLive
