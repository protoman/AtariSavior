   1201  f20a							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1202  f20a							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1203  f20a							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1204  f20a							;	   catches the fall in ~10 frames from terminal $0180.
   1205  f20a							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1206  f20a							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1207  f20a							;	   gone: it kept thrust below gravity for ~32 frames.
   1208  f20a							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1209  f20a							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1210  f20a							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1211  f20a							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1212  f20a							;	   1.0s hover was too long — halved); then the flag clears and
   1213  f20a							;	   normal gravity resumes (fall ~0.85s after release). State
   1214  f20a							;	   lives in JetPower, NOT
   1215  f20a							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1216  f20a							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1217  f20a							;	   rising frame — both clobbered a StepsLeft-based float.
   1218  f20a							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1219  f20a							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1220  f20a							;	   (headroom stays $FC67).
   1221  f20a							; ------------------------------------------------------------------------------
   1222  f20a		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1223  f20c		       24 88		      bit	Temp
   1224  f20e		       d0 25		      bne	.JetDecay
   1225  f210		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1226  f212		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1227  f214		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1228  f216		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1229  f218				   .JetRamp
   1230  f218							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1231  f218							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1232  f218							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1233  f218							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1234  f218							; ~80 frames = more than a room height of extra falling). The ramp only
   1235  f218							; applies from rest / while already rising, so take-off still eases in.
   1236  f218		       a5 94		      lda	vyHi
   1237  f21a		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1238  f21c		       05 93		      ora	vyLo
   1239  f21e		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1240  f220		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1241  f222		       85 96		      sta	JetPower
   1242  f224		       4c 61 f2 	      jmp	.Gravity
   1243  f227				   .JetClimb
   1244  f227		       a5 96		      lda	JetPower
   1245  f229		       c9 30		      cmp	#JET_MAX
   1246  f22b		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1247  f22d		       18		      clc
   1248  f22e		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1249  f230		       85 96		      sta	JetPower
   1250  f232		       4c 61 f2 	      jmp	.Gravity
   1251  f235				   .JetDecay		; Up NOT held this frame
   1252  f235		       a5 96		      lda	JetPower
   1253  f237		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1254  f239		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1255  f23b		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1256  f23d		       05 93		      ora	vyLo
   1257  f23f		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1258  f241							;   climb to stop, do NOT float
   1259  f241		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1260  f243		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1261  f245		       4c 61 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
