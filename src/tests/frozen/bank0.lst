   2245  f654		       85 07		      sta	COLUP1
   2246  f656		       4c 37 f7 	      jmp	.SODone
   2247  f659				   .SOFull
   2248  f659		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2249  f65b							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2250  f65b		       a5 b5		      lda	BombPacked
   2251  f65d		       29 03		      and	#%00000011
   2252  f65f		       c9 01		      cmp	#1
