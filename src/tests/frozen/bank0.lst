    710  f0d2							; ==============================================================================
    711  f0d2							; Kernel: 192 visible scanlines
    712  f0d2							; ==============================================================================
    713  f0d2							; Structure:
    714  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    715  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    716  f0d2							;
    717  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    718  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
    719  f0d2							; ==============================================================================
    720  f0d2
