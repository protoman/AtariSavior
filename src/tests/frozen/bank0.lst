   2203  f626							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2204  f626							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2205  f626							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2206  f626							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2207  f626							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2208  f626							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2209  f626							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2210  f626							; ==============================================================================
   2211  f626				   SelectActiveObject
   2212  f626							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2213  f626							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2214  f626							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2215  f626							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2216  f626							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2217  f626							; middle of the screen" the moment the points counting started).
   2218  f626		       a5 8a		      lda	DropTarget
   2219  f628		       c9 fe		      cmp	#$FE
   2220  f62a		       d0 2d		      bne	.SOFull
   2221  f62c		       a9 00		      lda	#0
   2222  f62e		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2223  f630		       a9 ff		      lda	#$FF
   2224  f632		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2225  f634							;   `0 = no object` comment was wrong and the
   2226  f634							;   tally-without-miner frame staged ObjTop from
   2227  f634							;   a stale Y, i.e. a stray key sprite)
   2228  f634		       a5 a4		      lda	LevelMinerRoom
   2229  f636		       29 7f		      and	#$7f
   2230  f638		       c5 98		      cmp	RoomNo
   2231  f63a		       f0 03		      beq	.SOTallyMiner
   2232  f63c		       4c 37 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2233  f63f				   .SOTallyMiner
   2234  f63f		       a9 55		      lda	#OBJ_MINER
   2235  f641		       85 b6		      sta	ObjBase
   2236  f643		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2237  f645		       85 9d		      sta	ObjHeight
   2238  f647		       a5 a5		      lda	MinerX
   2239  f649		       85 b7		      sta	ActiveObjectX
   2240  f64b		       a5 a6		      lda	MinerY
   2241  f64d		       18		      clc
