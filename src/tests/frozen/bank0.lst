   3726  fd78							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3727  fd78							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3728  fd78							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3729  fd78							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3730  fd78							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3731  fd78							; DeriveEnemyY — no persistent movement state exists in RAM.
   3732  fd78							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3733  fd78							; block after the pads; pre-pad headroom is 1B).
   3734  fd78							; ------------------------------------------------------------------------------
   3735  fd78				   RefreshEnemyY
   3736  fd78
   3737  fd78		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3738  fd7a							; TickCounter is the 60-frame GAME timer
   3739  fd7a							; (decrements 60->1, reloads) — gates derived
   3740  fd7a							; from it wrapped every second (spider
   3741  fd7a							; "teleported": (TC>>3)&63 only ever saw
   3742  fd7a							; 0..7 and counted DOWN 0->7 = jump).
   3743  fd7a		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3744  fd7c		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3745  fd7e				   .REYLoop		; every reader runs after refresh completes)
   3746  fd7e		       ca		      dex
   3747  fd7f		       20 90 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3748  fd82		       95 e2		      sta	EnemyRamY,X
   3749  fd84		       8a		      txa		; N/Z must come from X: flags after jsr are
   3750  fd85		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3751  fd87				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3752  fd87							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3753  fd87							; black rooms, broken PF, invisible sprites)
   3754  fd87							; --- SELECT or RESET held → back to the old title / level-select screen
   3755  fd87							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3756  fd87							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3757  fd87							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3758  fd87							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3759  fd87							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3760  fd87							;     RESET held past LANDING still re-fires — press must be released
   3761  fd87							;     before the drop-in finishes. ---
   3762  fd87		       a5 8a		      lda	DropTarget
   3763  fd89		       d0 1d		      bne	.REYRts	; not idle: not ours
   3764  fd8b		       ad 82 02 	      lda	SWCHB
   3765  fd8e		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3766  fd90		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3767  fd92		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3768  fd94		       f0 12		      beq	.REYRts	; neither pressed
   3769  fd96		       a9 ff		      lda	#$FF
   3770  fd98		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3771  fd9a		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   3772  fd9c		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
