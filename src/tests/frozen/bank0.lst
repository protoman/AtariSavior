   3820  fca5							; CheckBandTouch — overscan: if band on and sprite touches the water strip →
   3821  fca5							; life. Strip = bottom ~12 lines of the cave (bottom_band_plan rule 2);
   3822  fca5							; sprite origin RoomY >= 115 enters it (115 + 21 = 136 = the same feet
   3823  fca5							; depth the 12-row sprite had at 125).
   3824  fca5							; Same path as hot/enemy: lose life, then respawn 12 scanlines up (min 0).
   3825  fca5							; Band color = VBLANK-staged RoomBandColor ($D2, PF1Buf[3] dead-row alias;
   3826  fca5							; staged by the VBLANK fold from LevelEnemy+RoomNo*4+3 — a kernel-time fold
   3827  fca5							; overruns the .WaterRow line). Read inlined here and in .WaterRow (0 = off).
   3828  fca5							; ------------------------------------------------------------------------------
   3829  fca5				   CheckBandTouch
   3830  fca5		       a5 bc		      lda	RoomBandColor
