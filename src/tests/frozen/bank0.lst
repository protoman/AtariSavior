   2606  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2607  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2608  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2609  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2610  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2611  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2612  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2613  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2614  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2615  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2616  f980							; before — same ZP, no new allocation).
   2617  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2618  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2619  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2620  f980		       a5 8d		      lda	CollisionCellY
   2621  f982		       85 92		      sta	RectCount
   2622  f984				   .CWRow
   2623  f984		       a5 8e		      lda	CollisionEndX
   2624  f986		       85 8b		      sta	CollisionX
   2625  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2626  f989							;   was re-loaded every cell — −8c/cell walk
   2627  f989							;   trim for the falling+probe heavy frame)
   2628  f989				   .CWCol
   2629  f989		       a4 92		      ldy	RectCount
   2630  f98b		       98		      tya
   2631  f98c		       18		      clc
   2632  f98d		       7d a9 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2633  f990		       a8		      tay
   2634  f991		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2635  f994		       3d bd fd 	      and	ColMask,X	; bit for this source col
   2636  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2637  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2638  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2639  f99d		       e8		      inx
   2640  f99e		       86 8b		      stx	CollisionX
   2641  f9a0		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
   2642  f9a2				   .CWRowDone
   2643  f9a2		       a5 92		      lda	RectCount
   2644  f9a4		       c5 8f		      cmp	CollisionEndY	; row == bottom?
