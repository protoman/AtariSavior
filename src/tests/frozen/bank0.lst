   1685  f466		       c9 05		      cmp	#5
   1686  f468		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1687  f46a							; PHM's negative visible-left wraps to 255
   1688  f46a							; (col garbage / ColOff OOB walk). cand<=4
   1689  f46a							; ink pokes off-screen anyway; RoomX=cand
   1690  f46a							; already covers cell0.
