   3507  ff0f							; ==============================================================================
   3508  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3509  ff0f							; ==============================================================================
   3510  ff0f							; Andrew Davie session-24 routine:
   3511  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3512  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3513  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3514  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3515  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3516  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3517  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3518  ff0f							;
   3519  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3520  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3521  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3522  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3523  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3524  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3525  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3526  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3527  ff0f				   SetObjectXPos subroutine
   3528  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   3529  ff11		       38		      sec		; ensure carry flag
   3530  ff12				   .Div15Loop
   3531  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   3532  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   3533  ff16		       a8		      tay		; Y = remainder in -15..-1
   3534  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   3535  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   3536  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   3537  ff1e		       60		      rts
   3538  ff1f
   3539  ff20					      org	$FF20
   3540  ff20
   3541  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   3542  ff20				   SetObjReflection
   3543  ff20		       a9 00		      lda	#0
   3544  ff22		       85 0c		      sta	REFP1
   3545  ff24		       a5 b6		      lda	ObjBase
   3546  ff26		       c9 38		      cmp	#OBJ_MINER
   3547  ff28		       d0 08		      bne	.SORdone
   3548  ff2a		       a5 a4		      lda	LevelMinerRoom
   3549  ff2c		       10 04		      bpl	.SORdone
   3550  ff2e		       a9 08		      lda	#$08
   3551  ff30		       85 0c		      sta	REFP1
   3552  ff32				   .SORdone
   3553  ff32		       60		      rts
   3554  ff33
   3555  ff33							; ------------------------------------------------------------------------------
   3556  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3557  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3558  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3559  ff33							; user spec: no piercing, no HERO comparison needed).
   3560  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3561  ff33							;						  left	RoomX-4)
   3562  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3563  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3564  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3565  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3566  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3567  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3568  ff33							;     priority over M0 anyway).
   3569  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3570  ff33							;     press edge re-anchors).
   3571  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3572  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3573  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3574  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3575  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3576  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
