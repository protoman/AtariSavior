   2683  f814		       49 01		      eor	#1
   2684  f816		       aa		      tax
   2685  f817		       c5 b3		      cmp	EnemyCount
   2686  f819		       b0 0c		      bcs	.SOSkipNone	; no such enemy
   2687  f81b		       a5 ba		      lda	EnemyDeadMask
   2688  f81d		       3d c9 f3 	      and	EnemyBitTable,X
   2689  f820		       d0 05		      bne	.SOSkipNone	; partner dead too
   2690  f822		       86 b9		      stx	EnemyIndex
   2691  f824		       4c f5 f6 	      jmp	.SOEnemyLive
   2692  f827				   .SOSkipNone
