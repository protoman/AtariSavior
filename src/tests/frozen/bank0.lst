    493 U00bc							; ==============================================================================
    494 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    495 U00bc							; ==============================================================================
    496 U00bc							; Bank3 is the power-up bank. Its stub does:
    497 U00bc							;   lda #0 / sta $1FF4 → selects bank0
    498 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    499 U00bc							; ==============================================================================
    500  10000 ????				       seg	code
    501  f000					      org	$F000
    502  f000
    503  f000							; --- 5-byte bankswitching pad ---
    504  f000							; After bank3's stub selects us, CPU arrives here.
    505  f000							; We jump over the pad into the real init code.
    506  f000		       a9 00		      lda	#0
    507  f002		       8d f4 1f 	      sta	$1FF4	; ensure bank0 selected (idempotent)
    508  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    509  f008							; (NOT deletable: $F008 = GameStart is a
    510  f008							;  hardcoded cross-bank entry — bank1
    511  f008							;  stub `jmp $F008`; this jmp also keeps
    512  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    513  f008							;  fold-pad byte guard fires when it moves)
    514  f008							;  + F0xx landmarks fixed)
    515  f008
    516  f008				   GameStart
    517  f008		       78		      sei		; disable interrupts
    518  f009		       d8		      cld		; clear decimal mode
    519  f00a		       a2 ff		      ldx	#$FF
    520  f00c		       9a		      txs		; stack pointer = $FF
    521  f00d
    522  f00d							; --- Clear zero-page RAM ---
    523  f00d		       a9 00		      lda	#0
    524  f00f		       a2 80		      ldx	#$80
    525  f011				   .ClearZP
    526  f011		       95 00		      sta	$00,X
    527  f013		       e8		      inx
    528  f014		       d0 fb		      bne	.ClearZP
    529  f016
    530  f016							; --- Initialize game state --- (ClearZP left A = 0 and Level = 0)
    531  f016		       a9 03		      lda	#3
    532  f018		       85 ac		      sta	PlayerLives
    533  f01a		       a9 05		      lda	#BOMBS_MAX
    534  f01c		       85 f0		      sta	PlayerBombs
    535  f01e							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s (50 on PAL: the same
    536  f01e							; 120 real seconds at 50 Hz)
    537  f01e		       a9 3c		      lda	#TICKS_PER_SEC
    538  f020		       85 ad		      sta	TickCounter
    539  f022		       a9 78		      lda	#120
    540  f024		       85 ae		      sta	BarLevel	; bar starts full
    541  f026		       a9 00		      lda	#0
    542  f028		       20 08 fc 	      jsr	CallPad_SaveKey	; SaveKey BOOT: Level := the saved stage (the
    543  f02b							;   title then comes up on it); no key = no-op
    544  f02b							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    545  f02b							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    546  f02b							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    547  f02b							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    548  f02b							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    549  f02b		       a9 ff		      lda	#$FF
    550  f02d		       85 8a		      sta	DropTarget
    551  f02f
    552  f02f							; --- Load first level (the title previews it on the live stage:
    553  f02f							;     LoadLevel leaves the player at the level start, no flight) ---
    554  f02f		       20 20 fc 	      jsr	LoadLevel
    555  f032
    556  f032							; --- Set player color ---
    557  f032		       a9 48		      lda	#COLOR_PLAYER
    558  f034		       85 06		      sta	COLUP0
    559  f036
    560  f036							; --- Set playfield to reflected mode + priority ---
    561  f036							; D0=1 = reflect (left half mirrors to right)
    562  f036							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    563  f036							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    564  f036							; disabled at kernel entry, size only matters once Phase 3 enables it)
    565  f036		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    566  f038		       85 0a		      sta	CTRLPF
    567  f03a
    568  f03a							; ==============================================================================
    569  f03a							; Frame loop
    570  f03a							; ==============================================================================
    571  f03a				   StartFrame
    572  f03a
    573  f03a							; ------------------------------------------------------------------------------
    574  f03a							; VSYNC (3 scanlines)
    575  f03a							; ------------------------------------------------------------------------------
    576  f03a							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    577  f03a							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    578  f03a							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    579  f03a							; does not advance the wall clock to the next scanline boundary (it is already
    580  f03a							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    581  f03a							; fraction depends on where the previous frame's overscan happened to end) —
    582  f03a							; the whole screen shifted up 1 scanline on those frames = the jitter.
    583  f03a							;
    584  f03a							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    585  f03a							; the next scanline boundary (even if we were already at it — the store is 3c
    586  f03a							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    587  f03a							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    588  f03a							; the sim wall-model target is updated to match.
    589  f03a		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    590  f03c		       a9 02		      lda	#2
    591  f03e		       85 00		      sta	VSYNC
    592  f040		       85 02		      sta	WSYNC
    593  f042		       85 02		      sta	WSYNC
    594  f044		       85 02		      sta	WSYNC
    595  f046		       a9 00		      lda	#0
    596  f048		       85 00		      sta	VSYNC
    597  f04a
    598  f04a							; ------------------------------------------------------------------------------
    599  f04a							; VBLANK (37 scanlines)
    600  f04a							; ------------------------------------------------------------------------------
    601  f04a		       a9 02		      lda	#2
    602  f04c		       85 01		      sta	VBLANK	; turn on VBLANK
    603  f04e
    604  f04e							; --- Set TIM64T for VBLANK ---
    605  f04e							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    606  f04e							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    607  f04e							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    608  f04e							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    609  f04e							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    610  f04e							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    611  f04e							; Worst 1059c of the 1472c window = 413c margin.
    612  f04e							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    613  f04e							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    614  f04e							; 2026-10-25: #23 -> #31 (flicker hunt, bugs.md #16). With #23 a room whose
    615  f04e							; GRP1 objects alternate (FlickerFrame) ran the heavy VBL path ~35c PAST
    616  f04e							; the timer on every other frame: the SOXP WSYNC straddled a line edge, the
    617  f04e							; poll exited at once, the entry anchor took the NEXT line -> 270/271 line
    618  f04e							; frames alternating = visible flicker. #24 (+64c) fixed that room, but the
    619  f04e							; two-object phase rooms (level 6 room 4) still overran ~40c on a 16-frame
    620  f04e							; cycle (the object X moves the div15 count) and flipped 271<->272 in
    621  f04e							; blocks. Then the whole-stage sweep (211 rooms) showed ~60 rooms with
    622  f04e							; two enemies + M1/ball patches overrunning by up to 5 lines (4 positioning
    623  f04e							; WSYNCs + the slot-1 staging ~ 1830c effective). The overscan real work is
    624  f04e							; only ~1520c of its 3200c, so the split moved: V #25->#31, O #50->#44 (the
    625  f04e							; V+O sum stays 75 = 272 lines). Result: every shipped room is a constant
    626  f04e							; 272 lines (level 20: constant 273), worst VBL poll slack ~107c.
    627  f04e				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    628  f04e		       a9 1f		      lda	#VBL_UNITS	; 31 on NTSC; PAL adds blank lines (colors.inc)
    629  f050		       8d 96 02 	      sta	TIM64T
    630  f053
    631  f053							; --- Position player sprite horizontally ---
    632  f053		       a5 80		      lda	RoomX
    633  f055		       38		      sec
    634  f056		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    635  f058		       a2 00		      ldx	#0	; X=0 = player0
    636  f05a		       20 0f ff 	      jsr	SetObjectXPos
    637  f05d
    638  f05d							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    639  f05d							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    640  f05d							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    641  f05d							; now stages BallX into Temp; this block reads the staged copy. ---
    642  f05d
    643  f05d							; --- No sprite copy needed — kernel reads directly from ROM ---
    644  f05d							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    645  f05d							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    646  f05d							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    647  f05d
    648  f05d							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    649  f05d							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    650  f05d							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    651  f05d							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    652  f05d							; records are level data in bank2/bank3, so the type byte is fetched
    653  f05d							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    654  f05d		       20 30 f6 	      jsr	SelectActiveObject
    655  f060
    656  f060							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    657  f060							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    658  f060							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    659  f060							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    660  f060							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    661  f060							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    662  f060		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    663  f063
    664  f063							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    665  f063							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    666  f063							; 2026-10-04 up-exit fix). The
    667  f063							; old per-frame VBL fold that re-read the same ROM byte is
    668  f063							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    669  f063							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    670  f063							; the VBL path (the read that made a bank3 data move need another
    671  f063							; reader). test_band_restage covers the contract.
    672  f063
    673  f063							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    674  f063							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    675  f063							; Dark room: black except the existing explosion blink (state=2).
    676  f063							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    677  f063							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    678  f063							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    679  f063							; no reader between this point and overscan's own `sta Temp` (joystick).
    680  f063		       a5 b5		      lda	BombPacked
    681  f065		       29 03		      and	#%00000011
    682  f067		       c9 02		      cmp	#2
    683  f069		       f0 0a		      beq	.BgBlink
    684  f06b		       20 0e fc 	      jsr	CallPad_IsRoomDark
    685  f06e		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    686  f070		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    687  f072		       4c 85 f0 	      jmp	.BgStore
    688  f075				   .BgBlink
    689  f075							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    690  f075							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    691  f075							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    692  f075							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    693  f075							; 60 frames = exact 15 cycles, starts black at explosion.
    694  f075		       a9 3c		      lda	#60
    695  f077		       38		      sec
    696  f078		       e5 f7		      sbc	BombTimer
    697  f07a		       29 03		      and	#3
    698  f07c		       a8		      tay
    699  f07d		       b9 f6 f5 	      lda	BombBlinkColors,Y
    700  f080		       4c 85 f0 	      jmp	.BgStore
    701  f083				   .BgIdle
    702  f083		       a9 00		      lda	#COLOR_CAVE_BG
    703  f085				   .BgStore
    704  f085		       85 09		      sta	COLUBK
    705  f087
    706  f087							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    707  f087							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    708  f087							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    709  f087							; M1X (LevelEnemySpare2; 0 → no M1) — ball selector 4, M1 selector 3,
    710  f087							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    711  f087							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
