   4451  fe96		       8d f6 1f 	      sta	$1FF6	; select bank2
   4452  fe99		       4c 00 ff 	      jmp	$FF00	; bank2 LaserHitTestBody (dead in bank0; guard
   4453  fe9c							;   pins operands == bank2.lst label)
