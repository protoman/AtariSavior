   1047  f1b7		       29 04		      and	#%00000100
   1048  f1b9		       d0 39		      bne	.BombInDone	; held since last frame — no edge
   1049  f1bb		       a5 b5		      lda	BombPacked
   1050  f1bd		       29 03		      and	#%00000011
   1051  f1bf		       d0 2d		      bne	.BombMarkDown	; bomb already active: just set DownPrev
   1052  f1c1		       a5 f0		      lda	PlayerBombs
   1053  f1c3		       29 07		      and	#%00000111	; b2-0 = bombs; b7-3 are the raft's ramp state
   1054  f1c5		       f0 27		      beq	.BombMarkDown	; no bombs left: swallow edge, keep DownPrev
   1055  f1c7		       a5 b5		      lda	BombPacked
