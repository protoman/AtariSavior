   1709  f4f6		       4a		      lsr
   1710  f4f7		       4a		      lsr
   1711  f4f8		       4a		      lsr
   1712  f4f9		       29 0f		      and	#$0f
   1713  f4fb		       c9 0f		      cmp	#$0f
   1714  f4fd		       f0 07		      beq	.NoUp
   1715  f4ff		       20 d0 fb 	      jsr	EnterRoom
   1716  f502		       a9 84		      lda	#PLAYER_MAX_Y
   1717  f504		       85 81		      sta	RoomY	; enter at the bottom edge
   1718  f506				   .NoUp
