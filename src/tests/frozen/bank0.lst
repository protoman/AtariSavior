   2230  f68b		       85 07		      sta	COLUP1
   2231  f68d		       4c 49 f7 	      jmp	.SODone	; ObjTop/Bot from ActiveObjectY
   2232  f690				   .SOCount
   2233  f690							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   2234  f690		       a5 b3		      lda	EnemyCount
   2235  f692		       85 88		      sta	Temp
   2236  f694		       a5 a4		      lda	LevelMinerRoom
   2237  f696		       29 7f		      and	#$7f
   2238  f698		       c5 98		      cmp	RoomNo
   2239  f69a		       d0 02		      bne	.SONoMiner
   2240  f69c		       e6 88		      inc	Temp	; miner counts as a slot
   2241  f69e				   .SONoMiner
   2242  f69e		       a5 88		      lda	Temp
   2243  f6a0		       d0 09		      bne	.SONotNothing
   2244  f6a2							; No objects this frame: A = Temp = 0. Blank the sprite AND reset the
   2245  f6a2							; flicker counter — with no objects the modulo below never runs, so
   2246  f6a2							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   2247  f6a2							; would run O(FlickerFrame) iterations in the VBL on the next room with
   2248  f6a2							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   2249  f6a2		       85 b4		      sta	FlickerFrame
   2250  f6a4		       a9 ff		      lda	#$FF
   2251  f6a6		       85 b6		      sta	ObjBase
