   2462  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2463  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2464  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2465  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2466  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2467  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2468  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2469  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2470  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2471  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2472  f980							; before — same ZP, no new allocation).
   2473  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2474  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2475  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2476  f980		       a5 8d		      lda	CollisionCellY
   2477  f982		       85 92		      sta	RectCount
   2478  f984				   .CWRow
   2479  f984		       a5 8e		      lda	CollisionEndX
   2480  f986		       85 8b		      sta	CollisionX
   2481  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2482  f989							;   was re-loaded every cell — −8c/cell walk
   2483  f989							;   trim for the falling+probe heavy frame)
   2484  f989				   .CWCol
   2485  f989		       a4 92		      ldy	RectCount
   2486  f98b		       98		      tya
   2487  f98c		       18		      clc
   2488  f98d		       7d a8 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2489  f990		       a8		      tay
   2490  f991		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2491  f994		       3d bc fd 	      and	ColMask,X	; bit for this source col
   2492  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2493  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2494  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2495  f99d		       e8		      inx
   2496  f99e		       86 8b		      stx	CollisionX
   2497  f9a0		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
   2498  f9a2				   .CWRowDone
   2499  f9a2		       a5 92		      lda	RectCount
   2500  f9a4		       c5 8f		      cmp	CollisionEndY	; row == bottom?
   2501  f9a6		       f0 07		      beq	.CWNoHit
   2502  f9a8		       e6 92		      inc	RectCount
   2503  f9aa		       d0 d8		      bne	.CWRow	; always (row never wraps to 0)
   2504  f9ac				   .CWHit
   2505  f9ac		       4c ec ff 	      jmp	HotOverlapFlag	; C=1 contract; hot rects unchanged (ROM stream)
   2506  f9af				   .CWNoHit
   2507  f9af							; Phase 4: miss → asym-patch overlay (push-neutral tramp, moth pattern).
   2508  f9af							; OverlayTramp gates on LineCount ($84 = packed byte, VBL/$8F staged):
   2509  f9af							; symmetric rooms pay +8c and return here-shaped clc/rts; asym rooms
   2510  f9af							; cross to bank2 PHMOverlay (patch column + band mask), exit via
   2511  f9af							; ReturnPad $FBF8 — rts pops THIS call's return (0 pushes total, SP
   2512  f9af							; guard unchanged). Overlay sets C itself (plain sec — patch cells are
   2513  f9af							; envelope-guaranteed non-hot, so HotOverlapFlag must not run).
   2514  f9af		       4c b8 f9 	      jmp	OverlayTramp
