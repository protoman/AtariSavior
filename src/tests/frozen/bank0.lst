   3465  fda3							; ------------------------------------------------------------------------------
   3466  fda3							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3467  fda3							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3468  fda3							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3469  fda3							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3470  fda3							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3471  fda3							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3472  fda3							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3473  fda3							;   tools/test_cell_map.py).
   3474  fda3							;   (The standalone CellSolid leaf that lived here moved INTO
   3475  fda3							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3476  fda3							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3477  fda3							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3478  fda3							; ------------------------------------------------------------------------------
   3479  fda3		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3480  fdb7		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3481  fdc3		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3482  fdcb
   3483  fdcb							; ------------------------------------------------------------------------------
   3484  fdcb							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3485  fdcb							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3486  fdcb							; is fetched from bank2's byte-identical mirror at this same address and
   3487  fdcb							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3488  fdcb							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3489  fdcb							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3490  fdcb							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3491  fdcb							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3492  fdcb							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3493  fdcb							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3494  fdcb							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3495  fdcb							; ------------------------------------------------------------------------------
   3496  fdcb		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3497  fdd8				   BombEnemyBlast
   3498  fdd8		       8d f8 1f 	      sta	$1FF8
   3499  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3500  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3501  fdde							;   span)
   3502  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3503  fdde							;   latch + feature gate pushed +14; same day
   3504  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3505  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3506  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3507  fdde							;   garbage path's `inc $4A,X` set wall bits
   3508  fdde							;   via $CA)
   3509  fdde
