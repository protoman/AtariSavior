   4330  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   4331  ff00							; ==============================================================================
   4332  ff00					      org	$FF00
   4333  ff00				   fineAdjustBegin
   4334  ff00		       70		      .byte.b	%01110000	; left 7
   4335  ff01		       60		      .byte.b	%01100000	; left 6
   4336  ff02		       50		      .byte.b	%01010000	; left 5
   4337  ff03		       40		      .byte.b	%01000000	; left 4
   4338  ff04		       30		      .byte.b	%00110000	; left 3
   4339  ff05		       20		      .byte.b	%00100000	; left 2
   4340  ff06		       10		      .byte.b	%00010000	; left 1
   4341  ff07		       00		      .byte.b	%00000000	; no movement
   4342  ff08		       f0		      .byte.b	%11110000	; right 1
   4343  ff09		       e0		      .byte.b	%11100000	; right 2
   4344  ff0a		       d0		      .byte.b	%11010000	; right 3
   4345  ff0b		       c0		      .byte.b	%11000000	; right 4
   4346  ff0c		       b0		      .byte.b	%10110000	; right 5
   4347  ff0d		       a0		      .byte.b	%10100000	; right 6
   4348  ff0e		       90		      .byte.b	%10010000	; right 7
