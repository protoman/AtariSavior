   4272  feb0		       a9 00		      lda	#0
   4273  feb2		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4274  feb4							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4275  feb4							;   pose ($FE must take the real-fall path)
   4276  feb4							; 2026-11: the SaveKey CHECKPOINT (I2C) and LoadLevel (~3600c) no longer run
   4277  feb4							; here - together they overran this overscan by ~10 scanlines. LevelConnSpare
   4278  feb4							; = $C0 (pending + b6 = "new stage") makes the frame END in bank5's blank
   4279  feb4							; transition frame, which runs SaveKey op 2 (CHECKPOINT: {Level, lives,
   4280  feb4							; score} at the start of the new stage; past the last stage it commits the
   4281  feb4							; high score, erases the save and RESTARTS at the title) and then LoadLevel.
   4282  feb4							; LoadLevel leaves BarLevel/TickCounter alone, so they reset right here.
   4283  feb4		       a9 c0		      lda	#$C0
