   4047  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   4048  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   4049  fd61		       f0 0e		      beq	.TWmusic
