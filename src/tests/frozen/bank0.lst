   4233  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4234  ff27		       8a		      txa
   4235  ff28		       29 80		      and	#LASER_HELD
   4236  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4237  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4238  ff2d		       85 c0		      sta	LaserState
   4239  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4240  ff31		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4241  ff33							; below — moved here so the cap code could
   4242  ff33							; not push .LaserReleased past bmi's ±127)
   4243  ff33				   .LaserReleased
   4244  ff33		       a9 00		      lda	#0
