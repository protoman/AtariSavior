   4319  ff0f							; ==============================================================================
   4320  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4321  ff0f							; ==============================================================================
   4322  ff0f							; Andrew Davie session-24 routine:
   4323  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4324  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4325  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4326  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4327  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4328  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4329  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4330  ff0f							;
   4331  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4332  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4333  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4334  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4335  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4336  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4337  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4338  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4339  ff0f				   SetObjectXPos subroutine
   4340  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4341  ff11		       38		      sec		; ensure carry flag
   4342  ff12				   .Div15Loop
   4343  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4344  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4345  ff16		       a8		      tay		; Y = remainder in -15..-1
   4346  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4347  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4348  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4349  ff1e		       60		      rts
   4350  ff1f
   4351  ff20					      org	$FF20
   4352  ff20
   4353  ff20							; ------------------------------------------------------------------------------
   4354  ff20							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4355  ff20							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4356  ff20							; the facing until contact, then resets to the eye (single missile, KISS —
   4357  ff20							; user spec: no piercing, no HERO comparison needed).
   4358  ff20							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4359  ff20							;						  left	RoomX-4)
   4360  ff20							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4361  ff20							;     wrap) -> reset to eye (unsigned check catches both)
   4362  ff20							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4363  ff20							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4364  ff20							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4365  ff20							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4366  ff20							;     priority over M0 anyway).
   4367  ff20							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4368  ff20							;     press edge re-anchors).
   4369  ff20							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4370  ff20							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4371  ff20							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4372  ff20							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4373  ff20							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4374  ff20							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4375  ff20							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4376  ff20							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4377  ff20							; ------------------------------------------------------------------------------
   4378  ff20				   LaserInput
   4379  ff20		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4380  ff22		       8a		      txa
   4381  ff23		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4382  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4383  ff27		       8a		      txa
   4384  ff28		       29 80		      and	#LASER_HELD
   4385  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4386  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4387  ff2d		       85 c0		      sta	LaserState
   4388  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4389  ff31		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4390  ff33							; below — moved here so the cap code could
   4391  ff33							; not push .LaserReleased past bmi's ±127)
   4392  ff33				   .LaserReleased
   4393  ff33		       a9 00		      lda	#0
   4394  ff35		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4395  ff37							; otherwise -> bars slid across screen
   4396  ff37		       60		      rts		; LaserX kept; next press edge re-anchors
   4397  ff38				   .LaserFire
   4398  ff38		       a5 c0		      lda	LaserState
   4399  ff3a		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4400  ff3c		       85 c0		      sta	LaserState
   4401  ff3e		       8a		      txa
   4402  ff3f		       29 80		      and	#LASER_HELD
   4403  ff41		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4404  ff43							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4405  ff43							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4406  ff43							; step would jump out of the 8px wall with no candidate ever inside it
   4407  ff43							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4408  ff43							; here (b7 held from the ora above). Open-hold cadence alternates
   4409  ff43							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4410  ff43		       a5 c0		      lda	LaserState
   4411  ff45		       29 01		      and	#LASER_REARM
   4412  ff47		       f0 04		      beq	.LAdvStep
   4413  ff49		       c6 c0		      dec	LaserState
   4414  ff4b		       d0 3a		      bne	.LaserInit
   4415  ff4d							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4416  ff4d							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4417  ff4d							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4418  ff4d							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4419  ff4d							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4420  ff4d				   .LAdvStep
   4421  ff4d		       a4 82		      ldy	PlayerDir
   4422  ff4f		       a5 83		      lda	LaserX
