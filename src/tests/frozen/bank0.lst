   2406  f767		       e5 81		      sbc	RoomY	; (Scanline-RoomY) - ObjTopRel < OBJ_WINDOW =
   2407  f769		       85 bb		      sta	ObjTop	; Scanline-(RoomY+ObjTopRel); parking ObjTopRel
   2408  f76b		       4c e5 fb 	      jmp	StageSlot1	; = 144-RoomY → Scanline-144 ∈ [112,255] →
