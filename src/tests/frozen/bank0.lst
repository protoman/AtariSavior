   4499  fef0				   UE_MothTramp
   4500  fef0		       8d f6 1f 	      sta	$1FF6	; select bank2
   4501  fef3		       4c 10 f1 	      jmp	$F110	; bank2 MothRoutine (dead in bank0; guard pins
   4502  fef6							;   bank0/bank2 operands == bank2.lst label)
   4503  fef6					      .ds	$FEF6 - *, 0	; pin address (main size drift must not move it)
