   1738  f4e3		       49 ff		      eor	#$FF
   1739  f4e5		       38		      sec
   1740  f4e6		       e9 cf		      sbc	#$CF	; 48-p = (255-p)-207, up phase (p 25..47)
   1741  f4e8		       4c c6 f4 	      jmp	DEYDelta
