   1957  f620		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1958  f622		       b0 03		      bcs	.CMPDone	; no Y overlap
   1959  f624							; Pickup! Arm the level-bonus tally (frozen count-up, then advance).
   1960  f624							; TallyArm (bank2, via TallyTramp) snapshots time/bombs/lives into
   1961  f624							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
   1962  f624							; TallyWork, whose done path does the old tail (level++/LoadLevel/bar).
   1963  f624		       20 e6 ff 	      jsr	TallyTramp
