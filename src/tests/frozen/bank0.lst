   3814  ffe0		       00 00 00 00*	      .ds	$FFE6 - *, 0	; pin TallyTramp (BeamMask moved to $FExx
   3815  ffe6							; freed 12B here — drift must not move it)
   3816  ffe6							; ------------------------------------------------------------------------------
   3817  ffe6							; TallyTramp ($FFE6, byte-identical with bank2 — guard: check_moth_tramp).
   3818  ffe6							; bank0 jsr's here (CheckMinerPickup arm / TallyWork step): `sta $1FF8`
   3819  ffe6							; selects bank2, then the jmp operand is fetched from bank2's image at the
   3820  ffe6							; same PC (FoldIndirect discipline). The bank2 body tail-jmps ReturnPad
   3821  ffe6							; ($FBF8) -> rts back to the bank0 jsr. Ends $FFEB — $FFF2-$FFF9 stay fill
   3822  ffe6							; (F6 hotspot mirrors).
   3823  ffe6							; ------------------------------------------------------------------------------
   3824  ffe6		       f3 13	   TallyEntry =	$F313	; bank2 TallyEntry — operand must match label
   3825  ffe6				   TallyTramp
   3826  ffe6		       8d f8 1f 	      sta	$1FF8
   3827  ffe9		       4c 13 f3 	      jmp	TallyEntry
