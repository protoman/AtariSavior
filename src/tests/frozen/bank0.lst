   1907  f4f4							; Miner pickup — check if player overlaps miner, advance to next level
   1908  f4f4							; ==============================================================================
   1909  f4f4				   CheckMinerPickup
   1910  f4f4		       a5 a4		      lda	LevelMinerRoom
   1911  f4f6		       29 7f		      and	#$7f
   1912  f4f8		       c5 98		      cmp	RoomNo
   1913  f4fa		       d0 1b		      bne	.CMPDone	; not in miner's room
   1914  f4fc							; X overlap: player [RoomX, +6] vs 4px miner.
   1915  f4fc							; Accept iff RoomX - MinerX in [-6, +3].
   1916  f4fc		       a5 80		      lda	RoomX
   1917  f4fe		       38		      sec
   1918  f4ff		       e5 a5		      sbc	MinerX
   1919  f501		       18		      clc
   1920  f502		       69 06		      adc	#PLAYER_WIDTH - 1
   1921  f504		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1922  f506		       b0 0f		      bcs	.CMPDone	; no X overlap
   1923  f508							; Y overlap: player [RoomY, +11] vs miner [MinerY, +11]
   1924  f508							; accept iff RoomY - MinerY in [-11, +11]  (add 11, compare 23)
   1925  f508		       a5 81		      lda	RoomY
   1926  f50a		       38		      sec
   1927  f50b		       e5 a6		      sbc	MinerY
   1928  f50d		       18		      clc
   1929  f50e		       69 15		      adc	#PLAYER_SPRITE_H - 1
   1930  f510		       c9 2b		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
