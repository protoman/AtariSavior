   2224  f630							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2225  f630							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2226  f630							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2227  f630							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2228  f630							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2229  f630							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2230  f630							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2231  f630							; ==============================================================================
   2232  f630				   SelectActiveObject
   2233  f630							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2234  f630							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2235  f630							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2236  f630							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2237  f630							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2238  f630							; middle of the screen" the moment the points counting started).
   2239  f630		       a5 8a		      lda	DropTarget
   2240  f632		       c9 fe		      cmp	#$FE
   2241  f634		       d0 2d		      bne	.SOFull
   2242  f636		       a9 00		      lda	#0
   2243  f638		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2244  f63a		       a9 ff		      lda	#$FF
   2245  f63c		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2246  f63e							;   `0 = no object` comment was wrong and the
   2247  f63e							;   tally-without-miner frame staged ObjTop from
   2248  f63e							;   a stale Y, i.e. a stray key sprite)
   2249  f63e		       a5 a4		      lda	LevelMinerRoom
   2250  f640		       29 7f		      and	#$7f
   2251  f642		       c5 98		      cmp	RoomNo
   2252  f644		       f0 03		      beq	.SOTallyMiner
   2253  f646		       4c 41 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2254  f649				   .SOTallyMiner
   2255  f649		       a9 55		      lda	#OBJ_MINER
   2256  f64b		       85 b6		      sta	ObjBase
   2257  f64d		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2258  f64f		       85 9d		      sta	ObjHeight
   2259  f651		       a5 a5		      lda	MinerX
   2260  f653		       85 b7		      sta	ActiveObjectX
   2261  f655		       a5 a6		      lda	MinerY
   2262  f657		       18		      clc
