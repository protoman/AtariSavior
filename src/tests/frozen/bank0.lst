    413 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    414 U00bc							; ==============================================================================
    415 U00bc							; Bank3 is the power-up bank. Its stub does:
    416 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    417 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    418 U00bc							; ==============================================================================
    419  10000 ????				       seg	code
    420  f000					      org	$F000
    421  f000
    422  f000							; --- 5-byte bankswitching pad ---
    423  f000							; After bank3's stub selects us, CPU arrives here.
    424  f000							; We jump over the pad into the real init code.
    425  f000		       a9 00		      lda	#0
    426  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    427  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    428  f008							; (NOT deletable: $F008 = GameStart is a
    429  f008							;  hardcoded cross-bank entry — bank1
    430  f008							;  stub `jmp $F008`; this jmp also keeps
    431  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    432  f008							;  fold-pad byte guard fires when it moves)
    433  f008							;  + F0xx landmarks fixed)
    434  f008
    435  f008				   GameStart
    436  f008		       78		      sei		; disable interrupts
    437  f009		       d8		      cld		; clear decimal mode
    438  f00a		       a2 ff		      ldx	#$FF
    439  f00c		       9a		      txs		; stack pointer = $FF
    440  f00d
    441  f00d							; --- Clear zero-page RAM ---
    442  f00d		       a9 00		      lda	#0
    443  f00f		       a2 80		      ldx	#$80
    444  f011				   .ClearZP
    445  f011		       95 00		      sta	$00,X
    446  f013		       e8		      inx
    447  f014		       d0 fb		      bne	.ClearZP
    448  f016
    449  f016							; --- Initialize game state ---
    450  f016		       a9 00		      lda	#0
    451  f018		       85 a3		      sta	Level
    452  f01a		       a9 03		      lda	#3
    453  f01c		       85 ac		      sta	PlayerLives
    454  f01e		       a9 05		      lda	#BOMBS_MAX
    455  f020		       85 f0		      sta	PlayerBombs
    456  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    457  f022		       a9 3c		      lda	#60
    458  f024		       85 ad		      sta	TickCounter
    459  f026		       a9 78		      lda	#120
    460  f028		       85 ae		      sta	BarLevel	; bar starts full
    461  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    462  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    463  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    464  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    465  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    466  f02a		       a9 ff		      lda	#$FF
    467  f02c		       85 8a		      sta	DropTarget
    468  f02e
    469  f02e							; --- Load first level (the title previews it on the live stage:
    470  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    471  f02e		       20 2f f5 	      jsr	LoadLevel
