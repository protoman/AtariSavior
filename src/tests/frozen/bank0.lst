   2518  f940		       e5 82		      sbc	PlayerDir
   2519  f942		       c9 0f		      cmp	#15
   2520  f944		       b0 06		      bcs	.off7
   2521  f946		       38		      sec
   2522  f947		       e9 04		      sbc	#4	; P0 target <15: visible left = X - 4
   2523  f949		       4c 4e f9 	      jmp	.gotVL
   2524  f94c				   .off7
   2525  f94c		       e9 07		      sbc	#7	; P0 target >=15: visible left = X - 7
   2526  f94e				   .gotVL
   2527  f94e		       18		      clc
   2528  f94f		       65 82		      adc	PlayerDir	; reflected sprite's first lit bit is column 1
