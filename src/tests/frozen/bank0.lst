   3886  fe9c							; ------------------------------------------------------------------------------
   3887  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3888  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3889  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3890  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3891  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3892  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3893  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3894  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3895  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3896  fe9c							; ------------------------------------------------------------------------------
   3897  fe9c				   TallyWork
   3898  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3899  fe9f		       a8		      tay
   3900  fea0		       29 01		      and	#1
   3901  fea2		       f0 05		      beq	.TNoScore
   3902  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3903  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3904  fea9				   .TNoScore
   3905  fea9		       98		      tya
   3906  feaa		       29 04		      and	#4
   3907  feac		       f0 1e		      beq	.TLive
   3908  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3909  feb0		       a5 a3		      lda	Level
   3910  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3911  feb4		       d0 04		      bne	.TNotWrap
   3912  feb6		       a9 00		      lda	#0	; wrap past last level
   3913  feb8		       85 a3		      sta	Level
   3914  feba				   .TNotWrap
   3915  feba		       a9 00		      lda	#0
   3916  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3917  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3918  febe							;   pose ($FE must take the real-fall path)
   3919  febe		       20 20 fc 	      jsr	LoadLevel
   3920  fec1		       a9 78		      lda	#120	; reset timer for new level
   3921  fec3		       85 ae		      sta	BarLevel
   3922  fec5		       a9 3c		      lda	#60
   3923  fec7		       85 ad		      sta	TickCounter
   3924  fec9		       4c 30 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3925  fecc				   .TLive
   3926  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3927  fecf		       a9 00		      lda	#0
   3928  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3929  fed3				   .TWait
   3930  fed3		       ad 84 02 	      lda	INTIM
   3931  fed6		       d0 fb		      bne	.TWait
   3932  fed8		       4c 39 f0 	      jmp	StartFrame
