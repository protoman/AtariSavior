   1763  f470		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1764  f472							; sits 5/7 px left of A (moth .Mvl convention,
   1765  f472							; bank2), but PHM's PLAYER prologue derives
   1766  f472							; lit-left = arg-4/arg-7 with the bin on
   1767  f472							; RoomX-PlayerDir → box missed the cell left
   1768  f472							; of the ink at cand 8/12 (sprite drew 1 px
   1769  f472							; into the wall — bugs.md #4). cand-1 shifts
   1770  f472							; the tested box 1 px left: cell-exact or 1 px
   1771  f472							; conservative for every cand/facing pair
   1772  f472							; (tools/test_cell_map.py tentacle section).
