    506  f039							; ==============================================================================
    507  f039							; Frame loop
    508  f039							; ==============================================================================
    509  f039				   StartFrame
    510  f039
    511  f039							; ------------------------------------------------------------------------------
    512  f039							; VSYNC (3 scanlines)
    513  f039							; ------------------------------------------------------------------------------
    514  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    515  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    516  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    517  f039							; does not advance the wall clock to the next scanline boundary (it is already
    518  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    519  f039							; fraction depends on where the previous frame's overscan happened to end) —
    520  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    521  f039							;
    522  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    523  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    524  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    525  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    526  f039							; the sim wall-model target is updated to match.
    527  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    528  f03b		       a9 02		      lda	#2
    529  f03d		       85 00		      sta	VSYNC
    530  f03f		       85 02		      sta	WSYNC
    531  f041		       85 02		      sta	WSYNC
    532  f043		       85 02		      sta	WSYNC
    533  f045		       a9 00		      lda	#0
    534  f047		       85 00		      sta	VSYNC
    535  f049
    536  f049							; ------------------------------------------------------------------------------
    537  f049							; VBLANK (37 scanlines)
    538  f049							; ------------------------------------------------------------------------------
    539  f049		       a9 02		      lda	#2
    540  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    541  f04d
    542  f04d							; --- Set TIM64T for VBLANK ---
    543  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    544  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    545  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    546  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    547  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    548  f04d		       a9 17		      lda	#23
    549  f04f		       8d 96 02 	      sta	TIM64T
    550  f052
    551  f052							; --- Position player sprite horizontally ---
    552  f052		       a5 80		      lda	RoomX
    553  f054		       38		      sec
    554  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    555  f057		       a2 00		      ldx	#0	; X=0 = player0
    556  f059		       20 0f ff 	      jsr	SetObjectXPos
    557  f05c
    558  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    559  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    560  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    561  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    562  f05c
    563  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    564  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    565  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    566  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    567  f05c
    568  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    569  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    570  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    571  f05c		       20 04 f6 	      jsr	SelectActiveObject
    572  f05f
    573  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    574  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    575  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    576  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    577  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    578  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    579  f05f		       20 32 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    580  f062
    581  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    582  f062							; EnterRoomB2 (+3 of the RoomEnemies record — the 2026-10-04 up-exit
    583  f062							; fix). The old per-frame VBL fold that re-read the same ROM byte is
    584  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    585  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    586  f062							; the VBL path (the read that made a bank3 data move need another
    587  f062							; reader). test_band_restage covers the contract.
    588  f062
    589  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    590  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    591  f062							; Dark room: black except the existing explosion blink (state=2).
    592  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    593  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    594  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    595  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    596  f062		       a5 b5		      lda	BombPacked
    597  f064		       29 03		      and	#%00000011
    598  f066		       c9 02		      cmp	#2
    599  f068		       f0 0a		      beq	.BgBlink
    600  f06a		       20 20 fc 	      jsr	CallPad_IsRoomDark
    601  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    602  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    603  f071		       4c 84 f0 	      jmp	.BgStore
    604  f074				   .BgBlink
    605  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    606  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    607  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    608  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    609  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    610  f074		       a9 3c		      lda	#60
    611  f076		       38		      sec
    612  f077		       e5 f7		      sbc	BombTimer
    613  f079		       29 03		      and	#3
    614  f07b		       a8		      tay
    615  f07c		       b9 17 f8 	      lda	BombBlinkColors,Y
    616  f07f		       4c 84 f0 	      jmp	.BgStore
    617  f082				   .BgIdle
    618  f082		       a9 00		      lda	#COLOR_CAVE_BG
    619  f084				   .BgStore
    620  f084		       85 09		      sta	COLUBK
    621  f086
    622  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    623  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    624  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    625  f086							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    626  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    627  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    628  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    629  f086		       20 c4 f9 	      jsr	PositionBallM1
    630  f089
    631  f089							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    632  f089							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    633  f089							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    634  f089							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    635  f089							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    636  f089							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    637  f089							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    638  f089							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    639  f089		       a5 c2		      lda	EnemyRamP
    640  f08b		       29 f0		      and	#$F0
    641  f08d		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    642  f08f		       4a		      lsr
    643  f090		       4a		      lsr
    644  f091		       4a		      lsr
    645  f092		       4a		      lsr		; A = p (1..15)
    646  f093		       c9 08		      cmp	#8
    647  f095		       90 04		      bcc	.TideTri
    648  f097		       a9 00		      lda	#0	; rest phase p8-15
