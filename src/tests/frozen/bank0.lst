   3971  fd36							; ------------------------------------------------------------------------------
   3972  fd36							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3973  fd36							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3974  fd36							; selected level number (digits band) and the credits; the theme plays here.
   3975  fd36							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3976  fd36							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3977  fd36							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3978  fd36							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3979  fd36							;	    the intro exit ate the first press and made #2 read as dead)
   3980  fd36							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3981  fd36							;	    the real drop-in → gameplay starts
   3982  fd36							; ($FD reaches here directly — merged title, 2026-10-19.)
   3983  fd36							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3984  fd36							; title-owned; the first play frame rewrites it as the step budget).
   3985  fd36							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3986  fd36							; ------------------------------------------------------------------------------
   3987  fd36				   TitleWork
   3988  fd36							; --- SELECT edge (TitleSelect, fill region) ---
   3989  fd36		       20 4f fc 	      jsr	CallPad_TitleSelect
   3990  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   3991  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3992  fd3e				   .TWselDone
   3993  fd3e							; --- RESET edge ---
   3994  fd3e		       a5 97		      lda	StepsLeft
   3995  fd40		       29 01		      and	#%00000001
   3996  fd42		       f0 14		      beq	.TWrstDone
   3997  fd44		       ad 82 02 	      lda	SWCHB
   3998  fd47		       29 01		      and	#%00000001
   3999  fd49		       d0 0d		      bne	.TWrstDone
   4000  fd4b		       a9 00		      lda	#0
   4001  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   4002  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   4003  fd51		       85 f4		      sta	ScoreHu
   4004  fd53		       85 f5		      sta	ScoreTe
   4005  fd55		       20 20 fc 	      jsr	LoadLevel
   4006  fd58				   .TWrstDone
   4007  fd58		       ad 82 02 	      lda	SWCHB
   4008  fd5b		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   4009  fd5d							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   4010  fd5d							;     channel force-muted here — UpdateJetSound is skipped because
   4011  fd5d							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   4012  fd5d							;     = 0, AUDV0 covered above). ---
   4013  fd5d				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   4014  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   4015  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   4016  fd61		       f0 0e		      beq	.TWmusic
