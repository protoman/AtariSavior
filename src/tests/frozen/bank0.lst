    906  f0f8							; Sits in the setup window's free tail (~59c after PF2, before the WSYNC
    907  f0f8							; that ends the pass, so the phased stores above never move). The early
    908  f0f8							; out costs 5c; Slot1Hook pays 2 extra lines ONLY on the band that hosts
    909  f0f8							; slot 1 (SetObjectXPos WSYNC line + the HMOVE line).
    910  f0f8		       a5 ea		      lda	ObjBase1	; $FF = none. `bmi` is still valid HERE (slot 1
    911  f0fa		       30 03		      bmi	Slot1Keep	;   only holds an enemy design or the miner,
    912  f0fc							;   all < $80; the bomb never reaches slot 1).
    913  f0fc							;   Slot 0 must use `cmp #$FF` — see .SODone.
    914  f0fc		       4c 66 f7 	      jmp	Slot1Hook	; NOT jsr: when the hook positions P1 it owns
