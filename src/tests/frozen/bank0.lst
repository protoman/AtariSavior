    360 U00bc		       00 0f	   JET_AUD_BASE =	$0F	; engine AUDF base: freq = base - JetPower/8 - sputter
    361 U00bc		       00 08	   JET_AUD_VOL =	$08	; engine volume while Up is held
    362 U00bc		       00 02	   LASER_AUD_C =	2	; laser ch0 control: div-15 tone = low pitch
    363 U00bc		       00 09	   LASER_AUD_V =	9	; laser ch0 volume while fire held
    364 U00bc
    365 U00bc
    366 U00bc
    367 U00bc							; Facing direction of the player sprite's eye
    368 U00bc		       00 00	   FACING_RIGHT =	0
    369 U00bc		       00 01	   FACING_LEFT =	1
    370 U00bc
    371 U00bc							; LaserState bits
    372 U00bc		       00 80	   LASER_HELD =	%10000000	; b7: fire held this frame (INPT4 D7=0)
    373 U00bc		       00 02	   LASER_ARMED =	%00000010	; b1: kernel .Line beam gate (BeamMask $02
    374 U00bc							;   shares b1 — ENAM0 = BeamMask & LaserState)
    375 U00bc		       00 82	   LASER_ON   =	%10000010	; b7+b1 in one ora (held AND armed)
    376 U00bc		       00 3c	   LASER_DARK =	%00111100	; b5-2: RoomDarkMask rooms 4-7 (IsRoomDark/SetRoomDark)
    377 U00bc		       00 01	   LASER_REARM =	%00000001	; b0: contact consumed last frame — next held
    378 U00bc							;   frame re-tests the eye instead of stepping
