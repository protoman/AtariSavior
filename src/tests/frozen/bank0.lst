   3343  fca5							; life. Strip = bottom ~12 lines of the cave (bottom_band_plan rule 2);
   3344  fca5							; sprite origin RoomY >= 125 enters it (125 + PLAYER_SPRITE_H - 1 = 136).
   3345  fca5							; Same path as hot/enemy: lose life, then respawn 12 scanlines up (min 0).
   3346  fca5							; Band color = VBLANK-staged RoomBandColor ($D2, PF1Buf[3] dead-row alias;
   3347  fca5							; staged by the VBLANK fold from LevelEnemy+RoomNo*4+3 — a kernel-time fold
   3348  fca5							; overruns the .WaterRow line). Read inlined here and in .WaterRow (0 = off).
