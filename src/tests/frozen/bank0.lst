   3789  ff4b				   .LaserFire
   3790  ff4b		       a5 c0		      lda	LaserState
   3791  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   3792  ff4f		       85 c0		      sta	LaserState
   3793  ff51		       8a		      txa
   3794  ff52		       29 80		      and	#LASER_HELD
   3795  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   3796  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   3797  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   3798  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   3799  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   3800  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   3801  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   3802  ff56		       a5 c0		      lda	LaserState
   3803  ff58		       29 01		      and	#LASER_REARM
   3804  ff5a		       f0 04		      beq	.LAdvStep
