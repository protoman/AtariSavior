   4191  fff2							; ------------------------------------------------------------------------------
   4192  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   4193  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   4194  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   4195  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   4196  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   4197  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   4198  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   4199  fff2							;   One less push level too (no fold / no pad call inside the body).
   4200  fff2							;   Full behavior docs moved with the body.
   4201  fff2							; ------------------------------------------------------------------------------
   4202  fff2
   4203  fff2							; ==============================================================================
   4204  fff2							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   4205  fff2							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   4206  fff2							; ==============================================================================
   4207  fff2							; ==============================================================================
   4208  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   4209  fffa
   4210  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   4211  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   4212  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
