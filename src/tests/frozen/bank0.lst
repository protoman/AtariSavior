   3404  fd7d							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3405  fd7d							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3406  fd7d							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3407  fd7d							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3408  fd7d							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3409  fd7d							; DeriveEnemyY — no persistent movement state exists in RAM.
   3410  fd7d							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3411  fd7d							; block after the pads; pre-pad headroom is 1B).
   3412  fd7d							; ------------------------------------------------------------------------------
   3413  fd7d				   RefreshEnemyY
   3414  fd7d		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3415  fd7f							; TickCounter is the 60-frame GAME timer
   3416  fd7f							; (decrements 60->1, reloads) — gates derived
   3417  fd7f							; from it wrapped every second (spider
   3418  fd7f							; "teleported": (TC>>3)&63 only ever saw
   3419  fd7f							; 0..7 and counted DOWN 0->7 = jump).
   3420  fd7f		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3421  fd81		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3422  fd83				   .REYLoop		; every reader runs after refresh completes)
   3423  fd83		       ca		      dex
   3424  fd84		       20 79 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3425  fd87		       95 e2		      sta	EnemyRamY,X
   3426  fd89		       8a		      txa		; N/Z must come from X: flags after jsr are
   3427  fd8a		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3428  fd8c				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3429  fd8c							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3430  fd8c							; black rooms, broken PF, invisible sprites)
   3431  fd8c							; --- SELECT or RESET held → back to the old title / level-select screen
   3432  fd8c							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3433  fd8c							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3434  fd8c							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3435  fd8c							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3436  fd8c							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3437  fd8c							;     RESET held past LANDING still re-fires — press must be released
   3438  fd8c							;     before the drop-in finishes. ---
   3439  fd8c		       a5 8a		      lda	DropTarget
   3440  fd8e		       d0 17		      bne	.REYRts	; not idle: not ours
   3441  fd90		       ad 82 02 	      lda	SWCHB
   3442  fd93		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3443  fd95		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3444  fd97		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3445  fd99		       f0 0c		      beq	.REYRts	; neither pressed
   3446  fd9b		       a9 ff		      lda	#$FF
   3447  fd9d		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3448  fd9f		       20 35 f5 	      jsr	LoadLevel	; reload the level-start room for the preview
   3449  fda2		       68		      pla		; drop OUR return address (LoadLevel already
   3450  fda3		       68		      pla		;   popped its own) — tail into TitleWork
   3451  fda4		       4c 37 fd 	      jmp	TitleWork
