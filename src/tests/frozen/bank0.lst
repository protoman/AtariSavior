   3883  fcc1		       a5 8a		      lda	DropTarget
   3884  fcc3		       c9 fd		      cmp	#$FD
   3885  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3886  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3887  fcc7							;   tally cleared to 0 by TallyWork before its
   3888  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3889  fcc7		       a5 81		      lda	RoomY
   3890  fcc9		       85 8a		      sta	DropTarget
   3891  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3892  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3893  fccf		       a9 00		      lda	#0
   3894  fcd1		       85 81		      sta	RoomY
   3895  fcd3		       85 95		      sta	PlayerYSub
   3896  fcd5		       85 93		      sta	vyLo
