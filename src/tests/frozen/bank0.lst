   3249  fcc1		       a5 8a		      lda	DropTarget
   3250  fcc3		       c9 fd		      cmp	#$FD
   3251  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3252  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3253  fcc7							;   tally cleared to 0 by TallyWork before its
   3254  fcc7							;   LoadLevel — same-size swap 2026-10-06)
