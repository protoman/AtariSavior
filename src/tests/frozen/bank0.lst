   2169  f632							; ==============================================================================
   2170  f632							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2171  f632							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2172  f632							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2173  f632							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2174  f632							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2175  f632							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2176  f632							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2177  f632							; ==============================================================================
   2178  f632				   SelectActiveObject
   2179  f632							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2180  f632							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2181  f632							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2182  f632							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2183  f632							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2184  f632							; middle of the screen" the moment the points counting started).
   2185  f632		       a5 8a		      lda	DropTarget
   2186  f634		       c9 fe		      cmp	#$FE
   2187  f636		       d0 2d		      bne	.SOFull
   2188  f638		       a9 00		      lda	#0
   2189  f63a		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2190  f63c		       a9 ff		      lda	#$FF
   2191  f63e		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2192  f640							;   `0 = no object` comment was wrong and the
   2193  f640							;   tally-without-miner frame staged ObjTop from
   2194  f640							;   a stale Y, i.e. a stray key sprite)
   2195  f640		       a5 a4		      lda	LevelMinerRoom
   2196  f642		       29 7f		      and	#$7f
   2197  f644		       c5 98		      cmp	RoomNo
   2198  f646		       f0 03		      beq	.SOTallyMiner
   2199  f648		       4c 45 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2200  f64b				   .SOTallyMiner
   2201  f64b		       a9 55		      lda	#OBJ_MINER
   2202  f64d		       85 b6		      sta	ObjBase
