   1388  f370		       60		      rts
   1389  f371				   .SDAir
   1390  f371		       a5 b5		      lda	BombPacked
   1391  f373		       29 7f		      and	#%01111111	; still falling — not ground
   1392  f375		       85 b5		      sta	BombPacked
   1393  f377		       60		      rts
   1394  f378				   .SDBottom
   1395  f378		       20 db f4 	      jsr	ExitRoomDown
   1396  f37b		       a5 81		      lda	RoomY
   1397  f37d		       c9 84		      cmp	#PLAYER_MAX_Y
   1398  f37f		       d0 0c		      bne	.SDDone	; changed room (EnterRoom cleared b7)
   1399  f381		       a5 b5		      lda	BombPacked
   1400  f383		       09 80		      ora	#%10000000	; no down exit — standing on floor
   1401  f385		       85 b5		      sta	BombPacked
   1402  f387		       a9 00		      lda	#0
