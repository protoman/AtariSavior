   2428  f78f							; ------------------------------------------------------------------------------
   2429  f78f							; SwapSlot1Now — the SAME-BAND pair's mid-band swap (Phase 5b, 2026-10-22).
   2430  f78f							; `jsr`'d from .ObjNoRes when the running A0 reaches ObjSwap (= ObjTop1-1);
   2431  f78f							; lives here (the $F744 fill) because bank0's pre-pad only has 16 B.
   2432  f78f							;
   2433  f78f							; Why it exists: StageSlot1 can pair two candidates only through the band-start
   2434  f78f							; hook when slot 1 is in a HIGHER band. When both live in ONE band (the miner
   2435  f78f							; sitting while an enemy walks past, their drawn windows disjoint by at least
   2436  f78f							; OBJ_WINDOW lines) the object sprite has to change X inside the frame. This is
   2437  f78f							; the one place our kernel does what HERO's line code does continuously
   2438  f78f							; (docs/hero_async.md §2: HMP1 per row + HMOVE inside the line code).
   2439  f78f							;
   2440  f78f							; Cost: 2 SCANLINES (SetObjectXPos' own WSYNC line + the HMOVE line) — the frame
   2441  f78f							; reaches 269 in rooms that use the exception, and both lines show the band's
   2442  f78f							; uniform PF twice. Y is NOT advanced: the trigger line is re-run, so slot 1's
   2443  f78f							; row 0 lands on its own scanline. Y must survive SetObjectXPos (`tay`).
   2444  f78f							; The fine regs of the OTHER objects are cleared before the WSYNC — the
   2445  f78f							; 2026-10-22 lesson in Slot1Hook (a late HMOVE, or a second HMOVE applying the
   2446  f78f							; player's HMP0 again, is the "zig-zag" / "moves one tile at a time" family).
   2447  f78f							; ------------------------------------------------------------------------------
   2448  f78f				   SwapSlot1Now
   2449  f78f							; Entered with `jmp` from the trigger line's `sta WSYNC` (= cycle 0 here).
   2450  f78f		       a9 00		      lda	#0
   2451  f791		       85 20		      sta	HMP0	; clear the fine regs of the OTHER objects
   2452  f793		       85 22		      sta	HMM0	;   (player/laser/ball) — a second HMOVE must
   2453  f795		       85 24		      sta	HMBL	;   not re-apply them (2026-10-22 lesson)
   2454  f797		       a5 ea		      lda	ObjBase1
   2455  f799		       29 7f		      and	#$7F	; strip the same-band flag staged by StageSlot1
   2456  f79b		       85 b6		      sta	ObjBase
   2457  f79d		       a5 eb		      lda	ObjTop1
   2458  f79f		       85 bb		      sta	ObjTop
   2459  f7a1		       a5 ec		      lda	ObjX1
   2460  f7a3		       85 b7		      sta	ActiveObjectX
   2461  f7a5		       a2 01		      ldx	#1
   2462  f7a7		       20 0f ff 	      jsr	SetObjectXPos	; its own WSYNC starts the positioning line
   2463  f7aa		       85 02		      sta	WSYNC	; end of the positioning line
   2464  f7ac		       85 2a		      sta	HMOVE	; cycle 0 of the next line = HBLANK
   2465  f7ae		       4c 15 f1 	      jmp	CaveLine	; that line IS the re-run of A0 = ObjSwap, so
   2466  f7b1							;   slot 1's row 0 keeps its scanline. Entry at
   2467  f7b1							;   cycle ~7 (normal is 8) — Y is untouched
   2468  f7b1							;   (`jmp` skips the loop's dec/bne on purpose:
   2469  f7b1							;   the 2 lost lines are not band lines).
   2470  f7b1
   2471  f7b1							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2472  f7b1							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF7`
   2473  f7b1							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2474  f7b1							; not from here. That is the same FoldIndirect discipline every other tramp
   2475  f7b1							; uses — the twin cannot be skipped or shortened.
   2476  f7b1							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2477  f7b1		       00 00 00 00*	      .ds	$F830 - *, 0	; ObjSprites: 16 rows/type = 144 B (Phase 6).
   2478  f830							; Base low byte $30 + max index 143 = $BF ->
   2479  f830							; `lda ObjSprites,X` stays in ONE page
   2480  f830							; (verify_build guard). The base moved
   2481  f830							; $F850 -> $F830 with the Phase 6 growth so
   2482  f830							; the table still ENDS at the $F8C0 RaftBody
   2483  f830							; pin; the 32 B it took came from the $F744
   2484  f830							; fill freed by the StageSlot1 eviction.
   2485  f830							; 16 rows per type = OBJ_WINDOW, bits 7-4 (col0 = bit7). Offsets come from the
   2486  f830							; OBJ_* EQUs via ObjSpriteOffTable (stride 16). Rows 12-15 of every design are
   2487  f830							; $00 RESERVED for taller art: they draw nothing today, so the window grew
   2488  f830							; with NO visual change. Fill them (and the matching ObjColorTab rows) when a
   2489  f830							; type's art is authored.
