   2212  f660		       85 07		      sta	COLUP1
   2213  f662		       4c 45 f7 	      jmp	.SODone
   2214  f665				   .SOFull
   2215  f665		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2216  f667							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2217  f667		       a5 b5		      lda	BombPacked
   2218  f669		       29 03		      and	#%00000011
   2219  f66b		       c9 01		      cmp	#1
   2220  f66d		       d0 1d		      bne	.SOCount
   2221  f66f		       a5 f7		      lda	BombTimer
   2222  f671		       29 03		      and	#3
