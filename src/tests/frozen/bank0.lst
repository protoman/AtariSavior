   1817  f568							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1818  f568							; LevelDataTable stride: 14 bytes
   1819  f568							;   +0..+2: start_room, start_x, start_y
   1820  f568							;   +3..+5: miner_room (b7 = faces right), miner_x, miner_y
   1821  f568							;   +6..+7: pfdata ptr (lo, hi)
   1822  f568							;   +8..+9: conn ptr (lo, hi)
   1823  f568							;  +10..+11: enemy ptr (lo, hi)
