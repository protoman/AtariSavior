   3630  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3631  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3632  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3633  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3634  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3635  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3636  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3637  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3638  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3639  fe9c							; ------------------------------------------------------------------------------
   3640  fe9c				   TallyWork
   3641  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3642  fe9f		       a8		      tay
   3643  fea0		       29 01		      and	#1
   3644  fea2		       f0 05		      beq	.TNoScore
   3645  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3646  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3647  fea9				   .TNoScore
   3648  fea9		       98		      tya
   3649  feaa		       29 04		      and	#4
   3650  feac		       f0 1e		      beq	.TLive
   3651  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3652  feb0		       a5 a3		      lda	Level
   3653  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3654  feb4		       d0 04		      bne	.TNotWrap
   3655  feb6		       a9 00		      lda	#0	; wrap past last level
   3656  feb8		       85 a3		      sta	Level
   3657  feba				   .TNotWrap
   3658  feba		       a9 00		      lda	#0
   3659  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3660  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3661  febe							;   pose ($FE must take the real-fall path)
   3662  febe		       20 20 fc 	      jsr	LoadLevel
   3663  fec1		       a9 78		      lda	#120	; reset timer for new level
   3664  fec3		       85 ae		      sta	BarLevel
   3665  fec5		       a9 3c		      lda	#60
   3666  fec7		       85 ad		      sta	TickCounter
   3667  fec9		       4c 1b f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3668  fecc				   .TLive
   3669  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3670  fecf		       a9 00		      lda	#0
   3671  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3672  fed3				   .TWait
   3673  fed3		       ad 84 02 	      lda	INTIM
   3674  fed6		       d0 fb		      bne	.TWait
   3675  fed8		       4c 39 f0 	      jmp	StartFrame
