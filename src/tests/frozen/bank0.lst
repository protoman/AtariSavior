   2571  f92b		       b9 01 f9 	      lda	YToRowTable,Y
   2572  f92e		       85 8d		      sta	CollisionCellY	; top tile row
   2573  f930		       18		      clc
   2574  f931		       a5 81		      lda	RoomY
   2575  f933		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   2576  f935		       4a		      lsr
   2577  f936		       4a		      lsr
   2578  f937		       a8		      tay
   2579  f938		       b9 01 f9 	      lda	YToRowTable,Y
   2580  f93b		       85 8f		      sta	CollisionEndY	; bottom tile row
   2581  f93d
