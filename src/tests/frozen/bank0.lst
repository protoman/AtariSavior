   2153  f5f6				   BombBlinkColors
   2154  f5f6		       00		      .byte.b	COLOR_CAVE_BG	; 0 black
   2155  f5f7		       1c		      .byte.b	COLOR_BLINK_Y	; 1 yellow
   2156  f5f8		       44		      .byte.b	COLOR_BLINK_R	; 2 red
   2157  f5f9		       1c		      .byte.b	COLOR_BLINK_Y	; 3 yellow (4-phase blink: b/y/r/y)
