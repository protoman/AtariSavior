    986  f187
    987  f187							; --- Call bank1 for 13+2 HUD rendering via fold-pad at $FC68 ---
    988  f187							; The fold-pad at $FC68 has identical bytes in bank0 and bank1:
    989  f187							;   $FC68: lda #1 / sta $1FF7 / jmp $F540
    990  f187							; After sta $1FF7, CPU reads next instruction from bank1 at $FC6D.
    991  f187							; Bank1's $FC6D has the same jmp $F540 → seamless bank switch.
    992  f187		       4c 68 fc 	      jmp	$FC68	; jump to fold-pad (switches to bank1, runs MenuMain)
    993  f18a							; Bank1's MenuMain returns to bank0 via: lda #0 / sta $1FF6 / jmp Overscan
    994  f18a
