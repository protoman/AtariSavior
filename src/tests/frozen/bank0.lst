    249 U00bc
    250 U00bc							; Rect cache RETIRED (plan C4 / cell_collision_plan 7.1, 2026-10-20).
    251 U00bc							; The solid rect list is no longer emitted and no walker reads a cache:
    252 U00bc							; PlayerHitsMap, LaserWallClamp, the moth walk and BombMarkWalls all test
    253 U00bc							; PF cells. $CC-$DF are FREE (20 B, the "option A" ZP reclaim); $89 stays
    254 U00bc							; allocated as ZPSpare89 so the sequential block above does not shift.
    255 U00bc							; History worth keeping: the cache lived at $CC-$DF because bank1's HUD
    256 U00bc							; writes $E0-$EF every frame — rect4.h on $E0 was zeroed by scorePtr1 and
    257 U00bc							; probes walked through rect4 walls (the $E0 stomp-zone rule still applies
    258 U00bc							; to every persistent byte).
    259 U00bc							; Buffers packed: PF0 $C3-$C5, PF1 $C6-$C8, PF2 $C9-$CB (rows 0-2 only).
    260 U00bc							; ($E0/$E1 are spare/stomp-zone — never persistent bank0 state.)
    261 U00bc
    262 U00bc							; PF cave buffers (copied from ROM during VBLANK, read by kernel via absolute indexed)
    263 U00bc							; These share ZP space with bank1's HUD variables — safe because bank1
    264 U00bc							; runs AFTER the cave kernel. Bank1 overwrites them during HUD band;
    265 U00bc							; VBLANK re-populates them before the next kernel frame.
    266 U00bc		       00 c3	   PF0Buf     =	$C3	; 3 bytes: TilePF0 rows 0-2 (stride-3 data S4.2)
    267 U00bc							; (rows 0-2 pure since S3.4 — Y moved to $E2)
    268 U00bc		       00 c6	   PF1Buf     =	$C6	; rows 0-2 only (S3.1 packed; was $CF)
    269 U00bc		       00 bc	   RoomBandColor =	$BC	; band-color cache (level_bank_plan P2.5) —
    270 U00bc							; own byte since S3.1 (was $D2 = PF1Buf[3];
    271 U00bc							; history: FIX 2026-09-28 was $D1 = PF1Buf[2]
    272 U00bc							; collision → mid-wall gap; alias class now
    273 U00bc							; gone entirely). Writer: VBLANK stage AFTER
    274 U00bc							; LoadPFBuffer/BuildColupF (fold from
    275 U00bc							; LevelEnemy+RoomNo*4+3). Readers: kernel
    276 U00bc							; .WaterRow (direct lda, plain abs = 4c any
    277 U00bc							; address) + overscan CheckBandTouch. Window:
    278 U00bc							; VBL write → kernel + overscan read same
    279 U00bc							; frame ($BC is nobody else's byte) → next
    280 U00bc							; VBL restages.
    281 U00bc		       00 c9	   PF2Buf     =	$C9	; rows 0-2 only (S3.1 packed; was $DB-$E6)
    282 U00bc		       00 e7	   ColupfBuf  =	$E7	; 12 bytes: final COLUPF per tile row (stripe+hot)
    283 U00bc		       00 e5	   FetchPtr   =	$E5	; fold-indirect pointer ($E5 lo, $E6 hi) —
    284 U00bc							; MOVED S3.2 to free $E0 for rect4.h (cache
    285 U00bc							; $CD-$E0 now uniform). Sits in bank1's
    286 U00bc							; stomp zone (scorePtr3-hi/scorePtr4-lo) —
    287 U00bc							; time-partitioned: bank0 stages only inside
    288 U00bc							; VBL/overscan batches, bank1 rebuilds in
    289 U00bc							; HUD after both windows. Contract (fold
    290 U00bc							; wins): stage addr immediately before a
    291 U00bc							; FoldIndirect batch.
    292 U00bc		       00 ed	   BandTab    =	$ED	; Phase 3 asym ball: staged Band0/1/2
    293 U00bc							; ($ff = ball band, $00 = mirror). Written
    294 U00bc							; by bank2 StageBandTab (BuildColupF tail,
    295 U00bc							; every VBL) BEFORE this frame's cave; read
    296 U00bc							; by .Row's ENABL gate; bank1 HUD stomps
    297 U00bc							; $ED-$EF (scbrdTmp etc.) only AFTER the
    298 U00bc							; cave read — staged-only window, like
    299 U00bc							; FetchPtr. Next VBL restages.
    300 U00bc							; Enemy RAM shadow — live X/Y + packed flags. ROM records are read-only.
    301 U00bc							; Sequential vars end at $BB (ObjBot removed S3.0b); $BC = RoomBandColor,
    302 U00bc							; $BD-$BF EnemyRam, $C0 LaserState, $C1-$C2 EnemyRamD/P.
    303 U00bc							; Score lives at $F3-$F5 only ($F6/$F7 = BombX/BombTimer).
    304 U00bc							; EnemyRamY ($E2, 3B) — private bytes since S3.4 (was an alias over
    305 U00bc							; PF0Buf rows 0-2). It deliberately sits INSIDE bank1's HUD stomp zone
    306 U00bc							; ($E0-$EF score ptrs, written every frame) because every write and every
    307 U00bc							; read land inside one safe window:
    308 U00bc							;   [HUD stomp $E2-$E4] → [overscan: RefreshEnemyY/LoadEnemyRam WRITE]
    309 U00bc							;   → [CEH / Laser / moth READ] → [next VBL: SelectActiveObject READ]
    310 U00bc							;   → [HUD stomp ...]. No reader ever sits between the stomp and the write.
    311 U00bc							;   writers: RefreshEnemyY via DeriveEnemyY (overscan entry, EVERY frame —
    312 U00bc							;	      live Y is derived from ROM spawn + EnemyRamP clock, no stored
    313 U00bc							;	      movement state) + LoadEnemyRam (EnterRoom init);
    314 U00bc							;   readers: SelectActiveObject (VBLANK), CheckEnemyHit + LaserHitTest +
    315 U00bc							;	      moth walk (overscan, after the refresh).
    316 U00bc							; Effect: $C3-$C5 = pure PF0Buf rows 0-2, never stomped → the per-frame
    317 U00bc							;   VBL repair (LoadPF0Only, ~130c + 3 folds) is deleted; full
    318 U00bc							;   LoadPFBuffer runs only on EnterRoom (PF1/PF2 rows 0-2 likewise have
    319 U00bc							;   no per-frame writer). bank1 owns $E0-$EF during HUD; bank0 never keeps
    320 U00bc							;   other persistent state there (FetchPtr $E0/$E1 = staged only).
    321 U00bc		       00 bd	   EnemyRamX  =	$BD	; 3 bytes: live X per enemy ($BD-$BF, slots 0-2
    322 U00bc							; only — enemies+lamps capped at 3 by editor
    323 U00bc							; kMaxRoomElements, convert_level MAX_ENEMIES,
    324 U00bc							; verify_build; slot 3 would collide with $C0)
    325 U00bc		       00 c0	   LaserState =	$C0	; laser: b7 fire held this frame,
    326 U00bc							;   b6 fire held last frame (press-edge),
    327 U00bc							;   b5-2 RoomDarkMask rooms 4-7,
    328 U00bc							;   b1 beam gate for the kernel .Line
    329 U00bc							;     (PlayerColTable bit1 on the beam row shares b1; mirror of b7)
    330 U00bc		       00 c1	   EnemyRamD  =	$C1	; dir bits 0-3 = enemy 0-3 (1=right, 0=left)
    331 U00bc		       00 c2	   EnemyRamP  =	$C2	; bits0-3 moth phase (shared/sync); bits4-7
    332 U00bc							;   vdir for spider/bat/tentacle (1=down)
    333 U00bc		       00 e2	   EnemyRamY  =	$E2	; 3 bytes: live Y per enemy ($E2-$E4) —
    334 U00bc							;   private since S3.4; see contract above
    335 U00bc
    336 U00bc							; ==============================================================================
    337 U00bc							; Constants
    338 U00bc							; ==============================================================================
    339 U00bc		       00 0c	   PLAYER_HEIGHT =	12	; GRP1 object HIT BOX rows (enemy/miner) — the
    340 U00bc							;   player-vs-object overlap tests use this. It
    341 U00bc							;   is deliberately NOT the drawing window any
    342 U00bc							;   more (Phase 6, 2026-10-22): tall art must
    343 U00bc							;   not silently enlarge the hit boxes.
    344 U00bc		       00 10	   OBJ_WINDOW =	16	; GRP1 drawing window rows: the .Line test
    345 U00bc							;   `Y - ObjTop < OBJ_WINDOW`. Every design's
    346 U00bc							;   art + colour rows are sized to this
    347 U00bc							;   (ObjSprites/ObjColorTab, 9 x 16 = 144 B
    348 U00bc							;   each). Growing a design's ART past its old
    349 U00bc							;   12 rows is a per-type art change; the
    350 U00bc							;   window has the room reserved already.
    351 U00bc		       00 0c	   PLAYER_SPRITE_H =	12	; player sprite height in scanlines (8x12)
    352 U00bc		       00 07	   PLAYER_WIDTH =	7	; lit player sprite spans 7 pixels; REFP0 shift handled
    353 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    354 U00bc		       00 04	   LAMP_WIDTH =	4	; OBJ_LAMP uses GRP1's leftmost 4 lit pixels
    355 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    356 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    357 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    358 U00bc							; placed X, so the snake retreats a tile behind
    359 U00bc							; its placement and then comes out a tile — 2
    360 U00bc							; tiles of travel total. The editor cannot ask
    361 U00bc							; the user to place it 2 tiles from the border.
    362 U00bc		       00 14	   TILE_COLUMNS =	20	; columns per half (reflected playfield)
    363 U00bc		       00 03	   TILE_ROWS  =	3	; number of playable color bands
    364 U00bc		       00 30	   LINES_PER_TILE =	48	; scanlines per tile row
    365 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    366 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE
    367 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × LINES_PER_TILE)
    368 U00bc
