   1530  f401		       3d e5 f3 	      and	EnemyBitTable,X
   1531  f404		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1532  f406		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1533  f409		       20 f6 fe 	      jsr	FoldIndirect	; type
   1534  f40c		       4c 4d f8 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1535  f40f							; 18 B per-type compare chain with one 3 B jmp:
   1536  f40f							; frees 15 B of pre-pad headroom and gives the
   1537  f40f							; type tables room for the raft byte.
