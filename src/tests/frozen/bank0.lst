   2109  f5c1		       a9 3c		      lda	#60
   2110  f5c3		       85 f7		      sta	BombTimer
   2111  f5c5		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2112  f5c8		       aa		      tax
   2113  f5c9		       f0 08		      beq	.BTNoScore
