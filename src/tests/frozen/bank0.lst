   3380  fd7e							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3381  fd7e							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3382  fd7e							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3383  fd7e							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3384  fd7e							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3385  fd7e							; DeriveEnemyY — no persistent movement state exists in RAM.
   3386  fd7e							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3387  fd7e							; block after the pads; pre-pad headroom is 1B).
   3388  fd7e							; ------------------------------------------------------------------------------
   3389  fd7e				   RefreshEnemyY
   3390  fd7e
   3391  fd7e		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3392  fd80							; TickCounter is the 60-frame GAME timer
   3393  fd80							; (decrements 60->1, reloads) — gates derived
   3394  fd80							; from it wrapped every second (spider
   3395  fd80							; "teleported": (TC>>3)&63 only ever saw
   3396  fd80							; 0..7 and counted DOWN 0->7 = jump).
   3397  fd80		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3398  fd82		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3399  fd84				   .REYLoop		; every reader runs after refresh completes)
   3400  fd84		       ca		      dex
   3401  fd85		       20 79 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3402  fd88		       95 e2		      sta	EnemyRamY,X
   3403  fd8a		       8a		      txa		; N/Z must come from X: flags after jsr are
   3404  fd8b		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3405  fd8d				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3406  fd8d							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3407  fd8d							; black rooms, broken PF, invisible sprites)
   3408  fd8d							; --- SELECT or RESET held → back to the old title / level-select screen
   3409  fd8d							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3410  fd8d							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3411  fd8d							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3412  fd8d							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3413  fd8d							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3414  fd8d							;     RESET held past LANDING still re-fires — press must be released
   3415  fd8d							;     before the drop-in finishes. ---
   3416  fd8d		       a5 8a		      lda	DropTarget
   3417  fd8f		       d0 17		      bne	.REYRts	; not idle: not ours
   3418  fd91		       ad 82 02 	      lda	SWCHB
   3419  fd94		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3420  fd96		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3421  fd98		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3422  fd9a		       f0 0c		      beq	.REYRts	; neither pressed
   3423  fd9c		       a9 ff		      lda	#$FF
   3424  fd9e		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3425  fda0		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3426  fda3		       68		      pla		; drop OUR return address (LoadLevel already
   3427  fda4		       68		      pla		;   popped its own) — tail into TitleWork
   3428  fda5		       4c 38 fd 	      jmp	TitleWork
