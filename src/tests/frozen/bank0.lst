   1788  f4f1		       d0 1b		      bne	.CMPDone	; not in miner's room
   1789  f4f3							; X overlap: player [RoomX, +6] vs 4px miner.
   1790  f4f3							; Accept iff RoomX - MinerX in [-6, +3].
   1791  f4f3		       a5 80		      lda	RoomX
   1792  f4f5		       38		      sec
