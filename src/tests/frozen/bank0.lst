    708  f0d2							; ==============================================================================
    709  f0d2							; Kernel: 192 visible scanlines
    710  f0d2							; ==============================================================================
    711  f0d2							; Structure:
    712  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    713  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    714  f0d2							;
    715  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    716  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
    717  f0d2							; ==============================================================================
    718  f0d2
    719  f0d2							; --- Kernel entry: title/cave dispatch (TIA inits live in VBL tail) ---
