   4143  ffae							;   cap reorder, no pass-through possible.
   4144  ffae		       20 11 fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   4145  ffb1		       4c b7 ff 	      jmp	.LaserContact
   4146  ffb4				   .LaserKill
   4147  ffb4		       20 0b fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   4148  ffb7				   .LaserContact
   4149  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   4150  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
