   2664  f807		       29 7f		      and	#$7f
   2665  f809		       c5 98		      cmp	RoomNo
   2666  f80b		       d0 03		      bne	.SOSkipOther
   2667  f80d		       4c bf f6 	      jmp	.SOMinerDraw
   2668  f810				   .SOSkipOther
