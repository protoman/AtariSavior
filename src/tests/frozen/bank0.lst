   1842  f4a8		       f0 18		      beq	.DEYTickNoShift
   1843  f4aa		       c9 03		      cmp	#ENEMY_TENTACLE
   1844  f4ac		       f0 1a		      beq	.DEYTickShift
   1845  f4ae		       c9 00		      cmp	#ENEMY_SPIDER
   1846  f4b0		       f0 2e		      beq	.DEYSpiderTick
