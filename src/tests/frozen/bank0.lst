   1882  f5c8		       e5 a6		      sbc	MinerY
   1883  f5ca		       18		      clc
   1884  f5cb		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1885  f5cd		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1886  f5cf		       b0 03		      bcs	.CMPDone	; no Y overlap
   1887  f5d1							; Pickup! Arm the level-bonus tally (frozen count-up, then advance).
   1888  f5d1							; TallyArm (bank2, via TallyTramp) snapshots time/bombs/lives into
   1889  f5d1							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
