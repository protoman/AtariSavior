    651  f0ad							; --- Facing: mirror sprite in hardware via REFP0 bit3 ---
    652  f0ad							; bank1 HUD writes REFP0=0 during the HUD band, so rewrite it every frame.
    653  f0ad		       a5 82		      lda	PlayerDir
