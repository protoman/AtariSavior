   3604  ff00							; ==============================================================================
   3605  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   3606  ff00							; ==============================================================================
   3607  ff00					      org	$FF00
   3608  ff00				   fineAdjustBegin
   3609  ff00		       70		      .byte.b	%01110000	; left 7
   3610  ff01		       60		      .byte.b	%01100000	; left 6
   3611  ff02		       50		      .byte.b	%01010000	; left 5
   3612  ff03		       40		      .byte.b	%01000000	; left 4
   3613  ff04		       30		      .byte.b	%00110000	; left 3
   3614  ff05		       20		      .byte.b	%00100000	; left 2
   3615  ff06		       10		      .byte.b	%00010000	; left 1
   3616  ff07		       00		      .byte.b	%00000000	; no movement
   3617  ff08		       f0		      .byte.b	%11110000	; right 1
   3618  ff09		       e0		      .byte.b	%11100000	; right 2
   3619  ff0a		       d0		      .byte.b	%11010000	; right 3
   3620  ff0b		       c0		      .byte.b	%11000000	; right 4
   3621  ff0c		       b0		      .byte.b	%10110000	; right 5
   3622  ff0d		       a0		      .byte.b	%10100000	; right 6
   3623  ff0e		       90		      .byte.b	%10010000	; right 7
   3624  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
