   1322  f250		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1323  f252				   .FRActive
   1324  f252		       a5 94		      lda	vyHi
   1325  f254		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1326  f256		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1327  f258		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
