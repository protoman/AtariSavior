    724  f0d5				   CaveKernelRow
    725  f0d5				   .Row
    726  f0d5							; --- Set PF registers for this tile row (TIA persists) ---
    727  f0d5							; Store ORDER is cycle-critical (thin-yellow-line fix, 2026-10-01): the
    728  f0d5							; stores land mid-visible (advance block then these pairs), so on the
    729  f0d5							; row1→row2 band-transition line the left half must keep the OLD band's
    730  f0d5							; PF+color while the right half may show the NEW band. Write cycles
    731  f0d5							; (cN = CPU cycles on the setup line, x = pixel at 4x, HBLANK ends c22.7):
    732  f0d5							;   PF0 w c34 x136 | PF1 w c41 x222 | COLUPF w c48 x296 |
    733  f0d5							;   COLUP1 w c51 x332 (D6 M1 band color — AFTER the left half, so the
    734  f0d5							;     transition line keeps the OLD band's M1/P1 color on the left, same
    735  f0d5							;     rule as COLUPF) |
    736  f0d5							;   ENABL w c58 (BandTab gate, +1c vs the old COLUBK pair) |
    737  f0d5							;   PF2 w c65 x500 (moved +3c — still past right-half PF2 pixels x449)
    738  f0d5							; COLUPF 3rd: color flips at x296 = past ALL left ON-pixels (PF1 ends
    739  f0d5							; x187, PF2 cell17 ends x287); cells18-19 (x288-319) are never ON in any
    740  f0d5							; model row (PF2 bits6/7 always 0) so the flip there is invisible (BG =
    741  f0d5							; COLUBK). PF2 LAST: store lands past every right-half PF2 pixel (x449)
    742  f0d5							; → right PF2 keeps OLD band (= BG post-blast = no yellow; pre-blast
    743  f0d5							; cell17 = new pattern's wall = looks new). Old order (PF2 3rd = w c48,
    744  f0d5							; COLUPF last = w c61 x447) painted right PF2 (x350-446) NEW pattern
    745  f0d5							; under OLD hot color = the blinking thin yellow line at y191/192.
    746  f0d5		       b5 c3		      lda	PF0Buf,X
    747  f0d7		       85 0d		      sta	PF0
    748  f0d9		       b5 c6		      lda	PF1Buf,X
    749  f0db		       85 0e		      sta	PF1
    750  f0dd							; COLUPF precomputed by BuildColupF (stripe + hot pulse) — one ZP load.
    751  f0dd							; Inline stripe+hot test was 84-109c; budget is 76c/scanline.
    752  f0dd		       b5 e7		      lda	ColupfBuf,X
    753  f0df		       85 08		      sta	COLUPF
    754  f0e1		       85 88		      sta	Temp	; A1 (line-budget plan): stage band color
    755  f0e3							; for .ObjZero's A==8 restore (moved up —
    756  f0e3							; same A; Temp has no other kernel reader)
    757  f0e3		       a5 8d		      lda	CollisionCellY	; P2b door color staged by bank2 VBL:
    758  f0e5							; $80 = no door / $1C = yellow stripe
    759  f0e5		       30 06		      bmi	.M1band
    760  f0e7		       85 07		      sta	COLUP1	; door: yellow (only visible on the door's
    761  f0e9							;   open bands — wall PF hides it elsewhere)
    762  f0e9		       85 88		      sta	Temp	; bugs.md #15: also stage the door color into
    763  f0eb							;   Temp, so .ObjZero's plain restore keeps
    764  f0eb							;   the stripe yellow (0 extra cycles on the
    765  f0eb							;   object line; +3c here on the setup line)
    766  f0eb		       10 04		      bpl	.M1done	; $1C b7=0 → always
    767  f0ed				   .M1band
    768  f0ed		       b5 e7		      lda	ColupfBuf,X
