   3591  fd59				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3592  fd59		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3593  fd5b		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3594  fd5d		       f0 0e		      beq	.TWmusic
   3595  fd5f		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3596  fd61		       20 8d f5 	      jsr	BombTick
   3597  fd64				   .TWnoTick
