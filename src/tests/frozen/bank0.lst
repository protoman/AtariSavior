   2224  f675		       a9 65		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   2225  f677		       85 b6		      sta	ObjBase
   2226  f679		       a9 08		      lda	#OBJ_BOMB_H	; bomb design height (8-row art; OBJ_WINDOW
   2227  f67b							;   would draw the RAFT rows underneath)
   2228  f67b		       85 9d		      sta	ObjHeight
   2229  f67d		       a5 f6		      lda	BombX
   2230  f67f		       85 b7		      sta	ActiveObjectX
   2231  f681		       a5 85		      lda	BombY
   2232  f683		       85 b8		      sta	ActiveObjectY
   2233  f685		       a9 46		      lda	#COLOR_BOMBS	; $46 red (P1 X set by the .SODone tail)
   2234  f687		       85 07		      sta	COLUP1
   2235  f689		       4c 45 f7 	      jmp	.SODone	; ObjTop/Bot from ActiveObjectY
   2236  f68c				   .SOCount
   2237  f68c							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   2238  f68c		       a5 b3		      lda	EnemyCount
   2239  f68e		       85 88		      sta	Temp
   2240  f690		       a5 a4		      lda	LevelMinerRoom
   2241  f692		       29 7f		      and	#$7f
   2242  f694		       c5 98		      cmp	RoomNo
   2243  f696		       d0 02		      bne	.SONoMiner
   2244  f698		       e6 88		      inc	Temp	; miner counts as a slot
   2245  f69a				   .SONoMiner
   2246  f69a		       a5 88		      lda	Temp
   2247  f69c		       d0 09		      bne	.SONotNothing
   2248  f69e							; No objects this frame: A = Temp = 0. Blank the sprite AND reset the
   2249  f69e							; flicker counter — with no objects the modulo below never runs, so
   2250  f69e							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   2251  f69e							; would run O(FlickerFrame) iterations in the VBL on the next room with
   2252  f69e							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   2253  f69e		       85 b4		      sta	FlickerFrame
   2254  f6a0		       a9 ff		      lda	#$FF
