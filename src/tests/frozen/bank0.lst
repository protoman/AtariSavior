   1691  f4db							; ==============================================================================
   1692  f4db							; Room exit handlers — check connection table, switch rooms, reposition player
   1693  f4db							; ==============================================================================
   1694  f4db							; ------------------------------------------------------------------------------
   1695  f4db							; C3 (2026-10-20): the four handlers MOVED to bank2 ($FC4F cluster) — the
   1696  f4db							; connection table is level data in bank2, so each handler now reads its own
   1697  f4db							; 2-byte conn record directly (bank1 GetConnIdx + FoldIndirect hops gone).
   1698  f4db							; bank0 keeps only the entry pads at $FBD9-$FBE4 (3 B each, `sta $1FF8`;
   1699  f4db							; bank2 serves the `jmp` at A+3). The OPPOSITE-EDGE placement is written
   1700  f4db							; BEFORE `jmp EnterRoomB2`, because EnterRoom never touches RoomX/RoomY
   1701  f4db							; (checked: EnterRoomB2 + B3RoomBlocks read neither) — that keeps the whole
   1702  f4db							; tail in bank2 with 0 pushes: EnterRoomB2's `jmp ReturnPad` pops the
   1703  f4db							; ORIGINAL `jsr ExitRoomXxx` frame, exactly like the old in-bank return.
   1704  f4db							; Guard: verify_build.CORRIDOR_PADS (4 pads) + check_exit_handlers (edge
   1705  f4db							; placement precedes the EnterRoomB2 tail; no-exit path ends in ReturnPad).
   1706  f4db							; ------------------------------------------------------------------------------
   1707  f4db
   1708  f4db							; ==============================================================================
   1709  f4db							; Level management
   1710  f4db							; ==============================================================================
   1711  f4db							; LoadLevel MOVED to bank2 (C2, 2026-10-20) — body = LoadLevelB2 ($F640).
   1712  f4db							; The level index/table lives in bank2 (level data), so the old body paid 7
   1713  f4db							; `jsr FoldIndirect` (7 x 25c + 14 bank switches) to read a 7-byte entry that
   1714  f4db							; an in-bank (FetchPtr),Y read now fetches directly. Both halves are split
   1715  f4db							; pads (same discipline as CallPad_SelectObject):
   1716  f4db							;   A=$FC20  CallPad_LoadLevel / LoadLevel: `sta $1FF8`   (bank0 runs this)
   1717  f4db							;   A+3=$FC23	bank2 `jmp LoadLevelB2` 		   (fetched after it)
   1718  f4db							;   body tail `jmp $FC26` -> bank2 `sta $1FF6` at $FC26 -> the fetch at $FC29
   1719  f4db							;   comes from HERE: `jmp LF_B0Tail`, i.e. the drop-in tail (EnterRoom call,
   1720  f4db							;   level-start placement, `jmp DropArm`) stays in bank0 so the call chain and
   1721  f4db							;   the measured stack depth are UNCHANGED (0 extra jsr levels, 0 pushes).
   1722  f4db							; Entry layout: stride 7 = miner_room (b7 = faces right), miner_x, wall color,
   1723  f4db							; wall color 2, block base word (RoomDataTable), room count n (the Connections
   1724  f4db							; /RoomEnemies/enemy-record bases are that block's +2n/+4n/+5n offsets).
   1725  f4db							; Guards: verify_build.check_callpads pins the entry pad bytes + operand,
   1726  f4db							; check_loadlevel_tramp pins the return half; tools/test_respawn_hover.py,
   1727  f4db							; test_room_dark.py and test_level_bank.py read the bank2 body.
   1728  f4db
   1729  f4db							; ==============================================================================
   1730  f4db							; Miner pickup — check if player overlaps miner, advance to next level
   1731  f4db							; ==============================================================================
   1732  f4db				   CheckMinerPickup
   1733  f4db		       a5 a4		      lda	LevelMinerRoom
   1734  f4dd		       29 7f		      and	#$7f
   1735  f4df		       c5 98		      cmp	RoomNo
   1736  f4e1		       d0 1b		      bne	.CMPDone	; not in miner's room
   1737  f4e3							; X overlap: player [RoomX, +6] vs 4px miner.
   1738  f4e3							; Accept iff RoomX - MinerX in [-6, +3].
   1739  f4e3		       a5 80		      lda	RoomX
   1740  f4e5		       38		      sec
   1741  f4e6		       e5 a5		      sbc	MinerX
   1742  f4e8		       18		      clc
   1743  f4e9		       69 06		      adc	#PLAYER_WIDTH - 1
   1744  f4eb		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1745  f4ed		       b0 0f		      bcs	.CMPDone	; no X overlap
   1746  f4ef							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1747  f4ef							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1748  f4ef		       a5 81		      lda	RoomY
   1749  f4f1		       38		      sec
   1750  f4f2		       e5 a6		      sbc	MinerY
   1751  f4f4		       18		      clc
   1752  f4f5		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1753  f4f7		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1754  f4f9		       b0 03		      bcs	.CMPDone	; no Y overlap
