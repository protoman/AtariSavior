   1959  f516		       c9 2b		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1960  f518		       b0 03		      bcs	.CMPDone	; no Y overlap
   1961  f51a							; Pickup! Arm the level-bonus tally (frozen count-up, then advance).
   1962  f51a							; TallyArm (bank2, via TallyTramp) snapshots time/bombs/lives into
   1963  f51a							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
