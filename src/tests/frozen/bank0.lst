   1528  f422							; ------------------------------------------------------------------------------
   1529  f422							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1530  f422							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1531  f422							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1532  f422							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1533  f422							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1534  f422							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1535  f422							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1536  f422							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1537  f422							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1538  f422							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1539  f422							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1540  f422							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1541  f422							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1542  f422							; ------------------------------------------------------------------------------
   1543  f422				   UE_Tentacle
   1544  f422		       a5 ad		      lda	TickCounter
   1545  f424		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1546  f426							; = half the player's 1 px/frame (user
   1547  f426							; 2026-10-10: &3 read as chunky/slow)
   1548  f426		       d0 4b		      bne	.TentOut
   1549  f428		       b5 bd		      lda	EnemyRamX,X
   1550  f42a		       c5 80		      cmp	RoomX
   1551  f42c		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1552  f42e		       90 06		      bcc	.TentRight
   1553  f430		       38		      sec
   1554  f431		       e9 01		      sbc	#1	; step left
   1555  f433		       4c 39 f4 	      jmp	.TentProbe
   1556  f436				   .TentRight
   1557  f436		       18		      clc
   1558  f437		       69 01		      adc	#1	; step right
   1559  f439				   .TentProbe
   1560  f439		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1561  f43b		       b0 36		      bcs	.TentOut
   1562  f43d		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1563  f43f							; Same-column cull: committed X is always probe-clear, so a candidate in
   1564  f43f							; the same 4px column covers the same collision cells → result is known
   1565  f43f							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1566  f43f		       a5 88		      lda	Temp
   1567  f441		       55 bd		      eor	EnemyRamX,X
   1568  f443		       29 fc		      and	#$FC
   1569  f445		       f0 28		      beq	.TentCommit
   1570  f447		       a5 80		      lda	RoomX
   1571  f449		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1572  f44b		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1573  f44d		       85 b8		      sta	ActiveObjectY
   1574  f44f		       a5 88		      lda	Temp
   1575  f451		       c9 05		      cmp	#5
   1576  f453		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1577  f455							; PHM's negative visible-left wraps to 255
   1578  f455							; (col garbage / ColOff OOB walk). cand<=4
   1579  f455							; ink pokes off-screen anyway; RoomX=cand
   1580  f455							; already covers cell0.
   1581  f455		       38		      sec
   1582  f456		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1583  f458							; sits 5/7 px left of A (moth .Mvl convention,
   1584  f458							; bank2), but PHM's PLAYER prologue derives
   1585  f458							; lit-left = arg-4/arg-7 with the bin on
   1586  f458							; RoomX-PlayerDir → box missed the cell left
   1587  f458							; of the ink at cand 8/12 (sprite drew 1 px
   1588  f458							; into the wall — bugs.md #4). cand-1 shifts
   1589  f458							; the tested box 1 px left: cell-exact or 1 px
   1590  f458							; conservative for every cand/facing pair
   1591  f458							; (tools/test_cell_map.py tentacle section).
   1592  f458				   .TentProbeX
   1593  f458		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1594  f45a		       b5 e2		      lda	EnemyRamY,X
   1595  f45c		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1596  f45e		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1597  f460							; (rect walk ldx/dex/tax) — slot was lost here
   1598  f460		       20 26 f9 	      jsr	PlayerHitsMap
   1599  f463		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1600  f465		       a5 b8		      lda	ActiveObjectY
   1601  f467		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1602  f469		       a5 b7		      lda	ActiveObjectX
   1603  f46b		       85 80		      sta	RoomX	; restore player X
   1604  f46d		       b0 04		      bcs	.TentOut	; wall → hold position
   1605  f46f				   .TentCommit
   1606  f46f		       a5 88		      lda	Temp
   1607  f471		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1608  f473				   .TentOut
   1609  f473		       4c 1d f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1610  f476
   1611  f476							; ------------------------------------------------------------------------------
   1612  f476							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1613  f476							; there is no free ZP byte for per-slot movement state (phase/direction live
   1614  f476							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1615  f476							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1616  f476							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1617  f476							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1618  f476							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1619  f476							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1620  f476							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1621  f476							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1622  f476							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1623  f476							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1624  f476							;	    the 60-frame game timer — gates from it wrap every second).
   1625  f476							; Other types: straight ROM y (their movement stages come later).
   1626  f476							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1627  f476							; ------------------------------------------------------------------------------
   1628  f476				   DeriveEnemyY
   1629  f476							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1630  f476							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1631  f476		       a5 b1		      lda	EnemyDataLo
   1632  f478		       85 e5		      sta	FetchPtr
   1633  f47a		       a5 b2		      lda	EnemyDataHi
   1634  f47c		       85 e6		      sta	FetchPtr+1
   1635  f47e		       bc b2 f9 	      ldy	EnemyOffTable,X
   1636  f481		       20 f6 fe 	      jsr	FoldIndirect	; type
   1637  f484		       c9 01		      cmp	#ENEMY_BAT
