    845  f0df							; Inline stripe+hot test was 84-109c; budget is 76c/scanline.
    846  f0df		       b5 d3		      lda	ColupfBuf,X
    847  f0e1		       85 08		      sta	COLUPF
    848  f0e3		       85 88		      sta	Temp	; A1 (line-budget plan): band color for
    849  f0e5							; .ObjZero's A==8 restore — A already holds
    850  f0e5							; it, no reload
    851  f0e5		       85 07		      sta	COLUP1	; D6: M1 band color (left-col block) — P1
    852  f0e7							; inherits it until .Line's object path.
    853  f0e7							; Same c51 slot the old no-door path used
    854  f0e7							; (AFTER the left half, same rule as COLUPF)
    855  f0e7		       a5 8d		      lda	CollisionCellY	; P2b door color staged by the VBL:
    856  f0e9							; $80 = no door / $1C = yellow stripe
    857  f0e9		       30 04		      bmi	.M1done	; no door: COLUP1/Temp already hold the band
    858  f0eb							;   colour, nothing left to do
    859  f0eb		       85 07		      sta	COLUP1	; door: yellow (only visible on the door's
    860  f0ed							;   open bands — wall PF hides it elsewhere)
    861  f0ed		       85 88		      sta	Temp	; bugs.md #15: .ObjZero's plain restore must
    862  f0ef							;   keep the stripe yellow
    863  f0ef				   .M1done
