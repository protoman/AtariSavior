   4402  ff01		       60		      .byte.b	%01100000	; left 6
   4403  ff02		       50		      .byte.b	%01010000	; left 5
   4404  ff03		       40		      .byte.b	%01000000	; left 4
   4405  ff04		       30		      .byte.b	%00110000	; left 3
   4406  ff05		       20		      .byte.b	%00100000	; left 2
   4407  ff06		       10		      .byte.b	%00010000	; left 1
   4408  ff07		       00		      .byte.b	%00000000	; no movement
   4409  ff08		       f0		      .byte.b	%11110000	; right 1
   4410  ff09		       e0		      .byte.b	%11100000	; right 2
   4411  ff0a		       d0		      .byte.b	%11010000	; right 3
   4412  ff0b		       c0		      .byte.b	%11000000	; right 4
   4413  ff0c		       b0		      .byte.b	%10110000	; right 5
   4414  ff0d		       a0		      .byte.b	%10100000	; right 6
