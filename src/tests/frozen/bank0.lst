    414 U00bc							; ==============================================================================
    415 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    416 U00bc							; ==============================================================================
    417 U00bc							; Bank3 is the power-up bank. Its stub does:
    418 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    419 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    420 U00bc							; ==============================================================================
    421  10000 ????				       seg	code
    422  f000					      org	$F000
    423  f000
    424  f000							; --- 5-byte bankswitching pad ---
    425  f000							; After bank3's stub selects us, CPU arrives here.
    426  f000							; We jump over the pad into the real init code.
    427  f000		       a9 00		      lda	#0
    428  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    429  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    430  f008							; (NOT deletable: $F008 = GameStart is a
    431  f008							;  hardcoded cross-bank entry — bank1
    432  f008							;  stub `jmp $F008`; this jmp also keeps
    433  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    434  f008							;  fold-pad byte guard fires when it moves)
    435  f008							;  + F0xx landmarks fixed)
    436  f008
    437  f008				   GameStart
    438  f008		       78		      sei		; disable interrupts
    439  f009		       d8		      cld		; clear decimal mode
    440  f00a		       a2 ff		      ldx	#$FF
    441  f00c		       9a		      txs		; stack pointer = $FF
    442  f00d
    443  f00d							; --- Clear zero-page RAM ---
    444  f00d		       a9 00		      lda	#0
    445  f00f		       a2 80		      ldx	#$80
    446  f011				   .ClearZP
    447  f011		       95 00		      sta	$00,X
    448  f013		       e8		      inx
    449  f014		       d0 fb		      bne	.ClearZP
    450  f016
    451  f016							; --- Initialize game state ---
    452  f016		       a9 00		      lda	#0
    453  f018		       85 a3		      sta	Level
    454  f01a		       a9 03		      lda	#3
    455  f01c		       85 ac		      sta	PlayerLives
    456  f01e		       a9 05		      lda	#BOMBS_MAX
    457  f020		       85 f0		      sta	PlayerBombs
    458  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    459  f022		       a9 3c		      lda	#60
    460  f024		       85 ad		      sta	TickCounter
    461  f026		       a9 78		      lda	#120
    462  f028		       85 ae		      sta	BarLevel	; bar starts full
    463  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    464  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    465  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    466  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    467  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    468  f02a		       a9 ff		      lda	#$FF
    469  f02c		       85 8a		      sta	DropTarget
    470  f02e
    471  f02e							; --- Load first level (the title previews it on the live stage:
    472  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    473  f02e		       20 20 fc 	      jsr	LoadLevel
    474  f031
    475  f031							; --- Set player color ---
    476  f031		       a9 48		      lda	#COLOR_PLAYER
    477  f033		       85 06		      sta	COLUP0
    478  f035
    479  f035							; --- Set playfield to reflected mode + priority ---
    480  f035							; D0=1 = reflect (left half mirrors to right)
    481  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    482  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    483  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    484  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    485  f037		       85 0a		      sta	CTRLPF
    486  f039
    487  f039							; ==============================================================================
    488  f039							; Frame loop
    489  f039							; ==============================================================================
    490  f039				   StartFrame
    491  f039
    492  f039							; ------------------------------------------------------------------------------
    493  f039							; VSYNC (3 scanlines)
    494  f039							; ------------------------------------------------------------------------------
    495  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    496  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    497  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    498  f039							; does not advance the wall clock to the next scanline boundary (it is already
    499  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    500  f039							; fraction depends on where the previous frame's overscan happened to end) —
    501  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    502  f039							;
    503  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    504  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    505  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    506  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    507  f039							; the sim wall-model target is updated to match.
    508  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    509  f03b		       a9 02		      lda	#2
    510  f03d		       85 00		      sta	VSYNC
    511  f03f		       85 02		      sta	WSYNC
    512  f041		       85 02		      sta	WSYNC
    513  f043		       85 02		      sta	WSYNC
    514  f045		       a9 00		      lda	#0
    515  f047		       85 00		      sta	VSYNC
    516  f049
    517  f049							; ------------------------------------------------------------------------------
    518  f049							; VBLANK (37 scanlines)
    519  f049							; ------------------------------------------------------------------------------
    520  f049		       a9 02		      lda	#2
    521  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    522  f04d
    523  f04d							; --- Set TIM64T for VBLANK ---
    524  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    525  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    526  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    527  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    528  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    529  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    530  f04d							; Worst 1059c of the 1472c window = 413c margin.
    531  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    532  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    533  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    534  f04d		       a9 17		      lda	#23
    535  f04f		       8d 96 02 	      sta	TIM64T
    536  f052
    537  f052							; --- Position player sprite horizontally ---
    538  f052		       a5 80		      lda	RoomX
    539  f054		       38		      sec
    540  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    541  f057		       a2 00		      ldx	#0	; X=0 = player0
    542  f059		       20 0f ff 	      jsr	SetObjectXPos
    543  f05c
    544  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    545  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    546  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    547  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    548  f05c
    549  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    550  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    551  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    552  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    553  f05c
    554  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    555  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    556  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    557  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    558  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    559  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    560  f05c		       20 15 f6 	      jsr	SelectActiveObject
    561  f05f
    562  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    563  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    564  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    565  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    566  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    567  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    568  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    569  f062
    570  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    571  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    572  f062							; 2026-10-04 up-exit fix). The
    573  f062							; old per-frame VBL fold that re-read the same ROM byte is
    574  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    575  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    576  f062							; the VBL path (the read that made a bank3 data move need another
    577  f062							; reader). test_band_restage covers the contract.
    578  f062
    579  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    580  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    581  f062							; Dark room: black except the existing explosion blink (state=2).
    582  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    583  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    584  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    585  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    586  f062		       a5 b5		      lda	BombPacked
    587  f064		       29 03		      and	#%00000011
    588  f066		       c9 02		      cmp	#2
    589  f068		       f0 0a		      beq	.BgBlink
    590  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    591  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    592  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    593  f071		       4c 84 f0 	      jmp	.BgStore
    594  f074				   .BgBlink
    595  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    596  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    597  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    598  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    599  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    600  f074		       a9 3c		      lda	#60
    601  f076		       38		      sec
    602  f077		       e5 f7		      sbc	BombTimer
    603  f079		       29 03		      and	#3
    604  f07b		       a8		      tay
    605  f07c		       b9 e1 f5 	      lda	BombBlinkColors,Y
    606  f07f		       4c 84 f0 	      jmp	.BgStore
    607  f082				   .BgIdle
    608  f082		       a9 00		      lda	#COLOR_CAVE_BG
    609  f084				   .BgStore
    610  f084		       85 09		      sta	COLUBK
    611  f086
    612  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    613  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    614  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    615  f086							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    616  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    617  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    618  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    619  f086		       20 c1 f9 	      jsr	PositionBallM1
    620  f089
    621  f089							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    622  f089							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    623  f089							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    624  f089							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    625  f089							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    626  f089							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    627  f089							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    628  f089							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    629  f089		       a5 c2		      lda	EnemyRamP
    630  f08b		       29 f0		      and	#$F0
    631  f08d		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    632  f08f		       4a		      lsr
    633  f090		       4a		      lsr
    634  f091		       4a		      lsr
    635  f092		       4a		      lsr		; A = p (1..15)
    636  f093		       c9 08		      cmp	#8
    637  f095		       90 04		      bcc	.TideTri
    638  f097		       a9 00		      lda	#0	; rest phase p8-15
    639  f099		       f0 09		      beq	.TideBase	; always
    640  f09b				   .TideTri
    641  f09b		       c9 04		      cmp	#4
    642  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    643  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    644  f0a1		       38		      sec
    645  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
    646  f0a4				   .TideBase
    647  f0a4		       18		      clc
    648  f0a5		       69 24		      adc	#36
    649  f0a7		       85 8b		      sta	CollisionX
