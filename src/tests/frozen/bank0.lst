   1167  f203							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1168  f203							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1169  f203							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1170  f203							;	   catches the fall in ~10 frames from terminal $0180.
   1171  f203							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1172  f203							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1173  f203							;	   gone: it kept thrust below gravity for ~32 frames.
   1174  f203							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1175  f203							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1176  f203							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1177  f203							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1178  f203							;	   1.0s hover was too long — halved); then the flag clears and
   1179  f203							;	   normal gravity resumes (fall ~0.85s after release). State
   1180  f203							;	   lives in JetPower, NOT
   1181  f203							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1182  f203							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1183  f203							;	   rising frame — both clobbered a StepsLeft-based float.
   1184  f203							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1185  f203							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1186  f203							;	   (headroom stays $FC67).
   1187  f203							; ------------------------------------------------------------------------------
   1188  f203		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1189  f205		       24 88		      bit	Temp
   1190  f207		       d0 25		      bne	.JetDecay
   1191  f209		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1192  f20b		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1193  f20d		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1194  f20f		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1195  f211				   .JetRamp
   1196  f211							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1197  f211							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1198  f211							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1199  f211							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1200  f211							; ~80 frames = more than a room height of extra falling). The ramp only
   1201  f211							; applies from rest / while already rising, so take-off still eases in.
   1202  f211		       a5 94		      lda	vyHi
   1203  f213		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1204  f215		       05 93		      ora	vyLo
   1205  f217		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1206  f219		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1207  f21b		       85 96		      sta	JetPower
   1208  f21d		       4c 5a f2 	      jmp	.Gravity
   1209  f220				   .JetClimb
   1210  f220		       a5 96		      lda	JetPower
   1211  f222		       c9 30		      cmp	#JET_MAX
   1212  f224		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1213  f226		       18		      clc
   1214  f227		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1215  f229		       85 96		      sta	JetPower
   1216  f22b		       4c 5a f2 	      jmp	.Gravity
   1217  f22e				   .JetDecay		; Up NOT held this frame
   1218  f22e		       a5 96		      lda	JetPower
   1219  f230		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1220  f232		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1221  f234		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1222  f236		       05 93		      ora	vyLo
   1223  f238		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1224  f23a							;   climb to stop, do NOT float
   1225  f23a		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1226  f23c		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1227  f23e		       4c 5a f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1228  f241				   .FloatRun
   1229  f241		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1230  f243		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1231  f245		       29 7f		      and	#$7F
   1232  f247		       d0 04		      bne	.FRActive
   1233  f249		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1234  f24b		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1235  f24d				   .FRActive
   1236  f24d		       a5 94		      lda	vyHi
   1237  f24f		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1238  f251		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1239  f253		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1240  f255		       85 94		      sta	vyHi
   1241  f257		       4c 9f f2 	      jmp	.Integrate
