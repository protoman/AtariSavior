   1679  f491		       bc b2 f9 	      ldy	EnemyOffTable,X
   1680  f494		       20 f6 fe 	      jsr	FoldIndirect	; type
   1681  f497		       c9 01		      cmp	#ENEMY_BAT
   1682  f499		       f0 18		      beq	.DEYTickNoShift
   1683  f49b		       c9 03		      cmp	#ENEMY_TENTACLE
