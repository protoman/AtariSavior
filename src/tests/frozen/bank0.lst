   1053  f1b2		       4c f4 f1 	      jmp	.BombInDone
   1054  f1b5				   .BombHeld
   1055  f1b5		       a5 b5		      lda	BombPacked
   1056  f1b7		       29 04		      and	#%00000100
   1057  f1b9		       d0 39		      bne	.BombInDone	; held since last frame — no edge
   1058  f1bb		       a5 b5		      lda	BombPacked
   1059  f1bd		       29 03		      and	#%00000011
   1060  f1bf		       d0 2d		      bne	.BombMarkDown	; bomb already active: just set DownPrev
   1061  f1c1		       a5 f0		      lda	PlayerBombs
   1062  f1c3		       29 07		      and	#%00000111	; b2-0 = bombs; b7-3 are the raft's ramp state
   1063  f1c5		       f0 27		      beq	.BombMarkDown	; no bombs left: swallow edge, keep DownPrev
   1064  f1c7		       a5 b5		      lda	BombPacked
