   1772  f49c		       bc 77 f9 	      ldy	EnemyOffTable,X
   1773  f49f		       20 f6 fe 	      jsr	FoldIndirect	; type
   1774  f4a2		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
