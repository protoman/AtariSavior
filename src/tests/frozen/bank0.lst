   3277  fd74							; ------------------------------------------------------------------------------
   3278  fd74							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3279  fd74							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3280  fd74							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3281  fd74							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3282  fd74							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3283  fd74							; DeriveEnemyY — no persistent movement state exists in RAM.
   3284  fd74							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3285  fd74							; block after the pads; pre-pad headroom is 1B).
   3286  fd74							; ------------------------------------------------------------------------------
   3287  fd74				   RefreshEnemyY
   3288  fd74		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3289  fd76							; TickCounter is the 60-frame GAME timer
   3290  fd76							; (decrements 60->1, reloads) — gates derived
   3291  fd76							; from it wrapped every second (spider
   3292  fd76							; "teleported": (TC>>3)&63 only ever saw
   3293  fd76							; 0..7 and counted DOWN 0->7 = jump).
   3294  fd76		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3295  fd78		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3296  fd7a				   .REYLoop		; every reader runs after refresh completes)
   3297  fd7a		       ca		      dex
   3298  fd7b		       20 96 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3299  fd7e		       95 e2		      sta	EnemyRamY,X
   3300  fd80		       8a		      txa		; N/Z must come from X: flags after jsr are
   3301  fd81		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3302  fd83				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3303  fd83							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3304  fd83							; black rooms, broken PF, invisible sprites)
   3305  fd83							; --- SELECT or RESET held → back to the old title / level-select screen
   3306  fd83							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3307  fd83							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3308  fd83							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3309  fd83							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3310  fd83							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3311  fd83							;     RESET held past LANDING still re-fires — press must be released
   3312  fd83							;     before the drop-in finishes. ---
