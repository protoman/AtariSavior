   1253  f2cd							; Horizontal movement (left/right) — 1 px/frame + collision
   1254  f2cd							; ------------------------------------------------------------------------------
   1255  f2cd				   CheckP0Left
   1256  f2cd		       a9 04		      lda	#%00000100	; test D2 (left)
   1257  f2cf		       24 88		      bit	Temp
   1258  f2d1		       d0 19		      bne	CheckP0Right
   1259  f2d3		       a9 01		      lda	#FACING_LEFT
   1260  f2d5		       85 82		      sta	PlayerDir	; turn the eye left, even if the move is blocked
   1261  f2d7		       a5 80		      lda	RoomX
   1262  f2d9		       c9 04		      cmp	#PLAYER_MIN_X
   1263  f2db		       f0 0c		      beq	.ExitLeft	; at left edge -> room exit
   1264  f2dd		       c6 80		      dec	RoomX
   1265  f2df		       20 26 f9 	      jsr	PlayerHitsMap
