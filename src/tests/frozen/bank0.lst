   1072  f1dd		       a9 b4		      lda	#180
   1073  f1df		       85 f7		      sta	BombTimer
   1074  f1e1		       a5 f6		      lda	BombX	; position P1 ONCE here (overscan, timer-gated);
   1075  f1e3		       a2 01		      ldx	#1	;   bomb X is constant during the straight fall,
   1076  f1e5		       20 0f ff 	      jsr	SetObjectXPos	;   so VBL bomb path skips SOXP (its WSYNC shifted
   1077  f1e8							;   the re-anchor phase = +1-line pump on bt0)
   1078  f1e8		       20 02 fc 	      jsr	CallPad_BombSndDrop	; S10: short blip on place
   1079  f1eb		       4c f4 f1 	      jmp	.BombInDone
   1080  f1ee				   .BombMarkDown
   1081  f1ee		       a5 b5		      lda	BombPacked
   1082  f1f0		       09 04		      ora	#%00000100
   1083  f1f2		       85 b5		      sta	BombPacked
   1084  f1f4				   .BombInDone
