   3897  fecf		       a9 00		      lda	#0
   3898  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3899  fed3				   .TWait
   3900  fed3		       ad 84 02 	      lda	INTIM
   3901  fed6		       d0 fb		      bne	.TWait
