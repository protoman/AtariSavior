    428 U00bc							; ==============================================================================
    429 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    430 U00bc							; ==============================================================================
    431 U00bc							; Bank3 is the power-up bank. Its stub does:
    432 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    433 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    434 U00bc							; ==============================================================================
    435  10000 ????				       seg	code
    436  f000					      org	$F000
    437  f000
    438  f000							; --- 5-byte bankswitching pad ---
    439  f000							; After bank3's stub selects us, CPU arrives here.
    440  f000							; We jump over the pad into the real init code.
    441  f000		       a9 00		      lda	#0
    442  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    443  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    444  f008							; (NOT deletable: $F008 = GameStart is a
    445  f008							;  hardcoded cross-bank entry — bank1
    446  f008							;  stub `jmp $F008`; this jmp also keeps
    447  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    448  f008							;  fold-pad byte guard fires when it moves)
    449  f008							;  + F0xx landmarks fixed)
    450  f008
    451  f008				   GameStart
    452  f008		       78		      sei		; disable interrupts
    453  f009		       d8		      cld		; clear decimal mode
    454  f00a		       a2 ff		      ldx	#$FF
    455  f00c		       9a		      txs		; stack pointer = $FF
    456  f00d
    457  f00d							; --- Clear zero-page RAM ---
    458  f00d		       a9 00		      lda	#0
    459  f00f		       a2 80		      ldx	#$80
    460  f011				   .ClearZP
    461  f011		       95 00		      sta	$00,X
    462  f013		       e8		      inx
    463  f014		       d0 fb		      bne	.ClearZP
    464  f016
    465  f016							; --- Initialize game state ---
    466  f016		       a9 00		      lda	#0
    467  f018		       85 a3		      sta	Level
    468  f01a		       a9 03		      lda	#3
    469  f01c		       85 ac		      sta	PlayerLives
    470  f01e		       a9 05		      lda	#BOMBS_MAX
    471  f020		       85 f0		      sta	PlayerBombs
    472  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    473  f022		       a9 3c		      lda	#60
    474  f024		       85 ad		      sta	TickCounter
    475  f026		       a9 78		      lda	#120
    476  f028		       85 ae		      sta	BarLevel	; bar starts full
    477  f02a							; --- Intro screen: DropTarget=$FD sentinel (2026-10-06 — SAVIOR splash
    478  f02a							;     shows ONCE at power-on; first SELECT/RESET edge anywhere moves to
    479  f02a							;     the old title $FF = first room + HUD stage count; valid fall
    480  f02a							;     targets are Y ≤ 191, sentinels $FD/$FE/$FF all "not a fall"). ---
    481  f02a		       a9 fd		      lda	#$FD
    482  f02c		       85 8a		      sta	DropTarget
    483  f02e
    484  f02e							; --- Load first level ---
    485  f02e		       20 84 f5 	      jsr	LoadLevel
    486  f031		       a9 14		      lda	#20
    487  f033		       85 80		      sta	RoomX	; title flight starts on left side
    488  f035		       a9 00		      lda	#0
    489  f037		       85 81		      sta	RoomY	; offset in title's fixed flight window
    490  f039
    491  f039							; --- Set player color ---
    492  f039		       a9 48		      lda	#COLOR_PLAYER
    493  f03b		       85 06		      sta	COLUP0
    494  f03d
    495  f03d							; --- Set playfield to reflected mode + priority ---
    496  f03d							; D0=1 = reflect (left half mirrors to right)
    497  f03d							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    498  f03d							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    499  f03d							; disabled at kernel entry, size only matters once Phase 3 enables it)
    500  f03d		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    501  f03f		       85 0a		      sta	CTRLPF
    502  f041
    503  f041							; ==============================================================================
    504  f041							; Frame loop
    505  f041							; ==============================================================================
    506  f041				   StartFrame
    507  f041
    508  f041							; ------------------------------------------------------------------------------
    509  f041							; VSYNC (3 scanlines)
    510  f041							; ------------------------------------------------------------------------------
    511  f041							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    512  f041							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    513  f041							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    514  f041							; does not advance the wall clock to the next scanline boundary (it is already
    515  f041							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    516  f041							; fraction depends on where the previous frame's overscan happened to end) —
    517  f041							; the whole screen shifted up 1 scanline on those frames = the jitter.
    518  f041							;
    519  f041							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    520  f041							; the next scanline boundary (even if we were already at it — the store is 3c
    521  f041							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    522  f041							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    523  f041							; the sim wall-model target is updated to match.
    524  f041		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    525  f043		       a9 02		      lda	#2
    526  f045		       85 00		      sta	VSYNC
    527  f047		       85 02		      sta	WSYNC
    528  f049		       85 02		      sta	WSYNC
    529  f04b		       85 02		      sta	WSYNC
    530  f04d		       a9 00		      lda	#0
    531  f04f		       85 00		      sta	VSYNC
    532  f051
    533  f051							; ------------------------------------------------------------------------------
    534  f051							; VBLANK (37 scanlines)
    535  f051							; ------------------------------------------------------------------------------
    536  f051		       a9 02		      lda	#2
    537  f053		       85 01		      sta	VBLANK	; turn on VBLANK
    538  f055
    539  f055							; --- Set TIM64T for VBLANK ---
    540  f055							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    541  f055							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    542  f055							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    543  f055							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    544  f055				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    545  f055		       a9 17		      lda	#23
    546  f057		       8d 96 02 	      sta	TIM64T
    547  f05a
    548  f05a							; --- Position player sprite horizontally ---
    549  f05a		       a5 80		      lda	RoomX
    550  f05c		       38		      sec
    551  f05d		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    552  f05f		       a2 00		      ldx	#0	; X=0 = player0
    553  f061		       20 0f ff 	      jsr	SetObjectXPos
    554  f064
    555  f064							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    556  f064							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    557  f064							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    558  f064							; now stages BallX into Temp; this block reads the staged copy. ---
    559  f064
    560  f064							; --- No sprite copy needed — kernel reads directly from ROM ---
    561  f064							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    562  f064							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    563  f064							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    564  f064
    565  f064							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    566  f064							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    567  f064							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    568  f064		       20 44 f6 	      jsr	SelectActiveObject
    569  f067
    570  f067							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    571  f067							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    572  f067							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    573  f067							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    574  f067							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    575  f067							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    576  f067		       20 38 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    577  f06a
    578  f06a							; --- Band-color cache → RoomBandColor ($D2) for kernel+overscan (P2.5) ---
    579  f06a							; ROM now lives in bank2: kernel-time fold is cycle-impossible on the
    580  f06a							; .WaterRow line, so fold HERE (VBLANK, timer-paced) and hand the kernel
    581  f06a							; a plain zp load. Stage FetchPtr immediately before the fold.
    582  f06a		       a5 98		      lda	RoomNo
    583  f06c		       0a		      asl
    584  f06d		       0a		      asl
    585  f06e		       09 03		      ora	#3	; Y = RoomNo*4+3 (RoomNo*4 low bits are 0)
    586  f070		       a8		      tay
    587  f071		       a5 af		      lda	LevelEnemyLo
    588  f073		       85 e5		      sta	FetchPtr
    589  f075		       a5 b0		      lda	LevelEnemyHi
    590  f077		       85 e6		      sta	FetchPtr+1
    591  f079		       a2 00		      ldx	#0
    592  f07b		       20 f6 fe 	      jsr	FoldIndirect
    593  f07e		       85 bc		      sta	RoomBandColor
    594  f080
    595  f080							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    596  f080							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    597  f080							; Dark room: black except the existing explosion blink (state=2).
    598  f080							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    599  f080							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    600  f080							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    601  f080							; no reader between this point and overscan's own `sta Temp` (joystick).
    602  f080		       a5 b5		      lda	BombPacked
    603  f082		       29 03		      and	#%00000011
    604  f084		       c9 02		      cmp	#2
    605  f086		       f0 0a		      beq	.BgBlink
    606  f088		       20 26 fc 	      jsr	CallPad_IsRoomDark
    607  f08b		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    608  f08d		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    609  f08f		       4c a2 f0 	      jmp	.BgStore
    610  f092				   .BgBlink
    611  f092							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    612  f092							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    613  f092							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    614  f092							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    615  f092							; 60 frames = exact 15 cycles, starts black at explosion.
    616  f092		       a9 3c		      lda	#60
    617  f094		       38		      sec
    618  f095		       e5 f7		      sbc	BombTimer
    619  f097		       29 03		      and	#3
    620  f099		       a8		      tay
    621  f09a		       b9 2a f8 	      lda	BombBlinkColors,Y
    622  f09d		       4c a2 f0 	      jmp	.BgStore
    623  f0a0				   .BgIdle
    624  f0a0		       a9 00		      lda	#COLOR_CAVE_BG
    625  f0a2				   .BgStore
    626  f0a2		       85 09		      sta	COLUBK
    627  f0a4
    628  f0a4							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    629  f0a4							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    630  f0a4							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    631  f0a4							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    632  f0a4							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    633  f0a4							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    634  f0a4							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    635  f0a4		       20 c4 f9 	      jsr	PositionBallM1
    636  f0a7
    637  f0a7							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    638  f0a7							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    639  f0a7							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    640  f0a7							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    641  f0a7							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    642  f0a7							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    643  f0a7							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    644  f0a7							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    645  f0a7		       a5 c2		      lda	EnemyRamP
    646  f0a9		       29 f0		      and	#$F0
    647  f0ab		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    648  f0ad		       4a		      lsr
