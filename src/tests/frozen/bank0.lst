   1672  f4a7		       a5 c2		      lda	EnemyRamP
   1673  f4a9		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1674  f4aa		       4c b2 f4 	      jmp	.DEYBobTick
   1675  f4ad				   .DEYTickShift
   1676  f4ad		       a5 c2		      lda	EnemyRamP
   1677  f4af		       4a		      lsr
   1678  f4b0		       4a		      lsr
   1679  f4b1		       4a		      lsr		; ÷8 gate
   1680  f4b2				   .DEYBobTick		; shared bob delta: triangle(p&3) = 0,1,2,1
   1681  f4b2		       29 03		      and	#3
   1682  f4b4		       c9 03		      cmp	#3
   1683  f4b6		       d0 02		      bne	DEYDelta
