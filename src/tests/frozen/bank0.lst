   2566  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2567  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2568  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2569  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2570  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2571  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2572  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2573  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2574  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2575  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2576  f980							; before — same ZP, no new allocation).
   2577  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2578  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2579  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2580  f980		       a5 8d		      lda	CollisionCellY
   2581  f982		       85 92		      sta	RectCount
   2582  f984				   .CWRow
   2583  f984		       a5 8e		      lda	CollisionEndX
   2584  f986		       85 8b		      sta	CollisionX
   2585  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2586  f989							;   was re-loaded every cell — −8c/cell walk
   2587  f989							;   trim for the falling+probe heavy frame)
   2588  f989				   .CWCol
   2589  f989		       a4 92		      ldy	RectCount
   2590  f98b		       98		      tya
   2591  f98c		       18		      clc
   2592  f98d		       7d a2 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2593  f990		       a8		      tay
   2594  f991		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2595  f994		       3d b6 fd 	      and	ColMask,X	; bit for this source col
   2596  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2597  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2598  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2599  f99d		       e8		      inx
   2600  f99e		       86 8b		      stx	CollisionX
   2601  f9a0		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
   2602  f9a2				   .CWRowDone
   2603  f9a2		       a5 92		      lda	RectCount
   2604  f9a4		       c5 8f		      cmp	CollisionEndY	; row == bottom?
   2605  f9a6		       f0 07		      beq	.CWNoHit
   2606  f9a8		       e6 92		      inc	RectCount
   2607  f9aa		       d0 d8		      bne	.CWRow	; always (row never wraps to 0)
   2608  f9ac				   .CWHit
   2609  f9ac		       4c ec ff 	      jmp	HotOverlapFlag	; C=1 contract; hot rects unchanged (ROM stream)
   2610  f9af				   .CWNoHit
   2611  f9af							; Phase 4: miss → asym-patch overlay (push-neutral tramp, moth pattern).
   2612  f9af							; OverlayTramp gates on LineCount ($84 = packed byte, VBL/$8F staged):
   2613  f9af							; symmetric rooms pay +8c and return here-shaped clc/rts; asym rooms
   2614  f9af							; cross to bank2 PHMOverlay (patch column + band mask), exit via
   2615  f9af							; ReturnPad $FBF8 — rts pops THIS call's return (0 pushes total, SP
   2616  f9af							; guard unchanged). Overlay sets C itself (plain sec — patch cells are
   2617  f9af							; envelope-guaranteed non-hot, so HotOverlapFlag must not run).
   2618  f9af		       4c b8 f9 	      jmp	OverlayTramp
