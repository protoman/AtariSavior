   3404  fcc1		       a5 8a		      lda	DropTarget
   3405  fcc3		       c9 fd		      cmp	#$FD
   3406  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3407  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3408  fcc7							;   tally cleared to 0 by TallyWork before its
   3409  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3410  fcc7		       a5 81		      lda	RoomY
   3411  fcc9		       85 8a		      sta	DropTarget
   3412  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3413  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3414  fccf		       a9 00		      lda	#0
   3415  fcd1		       85 81		      sta	RoomY
   3416  fcd3		       85 95		      sta	PlayerYSub
   3417  fcd5		       85 93		      sta	vyLo
   3418  fcd7		       85 94		      sta	vyHi
   3419  fcd9		       a5 c0		      lda	LaserState
