   2693  f955		       a8		      tay
   2694  f956		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2695  f959		       3d bd fd 	      and	ColMask,X	; bit for this source col
   2696  f95c		       d0 13		      bne	.CWHit	; solid (Z=0)
