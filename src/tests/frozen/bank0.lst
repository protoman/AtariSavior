   3727  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   3728  ff00							; ==============================================================================
   3729  ff00					      org	$FF00
   3730  ff00				   fineAdjustBegin
   3731  ff00		       70		      .byte.b	%01110000	; left 7
   3732  ff01		       60		      .byte.b	%01100000	; left 6
   3733  ff02		       50		      .byte.b	%01010000	; left 5
   3734  ff03		       40		      .byte.b	%01000000	; left 4
   3735  ff04		       30		      .byte.b	%00110000	; left 3
   3736  ff05		       20		      .byte.b	%00100000	; left 2
   3737  ff06		       10		      .byte.b	%00010000	; left 1
   3738  ff07		       00		      .byte.b	%00000000	; no movement
   3739  ff08		       f0		      .byte.b	%11110000	; right 1
   3740  ff09		       e0		      .byte.b	%11100000	; right 2
   3741  ff0a		       d0		      .byte.b	%11010000	; right 3
   3742  ff0b		       c0		      .byte.b	%11000000	; right 4
   3743  ff0c		       b0		      .byte.b	%10110000	; right 5
   3744  ff0d		       a0		      .byte.b	%10100000	; right 6
   3745  ff0e		       90		      .byte.b	%10010000	; right 7
   3746  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
