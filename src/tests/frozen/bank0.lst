   4123  fda0							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   4124  fda0							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   4125  fda0							;   ranges before the walk; bank2 display-space walkers mirror first too).
   4126  fda0							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   4127  fda0							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   4128  fda0							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   4129  fda0							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   4130  fda0							;   by tools/test_cell_map.py).
   4131  fda0							;   (The standalone CellSolid leaf that lived here moved INTO
   4132  fda0							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   4133  fda0							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   4134  fda0							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   4135  fda0							; ------------------------------------------------------------------------------
   4136  fda0		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   4137  fdb4		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   4138  fdc0		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
