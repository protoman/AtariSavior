   1592  f474							; ------------------------------------------------------------------------------
   1593  f474							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1594  f474							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1595  f474							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1596  f474							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1597  f474							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1598  f474							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1599  f474							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1600  f474							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1601  f474							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1602  f474							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1603  f474							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1604  f474							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1605  f474							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1606  f474							; ------------------------------------------------------------------------------
   1607  f474				   UE_Tentacle
   1608  f474		       a5 ad		      lda	TickCounter
   1609  f476		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1610  f478							; = half the player's 1 px/frame (user
   1611  f478							; 2026-10-10: &3 read as chunky/slow)
   1612  f478		       d0 4b		      bne	.TentOut
   1613  f47a		       b5 bd		      lda	EnemyRamX,X
   1614  f47c		       c5 80		      cmp	RoomX
   1615  f47e		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1616  f480		       90 06		      bcc	.TentRight
   1617  f482		       38		      sec
   1618  f483		       e9 01		      sbc	#1	; step left
   1619  f485		       4c 8b f4 	      jmp	.TentProbe
   1620  f488				   .TentRight
   1621  f488		       18		      clc
   1622  f489		       69 01		      adc	#1	; step right
   1623  f48b				   .TentProbe
   1624  f48b		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1625  f48d		       b0 36		      bcs	.TentOut
   1626  f48f		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1627  f491							; Same-column cull: committed X is always probe-clear, so a candidate in
   1628  f491							; the same 4px column covers the same collision cells → result is known
   1629  f491							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1630  f491		       a5 88		      lda	Temp
   1631  f493		       55 bd		      eor	EnemyRamX,X
   1632  f495		       29 fc		      and	#$FC
   1633  f497		       f0 28		      beq	.TentCommit
   1634  f499		       a5 80		      lda	RoomX
   1635  f49b		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1636  f49d		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1637  f49f		       85 b8		      sta	ActiveObjectY
