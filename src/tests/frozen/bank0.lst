   2338  f7ec							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2339  f7ec							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2340  f7ec							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2341  f7ec							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2342  f7ec							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2343  f7ec							; this region is upstream of the pin, so it costs nothing at $FC67.
   2344  f7ec							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2345  f7ec							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2346  f7ec							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2347  f7ec							; and normal deaths, resets on game-over reload.
   2348  f7ec							; ------------------------------------------------------------------------------
   2349  f7ec				   CEH_Key
   2350  f7ec		       a5 ba		      lda	EnemyDeadMask
   2351  f7ee		       1d b2 f3 	      ora	EnemyBitTable,X
   2352  f7f1		       85 ba		      sta	EnemyDeadMask
   2353  f7f3		       a5 a7		      lda	LevelStartRoom
   2354  f7f5		       09 80		      ora	#$80	; KeyHeld = b7
   2355  f7f7		       85 a7		      sta	LevelStartRoom
   2356  f7f9		       60		      rts
