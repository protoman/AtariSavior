   2727  f984		       a5 8e		      lda	CollisionEndX
   2728  f986		       85 8b		      sta	CollisionX
   2729  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2730  f989							;   was re-loaded every cell — −8c/cell walk
   2731  f989							;   trim for the falling+probe heavy frame)
