   4168  ffec
   4169  ffec							; ------------------------------------------------------------------------------
   4170  ffec							; HotOverlapFlag — bank3 entry tramp (C7 2026-10-20: the hot walk went back
   4171  ffec							; to bank3 with the shape/extras stream it reads). Moved off $FE90 into the
   4172  ffec							; 6-byte gap after TallyTramp. bank0 executes `sta $1FF9`; the `jmp` at +3 is
   4173  ffec							; fetched from bank3's image at $FFEF (guard: check_moth_tramp).
   4174  ffec							; ------------------------------------------------------------------------------
   4175  ffec					      .ds	$FFEC - *, 0
   4176  ffec				   HotOverlapFlag
   4177  ffec		       8d f9 1f 	      sta	$1FF9	; select bank3 (record stream lives there)
   4178  ffef		       4c f8 f8 	      jmp	$F8F8	; bank3 HotOverlapBody (synced by verify_build)
   4179  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   4180  fff2
   4181  fff2							; ------------------------------------------------------------------------------
   4182  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   4183  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   4184  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   4185  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   4186  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   4187  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   4188  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   4189  fff2							;   One less push level too (no fold / no pad call inside the body).
   4190  fff2							;   Full behavior docs moved with the body.
   4191  fff2							; ------------------------------------------------------------------------------
   4192  fff2
   4193  fff2							; ==============================================================================
   4194  fff2							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   4195  fff2							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   4196  fff2							; ==============================================================================
   4197  fff2							; ==============================================================================
   4198  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   4199  fffa
   4200  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   4201  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   4202  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
