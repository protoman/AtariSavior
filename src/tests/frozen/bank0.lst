   1225  f276							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1226  f276							; The high byte alone is NOT enough (2026-10-22): `cmp #>MAX_FALL` with vyHi
   1227  f276							; == $01 is EQUAL, so the old code rewrote vy to exactly $0180 for every speed
   1228  f276							; in $0100..$017F — a falling player's thrust was computed and then thrown
   1229  f276							; away every frame (vy: $0180 -> $0188 -> $0158 -> clamped back to $0180), so
   1230  f276							; the jet could not slow a fall at all. Compare the low byte when the high
   1231  f276							; bytes match.
   1232  f276		       a5 94		      lda	vyHi
   1233  f278		       30 17		      bmi	.RiseClamp
   1234  f27a		       c9 01		      cmp	#>MAX_FALL
   1235  f27c		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1236  f27e		       d0 06		      bne	.FallClamp	; above: clamp
   1237  f280		       a5 93		      lda	vyLo
   1238  f282		       c9 80		      cmp	#<MAX_FALL
   1239  f284		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1240  f286				   .FallClamp
   1241  f286		       a9 01		      lda	#>MAX_FALL
   1242  f288		       85 94		      sta	vyHi
   1243  f28a		       a9 80		      lda	#<MAX_FALL
   1244  f28c		       85 93		      sta	vyLo
   1245  f28e		       4c 9d f2 	      jmp	.Integrate
   1246  f291				   .RiseClamp
   1247  f291		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1248  f293		       b0 08		      bcs	.Integrate
   1249  f295		       a9 ff		      lda	#$ff
   1250  f297		       85 94		      sta	vyHi
   1251  f299		       a9 00		      lda	#$00
   1252  f29b		       85 93		      sta	vyLo	; vy = -$0100
   1253  f29d
   1254  f29d							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1255  f29d							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1256  f29d							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1257  f29d							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1258  f29d							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1259  f29d							;     resumes (he lifts off). No Up -> hovers in place.
   1260  f29d				   .Integrate
   1261  f29d		       a5 9c		      lda	Hover
   1262  f29f		       f0 13		      beq	.DoInt
   1263  f2a1		       a5 96		      lda	JetPower
   1264  f2a3		       c9 09		      cmp	#GRAVITY + 1
   1265  f2a5		       b0 09		      bcs	.HoverEnd
   1266  f2a7		       a9 00		      lda	#0
   1267  f2a9		       85 93		      sta	vyLo
   1268  f2ab		       85 94		      sta	vyHi
   1269  f2ad		       4c b4 f2 	      jmp	.DoInt
   1270  f2b0				   .HoverEnd
   1271  f2b0		       a9 00		      lda	#0
   1272  f2b2		       85 9c		      sta	Hover
   1273  f2b4				   .DoInt
