   3988  ff2a		       a5 a4		      lda	LevelMinerRoom
   3989  ff2c		       10 04		      bpl	.SORdone
   3990  ff2e		       a9 08		      lda	#$08
   3991  ff30		       85 0c		      sta	REFP1
