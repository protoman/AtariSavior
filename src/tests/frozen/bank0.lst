   1616  f3e5		       3d c9 f3 	      and	EnemyBitTable,X
   1617  f3e8		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1618  f3ea		       bc 77 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1619  f3ed		       20 f6 fe 	      jsr	FoldIndirect	; type|dir (UEDispatch masks b7)
   1620  f3f0		       4c 0e f6 	      jmp	UEDispatch	; UEDispatch replaces the old
