   2561  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2562  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2563  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2564  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2565  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2566  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2567  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2568  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2569  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2570  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2571  f980							; before — same ZP, no new allocation).
   2572  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2573  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2574  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2575  f980		       a5 8d		      lda	CollisionCellY
   2576  f982		       85 92		      sta	RectCount
   2577  f984				   .CWRow
   2578  f984		       a5 8e		      lda	CollisionEndX
   2579  f986		       85 8b		      sta	CollisionX
   2580  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2581  f989							;   was re-loaded every cell — −8c/cell walk
   2582  f989							;   trim for the falling+probe heavy frame)
   2583  f989				   .CWCol
   2584  f989		       a4 92		      ldy	RectCount
   2585  f98b		       98		      tya
   2586  f98c		       18		      clc
   2587  f98d		       7d a9 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2588  f990		       a8		      tay
   2589  f991		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2590  f994		       3d bd fd 	      and	ColMask,X	; bit for this source col
   2591  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2592  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2593  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2594  f99d		       e8		      inx
   2595  f99e		       86 8b		      stx	CollisionX
   2596  f9a0		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
   2597  f9a2				   .CWRowDone
   2598  f9a2		       a5 92		      lda	RectCount
   2599  f9a4		       c5 8f		      cmp	CollisionEndY	; row == bottom?
   2600  f9a6		       f0 07		      beq	.CWNoHit
   2601  f9a8		       e6 92		      inc	RectCount
   2602  f9aa		       d0 d8		      bne	.CWRow	; always (row never wraps to 0)
   2603  f9ac				   .CWHit
   2604  f9ac		       4c 90 fe 	      jmp	HotOverlapFlag	; C=1 contract; hot rects unchanged (ROM stream)
   2605  f9af				   .CWNoHit
   2606  f9af							; Phase 4: miss → asym-patch overlay (push-neutral tramp, moth pattern).
   2607  f9af							; OverlayTramp gates on LineCount ($84 = packed byte, VBL/$8F staged):
   2608  f9af							; symmetric rooms pay +8c and return here-shaped clc/rts; asym rooms
   2609  f9af							; cross to bank2 PHMOverlay (patch column + band mask), exit via
   2610  f9af							; ReturnPad $FBF8 — rts pops THIS call's return (0 pushes total, SP
   2611  f9af							; guard unchanged). Overlay sets C itself (plain sec — patch cells are
   2612  f9af							; envelope-guaranteed non-hot, so HotOverlapFlag must not run).
   2613  f9af		       4c b8 f9 	      jmp	OverlayTramp
