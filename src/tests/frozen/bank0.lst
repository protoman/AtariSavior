   3027  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3028  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3029  fce7		       85 83		      sta	LaserX
