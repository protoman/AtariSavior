   3600  fcdb		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3601  fcdd		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3602  fcdf		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3603  fce1		       85 83		      sta	LaserX
