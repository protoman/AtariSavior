   1939  f4f5							; Miner pickup — check if player overlaps miner, advance to next level
   1940  f4f5							; ==============================================================================
   1941  f4f5				   CheckMinerPickup
   1942  f4f5		       a5 a4		      lda	LevelMinerRoom
   1943  f4f7		       29 7f		      and	#$7f
   1944  f4f9		       c5 98		      cmp	RoomNo
   1945  f4fb		       d0 1b		      bne	.CMPDone	; not in miner's room
   1946  f4fd							; X overlap: player [RoomX, +6] vs 4px miner.
   1947  f4fd							; Accept iff RoomX - MinerX in [-6, +3].
   1948  f4fd		       a5 80		      lda	RoomX
   1949  f4ff		       38		      sec
   1950  f500		       e5 a5		      sbc	MinerX
   1951  f502		       18		      clc
   1952  f503		       69 06		      adc	#PLAYER_WIDTH - 1
   1953  f505		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1954  f507		       b0 0f		      bcs	.CMPDone	; no X overlap
   1955  f509							; Y overlap: player [RoomY, +11] vs miner [MinerY, +11]
