   1384  f281		       c9 01		      cmp	#>MAX_FALL
   1385  f283		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1386  f285		       d0 06		      bne	.FallClamp	; above: clamp
   1387  f287		       a5 93		      lda	vyLo
   1388  f289		       c9 80		      cmp	#<MAX_FALL
   1389  f28b		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1390  f28d				   .FallClamp
