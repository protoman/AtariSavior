   1712  f4df							; ==============================================================================
   1713  f4df							; Room exit handlers — check connection table, switch rooms, reposition player
   1714  f4df							; ==============================================================================
   1715  f4df							; ------------------------------------------------------------------------------
   1716  f4df							; C3 (2026-10-20): the four handlers MOVED to bank2 ($FC4F cluster) — the
   1717  f4df							; connection table is level data in bank2, so each handler now reads its own
   1718  f4df							; 2-byte conn record directly (bank1 GetConnIdx + FoldIndirect hops gone).
   1719  f4df							; bank0 keeps only the entry pads at $FBD9-$FBE4 (3 B each, `sta $1FF8`;
   1720  f4df							; bank2 serves the `jmp` at A+3). The OPPOSITE-EDGE placement is written
   1721  f4df							; BEFORE `jmp EnterRoomB2`, because EnterRoom never touches RoomX/RoomY
   1722  f4df							; (checked: EnterRoomB2 + B3RoomBlocks read neither) — that keeps the whole
   1723  f4df							; tail in bank2 with 0 pushes: EnterRoomB2's `jmp ReturnPad` pops the
   1724  f4df							; ORIGINAL `jsr ExitRoomXxx` frame, exactly like the old in-bank return.
   1725  f4df							; Guard: verify_build.CORRIDOR_PADS (4 pads) + check_exit_handlers (edge
   1726  f4df							; placement precedes the EnterRoomB2 tail; no-exit path ends in ReturnPad).
   1727  f4df							; ------------------------------------------------------------------------------
   1728  f4df
   1729  f4df							; ==============================================================================
   1730  f4df							; Level management
   1731  f4df							; ==============================================================================
   1732  f4df							; LoadLevel MOVED to bank2 (C2, 2026-10-20) — body = LoadLevelB2 ($F640).
   1733  f4df							; The level index/table lives in bank2 (level data), so the old body paid 7
   1734  f4df							; `jsr FoldIndirect` (7 x 25c + 14 bank switches) to read a 7-byte entry that
   1735  f4df							; an in-bank (FetchPtr),Y read now fetches directly. Both halves are split
   1736  f4df							; pads (same discipline as CallPad_SelectObject):
   1737  f4df							;   A=$FC20  CallPad_LoadLevel / LoadLevel: `sta $1FF8`   (bank0 runs this)
   1738  f4df							;   A+3=$FC23	bank2 `jmp LoadLevelB2` 		   (fetched after it)
   1739  f4df							;   body tail `jmp $FC26` -> bank2 `sta $1FF6` at $FC26 -> the fetch at $FC29
   1740  f4df							;   comes from HERE: `jmp LF_B0Tail`, i.e. the drop-in tail (EnterRoom call,
   1741  f4df							;   level-start placement, `jmp DropArm`) stays in bank0 so the call chain and
   1742  f4df							;   the measured stack depth are UNCHANGED (0 extra jsr levels, 0 pushes).
   1743  f4df							; Entry layout: stride 7 = miner_room (b7 = faces right), miner_x, wall color,
   1744  f4df							; wall color 2, block base word (RoomShapes), room count n (the RoomPositions
   1745  f4df							; /RoomCounts/enemy-record bases are that block's +n/+2n/+3n offsets, C2).
   1746  f4df							; Guards: verify_build.check_callpads pins the entry pad bytes + operand,
   1747  f4df							; check_loadlevel_tramp pins the return half; tools/test_respawn_hover.py,
   1748  f4df							; test_room_dark.py and test_level_bank.py read the bank2 body.
   1749  f4df
   1750  f4df							; ==============================================================================
   1751  f4df							; Miner pickup — check if player overlaps miner, advance to next level
   1752  f4df							; ==============================================================================
   1753  f4df				   CheckMinerPickup
   1754  f4df		       a5 a4		      lda	LevelMinerRoom
   1755  f4e1		       29 7f		      and	#$7f
   1756  f4e3		       c5 98		      cmp	RoomNo
   1757  f4e5		       d0 1b		      bne	.CMPDone	; not in miner's room
   1758  f4e7							; X overlap: player [RoomX, +6] vs 4px miner.
   1759  f4e7							; Accept iff RoomX - MinerX in [-6, +3].
   1760  f4e7		       a5 80		      lda	RoomX
   1761  f4e9		       38		      sec
   1762  f4ea		       e5 a5		      sbc	MinerX
   1763  f4ec		       18		      clc
   1764  f4ed		       69 06		      adc	#PLAYER_WIDTH - 1
   1765  f4ef		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1766  f4f1		       b0 0f		      bcs	.CMPDone	; no X overlap
   1767  f4f3							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1768  f4f3							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1769  f4f3		       a5 81		      lda	RoomY
   1770  f4f5		       38		      sec
   1771  f4f6		       e5 a6		      sbc	MinerY
   1772  f4f8		       18		      clc
   1773  f4f9		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1774  f4fb		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1775  f4fd		       b0 03		      bcs	.CMPDone	; no Y overlap
   1776  f4ff							; Pickup! Arm the level-bonus tally (frozen count-up, then advance).
   1777  f4ff							; TallyArm (bank2, via TallyTramp) snapshots time/bombs/lives into
   1778  f4ff							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
   1779  f4ff							; TallyWork, whose done path does the old tail (level++/LoadLevel/bar).
   1780  f4ff		       20 e6 ff 	      jsr	TallyTramp
