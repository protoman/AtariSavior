   3742  ffef		       4c c7 f5 	      jmp	$F5C7	; bank3 HotOverlapBody (synced by verify_build)
   3743  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   3744  fff2
   3745  fff2							; ------------------------------------------------------------------------------
   3746  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   3747  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   3748  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   3749  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   3750  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   3751  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   3752  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   3753  fff2							;   One less push level too (no fold / no pad call inside the body).
   3754  fff2							;   Full behavior docs moved with the body.
   3755  fff2							; ------------------------------------------------------------------------------
