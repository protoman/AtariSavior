   1895  f5d5							; ==============================================================================
   1896  f5d5							; SelectActiveObject — choose the single GRP1 object to draw this frame.
   1897  f5d5							; The TIA has one GRP1 sprite, so objects flicker by rotating slots each frame.
   1898  f5d5							; Sets ObjBase, ActiveObjectX, ActiveObjectY, ObjTop, COLUP1.
   1899  f5d5							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   1900  f5d5							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0
   1901  f5d5							; (~15 Hz); other frames normal miner/enemy rotation (FlickerFrame alone).
   1902  f5d5							; One GRP1: cannot draw bomb + entity same frame.
   1903  f5d5							; ------------------------------------------------------------------------------
   1904  f5d5				   SelectActiveObject
   1905  f5d5							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   1906  f5d5							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   1907  f5d5							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   1908  f5d5							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   1909  f5d5							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   1910  f5d5							; middle of the screen" the moment the points counting started).
   1911  f5d5		       a5 8a		      lda	DropTarget
   1912  f5d7		       c9 fe		      cmp	#$FE
   1913  f5d9		       d0 27		      bne	.SOFull
   1914  f5db		       a9 00		      lda	#0
   1915  f5dd		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   1916  f5df		       85 b6		      sta	ObjBase	; 0 = no object
   1917  f5e1		       a5 a4		      lda	LevelMinerRoom
   1918  f5e3		       29 7f		      and	#$7f
   1919  f5e5		       c5 98		      cmp	RoomNo
   1920  f5e7		       f0 03		      beq	.SOTallyMiner
   1921  f5e9		       4c d1 f6 	      jmp	.SODone	; miner not here -> nothing drawn
   1922  f5ec				   .SOTallyMiner
   1923  f5ec		       a9 38		      lda	#OBJ_MINER
   1924  f5ee		       85 b6		      sta	ObjBase
   1925  f5f0		       a5 a5		      lda	MinerX
   1926  f5f2		       85 b7		      sta	ActiveObjectX
   1927  f5f4		       a5 a6		      lda	MinerY
   1928  f5f6		       18		      clc
   1929  f5f7		       69 03		      adc	#3	; same 3px offset as the normal miner path
   1930  f5f9		       85 b8		      sta	ActiveObjectY
   1931  f5fb		       a9 66		      lda	#$66	; purple (hue 6, luma 3)
   1932  f5fd		       85 07		      sta	COLUP1
