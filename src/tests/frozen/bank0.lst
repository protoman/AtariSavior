   4580  ff20							; ------------------------------------------------------------------------------
   4581  ff20							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4582  ff20							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4583  ff20							; the facing until contact, then resets to the eye (single missile, KISS —
   4584  ff20							; user spec: no piercing, no HERO comparison needed).
   4585  ff20							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4586  ff20							;						  left	RoomX-4)
   4587  ff20							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4588  ff20							;     wrap) -> reset to eye (unsigned check catches both)
   4589  ff20							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4590  ff20							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4591  ff20							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4592  ff20							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4593  ff20							;     priority over M0 anyway).
   4594  ff20							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4595  ff20							;     press edge re-anchors).
   4596  ff20							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4597  ff20							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4598  ff20							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4599  ff20							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4600  ff20							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4601  ff20							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4602  ff20							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4603  ff20							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4604  ff20							; ------------------------------------------------------------------------------
   4605  ff20				   LaserInput
   4606  ff20		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4607  ff22		       8a		      txa
   4608  ff23		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4609  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4610  ff27		       8a		      txa
   4611  ff28		       29 80		      and	#LASER_HELD
   4612  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4613  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4614  ff2d		       85 c0		      sta	LaserState
   4615  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4616  ff31		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4617  ff33							; below — moved here so the cap code could
   4618  ff33							; not push .LaserReleased past bmi's ±127)
   4619  ff33				   .LaserReleased
   4620  ff33		       a9 00		      lda	#0
   4621  ff35		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4622  ff37							; otherwise -> bars slid across screen
   4623  ff37		       60		      rts		; LaserX kept; next press edge re-anchors
   4624  ff38				   .LaserFire
   4625  ff38		       a5 c0		      lda	LaserState
   4626  ff3a		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4627  ff3c		       85 c0		      sta	LaserState
   4628  ff3e		       8a		      txa
   4629  ff3f		       29 80		      and	#LASER_HELD
   4630  ff41		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4631  ff43							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4632  ff43							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4633  ff43							; step would jump out of the 8px wall with no candidate ever inside it
   4634  ff43							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4635  ff43							; here (b7 held from the ora above). Open-hold cadence alternates
   4636  ff43							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4637  ff43		       a5 c0		      lda	LaserState
   4638  ff45		       29 01		      and	#LASER_REARM
