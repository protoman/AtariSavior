   2004  f562		       20 f6 fe 	      jsr	FoldIndirect	; type|dir
   2005  f565		       29 07		      and	#%00000111	; b7 = dir AND b3 = the LAMP's mirror flag
   2006  f567							;   (type 13 = the wall-mirrored design), so
   2007  f567							;   both lamp types land on `cmp #LAMP`. Without
   2008  f567							;   it a dir=right enemy read $81+ and fell
