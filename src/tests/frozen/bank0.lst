    353 U00bc							; Jetpack physics constants (HERO-style)
    354 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    355 U00bc		       00 14	   JET_MAX    =	$14	; max jet thrust accumulator = 20. With the
    356 U00bc							; ÷4 ramp gate below: full thrust at 80f,
    357 U00bc							; net lift (vy=0) at exactly 60f = 1.0s
    358 U00bc							; spin-up (bugs.md #31); was $20 (÷1 ramp:
    359 U00bc							; lift after 0.25s — too snappy).
    360 U00bc		       02 00	   MAX_FALL   =	$0200	; max fall speed (positive = down)
    361 U00bc
    362 U00bc		       00 0f	   JET_AUD_BASE =	$0F	; engine AUDF base: freq = base - JetPower/8 - sputter
    363 U00bc		       00 08	   JET_AUD_VOL =	$08	; engine volume while Up is held
    364 U00bc		       00 02	   LASER_AUD_C =	2	; laser ch0 control: div-15 tone = low pitch
    365 U00bc		       00 09	   LASER_AUD_V =	9	; laser ch0 volume while fire held
    366 U00bc
    367 U00bc
    368 U00bc
    369 U00bc							; Facing direction of the player sprite's eye
    370 U00bc		       00 00	   FACING_RIGHT =	0
    371 U00bc		       00 01	   FACING_LEFT =	1
    372 U00bc
    373 U00bc							; LaserState bits
    374 U00bc		       00 80	   LASER_HELD =	%10000000	; b7: fire held this frame (INPT4 D7=0)
    375 U00bc		       00 02	   LASER_ARMED =	%00000010	; b1: kernel .Line beam gate (BeamMask $02
    376 U00bc							;   shares b1 — ENAM0 = BeamMask & LaserState)
    377 U00bc		       00 82	   LASER_ON   =	%10000010	; b7+b1 in one ora (held AND armed)
    378 U00bc		       00 3c	   LASER_DARK =	%00111100	; b5-2: RoomDarkMask rooms 4-7 (IsRoomDark/SetRoomDark)
    379 U00bc		       00 01	   LASER_REARM =	%00000001	; b0: contact consumed last frame — next held
    380 U00bc							;   frame re-tests the eye instead of stepping
    381 U00bc							;   (flush hold: eye mid-tile, +4 would jump
    382 U00bc							;   out with no candidate ever inside the wall)
    383 U00bc		       00 3d	   LASER_KEEP =	%00111101	; dark|rearm: prologue store preserving b0
