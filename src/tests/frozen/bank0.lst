   2220  f679		       a9 65		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   2221  f67b		       85 b6		      sta	ObjBase
   2222  f67d		       a9 08		      lda	#OBJ_BOMB_H	; bomb design height (8-row art; OBJ_WINDOW
   2223  f67f							;   would draw the RAFT rows underneath)
   2224  f67f		       85 9d		      sta	ObjHeight
   2225  f681		       a5 f6		      lda	BombX
   2226  f683		       85 b7		      sta	ActiveObjectX
   2227  f685		       a5 85		      lda	BombY
   2228  f687		       85 b8		      sta	ActiveObjectY
