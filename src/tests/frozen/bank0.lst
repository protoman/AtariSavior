    372 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER's lit pixels start at col 0 (the
    373 U00bc							;   art is stored facing right)
    374 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    375 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    376 U00bc							; placed X, so the snake retreats a tile behind
    377 U00bc							; its placement and then comes out a tile — 2
    378 U00bc							; tiles of travel total. The editor cannot ask
    379 U00bc							; the user to place it 2 tiles from the border.
    380 U00bc		       00 14	   TILE_COLUMNS =	20	; columns per half (reflected playfield)
