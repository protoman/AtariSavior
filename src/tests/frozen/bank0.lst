   3503  fca5							; ------------------------------------------------------------------------------
   3504  fca5							; CheckBandTouch — overscan: if band on and sprite touches the water strip →
   3505  fca5							; life. Strip = bottom ~12 lines of the cave (bottom_band_plan rule 2);
   3506  fca5							; sprite origin RoomY >= 115 enters it (115 + 21 = 136 = the same feet
   3507  fca5							; depth the 12-row sprite had at 125).
   3508  fca5							; Same path as hot/enemy: lose life, then respawn 12 scanlines up (min 0).
   3509  fca5							; Band color = VBLANK-staged RoomBandColor ($D2, PF1Buf[3] dead-row alias;
   3510  fca5							; staged by the VBLANK fold from LevelEnemy+RoomNo*4+3 — a kernel-time fold
   3511  fca5							; overruns the .WaterRow line). Read inlined here and in .WaterRow (0 = off).
   3512  fca5							; ------------------------------------------------------------------------------
   3513  fca5				   CheckBandTouch
   3514  fca5		       a5 bc		      lda	RoomBandColor
   3515  fca7		       f0 09		      beq	.CBTdone	; band off
   3516  fca9		       a5 81		      lda	RoomY
   3517  fcab		       c9 73		      cmp	#115	; feet (RoomY+21) reach 136 in the strip
   3518  fcad		       90 03		      bcc	.CBTdone	; above strip
   3519  fcaf		       20 b3 fc 	      jsr	LoseLifeBand
   3520  fcb2				   .CBTdone
   3521  fcb2		       60		      rts
   3522  fcb3
   3523  fcb3							; ------------------------------------------------------------------------------
   3524  fcb3							; LoseLifeBand — life path + respawn just above the water strip.
   3525  fcb3							; The shift MUST happen BEFORE LoseLife: its stay path tail-jumps DropArm,
   3526  fcb3							; which freezes RoomY as the drop destiny. Shifting after the call was dead
   3527  fcb3							; code — a water death respawned at the death Y (inside the strip, >= 125) and
   3528  fcb3							; the player died again on landing, unable to fly out (user report 2026-10-21).
   3529  fcb3							; The shift is one tile (spec: -= 12, not the whole band): the band check
   3530  fcb3							; tests the sprite ORIGIN (RoomY >= 115), so 115 -> 103 clears the strip.
   3531  fcb3							; Tail-jmps LoseLife (never returns here): its exhausted path rts straight to
   3532  fcb3							; CheckBandTouch.
   3533  fcb3							; ------------------------------------------------------------------------------
   3534  fcb3				   LoseLifeBand
   3535  fcb3		       a5 81		      lda	RoomY
   3536  fcb5		       38		      sec
   3537  fcb6		       e9 0c		      sbc	#12	; one tile up
   3538  fcb8		       b0 02		      bcs	.LLBstore
   3539  fcba		       a9 00		      lda	#0	; near the top: clamp at 0
   3540  fcbc				   .LLBstore
   3541  fcbc		       85 81		      sta	RoomY
   3542  fcbe		       4c 8d fc 	      jmp	LoseLife	; freezes this Y as DropTarget and drops in
   3543  fcc1
   3544  fcc1
   3545  fcc1							; ------------------------------------------------------------------------------
   3546  fcc1							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3547  fcc1							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3548  fcc1							; caller; Y is animated from the screen top down to it).
   3549  fcc1							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3550  fcc1							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3551  fcc1							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3552  fcc1							;
   3553  fcc1							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3554  fcc1							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3555  fcc1							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3556  fcc1							;
   3557  fcc1							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3558  fcc1							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3559  fcc1							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3560  fcc1							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3561  fcc1							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3562  fcc1							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3563  fcc1							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3564  fcc1							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3565  fcc1							; ------------------------------------------------------------------------------
   3566  fcc1				   DropArm
   3567  fcc1		       a5 8a		      lda	DropTarget
   3568  fcc3		       c9 fd		      cmp	#$FD
   3569  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3570  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3571  fcc7							;   tally cleared to 0 by TallyWork before its
   3572  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3573  fcc7		       a5 81		      lda	RoomY
   3574  fcc9		       85 8a		      sta	DropTarget
   3575  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3576  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3577  fccf		       a9 00		      lda	#0
   3578  fcd1		       85 81		      sta	RoomY
   3579  fcd3		       85 95		      sta	PlayerYSub
   3580  fcd5		       85 93		      sta	vyLo
   3581  fcd7		       85 94		      sta	vyHi
   3582  fcd9		       a5 c0		      lda	LaserState
   3583  fcdb		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3584  fcdd		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3585  fcdf		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3586  fce1		       85 83		      sta	LaserX
   3587  fce3		       18		      clc
   3588  fce4		       60		      rts
   3589  fce5				   .DATitle
   3590  fce5							; Title: player already placed at level start by LoadLevel. Hide all
   3591  fce5							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3592  fce5							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3593  fce5							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3594  fce5		       a9 00		      lda	#0
   3595  fce7		       85 b3		      sta	EnemyCount
   3596  fce9		       a9 ff		      lda	#$FF
   3597  fceb		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3598  fced							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3599  fced							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3600  fced							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3601  fced							; preview still renders dark.
   3602  fced		       a5 c0		      lda	LaserState
   3603  fcef		       29 3d		      and	#LASER_KEEP
   3604  fcf1		       85 c0		      sta	LaserState
   3605  fcf3		       a5 a3		      lda	Level
   3606  fcf5		       18		      clc
   3607  fcf6		       69 01		      adc	#1	; 1-based level number (the title SELECT)
   3608  fcf8		       20 08 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3609  fcfb		       a9 00		      lda	#0
   3610  fcfd		       85 f3		      sta	ScoreTh
   3611  fcff		       85 f4		      sta	ScoreHu
   3612  fd01		       18		      clc
   3613  fd02		       60		      rts
