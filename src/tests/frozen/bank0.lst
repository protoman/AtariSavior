   2988  fcc7							; ------------------------------------------------------------------------------
   2989  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   2990  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   2991  fcc7							; caller; Y is animated from the screen top down to it).
   2992  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   2993  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   2994  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   2995  fcc7							;
   2996  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   2997  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   2998  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   2999  fcc7							;
   3000  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3001  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3002  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3003  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3004  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3005  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3006  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3007  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3008  fcc7							; ------------------------------------------------------------------------------
   3009  fcc7				   DropArm
   3010  fcc7		       a5 8a		      lda	DropTarget
   3011  fcc9		       c9 fd		      cmp	#$FD
   3012  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3013  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3014  fccd							;   tally cleared to 0 by TallyWork before its
   3015  fccd							;   LoadLevel — same-size swap 2026-10-06)
   3016  fccd		       a5 81		      lda	RoomY
   3017  fccf		       85 8a		      sta	DropTarget
   3018  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3019  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3020  fcd5		       a9 00		      lda	#0
