   4670  ff3a				   .LaserFire
   4671  ff3a		       a5 c0		      lda	LaserState
   4672  ff3c		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4673  ff3e		       85 c0		      sta	LaserState
   4674  ff40		       8a		      txa
