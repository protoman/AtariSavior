   2292  f7af							; BombTick — per-frame state machine (overscan).
   2293  f7af							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2294  f7af							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2295  f7af							; ------------------------------------------------------------------------------
