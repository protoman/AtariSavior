   1177  f26e							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1178  f26e		       a5 94		      lda	vyHi
   1179  f270		       30 0f		      bmi	.RiseClamp
   1180  f272		       c9 02		      cmp	#>MAX_FALL
