    978  f181							; saves 1B vs jmp: net +1B total = $FC67 fit)
    979  f181				   .AfterRows
    980  f181							; Phase 3: cave may leave the ball on (band2 BandTab=$ff) — clear ENABL
    981  f181							; at the very start of the HUD line, before bank1's first WSYNC and
    982  f181							; before the ball's x pixel on this line (bank1 has no pre-pin room for
    983  f181							; the clear: +2B tripped .ds $F9C0).
