   3170  fcc7							; ------------------------------------------------------------------------------
   3171  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3172  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3173  fcc7							; caller; Y is animated from the screen top down to it).
   3174  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3175  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3176  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3177  fcc7							;
   3178  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3179  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3180  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3181  fcc7							;
   3182  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3183  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3184  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3185  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3186  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3187  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3188  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3189  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3190  fcc7							; ------------------------------------------------------------------------------
   3191  fcc7				   DropArm
   3192  fcc7		       a5 8a		      lda	DropTarget
   3193  fcc9		       c9 fd		      cmp	#$FD
   3194  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FD intro / $FF old title → static
   3195  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3196  fccd							;   tally cleared to 0 by TallyWork before its
   3197  fccd							;   LoadLevel — same-size swap 2026-10-06)
   3198  fccd		       a5 81		      lda	RoomY
   3199  fccf		       85 8a		      sta	DropTarget
   3200  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3201  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3202  fcd5		       a9 00		      lda	#0
   3203  fcd7		       85 81		      sta	RoomY
   3204  fcd9		       85 95		      sta	PlayerYSub
   3205  fcdb		       85 93		      sta	vyLo
