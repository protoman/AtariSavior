   3618  fd3e		       f0 14		      beq	.TWrstDone
   3619  fd40		       ad 82 02 	      lda	SWCHB
   3620  fd43		       29 01		      and	#%00000001
   3621  fd45		       d0 0d		      bne	.TWrstDone
   3622  fd47		       a9 00		      lda	#0
   3623  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3624  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
