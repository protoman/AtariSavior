   1198  f252		       85 96		      sta	JetPower
   1199  f254		       4c 83 f2 	      jmp	.Gravity
   1200  f257				   .JetDecay		; Up NOT held this frame
   1201  f257		       a5 96		      lda	JetPower
   1202  f259		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1203  f25b		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1204  f25d		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1205  f25f		       05 93		      ora	vyLo
   1206  f261		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1207  f263							;   climb to stop, do NOT float
   1208  f263		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1209  f265		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1210  f267		       4c 83 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1211  f26a				   .FloatRun
   1212  f26a		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1213  f26c		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1214  f26e		       29 7f		      and	#$7F
   1215  f270		       d0 04		      bne	.FRActive
