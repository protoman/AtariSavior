   1036  f1b5		       a5 b5		      lda	BombPacked
   1037  f1b7		       29 03		      and	#%00000011
   1038  f1b9		       d0 2d		      bne	.BombMarkDown	; bomb already active: just set DownPrev
   1039  f1bb		       a5 f0		      lda	PlayerBombs
   1040  f1bd		       29 07		      and	#%00000111	; b2-0 = bombs; b7-3 are the raft's ramp state
   1041  f1bf		       f0 27		      beq	.BombMarkDown	; no bombs left: swallow edge, keep DownPrev
   1042  f1c1		       a5 b5		      lda	BombPacked
