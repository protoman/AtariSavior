   1573  f43a							; ------------------------------------------------------------------------------
   1574  f43a							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1575  f43a							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1576  f43a							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1577  f43a							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1578  f43a							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1579  f43a							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1580  f43a							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1581  f43a							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1582  f43a							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1583  f43a							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1584  f43a							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1585  f43a							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1586  f43a							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1587  f43a							; ------------------------------------------------------------------------------
   1588  f43a				   UE_Tentacle
   1589  f43a		       a5 ad		      lda	TickCounter
   1590  f43c		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1591  f43e							; = half the player's 1 px/frame (user
   1592  f43e							; 2026-10-10: &3 read as chunky/slow)
   1593  f43e		       d0 4b		      bne	.TentOut
   1594  f440		       b5 bd		      lda	EnemyRamX,X
   1595  f442		       c5 80		      cmp	RoomX
   1596  f444		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1597  f446		       90 06		      bcc	.TentRight
   1598  f448		       38		      sec
   1599  f449		       e9 01		      sbc	#1	; step left
   1600  f44b		       4c 51 f4 	      jmp	.TentProbe
   1601  f44e				   .TentRight
   1602  f44e		       18		      clc
   1603  f44f		       69 01		      adc	#1	; step right
   1604  f451				   .TentProbe
   1605  f451		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1606  f453		       b0 36		      bcs	.TentOut
   1607  f455		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1608  f457							; Same-column cull: committed X is always probe-clear, so a candidate in
   1609  f457							; the same 4px column covers the same collision cells → result is known
   1610  f457							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1611  f457		       a5 88		      lda	Temp
   1612  f459		       55 bd		      eor	EnemyRamX,X
   1613  f45b		       29 fc		      and	#$FC
   1614  f45d		       f0 28		      beq	.TentCommit
   1615  f45f		       a5 80		      lda	RoomX
   1616  f461		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1617  f463		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1618  f465		       85 b8		      sta	ActiveObjectY
   1619  f467		       a5 88		      lda	Temp
   1620  f469		       c9 05		      cmp	#5
   1621  f46b		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1622  f46d							; PHM's negative visible-left wraps to 255
   1623  f46d							; (col garbage / ColOff OOB walk). cand<=4
   1624  f46d							; ink pokes off-screen anyway; RoomX=cand
   1625  f46d							; already covers cell0.
   1626  f46d		       38		      sec
   1627  f46e		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1628  f470							; sits 5/7 px left of A (moth .Mvl convention,
   1629  f470							; bank2), but PHM's PLAYER prologue derives
   1630  f470							; lit-left = arg-4/arg-7 with the bin on
   1631  f470							; RoomX-PlayerDir → box missed the cell left
   1632  f470							; of the ink at cand 8/12 (sprite drew 1 px
   1633  f470							; into the wall — bugs.md #4). cand-1 shifts
