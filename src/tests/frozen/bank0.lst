   2061  f58e							; BombTick — per-frame state machine (overscan).
   2062  f58e							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2063  f58e							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2064  f58e							; ------------------------------------------------------------------------------
   2065  f58e				   BombTick   subroutine
   2066  f58e		       a5 b5		      lda	BombPacked
   2067  f590		       29 03		      and	#%00000011	; state
   2068  f592		       f0 41		      beq	.BTDone	; none
   2069  f594		       c9 01		      cmp	#1
   2070  f596		       f0 0f		      beq	.BTFuse
   2071  f598							; state 2 — exploding
   2072  f598		       c6 f7		      dec	BombTimer
   2073  f59a		       d0 39		      bne	.BTDone
   2074  f59c		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2075  f59e		       29 fc		      and	#%11111100
   2076  f5a0		       85 b5		      sta	BombPacked
   2077  f5a2		       a9 00		      lda	#0
   2078  f5a4		       85 f7		      sta	BombTimer
   2079  f5a6		       60		      rts
   2080  f5a7				   .BTFuse
   2081  f5a7		       c6 f7		      dec	BombTimer
   2082  f5a9		       d0 2a		      bne	.BTDone
   2083  f5ab		       a5 b5		      lda	BombPacked	; 1 → 2
   2084  f5ad		       29 fc		      and	#%11111100
   2085  f5af		       09 02		      ora	#%00000010
   2086  f5b1		       85 b5		      sta	BombPacked
   2087  f5b3		       a9 3c		      lda	#60
   2088  f5b5		       85 f7		      sta	BombTimer
   2089  f5b7		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2090  f5ba		       aa		      tax
   2091  f5bb		       f0 08		      beq	.BTNoScore
   2092  f5bd				   .BTScore
   2093  f5bd		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2094  f5bf		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2095  f5c2		       ca		      dex
   2096  f5c3		       d0 f8		      bne	.BTScore
   2097  f5c5				   .BTNoScore
   2098  f5c5		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2099  f5c8		       f0 05		      beq	.BTNoKill
   2100  f5ca		       a9 50		      lda	#$50	; +50 per kill — moved out of the pad body
   2101  f5cc		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2102  f5cf				   .BTNoKill
   2103  f5cf		       20 d6 f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2104  f5d2		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2105  f5d5				   .BTDone
   2106  f5d5		       60		      rts
