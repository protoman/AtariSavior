   1698  f4c8		       4a		      lsr		; ÷4 gate (1 px per 4 frames)
   1699  f4c9		       29 3f		      and	#$3F	; p = 0..63
   1700  f4cb		       c9 30		      cmp	#48
   1701  f4cd		       90 04		      bcc	.DEYSUp
