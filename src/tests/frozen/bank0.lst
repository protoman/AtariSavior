   3156  fd77							; ------------------------------------------------------------------------------
   3157  fd77							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3158  fd77							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3159  fd77							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3160  fd77							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3161  fd77							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3162  fd77							; DeriveEnemyY — no persistent movement state exists in RAM.
   3163  fd77							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3164  fd77							; block after the pads; pre-pad headroom is 1B).
   3165  fd77							; ------------------------------------------------------------------------------
   3166  fd77				   RefreshEnemyY
   3167  fd77		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3168  fd79							; TickCounter is the 60-frame GAME timer
   3169  fd79							; (decrements 60->1, reloads) — gates derived
   3170  fd79							; from it wrapped every second (spider
   3171  fd79							; "teleported": (TC>>3)&63 only ever saw
   3172  fd79							; 0..7 and counted DOWN 0->7 = jump).
   3173  fd79		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3174  fd7b		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3175  fd7d				   .REYLoop		; every reader runs after refresh completes)
   3176  fd7d		       ca		      dex
   3177  fd7e		       20 73 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3178  fd81		       95 e2		      sta	EnemyRamY,X
   3179  fd83		       8a		      txa		; N/Z must come from X: flags after jsr are
   3180  fd84		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3181  fd86				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3182  fd86							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3183  fd86							; black rooms, broken PF, invisible sprites)
   3184  fd86							; --- SELECT or RESET held → back to the old title / level-select screen
   3185  fd86							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3186  fd86							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3187  fd86							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3188  fd86							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3189  fd86							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3190  fd86							;     RESET held past LANDING still re-fires — press must be released
   3191  fd86							;     before the drop-in finishes. ---
   3192  fd86		       a5 8a		      lda	DropTarget
   3193  fd88		       d0 17		      bne	.REYRts	; not idle: not ours
   3194  fd8a		       ad 82 02 	      lda	SWCHB
   3195  fd8d		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3196  fd8f		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3197  fd91		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3198  fd93		       f0 0c		      beq	.REYRts	; neither pressed
   3199  fd95		       a9 ff		      lda	#$FF
   3200  fd97		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3201  fd99		       20 2f f5 	      jsr	LoadLevel	; reload the level-start room for the preview
   3202  fd9c		       68		      pla		; drop OUR return address (LoadLevel already
   3203  fd9d		       68		      pla		;   popped its own) — tail into TitleWork
   3204  fd9e		       4c 31 fd 	      jmp	TitleWork
   3205  fda1				   .REYRts
   3206  fda1		       60		      rts
