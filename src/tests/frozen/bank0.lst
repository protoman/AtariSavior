    216 U00bc							; Score ZP variables (shared with bank1 HUD — addresses MUST match bank1)
    217 U00bc							; $F3-$F5 live score only — $F6 is BombX (bank1 ScoreOn is unused).
    218 U00bc		       00 f3	   ScoreTh    =	$F3	; score thousands digit (0-9)
    219 U00bc		       00 f4	   ScoreHu    =	$F4	; score hundreds digit (0-9)
    220 U00bc		       00 f5	   ScoreTe    =	$F5	; score tens digit (0-9)
    221 U00bc							; PF0ScoreBuf/PF1ScoreBuf removed (S3.0): dead legacy EQUs — the 48px
    222 U00bc							; sprite score never used PF score buffers (decl-only, zero references).
    223 U00bc
    224 U00bc							; P3.4 rect cache — solid rect list copied once per EnterRoom, walked directly
    225 U00bc							; by PlayerHitsMap with NO bank2 fold (fold mid-function switched the EXECUTION
    226 U00bc							; bank; only byte-identical pad code may span a switch). Layout (S3.2 —
    227 U00bc							; UNIFORM STRIDE: all 5 rects contiguous, no windows, no .Stage3):
    228 U00bc							;   $89       count	    (RcBase — sequential decl; MUST stay outside
    229 U00bc							;			     bank1's $E0-$EF stomp zone: the first attempt
    230 U00bc							;			     had count/rect4.h inside it and scorePtr writes
    231 U00bc							;			     zeroed rect4.h every HUD frame → probes passed
    232 U00bc							;			     through rect4 walls = tentacle walked inside
    233 U00bc							;			     walls. Keep ALL persistent cache bytes < $E0.)
    234 U00bc							;   $CC-$DF  rect0..rect4 (walk: FetchPtr base RcW1=$CC, Y=0..19, stride 4;
    235 U00bc							;			    mask index = Y>>2, table has a $00 entry for
    236 U00bc							;			    index 4 = rect4 never masked)
    237 U00bc							; rect4 x,y,w,h live IN the cache ($DC-$DF) since S3.2 — the old split
    238 U00bc							; slots are gone (DropTarget $8A keeps the allocation byte), Rc4W retired.
    239 U00bc							; Buffers packed: PF0 $C3-$C5, PF1 $C6-$C8, PF2 $C9-$CB (rows 0-2 only).
    240 U00bc							; ($E0/$E1 are spare/stomp-zone — never persistent bank0 state.)
    241 U00bc		       00 cc	   RcW1       =	$CC	; walk FetchPtr base (rect0 x at Y=0; Y→$DF)
    242 U00bc							; Rc4W/Rc4H retired (S3.2): rect4.w/h = cache bytes $DE/$DF, reached by
    243 U00bc							; the uniform stride like every other field. RcBase is the $89 decl above.
    244 U00bc
    245 U00bc							; PF cave buffers (copied from ROM during VBLANK, read by kernel via absolute indexed)
    246 U00bc							; These share ZP space with bank1's HUD variables — safe because bank1
    247 U00bc							; runs AFTER the cave kernel. Bank1 overwrites them during HUD band;
    248 U00bc							; VBLANK re-populates them before the next kernel frame.
    249 U00bc		       00 c3	   PF0Buf     =	$C3	; 3 bytes: TilePF0 rows 0-2 (stride-3 data S4.2)
    250 U00bc							; (rows 0-2 pure since S3.4 — Y moved to $E2)
    251 U00bc		       00 c6	   PF1Buf     =	$C6	; rows 0-2 only (S3.1 packed; was $CF)
    252 U00bc		       00 bc	   RoomBandColor =	$BC	; band-color cache (level_bank_plan P2.5) —
    253 U00bc							; own byte since S3.1 (was $D2 = PF1Buf[3];
    254 U00bc							; history: FIX 2026-09-28 was $D1 = PF1Buf[2]
    255 U00bc							; collision → mid-wall gap; alias class now
    256 U00bc							; gone entirely). Writer: VBLANK stage AFTER
    257 U00bc							; LoadPFBuffer/BuildColupF (fold from
    258 U00bc							; LevelEnemy+RoomNo*4+3). Readers: kernel
    259 U00bc							; .WaterRow (direct lda, plain abs = 4c any
    260 U00bc							; address) + overscan CheckBandTouch. Window:
    261 U00bc							; VBL write → kernel + overscan read same
    262 U00bc							; frame ($BC is nobody else's byte) → next
    263 U00bc							; VBL restages.
    264 U00bc		       00 c9	   PF2Buf     =	$C9	; rows 0-2 only (S3.1 packed; was $DB-$E6)
    265 U00bc		       00 e7	   ColupfBuf  =	$E7	; 12 bytes: final COLUPF per tile row (stripe+hot)
    266 U00bc		       00 e5	   FetchPtr   =	$E5	; fold-indirect pointer ($E5 lo, $E6 hi) —
    267 U00bc							; MOVED S3.2 to free $E0 for rect4.h (cache
    268 U00bc							; $CD-$E0 now uniform). Sits in bank1's
    269 U00bc							; stomp zone (scorePtr3-hi/scorePtr4-lo) —
    270 U00bc							; time-partitioned: bank0 stages only inside
    271 U00bc							; VBL/overscan batches, bank1 rebuilds in
    272 U00bc							; HUD after both windows. Contract (fold
    273 U00bc							; wins): stage addr immediately before a
    274 U00bc							; FoldIndirect batch.
    275 U00bc		       00 ed	   BandTab    =	$ED	; Phase 3 asym ball: staged Band0/1/2
    276 U00bc							; ($ff = ball band, $00 = mirror). Written
    277 U00bc							; by bank2 StageBandTab (BuildColupF tail,
    278 U00bc							; every VBL) BEFORE this frame's cave; read
    279 U00bc							; by .Row's ENABL gate; bank1 HUD stomps
    280 U00bc							; $ED-$EF (scbrdTmp etc.) only AFTER the
    281 U00bc							; cave read — staged-only window, like
    282 U00bc							; FetchPtr. Next VBL restages.
    283 U00bc							; Enemy RAM shadow — live X/Y + packed flags. ROM records are read-only.
    284 U00bc							; Sequential vars end at $BB (ObjBot removed S3.0b); $BC = RoomBandColor,
    285 U00bc							; $BD-$BF EnemyRam, $C0 LaserState, $C1-$C2 EnemyRamD/P.
    286 U00bc							; Score lives at $F3-$F5 only ($F6/$F7 = BombX/BombTimer).
    287 U00bc							; EnemyRamY ($E2, 3B) — private bytes since S3.4 (was an alias over
    288 U00bc							; PF0Buf rows 0-2). It deliberately sits INSIDE bank1's HUD stomp zone
    289 U00bc							; ($E0-$EF score ptrs, written every frame) because every write and every
    290 U00bc							; read land inside one safe window:
    291 U00bc							;   [HUD stomp $E2-$E4] → [overscan: RefreshEnemyY/LoadEnemyRam WRITE]
    292 U00bc							;   → [CEH / Laser / moth READ] → [next VBL: SelectActiveObject READ]
    293 U00bc							;   → [HUD stomp ...]. No reader ever sits between the stomp and the write.
    294 U00bc							;   writers: RefreshEnemyY via DeriveEnemyY (overscan entry, EVERY frame —
    295 U00bc							;	      live Y is derived from ROM spawn + EnemyRamP clock, no stored
    296 U00bc							;	      movement state) + LoadEnemyRam (EnterRoom init);
    297 U00bc							;   readers: SelectActiveObject (VBLANK), CheckEnemyHit + LaserHitTest +
    298 U00bc							;	      moth walk (overscan, after the refresh).
    299 U00bc							; Effect: $C3-$C5 = pure PF0Buf rows 0-2, never stomped → the per-frame
    300 U00bc							;   VBL repair (LoadPF0Only, ~130c + 3 folds) is deleted; full
    301 U00bc							;   LoadPFBuffer runs only on EnterRoom (PF1/PF2 rows 0-2 likewise have
    302 U00bc							;   no per-frame writer). bank1 owns $E0-$EF during HUD; bank0 never keeps
    303 U00bc							;   other persistent state there (FetchPtr $E0/$E1 = staged only).
    304 U00bc		       00 bd	   EnemyRamX  =	$BD	; 3 bytes: live X per enemy ($BD-$BF, slots 0-2
    305 U00bc							; only — enemies+lamps capped at 3 by editor
    306 U00bc							; kMaxRoomElements, convert_level MAX_ENEMIES,
    307 U00bc							; verify_build; slot 3 would collide with $C0)
    308 U00bc		       00 c0	   LaserState =	$C0	; laser: b7 fire held this frame,
    309 U00bc							;   b6 fire held last frame (press-edge),
    310 U00bc							;   b5-2 RoomDarkMask rooms 4-7,
    311 U00bc							;   b1 beam gate for the kernel .Line
    312 U00bc							;     (BeamMask = $02 shares b1; mirror of b7)
    313 U00bc		       00 c1	   EnemyRamD  =	$C1	; dir bits 0-3 = enemy 0-3 (1=right, 0=left)
    314 U00bc		       00 c2	   EnemyRamP  =	$C2	; bits0-3 moth phase (shared/sync); bits4-7
    315 U00bc							;   vdir for spider/bat/tentacle (1=down)
    316 U00bc		       00 e2	   EnemyRamY  =	$E2	; 3 bytes: live Y per enemy ($E2-$E4) —
    317 U00bc							;   private since S3.4; see contract above
