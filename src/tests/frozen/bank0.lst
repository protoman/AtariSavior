    462 U00bc							; ==============================================================================
    463 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    464 U00bc							; ==============================================================================
    465 U00bc							; Bank3 is the power-up bank. Its stub does:
    466 U00bc							;   lda #0 / sta $1FF4 → selects bank0
    467 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    468 U00bc							; ==============================================================================
    469  10000 ????				       seg	code
    470  f000					      org	$F000
    471  f000
    472  f000							; --- 5-byte bankswitching pad ---
    473  f000							; After bank3's stub selects us, CPU arrives here.
    474  f000							; We jump over the pad into the real init code.
    475  f000		       a9 00		      lda	#0
    476  f002		       8d f4 1f 	      sta	$1FF4	; ensure bank0 selected (idempotent)
    477  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    478  f008							; (NOT deletable: $F008 = GameStart is a
    479  f008							;  hardcoded cross-bank entry — bank1
    480  f008							;  stub `jmp $F008`; this jmp also keeps
    481  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    482  f008							;  fold-pad byte guard fires when it moves)
    483  f008							;  + F0xx landmarks fixed)
    484  f008
    485  f008				   GameStart
    486  f008		       78		      sei		; disable interrupts
    487  f009		       d8		      cld		; clear decimal mode
    488  f00a		       a2 ff		      ldx	#$FF
    489  f00c		       9a		      txs		; stack pointer = $FF
    490  f00d
    491  f00d							; --- Clear zero-page RAM ---
    492  f00d		       a9 00		      lda	#0
    493  f00f		       a2 80		      ldx	#$80
    494  f011				   .ClearZP
    495  f011		       95 00		      sta	$00,X
    496  f013		       e8		      inx
    497  f014		       d0 fb		      bne	.ClearZP
    498  f016
    499  f016							; --- Initialize game state ---
    500  f016		       a9 00		      lda	#0
    501  f018		       85 a3		      sta	Level
    502  f01a		       a9 03		      lda	#3
    503  f01c		       85 ac		      sta	PlayerLives
    504  f01e		       a9 05		      lda	#BOMBS_MAX
    505  f020		       85 f0		      sta	PlayerBombs
    506  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    507  f022		       a9 3c		      lda	#60
    508  f024		       85 ad		      sta	TickCounter
    509  f026		       a9 78		      lda	#120
    510  f028		       85 ae		      sta	BarLevel	; bar starts full
    511  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    512  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    513  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    514  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    515  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    516  f02a		       a9 ff		      lda	#$FF
    517  f02c		       85 8a		      sta	DropTarget
    518  f02e
    519  f02e							; --- Load first level (the title previews it on the live stage:
    520  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    521  f02e		       20 20 fc 	      jsr	LoadLevel
    522  f031
    523  f031							; --- Set player color ---
    524  f031		       a9 48		      lda	#COLOR_PLAYER
    525  f033		       85 06		      sta	COLUP0
    526  f035
    527  f035							; --- Set playfield to reflected mode + priority ---
    528  f035							; D0=1 = reflect (left half mirrors to right)
    529  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    530  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    531  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    532  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    533  f037		       85 0a		      sta	CTRLPF
    534  f039
    535  f039							; ==============================================================================
    536  f039							; Frame loop
    537  f039							; ==============================================================================
    538  f039				   StartFrame
    539  f039
    540  f039							; ------------------------------------------------------------------------------
    541  f039							; VSYNC (3 scanlines)
    542  f039							; ------------------------------------------------------------------------------
    543  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    544  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    545  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    546  f039							; does not advance the wall clock to the next scanline boundary (it is already
    547  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    548  f039							; fraction depends on where the previous frame's overscan happened to end) —
    549  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    550  f039							;
    551  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    552  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    553  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    554  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    555  f039							; the sim wall-model target is updated to match.
    556  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    557  f03b		       a9 02		      lda	#2
    558  f03d		       85 00		      sta	VSYNC
    559  f03f		       85 02		      sta	WSYNC
    560  f041		       85 02		      sta	WSYNC
    561  f043		       85 02		      sta	WSYNC
    562  f045		       a9 00		      lda	#0
    563  f047		       85 00		      sta	VSYNC
    564  f049
    565  f049							; ------------------------------------------------------------------------------
    566  f049							; VBLANK (37 scanlines)
    567  f049							; ------------------------------------------------------------------------------
    568  f049		       a9 02		      lda	#2
    569  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    570  f04d
    571  f04d							; --- Set TIM64T for VBLANK ---
    572  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    573  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    574  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    575  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    576  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    577  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    578  f04d							; Worst 1059c of the 1472c window = 413c margin.
    579  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    580  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    581  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    582  f04d		       a9 17		      lda	#23
    583  f04f		       8d 96 02 	      sta	TIM64T
    584  f052
    585  f052							; --- Position player sprite horizontally ---
    586  f052		       a5 80		      lda	RoomX
    587  f054		       38		      sec
    588  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    589  f057		       a2 00		      ldx	#0	; X=0 = player0
    590  f059		       20 0f ff 	      jsr	SetObjectXPos
    591  f05c
    592  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    593  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    594  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    595  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    596  f05c
    597  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    598  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    599  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    600  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    601  f05c
    602  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    603  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    604  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    605  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    606  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    607  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    608  f05c		       20 32 f6 	      jsr	SelectActiveObject
    609  f05f
    610  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    611  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    612  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    613  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    614  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    615  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    616  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    617  f062
    618  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    619  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    620  f062							; 2026-10-04 up-exit fix). The
    621  f062							; old per-frame VBL fold that re-read the same ROM byte is
    622  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    623  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    624  f062							; the VBL path (the read that made a bank3 data move need another
    625  f062							; reader). test_band_restage covers the contract.
    626  f062
    627  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    628  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    629  f062							; Dark room: black except the existing explosion blink (state=2).
    630  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    631  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    632  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    633  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    634  f062		       a5 b5		      lda	BombPacked
    635  f064		       29 03		      and	#%00000011
    636  f066		       c9 02		      cmp	#2
    637  f068		       f0 0a		      beq	.BgBlink
    638  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    639  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    640  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    641  f071		       4c 84 f0 	      jmp	.BgStore
    642  f074				   .BgBlink
    643  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    644  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    645  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    646  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    647  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    648  f074		       a9 3c		      lda	#60
    649  f076		       38		      sec
