    370 U00bc		       00 20	   OBJ_SPIDER =	32	; 26-row HERO-height art (SPIDER, 2026-10-22), so every
    371 U00bc		       00 3a	   OBJ_LAMP   =	58	; later offset shifts when a type grows. ObjHeightTab
