   1276  f205		       29 7f		      and	#%01111111
   1277  f207		       85 88		      sta	Temp
   1278  f209
   1279  f209							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1280  f209							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1281  f209							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1282  f209							;	   catches the fall in ~10 frames from terminal $0180.
   1283  f209							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1284  f209							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1285  f209							;	   gone: it kept thrust below gravity for ~32 frames.
   1286  f209							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1287  f209							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1288  f209							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1289  f209							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1290  f209							;	   1.0s hover was too long — halved); then the flag clears and
   1291  f209							;	   normal gravity resumes (fall ~0.85s after release). State
   1292  f209							;	   lives in JetPower, NOT
   1293  f209							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1294  f209							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1295  f209							;	   rising frame — both clobbered a StepsLeft-based float.
   1296  f209							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1297  f209							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1298  f209							;	   (headroom stays $FC67).
   1299  f209							; ------------------------------------------------------------------------------
   1300  f209		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1301  f20b		       24 88		      bit	Temp
   1302  f20d		       d0 25		      bne	.JetDecay
   1303  f20f		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1304  f211		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1305  f213		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1306  f215		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1307  f217				   .JetRamp
   1308  f217							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1309  f217							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1310  f217							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1311  f217							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1312  f217							; ~80 frames = more than a room height of extra falling). The ramp only
   1313  f217							; applies from rest / while already rising, so take-off still eases in.
   1314  f217		       a5 94		      lda	vyHi
   1315  f219		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1316  f21b		       05 93		      ora	vyLo
   1317  f21d		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1318  f21f		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1319  f221		       85 96		      sta	JetPower
   1320  f223		       4c 60 f2 	      jmp	.Gravity
   1321  f226				   .JetClimb
   1322  f226		       a5 96		      lda	JetPower
   1323  f228		       c9 30		      cmp	#JET_MAX
   1324  f22a		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1325  f22c		       18		      clc
   1326  f22d		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1327  f22f		       85 96		      sta	JetPower
   1328  f231		       4c 60 f2 	      jmp	.Gravity
   1329  f234				   .JetDecay		; Up NOT held this frame
   1330  f234		       a5 96		      lda	JetPower
   1331  f236		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1332  f238		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1333  f23a		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1334  f23c		       05 93		      ora	vyLo
   1335  f23e		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1336  f240							;   climb to stop, do NOT float
   1337  f240		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1338  f242		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1339  f244		       4c 60 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1340  f247				   .FloatRun
   1341  f247		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1342  f249		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1343  f24b		       29 7f		      and	#$7F
   1344  f24d		       d0 04		      bne	.FRActive
   1345  f24f		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1346  f251		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1347  f253				   .FRActive
   1348  f253		       a5 94		      lda	vyHi
   1349  f255		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1350  f257		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1351  f259		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1352  f25b		       85 94		      sta	vyHi
