   1243  f25a							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1244  f25a							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1245  f25a							;     only — subtracting $80+ would blast the player upward.
   1246  f25a				   .Gravity
   1247  f25a		       18		      clc
   1248  f25b		       a5 93		      lda	vyLo
   1249  f25d		       69 08		      adc	#<GRAVITY
   1250  f25f		       85 93		      sta	vyLo
