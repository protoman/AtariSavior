    322 U00bc		       00 c2	   EnemyRamP  =	$C2	; bits0-3 moth phase (shared/sync); bits4-7
    323 U00bc							;   vdir for spider/bat/tentacle (1=down)
    324 U00bc		       00 e2	   EnemyRamY  =	$E2	; 3 bytes: live Y per enemy ($E2-$E4) —
    325 U00bc							;   private since S3.4; see contract above
