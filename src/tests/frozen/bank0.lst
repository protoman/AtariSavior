   2023  f56f		       d0 1c		      bne	CEHNext	; 7 = RAFT: a platform is walked on, not hit
   2024  f571		       4c a2 fb 	      jmp	CEH_KeyDisp	; 6 = key, 14 = power cell (the type mask folds b3)
