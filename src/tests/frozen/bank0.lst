   1745  f493		       bc 77 f9 	      ldy	EnemyOffTable,X
   1746  f496		       20 f6 fe 	      jsr	FoldIndirect	; type
   1747  f499		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1748  f49b							;   missed and a dir-left enemy fell through to
   1749  f49b							;   .DEYStatic (no bob)
   1750  f49b		       c9 01		      cmp	#ENEMY_BAT
   1751  f49d		       f0 18		      beq	.DEYTickNoShift
   1752  f49f		       c9 03		      cmp	#ENEMY_TENTACLE
   1753  f4a1		       f0 1a		      beq	.DEYTickShift
   1754  f4a3		       c9 00		      cmp	#ENEMY_SPIDER
   1755  f4a5		       f0 2e		      beq	.DEYSpiderTick
   1756  f4a7		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1757  f4a9		       d0 06		      bne	.DEYStatic
   1758  f4ab		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1759  f4ae		       4c ca f4 	      jmp	DEYDelta
   1760  f4b1				   .DEYStatic
   1761  f4b1		       c8		      iny
   1762  f4b2		       c8		      iny
   1763  f4b3		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1764  f4b6		       60		      rts
   1765  f4b7				   .DEYTickNoShift
   1766  f4b7		       a5 c2		      lda	EnemyRamP
   1767  f4b9		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1768  f4ba		       4c c2 f4 	      jmp	.DEYBobTick
