   1769  f46a		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1770  f46c		       85 b8		      sta	ActiveObjectY
   1771  f46e		       a5 88		      lda	Temp
   1772  f470		       c9 05		      cmp	#5
   1773  f472		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1774  f474							; PHM's negative visible-left wraps to 255
   1775  f474							; (col garbage / ColOff OOB walk). cand<=4
