   1810  f496							; ------------------------------------------------------------------------------
   1811  f496							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1812  f496							; there is no free ZP byte for per-slot movement state (phase/direction live
   1813  f496							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1814  f496							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1815  f496							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1816  f496							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1817  f496							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1818  f496							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1819  f496							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1820  f496							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1821  f496							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1822  f496							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1823  f496							;	    the 60-frame game timer — gates from it wrap every second).
   1824  f496							; Other types: straight ROM y (their movement stages come later).
   1825  f496							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1826  f496							; ------------------------------------------------------------------------------
   1827  f496				   DeriveEnemyY
   1828  f496							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1829  f496							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1830  f496		       a5 b1		      lda	EnemyDataLo
   1831  f498		       85 e5		      sta	FetchPtr
   1832  f49a		       a5 b2		      lda	EnemyDataHi
   1833  f49c		       85 e6		      sta	FetchPtr+1
   1834  f49e		       bc 77 f9 	      ldy	EnemyOffTable,X
   1835  f4a1		       20 f6 fe 	      jsr	FoldIndirect	; type
   1836  f4a4		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1837  f4a6							;   missed and a dir-left enemy fell through to
   1838  f4a6							;   .DEYStatic (no bob)
   1839  f4a6		       c9 01		      cmp	#ENEMY_BAT
   1840  f4a8		       f0 18		      beq	.DEYTickNoShift
   1841  f4aa		       c9 03		      cmp	#ENEMY_TENTACLE
   1842  f4ac		       f0 1a		      beq	.DEYTickShift
   1843  f4ae		       c9 00		      cmp	#ENEMY_SPIDER
   1844  f4b0		       f0 2e		      beq	.DEYSpiderTick
   1845  f4b2		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1846  f4b4		       d0 06		      bne	.DEYStatic
   1847  f4b6		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1848  f4b9		       4c d5 f4 	      jmp	DEYDelta
   1849  f4bc				   .DEYStatic
   1850  f4bc		       c8		      iny
   1851  f4bd		       c8		      iny
   1852  f4be		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1853  f4c1		       60		      rts
   1854  f4c2				   .DEYTickNoShift
   1855  f4c2		       a5 d7		      lda	EnemyClk
   1856  f4c4		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1857  f4c5		       4c cd f4 	      jmp	.DEYBobTick
