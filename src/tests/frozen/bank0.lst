   2395  f8dd							;   bank2 active — test_miner_colors asserts
   2396  f8dd							;   EQU == bank0 label AND byte identity). The
   2397  f8dd							;   S9 bomb-lamp stub deletion upstream must
   2398  f8dd							;   never shift these again.
   2399  f8dd				   PlayerSpriteA
