    413 U00bc							; LaserState bits
    414 U00bc		       00 80	   LASER_HELD =	%10000000	; b7: fire held this frame (INPT4 D7=0)
    415 U00bc		       00 02	   LASER_ARMED =	%00000010	; b1: kernel .Line beam gate — ENAM0 =
    416 U00bc							;   (PlayerColTable bit1) & b1, so the beam
    417 U00bc							;   row is the table's bit1 row (index 2)
    418 U00bc		       00 82	   LASER_ON   =	%10000010	; b7+b1 in one ora (held AND armed)
    419 U00bc		       00 3c	   LASER_DARK =	%00111100	; b5-2: RoomDarkMask rooms 4-7 (IsRoomDark/SetRoomDark)
    420 U00bc		       00 01	   LASER_REARM =	%00000001	; b0: contact consumed last frame — next held
    421 U00bc							;   frame re-tests the eye instead of stepping
