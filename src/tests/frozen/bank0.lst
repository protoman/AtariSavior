   1441  f3b5							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1442  f3b5							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1443  f3b5		       a5 b1		      lda	EnemyDataLo
   1444  f3b7		       85 e5		      sta	FetchPtr
   1445  f3b9		       a5 b2		      lda	EnemyDataHi
   1446  f3bb		       85 e6		      sta	FetchPtr+1
   1447  f3bd		       a2 00		      ldx	#0
   1448  f3bf				   UE_Loop
   1449  f3bf		       e4 b3		      cpx	EnemyCount
   1450  f3c1		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1451  f3c3		       4c 1e f4 	      jmp	UE_Exit
   1452  f3c6				   UE_Alive
   1453  f3c6		       a5 ba		      lda	EnemyDeadMask
   1454  f3c8		       3d ac f3 	      and	EnemyBitTable,X
   1455  f3cb		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1456  f3cd		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1457  f3d0		       20 f6 fe 	      jsr	FoldIndirect	; type
   1458  f3d3		       4c 0e f8 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1459  f3d6							; 18 B per-type compare chain with one 3 B jmp:
   1460  f3d6							; frees 15 B of pre-pad headroom and gives the
   1461  f3d6							; type tables room for the raft byte.
   1462  f3d6				   UE_SnakeBody
