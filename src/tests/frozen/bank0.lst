   1224  f208							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1225  f208							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1226  f208							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1227  f208							;	   catches the fall in ~10 frames from terminal $0180.
   1228  f208							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1229  f208							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1230  f208							;	   gone: it kept thrust below gravity for ~32 frames.
   1231  f208							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1232  f208							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1233  f208							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1234  f208							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1235  f208							;	   1.0s hover was too long — halved); then the flag clears and
   1236  f208							;	   normal gravity resumes (fall ~0.85s after release). State
   1237  f208							;	   lives in JetPower, NOT
   1238  f208							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1239  f208							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1240  f208							;	   rising frame — both clobbered a StepsLeft-based float.
   1241  f208							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1242  f208							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1243  f208							;	   (headroom stays $FC67).
   1244  f208							; ------------------------------------------------------------------------------
   1245  f208		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1246  f20a		       24 88		      bit	Temp
   1247  f20c		       d0 25		      bne	.JetDecay
   1248  f20e		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1249  f210		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1250  f212		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1251  f214		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1252  f216				   .JetRamp
   1253  f216							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1254  f216							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1255  f216							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1256  f216							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1257  f216							; ~80 frames = more than a room height of extra falling). The ramp only
   1258  f216							; applies from rest / while already rising, so take-off still eases in.
   1259  f216		       a5 94		      lda	vyHi
   1260  f218		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1261  f21a		       05 93		      ora	vyLo
   1262  f21c		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1263  f21e		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1264  f220		       85 96		      sta	JetPower
