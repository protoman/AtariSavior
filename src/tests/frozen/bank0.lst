   1554  f3d7		       e4 b3		      cpx	EnemyCount
   1555  f3d9		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1556  f3db		       4c 36 f4 	      jmp	UE_Exit
   1557  f3de				   UE_Alive
   1558  f3de		       a5 ba		      lda	EnemyDeadMask
   1559  f3e0		       3d c4 f3 	      and	EnemyBitTable,X
   1560  f3e3		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1561  f3e5		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1562  f3e8		       20 f6 fe 	      jsr	FoldIndirect	; type|dir (UEDispatch masks b7)
   1563  f3eb		       4c 07 f6 	      jmp	UEDispatch	; UEDispatch replaces the old
   1564  f3ee							; 18 B per-type compare chain with one 3 B jmp:
   1565  f3ee							; frees 15 B of pre-pad headroom and gives the
   1566  f3ee							; type tables room for the raft byte.
   1567  f3ee				   UE_SnakeBody
   1568  f3ee		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1569  f3f0		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1570  f3f2		       d0 3e		      bne	UE_Next
   1571  f3f4							; live dir bit: 1 = right, 0 = left
   1572  f3f4		       bd c4 f3 	      lda	EnemyBitTable,X
   1573  f3f7		       25 c1		      and	EnemyRamD
   1574  f3f9		       d0 1d		      bne	UE_SnakeRight
   1575  f3fb				   UE_SnakeLeft
   1576  f3fb		       d6 bd		      dec	EnemyRamX,X
   1577  f3fd		       c8		      iny		; +1 = ROM spawn X
