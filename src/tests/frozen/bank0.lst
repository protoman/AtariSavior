   3597  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3598  ff3a		       8a		      txa
   3599  ff3b		       29 80		      and	#LASER_HELD
   3600  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3601  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3602  ff40		       85 c0		      sta	LaserState
   3603  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3604  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3605  ff46							; below — moved here so the cap code could
   3606  ff46							; not push .LaserReleased past bmi's ±127)
   3607  ff46				   .LaserReleased
   3608  ff46		       a9 00		      lda	#0
