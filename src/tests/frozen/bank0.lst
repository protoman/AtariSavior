    335 U00bc		       00 03	   TILE_ROWS  =	3	; number of playable color bands
    336 U00bc		       00 30	   LINES_PER_TILE =	48	; scanlines per tile row
    337 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    338 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE
    339 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × LINES_PER_TILE)
    340 U00bc
