   3929  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3930  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3931  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3932  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3933  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3934  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3935  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3936  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3937  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3938  fe9c							; ------------------------------------------------------------------------------
   3939  fe9c				   TallyWork
   3940  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3941  fe9f		       a8		      tay
   3942  fea0		       29 01		      and	#1
   3943  fea2		       f0 05		      beq	.TNoScore
   3944  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3945  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3946  fea9				   .TNoScore
   3947  fea9		       98		      tya
   3948  feaa		       29 04		      and	#4
   3949  feac		       f0 1e		      beq	.TLive
   3950  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3951  feb0		       a5 a3		      lda	Level
   3952  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3953  feb4		       d0 04		      bne	.TNotWrap
   3954  feb6		       a9 00		      lda	#0	; wrap past last level
   3955  feb8		       85 a3		      sta	Level
   3956  feba				   .TNotWrap
   3957  feba		       a9 00		      lda	#0
   3958  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3959  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3960  febe							;   pose ($FE must take the real-fall path)
   3961  febe		       20 20 fc 	      jsr	LoadLevel
   3962  fec1		       a9 78		      lda	#120	; reset timer for new level
   3963  fec3		       85 ae		      sta	BarLevel
   3964  fec5		       a9 3c		      lda	#60
   3965  fec7		       85 ad		      sta	TickCounter
   3966  fec9		       4c 30 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3967  fecc				   .TLive
   3968  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3969  fecf		       a9 00		      lda	#0
   3970  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3971  fed3				   .TWait
   3972  fed3		       ad 84 02 	      lda	INTIM
   3973  fed6		       d0 fb		      bne	.TWait
   3974  fed8		       4c 39 f0 	      jmp	StartFrame
