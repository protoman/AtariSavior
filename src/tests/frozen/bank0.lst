   2972  fceb							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   2973  fceb							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   2974  fceb		       a9 00		      lda	#0
