   4298  ffe0		       00 00 00 00*	      .ds	$FFE6 - *, 0	; pin TallyTramp (was the BeamMask slot)
   4299  ffe6							; freed 12B here — drift must not move it)
   4300  ffe6							; ------------------------------------------------------------------------------
   4301  ffe6							; TallyTramp ($FFE6, byte-identical with BANK1 now — the body moved there in
   4302  ffe6							; repack chunk 3, 2026-10-20; guard: verify_build). bank0 jsr's here
   4303  ffe6							; (CheckMinerPickup arm / TallyWork step): `sta $1FF7` selects bank1, then the
   4304  ffe6							; jmp operand is fetched from bank1's image at the same PC (FoldIndirect
   4305  ffe6							; discipline). The bank1 body tail-jmps ReturnPad ($FBF8) -> rts back to the
   4306  ffe6							; bank0 jsr. Ends $FFEB — $FFF2-$FFF9 stay fill (F6 hotspot mirrors).
   4307  ffe6							; ------------------------------------------------------------------------------
   4308  ffe6		       f4 4f	   TallyEntry =	$F44F	; bank1 TallyEntry — operand must match label
   4309  ffe6				   TallyTramp
   4310  ffe6		       8d f7 1f 	      sta	$1FF7
   4311  ffe9		       4c 4f f4 	      jmp	TallyEntry
   4312  ffec
   4313  ffec							; ------------------------------------------------------------------------------
   4314  ffec							; HotOverlapFlag — bank3 entry tramp (C7 2026-10-20: the hot walk went back
   4315  ffec							; to bank3 with the shape/extras stream it reads). Moved off $FE90 into the
   4316  ffec							; 6-byte gap after TallyTramp. bank0 executes `sta $1FF9`; the `jmp` at +3 is
   4317  ffec							; fetched from bank3's image at $FFEF (guard: check_moth_tramp).
   4318  ffec							; ------------------------------------------------------------------------------
   4319  ffec					      .ds	$FFEC - *, 0
   4320  ffec				   HotOverlapFlag
   4321  ffec		       8d f9 1f 	      sta	$1FF9	; select bank3 (record stream lives there)
   4322  ffef		       4c f8 f8 	      jmp	$F8F8	; bank3 HotOverlapBody (synced by verify_build)
   4323  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   4324  fff2
   4325  fff2							; ------------------------------------------------------------------------------
   4326  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   4327  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   4328  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   4329  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   4330  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   4331  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   4332  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   4333  fff2							;   One less push level too (no fold / no pad call inside the body).
   4334  fff2							;   Full behavior docs moved with the body.
   4335  fff2							; ------------------------------------------------------------------------------
