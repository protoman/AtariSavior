   1796  f569		       85 a7		      sta	LevelStartRoom
   1797  f56b		       a9 20		      lda	#32
   1798  f56d		       85 a8		      sta	LevelStartX
   1799  f56f		       a9 18		      lda	#24
   1800  f571		       85 a9		      sta	LevelStartY
   1801  f573		       c8		      iny
