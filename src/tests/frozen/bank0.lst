   4195  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4196  ff3a		       8a		      txa
   4197  ff3b		       29 80		      and	#LASER_HELD
   4198  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4199  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4200  ff40		       85 c0		      sta	LaserState
   4201  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4202  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4203  ff46							; below — moved here so the cap code could
   4204  ff46							; not push .LaserReleased past bmi's ±127)
   4205  ff46				   .LaserReleased
   4206  ff46		       a9 00		      lda	#0
