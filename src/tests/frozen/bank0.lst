   4630  ff4b		       d0 3a		      bne	.LaserInit
   4631  ff4d							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4632  ff4d							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4633  ff4d							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4634  ff4d							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4635  ff4d							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4636  ff4d				   .LAdvStep
   4637  ff4d		       a4 82		      ldy	PlayerDir
   4638  ff4f		       a5 83		      lda	LaserX
   4639  ff51		       18		      clc
   4640  ff52		       79 cb ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   4641  ff55				   .LAdvS
   4642  ff55		       85 92		      sta	RectCount	; candidate (not committed yet)
   4643  ff57		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4644  ff59		       90 03		      bcc	.LAdvCap
   4645  ff5b		       4c 87 ff 	      jmp	.LaserInit
   4646  ff5e				   .LAdvCap
   4647  ff5e		       a5 82		      lda	PlayerDir
   4648  ff60		       d0 0c		      bne	.LAdvCapL
   4649  ff62		       a5 80		      lda	RoomX
   4650  ff64		       18		      clc
   4651  ff65		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   4652  ff67		       c5 92		      cmp	RectCount
   4653  ff69		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   4654  ff6b		       4c 87 ff 	      jmp	.LaserInit
   4655  ff6e				   .LAdvCapL
   4656  ff6e		       a5 80		      lda	RoomX
   4657  ff70		       38		      sec
   4658  ff71		       e9 14		      sbc	#20
   4659  ff73		       b0 02		      bcs	.LAdvCapLs
   4660  ff75		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4661  ff77				   .LAdvCapLs
   4662  ff77		       c5 92		      cmp	RectCount	; cap vs cand
   4663  ff79		       f0 05		      beq	.LAdvKeep
   4664  ff7b		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   4665  ff7d		       4c 87 ff 	      jmp	.LaserInit
   4666  ff80				   .LAdvKeep
   4667  ff80		       a5 92		      lda	RectCount
   4668  ff82		       85 83		      sta	LaserX
   4669  ff84		       4c 8a ff 	      jmp	.LaserGo	; committed: skip the eye restart
   4670  ff87				   .LaserInit
   4671  ff87		       20 b1 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   4672  ff8a				   .LaserGo
   4673  ff8a		       a5 83		      lda	LaserX
   4674  ff8c		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   4675  ff8e		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   4676  ff91		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   4677  ff93		       c9 50		      cmp	#$50
   4678  ff95		       f0 0a		      beq	.LaserKill
   4679  ff97		       c9 02		      cmp	#2
   4680  ff99		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   4681  ff9b							;   same as kill minus score — restart at
   4682  ff9b							;   the eye THIS frame, buzz keeps (b7).
   4683  ff9b							;   #9's blank + the wall-center hold clamp
   4684  ff9b							;   both superseded: a contact missile is
   4685  ff9b							;   consumed by walls. No hold state, no
   4686  ff9b							;   cap reorder, no pass-through possible.
