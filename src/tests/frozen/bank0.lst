   1700  f4f2		       20 f6 fe 	      jsr	FoldIndirect
   1701  f4f5		       4a		      lsr		; up = high nibble -> low
   1702  f4f6		       4a		      lsr
   1703  f4f7		       4a		      lsr
   1704  f4f8		       4a		      lsr
   1705  f4f9		       29 0f		      and	#$0f
   1706  f4fb		       c9 0f		      cmp	#$0f
   1707  f4fd		       f0 07		      beq	.NoUp
   1708  f4ff		       20 d0 fb 	      jsr	EnterRoom
   1709  f502		       a9 84		      lda	#PLAYER_MAX_Y
   1710  f504		       85 81		      sta	RoomY	; enter at the bottom edge
   1711  f506				   .NoUp
