   1682  f4d8		       20 f6 fe 	      jsr	FoldIndirect	; +0 = up/down byte
   1683  f4db		       29 0f		      and	#$0f	; down = low nibble
   1684  f4dd		       c9 0f		      cmp	#$0f
   1685  f4df		       f0 07		      beq	.NoDown
   1686  f4e1		       20 d0 fb 	      jsr	EnterRoom
   1687  f4e4		       a9 00		      lda	#PLAYER_MIN_Y
   1688  f4e6		       85 81		      sta	RoomY	; enter at the top edge
   1689  f4e8				   .NoDown
   1690  f4e8		       60		      rts
   1691  f4e9
   1692  f4e9				   ExitRoomUp
   1693  f4e9		       20 14 fc 	      jsr	CallPad_GetConnIdx	; +0 = up/down byte
   1694  f4ec		       20 f6 fe 	      jsr	FoldIndirect
   1695  f4ef		       4a		      lsr		; up = high nibble -> low
   1696  f4f0		       4a		      lsr
   1697  f4f1		       4a		      lsr
   1698  f4f2		       4a		      lsr
   1699  f4f3		       29 0f		      and	#$0f
   1700  f4f5		       c9 0f		      cmp	#$0f
   1701  f4f7		       f0 07		      beq	.NoUp
   1702  f4f9		       20 d0 fb 	      jsr	EnterRoom
   1703  f4fc		       a9 84		      lda	#PLAYER_MAX_Y
   1704  f4fe		       85 81		      sta	RoomY	; enter at the bottom edge
   1705  f500				   .NoUp
   1706  f500		       60		      rts
   1707  f501
   1708  f501				   ExitRoomLeft
   1709  f501		       20 14 fc 	      jsr	CallPad_GetConnIdx
   1710  f504		       c8		      iny		; +1 = left/right byte
   1711  f505		       20 f6 fe 	      jsr	FoldIndirect
   1712  f508		       29 0f		      and	#$0f	; left = low nibble
   1713  f50a		       c9 0f		      cmp	#$0f
   1714  f50c		       f0 07		      beq	.NoLeft
   1715  f50e		       20 d0 fb 	      jsr	EnterRoom
   1716  f511		       a9 9f		      lda	#PLAYER_MAX_X
   1717  f513		       85 80		      sta	RoomX	; enter at the right edge
   1718  f515				   .NoLeft
   1719  f515		       60		      rts
