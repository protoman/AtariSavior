   3612  fd32							; ------------------------------------------------------------------------------
   3613  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3614  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3615  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3616  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3617  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3618  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3619  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3620  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3621  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3622  fd32							;	    the real drop-in → gameplay starts
   3623  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3624  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3625  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3626  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3627  fd32							; ------------------------------------------------------------------------------
   3628  fd32				   TitleWork
   3629  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3630  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3631  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3632  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3633  fd3a				   .TWselDone
   3634  fd3a							; --- RESET edge ---
   3635  fd3a		       a5 97		      lda	StepsLeft
   3636  fd3c		       29 01		      and	#%00000001
   3637  fd3e		       f0 14		      beq	.TWrstDone
   3638  fd40		       ad 82 02 	      lda	SWCHB
   3639  fd43		       29 01		      and	#%00000001
   3640  fd45		       d0 0d		      bne	.TWrstDone
   3641  fd47		       a9 00		      lda	#0
   3642  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3643  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3644  fd4d		       85 f4		      sta	ScoreHu
   3645  fd4f		       85 f5		      sta	ScoreTe
   3646  fd51		       20 20 fc 	      jsr	LoadLevel
   3647  fd54				   .TWrstDone
   3648  fd54		       ad 82 02 	      lda	SWCHB
   3649  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
