   3789  fe05		       f2		      .byte.b	$f2	; bat — hue 15 luma 7 = brown
   3790  fe06		       c4		      .byte.b	$c4	; snake — hue 12 luma 2 = green
   3791  fe07		       0e		      .byte.b	$0e	; tentacle — hue 0 luma 7 = white
   3792  fe08		       22		      .byte.b	$22	; moth — hue 2 luma 1 = dark orange
   3793  fe09		       0e		      .byte.b	$0e	; lamp (type 5) — white; dark rooms override to grey
   3794  fe0a		       1c		      .byte.b	$1C	; key (type 6) — yellow
