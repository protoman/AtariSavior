    314 U00bc							; Constants
    315 U00bc							; ==============================================================================
    316 U00bc		       00 08	   PLAYER_HEIGHT =	8	; GRP1 object (enemy/miner) height; player uses PLAYER_SPRITE_H
    317 U00bc		       00 0c	   PLAYER_SPRITE_H =	12	; player sprite height in scanlines (8x12)
    318 U00bc		       00 07	   PLAYER_WIDTH =	7	; lit player sprite spans 7 pixels; REFP0 shift handled
    319 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    320 U00bc		       00 04	   LAMP_WIDTH =	4	; OBJ_LAMP uses GRP1's leftmost 4 lit pixels
    321 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    322 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    323 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    324 U00bc							; placed X, so the snake retreats a tile behind
    325 U00bc							; its placement and then comes out a tile — 2
    326 U00bc							; tiles of travel total. The editor cannot ask
    327 U00bc							; the user to place it 2 tiles from the border.
    328 U00bc		       00 14	   TILE_COLUMNS =	20	; columns per half (reflected playfield)
    329 U00bc		       00 03	   TILE_ROWS  =	3	; number of playable color bands
    330 U00bc		       00 30	   LINES_PER_TILE =	48	; scanlines per tile row
    331 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    332 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE
    333 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × LINES_PER_TILE)
    334 U00bc
    335 U00bc							; GRP1 sprite design offsets into ObjSprites (8 bytes each; 0 = blank/off)
    336 U00bc		       00 00	   OBJ_NONE   =	0
    337 U00bc		       00 00	   OBJ_KEY    =	0	; type-6 KEY design = the offset-0 slot
    338 U00bc		       00 08	   OBJ_MOTH   =	8
    339 U00bc		       00 10	   OBJ_SPIDER =	16
    340 U00bc		       00 18	   OBJ_LAMP   =	24
    341 U00bc		       00 20	   OBJ_TENTACLE =	32
    342 U00bc		       00 28	   OBJ_BAT    =	40
    343 U00bc		       00 30	   OBJ_SNAKE  =	48
    344 U00bc		       00 38	   OBJ_MINER  =	56
