   2054  f592		       c6 f7		      dec	BombTimer
   2055  f594		       d0 39		      bne	.BTDone
   2056  f596		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2057  f598		       29 fc		      and	#%11111100
   2058  f59a		       85 b5		      sta	BombPacked
   2059  f59c		       a9 00		      lda	#0
   2060  f59e		       85 f7		      sta	BombTimer
   2061  f5a0		       60		      rts
   2062  f5a1				   .BTFuse
   2063  f5a1		       c6 f7		      dec	BombTimer
   2064  f5a3		       d0 2a		      bne	.BTDone
   2065  f5a5		       a5 b5		      lda	BombPacked	; 1 → 2
   2066  f5a7		       29 fc		      and	#%11111100
   2067  f5a9		       09 02		      ora	#%00000010
   2068  f5ab		       85 b5		      sta	BombPacked
   2069  f5ad		       a9 3c		      lda	#60
   2070  f5af		       85 f7		      sta	BombTimer
   2071  f5b1		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2072  f5b4		       aa		      tax
   2073  f5b5		       f0 08		      beq	.BTNoScore
   2074  f5b7				   .BTScore
   2075  f5b7		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2076  f5b9		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2077  f5bc		       ca		      dex
   2078  f5bd		       d0 f8		      bne	.BTScore
   2079  f5bf				   .BTNoScore
   2080  f5bf		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2081  f5c2		       f0 05		      beq	.BTNoKill
