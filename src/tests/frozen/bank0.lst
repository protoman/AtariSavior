   1715  f4f6		       4a		      lsr
   1716  f4f7		       4a		      lsr
   1717  f4f8		       4a		      lsr
   1718  f4f9		       29 0f		      and	#$0f
   1719  f4fb		       c9 0f		      cmp	#$0f
   1720  f4fd		       f0 07		      beq	.NoUp
