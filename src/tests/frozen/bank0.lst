    867  f118		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
    868  f11a		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
    869  f11c		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
    870  f11d							;   Color/beam gate entered only with A0<=10
    871  f11d							;   -> after iny Y<=11: always fetchable, so
    872  f11d							;   the old `cpy #PLAYER_SPRITE_H / bcs
    873  f11d							;   .GrpZero` here was DEAD 4c on the worst
    874  f11d							;   path (2+2, never taken — A0=11+ never
    875  f11d							;   reaches it, it goes to bcs .GrpSkip).
    876  f11d		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
