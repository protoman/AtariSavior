   4004  feb4		       d0 04		      bne	.TNotWrap
   4005  feb6		       a9 00		      lda	#0	; wrap past last level
   4006  feb8		       85 a3		      sta	Level
   4007  feba				   .TNotWrap
   4008  feba		       a9 00		      lda	#0
   4009  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4010  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4011  febe							;   pose ($FE must take the real-fall path)
   4012  febe		       20 20 fc 	      jsr	LoadLevel
   4013  fec1		       a9 78		      lda	#120	; reset timer for new level
   4014  fec3		       85 ae		      sta	BarLevel
   4015  fec5		       a9 3c		      lda	#60
   4016  fec7		       85 ad		      sta	TickCounter
