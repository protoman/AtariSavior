    957  f123		       a5 ea		      lda	ObjBase1	; $FF = none. `bmi` is still valid HERE (slot 1
    958  f125		       30 03		      bmi	Slot1Keep	;   only holds an enemy design or the miner,
    959  f127							;   all < $80; the bomb never reaches slot 1).
    960  f127							;   Slot 0 must use `cmp #$FF` — see .SODone.
