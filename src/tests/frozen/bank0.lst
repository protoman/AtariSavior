   1520  f425							; ------------------------------------------------------------------------------
   1521  f425							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1522  f425							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1523  f425							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1524  f425							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1525  f425							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1526  f425							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1527  f425							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1528  f425							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1529  f425							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1530  f425							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1531  f425							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1532  f425							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1533  f425							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1534  f425							; ------------------------------------------------------------------------------
   1535  f425				   UE_Tentacle
   1536  f425		       a5 ad		      lda	TickCounter
   1537  f427		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1538  f429							; = half the player's 1 px/frame (user
   1539  f429							; 2026-10-10: &3 read as chunky/slow)
   1540  f429		       d0 4b		      bne	.TentOut
   1541  f42b		       b5 bd		      lda	EnemyRamX,X
   1542  f42d		       c5 80		      cmp	RoomX
   1543  f42f		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1544  f431		       90 06		      bcc	.TentRight
   1545  f433		       38		      sec
   1546  f434		       e9 01		      sbc	#1	; step left
   1547  f436		       4c 3c f4 	      jmp	.TentProbe
   1548  f439				   .TentRight
   1549  f439		       18		      clc
   1550  f43a		       69 01		      adc	#1	; step right
   1551  f43c				   .TentProbe
   1552  f43c		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1553  f43e		       b0 36		      bcs	.TentOut
   1554  f440		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1555  f442							; Same-column cull: committed X is always probe-clear, so a candidate in
   1556  f442							; the same 4px column covers the same collision cells → result is known
   1557  f442							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1558  f442		       a5 88		      lda	Temp
   1559  f444		       55 bd		      eor	EnemyRamX,X
   1560  f446		       29 fc		      and	#$FC
   1561  f448		       f0 28		      beq	.TentCommit
   1562  f44a		       a5 80		      lda	RoomX
   1563  f44c		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1564  f44e		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1565  f450		       85 b8		      sta	ActiveObjectY
   1566  f452		       a5 88		      lda	Temp
   1567  f454		       c9 05		      cmp	#5
   1568  f456		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1569  f458							; PHM's negative visible-left wraps to 255
   1570  f458							; (col garbage / ColOff OOB walk). cand<=4
   1571  f458							; ink pokes off-screen anyway; RoomX=cand
   1572  f458							; already covers cell0.
   1573  f458		       38		      sec
   1574  f459		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1575  f45b							; sits 5/7 px left of A (moth .Mvl convention,
   1576  f45b							; bank2), but PHM's PLAYER prologue derives
   1577  f45b							; lit-left = arg-4/arg-7 with the bin on
   1578  f45b							; RoomX-PlayerDir → box missed the cell left
   1579  f45b							; of the ink at cand 8/12 (sprite drew 1 px
   1580  f45b							; into the wall — bugs.md #4). cand-1 shifts
   1581  f45b							; the tested box 1 px left: cell-exact or 1 px
   1582  f45b							; conservative for every cand/facing pair
   1583  f45b							; (tools/test_cell_map.py tentacle section).
   1584  f45b				   .TentProbeX
   1585  f45b		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1586  f45d		       b5 e2		      lda	EnemyRamY,X
   1587  f45f		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1588  f461		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1589  f463							; (rect walk ldx/dex/tax) — slot was lost here
   1590  f463		       20 26 f9 	      jsr	PlayerHitsMap
   1591  f466		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1592  f468		       a5 b8		      lda	ActiveObjectY
   1593  f46a		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1594  f46c		       a5 b7		      lda	ActiveObjectX
   1595  f46e		       85 80		      sta	RoomX	; restore player X
   1596  f470		       b0 04		      bcs	.TentOut	; wall → hold position
   1597  f472				   .TentCommit
   1598  f472		       a5 88		      lda	Temp
   1599  f474		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1600  f476				   .TentOut
   1601  f476		       4c 20 f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1602  f479
   1603  f479							; ------------------------------------------------------------------------------
   1604  f479							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1605  f479							; there is no free ZP byte for per-slot movement state (phase/direction live
   1606  f479							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1607  f479							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1608  f479							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1609  f479							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1610  f479							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1611  f479							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1612  f479							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1613  f479							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1614  f479							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1615  f479							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1616  f479							;	    the 60-frame game timer — gates from it wrap every second).
   1617  f479							; Other types: straight ROM y (their movement stages come later).
   1618  f479							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1619  f479							; ------------------------------------------------------------------------------
   1620  f479				   DeriveEnemyY
   1621  f479							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1622  f479							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1623  f479		       a5 b1		      lda	EnemyDataLo
   1624  f47b		       85 e5		      sta	FetchPtr
   1625  f47d		       a5 b2		      lda	EnemyDataHi
   1626  f47f		       85 e6		      sta	FetchPtr+1
   1627  f481		       bc b2 f9 	      ldy	EnemyOffTable,X
   1628  f484		       20 f6 fe 	      jsr	FoldIndirect	; type
   1629  f487		       c9 01		      cmp	#ENEMY_BAT
   1630  f489		       f0 18		      beq	.DEYTickNoShift
   1631  f48b		       c9 03		      cmp	#ENEMY_TENTACLE
   1632  f48d		       f0 1a		      beq	.DEYTickShift
   1633  f48f		       c9 00		      cmp	#ENEMY_SPIDER
   1634  f491		       f0 2e		      beq	.DEYSpiderTick
   1635  f493		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1636  f495		       d0 06		      bne	.DEYStatic
   1637  f497		       20 e7 fe 	      jsr	CallPad_MothYDerive
