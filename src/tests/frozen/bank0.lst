   2586  f7d0							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2587  f7d0							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF5`
   2588  f7d0							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2589  f7d0							; not from here. That is the same FoldIndirect discipline every other tramp
   2590  f7d0							; uses — the twin cannot be skipped or shortened.
   2591  f7d0							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2592  f7d0							; ------------------------------------------------------------------------------
   2593  f7d0							; M1ColFromMeta — A = the async M1 sprite column (M1X) for this room, or 0 when
   2594  f7d0							; the room carries no side-1 patch.
   2595  f7d0							; MetaA ($99, RoomPF0Lo here) = ((m1_col+1) << 4) | band_mask | b3, written
   2596  f7d0							; convert_room.meta_bytes; M1X = 8*col + 7 is that field's inverse. Deriving it
   2597  f7d0							; here (instead of staging at room load) keeps bank3's pinned code untouched,
   2598  f7d0							; and it feeds the hot-overlap box test too, which reads M1X.
   2599  f7d0							; Flags: Z is left SET when A = 0, so the caller can branch right after.
   2600  f7d0							; ------------------------------------------------------------------------------
   2601  f7d0							; ------------------------------------------------------------------------------
   2602  f7d0							; DoorLocked — a locked door (M1 patch cell, PF-open) hit by the player.
   2603  f7d0							; In: nothing new (the overlay's box scratch is live). Out: C=1 blocked, or a
   2604  f7d0							; tail jump into HotOverlapFlag when the room is HOT, where the overlap body
   2605  f7d0							; also gets to apply the hot hit.
   2606  f7d0							; Why: the locked case used to jump straight to HotOverlapFlag, and its bank3
   2607  f7d0							; body returns C=0 when the hot stream has no hit — a cold room's door was
   2608  f7d0							; therefore walk-through (user report: "door is not solid, neither with nor
   2609  f7d0							; without the key").
   2610  f7d0							; ------------------------------------------------------------------------------
   2611  f7d0				   DoorLocked
   2612  f7d0		       a5 9a		      lda	RoomPF0Hi	; staged MetaB
   2613  f7d2		       29 40		      and	#$40	; b6 = mid_band_type hot shape
   2614  f7d4		       d0 02		      bne	.DLhot
   2615  f7d6		       38		      sec		; cold room: the door is simply solid
   2616  f7d7		       60		      rts
   2617  f7d8				   .DLhot
   2618  f7d8		       4c ec ff 	      jmp	HotOverlapFlag	; hot band: overlap body owns the hit (C=1)
   2619  f7db
   2620  f7db				   M1ColFromMeta
   2621  f7db		       a5 ba		      lda	EnemyDeadMask
   2622  f7dd		       29 10		      and	#$10	; b4 = M1 strip destroyed -> transparent
   2623  f7df		       d0 1c		      bne	.M1Cgone	;   (the collision overlay honours the same
   2624  f7e1							;   bit, so the sprite now dies with it)
   2625  f7e1		       a5 99		      lda	RoomPF0Lo	; bank3 stages MetaA over this dead pointer byte
   2626  f7e3		       4a		      lsr
   2627  f7e4		       4a		      lsr
   2628  f7e5		       4a		      lsr
   2629  f7e6		       4a		      lsr		; A = m1_col+1 (0 = no side-1 strip)
   2630  f7e7		       f0 18		      beq	.M1Cnone
   2631  f7e9		       0a		      asl
   2632  f7ea		       0a		      asl
   2633  f7eb		       0a		      asl		; 8*(col+1)
   2634  f7ec		       38		      sec
   2635  f7ed		       e9 01		      sbc	#1	; 8*col+7 = the LEFT-half M1 column
   2636  f7ef		       48		      pha
   2637  f7f0		       a5 99		      lda	RoomPF0Lo
   2638  f7f2		       29 01		      and	#$01	; MetaA b0 = strip on the RIGHT half
   2639  f7f4		       f0 05		      beq	.M1Cleft
   2640  f7f6		       68		      pla
   2641  f7f7		       18		      clc
   2642  f7f8		       69 50		      adc	#80	; right half: 87 + 8*col
   2643  f7fa		       60		      rts		; Z clear
   2644  f7fb				   .M1Cleft
   2645  f7fb		       68		      pla
   2646  f7fc		       60		      rts		; A = 7 + 8*col, Z clear
   2647  f7fd				   .M1Cgone
   2648  f7fd		       a9 00		      lda	#0
   2649  f7ff		       85 b0		      sta	M1X	; strip destroyed: keep the byte honest too
   2650  f801				   .M1Cnone
   2651  f801		       60		      rts		; A = 0, Z set -> caller skips the sprite
