   1160  f230							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1161  f230							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1162  f230							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1163  f230							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1164  f230							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1165  f230							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1166  f230							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1167  f230							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1168  f230							;	   1.0s hover was too long — halved); then the flag clears and
   1169  f230							;	   normal gravity resumes (fall ~0.85s after release). State
   1170  f230							;	   lives in JetPower, NOT
   1171  f230							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1172  f230							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1173  f230							;	   rising frame — both clobbered a StepsLeft-based float.
   1174  f230							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1175  f230							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1176  f230							;	   (headroom stays $FC67).
   1177  f230							; ------------------------------------------------------------------------------
   1178  f230		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1179  f232		       24 88		      bit	Temp
   1180  f234		       d0 21		      bne	.JetDecay
   1181  f236		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1182  f238		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1183  f23a		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1184  f23c		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1185  f23e				   .RampStart
   1186  f23e		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1187  f240		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1188  f242		       d0 3f		      bne	.Gravity
   1189  f244		       a5 96		      lda	JetPower
   1190  f246		       c9 14		      cmp	#JET_MAX
   1191  f248		       b0 06		      bcs	.JetCapped
   1192  f24a		       18		      clc
   1193  f24b		       69 01		      adc	#1
   1194  f24d		       4c 52 f2 	      jmp	.JetSet
   1195  f250				   .JetCapped
   1196  f250		       a9 14		      lda	#JET_MAX
