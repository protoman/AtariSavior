   3918  fd07		       a5 8a		      lda	DropTarget
   3919  fd09		       f0 28		      beq	.DSdone	; idle (target 0 = nothing to fall)
   3920  fd0b		       c9 ff		      cmp	#$FF
   3921  fd0d		       f0 27		      beq	TitleWork	; merged title = stage preview + level select
   3922  fd0f		       c9 fe		      cmp	#$FE
   3923  fd11		       d0 03		      bne	.DSfall
   3924  fd13		       4c 9c fe 	      jmp	TallyWork	; level-bonus tally sentinel (bank2 step)
   3925  fd16				   .DSfall
   3926  fd16		       4a		      lsr
   3927  fd17		       4a		      lsr
   3928  fd18		       4a		      lsr
   3929  fd19		       4a		      lsr
   3930  fd1a		       a8		      tay
