   3900  ffe6							; TallyTramp ($FFE6, byte-identical with bank2 — guard: check_moth_tramp).
   3901  ffe6							; bank0 jsr's here (CheckMinerPickup arm / TallyWork step): `sta $1FF8`
   3902  ffe6							; selects bank2, then the jmp operand is fetched from bank2's image at the
   3903  ffe6							; same PC (FoldIndirect discipline). The bank2 body tail-jmps ReturnPad
   3904  ffe6							; ($FBF8) -> rts back to the bank0 jsr. Ends $FFEB — $FFF2-$FFF9 stay fill
   3905  ffe6							; (F6 hotspot mirrors).
   3906  ffe6							; ------------------------------------------------------------------------------
   3907  ffe6		       f3 13	   TallyEntry =	$F313	; bank2 TallyEntry — operand must match label
   3908  ffe6				   TallyTramp
   3909  ffe6		       8d f8 1f 	      sta	$1FF8
   3910  ffe9		       4c 13 f3 	      jmp	TallyEntry
   3911  ffec
   3912  ffec							; ------------------------------------------------------------------------------
   3913  ffec							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   3914  ffec							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   3915  ffec							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   3916  ffec							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   3917  ffec							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   3918  ffec							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   3919  ffec							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   3920  ffec							;   One less push level too (no fold / no pad call inside the body).
   3921  ffec							;   Full behavior docs moved with the body.
   3922  ffec							; ------------------------------------------------------------------------------
   3923  ffec
   3924  ffec							; ==============================================================================
   3925  ffec							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   3926  ffec							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   3927  ffec							; ==============================================================================
   3928  ffec							; ==============================================================================
   3929  ffec		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   3930  fffa
   3931  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   3932  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   3933  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
