   2584  f7d3							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2585  f7d3							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF5`
   2586  f7d3							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2587  f7d3							; not from here. That is the same FoldIndirect discipline every other tramp
   2588  f7d3							; uses — the twin cannot be skipped or shortened.
   2589  f7d3							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2590  f7d3							; ------------------------------------------------------------------------------
   2591  f7d3							; M1ColFromMeta — A = the async M1 sprite column (M1X) for this room, or 0 when
   2592  f7d3							; the room carries no side-1 patch.
   2593  f7d3							; MetaA ($99, RoomPF0Lo here) = ((m1_col+1) << 4) | band_mask | b3, written
   2594  f7d3							; convert_room.meta_bytes; M1X = 8*col + 7 is that field's inverse. Deriving it
   2595  f7d3							; here (instead of staging at room load) keeps bank3's pinned code untouched,
   2596  f7d3							; and it feeds the hot-overlap box test too, which reads M1X.
   2597  f7d3							; Flags: Z is left SET when A = 0, so the caller can branch right after.
   2598  f7d3							; ------------------------------------------------------------------------------
   2599  f7d3							; ------------------------------------------------------------------------------
   2600  f7d3							; DoorLocked — a locked door (M1 patch cell, PF-open) hit by the player.
   2601  f7d3							; In: nothing new (the overlay's box scratch is live). Out: C=1 blocked, or a
   2602  f7d3							; tail jump into HotOverlapFlag when the room is HOT, where the overlap body
   2603  f7d3							; also gets to apply the hot hit.
   2604  f7d3							; Why: the locked case used to jump straight to HotOverlapFlag, and its bank3
   2605  f7d3							; body returns C=0 when the hot stream has no hit — a cold room's door was
   2606  f7d3							; therefore walk-through (user report: "door is not solid, neither with nor
   2607  f7d3							; without the key").
   2608  f7d3							; ------------------------------------------------------------------------------
   2609  f7d3				   DoorLocked
   2610  f7d3		       a5 9a		      lda	RoomPF0Hi	; staged MetaB
   2611  f7d5		       29 40		      and	#$40	; b6 = mid_band_type hot shape
   2612  f7d7		       d0 02		      bne	.DLhot
   2613  f7d9		       38		      sec		; cold room: the door is simply solid
   2614  f7da		       60		      rts
   2615  f7db				   .DLhot
   2616  f7db		       4c ec ff 	      jmp	HotOverlapFlag	; hot band: overlap body owns the hit (C=1)
   2617  f7de
   2618  f7de				   M1ColFromMeta
   2619  f7de		       a5 ba		      lda	EnemyDeadMask
   2620  f7e0		       29 10		      and	#$10	; b4 = M1 strip destroyed -> transparent
   2621  f7e2		       d0 1c		      bne	.M1Cgone	;   (the collision overlay honours the same
   2622  f7e4							;   bit, so the sprite now dies with it)
   2623  f7e4		       a5 99		      lda	RoomPF0Lo	; bank3 stages MetaA over this dead pointer byte
   2624  f7e6		       4a		      lsr
   2625  f7e7		       4a		      lsr
   2626  f7e8		       4a		      lsr
   2627  f7e9		       4a		      lsr		; A = m1_col+1 (0 = no side-1 strip)
   2628  f7ea		       f0 18		      beq	.M1Cnone
   2629  f7ec		       0a		      asl
   2630  f7ed		       0a		      asl
   2631  f7ee		       0a		      asl		; 8*(col+1)
   2632  f7ef		       38		      sec
   2633  f7f0		       e9 01		      sbc	#1	; 8*col+7 = the LEFT-half M1 column
   2634  f7f2		       48		      pha
   2635  f7f3		       a5 99		      lda	RoomPF0Lo
   2636  f7f5		       29 01		      and	#$01	; MetaA b0 = strip on the RIGHT half
   2637  f7f7		       f0 05		      beq	.M1Cleft
   2638  f7f9		       68		      pla
   2639  f7fa		       18		      clc
   2640  f7fb		       69 50		      adc	#80	; right half: 87 + 8*col
   2641  f7fd		       60		      rts		; Z clear
   2642  f7fe				   .M1Cleft
   2643  f7fe		       68		      pla
   2644  f7ff		       60		      rts		; A = 7 + 8*col, Z clear
   2645  f800				   .M1Cgone
   2646  f800		       a9 00		      lda	#0
   2647  f802		       85 b0		      sta	M1X	; strip destroyed: keep the byte honest too
   2648  f804				   .M1Cnone
   2649  f804		       60		      rts		; A = 0, Z set -> caller skips the sprite
   2650  f805
