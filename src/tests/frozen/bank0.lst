   4472  fea2		       f0 05		      beq	.TNoScore
   4473  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4474  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4475  fea9				   .TNoScore
