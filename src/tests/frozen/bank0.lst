   1731  f4db		       a5 a4		      lda	LevelMinerRoom
   1732  f4dd		       29 7f		      and	#$7f
   1733  f4df		       c5 98		      cmp	RoomNo
   1734  f4e1		       d0 1b		      bne	.CMPDone	; not in miner's room
   1735  f4e3							; X overlap: player [RoomX, +6] vs 4px miner.
   1736  f4e3							; Accept iff RoomX - MinerX in [-6, +3].
   1737  f4e3		       a5 80		      lda	RoomX
   1738  f4e5		       38		      sec
   1739  f4e6		       e5 a5		      sbc	MinerX
   1740  f4e8		       18		      clc
   1741  f4e9		       69 06		      adc	#PLAYER_WIDTH - 1
   1742  f4eb		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1743  f4ed		       b0 0f		      bcs	.CMPDone	; no X overlap
   1744  f4ef							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1745  f4ef							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1746  f4ef		       a5 81		      lda	RoomY
   1747  f4f1		       38		      sec
   1748  f4f2		       e5 a6		      sbc	MinerY
   1749  f4f4		       18		      clc
   1750  f4f5		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1751  f4f7		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1752  f4f9		       b0 03		      bcs	.CMPDone	; no Y overlap
