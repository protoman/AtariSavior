   3088  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3089  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3090  fcc7							; caller; Y is animated from the screen top down to it).
   3091  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3092  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3093  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3094  fcc7							;
   3095  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3096  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3097  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3098  fcc7							;
   3099  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3100  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3101  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3102  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3103  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3104  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3105  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3106  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3107  fcc7							; ------------------------------------------------------------------------------
   3108  fcc7				   DropArm
   3109  fcc7		       a5 8a		      lda	DropTarget
   3110  fcc9		       c9 fd		      cmp	#$FD
   3111  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FD intro / $FF old title → static
   3112  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3113  fccd							;   tally cleared to 0 by TallyWork before its
   3114  fccd							;   LoadLevel — same-size swap 2026-10-06)
   3115  fccd		       a5 81		      lda	RoomY
   3116  fccf		       85 8a		      sta	DropTarget
   3117  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3118  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3119  fcd5		       a9 00		      lda	#0
   3120  fcd7		       85 81		      sta	RoomY
   3121  fcd9		       85 95		      sta	PlayerYSub
   3122  fcdb		       85 93		      sta	vyLo
   3123  fcdd		       85 94		      sta	vyHi
   3124  fcdf		       a5 c0		      lda	LaserState
   3125  fce1		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3126  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3127  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3128  fce7		       85 83		      sta	LaserX
   3129  fce9		       18		      clc
   3130  fcea		       60		      rts
