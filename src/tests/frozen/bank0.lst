   2187  f60b							; ------------------------------------------------------------------------------
   2188  f60b							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2189  f60b							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2190  f60b							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2191  f60b							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2192  f60b							; ------------------------------------------------------------------------------
   2193  f60b				   UEDispatch
   2194  f60b		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2195  f60d							;   the single type-compare entry. 2026-10-22:
   2196  f60d							;   a raft authored dir=right read $87, missed
   2197  f60d							;   `cmp #ENEMY_RAFT` and its body never ran
   2198  f60d							;   (no tide, no motion, no rider pin).
   2199  f60d		       c9 07		      cmp	#ENEMY_RAFT
   2200  f60f		       d0 06		      bne	.UEDNotRaft
   2201  f611		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2202  f614		       4c 3a f4 	      jmp	UE_Next
   2203  f617				   .UEDNotRaft
   2204  f617		       c9 03		      cmp	#ENEMY_TENTACLE
   2205  f619		       d0 03		      bne	.UEDNotTent
   2206  f61b		       4c 41 f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2207  f61e				   .UEDNotTent
   2208  f61e		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2209  f620		       d0 03		      bne	.UEDNotMoth
   2210  f622		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2211  f625				   .UEDNotMoth
   2212  f625		       c9 02		      cmp	#ENEMY_SNAKE
   2213  f627		       d0 03		      bne	.UEDNotSnake
   2214  f629		       4c f6 f3 	      jmp	UE_SnakeBody
   2215  f62c				   .UEDNotSnake
   2216  f62c		       4c 3a f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2217  f62f							; (absolute jmps: this block is far from the
   2218  f62f							;  bodies — relative branches do not reach)
