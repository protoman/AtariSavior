   1376  f27d							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1377  f27d							; The high byte alone is NOT enough (2026-10-22): `cmp #>MAX_FALL` with vyHi
   1378  f27d							; == $01 is EQUAL, so the old code rewrote vy to exactly $0180 for every speed
   1379  f27d							; in $0100..$017F — a falling player's thrust was computed and then thrown
   1380  f27d							; away every frame (vy: $0180 -> $0188 -> $0158 -> clamped back to $0180), so
   1381  f27d							; the jet could not slow a fall at all. Compare the low byte when the high
   1382  f27d							; bytes match.
   1383  f27d		       a5 94		      lda	vyHi
   1384  f27f		       30 17		      bmi	.RiseClamp
   1385  f281		       c9 01		      cmp	#>MAX_FALL
   1386  f283		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1387  f285		       d0 06		      bne	.FallClamp	; above: clamp
   1388  f287		       a5 93		      lda	vyLo
   1389  f289		       c9 80		      cmp	#<MAX_FALL
   1390  f28b		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1391  f28d				   .FallClamp
   1392  f28d		       a9 01		      lda	#>MAX_FALL
   1393  f28f		       85 94		      sta	vyHi
   1394  f291		       a9 80		      lda	#<MAX_FALL
   1395  f293		       85 93		      sta	vyLo
   1396  f295		       4c a4 f2 	      jmp	.Integrate
   1397  f298				   .RiseClamp
   1398  f298		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1399  f29a		       b0 08		      bcs	.Integrate
