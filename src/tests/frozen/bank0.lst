   1759  f535							; ==============================================================================
   1760  f535							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1761  f535							; LevelDataTable stride: 7 bytes (C4 2026-10-20: the Connections / RoomEnemies
   1762  f535							; word pointers were redundant — both are fixed offsets inside the level block,
   1763  f535							; see the layout comment in generated/levels_index.asm. start_x/y dropped
   1764  f535							; 2026-10-19 (constants 32/24); start_room and miner_y dropped 2026-10-20
   1765  f535							; (constants 0 / 84) — the converter rejects any other value)
   1766  f535							;   +0: miner_room (b7 = faces right)
   1767  f535							;   +1: miner_x
   1768  f535							;   +2..+3: wall colors
   1769  f535							;   +4..+5: level block base (RoomDataTable)
   1770  f535							;   +6: room count n — readers derive Connections (+2n), RoomEnemies (+4n)
   1771  f535							;	 and the enemy records (+5n — 1 B/room since 2026-10-20) from it (C2/C3)
   1772  f535							; ------------------------------------------------------------------------------
