   2221  f630							; ==============================================================================
   2222  f630							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2223  f630							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2224  f630							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2225  f630							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2226  f630							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2227  f630							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2228  f630							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2229  f630							; ==============================================================================
   2230  f630				   SelectActiveObject
   2231  f630							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2232  f630							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2233  f630							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2234  f630							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2235  f630							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2236  f630							; middle of the screen" the moment the points counting started).
   2237  f630		       a5 8a		      lda	DropTarget
   2238  f632		       c9 fe		      cmp	#$FE
   2239  f634		       d0 2d		      bne	.SOFull
   2240  f636		       a9 00		      lda	#0
   2241  f638		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2242  f63a		       a9 ff		      lda	#$FF
   2243  f63c		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2244  f63e							;   `0 = no object` comment was wrong and the
   2245  f63e							;   tally-without-miner frame staged ObjTop from
   2246  f63e							;   a stale Y, i.e. a stray key sprite)
   2247  f63e		       a5 a4		      lda	LevelMinerRoom
   2248  f640		       29 7f		      and	#$7f
   2249  f642		       c5 98		      cmp	RoomNo
   2250  f644		       f0 03		      beq	.SOTallyMiner
   2251  f646		       4c 41 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2252  f649				   .SOTallyMiner
   2253  f649		       a9 55		      lda	#OBJ_MINER
   2254  f64b		       85 b6		      sta	ObjBase
   2255  f64d		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
