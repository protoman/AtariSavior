   4087  ff5e		       d0 3a		      bne	.LaserInit
   4088  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4089  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4090  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4091  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4092  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4093  ff60				   .LAdvStep
   4094  ff60		       a4 82		      ldy	PlayerDir
   4095  ff62		       a5 83		      lda	LaserX
   4096  ff64		       18		      clc
   4097  ff65		       79 de ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   4098  ff68				   .LAdvS
   4099  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   4100  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4101  ff6c		       90 03		      bcc	.LAdvCap
   4102  ff6e		       4c 9a ff 	      jmp	.LaserInit
   4103  ff71				   .LAdvCap
   4104  ff71		       a5 82		      lda	PlayerDir
   4105  ff73		       d0 0c		      bne	.LAdvCapL
   4106  ff75		       a5 80		      lda	RoomX
   4107  ff77		       18		      clc
