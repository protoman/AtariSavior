   3613  fd32							; ------------------------------------------------------------------------------
   3614  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3615  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3616  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3617  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3618  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3619  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3620  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3621  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3622  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3623  fd32							;	    the real drop-in → gameplay starts
   3624  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3625  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3626  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3627  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3628  fd32							; ------------------------------------------------------------------------------
   3629  fd32				   TitleWork
   3630  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3631  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3632  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3633  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3634  fd3a				   .TWselDone
   3635  fd3a							; --- RESET edge ---
   3636  fd3a		       a5 97		      lda	StepsLeft
   3637  fd3c		       29 01		      and	#%00000001
   3638  fd3e		       f0 14		      beq	.TWrstDone
   3639  fd40		       ad 82 02 	      lda	SWCHB
   3640  fd43		       29 01		      and	#%00000001
   3641  fd45		       d0 0d		      bne	.TWrstDone
   3642  fd47		       a9 00		      lda	#0
   3643  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3644  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3645  fd4d		       85 f4		      sta	ScoreHu
   3646  fd4f		       85 f5		      sta	ScoreTe
   3647  fd51		       20 20 fc 	      jsr	LoadLevel
   3648  fd54				   .TWrstDone
   3649  fd54		       ad 82 02 	      lda	SWCHB
   3650  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3651  fd59							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3652  fd59							;     channel force-muted here — UpdateJetSound is skipped because
   3653  fd59							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3654  fd59							;     = 0, AUDV0 covered above). ---
   3655  fd59				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3656  fd59		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3657  fd5b		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3658  fd5d		       f0 0e		      beq	.TWmusic
   3659  fd5f		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3660  fd61		       20 98 f5 	      jsr	BombTick
   3661  fd64				   .TWnoTick
   3662  fd64		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3663  fd67		       a9 00		      lda	#0
   3664  fd69		       85 1a		      sta	AUDV1
   3665  fd6b		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3666  fd6d				   .TWmusic		; title: music wins the audio regs
   3667  fd6d		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3668  fd70				   .TWwait
   3669  fd70		       ad 84 02 	      lda	INTIM
   3670  fd73		       d0 fb		      bne	.TWwait
   3671  fd75		       4c 39 f0 	      jmp	StartFrame
