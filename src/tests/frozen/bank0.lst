   3549  fd32							; ------------------------------------------------------------------------------
   3550  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3551  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3552  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3553  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3554  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3555  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3556  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3557  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3558  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3559  fd32							;	    the real drop-in → gameplay starts
   3560  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3561  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3562  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3563  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3564  fd32							; ------------------------------------------------------------------------------
   3565  fd32				   TitleWork
   3566  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3567  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3568  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3569  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3570  fd3a				   .TWselDone
   3571  fd3a							; --- RESET edge ---
   3572  fd3a		       a5 97		      lda	StepsLeft
   3573  fd3c		       29 01		      and	#%00000001
   3574  fd3e		       f0 14		      beq	.TWrstDone
   3575  fd40		       ad 82 02 	      lda	SWCHB
   3576  fd43		       29 01		      and	#%00000001
   3577  fd45		       d0 0d		      bne	.TWrstDone
   3578  fd47		       a9 00		      lda	#0
   3579  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3580  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3581  fd4d		       85 f4		      sta	ScoreHu
   3582  fd4f		       85 f5		      sta	ScoreTe
   3583  fd51		       20 20 fc 	      jsr	LoadLevel
   3584  fd54				   .TWrstDone
   3585  fd54		       ad 82 02 	      lda	SWCHB
   3586  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
