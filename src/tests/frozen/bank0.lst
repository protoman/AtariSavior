   2063  f58e							; BombTick — per-frame state machine (overscan).
   2064  f58e							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2065  f58e							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2066  f58e							; ------------------------------------------------------------------------------
   2067  f58e				   BombTick   subroutine
   2068  f58e		       a5 b5		      lda	BombPacked
