   3115  fd37							; ------------------------------------------------------------------------------
   3116  fd37							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3117  fd37							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3118  fd37							; selected level number (digits band) and the credits; the theme plays here.
   3119  fd37							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3120  fd37							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3121  fd37							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3122  fd37							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3123  fd37							;	    the intro exit ate the first press and made #2 read as dead)
   3124  fd37							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3125  fd37							;	    the real drop-in → gameplay starts
   3126  fd37							; ($FD reaches here directly — merged title, 2026-10-19.)
   3127  fd37							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3128  fd37							; title-owned; the first play frame rewrites it as the step budget).
   3129  fd37							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3130  fd37							; ------------------------------------------------------------------------------
   3131  fd37				   TitleWork
   3132  fd37							; --- SELECT edge (TitleSelect, fill region) ---
   3133  fd37		       20 4f fc 	      jsr	CallPad_TitleSelect
   3134  fd3a		       90 03		      bcc	.TWselDone	; C=0: no edge
   3135  fd3c		       20 35 f5 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3136  fd3f				   .TWselDone
   3137  fd3f							; --- RESET edge ---
   3138  fd3f		       a5 97		      lda	StepsLeft
   3139  fd41		       29 01		      and	#%00000001
   3140  fd43		       f0 14		      beq	.TWrstDone
   3141  fd45		       ad 82 02 	      lda	SWCHB
   3142  fd48		       29 01		      and	#%00000001
   3143  fd4a		       d0 0d		      bne	.TWrstDone
   3144  fd4c		       a9 00		      lda	#0
   3145  fd4e		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3146  fd50		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3147  fd52		       85 f4		      sta	ScoreHu
   3148  fd54		       85 f5		      sta	ScoreTe
   3149  fd56		       20 35 f5 	      jsr	LoadLevel
   3150  fd59				   .TWrstDone
   3151  fd59		       ad 82 02 	      lda	SWCHB
   3152  fd5c		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3153  fd5e							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3154  fd5e							;     channel force-muted here — UpdateJetSound is skipped because
   3155  fd5e							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3156  fd5e							;     = 0, AUDV0 covered above). ---
   3157  fd5e				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3158  fd5e		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3159  fd60		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3160  fd62		       f0 0e		      beq	.TWmusic
   3161  fd64		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3162  fd66		       20 4f f6 	      jsr	BombTick
