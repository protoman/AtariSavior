   2530  f951		       a8		      tay		; Y = visible_left
   2531  f952		       4a		      lsr
   2532  f953		       4a		      lsr
   2533  f954		       c9 14		      cmp	#TILE_COLUMNS
   2534  f956		       90 07		      bcc	.firstOk
