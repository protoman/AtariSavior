   1716  f43c		       a5 ad		      lda	TickCounter
   1717  f43e		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1718  f440							; = half the player's 1 px/frame (user
   1719  f440							; 2026-10-10: &3 read as chunky/slow)
   1720  f440		       d0 4b		      bne	.TentOut
   1721  f442		       b5 bd		      lda	EnemyRamX,X
   1722  f444		       c5 80		      cmp	RoomX
   1723  f446		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1724  f448		       90 06		      bcc	.TentRight
   1725  f44a		       38		      sec
   1726  f44b		       e9 01		      sbc	#1	; step left
   1727  f44d		       4c 53 f4 	      jmp	.TentProbe
   1728  f450				   .TentRight
   1729  f450		       18		      clc
   1730  f451		       69 01		      adc	#1	; step right
   1731  f453				   .TentProbe
   1732  f453		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1733  f455		       b0 36		      bcs	.TentOut
   1734  f457		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1735  f459							; Same-column cull: committed X is always probe-clear, so a candidate in
   1736  f459							; the same 4px column covers the same collision cells → result is known
   1737  f459							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1738  f459		       a5 88		      lda	Temp
   1739  f45b		       55 bd		      eor	EnemyRamX,X
   1740  f45d		       29 fc		      and	#$FC
   1741  f45f		       f0 28		      beq	.TentCommit
   1742  f461		       a5 80		      lda	RoomX
