   4165  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4166  ff3a		       8a		      txa
   4167  ff3b		       29 80		      and	#LASER_HELD
   4168  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4169  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4170  ff40		       85 c0		      sta	LaserState
   4171  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4172  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4173  ff46							; below — moved here so the cap code could
   4174  ff46							; not push .LaserReleased past bmi's ±127)
   4175  ff46				   .LaserReleased
   4176  ff46		       a9 00		      lda	#0
   4177  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4178  ff4a							; otherwise -> bars slid across screen
   4179  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   4180  ff4b				   .LaserFire
   4181  ff4b		       a5 c0		      lda	LaserState
   4182  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4183  ff4f		       85 c0		      sta	LaserState
   4184  ff51		       8a		      txa
   4185  ff52		       29 80		      and	#LASER_HELD
   4186  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4187  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4188  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4189  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   4190  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4191  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   4192  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4193  ff56		       a5 c0		      lda	LaserState
