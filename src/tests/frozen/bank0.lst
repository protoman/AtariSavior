   1354  f25f							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1355  f25f							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1356  f25f							;     only — subtracting $80+ would blast the player upward.
   1357  f25f				   .Gravity
   1358  f25f		       18		      clc
   1359  f260		       a5 93		      lda	vyLo
   1360  f262		       69 08		      adc	#<GRAVITY
   1361  f264		       85 93		      sta	vyLo
   1362  f266		       a5 94		      lda	vyHi
   1363  f268		       69 00		      adc	#>GRAVITY
   1364  f26a		       85 94		      sta	vyHi
   1365  f26c		       a5 96		      lda	JetPower
   1366  f26e		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1367  f270		       38		      sec
   1368  f271		       a5 93		      lda	vyLo
   1369  f273		       e5 96		      sbc	JetPower
   1370  f275		       85 93		      sta	vyLo
