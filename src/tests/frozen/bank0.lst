   3800  fca5							; life. Strip = bottom ~12 lines of the cave (bottom_band_plan rule 2);
   3801  fca5							; sprite origin RoomY >= 115 enters it (115 + 21 = 136 = the same feet
   3802  fca5							; depth the 12-row sprite had at 125).
   3803  fca5							; Same path as hot/enemy: lose life, then respawn 12 scanlines up (min 0).
   3804  fca5							; Band color = VBLANK-staged RoomBandColor ($D2, PF1Buf[3] dead-row alias;
   3805  fca5							; staged by the VBLANK fold from LevelEnemy+RoomNo*4+3 — a kernel-time fold
   3806  fca5							; overruns the .WaterRow line). Read inlined here and in .WaterRow (0 = off).
   3807  fca5							; ------------------------------------------------------------------------------
   3808  fca5				   CheckBandTouch
   3809  fca5		       a5 bc		      lda	RoomBandColor
   3810  fca7		       f0 09		      beq	.CBTdone	; band off
   3811  fca9		       a5 81		      lda	RoomY
   3812  fcab		       c9 73		      cmp	#115	; feet (RoomY+21) reach 136 in the strip
   3813  fcad		       90 03		      bcc	.CBTdone	; above strip
   3814  fcaf		       20 b3 fc 	      jsr	LoseLifeBand
   3815  fcb2				   .CBTdone
   3816  fcb2		       60		      rts
