   1820  f58f		       85 aa		      sta	LevelWallColor
   1821  f591		       c8		      iny
   1822  f592		       20 f6 fe 	      jsr	FoldIndirect
   1823  f595		       85 ab		      sta	LevelWallColor2
   1824  f597		       c8		      iny
