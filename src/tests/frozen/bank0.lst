   2122  f62b							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2123  f62b							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2124  f62b							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2125  f62b							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2126  f62b							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2127  f62b							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2128  f62b							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2129  f62b							; ==============================================================================
   2130  f62b				   SelectActiveObject
   2131  f62b							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2132  f62b							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2133  f62b							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2134  f62b							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2135  f62b							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2136  f62b							; middle of the screen" the moment the points counting started).
   2137  f62b		       a5 8a		      lda	DropTarget
   2138  f62d		       c9 fe		      cmp	#$FE
   2139  f62f		       d0 27		      bne	.SOFull
