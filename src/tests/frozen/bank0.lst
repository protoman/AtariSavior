    433 U00bc							; ==============================================================================
    434 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    435 U00bc							; ==============================================================================
    436 U00bc							; Bank3 is the power-up bank. Its stub does:
    437 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    438 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    439 U00bc							; ==============================================================================
    440  10000 ????				       seg	code
    441  f000					      org	$F000
    442  f000
    443  f000							; --- 5-byte bankswitching pad ---
    444  f000							; After bank3's stub selects us, CPU arrives here.
    445  f000							; We jump over the pad into the real init code.
    446  f000		       a9 00		      lda	#0
    447  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    448  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    449  f008							; (NOT deletable: $F008 = GameStart is a
    450  f008							;  hardcoded cross-bank entry — bank1
    451  f008							;  stub `jmp $F008`; this jmp also keeps
    452  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    453  f008							;  fold-pad byte guard fires when it moves)
    454  f008							;  + F0xx landmarks fixed)
    455  f008
    456  f008				   GameStart
    457  f008		       78		      sei		; disable interrupts
    458  f009		       d8		      cld		; clear decimal mode
    459  f00a		       a2 ff		      ldx	#$FF
    460  f00c		       9a		      txs		; stack pointer = $FF
    461  f00d
    462  f00d							; --- Clear zero-page RAM ---
    463  f00d		       a9 00		      lda	#0
    464  f00f		       a2 80		      ldx	#$80
    465  f011				   .ClearZP
    466  f011		       95 00		      sta	$00,X
    467  f013		       e8		      inx
    468  f014		       d0 fb		      bne	.ClearZP
    469  f016
    470  f016							; --- Initialize game state ---
    471  f016		       a9 00		      lda	#0
    472  f018		       85 a3		      sta	Level
    473  f01a		       a9 03		      lda	#3
    474  f01c		       85 ac		      sta	PlayerLives
    475  f01e		       a9 05		      lda	#BOMBS_MAX
    476  f020		       85 f0		      sta	PlayerBombs
    477  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    478  f022		       a9 3c		      lda	#60
    479  f024		       85 ad		      sta	TickCounter
    480  f026		       a9 78		      lda	#120
    481  f028		       85 ae		      sta	BarLevel	; bar starts full
    482  f02a							; --- Intro screen: DropTarget=$FD sentinel (2026-10-06 — SAVIOR splash
    483  f02a							;     shows ONCE at power-on; first SELECT/RESET edge anywhere moves to
    484  f02a							;     the old title $FF = first room + HUD stage count; valid fall
    485  f02a							;     targets are Y ≤ 191, sentinels $FD/$FE/$FF all "not a fall"). ---
    486  f02a		       a9 fd		      lda	#$FD
    487  f02c		       85 8a		      sta	DropTarget
    488  f02e
    489  f02e							; --- Load first level ---
    490  f02e		       20 68 f5 	      jsr	LoadLevel
    491  f031		       a9 14		      lda	#20
    492  f033		       85 80		      sta	RoomX	; title flight starts on left side
    493  f035		       a9 00		      lda	#0
    494  f037		       85 81		      sta	RoomY	; offset in title's fixed flight window
    495  f039
    496  f039							; --- Set player color ---
    497  f039		       a9 48		      lda	#COLOR_PLAYER
    498  f03b		       85 06		      sta	COLUP0
    499  f03d
    500  f03d							; --- Set playfield to reflected mode + priority ---
    501  f03d							; D0=1 = reflect (left half mirrors to right)
    502  f03d							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    503  f03d							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    504  f03d							; disabled at kernel entry, size only matters once Phase 3 enables it)
    505  f03d		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    506  f03f		       85 0a		      sta	CTRLPF
    507  f041
    508  f041							; ==============================================================================
    509  f041							; Frame loop
    510  f041							; ==============================================================================
    511  f041				   StartFrame
    512  f041
    513  f041							; ------------------------------------------------------------------------------
    514  f041							; VSYNC (3 scanlines)
    515  f041							; ------------------------------------------------------------------------------
    516  f041							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    517  f041							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    518  f041							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    519  f041							; does not advance the wall clock to the next scanline boundary (it is already
    520  f041							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    521  f041							; fraction depends on where the previous frame's overscan happened to end) —
    522  f041							; the whole screen shifted up 1 scanline on those frames = the jitter.
    523  f041							;
    524  f041							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    525  f041							; the next scanline boundary (even if we were already at it — the store is 3c
    526  f041							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    527  f041							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    528  f041							; the sim wall-model target is updated to match.
    529  f041		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    530  f043		       a9 02		      lda	#2
    531  f045		       85 00		      sta	VSYNC
    532  f047		       85 02		      sta	WSYNC
    533  f049		       85 02		      sta	WSYNC
    534  f04b		       85 02		      sta	WSYNC
    535  f04d		       a9 00		      lda	#0
    536  f04f		       85 00		      sta	VSYNC
    537  f051
    538  f051							; ------------------------------------------------------------------------------
    539  f051							; VBLANK (37 scanlines)
    540  f051							; ------------------------------------------------------------------------------
    541  f051		       a9 02		      lda	#2
    542  f053		       85 01		      sta	VBLANK	; turn on VBLANK
    543  f055
    544  f055							; --- Set TIM64T for VBLANK ---
    545  f055							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    546  f055							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    547  f055							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    548  f055							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    549  f055				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    550  f055		       a9 17		      lda	#23
    551  f057		       8d 96 02 	      sta	TIM64T
    552  f05a
    553  f05a							; --- Position player sprite horizontally ---
    554  f05a		       a5 80		      lda	RoomX
    555  f05c		       38		      sec
    556  f05d		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    557  f05f		       a2 00		      ldx	#0	; X=0 = player0
    558  f061		       20 0f ff 	      jsr	SetObjectXPos
    559  f064
    560  f064							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    561  f064							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    562  f064							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    563  f064							; now stages BallX into Temp; this block reads the staged copy. ---
    564  f064
    565  f064							; --- No sprite copy needed — kernel reads directly from ROM ---
    566  f064							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    567  f064							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    568  f064							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    569  f064
    570  f064							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    571  f064							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    572  f064							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    573  f064		       20 28 f6 	      jsr	SelectActiveObject
    574  f067
    575  f067							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    576  f067							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    577  f067							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    578  f067							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    579  f067							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    580  f067							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    581  f067		       20 38 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    582  f06a
    583  f06a							; --- Band-color cache → RoomBandColor ($D2) for kernel+overscan (P2.5) ---
    584  f06a							; ROM now lives in bank2: kernel-time fold is cycle-impossible on the
    585  f06a							; .WaterRow line, so fold HERE (VBLANK, timer-paced) and hand the kernel
    586  f06a							; a plain zp load. Stage FetchPtr immediately before the fold.
    587  f06a		       a5 98		      lda	RoomNo
    588  f06c		       0a		      asl
    589  f06d		       0a		      asl
    590  f06e		       09 03		      ora	#3	; Y = RoomNo*4+3 (RoomNo*4 low bits are 0)
    591  f070		       a8		      tay
    592  f071		       a5 af		      lda	LevelEnemyLo
    593  f073		       85 e5		      sta	FetchPtr
    594  f075		       a5 b0		      lda	LevelEnemyHi
    595  f077		       85 e6		      sta	FetchPtr+1
    596  f079		       a2 00		      ldx	#0
    597  f07b		       20 f6 fe 	      jsr	FoldIndirect
    598  f07e		       85 bc		      sta	RoomBandColor
    599  f080
    600  f080							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    601  f080							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    602  f080							; Dark room: black except the existing explosion blink (state=2).
    603  f080							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    604  f080							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    605  f080							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    606  f080							; no reader between this point and overscan's own `sta Temp` (joystick).
    607  f080		       a5 b5		      lda	BombPacked
    608  f082		       29 03		      and	#%00000011
    609  f084		       c9 02		      cmp	#2
    610  f086		       f0 0a		      beq	.BgBlink
    611  f088		       20 26 fc 	      jsr	CallPad_IsRoomDark
    612  f08b		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    613  f08d		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    614  f08f		       4c a2 f0 	      jmp	.BgStore
    615  f092				   .BgBlink
    616  f092							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    617  f092							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    618  f092							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    619  f092							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    620  f092							; 60 frames = exact 15 cycles, starts black at explosion.
    621  f092		       a9 3c		      lda	#60
    622  f094		       38		      sec
    623  f095		       e5 f7		      sbc	BombTimer
    624  f097		       29 03		      and	#3
    625  f099		       a8		      tay
    626  f09a		       b9 3b f8 	      lda	BombBlinkColors,Y
    627  f09d		       4c a2 f0 	      jmp	.BgStore
    628  f0a0				   .BgIdle
    629  f0a0		       a9 00		      lda	#COLOR_CAVE_BG
    630  f0a2				   .BgStore
    631  f0a2		       85 09		      sta	COLUBK
    632  f0a4
    633  f0a4							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    634  f0a4							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    635  f0a4							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    636  f0a4							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    637  f0a4							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    638  f0a4							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    639  f0a4							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    640  f0a4		       20 c4 f9 	      jsr	PositionBallM1
    641  f0a7
    642  f0a7							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    643  f0a7							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    644  f0a7							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    645  f0a7							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    646  f0a7							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    647  f0a7							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    648  f0a7							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
