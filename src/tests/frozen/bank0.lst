   1210  f281							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1211  f281							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1212  f281							;     only — subtracting $80+ would blast the player upward.
   1213  f281				   .Gravity
   1214  f281		       18		      clc
