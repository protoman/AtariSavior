   1386  f282		       c9 01		      cmp	#>MAX_FALL
   1387  f284		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1388  f286		       d0 06		      bne	.FallClamp	; above: clamp
   1389  f288		       a5 93		      lda	vyLo
   1390  f28a		       c9 80		      cmp	#<MAX_FALL
   1391  f28c		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1392  f28e				   .FallClamp
   1393  f28e		       a9 01		      lda	#>MAX_FALL
