   3705  fccb		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3706  fccd		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3707  fccf		       85 83		      sta	LaserX
