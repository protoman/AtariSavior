   1774  f483		       a5 b7		      lda	ActiveObjectX
   1775  f485		       85 80		      sta	RoomX	; restore player X
   1776  f487		       b0 04		      bcs	.TentOut	; wall → hold position
   1777  f489				   .TentCommit
