    694  f0d2							; ==============================================================================
    695  f0d2							; Kernel: 192 visible scanlines
    696  f0d2							; ==============================================================================
    697  f0d2							; Structure:
    698  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    699  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    700  f0d2							;
    701  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    702  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
    703  f0d2							; ==============================================================================
    704  f0d2
