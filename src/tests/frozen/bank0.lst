   1281  f207							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1282  f207							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1283  f207							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1284  f207							;	   catches the fall in ~10 frames from terminal $0180.
   1285  f207							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1286  f207							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1287  f207							;	   gone: it kept thrust below gravity for ~32 frames.
   1288  f207							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1289  f207							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1290  f207							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1291  f207							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1292  f207							;	   1.0s hover was too long — halved); then the flag clears and
   1293  f207							;	   normal gravity resumes (fall ~0.85s after release). State
   1294  f207							;	   lives in JetPower, NOT
   1295  f207							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1296  f207							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1297  f207							;	   rising frame — both clobbered a StepsLeft-based float.
   1298  f207							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1299  f207							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1300  f207							;	   (headroom stays $FC67).
   1301  f207							; ------------------------------------------------------------------------------
   1302  f207		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1303  f209		       24 88		      bit	Temp
   1304  f20b		       d0 23		      bne	.JetDecay
   1305  f20d		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1306  f20f		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1307  f211		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1308  f213		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1309  f215				   .JetRamp
   1310  f215							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1311  f215							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1312  f215							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1313  f215							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1314  f215							; ~80 frames = more than a room height of extra falling). The ramp only
   1315  f215							; applies from rest / while already rising, so take-off still eases in.
   1316  f215		       a5 94		      lda	vyHi
   1317  f217		       30 0a		      bmi	.JetClimb	; already rising -> ramp
   1318  f219		       05 93		      ora	vyLo
   1319  f21b		       f0 06		      beq	.JetClimb	; at rest -> ramp
   1320  f21d		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1321  f21f		       85 96		      sta	JetPower
   1322  f221		       d0 37		      bne	.Gravity	; A = JET_MAX != 0 (was jmp)
   1323  f223				   .JetClimb
   1324  f223		       a5 96		      lda	JetPower
   1325  f225		       c9 30		      cmp	#JET_MAX
   1326  f227		       b0 31		      bcs	.Gravity	; already full: nothing to add
   1327  f229		       18		      clc
   1328  f22a		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1329  f22c		       85 96		      sta	JetPower
   1330  f22e		       d0 2a		      bne	.Gravity	; A = JetPower+1 != 0 (was jmp)
   1331  f230				   .JetDecay		; Up NOT held this frame
   1332  f230		       a5 96		      lda	JetPower
   1333  f232		       f0 26		      beq	.Gravity	; 0: idle / normal fall
   1334  f234		       30 0c		      bmi	.FloatRun	; b7 set: float already active -> step it
   1335  f236		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1336  f238		       05 93		      ora	vyLo
   1337  f23a		       f0 1e		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1338  f23c							;   climb to stop, do NOT float
   1339  f23c		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1340  f23e		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1341  f240		       d0 18		      bne	.Gravity	;   (user: 1s hover too long ->
   1342  f242				   .FloatRun
   1343  f242		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1344  f244		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1345  f246		       29 7f		      and	#$7F
   1346  f248		       d0 04		      bne	.FRActive
   1347  f24a		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1348  f24c		       f0 0c		      beq	.Gravity	;   normal gravity fall from here
   1349  f24e				   .FRActive
   1350  f24e		       a5 94		      lda	vyHi
   1351  f250		       30 08		      bmi	.Gravity	; still climbing: gravity-only decel
   1352  f252		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1353  f254		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1354  f256		       85 94		      sta	vyHi
   1355  f258		       f0 44		      beq	.Integrate	; A = 0 (was jmp)
