   2253  f7b5		       d0 2a		      bne	.BTDone
   2254  f7b7		       a5 b5		      lda	BombPacked	; 1 → 2
   2255  f7b9		       29 fc		      and	#%11111100
   2256  f7bb		       09 02		      ora	#%00000010
   2257  f7bd		       85 b5		      sta	BombPacked
   2258  f7bf		       a9 3c		      lda	#60
   2259  f7c1		       85 f7		      sta	BombTimer
