   4092  ff0f							; ==============================================================================
   4093  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4094  ff0f							; ==============================================================================
   4095  ff0f							; Andrew Davie session-24 routine:
   4096  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4097  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4098  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4099  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4100  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4101  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4102  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4103  ff0f							;
   4104  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4105  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4106  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4107  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4108  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4109  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4110  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4111  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4112  ff0f				   SetObjectXPos subroutine
   4113  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4114  ff11		       38		      sec		; ensure carry flag
   4115  ff12				   .Div15Loop
   4116  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4117  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4118  ff16		       a8		      tay		; Y = remainder in -15..-1
   4119  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4120  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4121  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4122  ff1e		       60		      rts
   4123  ff1f
   4124  ff20					      org	$FF20
   4125  ff20
   4126  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   4127  ff20				   SetObjReflection
   4128  ff20		       a9 00		      lda	#0
   4129  ff22		       85 0c		      sta	REFP1
   4130  ff24		       a5 b6		      lda	ObjBase
   4131  ff26		       c9 55		      cmp	#OBJ_MINER
   4132  ff28		       d0 08		      bne	.SORdone
   4133  ff2a		       a5 a4		      lda	LevelMinerRoom
   4134  ff2c		       10 04		      bpl	.SORdone
   4135  ff2e		       a9 08		      lda	#$08
   4136  ff30		       85 0c		      sta	REFP1
   4137  ff32				   .SORdone
   4138  ff32		       60		      rts
   4139  ff33
   4140  ff33							; ------------------------------------------------------------------------------
   4141  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4142  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4143  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   4144  ff33							; user spec: no piercing, no HERO comparison needed).
   4145  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4146  ff33							;						  left	RoomX-4)
   4147  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4148  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   4149  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4150  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4151  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4152  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4153  ff33							;     priority over M0 anyway).
   4154  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4155  ff33							;     press edge re-anchors).
   4156  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4157  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4158  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4159  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4160  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4161  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4162  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4163  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4164  ff33							; ------------------------------------------------------------------------------
   4165  ff33				   LaserInput
   4166  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4167  ff35		       8a		      txa
   4168  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4169  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4170  ff3a		       8a		      txa
   4171  ff3b		       29 80		      and	#LASER_HELD
   4172  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4173  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4174  ff40		       85 c0		      sta	LaserState
   4175  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4176  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4177  ff46							; below — moved here so the cap code could
   4178  ff46							; not push .LaserReleased past bmi's ±127)
   4179  ff46				   .LaserReleased
   4180  ff46		       a9 00		      lda	#0
   4181  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4182  ff4a							; otherwise -> bars slid across screen
   4183  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   4184  ff4b				   .LaserFire
   4185  ff4b		       a5 c0		      lda	LaserState
   4186  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4187  ff4f		       85 c0		      sta	LaserState
   4188  ff51		       8a		      txa
   4189  ff52		       29 80		      and	#LASER_HELD
   4190  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4191  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4192  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4193  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   4194  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4195  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   4196  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4197  ff56		       a5 c0		      lda	LaserState
   4198  ff58		       29 01		      and	#LASER_REARM
   4199  ff5a		       f0 04		      beq	.LAdvStep
   4200  ff5c		       c6 c0		      dec	LaserState
   4201  ff5e		       d0 3a		      bne	.LaserInit
   4202  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4203  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4204  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4205  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4206  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4207  ff60				   .LAdvStep
   4208  ff60		       a4 82		      ldy	PlayerDir
   4209  ff62		       a5 83		      lda	LaserX
   4210  ff64		       18		      clc
   4211  ff65		       79 de ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   4212  ff68				   .LAdvS
   4213  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   4214  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4215  ff6c		       90 03		      bcc	.LAdvCap
   4216  ff6e		       4c 9a ff 	      jmp	.LaserInit
   4217  ff71				   .LAdvCap
   4218  ff71		       a5 82		      lda	PlayerDir
   4219  ff73		       d0 0c		      bne	.LAdvCapL
   4220  ff75		       a5 80		      lda	RoomX
   4221  ff77		       18		      clc
   4222  ff78		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   4223  ff7a		       c5 92		      cmp	RectCount
   4224  ff7c		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   4225  ff7e		       4c 9a ff 	      jmp	.LaserInit
   4226  ff81				   .LAdvCapL
   4227  ff81		       a5 80		      lda	RoomX
   4228  ff83		       38		      sec
   4229  ff84		       e9 14		      sbc	#20
   4230  ff86		       b0 02		      bcs	.LAdvCapLs
   4231  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4232  ff8a				   .LAdvCapLs
   4233  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
   4234  ff8c		       f0 05		      beq	.LAdvKeep
   4235  ff8e		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   4236  ff90		       4c 9a ff 	      jmp	.LaserInit
   4237  ff93				   .LAdvKeep
   4238  ff93		       a5 92		      lda	RectCount
   4239  ff95		       85 83		      sta	LaserX
   4240  ff97		       4c 9d ff 	      jmp	.LaserGo	; committed: skip the eye restart
   4241  ff9a				   .LaserInit
   4242  ff9a		       20 c4 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   4243  ff9d				   .LaserGo
   4244  ff9d		       a5 83		      lda	LaserX
   4245  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   4246  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   4247  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   4248  ffa6		       c9 50		      cmp	#$50
   4249  ffa8		       f0 0a		      beq	.LaserKill
   4250  ffaa		       c9 02		      cmp	#2
   4251  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   4252  ffae							;   same as kill minus score — restart at
   4253  ffae							;   the eye THIS frame, buzz keeps (b7).
   4254  ffae							;   #9's blank + the wall-center hold clamp
   4255  ffae							;   both superseded: a contact missile is
   4256  ffae							;   consumed by walls. No hold state, no
   4257  ffae							;   cap reorder, no pass-through possible.
   4258  ffae		       20 11 fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   4259  ffb1		       4c b7 ff 	      jmp	.LaserContact
   4260  ffb4				   .LaserKill
   4261  ffb4		       20 0b fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   4262  ffb7				   .LaserContact
   4263  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   4264  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
   4265  ffbc							; (b0 was 0: travel only runs with b0 clear,
   4266  ffbc							; rearm dec'd it before this init) — flush
   4267  ffbc							; hold otherwise steps +4 out of the tile
   4268  ffbc				   .LaserPos
   4269  ffbc		       a5 83		      lda	LaserX
   4270  ffbe		       a2 02		      ldx	#2	; selector 2: RESP0+2=RESM0, HMP0+2=HMM0
   4271  ffc0		       20 0f ff 	      jsr	SetObjectXPos	; drawn M0 = [LaserX-7, LaserX]
   4272  ffc3		       60		      rts
   4273  ffc4
   4274  ffc4							; Eye spawn point. Right clamped to 159 (TIA position past 159 is
   4275  ffc4							; unverified for SetObjectXPos); left >= 0 because RoomX >= PLAYER_MIN_X=4.
   4276  ffc4				   .LaserEye
   4277  ffc4		       a5 82		      lda	PlayerDir
   4278  ffc6		       d0 0e		      bne	.LEyeL
   4279  ffc8		       a5 80		      lda	RoomX
   4280  ffca		       18		      clc
   4281  ffcb		       69 04		      adc	#4
   4282  ffcd		       c9 a0		      cmp	#160
   4283  ffcf		       90 02		      bcc	.LEyeS
   4284  ffd1		       a9 9f		      lda	#159
   4285  ffd3				   .LEyeS
   4286  ffd3		       85 83		      sta	LaserX
   4287  ffd5		       60		      rts
   4288  ffd6				   .LEyeL
   4289  ffd6		       a5 80		      lda	RoomX
   4290  ffd8		       38		      sec
   4291  ffd9		       e9 04		      sbc	#4
   4292  ffdb		       85 83		      sta	LaserX
   4293  ffdd		       60		      rts
