   1578  f435							; ------------------------------------------------------------------------------
   1579  f435							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1580  f435							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1581  f435							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1582  f435							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1583  f435							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1584  f435							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1585  f435							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1586  f435							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1587  f435							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1588  f435							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1589  f435							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1590  f435							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1591  f435							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1592  f435							; ------------------------------------------------------------------------------
   1593  f435				   UE_Tentacle
   1594  f435		       a5 ad		      lda	TickCounter
   1595  f437		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1596  f439							; = half the player's 1 px/frame (user
   1597  f439							; 2026-10-10: &3 read as chunky/slow)
   1598  f439		       d0 4b		      bne	.TentOut
   1599  f43b		       b5 bd		      lda	EnemyRamX,X
   1600  f43d		       c5 80		      cmp	RoomX
   1601  f43f		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1602  f441		       90 06		      bcc	.TentRight
   1603  f443		       38		      sec
   1604  f444		       e9 01		      sbc	#1	; step left
   1605  f446		       4c 4c f4 	      jmp	.TentProbe
   1606  f449				   .TentRight
   1607  f449		       18		      clc
   1608  f44a		       69 01		      adc	#1	; step right
   1609  f44c				   .TentProbe
   1610  f44c		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1611  f44e		       b0 36		      bcs	.TentOut
   1612  f450		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1613  f452							; Same-column cull: committed X is always probe-clear, so a candidate in
   1614  f452							; the same 4px column covers the same collision cells → result is known
   1615  f452							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1616  f452		       a5 88		      lda	Temp
   1617  f454		       55 bd		      eor	EnemyRamX,X
   1618  f456		       29 fc		      and	#$FC
   1619  f458		       f0 28		      beq	.TentCommit
   1620  f45a		       a5 80		      lda	RoomX
   1621  f45c		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1622  f45e		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1623  f460		       85 b8		      sta	ActiveObjectY
   1624  f462		       a5 88		      lda	Temp
   1625  f464		       c9 05		      cmp	#5
   1626  f466		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1627  f468							; PHM's negative visible-left wraps to 255
   1628  f468							; (col garbage / ColOff OOB walk). cand<=4
   1629  f468							; ink pokes off-screen anyway; RoomX=cand
   1630  f468							; already covers cell0.
   1631  f468		       38		      sec
   1632  f469		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1633  f46b							; sits 5/7 px left of A (moth .Mvl convention,
   1634  f46b							; bank2), but PHM's PLAYER prologue derives
   1635  f46b							; lit-left = arg-4/arg-7 with the bin on
   1636  f46b							; RoomX-PlayerDir → box missed the cell left
   1637  f46b							; of the ink at cand 8/12 (sprite drew 1 px
   1638  f46b							; into the wall — bugs.md #4). cand-1 shifts
