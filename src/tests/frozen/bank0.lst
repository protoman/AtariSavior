   1096  f1fd							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1097  f1fd							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1098  f1fd							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1099  f1fd							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1100  f1fd							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1101  f1fd							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1102  f1fd							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1103  f1fd							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1104  f1fd							;	   1.0s hover was too long — halved); then the flag clears and
   1105  f1fd							;	   normal gravity resumes (fall ~0.85s after release). State
   1106  f1fd							;	   lives in JetPower, NOT
   1107  f1fd							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1108  f1fd							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1109  f1fd							;	   rising frame — both clobbered a StepsLeft-based float.
   1110  f1fd							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1111  f1fd							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1112  f1fd							;	   (headroom stays $FC67).
   1113  f1fd							; ------------------------------------------------------------------------------
   1114  f1fd		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1115  f1ff		       24 88		      bit	Temp
   1116  f201		       d0 21		      bne	.JetDecay
   1117  f203		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1118  f205		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1119  f207		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1120  f209		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1121  f20b				   .RampStart
   1122  f20b		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1123  f20d		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1124  f20f		       d0 3f		      bne	.Gravity
   1125  f211		       a5 96		      lda	JetPower
   1126  f213		       c9 14		      cmp	#JET_MAX
   1127  f215		       b0 06		      bcs	.JetCapped
   1128  f217		       18		      clc
   1129  f218		       69 01		      adc	#1
   1130  f21a		       4c 1f f2 	      jmp	.JetSet
   1131  f21d				   .JetCapped
   1132  f21d		       a9 14		      lda	#JET_MAX
   1133  f21f				   .JetSet
   1134  f21f		       85 96		      sta	JetPower
   1135  f221		       4c 50 f2 	      jmp	.Gravity
   1136  f224				   .JetDecay		; Up NOT held this frame
   1137  f224		       a5 96		      lda	JetPower
   1138  f226		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1139  f228		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1140  f22a		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1141  f22c		       05 93		      ora	vyLo
   1142  f22e		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1143  f230							;   climb to stop, do NOT float
   1144  f230		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1145  f232		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1146  f234		       4c 50 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1147  f237				   .FloatRun
   1148  f237		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1149  f239		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1150  f23b		       29 7f		      and	#$7F
   1151  f23d		       d0 04		      bne	.FRActive
   1152  f23f		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1153  f241		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1154  f243				   .FRActive
   1155  f243		       a5 94		      lda	vyHi
   1156  f245		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1157  f247		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1158  f249		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1159  f24b		       85 94		      sta	vyHi
   1160  f24d		       4c 8d f2 	      jmp	.Integrate
   1161  f250
   1162  f250							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1163  f250							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1164  f250							;     only — subtracting $80+ would blast the player upward.
   1165  f250				   .Gravity
