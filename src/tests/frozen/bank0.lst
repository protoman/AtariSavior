   3902  ff05		       20		      .byte.b	%00100000	; left 2
   3903  ff06		       10		      .byte.b	%00010000	; left 1
   3904  ff07		       00		      .byte.b	%00000000	; no movement
   3905  ff08		       f0		      .byte.b	%11110000	; right 1
   3906  ff09		       e0		      .byte.b	%11100000	; right 2
   3907  ff0a		       d0		      .byte.b	%11010000	; right 3
   3908  ff0b		       c0		      .byte.b	%11000000	; right 4
   3909  ff0c		       b0		      .byte.b	%10110000	; right 5
   3910  ff0d		       a0		      .byte.b	%10100000	; right 6
   3911  ff0e		       90		      .byte.b	%10010000	; right 7
   3912  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
