   1685  f460		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1686  f462		       85 b8		      sta	ActiveObjectY
   1687  f464		       a5 88		      lda	Temp
   1688  f466		       c9 05		      cmp	#5
   1689  f468		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1690  f46a							; PHM's negative visible-left wraps to 255
   1691  f46a							; (col garbage / ColOff OOB walk). cand<=4
   1692  f46a							; ink pokes off-screen anyway; RoomX=cand
   1693  f46a							; already covers cell0.
