   3088  fd7d							; ------------------------------------------------------------------------------
   3089  fd7d							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3090  fd7d							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3091  fd7d							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3092  fd7d							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3093  fd7d							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3094  fd7d							; DeriveEnemyY — no persistent movement state exists in RAM.
   3095  fd7d							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3096  fd7d							; block after the pads; pre-pad headroom is 1B).
   3097  fd7d							; ------------------------------------------------------------------------------
   3098  fd7d				   RefreshEnemyY
   3099  fd7d		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3100  fd7f							; TickCounter is the 60-frame GAME timer
   3101  fd7f							; (decrements 60->1, reloads) — gates derived
   3102  fd7f							; from it wrapped every second (spider
   3103  fd7f							; "teleported": (TC>>3)&63 only ever saw
   3104  fd7f							; 0..7 and counted DOWN 0->7 = jump).
   3105  fd7f		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3106  fd81		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3107  fd83				   .REYLoop		; every reader runs after refresh completes)
   3108  fd83		       ca		      dex
   3109  fd84		       20 79 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3110  fd87		       95 e2		      sta	EnemyRamY,X
   3111  fd89		       8a		      txa		; N/Z must come from X: flags after jsr are
   3112  fd8a		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3113  fd8c				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3114  fd8c							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3115  fd8c							; black rooms, broken PF, invisible sprites)
   3116  fd8c							; --- SELECT or RESET held → back to the old title / level-select screen
   3117  fd8c							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3118  fd8c							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3119  fd8c							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3120  fd8c							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3121  fd8c							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3122  fd8c							;     RESET held past LANDING still re-fires — press must be released
   3123  fd8c							;     before the drop-in finishes. ---
   3124  fd8c		       a5 8a		      lda	DropTarget
   3125  fd8e		       d0 17		      bne	.REYRts	; not idle: not ours
   3126  fd90		       ad 82 02 	      lda	SWCHB
   3127  fd93		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3128  fd95		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3129  fd97		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3130  fd99		       f0 0c		      beq	.REYRts	; neither pressed
   3131  fd9b		       a9 ff		      lda	#$FF
   3132  fd9d		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3133  fd9f		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3134  fda2		       68		      pla		; drop OUR return address (LoadLevel already
   3135  fda3		       68		      pla		;   popped its own) — tail into TitleWork
   3136  fda4		       4c 37 fd 	      jmp	TitleWork
   3137  fda7				   .REYRts
   3138  fda7		       60		      rts
