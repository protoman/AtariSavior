    324 U00bc		       00 08	   PLAYER_HEIGHT =	8	; GRP1 object (enemy/miner) height; player uses PLAYER_SPRITE_H
    325 U00bc		       00 0c	   PLAYER_SPRITE_H =	12	; player sprite height in scanlines (8x12)
    326 U00bc		       00 0c	   OBJ_WINDOW =	12	; GRP1 draw window (Phase 6 tall art);
    327 U00bc							;   PLAYER_HEIGHT stays 8 (collision box)
