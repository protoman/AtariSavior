   1832  f595		       85 f7		      sta	BombTimer
   1833  f597		       85 c1		      sta	EnemyRamD	; clear dir + RoomDarkMask (bits 4-7) — level reset
   1834  f599		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1835  f59b							;  game-over restart = LoseLife->ReloadLevel->
   1836  f59b							;  here; same-stage respawn keeps facing)
