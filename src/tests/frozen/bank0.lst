   2137  f60e							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2138  f60e							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2139  f60e							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2140  f60e							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2141  f60e							; ------------------------------------------------------------------------------
   2142  f60e				   UEDispatch
   2143  f60e		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2144  f610							;   the single type-compare entry. 2026-10-22:
   2145  f610							;   a raft authored dir=right read $87, missed
   2146  f610							;   `cmp #ENEMY_RAFT` and its body never ran
   2147  f610							;   (no tide, no motion, no rider pin).
   2148  f610		       c9 07		      cmp	#ENEMY_RAFT
   2149  f612		       d0 06		      bne	.UEDNotRaft
   2150  f614		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2151  f617		       4c 37 f4 	      jmp	UE_Next
   2152  f61a				   .UEDNotRaft
   2153  f61a		       c9 03		      cmp	#ENEMY_TENTACLE
   2154  f61c		       d0 03		      bne	.UEDNotTent
   2155  f61e		       4c 3c f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2156  f621				   .UEDNotTent
   2157  f621		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2158  f623		       d0 03		      bne	.UEDNotMoth
   2159  f625		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2160  f628				   .UEDNotMoth
   2161  f628		       c9 02		      cmp	#ENEMY_SNAKE
   2162  f62a		       d0 03		      bne	.UEDNotSnake
   2163  f62c		       4c f3 f3 	      jmp	UE_SnakeBody
   2164  f62f				   .UEDNotSnake
   2165  f62f		       4c 37 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2166  f632							; (absolute jmps: this block is far from the
   2167  f632							;  bodies — relative branches do not reach)
