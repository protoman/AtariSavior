   4001  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   4002  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   4003  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   4004  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   4005  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   4006  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   4007  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   4008  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   4009  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   4010  fe9c							; ------------------------------------------------------------------------------
   4011  fe9c				   TallyWork
   4012  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   4013  fe9f		       a8		      tay
   4014  fea0		       29 01		      and	#1
   4015  fea2		       f0 05		      beq	.TNoScore
   4016  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4017  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4018  fea9				   .TNoScore
   4019  fea9		       98		      tya
   4020  feaa		       29 04		      and	#4
   4021  feac		       f0 1e		      beq	.TLive
   4022  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4023  feb0		       a5 a3		      lda	Level
   4024  feb2		       c9 04		      cmp	#LEVEL_COUNT
   4025  feb4		       d0 04		      bne	.TNotWrap
   4026  feb6		       a9 00		      lda	#0	; wrap past last level
   4027  feb8		       85 a3		      sta	Level
   4028  feba				   .TNotWrap
   4029  feba		       a9 00		      lda	#0
   4030  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4031  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4032  febe							;   pose ($FE must take the real-fall path)
   4033  febe		       20 20 fc 	      jsr	LoadLevel
   4034  fec1		       a9 78		      lda	#120	; reset timer for new level
   4035  fec3		       85 ae		      sta	BarLevel
   4036  fec5		       a9 3c		      lda	#60
   4037  fec7		       85 ad		      sta	TickCounter
   4038  fec9		       4c 30 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4039  fecc				   .TLive
