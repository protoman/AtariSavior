   3870  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   3871  ff6c		       90 03		      bcc	.LAdvCap
   3872  ff6e		       4c 9a ff 	      jmp	.LaserInit
   3873  ff71				   .LAdvCap
   3874  ff71		       a5 82		      lda	PlayerDir
   3875  ff73		       d0 0c		      bne	.LAdvCapL
   3876  ff75		       a5 80		      lda	RoomX
   3877  ff77		       18		      clc
