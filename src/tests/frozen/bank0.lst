   3584  fe9c							; ------------------------------------------------------------------------------
   3585  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3586  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3587  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3588  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3589  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3590  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3591  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3592  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3593  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3594  fe9c							; ------------------------------------------------------------------------------
   3595  fe9c				   TallyWork
   3596  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3597  fe9f		       a8		      tay
   3598  fea0		       29 01		      and	#1
   3599  fea2		       f0 05		      beq	.TNoScore
   3600  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3601  fea6		       20 20 fc 	      jsr	CallPad_AddScore
   3602  fea9				   .TNoScore
   3603  fea9		       98		      tya
   3604  feaa		       29 04		      and	#4
   3605  feac		       f0 1e		      beq	.TLive
   3606  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3607  feb0		       a5 a3		      lda	Level
   3608  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3609  feb4		       d0 04		      bne	.TNotWrap
   3610  feb6		       a9 00		      lda	#0	; wrap past last level
   3611  feb8		       85 a3		      sta	Level
   3612  feba				   .TNotWrap
   3613  feba		       a9 00		      lda	#0
   3614  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3615  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3616  febe							;   pose ($FE must take the real-fall path)
   3617  febe		       20 68 f5 	      jsr	LoadLevel
   3618  fec1		       a9 78		      lda	#120	; reset timer for new level
   3619  fec3		       85 ae		      sta	BarLevel
   3620  fec5		       a9 3c		      lda	#60
   3621  fec7		       85 ad		      sta	TickCounter
   3622  fec9		       4c 51 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3623  fecc				   .TLive
   3624  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3625  fecf		       a9 00		      lda	#0
   3626  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3627  fed3				   .TWait
   3628  fed3		       ad 84 02 	      lda	INTIM
   3629  fed6		       d0 fb		      bne	.TWait
   3630  fed8		       4c 41 f0 	      jmp	StartFrame
