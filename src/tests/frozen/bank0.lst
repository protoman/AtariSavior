   3511  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3512  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3513  fdde							;   span)
   3514  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3515  fdde							;   latch + feature gate pushed +14; same day
   3516  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3517  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3518  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3519  fdde							;   garbage path's `inc $4A,X` set wall bits
   3520  fdde							;   via $CA)
