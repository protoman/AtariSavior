    425 U00bc		       00 00	   COLOR_CAVE_BG =	$00	; black interior
    426 U00bc		       00 84	   COLOR_CAVE_WALL =	$84	; hue 8 luma 2 = dark grey-blue
    427 U00bc		       00 06	   COLOR_HUD_BG =	$06	; hue 0 luma 3 = grey
    428 U00bc		       00 1e	   COLOR_TIMER =	$1E	; hue 1 luma 7 = yellow
