    721  f0d5							; --- Set PF registers for this tile row (TIA persists) ---
    722  f0d5							; Store ORDER is cycle-critical (thin-yellow-line fix, 2026-10-01): the
    723  f0d5							; stores land mid-visible (advance block then these pairs), so on the
    724  f0d5							; row1→row2 band-transition line the left half must keep the OLD band's
    725  f0d5							; PF+color while the right half may show the NEW band. Write cycles
    726  f0d5							; (cN = CPU cycles on the setup line, x = pixel at 4x, HBLANK ends c22.7):
    727  f0d5							;   PF0 w c34 x136 | PF1 w c41 x222 | COLUPF w c48 x296 |
    728  f0d5							;   COLUP1 w c51 x332 (D6 M1 band color — AFTER the left half, so the
    729  f0d5							;     transition line keeps the OLD band's M1/P1 color on the left, same
    730  f0d5							;     rule as COLUPF) |
    731  f0d5							;   ENABL w c58 (BandTab gate, +1c vs the old COLUBK pair) |
    732  f0d5							;   PF2 w c65 x500 (moved +3c — still past right-half PF2 pixels x449)
    733  f0d5							; COLUPF 3rd: color flips at x296 = past ALL left ON-pixels (PF1 ends
    734  f0d5							; x187, PF2 cell17 ends x287); cells18-19 (x288-319) are never ON in any
    735  f0d5							; model row (PF2 bits6/7 always 0) so the flip there is invisible (BG =
    736  f0d5							; COLUBK). PF2 LAST: store lands past every right-half PF2 pixel (x449)
    737  f0d5							; → right PF2 keeps OLD band (= BG post-blast = no yellow; pre-blast
    738  f0d5							; cell17 = new pattern's wall = looks new). Old order (PF2 3rd = w c48,
    739  f0d5							; COLUPF last = w c61 x447) painted right PF2 (x350-446) NEW pattern
    740  f0d5							; under OLD hot color = the blinking thin yellow line at y191/192.
    741  f0d5		       b5 c3		      lda	PF0Buf,X
    742  f0d7		       85 0d		      sta	PF0
    743  f0d9		       b5 c6		      lda	PF1Buf,X
    744  f0db		       85 0e		      sta	PF1
