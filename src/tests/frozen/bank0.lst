   4219  ff7a		       c5 92		      cmp	RectCount
   4220  ff7c		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   4221  ff7e		       4c 9a ff 	      jmp	.LaserInit
   4222  ff81				   .LAdvCapL
   4223  ff81		       a5 80		      lda	RoomX
   4224  ff83		       38		      sec
   4225  ff84		       e9 14		      sbc	#20
   4226  ff86		       b0 02		      bcs	.LAdvCapLs
   4227  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4228  ff8a				   .LAdvCapLs
   4229  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
   4230  ff8c		       f0 05		      beq	.LAdvKeep
   4231  ff8e		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   4232  ff90		       4c 9a ff 	      jmp	.LaserInit
   4233  ff93				   .LAdvKeep
   4234  ff93		       a5 92		      lda	RectCount
   4235  ff95		       85 83		      sta	LaserX
   4236  ff97		       4c 9d ff 	      jmp	.LaserGo	; committed: skip the eye restart
   4237  ff9a				   .LaserInit
   4238  ff9a		       20 c4 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   4239  ff9d				   .LaserGo
   4240  ff9d		       a5 83		      lda	LaserX
   4241  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   4242  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   4243  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   4244  ffa6		       c9 50		      cmp	#$50
   4245  ffa8		       f0 0a		      beq	.LaserKill
   4246  ffaa		       c9 02		      cmp	#2
   4247  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   4248  ffae							;   same as kill minus score — restart at
   4249  ffae							;   the eye THIS frame, buzz keeps (b7).
   4250  ffae							;   #9's blank + the wall-center hold clamp
   4251  ffae							;   both superseded: a contact missile is
   4252  ffae							;   consumed by walls. No hold state, no
   4253  ffae							;   cap reorder, no pass-through possible.
   4254  ffae		       20 11 fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   4255  ffb1		       4c b7 ff 	      jmp	.LaserContact
   4256  ffb4				   .LaserKill
   4257  ffb4		       20 0b fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   4258  ffb7				   .LaserContact
   4259  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   4260  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
   4261  ffbc							; (b0 was 0: travel only runs with b0 clear,
