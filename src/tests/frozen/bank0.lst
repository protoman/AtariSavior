   2760  f8c6							; --- Level data ---
   2761  f8c6							; Generated from level JSON via tools/convert_level.py.
   2762  f8c6							; Do not edit by hand — regenerate with build.sh.
   2763  f8c6							; NOTE: data payload moved to bank2 (level_bank_plan P2, frozen addresses
   2764  f8c6							; $F9D9-$FB1E); pointer values are unchanged. kernel keeps only the EQUs
   2765  f8c6							; it consumes (LEVEL_COUNT) — sync asserted by test_level_bank.py.
   2766  f8c6
   2767  f8c6							; --- Level constants ---
   2768  f8c6		       00 00	   ENEMY_SPIDER =	0
   2769  f8c6		       00 01	   ENEMY_BAT  =	1
   2770  f8c6		       00 02	   ENEMY_SNAKE =	2
   2771  f8c6		       00 03	   ENEMY_TENTACLE =	3
