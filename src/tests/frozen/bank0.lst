   3888  ffec							; ------------------------------------------------------------------------------
   3889  ffec							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   3890  ffec							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   3891  ffec							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   3892  ffec							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   3893  ffec							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   3894  ffec							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   3895  ffec							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   3896  ffec							;   One less push level too (no fold / no pad call inside the body).
   3897  ffec							;   Full behavior docs moved with the body.
   3898  ffec							; ------------------------------------------------------------------------------
   3899  ffec
   3900  ffec							; ==============================================================================
   3901  ffec							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   3902  ffec							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   3903  ffec							; ==============================================================================
   3904  ffec							; ==============================================================================
   3905  ffec		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   3906  fffa
   3907  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   3908  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   3909  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
