   3948  fcf5				   DropStep
   3949  fcf5		       a5 8a		      lda	DropTarget
   3950  fcf7		       f0 28		      beq	.DSdone	; idle (target 0 = nothing to fall)
   3951  fcf9		       c9 ff		      cmp	#$FF
   3952  fcfb		       f0 27		      beq	TitleWork	; merged title = stage preview + level select
   3953  fcfd		       c9 fe		      cmp	#$FE
   3954  fcff		       d0 03		      bne	.DSfall
   3955  fd01		       4c 9c fe 	      jmp	TallyWork	; level-bonus tally sentinel (bank2 step)
   3956  fd04				   .DSfall
   3957  fd04		       4a		      lsr
   3958  fd05		       4a		      lsr
   3959  fd06		       4a		      lsr
   3960  fd07		       4a		      lsr
   3961  fd08		       a8		      tay
   3962  fd09		       b9 ec f9 	      lda	DropSpeedTable,y
   3963  fd0c		       18		      clc
   3964  fd0d		       65 95		      adc	PlayerYSub
   3965  fd0f		       85 95		      sta	PlayerYSub
   3966  fd11		       90 0e		      bcc	.DSdone	; subpixel: no whole pixel yet this frame
   3967  fd13		       e6 81		      inc	RoomY
   3968  fd15		       a5 81		      lda	RoomY
   3969  fd17		       c5 8a		      cmp	DropTarget
   3970  fd19		       90 06		      bcc	.DSdone
   3971  fd1b		       a9 00		      lda	#0
   3972  fd1d		       85 8a		      sta	DropTarget	; arrived — input/physics resume next frame
   3973  fd1f		       85 96		      sta	JetPower	; clean resume (no phantom thrust hop)
   3974  fd21				   .DSdone
   3975  fd21		       4c 36 f3 	      jmp	OverscanAudio	; rejoin past physics/collision (no rts)
