   1367  f27d							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1368  f27d							; The high byte alone is NOT enough (2026-10-22): `cmp #>MAX_FALL` with vyHi
   1369  f27d							; == $01 is EQUAL, so the old code rewrote vy to exactly $0180 for every speed
   1370  f27d							; in $0100..$017F — a falling player's thrust was computed and then thrown
   1371  f27d							; away every frame (vy: $0180 -> $0188 -> $0158 -> clamped back to $0180), so
   1372  f27d							; the jet could not slow a fall at all. Compare the low byte when the high
   1373  f27d							; bytes match.
   1374  f27d		       a5 94		      lda	vyHi
   1375  f27f		       30 17		      bmi	.RiseClamp
   1376  f281		       c9 01		      cmp	#>MAX_FALL
   1377  f283		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1378  f285		       d0 06		      bne	.FallClamp	; above: clamp
   1379  f287		       a5 93		      lda	vyLo
   1380  f289		       c9 80		      cmp	#<MAX_FALL
   1381  f28b		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1382  f28d				   .FallClamp
   1383  f28d		       a9 01		      lda	#>MAX_FALL
   1384  f28f		       85 94		      sta	vyHi
   1385  f291		       a9 80		      lda	#<MAX_FALL
   1386  f293		       85 93		      sta	vyLo
   1387  f295		       4c a4 f2 	      jmp	.Integrate
   1388  f298				   .RiseClamp
   1389  f298		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1390  f29a		       b0 08		      bcs	.Integrate
   1391  f29c		       a9 ff		      lda	#$ff
   1392  f29e		       85 94		      sta	vyHi
   1393  f2a0		       a9 00		      lda	#$00
   1394  f2a2		       85 93		      sta	vyLo	; vy = -$0100
