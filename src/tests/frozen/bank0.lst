   2729  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2730  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2731  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2732  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2733  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2734  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2735  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2736  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2737  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2738  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2739  f980							; before — same ZP, no new allocation).
   2740  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2741  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2742  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2743  f980		       a5 8d		      lda	CollisionCellY
   2744  f982		       85 92		      sta	RectCount
   2745  f984				   .CWRow
   2746  f984		       a5 8e		      lda	CollisionEndX
   2747  f986		       85 8b		      sta	CollisionX
   2748  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2749  f989							;   was re-loaded every cell — −8c/cell walk
   2750  f989							;   trim for the falling+probe heavy frame)
   2751  f989				   .CWCol
   2752  f989		       a4 92		      ldy	RectCount
   2753  f98b		       98		      tya
   2754  f98c		       18		      clc
   2755  f98d		       7d a3 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2756  f990		       a8		      tay
   2757  f991		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2758  f994		       3d b7 fd 	      and	ColMask,X	; bit for this source col
   2759  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2760  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2761  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2762  f99d		       e8		      inx
   2763  f99e		       86 8b		      stx	CollisionX
   2764  f9a0		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
