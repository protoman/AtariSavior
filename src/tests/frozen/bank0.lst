    234 U00bc
    235 U00bc							; Rect cache RETIRED (plan C4 / cell_collision_plan 7.1, 2026-10-20).
    236 U00bc							; The solid rect list is no longer emitted and no walker reads a cache:
    237 U00bc							; PlayerHitsMap, LaserWallClamp, the moth walk and BombMarkWalls all test
    238 U00bc							; PF cells. $CC-$DF are FREE (20 B, the "option A" ZP reclaim); $89 stays
    239 U00bc							; allocated as ZPSpare89 so the sequential block above does not shift.
    240 U00bc							; History worth keeping: the cache lived at $CC-$DF because bank1's HUD
    241 U00bc							; writes $E0-$EF every frame — rect4.h on $E0 was zeroed by scorePtr1 and
    242 U00bc							; probes walked through rect4 walls (the $E0 stomp-zone rule still applies
    243 U00bc							; to every persistent byte).
    244 U00bc							; Buffers packed: PF0 $C3-$C5, PF1 $C6-$C8, PF2 $C9-$CB (rows 0-2 only).
    245 U00bc							; ($E0/$E1 are spare/stomp-zone — never persistent bank0 state.)
    246 U00bc
    247 U00bc							; PF cave buffers (copied from ROM during VBLANK, read by kernel via absolute indexed)
    248 U00bc							; These share ZP space with bank1's HUD variables — safe because bank1
    249 U00bc							; runs AFTER the cave kernel. Bank1 overwrites them during HUD band;
    250 U00bc							; VBLANK re-populates them before the next kernel frame.
    251 U00bc		       00 c3	   PF0Buf     =	$C3	; 3 bytes: TilePF0 rows 0-2 (stride-3 data S4.2)
    252 U00bc							; (rows 0-2 pure since S3.4 — Y moved to $E2)
    253 U00bc		       00 c6	   PF1Buf     =	$C6	; rows 0-2 only (S3.1 packed; was $CF)
    254 U00bc		       00 bc	   RoomBandColor =	$BC	; band-color cache (level_bank_plan P2.5) —
    255 U00bc							; own byte since S3.1 (was $D2 = PF1Buf[3];
    256 U00bc							; history: FIX 2026-09-28 was $D1 = PF1Buf[2]
    257 U00bc							; collision → mid-wall gap; alias class now
    258 U00bc							; gone entirely). Writer: VBLANK stage AFTER
    259 U00bc							; LoadPFBuffer/BuildColupF (fold from
    260 U00bc							; LevelEnemy+RoomNo*4+3). Readers: kernel
    261 U00bc							; .WaterRow (direct lda, plain abs = 4c any
    262 U00bc							; address) + overscan CheckBandTouch. Window:
    263 U00bc							; VBL write → kernel + overscan read same
    264 U00bc							; frame ($BC is nobody else's byte) → next
    265 U00bc							; VBL restages.
    266 U00bc		       00 c9	   PF2Buf     =	$C9	; rows 0-2 only (S3.1 packed; was $DB-$E6)
    267 U00bc		       00 e7	   ColupfBuf  =	$E7	; 12 bytes: final COLUPF per tile row (stripe+hot)
    268 U00bc		       00 e5	   FetchPtr   =	$E5	; fold-indirect pointer ($E5 lo, $E6 hi) —
    269 U00bc							; MOVED S3.2 to free $E0 for rect4.h (cache
    270 U00bc							; $CD-$E0 now uniform). Sits in bank1's
    271 U00bc							; stomp zone (scorePtr3-hi/scorePtr4-lo) —
    272 U00bc							; time-partitioned: bank0 stages only inside
    273 U00bc							; VBL/overscan batches, bank1 rebuilds in
    274 U00bc							; HUD after both windows. Contract (fold
    275 U00bc							; wins): stage addr immediately before a
    276 U00bc							; FoldIndirect batch.
    277 U00bc		       00 ed	   BandTab    =	$ED	; Phase 3 asym ball: staged Band0/1/2
    278 U00bc							; ($ff = ball band, $00 = mirror). Written
    279 U00bc							; by bank2 StageBandTab (BuildColupF tail,
    280 U00bc							; every VBL) BEFORE this frame's cave; read
    281 U00bc							; by .Row's ENABL gate; bank1 HUD stomps
    282 U00bc							; $ED-$EF (scbrdTmp etc.) only AFTER the
    283 U00bc							; cave read — staged-only window, like
    284 U00bc							; FetchPtr. Next VBL restages.
    285 U00bc							; Enemy RAM shadow — live X/Y + packed flags. ROM records are read-only.
    286 U00bc							; Sequential vars end at $BB (ObjBot removed S3.0b); $BC = RoomBandColor,
    287 U00bc							; $BD-$BF EnemyRam, $C0 LaserState, $C1-$C2 EnemyRamD/P.
    288 U00bc							; Score lives at $F3-$F5 only ($F6/$F7 = BombX/BombTimer).
    289 U00bc							; EnemyRamY ($E2, 3B) — private bytes since S3.4 (was an alias over
    290 U00bc							; PF0Buf rows 0-2). It deliberately sits INSIDE bank1's HUD stomp zone
    291 U00bc							; ($E0-$EF score ptrs, written every frame) because every write and every
    292 U00bc							; read land inside one safe window:
    293 U00bc							;   [HUD stomp $E2-$E4] → [overscan: RefreshEnemyY/LoadEnemyRam WRITE]
    294 U00bc							;   → [CEH / Laser / moth READ] → [next VBL: SelectActiveObject READ]
    295 U00bc							;   → [HUD stomp ...]. No reader ever sits between the stomp and the write.
    296 U00bc							;   writers: RefreshEnemyY via DeriveEnemyY (overscan entry, EVERY frame —
    297 U00bc							;	      live Y is derived from ROM spawn + EnemyRamP clock, no stored
    298 U00bc							;	      movement state) + LoadEnemyRam (EnterRoom init);
    299 U00bc							;   readers: SelectActiveObject (VBLANK), CheckEnemyHit + LaserHitTest +
    300 U00bc							;	      moth walk (overscan, after the refresh).
    301 U00bc							; Effect: $C3-$C5 = pure PF0Buf rows 0-2, never stomped → the per-frame
    302 U00bc							;   VBL repair (LoadPF0Only, ~130c + 3 folds) is deleted; full
    303 U00bc							;   LoadPFBuffer runs only on EnterRoom (PF1/PF2 rows 0-2 likewise have
    304 U00bc							;   no per-frame writer). bank1 owns $E0-$EF during HUD; bank0 never keeps
    305 U00bc							;   other persistent state there (FetchPtr $E0/$E1 = staged only).
    306 U00bc		       00 bd	   EnemyRamX  =	$BD	; 3 bytes: live X per enemy ($BD-$BF, slots 0-2
    307 U00bc							; only — enemies+lamps capped at 3 by editor
    308 U00bc							; kMaxRoomElements, convert_level MAX_ENEMIES,
    309 U00bc							; verify_build; slot 3 would collide with $C0)
    310 U00bc		       00 c0	   LaserState =	$C0	; laser: b7 fire held this frame,
    311 U00bc							;   b6 fire held last frame (press-edge),
    312 U00bc							;   b5-2 RoomDarkMask rooms 4-7,
    313 U00bc							;   b1 beam gate for the kernel .Line
    314 U00bc							;     (PlayerColTable bit1 on the beam row shares b1; mirror of b7)
    315 U00bc		       00 c1	   EnemyRamD  =	$C1	; dir bits 0-3 = enemy 0-3 (1=right, 0=left)
    316 U00bc		       00 c2	   EnemyRamP  =	$C2	; bits0-3 moth phase (shared/sync); bits4-7
    317 U00bc							;   vdir for spider/bat/tentacle (1=down)
    318 U00bc		       00 e2	   EnemyRamY  =	$E2	; 3 bytes: live Y per enemy ($E2-$E4) —
    319 U00bc							;   private since S3.4; see contract above
    320 U00bc
