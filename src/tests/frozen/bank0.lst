    335 U00bc		       00 00	   OBJ_NONE   =	0
    336 U00bc		       00 00	   OBJ_KEY    =	0	; type-6 KEY design = the offset-0 slot
    337 U00bc		       00 08	   OBJ_MOTH   =	8
    338 U00bc		       00 10	   OBJ_SPIDER =	16
    339 U00bc		       00 18	   OBJ_LAMP   =	24
