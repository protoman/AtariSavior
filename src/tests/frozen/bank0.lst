   1723  f4e3							; ==============================================================================
   1724  f4e3							; Room exit handlers — check connection table, switch rooms, reposition player
   1725  f4e3							; ==============================================================================
   1726  f4e3							; ------------------------------------------------------------------------------
   1727  f4e3							; C3 (2026-10-20): the four handlers MOVED to bank2 ($FC4F cluster) — the
   1728  f4e3							; connection table is level data in bank2, so each handler now reads its own
   1729  f4e3							; 2-byte conn record directly (bank1 GetConnIdx + FoldIndirect hops gone).
   1730  f4e3							; bank0 keeps only the entry pads at $FBD9-$FBE4 (3 B each, `sta $1FF8`;
   1731  f4e3							; bank2 serves the `jmp` at A+3). The OPPOSITE-EDGE placement is written
   1732  f4e3							; BEFORE `jmp EnterRoomB2`, because EnterRoom never touches RoomX/RoomY
   1733  f4e3							; (checked: EnterRoomB2 + B3RoomBlocks read neither) — that keeps the whole
   1734  f4e3							; tail in bank2 with 0 pushes: EnterRoomB2's `jmp ReturnPad` pops the
   1735  f4e3							; ORIGINAL `jsr ExitRoomXxx` frame, exactly like the old in-bank return.
   1736  f4e3							; Guard: verify_build.CORRIDOR_PADS (4 pads) + check_exit_handlers (edge
   1737  f4e3							; placement precedes the EnterRoomB2 tail; no-exit path ends in ReturnPad).
   1738  f4e3							; ------------------------------------------------------------------------------
   1739  f4e3
   1740  f4e3							; ==============================================================================
   1741  f4e3							; Level management
   1742  f4e3							; ==============================================================================
   1743  f4e3							; LoadLevel MOVED to bank2 (C2, 2026-10-20) — body = LoadLevelB2 ($F640).
   1744  f4e3							; The level index/table lives in bank2 (level data), so the old body paid 7
   1745  f4e3							; `jsr FoldIndirect` (7 x 25c + 14 bank switches) to read a 7-byte entry that
   1746  f4e3							; an in-bank (FetchPtr),Y read now fetches directly. Both halves are split
   1747  f4e3							; pads (same discipline as CallPad_SelectObject):
   1748  f4e3							;   A=$FC20  CallPad_LoadLevel / LoadLevel: `sta $1FF8`   (bank0 runs this)
   1749  f4e3							;   A+3=$FC23	bank2 `jmp LoadLevelB2` 		   (fetched after it)
   1750  f4e3							;   body tail `jmp $FC26` -> bank2 `sta $1FF6` at $FC26 -> the fetch at $FC29
   1751  f4e3							;   comes from HERE: `jmp LF_B0Tail`, i.e. the drop-in tail (EnterRoom call,
   1752  f4e3							;   level-start placement, `jmp DropArm`) stays in bank0 so the call chain and
   1753  f4e3							;   the measured stack depth are UNCHANGED (0 extra jsr levels, 0 pushes).
   1754  f4e3							; Entry layout: stride 7 = miner_room (b7 = faces right), miner_x, wall color,
   1755  f4e3							; wall color 2, block base word (RoomShapes), room count n (the RoomPositions
   1756  f4e3							; /RoomCounts/enemy-record bases are that block's +n/+2n/+3n offsets, C2).
   1757  f4e3							; Guards: verify_build.check_callpads pins the entry pad bytes + operand,
   1758  f4e3							; check_loadlevel_tramp pins the return half; tools/test_respawn_hover.py,
   1759  f4e3							; test_room_dark.py and test_level_bank.py read the bank2 body.
   1760  f4e3
   1761  f4e3							; ==============================================================================
   1762  f4e3							; Miner pickup — check if player overlaps miner, advance to next level
   1763  f4e3							; ==============================================================================
   1764  f4e3				   CheckMinerPickup
   1765  f4e3		       a5 a4		      lda	LevelMinerRoom
   1766  f4e5		       29 7f		      and	#$7f
   1767  f4e7		       c5 98		      cmp	RoomNo
   1768  f4e9		       d0 1b		      bne	.CMPDone	; not in miner's room
   1769  f4eb							; X overlap: player [RoomX, +6] vs 4px miner.
   1770  f4eb							; Accept iff RoomX - MinerX in [-6, +3].
   1771  f4eb		       a5 80		      lda	RoomX
   1772  f4ed		       38		      sec
   1773  f4ee		       e5 a5		      sbc	MinerX
   1774  f4f0		       18		      clc
   1775  f4f1		       69 06		      adc	#PLAYER_WIDTH - 1
   1776  f4f3		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1777  f4f5		       b0 0f		      bcs	.CMPDone	; no X overlap
   1778  f4f7							; Y overlap: player [RoomY, +11] vs miner [MinerY, +11]
   1779  f4f7							; accept iff RoomY - MinerY in [-11, +11]  (add 11, compare 23)
   1780  f4f7		       a5 81		      lda	RoomY
   1781  f4f9		       38		      sec
   1782  f4fa		       e5 a6		      sbc	MinerY
   1783  f4fc		       18		      clc
   1784  f4fd		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1785  f4ff		       c9 17		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1786  f501		       b0 03		      bcs	.CMPDone	; no Y overlap
