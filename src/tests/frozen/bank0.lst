   3051  fcef		       a9 ff		      lda	#$FF
   3052  fcf1		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3053  fcf3		       a5 a3		      lda	Level
   3054  fcf5		       18		      clc
   3055  fcf6		       69 01		      adc	#1
   3056  fcf8		       85 f5		      sta	ScoreTe	; ones digit (LEVEL_COUNT ≤ 9 — ≥10 needs
   3057  fcfa		       a9 00		      lda	#0	;  a packed-BCD tens digit here)
   3058  fcfc		       85 f3		      sta	ScoreTh
   3059  fcfe		       85 f4		      sta	ScoreHu
   3060  fd00		       18		      clc
   3061  fd01		       60		      rts
