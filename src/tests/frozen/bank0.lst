   3925  fd9d							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3926  fd9d							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3927  fd9d							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3928  fd9d							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3929  fd9d							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   3930  fd9d							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   3931  fd9d							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   3932  fd9d							;   by tools/test_cell_map.py).
   3933  fd9d							;   (The standalone CellSolid leaf that lived here moved INTO
   3934  fd9d							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3935  fd9d							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3936  fd9d							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3937  fd9d							; ------------------------------------------------------------------------------
   3938  fd9d		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   3939  fdb1		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3940  fdbd		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
