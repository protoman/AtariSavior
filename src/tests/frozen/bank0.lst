   4081  ff7e		       4c 9a ff 	      jmp	.LaserInit
   4082  ff81				   .LAdvCapL
   4083  ff81		       a5 80		      lda	RoomX
   4084  ff83		       38		      sec
   4085  ff84		       e9 14		      sbc	#20
   4086  ff86		       b0 02		      bcs	.LAdvCapLs
   4087  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4088  ff8a				   .LAdvCapLs
   4089  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
