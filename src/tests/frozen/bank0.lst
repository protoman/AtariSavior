    483  f03b		       85 06		      sta	COLUP0
    484  f03d
    485  f03d							; --- Set playfield to reflected mode + priority ---
    486  f03d							; D0=1 = reflect (left half mirrors to right)
    487  f03d							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    488  f03d							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    489  f03d							; disabled at kernel entry, size only matters once Phase 3 enables it)
    490  f03d		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    491  f03f		       85 0a		      sta	CTRLPF
