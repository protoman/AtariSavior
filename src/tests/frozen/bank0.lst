   3362  fd3a		       90 03		      bcc	.TWselDone	; C=0: no edge
   3363  fd3c		       20 35 f5 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3364  fd3f				   .TWselDone
   3365  fd3f							; --- RESET edge ---
   3366  fd3f		       a5 97		      lda	StepsLeft
   3367  fd41		       29 01		      and	#%00000001
   3368  fd43		       f0 14		      beq	.TWrstDone
   3369  fd45		       ad 82 02 	      lda	SWCHB
   3370  fd48		       29 01		      and	#%00000001
   3371  fd4a		       d0 0d		      bne	.TWrstDone
   3372  fd4c		       a9 00		      lda	#0
   3373  fd4e		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3374  fd50		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3375  fd52		       85 f4		      sta	ScoreHu
   3376  fd54		       85 f5		      sta	ScoreTe
   3377  fd56		       20 35 f5 	      jsr	LoadLevel
   3378  fd59				   .TWrstDone
   3379  fd59		       ad 82 02 	      lda	SWCHB
