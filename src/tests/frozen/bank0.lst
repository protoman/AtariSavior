   3586  ff00							; ==============================================================================
   3587  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   3588  ff00							; ==============================================================================
   3589  ff00					      org	$FF00
   3590  ff00				   fineAdjustBegin
   3591  ff00		       70		      .byte.b	%01110000	; left 7
   3592  ff01		       60		      .byte.b	%01100000	; left 6
   3593  ff02		       50		      .byte.b	%01010000	; left 5
   3594  ff03		       40		      .byte.b	%01000000	; left 4
   3595  ff04		       30		      .byte.b	%00110000	; left 3
   3596  ff05		       20		      .byte.b	%00100000	; left 2
   3597  ff06		       10		      .byte.b	%00010000	; left 1
   3598  ff07		       00		      .byte.b	%00000000	; no movement
   3599  ff08		       f0		      .byte.b	%11110000	; right 1
   3600  ff09		       e0		      .byte.b	%11100000	; right 2
   3601  ff0a		       d0		      .byte.b	%11010000	; right 3
   3602  ff0b		       c0		      .byte.b	%11000000	; right 4
   3603  ff0c		       b0		      .byte.b	%10110000	; right 5
   3604  ff0d		       a0		      .byte.b	%10100000	; right 6
   3605  ff0e		       90		      .byte.b	%10010000	; right 7
   3606  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   3607  ff0f
   3608  ff0f							; ==============================================================================
   3609  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3610  ff0f							; ==============================================================================
   3611  ff0f							; Andrew Davie session-24 routine:
   3612  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3613  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3614  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3615  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3616  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3617  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3618  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3619  ff0f							;
   3620  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3621  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3622  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3623  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3624  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3625  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3626  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3627  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3628  ff0f				   SetObjectXPos subroutine
   3629  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   3630  ff11		       38		      sec		; ensure carry flag
   3631  ff12				   .Div15Loop
   3632  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   3633  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   3634  ff16		       a8		      tay		; Y = remainder in -15..-1
   3635  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   3636  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   3637  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   3638  ff1e		       60		      rts
   3639  ff1f
   3640  ff20					      org	$FF20
   3641  ff20
   3642  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   3643  ff20				   SetObjReflection
   3644  ff20		       a9 00		      lda	#0
   3645  ff22		       85 0c		      sta	REFP1
   3646  ff24		       a5 b6		      lda	ObjBase
   3647  ff26		       c9 38		      cmp	#OBJ_MINER
   3648  ff28		       d0 08		      bne	.SORdone
   3649  ff2a		       a5 a4		      lda	LevelMinerRoom
   3650  ff2c		       10 04		      bpl	.SORdone
   3651  ff2e		       a9 08		      lda	#$08
   3652  ff30		       85 0c		      sta	REFP1
   3653  ff32				   .SORdone
   3654  ff32		       60		      rts
   3655  ff33
   3656  ff33							; ------------------------------------------------------------------------------
   3657  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3658  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3659  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3660  ff33							; user spec: no piercing, no HERO comparison needed).
   3661  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3662  ff33							;						  left	RoomX-4)
   3663  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3664  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3665  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3666  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3667  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3668  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3669  ff33							;     priority over M0 anyway).
   3670  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3671  ff33							;     press edge re-anchors).
   3672  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3673  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3674  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3675  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3676  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3677  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3678  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3679  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3680  ff33							; ------------------------------------------------------------------------------
   3681  ff33				   LaserInput
   3682  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3683  ff35		       8a		      txa
   3684  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3685  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3686  ff3a		       8a		      txa
   3687  ff3b		       29 80		      and	#LASER_HELD
   3688  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3689  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3690  ff40		       85 c0		      sta	LaserState
   3691  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3692  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3693  ff46							; below — moved here so the cap code could
   3694  ff46							; not push .LaserReleased past bmi's ±127)
   3695  ff46				   .LaserReleased
   3696  ff46		       a9 00		      lda	#0
   3697  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   3698  ff4a							; otherwise -> bars slid across screen
   3699  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   3700  ff4b				   .LaserFire
   3701  ff4b		       a5 c0		      lda	LaserState
   3702  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   3703  ff4f		       85 c0		      sta	LaserState
   3704  ff51		       8a		      txa
   3705  ff52		       29 80		      and	#LASER_HELD
   3706  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   3707  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   3708  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   3709  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   3710  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   3711  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   3712  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   3713  ff56		       a5 c0		      lda	LaserState
   3714  ff58		       29 01		      and	#LASER_REARM
   3715  ff5a		       f0 04		      beq	.LAdvStep
   3716  ff5c		       c6 c0		      dec	LaserState
   3717  ff5e		       d0 3a		      bne	.LaserInit
   3718  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   3719  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   3720  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   3721  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   3722  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   3723  ff60				   .LAdvStep
   3724  ff60		       a4 82		      ldy	PlayerDir
   3725  ff62		       a5 83		      lda	LaserX
   3726  ff64		       18		      clc
   3727  ff65		       79 de ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   3728  ff68				   .LAdvS
   3729  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   3730  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   3731  ff6c		       90 03		      bcc	.LAdvCap
   3732  ff6e		       4c 9a ff 	      jmp	.LaserInit
   3733  ff71				   .LAdvCap
   3734  ff71		       a5 82		      lda	PlayerDir
   3735  ff73		       d0 0c		      bne	.LAdvCapL
   3736  ff75		       a5 80		      lda	RoomX
   3737  ff77		       18		      clc
   3738  ff78		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   3739  ff7a		       c5 92		      cmp	RectCount
   3740  ff7c		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   3741  ff7e		       4c 9a ff 	      jmp	.LaserInit
   3742  ff81				   .LAdvCapL
   3743  ff81		       a5 80		      lda	RoomX
   3744  ff83		       38		      sec
   3745  ff84		       e9 14		      sbc	#20
   3746  ff86		       b0 02		      bcs	.LAdvCapLs
   3747  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   3748  ff8a				   .LAdvCapLs
   3749  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
   3750  ff8c		       f0 05		      beq	.LAdvKeep
   3751  ff8e		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   3752  ff90		       4c 9a ff 	      jmp	.LaserInit
   3753  ff93				   .LAdvKeep
   3754  ff93		       a5 92		      lda	RectCount
   3755  ff95		       85 83		      sta	LaserX
   3756  ff97		       4c 9d ff 	      jmp	.LaserGo	; committed: skip the eye restart
   3757  ff9a				   .LaserInit
   3758  ff9a		       20 c4 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   3759  ff9d				   .LaserGo
   3760  ff9d		       a5 83		      lda	LaserX
   3761  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   3762  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   3763  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   3764  ffa6		       c9 50		      cmp	#$50
   3765  ffa8		       f0 0a		      beq	.LaserKill
   3766  ffaa		       c9 02		      cmp	#2
   3767  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   3768  ffae							;   same as kill minus score — restart at
   3769  ffae							;   the eye THIS frame, buzz keeps (b7).
   3770  ffae							;   #9's blank + the wall-center hold clamp
   3771  ffae							;   both superseded: a contact missile is
   3772  ffae							;   consumed by walls. No hold state, no
   3773  ffae							;   cap reorder, no pass-through possible.
   3774  ffae		       20 2c fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   3775  ffb1		       4c b7 ff 	      jmp	.LaserContact
   3776  ffb4				   .LaserKill
   3777  ffb4		       20 20 fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   3778  ffb7				   .LaserContact
   3779  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   3780  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
   3781  ffbc							; (b0 was 0: travel only runs with b0 clear,
