   1844  f49b		       bc 77 f9 	      ldy	EnemyOffTable,X
   1845  f49e		       20 f6 fe 	      jsr	FoldIndirect	; type
   1846  f4a1		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1847  f4a3							;   missed and a dir-left enemy fell through to
   1848  f4a3							;   .DEYStatic (no bob)
   1849  f4a3		       c9 01		      cmp	#ENEMY_BAT
   1850  f4a5		       f0 18		      beq	.DEYTickNoShift
   1851  f4a7		       c9 03		      cmp	#ENEMY_TENTACLE
