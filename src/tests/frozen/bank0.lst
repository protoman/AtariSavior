   3141  fda8							; BuildColupF — 12-byte final COLUPF image at ColupfBuf ($E7-$F2).
   3142  fda8							;   Stripe: rows 0,2 = LevelWallColor; row 1 = LevelWallColor2.
   3143  fda8							;   Hot rows overwrite with TickCounter-bit4 pulse (COLOR_HOT_Y/R).
   3144  fda8							;   $F0-$F2 (bombs) NO LONGER overlap-saved: body writes rows 0-2 only,
   3145  fda8							;   save/restore round trip deleted (S3.0b — window audit: zero writers).
   3146  fda8							;   Bank1 clobbers $E0-$EF during HUD; VBLANK rebuilds every frame.
   3147  fda8							; ------------------------------------------------------------------------------
   3148  fda8							; ------------------------------------------------------------------------------
   3149  fda8							; BuildColupF — MOVED to bank2 (S5.1) — CallPad_BuildColupF.
   3150  fda8							;   Hot-rect data (RoomRects) lives in bank2, so the body reads it with
   3151  fda8							;   direct (FetchPtr),Y — the shared $FEF6 fold block's sta $1FF6 always
   3152  fda8							;   returns to bank0, so a fold inside a bank1 body could not work.
   3153  fda8							;   The dark check is inlined there too: CallPad_IsRoomDark cannot nest
   3154  fda8							;   from a pad body (ReturnPad switches to bank0 mid-call).
   3155  fda8							;   Body: bank2.asm, pinned at $FC4F. Entry save block ($F0-$F2 → collision
   3156  fda8							;   temps) was dead (rows 0-2 only) — deleted with the .AfterRows restore
   3157  fda8							;   in S3.0b.
   3158  fda8							; ------------------------------------------------------------------------------
   3159  fda8
   3160  fda8							; UpdateBombSound moved to bank1 (leaf_move_plan batch A) — CallPad_UpdateBombSound.
   3161  fda8
   3162  fda8							; ------------------------------------------------------------------------------
   3163  fda8							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3164  fda8							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3165  fda8							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3166  fda8							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3167  fda8							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3168  fda8							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3169  fda8							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3170  fda8							;   tools/test_cell_map.py).
   3171  fda8							;   (The standalone CellSolid leaf that lived here moved INTO
   3172  fda8							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3173  fda8							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3174  fda8							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3175  fda8							; ------------------------------------------------------------------------------
   3176  fda8		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3177  fdbc		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3178  fdc8		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3179  fdd0
   3180  fdd0							; ------------------------------------------------------------------------------
   3181  fdd0							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3182  fdd0							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3183  fdd0							; is fetched from bank2's byte-identical mirror at this same address and
   3184  fdd0							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3185  fdd0							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3186  fdd0							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3187  fdd0							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3188  fdd0							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3189  fdd0							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3190  fdd0							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3191  fdd0							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3192  fdd0							; ------------------------------------------------------------------------------
   3193  fdd0		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3194  fdd8				   BombEnemyBlast
   3195  fdd8		       8d f8 1f 	      sta	$1FF8
   3196  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3197  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3198  fdde							;   span)
   3199  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3200  fdde							;   latch + feature gate pushed +14; same day
   3201  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3202  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3203  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3204  fdde							;   garbage path's `inc $4A,X` set wall bits
   3205  fdde							;   via $CA)
   3206  fdde
   3207  fdde							; ------------------------------------------------------------------------------
   3208  fdde							; PickPlayerFrame tramp RETIRED (2026-10-20, repack chunk 1): the body now
   3209  fdde							; lives in bank0 ($F9F5 region), so the VBL `jsr PickPlayerFrame` resolves
   3210  fdde							; in-bank and the 6-byte `sta $1FF8 / jmp $F3C4` pad plus its bank2 mirror
   3211  fdde							; are gone. PlayerWalkA/B flow up to $FDDE (nothing pins them any more).
