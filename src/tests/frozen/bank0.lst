   2582  f980							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2583  f980							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2584  f980							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2585  f980							; into them), so room complexity is unbounded and geometry parity is proven
   2586  f980							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2587  f980							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2588  f980							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2589  f980							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2590  f980							; mirror; bank2 display-space walkers add their own when they convert).
   2591  f980							; RectCount = running row, CollisionX = running col (both were walk temps
   2592  f980							; before — same ZP, no new allocation).
   2593  f980							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2594  f980							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2595  f980							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2596  f980		       a5 8d		      lda	CollisionCellY
   2597  f982		       85 92		      sta	RectCount
   2598  f984				   .CWRow
   2599  f984		       a5 8e		      lda	CollisionEndX
   2600  f986		       85 8b		      sta	CollisionX
   2601  f988		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2602  f989							;   was re-loaded every cell — −8c/cell walk
   2603  f989							;   trim for the falling+probe heavy frame)
   2604  f989				   .CWCol
   2605  f989		       a4 92		      ldy	RectCount
   2606  f98b		       98		      tya
   2607  f98c		       18		      clc
