    881  f0f3		       b5 cb		      lda	PF2Buf,X
    882  f0f5		       85 0f		      sta	PF2
    883  f0f7							; --- Phase 5: is the second GRP1 object in THIS band? ---------------
    884  f0f7							; Sits in the setup window's free tail (~59c after PF2, before the WSYNC
    885  f0f7							; that ends the pass, so the phased stores above never move). The early
    886  f0f7							; out costs 5c; Slot1Hook pays 2 extra lines ONLY on the band that hosts
    887  f0f7							; slot 1 (SetObjectXPos WSYNC line + the HMOVE line).
    888  f0f7		       a5 ea		      lda	ObjBase1	; $FF = none. `bmi` is still valid HERE (slot 1
    889  f0f9		       30 03		      bmi	Slot1Keep	;   only holds an enemy design or the miner,
    890  f0fb							;   all < $80; the bomb never reaches slot 1).
    891  f0fb							;   Slot 0 must use `cmp #$FF` — see .SODone.
    892  f0fb		       4c 6a f7 	      jmp	Slot1Hook	; NOT jsr: when the hook positions P1 it owns
    893  f0fe							;   the rest of this band (counts its own lines
    894  f0fe							;   and jumps into .Line), so a pushed return
    895  f0fe							;   address would leak 2 bytes every frame.
    896  f0fe							;   Its early-out jumps back to .RowNoSlot1.
    897  f0fe				   Slot1Keep
    898  f0fe							; (2026-10-15) GRP0 blank REMOVED: +5c pushed the rows0/1 setup
    899  f0fe							; segment to 75c armed (>=74 = write lands next line = +1 stall line
    900  f0fe							; = whole-screen shift). The blank only traded a stale-byte duplicate
    901  f0fe							; for a blank line at band boundaries — shipped pre-99b8e86 without
    902  f0fe							; either; case15 filters zero writes so the Y-align guard is unaffected.
    903  f0fe							; --- Scanlines this pass (N=4): bands 0-2 = 36; band 3 = 24+off (tide,
    904  f0fe							; CollisionX). The bottom water strip (last 12-off lines,
    905  f0fe							; bottom_band_plan rule 2) renders in .WaterRow after this pass — its own
    906  f0fe							; setup line + (12-off) bodies, so the bottom band spans 38 picture lines
    907  f0fe							; and the cave body count is exactly CAVE_LINES (144).
    908  f0fe							; Split tail (2026-10-05, row1 setup gap 77->74): the non-bottom gate used
    909  f0fe							; to pay `bne` 3c to skip the tide load AND share the WSYNC — gap was 77
    910  f0fe							; (stall, +1 line/frame). Non-bottom bands now store+WSYNC before the tide
    911  f0fe							; block, then jmp over it (+3c charged to the FIRST body line =
    912  f0fe							; 66max+3jmp+3WSYNC = 72 <=76). Bottom-band path byte-identical in cost
    913  f0fe							; (cpx/beqT/lda/sta/WSYNC
    914  f0fe							; = 11+3 = 76, zero margin — the `beq` target is 9 bytes ahead, same
    915  f0fe							; page, T=3c; do not let this block grow toward a page edge).
    916  f0fe							; A1 gap fix (2026-10-05): `sta Temp` (+3c in .Row) pushed gaps to
    917  f0fe							; 77/79 = stall EVERY frame (265-line frames). `sta LineCount` moved
    918  f0fe							; AFTER `sta WSYNC` — same bytes, -3c from the gap window, +3c to the
    919  f0fe							; first body line (66max+3LC[+3jmp]+3WSYNC = 75 rows0/1, 72 row2).
    920  f0fe							; LineCount is not read until the line's `dec` tail — the early store
    921  f0fe							; was never required; keep the store strictly between WSYNC and .Line.
    922  f0fe		       e0 03		      cpx	#TILE_ROWS-1
    923  f100		       f0 09		      beq	.RowLinesTide	; bottom band: tide count (24+off) from CollisionX
    924  f102							; other bands: fixed LINES_PER_TILE bodies (36 since N=4).
    925  f102		       a9 24		      lda	#LINES_PER_TILE
    926  f104							; --- Sync to next scanline (rows 0/1) ---
    927  f104		       85 02		      sta	WSYNC
    928  f106		       85 84		      sta	LineCount
    929  f108		       4c 11 f1 	      jmp	CaveLine
    930  f10b				   .RowLinesTide
    931  f10b		       a5 8b		      lda	CollisionX	; 24..27 — VBL tide calc (see VBL comment)
    932  f10d							; --- Sync to next scanline (row 2; falls straight into .Line) ---
