   3729  fda3							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3730  fda3							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3731  fda3							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3732  fda3							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3733  fda3							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3734  fda3							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3735  fda3							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3736  fda3							;   tools/test_cell_map.py).
   3737  fda3							;   (The standalone CellSolid leaf that lived here moved INTO
   3738  fda3							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3739  fda3							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3740  fda3							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3741  fda3							; ------------------------------------------------------------------------------
   3742  fda3		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3743  fdb7		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3744  fdc3		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
