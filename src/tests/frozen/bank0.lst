   1477  f3be							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1478  f3be							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1479  f3be							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1480  f3be							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1481  f3be							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1482  f3be							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1483  f3be							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1484  f3be							; so the first move is the retreat into its wall. Ignores editor range_* per
   1485  f3be							; user 2026-09-23. No wall collision.
   1486  f3be							; ------------------------------------------------------------------------------
   1487  f3be				   UpdateEnemies
   1488  f3be		       a5 b3		      lda	EnemyCount
   1489  f3c0		       d0 01		      bne	UE_Start
   1490  f3c2		       60		      rts
   1491  f3c3				   UE_Start
   1492  f3c3							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1493  f3c3							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1494  f3c3		       a5 b1		      lda	EnemyDataLo
   1495  f3c5		       85 e5		      sta	FetchPtr
   1496  f3c7		       a5 b2		      lda	EnemyDataHi
   1497  f3c9		       85 e6		      sta	FetchPtr+1
   1498  f3cb		       a2 00		      ldx	#0
   1499  f3cd				   UE_Loop
   1500  f3cd		       e4 b3		      cpx	EnemyCount
   1501  f3cf		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1502  f3d1		       4c 2c f4 	      jmp	UE_Exit
   1503  f3d4				   UE_Alive
   1504  f3d4		       a5 ba		      lda	EnemyDeadMask
   1505  f3d6		       3d ba f3 	      and	EnemyBitTable,X
   1506  f3d9		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1507  f3db		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1508  f3de		       20 f6 fe 	      jsr	FoldIndirect	; type
   1509  f3e1		       4c fb f5 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1510  f3e4							; 18 B per-type compare chain with one 3 B jmp:
   1511  f3e4							; frees 15 B of pre-pad headroom and gives the
   1512  f3e4							; type tables room for the raft byte.
   1513  f3e4				   UE_SnakeBody
   1514  f3e4		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1515  f3e6		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1516  f3e8		       d0 3e		      bne	UE_Next
   1517  f3ea							; live dir bit: 1 = right, 0 = left
   1518  f3ea		       bd ba f3 	      lda	EnemyBitTable,X
   1519  f3ed		       25 c1		      and	EnemyRamD
   1520  f3ef		       d0 1d		      bne	UE_SnakeRight
   1521  f3f1				   UE_SnakeLeft
   1522  f3f1		       d6 bd		      dec	EnemyRamX,X
   1523  f3f3		       c8		      iny		; +1 = ROM spawn X
   1524  f3f4		       20 f6 fe 	      jsr	FoldIndirect
   1525  f3f7		       85 88		      sta	Temp
   1526  f3f9		       38		      sec
   1527  f3fa		       e9 04		      sbc	#SNAKE_PATROL	; rmin = spawn - SNAKE_PATROL: SYMMETRIC patrol
   1528  f3fc							; (user 2026-10-19) — no dir read needed, the
   1529  f3fc							; range is the placement ± one tile either way
   1530  f3fc		       85 88		      sta	Temp
   1531  f3fe		       b5 bd		      lda	EnemyRamX,X
   1532  f400		       c5 88		      cmp	Temp
   1533  f402		       b0 24		      bcs	UE_Next	; X >= rmin OK
   1534  f404		       a5 88		      lda	Temp
   1535  f406		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1536  f408		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1537  f40b		       4c 28 f4 	      jmp	UE_Next
   1538  f40e				   UE_SnakeRight
   1539  f40e		       f6 bd		      inc	EnemyRamX,X
   1540  f410		       c8		      iny		; +1 = ROM spawn X
   1541  f411		       20 f6 fe 	      jsr	FoldIndirect
   1542  f414		       85 88		      sta	Temp
   1543  f416		       18		      clc
   1544  f417		       69 04		      adc	#SNAKE_PATROL	; rmax = spawn + SNAKE_PATROL (symmetric)
   1545  f419		       85 88		      sta	Temp
   1546  f41b		       b5 bd		      lda	EnemyRamX,X
   1547  f41d		       c5 88		      cmp	Temp
   1548  f41f		       90 07		      bcc	UE_Next	; X < rmax OK
   1549  f421		       a5 88		      lda	Temp
   1550  f423		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1551  f425		       20 78 fc 	      jsr	UE_FlipDir	; at or past max → turn left
   1552  f428				   UE_Next
   1553  f428		       e8		      inx
