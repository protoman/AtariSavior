    437 U00bc							; ==============================================================================
    438 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    439 U00bc							; ==============================================================================
    440 U00bc							; Bank3 is the power-up bank. Its stub does:
    441 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    442 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    443 U00bc							; ==============================================================================
    444  10000 ????				       seg	code
    445  f000					      org	$F000
    446  f000
    447  f000							; --- 5-byte bankswitching pad ---
    448  f000							; After bank3's stub selects us, CPU arrives here.
    449  f000							; We jump over the pad into the real init code.
    450  f000		       a9 00		      lda	#0
    451  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    452  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    453  f008							; (NOT deletable: $F008 = GameStart is a
    454  f008							;  hardcoded cross-bank entry — bank1
    455  f008							;  stub `jmp $F008`; this jmp also keeps
    456  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    457  f008							;  fold-pad byte guard fires when it moves)
    458  f008							;  + F0xx landmarks fixed)
    459  f008
    460  f008				   GameStart
    461  f008		       78		      sei		; disable interrupts
    462  f009		       d8		      cld		; clear decimal mode
    463  f00a		       a2 ff		      ldx	#$FF
    464  f00c		       9a		      txs		; stack pointer = $FF
    465  f00d
    466  f00d							; --- Clear zero-page RAM ---
    467  f00d		       a9 00		      lda	#0
    468  f00f		       a2 80		      ldx	#$80
    469  f011				   .ClearZP
    470  f011		       95 00		      sta	$00,X
    471  f013		       e8		      inx
    472  f014		       d0 fb		      bne	.ClearZP
    473  f016
    474  f016							; --- Initialize game state ---
    475  f016		       a9 00		      lda	#0
    476  f018		       85 a3		      sta	Level
    477  f01a		       a9 03		      lda	#3
    478  f01c		       85 ac		      sta	PlayerLives
    479  f01e		       a9 05		      lda	#BOMBS_MAX
    480  f020		       85 f0		      sta	PlayerBombs
    481  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    482  f022		       a9 3c		      lda	#60
    483  f024		       85 ad		      sta	TickCounter
    484  f026		       a9 78		      lda	#120
    485  f028		       85 ae		      sta	BarLevel	; bar starts full
    486  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    487  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    488  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    489  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    490  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    491  f02a		       a9 ff		      lda	#$FF
    492  f02c		       85 8a		      sta	DropTarget
    493  f02e
    494  f02e							; --- Load first level (the title previews it on the live stage:
    495  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    496  f02e		       20 20 fc 	      jsr	LoadLevel
    497  f031
    498  f031							; --- Set player color ---
    499  f031		       a9 48		      lda	#COLOR_PLAYER
    500  f033		       85 06		      sta	COLUP0
    501  f035
    502  f035							; --- Set playfield to reflected mode + priority ---
    503  f035							; D0=1 = reflect (left half mirrors to right)
    504  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    505  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    506  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    507  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    508  f037		       85 0a		      sta	CTRLPF
