   1575  f3e5		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1576  f3e8		       20 f6 fe 	      jsr	FoldIndirect	; type|dir (UEDispatch masks b7)
   1577  f3eb		       4c 07 f6 	      jmp	UEDispatch	; UEDispatch replaces the old
   1578  f3ee							; 18 B per-type compare chain with one 3 B jmp:
   1579  f3ee							; frees 15 B of pre-pad headroom and gives the
