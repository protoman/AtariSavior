   3801  fcc1							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3802  fcc1							; caller; Y is animated from the screen top down to it).
   3803  fcc1							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3804  fcc1							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3805  fcc1							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3806  fcc1							;
   3807  fcc1							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3808  fcc1							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3809  fcc1							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3810  fcc1							;
   3811  fcc1							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3812  fcc1							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3813  fcc1							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3814  fcc1							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3815  fcc1							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3816  fcc1							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3817  fcc1							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3818  fcc1							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3819  fcc1							; ------------------------------------------------------------------------------
   3820  fcc1				   DropArm
   3821  fcc1		       a5 8a		      lda	DropTarget
   3822  fcc3		       c9 fd		      cmp	#$FD
   3823  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3824  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3825  fcc7							;   tally cleared to 0 by TallyWork before its
   3826  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3827  fcc7		       a5 81		      lda	RoomY
   3828  fcc9		       85 8a		      sta	DropTarget
   3829  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3830  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3831  fccf		       a9 00		      lda	#0
   3832  fcd1		       85 81		      sta	RoomY
   3833  fcd3		       85 95		      sta	PlayerYSub
   3834  fcd5		       85 93		      sta	vyLo
   3835  fcd7		       85 94		      sta	vyHi
   3836  fcd9		       a5 c0		      lda	LaserState
   3837  fcdb		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3838  fcdd		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3839  fcdf		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3840  fce1		       85 83		      sta	LaserX
   3841  fce3		       18		      clc
   3842  fce4		       60		      rts
