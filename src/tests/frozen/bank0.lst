   4113  fe0d				   PlayerSpriteA
   4114  fe0d		       3c		      .byte.b	%00111100	; row	0
   4115  fe0e		       7e		      .byte.b	%01111110	; row	1
   4116  fe0f		       7e		      .byte.b	%01111110	; row	2
