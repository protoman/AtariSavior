   2209  f62a							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2210  f62a							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2211  f62a							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2212  f62a							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2213  f62a							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2214  f62a							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2215  f62a							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2216  f62a							; ==============================================================================
   2217  f62a				   SelectActiveObject
   2218  f62a							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2219  f62a							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2220  f62a							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2221  f62a							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2222  f62a							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2223  f62a							; middle of the screen" the moment the points counting started).
   2224  f62a		       a5 8a		      lda	DropTarget
   2225  f62c		       c9 fe		      cmp	#$FE
   2226  f62e		       d0 2d		      bne	.SOFull
   2227  f630		       a9 00		      lda	#0
   2228  f632		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2229  f634		       a9 ff		      lda	#$FF
   2230  f636		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2231  f638							;   `0 = no object` comment was wrong and the
   2232  f638							;   tally-without-miner frame staged ObjTop from
   2233  f638							;   a stale Y, i.e. a stray key sprite)
   2234  f638		       a5 a4		      lda	LevelMinerRoom
   2235  f63a		       29 7f		      and	#$7f
   2236  f63c		       c5 98		      cmp	RoomNo
   2237  f63e		       f0 03		      beq	.SOTallyMiner
   2238  f640		       4c 3b f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2239  f643				   .SOTallyMiner
   2240  f643		       a9 55		      lda	#OBJ_MINER
   2241  f645		       85 b6		      sta	ObjBase
   2242  f647		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2243  f649		       85 9d		      sta	ObjHeight
   2244  f64b		       a5 a5		      lda	MinerX
   2245  f64d		       85 b7		      sta	ActiveObjectX
   2246  f64f		       a5 a6		      lda	MinerY
   2247  f651		       18		      clc
