    716  f0d2							; Kernel: 192 visible scanlines
    717  f0d2							; ==============================================================================
    718  f0d2							; Structure:
    719  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    720  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    721  f0d2							;
    722  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    723  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
