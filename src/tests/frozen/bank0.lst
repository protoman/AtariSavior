   1694  f4e0		       20 f6 fe 	      jsr	FoldIndirect	; type
   1695  f4e3		       c9 01		      cmp	#ENEMY_BAT
   1696  f4e5		       f0 18		      beq	.DEYTickNoShift
   1697  f4e7		       c9 03		      cmp	#ENEMY_TENTACLE
