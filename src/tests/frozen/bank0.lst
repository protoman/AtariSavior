   3680  ff33							; ------------------------------------------------------------------------------
   3681  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3682  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3683  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3684  ff33							; user spec: no piercing, no HERO comparison needed).
   3685  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3686  ff33							;						  left	RoomX-4)
   3687  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3688  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3689  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3690  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3691  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3692  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3693  ff33							;     priority over M0 anyway).
   3694  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3695  ff33							;     press edge re-anchors).
   3696  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3697  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3698  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3699  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3700  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3701  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3702  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3703  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3704  ff33							; ------------------------------------------------------------------------------
   3705  ff33				   LaserInput
   3706  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3707  ff35		       8a		      txa
   3708  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3709  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3710  ff3a		       8a		      txa
   3711  ff3b		       29 80		      and	#LASER_HELD
   3712  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3713  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3714  ff40		       85 c0		      sta	LaserState
   3715  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3716  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3717  ff46							; below — moved here so the cap code could
   3718  ff46							; not push .LaserReleased past bmi's ±127)
   3719  ff46				   .LaserReleased
   3720  ff46		       a9 00		      lda	#0
   3721  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   3722  ff4a							; otherwise -> bars slid across screen
   3723  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   3724  ff4b				   .LaserFire
   3725  ff4b		       a5 c0		      lda	LaserState
   3726  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   3727  ff4f		       85 c0		      sta	LaserState
   3728  ff51		       8a		      txa
   3729  ff52		       29 80		      and	#LASER_HELD
   3730  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   3731  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   3732  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   3733  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   3734  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   3735  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   3736  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   3737  ff56		       a5 c0		      lda	LaserState
   3738  ff58		       29 01		      and	#LASER_REARM
   3739  ff5a		       f0 04		      beq	.LAdvStep
