   3606  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3607  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3608  fd3a				   .TWselDone
   3609  fd3a							; --- RESET edge ---
   3610  fd3a		       a5 97		      lda	StepsLeft
   3611  fd3c		       29 01		      and	#%00000001
   3612  fd3e		       f0 14		      beq	.TWrstDone
   3613  fd40		       ad 82 02 	      lda	SWCHB
   3614  fd43		       29 01		      and	#%00000001
   3615  fd45		       d0 0d		      bne	.TWrstDone
   3616  fd47		       a9 00		      lda	#0
   3617  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3618  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3619  fd4d		       85 f4		      sta	ScoreHu
   3620  fd4f		       85 f5		      sta	ScoreTe
   3621  fd51		       20 20 fc 	      jsr	LoadLevel
