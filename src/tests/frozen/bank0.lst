   2152  f93e		       a5 80		      lda	RoomX
   2153  f940		       e5 82		      sbc	PlayerDir
   2154  f942		       c9 0f		      cmp	#15
   2155  f944		       b0 06		      bcs	.off7
   2156  f946		       38		      sec
   2157  f947		       e9 04		      sbc	#4	; P0 target <15: visible left = X - 4
   2158  f949		       4c 4e f9 	      jmp	.gotVL
   2159  f94c				   .off7
   2160  f94c		       e9 07		      sbc	#7	; P0 target >=15: visible left = X - 7
   2161  f94e				   .gotVL
   2162  f94e		       18		      clc
   2163  f94f		       65 82		      adc	PlayerDir	; reflected sprite's first lit bit is column 1
   2164  f951							; first block = visible_left / 4 -> text column
   2165  f951		       a8		      tay		; Y = visible_left
   2166  f952		       4a		      lsr
   2167  f953		       4a		      lsr
   2168  f954		       c9 14		      cmp	#TILE_COLUMNS
   2169  f956		       90 07		      bcc	.firstOk
   2170  f958		       85 8b		      sta	CollisionX
   2171  f95a		       a9 27		      lda	#39
   2172  f95c		       38		      sec
   2173  f95d		       e5 8b		      sbc	CollisionX
   2174  f95f				   .firstOk
   2175  f95f		       85 8e		      sta	CollisionEndX	; min text column
   2176  f961
   2177  f961							; last block = (visible_left + PLAYER_WIDTH - 1) / 4 -> text column
   2178  f961		       98		      tya		; A = visible_left
   2179  f962		       18		      clc
   2180  f963		       69 06		      adc	#PLAYER_WIDTH - 1
   2181  f965		       4a		      lsr
   2182  f966		       4a		      lsr
   2183  f967		       c9 14		      cmp	#TILE_COLUMNS
   2184  f969		       90 07		      bcc	.lastOk
   2185  f96b		       85 8b		      sta	CollisionX
   2186  f96d		       a9 27		      lda	#39
   2187  f96f		       38		      sec
   2188  f970		       e5 8b		      sbc	CollisionX
   2189  f972				   .lastOk
   2190  f972		       85 8c		      sta	CollisionCellX	; max text column
   2191  f974
   2192  f974							; Ensure min <= max (blocks 20+ reverse the column order)
   2193  f974		       a5 8e		      lda	CollisionEndX
   2194  f976		       c5 8c		      cmp	CollisionCellX
   2195  f978		       90 06		      bcc	.colsOk
