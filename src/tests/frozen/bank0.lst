   1791  f490							; ------------------------------------------------------------------------------
   1792  f490							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1793  f490							; there is no free ZP byte for per-slot movement state (phase/direction live
   1794  f490							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1795  f490							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1796  f490							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1797  f490							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1798  f490							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1799  f490							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1800  f490							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1801  f490							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1802  f490							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1803  f490							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1804  f490							;	    the 60-frame game timer — gates from it wrap every second).
   1805  f490							; Other types: straight ROM y (their movement stages come later).
   1806  f490							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1807  f490							; ------------------------------------------------------------------------------
   1808  f490				   DeriveEnemyY
   1809  f490							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1810  f490							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1811  f490		       a5 b1		      lda	EnemyDataLo
   1812  f492		       85 e5		      sta	FetchPtr
   1813  f494		       a5 b2		      lda	EnemyDataHi
   1814  f496		       85 e6		      sta	FetchPtr+1
   1815  f498		       bc 77 f9 	      ldy	EnemyOffTable,X
   1816  f49b		       20 f6 fe 	      jsr	FoldIndirect	; type
   1817  f49e		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1818  f4a0							;   missed and a dir-left enemy fell through to
   1819  f4a0							;   .DEYStatic (no bob)
   1820  f4a0		       c9 01		      cmp	#ENEMY_BAT
   1821  f4a2		       f0 18		      beq	.DEYTickNoShift
   1822  f4a4		       c9 03		      cmp	#ENEMY_TENTACLE
   1823  f4a6		       f0 1a		      beq	.DEYTickShift
   1824  f4a8		       c9 00		      cmp	#ENEMY_SPIDER
   1825  f4aa		       f0 2e		      beq	.DEYSpiderTick
   1826  f4ac		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1827  f4ae		       d0 06		      bne	.DEYStatic
   1828  f4b0		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1829  f4b3		       4c cf f4 	      jmp	DEYDelta
   1830  f4b6				   .DEYStatic
   1831  f4b6		       c8		      iny
   1832  f4b7		       c8		      iny
   1833  f4b8		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1834  f4bb		       60		      rts
   1835  f4bc				   .DEYTickNoShift
   1836  f4bc		       a5 c2		      lda	EnemyRamP
   1837  f4be		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1838  f4bf		       4c c7 f4 	      jmp	.DEYBobTick
   1839  f4c2				   .DEYTickShift
   1840  f4c2		       a5 c2		      lda	EnemyRamP
   1841  f4c4		       4a		      lsr
   1842  f4c5		       4a		      lsr
   1843  f4c6		       4a		      lsr		; ÷8 gate
   1844  f4c7				   .DEYBobTick		; shared bob delta: triangle(p&3) = 0,1,2,1
   1845  f4c7		       29 03		      and	#3
