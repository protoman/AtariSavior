   2031  f5af		       d0 2a		      bne	.BTDone
   2032  f5b1		       a5 b5		      lda	BombPacked	; 1 → 2
   2033  f5b3		       29 fc		      and	#%11111100
   2034  f5b5		       09 02		      ora	#%00000010
   2035  f5b7		       85 b5		      sta	BombPacked
   2036  f5b9		       a9 3c		      lda	#60
   2037  f5bb		       85 f7		      sta	BombTimer
