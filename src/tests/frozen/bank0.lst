   3842  ffec							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   3843  ffec							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   3844  ffec							; ==============================================================================
   3845  ffec							; ==============================================================================
