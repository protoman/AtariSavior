   1736  f4db		       a5 a4		      lda	LevelMinerRoom
   1737  f4dd		       29 7f		      and	#$7f
   1738  f4df		       c5 98		      cmp	RoomNo
   1739  f4e1		       d0 1b		      bne	.CMPDone	; not in miner's room
   1740  f4e3							; X overlap: player [RoomX, +6] vs 4px miner.
   1741  f4e3							; Accept iff RoomX - MinerX in [-6, +3].
   1742  f4e3		       a5 80		      lda	RoomX
   1743  f4e5		       38		      sec
   1744  f4e6		       e5 a5		      sbc	MinerX
   1745  f4e8		       18		      clc
   1746  f4e9		       69 06		      adc	#PLAYER_WIDTH - 1
   1747  f4eb		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1748  f4ed		       b0 0f		      bcs	.CMPDone	; no X overlap
   1749  f4ef							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1750  f4ef							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1751  f4ef		       a5 81		      lda	RoomY
   1752  f4f1		       38		      sec
   1753  f4f2		       e5 a6		      sbc	MinerY
   1754  f4f4		       18		      clc
   1755  f4f5		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1756  f4f7		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1757  f4f9		       b0 03		      bcs	.CMPDone	; no Y overlap
