   4663  ff67		       c5 92		      cmp	RectCount
   4664  ff69		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   4665  ff6b		       4c 87 ff 	      jmp	.LaserInit
   4666  ff6e				   .LAdvCapL
   4667  ff6e		       a5 80		      lda	RoomX
   4668  ff70		       38		      sec
   4669  ff71		       e9 14		      sbc	#20
   4670  ff73		       b0 02		      bcs	.LAdvCapLs
   4671  ff75		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4672  ff77				   .LAdvCapLs
