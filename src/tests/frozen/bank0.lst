   2211  f669		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2212  f66b							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2213  f66b		       a5 b5		      lda	BombPacked
   2214  f66d		       29 03		      and	#%00000011
   2215  f66f		       c9 01		      cmp	#1
   2216  f671		       d0 1d		      bne	.SOCount
   2217  f673		       a5 f7		      lda	BombTimer
