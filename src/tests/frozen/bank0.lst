   3690  fedb							; BeamMask — per-scanline ENAM0 values for the in-window kernel path (S2.2).
   3691  fedb							; Indexed by Y = A0 = Scanline - RoomY, rows 0-11 only.
   3692  fedb							; Rows 2-3 = $02 (beam on: RoomY+2..RoomY+3 = eye rows — yellow face row 2 +
   3693  fedb							; red row 3 = two-tone beam; kept per user decision: single-red rows could
   3694  fedb							; not also reach floor-standing enemies without kill-window churn); rest $00.
   3695  fedb							; 2026-10-08 user directive: ONE strip, yellow — row 2 only ($02 at index 2),
   3696  fedb							; row 3 dropped. Kill window in LaserHitTestBody stays rows RoomY+2..3 = a
   3697  fedb							; superset of the 1-line draw (floor-standing reach preserved).
   3698  fedb							; Lives in the $FExx page: `lda BeamMask,Y` from .Line ($F1xx) fetches in
   3699  fedb							; 4c when operand+11 stays in-page (1c reclaim toward the ObjColorTab
   3700  fedb							; write; verify_build asserts the no-cross operand range).
   3701  fedb							; ------------------------------------------------------------------------------
   3702  fedb				   BeamMask
   3703  fedb		       00 00 02 00*	      .byte.b	0,0,2,0,0,0,0,0,0,0,0,0
   3704  fee7
   3705  fee7
   3706  fee7					      .ds	$FEE7 - *, 0	; bank0↔bank1 CallPad (leaf_move_plan Step 0)
