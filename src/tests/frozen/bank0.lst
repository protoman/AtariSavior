   3601  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3602  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3603  fd3a				   .TWselDone
   3604  fd3a							; --- RESET edge ---
   3605  fd3a		       a5 97		      lda	StepsLeft
   3606  fd3c		       29 01		      and	#%00000001
   3607  fd3e		       f0 14		      beq	.TWrstDone
   3608  fd40		       ad 82 02 	      lda	SWCHB
   3609  fd43		       29 01		      and	#%00000001
   3610  fd45		       d0 0d		      bne	.TWrstDone
   3611  fd47		       a9 00		      lda	#0
   3612  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3613  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3614  fd4d		       85 f4		      sta	ScoreHu
   3615  fd4f		       85 f5		      sta	ScoreTe
   3616  fd51		       20 20 fc 	      jsr	LoadLevel
   3617  fd54				   .TWrstDone
   3618  fd54		       ad 82 02 	      lda	SWCHB
