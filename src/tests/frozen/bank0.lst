   3592  fef3		       4c 10 f1 	      jmp	$F110	; bank2 MothRoutine (dead in bank0; guard pins
   3593  fef6							;   bank0/bank2 operands == bank2.lst label)
   3594  fef6					      .ds	$FEF6 - *, 0	; pin address (main size drift must not move it)
   3595  fef6				   FoldIndirect
