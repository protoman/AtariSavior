   3685  fda3							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3686  fda3							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3687  fda3							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3688  fda3							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3689  fda3							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3690  fda3							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3691  fda3							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3692  fda3							;   tools/test_cell_map.py).
   3693  fda3							;   (The standalone CellSolid leaf that lived here moved INTO
   3694  fda3							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3695  fda3							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3696  fda3							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3697  fda3							; ------------------------------------------------------------------------------
   3698  fda3		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3699  fdb7		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3700  fdc3		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
