   2380  f830							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2381  f830							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF7`
   2382  f830							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2383  f830							; not from here. That is the same FoldIndirect discipline every other tramp
   2384  f830							; uses — the twin cannot be skipped or shortened.
   2385  f830							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2386  f830		       00 00 00 00*	      .ds	$F8C0 - *, 0
   2387  f8c0				   CallPad_RaftBody
   2388  f8c0		       8d f7 1f 	      sta	$1FF7	; select bank1 (last byte fetched from bank0)
   2389  f8c3		       4c e3 fd 	      jmp	$FDE3	; bank1 RaftBody — returns via bank1's ReturnPad
   2390  f8c6
