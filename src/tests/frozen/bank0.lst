   2313  f7ca		       d0 2a		      bne	.BTDone
   2314  f7cc		       a5 b5		      lda	BombPacked	; 1 → 2
   2315  f7ce		       29 fc		      and	#%11111100
   2316  f7d0		       09 02		      ora	#%00000010
   2317  f7d2		       85 b5		      sta	BombPacked
