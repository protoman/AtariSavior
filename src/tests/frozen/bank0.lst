    838  f113				   .Line
    839  f113							; --- Player sprite: color for THIS line, graphics byte for NEXT line ---
    840  f113							; GRP0 written on line S displays on line S+1 (latched at the sprite's
    841  f113							; window start after the write) — index graphics with A0+1 ($ff wraps
    842  f113							; to 0 = row0 on the line before the sprite).
    843  f113							; Running-Y: Y = A0 = Scanline - RoomY is computed ONCE at kernel entry
    844  f113							; (sec/sbc RoomY/tay); .Line's iny advances it (Y = A0+1 after the
    845  f113							; graphics write = A0 of the next line). Nothing between rows may touch
    846  f113							; Y — the water-strip band-color read is an inlined `lda` (Y untouched).
    847  f113							; Cycle budget — MEASURED (sim_frame_budget, bugs.md #29 Class A):
    848  f113							; the old worst path (in-window color/beam/GRP0 + object in-range) was
    849  f113							; 78c: WSYNC write landed 2c into the next line -> full-line stall ->
    850  f113							; +1 scanline on every frame whose object window overlapped the A0=11
    851  f113							; line (24 stalls in the SIM_LEVEL=2 window, always even frames —
    852  f113							; SelectActiveObject parity rotation). Root fix: the color/beam gate
    853  f113							; below stops at A0=10; row 11 inherits row 10's COLUP0/ENAM0 writes
    854  f113							; (PlayerColTable [10]==[11], verify_build asserts) because
    855  f113							; GRP0 row11 is fetched on line A0=10 already ("row11 shows via
    856  f113							; line10"). Worst path measured 2026-10-15 (vcrunch jitter hunt):
    857  f113							; in-window color/beam/GRP0 + object in-range = 69c between WSs,
    858  f113							; start-to-start d=72 — was 73/76 (= stall zone 74-76, whole-screen
    859  f113							; +1-line jitter) until the dead `cpy #12 / bcs .GrpZero` (4c, never
    860  f113							; taken on the A0<=10 color path) moved to .GrpSkip. Budget: work
    861  f113							; <= 70c / d <= 73 — a 74-76 segment stalls a full scanline.
    862  f113							; ObjSprites+71 must stay in the $FExx page (else lda ObjSprites,X
    863  f113							; page-crosses, +1c on the GRP1 fetch) — verify_build enforces this.
    864  f113							; Branch targets all same-page (3c taken) and PlayerColTable in $F8xx
    865  f113							; (verify_build guards the A0=10 page-cross budget).
    866  f113							; GRP1 object section clobbers X (ObjSprites index) — row counter lives in
    867  f113							; RowIdx and X is reloaded after bne. Row-advance +6c on the .Row setup
    868  f113							; scanline (segment 63c -> 69c <= 76c): frame length unchanged.
    869  f113							; The old Scanline/sec/sbc/tay prefix cost 10c more (body 66c -> WSYNC
    870  f113							; write on cycle 76 = one cycle late): WSYNC stalled a full line per
    871  f113							; overlapping scanline — stretched cave row, HUD pushed down, and with
    872  f113							; GRP1 flicker rotation the frame length alternated (one-tile oscillation).
    873  f113							; Keep the hot path at <= 70c work: an overrun duplicates the scanline.
    874  f113		       c0 0b		      cpy	#PLAYER_SPRITE_H - 1
    875  f115		       b0 3d		      bcs	.GrpSkip	; A0 >= 11 (incl $ff): no color/beam this line.
    876  f117							; A0=11 skips too (Class-A stall line): rows
    877  f117							; 10/11 share color+beam bytes, so row 10's
    878  f117							; writes are still in effect here.
    879  f117							; --- Laser S2.2: ENAM0 = PlayerColTable bit1 & LaserState.b1 ----------
    880  f117							; Phase 0 (2026-10-21): the retired BeamMask table duplicated bit 1 of
    881  f117							; PlayerColTable for a separate 4c fetch. One yellow strip on RoomY+2
    882  f117							; only (user directive 2026-10-08: the red row-3 strip is gone; the kill
    883  f117							; window in LaserHitTestBody keeps rows RoomY+2..3 = superset of the
    884  f117							; draw). In-window path only (Y<=11), so outside the window ENAM0 keeps
    885  f117							; its last write ($00 at A0=10) — no HUD artifact. verify_build asserts
    886  f117							; bit1 is set at index 2 and nowhere else, and that rows 10/11 stay equal
    887  f117							; (the A0=11 gate skip inherits row 10's writes).
    888  f117		       b9 f5 f8 	      lda	PlayerColTable,Y	; 4c — per-row color; bit 1 = ENAM0 enable
    889  f11a		       85 06		      sta	COLUP0	; applies to this line (colour bit0 = don't-care)
    890  f11c		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
    891  f11e		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
    892  f120		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
    893  f121							;   Color/beam gate entered only with A0<=10
    894  f121							;   -> after iny Y<=11: always fetchable, so
    895  f121							;   the old `cpy #PLAYER_SPRITE_H / bcs
    896  f121							;   .GrpZero` here was DEAD 4c on the worst
    897  f121							;   path (2+2, never taken — A0=11+ never
    898  f121							;   reaches it, it goes to bcs .GrpSkip).
    899  f121		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
    900  f123		       85 1b		      sta	GRP0
