   1855  f5c5							; ==============================================================================
   1856  f5c5							; Miner pickup — check if player overlaps miner, advance to next level
   1857  f5c5							; ==============================================================================
   1858  f5c5				   CheckMinerPickup
   1859  f5c5		       a5 a4		      lda	LevelMinerRoom
   1860  f5c7		       29 7f		      and	#$7f
   1861  f5c9		       c5 98		      cmp	RoomNo
   1862  f5cb		       d0 1b		      bne	.CMPDone	; not in miner's room
   1863  f5cd							; X overlap: player [RoomX, +6] vs 4px miner.
   1864  f5cd							; Accept iff RoomX - MinerX in [-6, +3].
   1865  f5cd		       a5 80		      lda	RoomX
   1866  f5cf		       38		      sec
   1867  f5d0		       e5 a5		      sbc	MinerX
   1868  f5d2		       18		      clc
   1869  f5d3		       69 06		      adc	#PLAYER_WIDTH - 1
   1870  f5d5		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1871  f5d7		       b0 0f		      bcs	.CMPDone	; no X overlap
   1872  f5d9							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1873  f5d9							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1874  f5d9		       a5 81		      lda	RoomY
   1875  f5db		       38		      sec
   1876  f5dc		       e5 a6		      sbc	MinerY
   1877  f5de		       18		      clc
   1878  f5df		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1879  f5e1		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1880  f5e3		       b0 03		      bcs	.CMPDone	; no Y overlap
