   3810  fd36							; ------------------------------------------------------------------------------
   3811  fd36							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3812  fd36							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3813  fd36							; selected level number (digits band) and the credits; the theme plays here.
   3814  fd36							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3815  fd36							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3816  fd36							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3817  fd36							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3818  fd36							;	    the intro exit ate the first press and made #2 read as dead)
   3819  fd36							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3820  fd36							;	    the real drop-in → gameplay starts
   3821  fd36							; ($FD reaches here directly — merged title, 2026-10-19.)
   3822  fd36							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3823  fd36							; title-owned; the first play frame rewrites it as the step budget).
   3824  fd36							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3825  fd36							; ------------------------------------------------------------------------------
   3826  fd36				   TitleWork
   3827  fd36							; --- SELECT edge (TitleSelect, fill region) ---
   3828  fd36		       20 4f fc 	      jsr	CallPad_TitleSelect
   3829  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   3830  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3831  fd3e				   .TWselDone
   3832  fd3e							; --- RESET edge ---
   3833  fd3e		       a5 97		      lda	StepsLeft
   3834  fd40		       29 01		      and	#%00000001
   3835  fd42		       f0 14		      beq	.TWrstDone
   3836  fd44		       ad 82 02 	      lda	SWCHB
   3837  fd47		       29 01		      and	#%00000001
   3838  fd49		       d0 0d		      bne	.TWrstDone
   3839  fd4b		       a9 00		      lda	#0
   3840  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3841  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3842  fd51		       85 f4		      sta	ScoreHu
   3843  fd53		       85 f5		      sta	ScoreTe
   3844  fd55		       20 20 fc 	      jsr	LoadLevel
   3845  fd58				   .TWrstDone
   3846  fd58		       ad 82 02 	      lda	SWCHB
   3847  fd5b		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3848  fd5d							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3849  fd5d							;     channel force-muted here — UpdateJetSound is skipped because
   3850  fd5d							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3851  fd5d							;     = 0, AUDV0 covered above). ---
   3852  fd5d				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3853  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3854  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3855  fd61		       f0 0e		      beq	.TWmusic
   3856  fd63		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3857  fd65		       20 94 f5 	      jsr	BombTick
   3858  fd68				   .TWnoTick
   3859  fd68		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3860  fd6b		       a9 00		      lda	#0
   3861  fd6d		       85 1a		      sta	AUDV1
   3862  fd6f		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3863  fd71				   .TWmusic		; title: music wins the audio regs
   3864  fd71		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3865  fd74				   .TWwait
   3866  fd74		       ad 84 02 	      lda	INTIM
   3867  fd77		       d0 fb		      bne	.TWwait
   3868  fd79		       4c 39 f0 	      jmp	StartFrame
   3869  fd7c
   3870  fd7c							; ------------------------------------------------------------------------------
   3871  fd7c							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3872  fd7c							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3873  fd7c							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3874  fd7c							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3875  fd7c							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3876  fd7c							; DeriveEnemyY — no persistent movement state exists in RAM.
   3877  fd7c							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3878  fd7c							; block after the pads; pre-pad headroom is 1B).
   3879  fd7c							; ------------------------------------------------------------------------------
   3880  fd7c				   RefreshEnemyY
   3881  fd7c
   3882  fd7c		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3883  fd7e							; TickCounter is the 60-frame GAME timer
   3884  fd7e							; (decrements 60->1, reloads) — gates derived
   3885  fd7e							; from it wrapped every second (spider
   3886  fd7e							; "teleported": (TC>>3)&63 only ever saw
   3887  fd7e							; 0..7 and counted DOWN 0->7 = jump).
   3888  fd7e		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3889  fd80		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3890  fd82				   .REYLoop		; every reader runs after refresh completes)
   3891  fd82		       ca		      dex
   3892  fd83		       20 90 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3893  fd86		       95 e2		      sta	EnemyRamY,X
   3894  fd88		       8a		      txa		; N/Z must come from X: flags after jsr are
   3895  fd89		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3896  fd8b				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3897  fd8b							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3898  fd8b							; black rooms, broken PF, invisible sprites)
   3899  fd8b							; --- SELECT or RESET held → back to the old title / level-select screen
   3900  fd8b							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3901  fd8b							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3902  fd8b							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3903  fd8b							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3904  fd8b							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3905  fd8b							;     RESET held past LANDING still re-fires — press must be released
   3906  fd8b							;     before the drop-in finishes. ---
   3907  fd8b		       a5 8a		      lda	DropTarget
   3908  fd8d		       d0 1d		      bne	.REYRts	; not idle: not ours
   3909  fd8f		       ad 82 02 	      lda	SWCHB
   3910  fd92		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3911  fd94		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3912  fd96		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3913  fd98		       f0 12		      beq	.REYRts	; neither pressed
   3914  fd9a		       a9 ff		      lda	#$FF
   3915  fd9c		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3916  fd9e		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   3917  fda0		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   3918  fda2		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   3919  fda4							;   game must clear them for a clean melody
   3920  fda4		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3921  fda7		       68		      pla		; drop OUR return address (LoadLevel already
   3922  fda8		       68		      pla		;   popped its own) — tail into TitleWork
   3923  fda9		       4c 36 fd 	      jmp	TitleWork
   3924  fdac				   .REYRts
   3925  fdac		       60		      rts
