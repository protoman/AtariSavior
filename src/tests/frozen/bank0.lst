   3351  fd9c							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3352  fd9c							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3353  fd9c							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3354  fd9c							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3355  fd9c							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3356  fd9c							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3357  fd9c							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3358  fd9c							;   tools/test_cell_map.py).
   3359  fd9c							;   (The standalone CellSolid leaf that lived here moved INTO
   3360  fd9c							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3361  fd9c							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3362  fd9c							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3363  fd9c							; ------------------------------------------------------------------------------
   3364  fd9c		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3365  fdb0		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3366  fdbc		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
