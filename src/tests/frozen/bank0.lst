   2043  f588							; BombTick — per-frame state machine (overscan).
   2044  f588							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2045  f588							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2046  f588							; ------------------------------------------------------------------------------
   2047  f588				   BombTick   subroutine
   2048  f588		       a5 b5		      lda	BombPacked
   2049  f58a		       29 03		      and	#%00000011	; state
   2050  f58c		       f0 41		      beq	.BTDone	; none
   2051  f58e		       c9 01		      cmp	#1
   2052  f590		       f0 0f		      beq	.BTFuse
