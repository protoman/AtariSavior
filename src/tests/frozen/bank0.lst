   1210  f28d
   1211  f28d							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1212  f28d							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1213  f28d							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1214  f28d							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1215  f28d							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1216  f28d							;     resumes (he lifts off). No Up -> hovers in place.
   1217  f28d				   .Integrate
   1218  f28d		       a5 9c		      lda	Hover
   1219  f28f		       f0 13		      beq	.DoInt
   1220  f291		       a5 96		      lda	JetPower
   1221  f293		       c9 09		      cmp	#GRAVITY + 1
   1222  f295		       b0 09		      bcs	.HoverEnd
   1223  f297		       a9 00		      lda	#0
   1224  f299		       85 93		      sta	vyLo
   1225  f29b		       85 94		      sta	vyHi
   1226  f29d		       4c a4 f2 	      jmp	.DoInt
   1227  f2a0				   .HoverEnd
   1228  f2a0		       a9 00		      lda	#0
   1229  f2a2		       85 9c		      sta	Hover
   1230  f2a4				   .DoInt
   1231  f2a4		       18		      clc
   1232  f2a5		       a5 95		      lda	PlayerYSub
   1233  f2a7		       65 93		      adc	vyLo
   1234  f2a9		       85 95		      sta	PlayerYSub
   1235  f2ab		       a9 00		      lda	#0
   1236  f2ad		       65 94		      adc	vyHi
   1237  f2af		       f0 1c		      beq	.NoVMove
   1238  f2b1		       30 0c		      bmi	.UpSteps
   1239  f2b3		       85 97		      sta	StepsLeft	; positive = falling (down)
   1240  f2b5				   .JFalling
   1241  f2b5		       20 55 f3 	      jsr	StepDown
   1242  f2b8		       c6 97		      dec	StepsLeft
