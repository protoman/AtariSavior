    901  f0f7							; --- Phase 5: is the second GRP1 object in THIS band? ---------------
    902  f0f7							; Sits in the setup window's free tail (~59c after PF2, before the WSYNC
    903  f0f7							; that ends the pass, so the phased stores above never move). The early
    904  f0f7							; out costs 5c; Slot1Hook pays 2 extra lines ONLY on the band that hosts
    905  f0f7							; slot 1 (SetObjectXPos WSYNC line + the HMOVE line).
    906  f0f7		       a5 ea		      lda	ObjBase1	; $FF = none. `bmi` is still valid HERE (slot 1
    907  f0f9		       30 03		      bmi	Slot1Keep	;   only holds an enemy design or the miner,
    908  f0fb							;   all < $80; the bomb never reaches slot 1).
    909  f0fb							;   Slot 0 must use `cmp #$FF` — see .SODone.
    910  f0fb		       4c 65 f7 	      jmp	Slot1Hook	; NOT jsr: when the hook positions P1 it owns
