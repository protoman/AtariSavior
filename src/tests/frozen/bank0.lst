   3909  fd36							; ------------------------------------------------------------------------------
   3910  fd36							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3911  fd36							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3912  fd36							; selected level number (digits band) and the credits; the theme plays here.
   3913  fd36							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3914  fd36							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3915  fd36							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3916  fd36							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3917  fd36							;	    the intro exit ate the first press and made #2 read as dead)
   3918  fd36							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3919  fd36							;	    the real drop-in → gameplay starts
   3920  fd36							; ($FD reaches here directly — merged title, 2026-10-19.)
   3921  fd36							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3922  fd36							; title-owned; the first play frame rewrites it as the step budget).
   3923  fd36							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3924  fd36							; ------------------------------------------------------------------------------
   3925  fd36				   TitleWork
   3926  fd36							; --- SELECT edge (TitleSelect, fill region) ---
   3927  fd36		       20 4f fc 	      jsr	CallPad_TitleSelect
   3928  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   3929  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3930  fd3e				   .TWselDone
   3931  fd3e							; --- RESET edge ---
   3932  fd3e		       a5 97		      lda	StepsLeft
   3933  fd40		       29 01		      and	#%00000001
   3934  fd42		       f0 14		      beq	.TWrstDone
   3935  fd44		       ad 82 02 	      lda	SWCHB
   3936  fd47		       29 01		      and	#%00000001
   3937  fd49		       d0 0d		      bne	.TWrstDone
   3938  fd4b		       a9 00		      lda	#0
   3939  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3940  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3941  fd51		       85 f4		      sta	ScoreHu
   3942  fd53		       85 f5		      sta	ScoreTe
   3943  fd55		       20 20 fc 	      jsr	LoadLevel
   3944  fd58				   .TWrstDone
   3945  fd58		       ad 82 02 	      lda	SWCHB
   3946  fd5b		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3947  fd5d							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3948  fd5d							;     channel force-muted here — UpdateJetSound is skipped because
   3949  fd5d							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3950  fd5d							;     = 0, AUDV0 covered above). ---
   3951  fd5d				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3952  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3953  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3954  fd61		       f0 0e		      beq	.TWmusic
   3955  fd63		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3956  fd65		       20 94 f5 	      jsr	BombTick
   3957  fd68				   .TWnoTick
   3958  fd68		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3959  fd6b		       a9 00		      lda	#0
   3960  fd6d		       85 1a		      sta	AUDV1
   3961  fd6f		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3962  fd71				   .TWmusic		; title: music wins the audio regs
   3963  fd71		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3964  fd74				   .TWwait
   3965  fd74		       ad 84 02 	      lda	INTIM
   3966  fd77		       d0 fb		      bne	.TWwait
   3967  fd79		       4c 39 f0 	      jmp	StartFrame
