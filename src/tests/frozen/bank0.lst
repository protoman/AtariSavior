   1464  f3d8		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1465  f3da		       d0 3e		      bne	UE_Next
   1466  f3dc							; live dir bit: 1 = right, 0 = left
   1467  f3dc		       bd ac f3 	      lda	EnemyBitTable,X
   1468  f3df		       25 c1		      and	EnemyRamD
   1469  f3e1		       d0 1d		      bne	UE_SnakeRight
