   1189  f23c		       85 96		      sta	JetPower
   1190  f23e		       4c 6d f2 	      jmp	.Gravity
   1191  f241				   .JetDecay		; Up NOT held this frame
   1192  f241		       a5 96		      lda	JetPower
   1193  f243		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1194  f245		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1195  f247		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1196  f249		       05 93		      ora	vyLo
   1197  f24b		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1198  f24d							;   climb to stop, do NOT float
   1199  f24d		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1200  f24f		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1201  f251		       4c 6d f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1202  f254				   .FloatRun
   1203  f254		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1204  f256		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1205  f258		       29 7f		      and	#$7F
