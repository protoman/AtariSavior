   3615  fd03				   DropStep
   3616  fd03		       a5 8a		      lda	DropTarget
   3617  fd05		       f0 28		      beq	.DSdone	; idle (target 0 = nothing to fall)
   3618  fd07		       c9 ff		      cmp	#$FF
   3619  fd09		       f0 27		      beq	TitleWork	; merged title = stage preview + level select
   3620  fd0b		       c9 fe		      cmp	#$FE
   3621  fd0d		       d0 03		      bne	.DSfall
   3622  fd0f		       4c 9c fe 	      jmp	TallyWork	; level-bonus tally sentinel (bank2 step)
   3623  fd12				   .DSfall
