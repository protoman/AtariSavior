   3655  ff81		       a5 80		      lda	RoomX
   3656  ff83		       38		      sec
   3657  ff84		       e9 14		      sbc	#20
   3658  ff86		       b0 02		      bcs	.LAdvCapLs
   3659  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
