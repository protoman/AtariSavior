   3800  fdde							; PlayerWalkA/B — dedicated ground-walk frames (sprites.png 2026-10-03,
   3801  fdde							; extracted pixel-exact; torso rows 0-6 identical to the jet pair).
   3802  fdde							;   A = boots apart (stride, rows 10-11 spread to cols 2+6 / 1+6)
   3803  fdde							;   B = boots together (passing pose, rows 10-11 = cols 3+4)
   3804  fdde							; Legs rows 7-9 identical in both — only the boots move. Standing forces
   3805  fdde							; PlayerSpriteA; walk cycle alternates A<->B every 8 frames (EnemyRamP&$08,
   3806  fdde							; 16-frame full cycle) while grounded + L/R held.
   3807  fdde							; ------------------------------------------------------------------------------
   3808  fdde				   PlayerWalkA
   3809  fdde		       3c		      .byte.b	%00111100	; row 0 torso (sprites.png 2026-10-03)
   3810  fddf		       7e		      .byte.b	%01111110	; row 1
   3811  fde0		       7c		      .byte.b	%01111100	; row 2 — yellow face
   3812  fde1		       7e		      .byte.b	%01111110	; row 3
   3813  fde2		       7c		      .byte.b	%01111100	; row 4 — grey pack
   3814  fde3		       fe		      .byte.b	%11111110	; row 5
   3815  fde4		       fe		      .byte.b	%11111110	; row 6
   3816  fde5		       3e		      .byte.b	%00111110	; row 7  legs
   3817  fde6		       3e		      .byte.b	%00111110	; row 8
   3818  fde7		       14		      .byte.b	%00010100	; row 9
   3819  fde8		       22		      .byte.b	%00100010	; row 10 boots apart (spread)
   3820  fde9		       42		      .byte.b	%01000010	; row 11 boots apart
