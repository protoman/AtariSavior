   2554  f928		       4a		      lsr
   2555  f929		       4a		      lsr		; A = scanline >> 2
   2556  f92a		       a8		      tay
   2557  f92b		       b9 01 f9 	      lda	YToRowTable,Y
   2558  f92e		       85 8d		      sta	CollisionCellY	; top tile row
   2559  f930		       18		      clc
   2560  f931		       a5 81		      lda	RoomY
   2561  f933		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   2562  f935		       4a		      lsr
   2563  f936		       4a		      lsr
   2564  f937		       a8		      tay
   2565  f938		       b9 01 f9 	      lda	YToRowTable,Y
   2566  f93b		       85 8f		      sta	CollisionEndY	; bottom tile row
