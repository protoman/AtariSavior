   1497  f3c6							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1498  f3c6							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1499  f3c6							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1500  f3c6							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1501  f3c6							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1502  f3c6							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1503  f3c6							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1504  f3c6							; so the first move is the retreat into its wall. Ignores editor range_* per
   1505  f3c6							; user 2026-09-23. No wall collision.
   1506  f3c6							; ------------------------------------------------------------------------------
   1507  f3c6				   UpdateEnemies
   1508  f3c6		       a5 b3		      lda	EnemyCount
   1509  f3c8		       d0 01		      bne	UE_Start
   1510  f3ca		       60		      rts
   1511  f3cb				   UE_Start
   1512  f3cb							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1513  f3cb							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1514  f3cb		       a5 b1		      lda	EnemyDataLo
   1515  f3cd		       85 e5		      sta	FetchPtr
   1516  f3cf		       a5 b2		      lda	EnemyDataHi
   1517  f3d1		       85 e6		      sta	FetchPtr+1
   1518  f3d3		       a2 00		      ldx	#0
   1519  f3d5				   UE_Loop
   1520  f3d5		       e4 b3		      cpx	EnemyCount
   1521  f3d7		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1522  f3d9		       4c 34 f4 	      jmp	UE_Exit
   1523  f3dc				   UE_Alive
   1524  f3dc		       a5 ba		      lda	EnemyDeadMask
   1525  f3de		       3d c2 f3 	      and	EnemyBitTable,X
   1526  f3e1		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1527  f3e3		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1528  f3e6		       20 f6 fe 	      jsr	FoldIndirect	; type|dir (UEDispatch masks b7)
   1529  f3e9		       4c 05 f6 	      jmp	UEDispatch	; UEDispatch replaces the old
   1530  f3ec							; 18 B per-type compare chain with one 3 B jmp:
   1531  f3ec							; frees 15 B of pre-pad headroom and gives the
   1532  f3ec							; type tables room for the raft byte.
   1533  f3ec				   UE_SnakeBody
   1534  f3ec		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1535  f3ee		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1536  f3f0		       d0 3e		      bne	UE_Next
   1537  f3f2							; live dir bit: 1 = right, 0 = left
   1538  f3f2		       bd c2 f3 	      lda	EnemyBitTable,X
   1539  f3f5		       25 c1		      and	EnemyRamD
   1540  f3f7		       d0 1d		      bne	UE_SnakeRight
