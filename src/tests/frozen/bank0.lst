   4027  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   4028  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   4029  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   4030  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   4031  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   4032  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   4033  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   4034  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   4035  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   4036  fe9c							; ------------------------------------------------------------------------------
   4037  fe9c				   TallyWork
   4038  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   4039  fe9f		       a8		      tay
   4040  fea0		       29 01		      and	#1
   4041  fea2		       f0 05		      beq	.TNoScore
   4042  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4043  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4044  fea9				   .TNoScore
   4045  fea9		       98		      tya
   4046  feaa		       29 04		      and	#4
   4047  feac		       f0 1e		      beq	.TLive
   4048  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4049  feb0		       a5 a3		      lda	Level
   4050  feb2		       c9 04		      cmp	#LEVEL_COUNT
   4051  feb4		       d0 04		      bne	.TNotWrap
   4052  feb6		       a9 00		      lda	#0	; wrap past last level
   4053  feb8		       85 a3		      sta	Level
   4054  feba				   .TNotWrap
   4055  feba		       a9 00		      lda	#0
   4056  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4057  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4058  febe							;   pose ($FE must take the real-fall path)
   4059  febe		       20 20 fc 	      jsr	LoadLevel
   4060  fec1		       a9 78		      lda	#120	; reset timer for new level
   4061  fec3		       85 ae		      sta	BarLevel
   4062  fec5		       a9 3c		      lda	#60
   4063  fec7		       85 ad		      sta	TickCounter
   4064  fec9		       4c 39 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4065  fecc				   .TLive
   4066  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   4067  fecf		       a9 00		      lda	#0
   4068  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   4069  fed3				   .TWait
   4070  fed3		       ad 84 02 	      lda	INTIM
   4071  fed6		       d0 fb		      bne	.TWait
   4072  fed8		       4c 39 f0 	      jmp	StartFrame
