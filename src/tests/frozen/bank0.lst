   2182  f606		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2183  f608							;   the single type-compare entry. 2026-10-22:
   2184  f608							;   a raft authored dir=right read $87, missed
   2185  f608							;   `cmp #ENEMY_RAFT` and its body never ran
   2186  f608							;   (no tide, no motion, no rider pin).
