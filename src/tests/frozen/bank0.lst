   3760  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3761  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3762  fdde							;   span)
   3763  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3764  fdde							;   latch + feature gate pushed +14; same day
   3765  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3766  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3767  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3768  fdde							;   garbage path's `inc $4A,X` set wall bits
   3769  fdde							;   via $CA)
