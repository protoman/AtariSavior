   3625  fd13		       4a		      lsr
   3626  fd14		       4a		      lsr
   3627  fd15		       4a		      lsr
   3628  fd16		       a8		      tay
   3629  fd17		       b9 e9 f9 	      lda	DropSpeedTable,y
   3630  fd1a		       18		      clc
   3631  fd1b		       65 95		      adc	PlayerYSub
   3632  fd1d		       85 95		      sta	PlayerYSub
   3633  fd1f		       90 0e		      bcc	.DSdone	; subpixel: no whole pixel yet this frame
   3634  fd21		       e6 81		      inc	RoomY
   3635  fd23		       a5 81		      lda	RoomY
   3636  fd25		       c5 8a		      cmp	DropTarget
   3637  fd27		       90 06		      bcc	.DSdone
   3638  fd29		       a9 00		      lda	#0
   3639  fd2b		       85 8a		      sta	DropTarget	; arrived — input/physics resume next frame
   3640  fd2d		       85 96		      sta	JetPower	; clean resume (no phantom thrust hop)
   3641  fd2f				   .DSdone
