   1149  f212							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1150  f212							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1151  f212							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1152  f212							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1153  f212							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1154  f212							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1155  f212							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1156  f212							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1157  f212							;	   1.0s hover was too long — halved); then the flag clears and
   1158  f212							;	   normal gravity resumes (fall ~0.85s after release). State
   1159  f212							;	   lives in JetPower, NOT
   1160  f212							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1161  f212							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1162  f212							;	   rising frame — both clobbered a StepsLeft-based float.
   1163  f212							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1164  f212							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1165  f212							;	   (headroom stays $FC67).
   1166  f212							; ------------------------------------------------------------------------------
   1167  f212		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1168  f214		       24 88		      bit	Temp
   1169  f216		       d0 21		      bne	.JetDecay
   1170  f218		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1171  f21a		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1172  f21c		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1173  f21e		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1174  f220				   .RampStart
   1175  f220		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1176  f222		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1177  f224		       d0 3f		      bne	.Gravity
   1178  f226		       a5 96		      lda	JetPower
   1179  f228		       c9 14		      cmp	#JET_MAX
   1180  f22a		       b0 06		      bcs	.JetCapped
   1181  f22c		       18		      clc
