   2783  f9ba		       f0 03		      beq	.OTsym	; sym: clc/rts, never enters the cluster
   2784  f9bc		       4c 2d fa 	      jmp	PHMOverlay	; bank0 cluster ($FA30; repack chunk 4)
   2785  f9bf				   .OTsym
