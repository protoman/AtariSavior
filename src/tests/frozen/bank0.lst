   2114  f5d6		       a5 8a		      lda	DropTarget
   2115  f5d8		       d0 1b		      bne	.BPBMiss	; spawn drop-in: falling = invulnerable
   2116  f5da		       a5 f6		      lda	BombX
   2117  f5dc		       4a		      lsr
   2118  f5dd		       4a		      lsr		; bomb col = BombX/4
   2119  f5de		       85 88		      sta	Temp
   2120  f5e0		       a5 80		      lda	RoomX
   2121  f5e2		       4a		      lsr
   2122  f5e3		       4a		      lsr		; player col = RoomX/4
   2123  f5e4		       38		      sec
   2124  f5e5		       e5 88		      sbc	Temp
   2125  f5e7		       b0 05		      bcs	.BPBColAbs
   2126  f5e9		       49 ff		      eor	#$ff
   2127  f5eb		       18		      clc
   2128  f5ec		       69 01		      adc	#1
   2129  f5ee				   .BPBColAbs
   2130  f5ee		       c9 02		      cmp	#2	; |dcol| < 2 → any Y kills
   2131  f5f0		       b0 03		      bcs	.BPBMiss
   2132  f5f2		       4c 80 fc 	      jmp	LoseLife	; shared life path (tail: rts to caller)
   2133  f5f5				   .BPBMiss
