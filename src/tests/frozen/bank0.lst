   3544  fd3e		       f0 14		      beq	.TWrstDone
   3545  fd40		       ad 82 02 	      lda	SWCHB
   3546  fd43		       29 01		      and	#%00000001
   3547  fd45		       d0 0d		      bne	.TWrstDone
   3548  fd47		       a9 00		      lda	#0
   3549  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3550  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3551  fd4d		       85 f4		      sta	ScoreHu
   3552  fd4f		       85 f5		      sta	ScoreTe
