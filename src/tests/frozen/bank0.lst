   1816  f491							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1817  f491							; there is no free ZP byte for per-slot movement state (phase/direction live
   1818  f491							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1819  f491							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1820  f491							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1821  f491							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1822  f491							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1823  f491							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1824  f491							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1825  f491							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1826  f491							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1827  f491							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1828  f491							;	    the 60-frame game timer — gates from it wrap every second).
   1829  f491							; Other types: straight ROM y (their movement stages come later).
   1830  f491							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1831  f491							; ------------------------------------------------------------------------------
   1832  f491				   DeriveEnemyY
   1833  f491							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1834  f491							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1835  f491		       a5 b1		      lda	EnemyDataLo
   1836  f493		       85 e5		      sta	FetchPtr
   1837  f495		       a5 b2		      lda	EnemyDataHi
   1838  f497		       85 e6		      sta	FetchPtr+1
   1839  f499		       bc 77 f9 	      ldy	EnemyOffTable,X
   1840  f49c		       20 f6 fe 	      jsr	FoldIndirect	; type
   1841  f49f		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1842  f4a1							;   missed and a dir-left enemy fell through to
   1843  f4a1							;   .DEYStatic (no bob)
   1844  f4a1		       c9 01		      cmp	#ENEMY_BAT
   1845  f4a3		       f0 18		      beq	.DEYTickNoShift
   1846  f4a5		       c9 03		      cmp	#ENEMY_TENTACLE
   1847  f4a7		       f0 1a		      beq	.DEYTickShift
   1848  f4a9		       c9 00		      cmp	#ENEMY_SPIDER
   1849  f4ab		       f0 2e		      beq	.DEYSpiderTick
   1850  f4ad		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1851  f4af		       d0 06		      bne	.DEYStatic
   1852  f4b1		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1853  f4b4		       4c d0 f4 	      jmp	DEYDelta
   1854  f4b7				   .DEYStatic
   1855  f4b7		       c8		      iny
   1856  f4b8		       c8		      iny
   1857  f4b9		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1858  f4bc		       60		      rts
   1859  f4bd				   .DEYTickNoShift
   1860  f4bd		       a5 d7		      lda	EnemyClk
   1861  f4bf		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1862  f4c0		       4c c8 f4 	      jmp	.DEYBobTick
   1863  f4c3				   .DEYTickShift
