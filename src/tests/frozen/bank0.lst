   3869  fcaf							; ------------------------------------------------------------------------------
   3870  fcaf							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3871  fcaf							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3872  fcaf							; caller; Y is animated from the screen top down to it).
   3873  fcaf							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3874  fcaf							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3875  fcaf							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3876  fcaf							;
   3877  fcaf							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3878  fcaf							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3879  fcaf							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3880  fcaf							;
   3881  fcaf							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3882  fcaf							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3883  fcaf							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3884  fcaf							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3885  fcaf							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3886  fcaf							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3887  fcaf							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3888  fcaf							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3889  fcaf							; ------------------------------------------------------------------------------
   3890  fcaf				   DropArm
   3891  fcaf		       a5 8a		      lda	DropTarget
   3892  fcb1		       c9 fd		      cmp	#$FD
   3893  fcb3		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3894  fcb5							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3895  fcb5							;   tally cleared to 0 by TallyWork before its
   3896  fcb5							;   LoadLevel — same-size swap 2026-10-06)
   3897  fcb5		       a5 81		      lda	RoomY
   3898  fcb7		       85 8a		      sta	DropTarget
   3899  fcb9		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3900  fcbb		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3901  fcbd		       a9 00		      lda	#0
   3902  fcbf		       85 81		      sta	RoomY
   3903  fcc1		       85 95		      sta	PlayerYSub
   3904  fcc3		       85 93		      sta	vyLo
   3905  fcc5		       85 94		      sta	vyHi
   3906  fcc7		       a5 c0		      lda	LaserState
   3907  fcc9		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3908  fccb		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3909  fccd		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3910  fccf		       85 83		      sta	LaserX
   3911  fcd1		       18		      clc
   3912  fcd2		       60		      rts
