   2552  f901							; --- Level data ---
   2553  f901							; Generated from level JSON via tools/convert_level.py.
   2554  f901							; Do not edit by hand — regenerate with build.sh.
   2555  f901							; NOTE: data payload moved to bank2 (level_bank_plan P2, frozen addresses
   2556  f901							; $F9D9-$FB1E); pointer values are unchanged. kernel keeps only the EQUs
   2557  f901							; it consumes (LEVEL_COUNT) — sync asserted by test_level_bank.py.
   2558  f901
   2559  f901							; --- Level constants ---
   2560  f901		       00 00	   ENEMY_SPIDER =	0
   2561  f901		       00 01	   ENEMY_BAT  =	1
   2562  f901		       00 02	   ENEMY_SNAKE =	2
   2563  f901		       00 03	   ENEMY_TENTACLE =	3
   2564  f901		       00 04	   ENEMY_MOTH =	4
   2565  f901		       00 05	   LAMP       =	5	; type-5 enemy record = editor lamp (white square)
   2566  f901		       00 06	   KEY	      =	6	; type-6 enemy record = editor key (Phase 5 pickup)
   2567  f901		       00 07	   ENEMY_RAFT =	7	; type-7 enemy record = the moving, rideable raft
   2568  f901							; (plans/raft_moving_plan.md): floats on the open
   2569  f901							; water of model row 2, carries the player and
   2570  f901							; returns; body lives in bank1 (RaftBody)
