   4111  ff7e		       4c 9a ff 	      jmp	.LaserInit
   4112  ff81				   .LAdvCapL
   4113  ff81		       a5 80		      lda	RoomX
   4114  ff83		       38		      sec
   4115  ff84		       e9 14		      sbc	#20
   4116  ff86		       b0 02		      bcs	.LAdvCapLs
   4117  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4118  ff8a				   .LAdvCapLs
