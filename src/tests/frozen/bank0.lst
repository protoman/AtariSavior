   1661  f489							; ------------------------------------------------------------------------------
   1662  f489							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1663  f489							; there is no free ZP byte for per-slot movement state (phase/direction live
   1664  f489							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1665  f489							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1666  f489							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1667  f489							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1668  f489							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1669  f489							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1670  f489							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1671  f489							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1672  f489							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1673  f489							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1674  f489							;	    the 60-frame game timer — gates from it wrap every second).
   1675  f489							; Other types: straight ROM y (their movement stages come later).
   1676  f489							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1677  f489							; ------------------------------------------------------------------------------
   1678  f489				   DeriveEnemyY
   1679  f489							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1680  f489							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1681  f489		       a5 b1		      lda	EnemyDataLo
   1682  f48b		       85 e5		      sta	FetchPtr
   1683  f48d		       a5 b2		      lda	EnemyDataHi
   1684  f48f		       85 e6		      sta	FetchPtr+1
   1685  f491		       bc b2 f9 	      ldy	EnemyOffTable,X
   1686  f494		       20 f6 fe 	      jsr	FoldIndirect	; type
   1687  f497		       c9 01		      cmp	#ENEMY_BAT
   1688  f499		       f0 18		      beq	.DEYTickNoShift
   1689  f49b		       c9 03		      cmp	#ENEMY_TENTACLE
   1690  f49d		       f0 1a		      beq	.DEYTickShift
   1691  f49f		       c9 00		      cmp	#ENEMY_SPIDER
   1692  f4a1		       f0 2e		      beq	.DEYSpiderTick
   1693  f4a3		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1694  f4a5		       d0 06		      bne	.DEYStatic
   1695  f4a7		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1696  f4aa		       4c c6 f4 	      jmp	DEYDelta
   1697  f4ad				   .DEYStatic
   1698  f4ad		       c8		      iny
   1699  f4ae		       c8		      iny
   1700  f4af		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1701  f4b2		       60		      rts
   1702  f4b3				   .DEYTickNoShift
   1703  f4b3		       a5 c2		      lda	EnemyRamP
   1704  f4b5		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1705  f4b6		       4c be f4 	      jmp	.DEYBobTick
   1706  f4b9				   .DEYTickShift
   1707  f4b9		       a5 c2		      lda	EnemyRamP
   1708  f4bb		       4a		      lsr
   1709  f4bc		       4a		      lsr
   1710  f4bd		       4a		      lsr		; ÷8 gate
   1711  f4be				   .DEYBobTick		; shared bob delta: triangle(p&3) = 0,1,2,1
   1712  f4be		       29 03		      and	#3
   1713  f4c0		       c9 03		      cmp	#3
   1714  f4c2		       d0 02		      bne	DEYDelta
   1715  f4c4		       a9 01		      lda	#1	; 3 -> 1
   1716  f4c6							; (dead `jmp DEYDelta` removed — target was
   1717  f4c6							;  the very next instruction)
