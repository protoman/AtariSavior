   1202  f28d							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1203  f28d							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1204  f28d							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1205  f28d							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1206  f28d							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1207  f28d							;     resumes (he lifts off). No Up -> hovers in place.
   1208  f28d				   .Integrate
   1209  f28d		       a5 9c		      lda	Hover
   1210  f28f		       f0 13		      beq	.DoInt
   1211  f291		       a5 96		      lda	JetPower
   1212  f293		       c9 09		      cmp	#GRAVITY + 1
   1213  f295		       b0 09		      bcs	.HoverEnd
   1214  f297		       a9 00		      lda	#0
   1215  f299		       85 93		      sta	vyLo
   1216  f29b		       85 94		      sta	vyHi
   1217  f29d		       4c a4 f2 	      jmp	.DoInt
   1218  f2a0				   .HoverEnd
   1219  f2a0		       a9 00		      lda	#0
   1220  f2a2		       85 9c		      sta	Hover
   1221  f2a4				   .DoInt
   1222  f2a4		       18		      clc
   1223  f2a5		       a5 95		      lda	PlayerYSub
   1224  f2a7		       65 93		      adc	vyLo
   1225  f2a9		       85 95		      sta	PlayerYSub
   1226  f2ab		       a9 00		      lda	#0
   1227  f2ad		       65 94		      adc	vyHi
   1228  f2af		       f0 1c		      beq	.NoVMove
   1229  f2b1		       30 0c		      bmi	.UpSteps
   1230  f2b3		       85 97		      sta	StepsLeft	; positive = falling (down)
   1231  f2b5				   .JFalling
