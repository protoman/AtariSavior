   1494  f3d3							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1495  f3d3							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1496  f3d3							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1497  f3d3							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1498  f3d3							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1499  f3d3							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1500  f3d3							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1501  f3d3							; so the first move is the retreat into its wall. Ignores editor range_* per
   1502  f3d3							; user 2026-09-23. No wall collision.
   1503  f3d3							; ------------------------------------------------------------------------------
   1504  f3d3				   UpdateEnemies
   1505  f3d3		       a5 b3		      lda	EnemyCount
   1506  f3d5		       d0 01		      bne	UE_Start
   1507  f3d7		       60		      rts
   1508  f3d8				   UE_Start
   1509  f3d8							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1510  f3d8							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1511  f3d8		       a5 b1		      lda	EnemyDataLo
   1512  f3da		       85 e5		      sta	FetchPtr
   1513  f3dc		       a5 b2		      lda	EnemyDataHi
   1514  f3de		       85 e6		      sta	FetchPtr+1
   1515  f3e0		       a2 00		      ldx	#0
   1516  f3e2				   UE_Loop
   1517  f3e2		       e4 b3		      cpx	EnemyCount
   1518  f3e4		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1519  f3e6		       4c 41 f4 	      jmp	UE_Exit
   1520  f3e9				   UE_Alive
   1521  f3e9		       a5 ba		      lda	EnemyDeadMask
   1522  f3eb		       3d cf f3 	      and	EnemyBitTable,X
   1523  f3ee		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1524  f3f0		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1525  f3f3		       20 f6 fe 	      jsr	FoldIndirect	; type
   1526  f3f6		       4c 31 f8 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1527  f3f9							; 18 B per-type compare chain with one 3 B jmp:
   1528  f3f9							; frees 15 B of pre-pad headroom and gives the
   1529  f3f9							; type tables room for the raft byte.
   1530  f3f9				   UE_SnakeBody
