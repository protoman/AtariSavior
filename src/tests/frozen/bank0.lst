   3759  fe05		       f2		      .byte.b	$f2	; bat — hue 15 luma 7 = brown
   3760  fe06		       c4		      .byte.b	$c4	; snake — hue 12 luma 2 = green
   3761  fe07		       0e		      .byte.b	$0e	; tentacle — hue 0 luma 7 = white
   3762  fe08		       22		      .byte.b	$22	; moth — hue 2 luma 1 = dark orange
   3763  fe09		       0e		      .byte.b	$0e	; lamp (type 5) — white; dark rooms override to grey
