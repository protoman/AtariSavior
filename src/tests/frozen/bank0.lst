   1969  f654							; FlickerFrame already advanced at entry — modulo into 0..(slot count-1)
   1970  f654				   .SOModLoop
   1971  f654		       a5 b4		      lda	FlickerFrame
   1972  f656		       c5 88		      cmp	Temp
   1973  f658		       90 08		      bcc	.SOModDone
   1974  f65a		       38		      sec
   1975  f65b		       e5 88		      sbc	Temp
   1976  f65d		       85 b4		      sta	FlickerFrame
   1977  f65f		       4c 54 f6 	      jmp	.SOModLoop
   1978  f662				   .SOModDone
   1979  f662							; FlickerFrame is now 0..(slot count-1)
   1980  f662							; Check if slot 0 is the miner
   1981  f662		       a5 b4		      lda	FlickerFrame
   1982  f664		       d0 1c		      bne	.SOEnemy
   1983  f666		       a5 88		      lda	Temp
   1984  f668		       c5 b3		      cmp	EnemyCount
   1985  f66a		       f0 16		      beq	.SOEnemy	; no miner slot in this room
   1986  f66c							; This slot is the miner
   1987  f66c		       a9 38		      lda	#OBJ_MINER	; miner design offset into ObjSprites
   1988  f66e		       85 b6		      sta	ObjBase
