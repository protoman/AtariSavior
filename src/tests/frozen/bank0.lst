   3874  ffec							; ------------------------------------------------------------------------------
   3875  ffec							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   3876  ffec							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   3877  ffec							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   3878  ffec							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   3879  ffec							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   3880  ffec							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   3881  ffec							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   3882  ffec							;   One less push level too (no fold / no pad call inside the body).
   3883  ffec							;   Full behavior docs moved with the body.
   3884  ffec							; ------------------------------------------------------------------------------
   3885  ffec
   3886  ffec							; ==============================================================================
   3887  ffec							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   3888  ffec							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   3889  ffec							; ==============================================================================
   3890  ffec							; ==============================================================================
   3891  ffec		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
