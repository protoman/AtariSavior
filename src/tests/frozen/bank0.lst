    858  f0e7							; Same c51 slot the old no-door path used
    859  f0e7							; (AFTER the left half, same rule as COLUPF)
    860  f0e7		       a5 8d		      lda	CollisionCellY	; P2b door color staged by the VBL:
    861  f0e9							; $80 = no door / $1C = yellow stripe
    862  f0e9		       30 04		      bmi	.M1done	; no door: COLUP1/Temp already hold the band
    863  f0eb							;   colour, nothing left to do
