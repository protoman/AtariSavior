   1046  f1a6							; --- Bomb: edge-detect Down (D1, 0=pressed) ---
   1047  f1a6		       a5 88		      lda	Temp
   1048  f1a8		       29 02		      and	#%00000010
   1049  f1aa		       f0 09		      beq	.BombHeld
   1050  f1ac		       a5 b5		      lda	BombPacked	; released: clear DownPrev (b2), keep state/mask
   1051  f1ae		       29 fb		      and	#%11111011
