   3752  ff68				   .LAdvS
   3753  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   3754  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   3755  ff6c		       90 03		      bcc	.LAdvCap
   3756  ff6e		       4c 9a ff 	      jmp	.LaserInit
   3757  ff71				   .LAdvCap
   3758  ff71		       a5 82		      lda	PlayerDir
   3759  ff73		       d0 0c		      bne	.LAdvCapL
   3760  ff75		       a5 80		      lda	RoomX
   3761  ff77		       18		      clc
   3762  ff78		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   3763  ff7a		       c5 92		      cmp	RectCount
   3764  ff7c		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   3765  ff7e		       4c 9a ff 	      jmp	.LaserInit
   3766  ff81				   .LAdvCapL
   3767  ff81		       a5 80		      lda	RoomX
   3768  ff83		       38		      sec
   3769  ff84		       e9 14		      sbc	#20
   3770  ff86		       b0 02		      bcs	.LAdvCapLs
   3771  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   3772  ff8a				   .LAdvCapLs
   3773  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
   3774  ff8c		       f0 05		      beq	.LAdvKeep
   3775  ff8e		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   3776  ff90		       4c 9a ff 	      jmp	.LaserInit
   3777  ff93				   .LAdvKeep
   3778  ff93		       a5 92		      lda	RectCount
   3779  ff95		       85 83		      sta	LaserX
   3780  ff97		       4c 9d ff 	      jmp	.LaserGo	; committed: skip the eye restart
   3781  ff9a				   .LaserInit
   3782  ff9a		       20 c4 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   3783  ff9d				   .LaserGo
   3784  ff9d		       a5 83		      lda	LaserX
   3785  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   3786  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   3787  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   3788  ffa6		       c9 50		      cmp	#$50
   3789  ffa8		       f0 0a		      beq	.LaserKill
   3790  ffaa		       c9 02		      cmp	#2
   3791  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   3792  ffae							;   same as kill minus score — restart at
   3793  ffae							;   the eye THIS frame, buzz keeps (b7).
   3794  ffae							;   #9's blank + the wall-center hold clamp
   3795  ffae							;   both superseded: a contact missile is
   3796  ffae							;   consumed by walls. No hold state, no
   3797  ffae							;   cap reorder, no pass-through possible.
   3798  ffae		       20 26 fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   3799  ffb1		       4c b7 ff 	      jmp	.LaserContact
   3800  ffb4				   .LaserKill
   3801  ffb4		       20 1a fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   3802  ffb7				   .LaserContact
   3803  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   3804  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
