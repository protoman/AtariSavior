   3521  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3522  ff0f							; ==============================================================================
   3523  ff0f							; Andrew Davie session-24 routine:
   3524  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3525  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3526  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3527  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3528  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3529  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3530  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3531  ff0f							;
   3532  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3533  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3534  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3535  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3536  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3537  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3538  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3539  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3540  ff0f				   SetObjectXPos subroutine
   3541  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   3542  ff11		       38		      sec		; ensure carry flag
   3543  ff12				   .Div15Loop
   3544  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
