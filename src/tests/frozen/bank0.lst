   2597  f942		       c9 0f		      cmp	#15
   2598  f944		       b0 06		      bcs	.off7
   2599  f946		       38		      sec
   2600  f947		       e9 04		      sbc	#4	; P0 target <15: visible left = X - 4
   2601  f949		       4c 4e f9 	      jmp	.gotVL
   2602  f94c				   .off7
   2603  f94c		       e9 07		      sbc	#7	; P0 target >=15: visible left = X - 7
   2604  f94e				   .gotVL
