   3850  fca1							; LoseLifeBand — life path + respawn just above the water strip.
   3851  fca1							; The shift MUST happen BEFORE LoseLife: its stay path tail-jumps DropArm,
   3852  fca1							; which freezes RoomY as the drop destiny. Shifting after the call was dead
   3853  fca1							; code — a water death respawned at the death Y (inside the strip, >= 125) and
   3854  fca1							; the player died again on landing, unable to fly out (user report 2026-10-21).
   3855  fca1							; The shift is one tile (spec: -= 12, not the whole band): the band check
   3856  fca1							; tests the sprite ORIGIN (RoomY >= 115), so 115 -> 103 clears the strip.
   3857  fca1							; Tail-jmps LoseLife (never returns here): its exhausted path rts straight to
   3858  fca1							; CheckBandTouch.
   3859  fca1							; ------------------------------------------------------------------------------
   3860  fca1				   LoseLifeBand
   3861  fca1		       a5 81		      lda	RoomY
   3862  fca3		       38		      sec
   3863  fca4		       e9 0c		      sbc	#12	; one tile up
   3864  fca6		       b0 02		      bcs	.LLBstore
   3865  fca8		       a9 00		      lda	#0	; near the top: clamp at 0
   3866  fcaa				   .LLBstore
   3867  fcaa		       85 81		      sta	RoomY
   3868  fcac		       4c 80 fc 	      jmp	LoseLife	; freezes this Y as DropTarget and drops in
   3869  fcaf
   3870  fcaf
   3871  fcaf							; ------------------------------------------------------------------------------
   3872  fcaf							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3873  fcaf							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3874  fcaf							; caller; Y is animated from the screen top down to it).
   3875  fcaf							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3876  fcaf							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3877  fcaf							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3878  fcaf							;
   3879  fcaf							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3880  fcaf							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3881  fcaf							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3882  fcaf							;
   3883  fcaf							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3884  fcaf							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3885  fcaf							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3886  fcaf							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3887  fcaf							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3888  fcaf							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3889  fcaf							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3890  fcaf							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3891  fcaf							; ------------------------------------------------------------------------------
   3892  fcaf				   DropArm
   3893  fcaf		       a5 8a		      lda	DropTarget
   3894  fcb1		       c9 fd		      cmp	#$FD
   3895  fcb3		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3896  fcb5							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3897  fcb5							;   tally cleared to 0 by TallyWork before its
   3898  fcb5							;   LoadLevel — same-size swap 2026-10-06)
   3899  fcb5		       a5 81		      lda	RoomY
   3900  fcb7		       85 8a		      sta	DropTarget
   3901  fcb9		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3902  fcbb		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3903  fcbd		       a9 00		      lda	#0
   3904  fcbf		       85 81		      sta	RoomY
   3905  fcc1		       85 95		      sta	PlayerYSub
   3906  fcc3		       85 93		      sta	vyLo
   3907  fcc5		       85 94		      sta	vyHi
   3908  fcc7		       a5 c0		      lda	LaserState
   3909  fcc9		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3910  fccb		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3911  fccd		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3912  fccf		       85 83		      sta	LaserX
   3913  fcd1		       18		      clc
   3914  fcd2		       60		      rts
   3915  fcd3				   .DATitle
   3916  fcd3							; Title: player already placed at level start by LoadLevel. Hide all
   3917  fcd3							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3918  fcd3							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3919  fcd3							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3920  fcd3		       a9 00		      lda	#0
   3921  fcd5		       85 b3		      sta	EnemyCount
   3922  fcd7		       a9 ff		      lda	#$FF
   3923  fcd9		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3924  fcdb							; Preview seat (user 2026-10-24): the title draws the REAL cave in band 0
   3925  fcdb							; and seats the player 6 px down from the very top, so his head is not
   3926  fcdb							; clipped by the top of the screen (RoomY = 0 cut it). (RoomY = 36 put him
   3927  fcdb							; inside band 1's wall: the playfield has priority over sprites, so he
   3928  fcdb							; showed as a sliver.)
   3929  fcdb		       a9 06		      lda	#6
   3930  fcdd		       85 81		      sta	RoomY
   3931  fcdf							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3932  fcdf							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3933  fcdf							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3934  fcdf							; preview still renders dark.
   3935  fcdf		       a5 c0		      lda	LaserState
   3936  fce1		       29 3d		      and	#LASER_KEEP
   3937  fce3		       85 c0		      sta	LaserState
   3938  fce5		       a5 a3		      lda	Level
   3939  fce7		       18		      clc
   3940  fce8		       69 01		      adc	#1	; 1-based level number (the title SELECT)
   3941  fcea		       20 12 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3942  fced		       a9 00		      lda	#0
   3943  fcef		       85 f3		      sta	ScoreTh
   3944  fcf1		       85 f4		      sta	ScoreHu
   3945  fcf3		       18		      clc
   3946  fcf4		       60		      rts
