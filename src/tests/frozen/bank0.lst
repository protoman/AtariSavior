   1186  f264		       e5 96		      sbc	JetPower
   1187  f266		       85 93		      sta	vyLo
   1188  f268		       a5 94		      lda	vyHi
   1189  f26a		       e9 00		      sbc	#0
   1190  f26c		       85 94		      sta	vyHi
   1191  f26e				   .ThrustSkip
