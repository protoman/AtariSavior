   3694  ff2a		       a5 a4		      lda	LevelMinerRoom
   3695  ff2c		       10 04		      bpl	.SORdone
   3696  ff2e		       a9 08		      lda	#$08
   3697  ff30		       85 0c		      sta	REFP1
   3698  ff32				   .SORdone
   3699  ff32		       60		      rts
