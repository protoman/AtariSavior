   3657  fef3		       4c 00 f1 	      jmp	$F100	; bank2 MothRoutine (dead in bank0; guard pins
   3658  fef6							;   bank0/bank2 operands == bank2.lst label)
   3659  fef6					      .ds	$FEF6 - *, 0	; pin address (main size drift must not move it)
