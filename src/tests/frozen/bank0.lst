   1036  f19f							; --- Spawn drop-in gate: while falling from the top (DropTarget != 0)
   1037  f19f							;     ALL input/physics/collision is bypassed -> DropStep only. ---
   1038  f19f		       a5 8a		      lda	DropTarget
   1039  f1a1		       f0 03		      beq	.NormalGame	; idle -> normal play (adjacent, 3c/2c)
   1040  f1a3		       4c 08 fd 	      jmp	DropStep	; tail-jumps back to OverscanAudio
   1041  f1a6				   .NormalGame
   1042  f1a6
   1043  f1a6							; --- Bomb: edge-detect Down (D1, 0=pressed) ---
   1044  f1a6		       a5 88		      lda	Temp
   1045  f1a8		       29 02		      and	#%00000010
   1046  f1aa		       f0 09		      beq	.BombHeld
   1047  f1ac		       a5 b5		      lda	BombPacked	; released: clear DownPrev (b2), keep state/mask
   1048  f1ae		       29 fb		      and	#%11111011
   1049  f1b0		       85 b5		      sta	BombPacked
   1050  f1b2		       4c f4 f1 	      jmp	.BombInDone
   1051  f1b5				   .BombHeld
   1052  f1b5		       a5 b5		      lda	BombPacked
   1053  f1b7		       29 04		      and	#%00000100
   1054  f1b9		       d0 39		      bne	.BombInDone	; held since last frame — no edge
   1055  f1bb		       a5 b5		      lda	BombPacked
   1056  f1bd		       29 03		      and	#%00000011
   1057  f1bf		       d0 2d		      bne	.BombMarkDown	; bomb already active: just set DownPrev
   1058  f1c1		       a5 f0		      lda	PlayerBombs
   1059  f1c3		       29 07		      and	#%00000111	; b2-0 = bombs; b7-3 are the raft's ramp state
   1060  f1c5		       f0 27		      beq	.BombMarkDown	; no bombs left: swallow edge, keep DownPrev
   1061  f1c7		       a5 b5		      lda	BombPacked
   1062  f1c9		       29 80		      and	#%10000000	; b7 OnGround — drop only when standing
   1063  f1cb		       f0 21		      beq	.BombMarkDown	; flying/falling: swallow edge, keep DownPrev
   1064  f1cd		       c6 f0		      dec	PlayerBombs
   1065  f1cf		       a5 b5		      lda	BombPacked	; rising edge, state=0 → drop
   1066  f1d1		       09 05		      ora	#%00000101	; state=1 + DownPrev
   1067  f1d3		       85 b5		      sta	BombPacked
   1068  f1d5		       a5 80		      lda	RoomX
   1069  f1d7		       85 f6		      sta	BombX
