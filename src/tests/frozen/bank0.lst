   4119  ff33							; ------------------------------------------------------------------------------
   4120  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4121  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4122  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   4123  ff33							; user spec: no piercing, no HERO comparison needed).
   4124  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4125  ff33							;						  left	RoomX-4)
   4126  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4127  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   4128  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4129  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4130  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4131  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4132  ff33							;     priority over M0 anyway).
   4133  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4134  ff33							;     press edge re-anchors).
   4135  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4136  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4137  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4138  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4139  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4140  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4141  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4142  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4143  ff33							; ------------------------------------------------------------------------------
   4144  ff33				   LaserInput
   4145  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4146  ff35		       8a		      txa
   4147  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4148  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4149  ff3a		       8a		      txa
   4150  ff3b		       29 80		      and	#LASER_HELD
   4151  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4152  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4153  ff40		       85 c0		      sta	LaserState
   4154  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4155  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4156  ff46							; below — moved here so the cap code could
   4157  ff46							; not push .LaserReleased past bmi's ±127)
   4158  ff46				   .LaserReleased
   4159  ff46		       a9 00		      lda	#0
   4160  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4161  ff4a							; otherwise -> bars slid across screen
   4162  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   4163  ff4b				   .LaserFire
   4164  ff4b		       a5 c0		      lda	LaserState
   4165  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4166  ff4f		       85 c0		      sta	LaserState
   4167  ff51		       8a		      txa
   4168  ff52		       29 80		      and	#LASER_HELD
   4169  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4170  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4171  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4172  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   4173  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4174  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   4175  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4176  ff56		       a5 c0		      lda	LaserState
   4177  ff58		       29 01		      and	#LASER_REARM
   4178  ff5a		       f0 04		      beq	.LAdvStep
   4179  ff5c		       c6 c0		      dec	LaserState
   4180  ff5e		       d0 3a		      bne	.LaserInit
   4181  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4182  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4183  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4184  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4185  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4186  ff60				   .LAdvStep
   4187  ff60		       a4 82		      ldy	PlayerDir
