    954  f16e		       a9 00		      lda	#0	; (nothing falls through `jmp .Row`)
    955  f170		       85 1b		      sta	GRP0
    956  f172		       4c 21 f1 	      jmp	.Grp1
    957  f175				   .ObjZero
    958  f175		       d0 04		      bne	.ObjNoRes	; flags live from `cmp #PLAYER_HEIGHT` upstream:
    959  f177							; A==8 ONLY = first line below the window — the
    960  f177							; only line where COLUP1 still holds the object
    961  f177							; color (all other obj-out lines: band color from
    962  f177							; .Row is intact, or this line already restored).
    963  f177							; A!=8 (above window / below first line): skip the
    964  f177							; restore — this was the A0=11 worst line
    965  f177							; (color+beam+GrpZero+restore = 77c > 76 → WSYNC
    966  f177							; late → +1 line/frame, sim 264). #6 attempt to
    967  f177							; restore EVERY line measured 271-line frames —
    968  f177							; keep the A==8-only restore.
