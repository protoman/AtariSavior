   2670  f9c4							; PositionBallM1 — D6 asymmetric objects, BOTH positioned in one VBL call.
   2671  f9c4							; WHY here: pre-pad headroom is 1B — inline ball+m1 (22B) cannot live in the
   2672  f9c4							; VBL block, so the ball block became this jsr and the body sits in the
   2673  f9c4							; $F9C4..$FBF7 fill (ReturnPad pin at $FBF8 unaffected; F6-safe:
   2674  f9c4							; $F9C4 & $1FFF = $19C4 ∉ $1FF6-$1FF9; bank0-only, not a fold twin).
   2675  f9c4							;   Temp	   = staged BallX (bank2 StageBandTab): 0 = symmetric → skip.
   2676  f9c4							;		     selector 4 = HMBL/RESPBL, ball x drawn clocks [A-7,A].
   2677  f9c4							;   CollisionEndX = staged M1X (MetaA nibble, bank2 StageBandTab):
   2678  f9c4							;		     0 = no M1 patch → skip.
   2679  f9c4							;		     selector 3 = HMM1/RESM1, left-col block x = 7+8*col
   2680  f9c4							;		     (passed to SetObjectXPos as M1X+1 — Stella draws 8-wide
   2681  f9c4							;		     M1 one clock left of the [A-7,A] player contract).
   2682  f9c4							;		     ENAM1 latched #$02 for the whole cave (hero-style: 2
   2683  f9c4							;		     ENAM writes/frame — enable here, clear in .AfterRows);
   2684  f9c4							;		     walls hide the parked M1 in unpatched bands (PF > M1 in
   2685  f9c4							;		     the priority chain — convert enforces the solid cell).
   2686  f9c4							; Runs before the single HMOVE (HMP0+X shadow registers accumulate).
   2687  f9c4							; Sym path cost: jsr+rts overhead only — no RESP/HMP write, frames stay
   2688  f9c4							; bit-identical to the pre-D6 build.
   2689  f9c4							; ------------------------------------------------------------------------------
