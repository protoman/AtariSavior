   3478  fda8							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3479  fda8							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3480  fda8							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3481  fda8							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3482  fda8							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3483  fda8							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3484  fda8							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3485  fda8							;   tools/test_cell_map.py).
   3486  fda8							;   (The standalone CellSolid leaf that lived here moved INTO
   3487  fda8							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3488  fda8							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3489  fda8							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3490  fda8							; ------------------------------------------------------------------------------
   3491  fda8		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3492  fdbc		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3493  fdc8		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3494  fdd0
   3495  fdd0							; ------------------------------------------------------------------------------
   3496  fdd0							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3497  fdd0							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3498  fdd0							; is fetched from bank2's byte-identical mirror at this same address and
   3499  fdd0							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3500  fdd0							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3501  fdd0							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3502  fdd0							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3503  fdd0							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3504  fdd0							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3505  fdd0							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3506  fdd0							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3507  fdd0							; ------------------------------------------------------------------------------
