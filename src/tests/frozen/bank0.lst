   3051  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3052  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3053  fce7		       85 83		      sta	LaserX
   3054  fce9		       18		      clc
   3055  fcea		       60		      rts
