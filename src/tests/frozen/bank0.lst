   2375  f827		       d0 03		      bne	.UEDNotMoth
   2376  f829		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2377  f82c				   .UEDNotMoth
   2378  f82c		       c9 02		      cmp	#ENEMY_SNAKE
   2379  f82e		       d0 03		      bne	.UEDNotSnake
   2380  f830		       4c dc f3 	      jmp	UE_SnakeBody
   2381  f833				   .UEDNotSnake
   2382  f833		       4c 20 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
