   3936  fedb		       00 00 00 00*	      .ds	$FEE7 - *, 0	; bank0↔bank1 CallPad (leaf_move_plan Step 0)
   3937  fee7				   CallPad_MothYDerive
   3938  fee7		       8d f7 1f 	      sta	$1FF7
   3939  feea		       4c 38 f0 	      jmp	$F038
