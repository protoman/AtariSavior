   2858  f939		       a5 8e		      lda	CollisionEndX
   2859  f93b		       c5 8c		      cmp	CollisionCellX
   2860  f93d		       90 06		      bcc	.colsOk
   2861  f93f		       a6 8c		      ldx	CollisionCellX
