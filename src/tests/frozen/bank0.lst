   2401  f8de		       7e		      .byte.b	%01111110	; row 1
   2402  f8df		       7c		      .byte.b	%01111100	; row 2 — yellow face
   2403  f8e0		       7e		      .byte.b	%01111110	; row 3
   2404  f8e1		       7c		      .byte.b	%01111100	; row 4 — grey pack
   2405  f8e2		       fe		      .byte.b	%11111110	; row 5
   2406  f8e3		       fe		      .byte.b	%11111110	; row 6
   2407  f8e4		       3e		      .byte.b	%00111110	; row 7 — jet frame A
   2408  f8e5		       3e		      .byte.b	%00111110	; row 8
   2409  f8e6		       14		      .byte.b	%00010100	; row 9
   2410  f8e7		       14		      .byte.b	%00010100	; row 10 — grey boots
   2411  f8e8		       14		      .byte.b	%00010100	; row 11
