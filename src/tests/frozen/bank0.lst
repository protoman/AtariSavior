   4676  ff43		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4677  ff45							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4678  ff45							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4679  ff45							; step would jump out of the 8px wall with no candidate ever inside it
   4680  ff45							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4681  ff45							; here (b7 held from the ora above). Open-hold cadence alternates
   4682  ff45							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4683  ff45		       a5 c0		      lda	LaserState
