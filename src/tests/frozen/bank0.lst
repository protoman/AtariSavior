   3711  fda9							; ------------------------------------------------------------------------------
   3712  fda9							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3713  fda9							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3714  fda9							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3715  fda9							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3716  fda9							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3717  fda9							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3718  fda9							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3719  fda9							;   tools/test_cell_map.py).
   3720  fda9							;   (The standalone CellSolid leaf that lived here moved INTO
   3721  fda9							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3722  fda9							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3723  fda9							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3724  fda9							; ------------------------------------------------------------------------------
   3725  fda9		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3726  fdbd		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3727  fdc9		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3728  fdd1
   3729  fdd1							; ------------------------------------------------------------------------------
   3730  fdd1							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3731  fdd1							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3732  fdd1							; is fetched from bank2's byte-identical mirror at this same address and
   3733  fdd1							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3734  fdd1							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3735  fdd1							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3736  fdd1							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3737  fdd1							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3738  fdd1							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3739  fdd1							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3740  fdd1							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3741  fdd1							; ------------------------------------------------------------------------------
   3742  fdd1		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3743  fdd8				   BombEnemyBlast
   3744  fdd8		       8d f8 1f 	      sta	$1FF8
   3745  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3746  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3747  fdde							;   span)
   3748  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3749  fdde							;   latch + feature gate pushed +14; same day
   3750  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3751  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3752  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3753  fdde							;   garbage path's `inc $4A,X` set wall bits
   3754  fdde							;   via $CA)
