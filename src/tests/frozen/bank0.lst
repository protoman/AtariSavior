   2105  f70d		       85 bb		      sta	ObjTop	; Scanline-(RoomY+ObjTopRel); parking ObjTopRel
   2106  f70f		       60		      rts		; = 144-RoomY → Scanline-144 ∈ [112,255] →
   2107  f710							; never <8 → never drawn. A CONSTANT 144
   2108  f710							; wrapped for RoomY ≥ 112 (Scanline-(144+RY)
   2109  f710							; mod 256 ∈ [0,7]) and drew ObjSprites[row+
   2110  f710							; ObjBase]; with the key art now at slot 0
   2111  f710							; (ObjBase=$FF → row 1..7 = index 0..6) that
   2112  f710							; leaked the key onto the player's rows
