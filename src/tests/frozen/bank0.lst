   2262  f926							; PlayerHitsMap — check player bounding box against the room's PF map
   2263  f926							; ==============================================================================
   2264  f926							; Boxes are in tile coordinates (col 0-19, row 0-2); the walk tests the
   2265  f926							; PF0/1/2Buf cell bits directly (cell_collision_plan 2.1) — no rect cache,
   2266  f926							; no rect-count limit. The playfield is reflected, so right-half display
   2267  f926							; cols mirror via 39-col IN THE PROLOGUE (walk sees left-half only).
   2268  f926							; Returns C=0 if clear, C=1 if blocked.
   2269  f926				   PlayerHitsMap
   2270  f926							; --- Tile row range (top, bottom) ---
   2271  f926							; Inlined row lookup: saves 2 JSR stack push levels (4B on stack) to keep SP >= $F8
   2272  f926		       a5 81		      lda	RoomY
   2273  f928		       4a		      lsr
   2274  f929		       4a		      lsr		; A = scanline >> 2
   2275  f92a		       a8		      tay
   2276  f92b		       b9 01 f9 	      lda	YToRowTable,Y
   2277  f92e		       85 8d		      sta	CollisionCellY	; top tile row
   2278  f930		       18		      clc
   2279  f931		       a5 81		      lda	RoomY
   2280  f933		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   2281  f935		       4a		      lsr
   2282  f936		       4a		      lsr
   2283  f937		       a8		      tay
   2284  f938		       b9 01 f9 	      lda	YToRowTable,Y
   2285  f93b		       85 8f		      sta	CollisionEndY	; bottom tile row
   2286  f93d
