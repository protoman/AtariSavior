    455 U00bc							; ==============================================================================
    456 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    457 U00bc							; ==============================================================================
    458 U00bc							; Bank3 is the power-up bank. Its stub does:
    459 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    460 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    461 U00bc							; ==============================================================================
    462  10000 ????				       seg	code
    463  f000					      org	$F000
    464  f000
    465  f000							; --- 5-byte bankswitching pad ---
    466  f000							; After bank3's stub selects us, CPU arrives here.
    467  f000							; We jump over the pad into the real init code.
    468  f000		       a9 00		      lda	#0
    469  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    470  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    471  f008							; (NOT deletable: $F008 = GameStart is a
    472  f008							;  hardcoded cross-bank entry — bank1
    473  f008							;  stub `jmp $F008`; this jmp also keeps
    474  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    475  f008							;  fold-pad byte guard fires when it moves)
    476  f008							;  + F0xx landmarks fixed)
    477  f008
    478  f008				   GameStart
    479  f008		       78		      sei		; disable interrupts
    480  f009		       d8		      cld		; clear decimal mode
    481  f00a		       a2 ff		      ldx	#$FF
    482  f00c		       9a		      txs		; stack pointer = $FF
    483  f00d
    484  f00d							; --- Clear zero-page RAM ---
    485  f00d		       a9 00		      lda	#0
    486  f00f		       a2 80		      ldx	#$80
    487  f011				   .ClearZP
    488  f011		       95 00		      sta	$00,X
    489  f013		       e8		      inx
    490  f014		       d0 fb		      bne	.ClearZP
    491  f016
    492  f016							; --- Initialize game state ---
    493  f016		       a9 00		      lda	#0
    494  f018		       85 a3		      sta	Level
    495  f01a		       a9 03		      lda	#3
    496  f01c		       85 ac		      sta	PlayerLives
    497  f01e		       a9 05		      lda	#BOMBS_MAX
    498  f020		       85 f0		      sta	PlayerBombs
    499  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    500  f022		       a9 3c		      lda	#60
    501  f024		       85 ad		      sta	TickCounter
    502  f026		       a9 78		      lda	#120
    503  f028		       85 ae		      sta	BarLevel	; bar starts full
    504  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    505  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    506  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    507  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    508  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    509  f02a		       a9 ff		      lda	#$FF
    510  f02c		       85 8a		      sta	DropTarget
    511  f02e
    512  f02e							; --- Load first level (the title previews it on the live stage:
    513  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    514  f02e		       20 20 fc 	      jsr	LoadLevel
    515  f031
    516  f031							; --- Set player color ---
    517  f031		       a9 48		      lda	#COLOR_PLAYER
    518  f033		       85 06		      sta	COLUP0
    519  f035
    520  f035							; --- Set playfield to reflected mode + priority ---
    521  f035							; D0=1 = reflect (left half mirrors to right)
    522  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    523  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    524  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    525  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    526  f037		       85 0a		      sta	CTRLPF
    527  f039
    528  f039							; ==============================================================================
    529  f039							; Frame loop
    530  f039							; ==============================================================================
    531  f039				   StartFrame
    532  f039
    533  f039							; ------------------------------------------------------------------------------
    534  f039							; VSYNC (3 scanlines)
    535  f039							; ------------------------------------------------------------------------------
    536  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    537  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    538  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    539  f039							; does not advance the wall clock to the next scanline boundary (it is already
    540  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    541  f039							; fraction depends on where the previous frame's overscan happened to end) —
    542  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    543  f039							;
    544  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    545  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    546  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    547  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    548  f039							; the sim wall-model target is updated to match.
    549  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    550  f03b		       a9 02		      lda	#2
    551  f03d		       85 00		      sta	VSYNC
    552  f03f		       85 02		      sta	WSYNC
    553  f041		       85 02		      sta	WSYNC
    554  f043		       85 02		      sta	WSYNC
    555  f045		       a9 00		      lda	#0
    556  f047		       85 00		      sta	VSYNC
    557  f049
    558  f049							; ------------------------------------------------------------------------------
    559  f049							; VBLANK (37 scanlines)
    560  f049							; ------------------------------------------------------------------------------
    561  f049		       a9 02		      lda	#2
    562  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    563  f04d
    564  f04d							; --- Set TIM64T for VBLANK ---
    565  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    566  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    567  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    568  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    569  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    570  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    571  f04d							; Worst 1059c of the 1472c window = 413c margin.
    572  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    573  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    574  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    575  f04d		       a9 17		      lda	#23
    576  f04f		       8d 96 02 	      sta	TIM64T
    577  f052
    578  f052							; --- Position player sprite horizontally ---
    579  f052		       a5 80		      lda	RoomX
    580  f054		       38		      sec
    581  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    582  f057		       a2 00		      ldx	#0	; X=0 = player0
    583  f059		       20 0f ff 	      jsr	SetObjectXPos
    584  f05c
    585  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    586  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    587  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    588  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    589  f05c
    590  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    591  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    592  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    593  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    594  f05c
    595  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    596  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    597  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    598  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    599  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    600  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    601  f05c		       20 32 f6 	      jsr	SelectActiveObject
    602  f05f
    603  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    604  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    605  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    606  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    607  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    608  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    609  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    610  f062
    611  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    612  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    613  f062							; 2026-10-04 up-exit fix). The
    614  f062							; old per-frame VBL fold that re-read the same ROM byte is
    615  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    616  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    617  f062							; the VBL path (the read that made a bank3 data move need another
    618  f062							; reader). test_band_restage covers the contract.
    619  f062
    620  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    621  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    622  f062							; Dark room: black except the existing explosion blink (state=2).
    623  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    624  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    625  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    626  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    627  f062		       a5 b5		      lda	BombPacked
    628  f064		       29 03		      and	#%00000011
    629  f066		       c9 02		      cmp	#2
    630  f068		       f0 0a		      beq	.BgBlink
    631  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    632  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    633  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    634  f071		       4c 84 f0 	      jmp	.BgStore
    635  f074				   .BgBlink
    636  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    637  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    638  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    639  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    640  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    641  f074		       a9 3c		      lda	#60
    642  f076		       38		      sec
    643  f077		       e5 f7		      sbc	BombTimer
    644  f079		       29 03		      and	#3
    645  f07b		       a8		      tay
    646  f07c		       b9 fc f5 	      lda	BombBlinkColors,Y
    647  f07f		       4c 84 f0 	      jmp	.BgStore
    648  f082				   .BgIdle
    649  f082		       a9 00		      lda	#COLOR_CAVE_BG
    650  f084				   .BgStore
