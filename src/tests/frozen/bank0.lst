   4193  ffe6							; TallyTramp ($FFE6, byte-identical with BANK1 now — the body moved there in
   4194  ffe6							; repack chunk 3, 2026-10-20; guard: verify_build). bank0 jsr's here
   4195  ffe6							; (CheckMinerPickup arm / TallyWork step): `sta $1FF7` selects bank1, then the
   4196  ffe6							; jmp operand is fetched from bank1's image at the same PC (FoldIndirect
   4197  ffe6							; discipline). The bank1 body tail-jmps ReturnPad ($FBF8) -> rts back to the
   4198  ffe6							; bank0 jsr. Ends $FFEB — $FFF2-$FFF9 stay fill (F6 hotspot mirrors).
   4199  ffe6							; ------------------------------------------------------------------------------
   4200  ffe6		       f4 4f	   TallyEntry =	$F44F	; bank1 TallyEntry — operand must match label
   4201  ffe6				   TallyTramp
   4202  ffe6		       8d f7 1f 	      sta	$1FF7
   4203  ffe9		       4c 4f f4 	      jmp	TallyEntry
   4204  ffec
   4205  ffec							; ------------------------------------------------------------------------------
   4206  ffec							; HotOverlapFlag — bank3 entry tramp (C7 2026-10-20: the hot walk went back
   4207  ffec							; to bank3 with the shape/extras stream it reads). Moved off $FE90 into the
   4208  ffec							; 6-byte gap after TallyTramp. bank0 executes `sta $1FF9`; the `jmp` at +3 is
   4209  ffec							; fetched from bank3's image at $FFEF (guard: check_moth_tramp).
   4210  ffec							; ------------------------------------------------------------------------------
   4211  ffec					      .ds	$FFEC - *, 0
   4212  ffec				   HotOverlapFlag
   4213  ffec		       8d f9 1f 	      sta	$1FF9	; select bank3 (record stream lives there)
   4214  ffef		       4c f8 f8 	      jmp	$F8F8	; bank3 HotOverlapBody (synced by verify_build)
   4215  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   4216  fff2
   4217  fff2							; ------------------------------------------------------------------------------
   4218  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   4219  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   4220  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   4221  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   4222  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   4223  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   4224  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   4225  fff2							;   One less push level too (no fold / no pad call inside the body).
   4226  fff2							;   Full behavior docs moved with the body.
   4227  fff2							; ------------------------------------------------------------------------------
   4228  fff2
   4229  fff2							; ==============================================================================
   4230  fff2							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   4231  fff2							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   4232  fff2							; ==============================================================================
   4233  fff2							; ==============================================================================
   4234  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   4235  fffa
   4236  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   4237  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   4238  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
