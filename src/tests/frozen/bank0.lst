   2201  f632							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2202  f632							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2203  f632							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2204  f632							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2205  f632							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2206  f632							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2207  f632							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2208  f632							; ==============================================================================
   2209  f632				   SelectActiveObject
   2210  f632							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2211  f632							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2212  f632							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2213  f632							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2214  f632							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2215  f632							; middle of the screen" the moment the points counting started).
   2216  f632		       a5 8a		      lda	DropTarget
   2217  f634		       c9 fe		      cmp	#$FE
   2218  f636		       d0 2d		      bne	.SOFull
   2219  f638		       a9 00		      lda	#0
   2220  f63a		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2221  f63c		       a9 ff		      lda	#$FF
   2222  f63e		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2223  f640							;   `0 = no object` comment was wrong and the
   2224  f640							;   tally-without-miner frame staged ObjTop from
   2225  f640							;   a stale Y, i.e. a stray key sprite)
   2226  f640		       a5 a4		      lda	LevelMinerRoom
   2227  f642		       29 7f		      and	#$7f
   2228  f644		       c5 98		      cmp	RoomNo
   2229  f646		       f0 03		      beq	.SOTallyMiner
   2230  f648		       4c 45 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2231  f64b				   .SOTallyMiner
   2232  f64b		       a9 55		      lda	#OBJ_MINER
   2233  f64d		       85 b6		      sta	ObjBase
   2234  f64f		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2235  f651		       85 9d		      sta	ObjHeight
   2236  f653		       a5 a5		      lda	MinerX
   2237  f655		       85 b7		      sta	ActiveObjectX
