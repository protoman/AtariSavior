    701  f0d2							; ==============================================================================
    702  f0d2							; Kernel: 192 visible scanlines
    703  f0d2							; ==============================================================================
    704  f0d2							; Structure:
    705  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    706  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    707  f0d2							;
    708  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    709  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
    710  f0d2							; ==============================================================================
