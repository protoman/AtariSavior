    341 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    342 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE
    343 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × LINES_PER_TILE)
