   2474  f844							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2475  f844							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF7`
   2476  f844							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2477  f844							; not from here. That is the same FoldIndirect discipline every other tramp
   2478  f844							; uses — the twin cannot be skipped or shortened.
   2479  f844							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2480  f844		       00 00 00 00*	      .ds	$F850 - *, 0	; ObjSprites: 12 rows/type = 108 B.
   2481  f850							; Base low byte $50 + max index 107 =
   2482  f850							; 187 -> `lda ObjSprites,X` stays in one
   2483  f850							; page (verify_build guard).
