   3854  fd36							; ------------------------------------------------------------------------------
   3855  fd36							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3856  fd36							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3857  fd36							; selected level number (digits band) and the credits; the theme plays here.
   3858  fd36							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3859  fd36							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3860  fd36							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3861  fd36							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3862  fd36							;	    the intro exit ate the first press and made #2 read as dead)
   3863  fd36							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3864  fd36							;	    the real drop-in → gameplay starts
   3865  fd36							; ($FD reaches here directly — merged title, 2026-10-19.)
   3866  fd36							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3867  fd36							; title-owned; the first play frame rewrites it as the step budget).
   3868  fd36							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3869  fd36							; ------------------------------------------------------------------------------
   3870  fd36				   TitleWork
   3871  fd36							; --- SELECT edge (TitleSelect, fill region) ---
   3872  fd36		       20 4f fc 	      jsr	CallPad_TitleSelect
   3873  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   3874  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3875  fd3e				   .TWselDone
   3876  fd3e							; --- RESET edge ---
   3877  fd3e		       a5 97		      lda	StepsLeft
   3878  fd40		       29 01		      and	#%00000001
   3879  fd42		       f0 14		      beq	.TWrstDone
   3880  fd44		       ad 82 02 	      lda	SWCHB
   3881  fd47		       29 01		      and	#%00000001
   3882  fd49		       d0 0d		      bne	.TWrstDone
   3883  fd4b		       a9 00		      lda	#0
   3884  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3885  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3886  fd51		       85 f4		      sta	ScoreHu
   3887  fd53		       85 f5		      sta	ScoreTe
   3888  fd55		       20 20 fc 	      jsr	LoadLevel
   3889  fd58				   .TWrstDone
   3890  fd58		       ad 82 02 	      lda	SWCHB
   3891  fd5b		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3892  fd5d							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3893  fd5d							;     channel force-muted here — UpdateJetSound is skipped because
   3894  fd5d							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3895  fd5d							;     = 0, AUDV0 covered above). ---
   3896  fd5d				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3897  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3898  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3899  fd61		       f0 0e		      beq	.TWmusic
   3900  fd63		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3901  fd65		       20 94 f5 	      jsr	BombTick
   3902  fd68				   .TWnoTick
   3903  fd68		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3904  fd6b		       a9 00		      lda	#0
   3905  fd6d		       85 1a		      sta	AUDV1
   3906  fd6f		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3907  fd71				   .TWmusic		; title: music wins the audio regs
   3908  fd71		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3909  fd74				   .TWwait
