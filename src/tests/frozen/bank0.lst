    399 U00bc		       00 84	   COLOR_CAVE_WALL =	$84	; hue 8 luma 2 = dark grey-blue
    400 U00bc		       00 06	   COLOR_HUD_BG =	$06	; hue 0 luma 3 = grey
    401 U00bc		       00 1e	   COLOR_TIMER =	$1E	; hue 1 luma 7 = yellow
    402 U00bc		       00 c6	   COLOR_LIVES =	$C6	; hue 12 luma 3 = green
    403 U00bc		       00 46	   COLOR_BOMBS =	$46	; hue 4 luma 3 = red
    404 U00bc		       00 0e	   COLOR_SCORE =	$0E	; hue 0 luma 7 = white
