    427 U00bc							; ==============================================================================
    428 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    429 U00bc							; ==============================================================================
    430 U00bc							; Bank3 is the power-up bank. Its stub does:
    431 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    432 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    433 U00bc							; ==============================================================================
    434  10000 ????				       seg	code
    435  f000					      org	$F000
    436  f000
    437  f000							; --- 5-byte bankswitching pad ---
    438  f000							; After bank3's stub selects us, CPU arrives here.
    439  f000							; We jump over the pad into the real init code.
    440  f000		       a9 00		      lda	#0
    441  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    442  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    443  f008							; (NOT deletable: $F008 = GameStart is a
    444  f008							;  hardcoded cross-bank entry — bank1
    445  f008							;  stub `jmp $F008`; this jmp also keeps
    446  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    447  f008							;  fold-pad byte guard fires when it moves)
    448  f008							;  + F0xx landmarks fixed)
    449  f008
    450  f008				   GameStart
    451  f008		       78		      sei		; disable interrupts
    452  f009		       d8		      cld		; clear decimal mode
    453  f00a		       a2 ff		      ldx	#$FF
    454  f00c		       9a		      txs		; stack pointer = $FF
    455  f00d
    456  f00d							; --- Clear zero-page RAM ---
    457  f00d		       a9 00		      lda	#0
    458  f00f		       a2 80		      ldx	#$80
    459  f011				   .ClearZP
    460  f011		       95 00		      sta	$00,X
    461  f013		       e8		      inx
    462  f014		       d0 fb		      bne	.ClearZP
    463  f016
    464  f016							; --- Initialize game state ---
    465  f016		       a9 00		      lda	#0
    466  f018		       85 a3		      sta	Level
    467  f01a		       a9 03		      lda	#3
    468  f01c		       85 ac		      sta	PlayerLives
    469  f01e		       a9 05		      lda	#BOMBS_MAX
    470  f020		       85 f0		      sta	PlayerBombs
    471  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    472  f022		       a9 3c		      lda	#60
    473  f024		       85 ad		      sta	TickCounter
    474  f026		       a9 78		      lda	#120
    475  f028		       85 ae		      sta	BarLevel	; bar starts full
    476  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    477  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    478  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    479  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    480  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    481  f02a		       a9 ff		      lda	#$FF
    482  f02c		       85 8a		      sta	DropTarget
    483  f02e
    484  f02e							; --- Load first level (the title previews it on the live stage:
    485  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    486  f02e		       20 20 fc 	      jsr	LoadLevel
    487  f031
    488  f031							; --- Set player color ---
    489  f031		       a9 48		      lda	#COLOR_PLAYER
    490  f033		       85 06		      sta	COLUP0
    491  f035
    492  f035							; --- Set playfield to reflected mode + priority ---
    493  f035							; D0=1 = reflect (left half mirrors to right)
    494  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    495  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    496  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    497  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    498  f037		       85 0a		      sta	CTRLPF
    499  f039
    500  f039							; ==============================================================================
    501  f039							; Frame loop
    502  f039							; ==============================================================================
    503  f039				   StartFrame
    504  f039
    505  f039							; ------------------------------------------------------------------------------
    506  f039							; VSYNC (3 scanlines)
    507  f039							; ------------------------------------------------------------------------------
    508  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    509  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    510  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    511  f039							; does not advance the wall clock to the next scanline boundary (it is already
    512  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    513  f039							; fraction depends on where the previous frame's overscan happened to end) —
    514  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    515  f039							;
    516  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    517  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    518  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    519  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    520  f039							; the sim wall-model target is updated to match.
    521  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    522  f03b		       a9 02		      lda	#2
    523  f03d		       85 00		      sta	VSYNC
    524  f03f		       85 02		      sta	WSYNC
    525  f041		       85 02		      sta	WSYNC
    526  f043		       85 02		      sta	WSYNC
    527  f045		       a9 00		      lda	#0
    528  f047		       85 00		      sta	VSYNC
    529  f049
    530  f049							; ------------------------------------------------------------------------------
    531  f049							; VBLANK (37 scanlines)
    532  f049							; ------------------------------------------------------------------------------
    533  f049		       a9 02		      lda	#2
    534  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    535  f04d
    536  f04d							; --- Set TIM64T for VBLANK ---
    537  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    538  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    539  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    540  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    541  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    542  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    543  f04d							; Worst 1059c of the 1472c window = 413c margin.
    544  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    545  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    546  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    547  f04d		       a9 17		      lda	#23
    548  f04f		       8d 96 02 	      sta	TIM64T
    549  f052
    550  f052							; --- Position player sprite horizontally ---
    551  f052		       a5 80		      lda	RoomX
    552  f054		       38		      sec
    553  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    554  f057		       a2 00		      ldx	#0	; X=0 = player0
    555  f059		       20 0f ff 	      jsr	SetObjectXPos
    556  f05c
    557  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    558  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    559  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    560  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    561  f05c
    562  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    563  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    564  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    565  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    566  f05c
    567  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    568  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    569  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    570  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    571  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    572  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    573  f05c		       20 19 f6 	      jsr	SelectActiveObject
    574  f05f
    575  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    576  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    577  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    578  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    579  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    580  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    581  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    582  f062
    583  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    584  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    585  f062							; 2026-10-04 up-exit fix). The
    586  f062							; old per-frame VBL fold that re-read the same ROM byte is
    587  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    588  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    589  f062							; the VBL path (the read that made a bank3 data move need another
    590  f062							; reader). test_band_restage covers the contract.
    591  f062
    592  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    593  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    594  f062							; Dark room: black except the existing explosion blink (state=2).
    595  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    596  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    597  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    598  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    599  f062		       a5 b5		      lda	BombPacked
    600  f064		       29 03		      and	#%00000011
    601  f066		       c9 02		      cmp	#2
    602  f068		       f0 0a		      beq	.BgBlink
    603  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    604  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    605  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    606  f071		       4c 84 f0 	      jmp	.BgStore
    607  f074				   .BgBlink
    608  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    609  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    610  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    611  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    612  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    613  f074		       a9 3c		      lda	#60
    614  f076		       38		      sec
    615  f077		       e5 f7		      sbc	BombTimer
    616  f079		       29 03		      and	#3
    617  f07b		       a8		      tay
    618  f07c		       b9 e5 f5 	      lda	BombBlinkColors,Y
    619  f07f		       4c 84 f0 	      jmp	.BgStore
    620  f082				   .BgIdle
    621  f082		       a9 00		      lda	#COLOR_CAVE_BG
    622  f084				   .BgStore
    623  f084		       85 09		      sta	COLUBK
    624  f086
    625  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    626  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    627  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    628  f086							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    629  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    630  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    631  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    632  f086		       20 c1 f9 	      jsr	PositionBallM1
    633  f089
    634  f089							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    635  f089							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    636  f089							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    637  f089							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    638  f089							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    639  f089							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    640  f089							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    641  f089							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    642  f089		       a5 c2		      lda	EnemyRamP
    643  f08b		       29 f0		      and	#$F0
    644  f08d		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    645  f08f		       4a		      lsr
    646  f090		       4a		      lsr
    647  f091		       4a		      lsr
    648  f092		       4a		      lsr		; A = p (1..15)
