------- FILE kernel.asm
      3  10000 ????
      4  10000 ????						; ==============================================================================
      5  10000 ????						; savior kernel — HERO-style fixed-time rendering kernel
      6  10000 ????						; ==============================================================================
      7  10000 ????						; A from-scratch Atari 2600 kernel modeled after Activision's HERO.
      8  10000 ????						;
      9  10000 ????						; Architecture:
     10  10000 ????						;   - 4K ROM at $F000-$FFFF (no bankswitching)
     11  10000 ????						;   - Kernel renders 192 visible scanlines: 144 cave + 48 HUD
     12  10000 ????						;   - Cave: 3 tile rows × 48 scanlines each
     13  10000 ????						;   - Reflected playfield (CTRLPF D0=1) — symmetric cave
     14  10000 ????						;   - GRP0 = player (square sprite), GRP1 = future objects
     15  10000 ????						;   - Per-scanline kernel with WSYNC for stable timing
     16  10000 ????						;   - PF registers written ONCE per tile row (TIA persists)
     17  10000 ????						;   - Overscan: input handling + game logic
     18  10000 ????						;
     19  10000 ????						; Frame timing (262 scanlines @ 60Hz NTSC):
     20  10000 ????						;   VSYNC     3 lines
     21  10000 ????						;   VBLANK   37 lines	(game logic + positioning)
     22  10000 ????						;   Kernel  192 lines	(144 cave + 48 HUD)
     23  10000 ????						;   Overscan  30 lines (input + movement)
     24  10000 ????						;   Total   262 lines
     25  10000 ????						;
     26  10000 ????						; Key difference from naive kernels:
     27  10000 ????						;   The inner .Line loop is UNCONDITIONAL — no per-scanline branches for
     28  10000 ????						;   sprite visibility. The player check uses a compare+branch that costs
     29  10000 ????						;   16c (off-screen) or 19c (on-screen), both well within the 76-cycle
     30  10000 ????						;   budget. PF registers are written once per tile row, not per scanline.
     31  10000 ????						; ==============================================================================
     32  10000 ????
     33  10000 ????						; --- TIA write addresses ---
     34  10000 ????		00 00	    VSYNC      =	$00
     35  10000 ????		00 01	    VBLANK     =	$01
     36  10000 ????		00 02	    WSYNC      =	$02
     37  10000 ????		00 04	    NUSIZ0     =	$04
     38  10000 ????		00 05	    NUSIZ1     =	$05
     39  10000 ????		00 06	    COLUP0     =	$06
     40  10000 ????		00 07	    COLUP1     =	$07
     41  10000 ????		00 08	    COLUPF     =	$08
     42  10000 ????		00 09	    COLUBK     =	$09
     43  10000 ????		00 0a	    CTRLPF     =	$0A
     44  10000 ????		00 0b	    REFP0      =	$0B
     45  10000 ????		00 0c	    REFP1      =	$0C
     46  10000 ????		00 0d	    PF0        =	$0D
     47  10000 ????		00 0e	    PF1        =	$0E
     48  10000 ????		00 0f	    PF2        =	$0F
     49  10000 ????		00 10	    RESP0      =	$10
     50  10000 ????		00 11	    RESP1      =	$11
     51  10000 ????		00 1b	    GRP0       =	$1B
     52  10000 ????		00 1c	    GRP1       =	$1C
     53  10000 ????		00 1d	    ENAM0      =	$1D
     54  10000 ????		00 1e	    ENAM1      =	$1E
     55  10000 ????		00 1f	    ENABL      =	$1F
     56  10000 ????		00 20	    HMP0       =	$20
     57  10000 ????		00 21	    HMP1       =	$21
     58  10000 ????		00 22	    HMM0       =	$22
     59  10000 ????		00 23	    HMM1       =	$23
     60  10000 ????		00 24	    HMBL       =	$24
     61  10000 ????		00 25	    VDELP0     =	$25
     62  10000 ????		00 26	    VDELP1     =	$26
     63  10000 ????		00 2a	    HMOVE      =	$2A
     64  10000 ????		00 2b	    HMCLR      =	$2B
     65  10000 ????		00 2c	    CXCLR      =	$2C
     66  10000 ????		00 15	    AUDC0      =	$15
     67  10000 ????		00 16	    AUDC1      =	$16
     68  10000 ????		00 17	    AUDF0      =	$17
     69  10000 ????		00 18	    AUDF1      =	$18
     70  10000 ????		00 19	    AUDV0      =	$19
     71  10000 ????		00 1a	    AUDV1      =	$1A
     72  10000 ????
     73  10000 ????						; --- TIA read addresses ---
     74  10000 ????		02 80	    SWCHA      =	$0280
     75  10000 ????		02 82	    SWCHB      =	$0282
     76  10000 ????		00 0c	    INPT4      =	$0C	; fire button, D7: 0=pressed, 1=released
     77  10000 ????						; (HERO reads BIT $0C; must match bank1 EQU)
     78  10000 ????
     79  10000 ????						; --- RIOT addresses ---
     80  10000 ????		02 96	    TIM64T     =	$0296
     81  10000 ????		02 84	    INTIM      =	$0284
     82  10000 ????
     83  10000 ????						; ==============================================================================
     84  10000 ????						; Zero-page variables ($80-$FF)
     85  10000 ????						; ==============================================================================
     86 U00bc ????				      seg.u	Variables
     87 U0080					      org	$80
     88 U0080
     89 U0080		       00	   RoomX      byte.b		; player X position (0-159)
     90 U0081		       00	   RoomY      byte.b		; player Y position (0-191)
