   1588  f40e		       a5 88		      lda	Temp
   1589  f410		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1590  f412		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1591  f415		       4c 32 f4 	      jmp	UE_Next
   1592  f418				   UE_SnakeRight
