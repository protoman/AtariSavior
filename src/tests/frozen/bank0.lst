   1376  f371				   .SDAir
   1377  f371		       a5 b5		      lda	BombPacked
   1378  f373		       29 7f		      and	#%01111111	; still falling — not ground
   1379  f375		       85 b5		      sta	BombPacked
   1380  f377		       60		      rts
   1381  f378				   .SDBottom
   1382  f378		       20 db f4 	      jsr	ExitRoomDown
   1383  f37b		       a5 81		      lda	RoomY
   1384  f37d		       c9 84		      cmp	#PLAYER_MAX_Y
