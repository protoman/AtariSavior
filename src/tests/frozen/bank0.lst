   1389  f371				   .SDAir
   1390  f371		       a5 b5		      lda	BombPacked
   1391  f373		       29 7f		      and	#%01111111	; still falling — not ground
   1392  f375		       85 b5		      sta	BombPacked
   1393  f377		       60		      rts
   1394  f378				   .SDBottom
   1395  f378		       20 d9 fb 	      jsr	ExitRoomDown
