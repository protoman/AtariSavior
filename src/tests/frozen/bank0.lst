    254 U00bc							; Rect cache RETIRED (plan C4 / cell_collision_plan 7.1, 2026-10-20).
    255 U00bc							; The solid rect list is no longer emitted and no walker reads a cache:
    256 U00bc							; PlayerHitsMap, LaserWallClamp, the moth walk and BombMarkWalls all test
    257 U00bc							; PF cells. $CC-$DF are FREE (20 B, the "option A" ZP reclaim); $89 stays
    258 U00bc							; allocated as ZPSpare89 so the sequential block above does not shift.
    259 U00bc							; History worth keeping: the cache lived at $CC-$DF because bank1's HUD
    260 U00bc							; writes $E0-$EF every frame — rect4.h on $E0 was zeroed by scorePtr1 and
    261 U00bc							; probes walked through rect4 walls (the $E0 stomp-zone rule still applies
    262 U00bc							; to every persistent byte).
    263 U00bc							; Buffers packed: PF0 $C3-$C5, PF1 $C6-$C8, PF2 $C9-$CB (rows 0-2 only).
    264 U00bc							; ($E0/$E1 are spare/stomp-zone — never persistent bank0 state.)
    265 U00bc
    266 U00bc							; PF cave buffers (copied from ROM during VBLANK, read by kernel via absolute indexed)
    267 U00bc							; These share ZP space with bank1's HUD variables — safe because bank1
    268 U00bc							; runs AFTER the cave kernel. Bank1 overwrites them during HUD band;
    269 U00bc							; VBLANK re-populates them before the next kernel frame.
    270 U00bc		       00 c3	   PF0Buf     =	$C3	; 4 bytes: TilePF0 rows 0-3 (N=4 bands, stride 4)
    271 U00bc							; (rows pure since S3.4 — Y moved to $E2)
    272 U00bc		       00 c7	   PF1Buf     =	$C7	; rows 0-3 (stride 4 — label-based readers only)
    273 U00bc		       00 bc	   RoomBandColor =	$BC	; band-color cache (level_bank_plan P2.5) —
    274 U00bc							; own byte since S3.1 (was $D2 = PF1Buf[3];
    275 U00bc							; history: FIX 2026-09-28 was $D1 = PF1Buf[2]
    276 U00bc							; collision → mid-wall gap; alias class now
    277 U00bc							; gone entirely). Writer: VBLANK stage AFTER
    278 U00bc							; LoadPFBuffer/BuildColupF (fold from
    279 U00bc							; LevelEnemy+RoomNo*4+3). Readers: kernel
    280 U00bc							; .WaterRow (direct lda, plain abs = 4c any
    281 U00bc							; address) + overscan CheckBandTouch. Window:
    282 U00bc							; VBL write → kernel + overscan read same
    283 U00bc							; frame ($BC is nobody else's byte) → next
    284 U00bc							; VBL restages.
    285 U00bc		       00 cb	   PF2Buf     =	$CB	; rows 0-3 (stride 4)
    286 U00bc		       00 d3	   ColupfBuf  =	$D3	; 4 bytes: final COLUPF per band (stripe+hot).
    287 U00bc							; Moved out of the $E7 window with the N=4
    288 U00bc							; migration (was $E7; $ED-$EF BandTab now $CF
    289 U00bc							; and BombX $F0 blocked the grow) — inside the
    290 U00bc							; free retired-rect-cache window, so it is no
    291 U00bc							; longer a bank1-stomp-zone exception.
    292 U00bc		       00 e5	   FetchPtr   =	$E5	; fold-indirect pointer ($E5 lo, $E6 hi) —
    293 U00bc							; MOVED S3.2 to free $E0 for rect4.h (cache
    294 U00bc							; $CD-$E0 now uniform). Sits in bank1's
    295 U00bc							; stomp zone (scorePtr3-hi/scorePtr4-lo) —
    296 U00bc							; time-partitioned: bank0 stages only inside
    297 U00bc							; VBL/overscan batches, bank1 rebuilds in
    298 U00bc							; HUD after both windows. Contract (fold
    299 U00bc							; wins): stage addr immediately before a
    300 U00bc							; FoldIndirect batch.
    301 U00bc		       00 cf	   BandTab    =	$CF	; N=4: per-band ENABL gate (4 bytes $CF-$D2)
    302 U00bc							; ($ff = ball band, $00 = mirror). Written
    303 U00bc							; by bank3 StageBandTab (BuildColupF tail,
    304 U00bc							; every VBL) BEFORE this frame's cave; read
    305 U00bc							; by .Row's ENABL gate. Moved off $ED (BombX
    306 U00bc							; is $F0) into the retired-rect-cache window.
    307 U00bc							; Enemy RAM shadow — live X/Y + packed flags. ROM records are read-only.
    308 U00bc							; Sequential vars end at $BB (ObjBot removed S3.0b); $BC = RoomBandColor,
    309 U00bc							; $BD-$BF EnemyRam, $C0 LaserState, $C1-$C2 EnemyRamD/P.
    310 U00bc							; Score lives at $F3-$F5 only ($F6/$F7 = BombX/BombTimer).
    311 U00bc							; EnemyRamY ($E2, 3B) — private bytes since S3.4 (was an alias over
    312 U00bc							; PF0Buf rows 0-2). It deliberately sits INSIDE bank1's HUD stomp zone
    313 U00bc							; ($E0-$EF score ptrs, written every frame) because every write and every
    314 U00bc							; read land inside one safe window:
    315 U00bc							;   [HUD stomp $E2-$E4] → [overscan: RefreshEnemyY/LoadEnemyRam WRITE]
    316 U00bc							;   → [CEH / Laser / moth READ] → [next VBL: SelectActiveObject READ]
    317 U00bc							;   → [HUD stomp ...]. No reader ever sits between the stomp and the write.
    318 U00bc							;   writers: RefreshEnemyY via DeriveEnemyY (overscan entry, EVERY frame —
    319 U00bc							;	      live Y is derived from ROM spawn + EnemyRamP clock, no stored
    320 U00bc							;	      movement state) + LoadEnemyRam (EnterRoom init);
    321 U00bc							;   readers: SelectActiveObject (VBLANK), CheckEnemyHit + LaserHitTest +
    322 U00bc							;	      moth walk (overscan, after the refresh).
    323 U00bc							; Effect: $C3-$C5 = pure PF0Buf rows 0-2, never stomped → the per-frame
    324 U00bc							;   VBL repair (LoadPF0Only, ~130c + 3 folds) is deleted; full
    325 U00bc							;   LoadPFBuffer runs only on EnterRoom (PF1/PF2 rows 0-2 likewise have
    326 U00bc							;   no per-frame writer). bank1 owns $E0-$EF during HUD; bank0 never keeps
    327 U00bc							;   other persistent state there (FetchPtr $E0/$E1 = staged only).
    328 U00bc		       00 bd	   EnemyRamX  =	$BD	; 3 bytes: live X per enemy ($BD-$BF, slots 0-2
    329 U00bc							; only — enemies+lamps capped at 3 by editor
    330 U00bc							; kMaxRoomElements, convert_level MAX_ENEMIES,
    331 U00bc							; verify_build; slot 3 would collide with $C0)
    332 U00bc		       00 c0	   LaserState =	$C0	; laser: b7 fire held this frame,
    333 U00bc							;   b6 fire held last frame (press-edge),
    334 U00bc							;   b5-2 RoomDarkMask rooms 4-7,
    335 U00bc							;   b1 beam gate for the kernel .Line
    336 U00bc							;     (PlayerColTable bit1 on the beam row shares b1; mirror of b7)
    337 U00bc		       00 c1	   EnemyRamD  =	$C1	; dir bits 0-3 = enemy 0-3 (1=right, 0=left)
    338 U00bc		       00 c2	   EnemyRamP  =	$C2	; bits0-3 moth phase (shared/sync); bits4-7
    339 U00bc							;   vdir for spider/bat/tentacle (1=down)
    340 U00bc		       00 d7	   EnemyClk   =	$D7	; 2026-10-26 ENEMY clock: every enemy gate / bob reads
    341 U00bc							;   this, NOT EnemyRamP/TickCounter (those also drive
    342 U00bc							;   the walk cycle, tide, hcrunch, laser tone). One
    343 U00bc							;   UpdateEnemies PASS = one tick; passes per frame =
    344 U00bc							;   EnemySpd / 2 (x1 .. x3 by level: tools/test_enemy_speed.py)
    345 U00bc		       00 d8	   EnemySpd   =	$D8	; half-units per frame: 2 + Level / 5 (x1, x1.5, x2 ...)
    346 U00bc		       00 d9	   EnemyFrac  =	$D9	; 0/1 carry of the half-unit accumulator
    347 U00bc		       00 10	   UE_MIN_INTIM =	16	; TIM64T units (64c) of overscan an EXTRA enemy pass needs left
    348 U00bc		       00 da	   EnemyPass  =	$DA	; passes left this frame
    349 U00bc							; Attract mode (2026-11, bank5 DemoHook). StickA / DemoOn are EOR-ed onto the real
    350 U00bc							; SWCHA / INPT4 reads in the three gameplay readers (main joystick read, walk
    351 U00bc							; frame pick, LaserInput): 0 = no effect; the demo script sets a bit to "press"
    352 U00bc							; it (the real controller is neutral during the demo, else the demo aborts).
