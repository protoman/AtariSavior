   2621  f961		       98		      tya		; A = visible_left
   2622  f962		       18		      clc
   2623  f963		       69 06		      adc	#PLAYER_WIDTH - 1
   2624  f965		       4a		      lsr
   2625  f966		       4a		      lsr
   2626  f967		       c9 14		      cmp	#TILE_COLUMNS
   2627  f969		       90 07		      bcc	.lastOk
