    804  f0d4							; ==============================================================================
    805  f0d4							; Kernel: 192 visible scanlines
    806  f0d4							; ==============================================================================
    807  f0d4							; Structure:
    808  f0d4							;   .Row (×3): set PF registers once per color band, init scanline counter
    809  f0d4							;   .Line (×48): render one scanline — sprite check + loop control
    810  f0d4							;
    811  f0d4							; PF registers persist in TIA, so writing once per tile row is sufficient.
    812  f0d4							; The inner .Line loop has NO PF writes — only sprite rendering.
    813  f0d4							; ==============================================================================
    814  f0d4
    815  f0d4							; --- Kernel entry: title/cave dispatch (TIA inits live in VBL tail) ---
