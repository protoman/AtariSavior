   2728  f994		       3d b7 fd 	      and	ColMask,X	; bit for this source col
   2729  f997		       d0 13		      bne	.CWHit	; solid (Z=0)
   2730  f999		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2731  f99b		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2732  f99d		       e8		      inx
