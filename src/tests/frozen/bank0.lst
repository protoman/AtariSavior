   2048  f588							; BombTick — per-frame state machine (overscan).
   2049  f588							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2050  f588							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2051  f588							; ------------------------------------------------------------------------------
   2052  f588				   BombTick   subroutine
   2053  f588		       a5 b5		      lda	BombPacked
   2054  f58a		       29 03		      and	#%00000011	; state
   2055  f58c		       f0 41		      beq	.BTDone	; none
   2056  f58e		       c9 01		      cmp	#1
   2057  f590		       f0 0f		      beq	.BTFuse
   2058  f592							; state 2 — exploding
   2059  f592		       c6 f7		      dec	BombTimer
   2060  f594		       d0 39		      bne	.BTDone
   2061  f596		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2062  f598		       29 fc		      and	#%11111100
   2063  f59a		       85 b5		      sta	BombPacked
   2064  f59c		       a9 00		      lda	#0
   2065  f59e		       85 f7		      sta	BombTimer
   2066  f5a0		       60		      rts
   2067  f5a1				   .BTFuse
   2068  f5a1		       c6 f7		      dec	BombTimer
   2069  f5a3		       d0 2a		      bne	.BTDone
   2070  f5a5		       a5 b5		      lda	BombPacked	; 1 → 2
   2071  f5a7		       29 fc		      and	#%11111100
   2072  f5a9		       09 02		      ora	#%00000010
   2073  f5ab		       85 b5		      sta	BombPacked
   2074  f5ad		       a9 3c		      lda	#60
   2075  f5af		       85 f7		      sta	BombTimer
   2076  f5b1		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2077  f5b4		       aa		      tax
   2078  f5b5		       f0 08		      beq	.BTNoScore
   2079  f5b7				   .BTScore
   2080  f5b7		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2081  f5b9		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2082  f5bc		       ca		      dex
   2083  f5bd		       d0 f8		      bne	.BTScore
   2084  f5bf				   .BTNoScore
   2085  f5bf		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2086  f5c2		       f0 05		      beq	.BTNoKill
