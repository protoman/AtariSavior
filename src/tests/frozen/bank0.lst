   1025  f196
   1026  f196							; --- Read joystick ---
   1027  f196							; SWCHA bits: D4=up, D5=down, D6=left, D7=right (0=pressed)
   1028  f196							; After 4x LSR: D0=up, D1=down, D2=left, D3=right
   1029  f196		       ad 80 02 	      lda	SWCHA
   1030  f199		       4a		      lsr		; shift joystick 0 bits to D0-D3
   1031  f19a		       4a		      lsr
   1032  f19b		       4a		      lsr
   1033  f19c		       4a		      lsr
   1034  f19d		       85 88		      sta	Temp	; save shifted joystick bits
