   3769  ff33							; ------------------------------------------------------------------------------
   3770  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3771  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3772  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3773  ff33							; user spec: no piercing, no HERO comparison needed).
   3774  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3775  ff33							;						  left	RoomX-4)
   3776  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3777  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3778  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3779  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3780  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3781  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3782  ff33							;     priority over M0 anyway).
   3783  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3784  ff33							;     press edge re-anchors).
   3785  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3786  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3787  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3788  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   3789  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3790  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3791  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3792  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3793  ff33							; ------------------------------------------------------------------------------
   3794  ff33				   LaserInput
   3795  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3796  ff35		       8a		      txa
   3797  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3798  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3799  ff3a		       8a		      txa
   3800  ff3b		       29 80		      and	#LASER_HELD
   3801  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3802  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3803  ff40		       85 c0		      sta	LaserState
   3804  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3805  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3806  ff46							; below — moved here so the cap code could
   3807  ff46							; not push .LaserReleased past bmi's ±127)
   3808  ff46				   .LaserReleased
   3809  ff46		       a9 00		      lda	#0
   3810  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   3811  ff4a							; otherwise -> bars slid across screen
   3812  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   3813  ff4b				   .LaserFire
   3814  ff4b		       a5 c0		      lda	LaserState
   3815  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   3816  ff4f		       85 c0		      sta	LaserState
   3817  ff51		       8a		      txa
   3818  ff52		       29 80		      and	#LASER_HELD
   3819  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   3820  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   3821  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   3822  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   3823  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   3824  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   3825  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   3826  ff56		       a5 c0		      lda	LaserState
   3827  ff58		       29 01		      and	#LASER_REARM
   3828  ff5a		       f0 04		      beq	.LAdvStep
