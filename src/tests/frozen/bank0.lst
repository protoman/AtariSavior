    446 U00bc							; ==============================================================================
    447 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    448 U00bc							; ==============================================================================
    449 U00bc							; Bank3 is the power-up bank. Its stub does:
    450 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    451 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    452 U00bc							; ==============================================================================
    453  10000 ????				       seg	code
    454  f000					      org	$F000
    455  f000
    456  f000							; --- 5-byte bankswitching pad ---
    457  f000							; After bank3's stub selects us, CPU arrives here.
    458  f000							; We jump over the pad into the real init code.
    459  f000		       a9 00		      lda	#0
    460  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    461  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    462  f008							; (NOT deletable: $F008 = GameStart is a
    463  f008							;  hardcoded cross-bank entry — bank1
    464  f008							;  stub `jmp $F008`; this jmp also keeps
    465  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    466  f008							;  fold-pad byte guard fires when it moves)
    467  f008							;  + F0xx landmarks fixed)
    468  f008
    469  f008				   GameStart
    470  f008		       78		      sei		; disable interrupts
    471  f009		       d8		      cld		; clear decimal mode
    472  f00a		       a2 ff		      ldx	#$FF
    473  f00c		       9a		      txs		; stack pointer = $FF
    474  f00d
    475  f00d							; --- Clear zero-page RAM ---
    476  f00d		       a9 00		      lda	#0
    477  f00f		       a2 80		      ldx	#$80
    478  f011				   .ClearZP
    479  f011		       95 00		      sta	$00,X
    480  f013		       e8		      inx
    481  f014		       d0 fb		      bne	.ClearZP
    482  f016
    483  f016							; --- Initialize game state ---
    484  f016		       a9 00		      lda	#0
    485  f018		       85 a3		      sta	Level
    486  f01a		       a9 03		      lda	#3
    487  f01c		       85 ac		      sta	PlayerLives
    488  f01e		       a9 05		      lda	#BOMBS_MAX
    489  f020		       85 f0		      sta	PlayerBombs
    490  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    491  f022		       a9 3c		      lda	#60
    492  f024		       85 ad		      sta	TickCounter
    493  f026		       a9 78		      lda	#120
    494  f028		       85 ae		      sta	BarLevel	; bar starts full
    495  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    496  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    497  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    498  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    499  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    500  f02a		       a9 ff		      lda	#$FF
    501  f02c		       85 8a		      sta	DropTarget
    502  f02e
    503  f02e							; --- Load first level (the title previews it on the live stage:
    504  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    505  f02e		       20 20 fc 	      jsr	LoadLevel
    506  f031
    507  f031							; --- Set player color ---
    508  f031		       a9 48		      lda	#COLOR_PLAYER
    509  f033		       85 06		      sta	COLUP0
    510  f035
    511  f035							; --- Set playfield to reflected mode + priority ---
    512  f035							; D0=1 = reflect (left half mirrors to right)
    513  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    514  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    515  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    516  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    517  f037		       85 0a		      sta	CTRLPF
    518  f039
    519  f039							; ==============================================================================
    520  f039							; Frame loop
    521  f039							; ==============================================================================
    522  f039				   StartFrame
    523  f039
    524  f039							; ------------------------------------------------------------------------------
    525  f039							; VSYNC (3 scanlines)
    526  f039							; ------------------------------------------------------------------------------
    527  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    528  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    529  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    530  f039							; does not advance the wall clock to the next scanline boundary (it is already
    531  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    532  f039							; fraction depends on where the previous frame's overscan happened to end) —
    533  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    534  f039							;
    535  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    536  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    537  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    538  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    539  f039							; the sim wall-model target is updated to match.
    540  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    541  f03b		       a9 02		      lda	#2
    542  f03d		       85 00		      sta	VSYNC
    543  f03f		       85 02		      sta	WSYNC
    544  f041		       85 02		      sta	WSYNC
    545  f043		       85 02		      sta	WSYNC
    546  f045		       a9 00		      lda	#0
    547  f047		       85 00		      sta	VSYNC
    548  f049
    549  f049							; ------------------------------------------------------------------------------
    550  f049							; VBLANK (37 scanlines)
    551  f049							; ------------------------------------------------------------------------------
    552  f049		       a9 02		      lda	#2
    553  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    554  f04d
    555  f04d							; --- Set TIM64T for VBLANK ---
    556  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    557  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    558  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    559  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    560  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    561  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    562  f04d							; Worst 1059c of the 1472c window = 413c margin.
    563  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    564  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    565  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    566  f04d		       a9 17		      lda	#23
    567  f04f		       8d 96 02 	      sta	TIM64T
    568  f052
    569  f052							; --- Position player sprite horizontally ---
    570  f052		       a5 80		      lda	RoomX
    571  f054		       38		      sec
    572  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    573  f057		       a2 00		      ldx	#0	; X=0 = player0
    574  f059		       20 0f ff 	      jsr	SetObjectXPos
    575  f05c
    576  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    577  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    578  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    579  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    580  f05c
    581  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    582  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    583  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    584  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    585  f05c
    586  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    587  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    588  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    589  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    590  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    591  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    592  f05c		       20 2b f6 	      jsr	SelectActiveObject
    593  f05f
    594  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    595  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    596  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    597  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    598  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    599  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    600  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    601  f062
    602  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    603  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    604  f062							; 2026-10-04 up-exit fix). The
    605  f062							; old per-frame VBL fold that re-read the same ROM byte is
    606  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    607  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    608  f062							; the VBL path (the read that made a bank3 data move need another
    609  f062							; reader). test_band_restage covers the contract.
    610  f062
    611  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    612  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    613  f062							; Dark room: black except the existing explosion blink (state=2).
    614  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    615  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    616  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    617  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    618  f062		       a5 b5		      lda	BombPacked
    619  f064		       29 03		      and	#%00000011
    620  f066		       c9 02		      cmp	#2
    621  f068		       f0 0a		      beq	.BgBlink
    622  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    623  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    624  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    625  f071		       4c 84 f0 	      jmp	.BgStore
    626  f074				   .BgBlink
    627  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    628  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    629  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    630  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    631  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    632  f074		       a9 3c		      lda	#60
    633  f076		       38		      sec
    634  f077		       e5 f7		      sbc	BombTimer
    635  f079		       29 03		      and	#3
    636  f07b		       a8		      tay
    637  f07c		       b9 f5 f5 	      lda	BombBlinkColors,Y
    638  f07f		       4c 84 f0 	      jmp	.BgStore
    639  f082				   .BgIdle
    640  f082		       a9 00		      lda	#COLOR_CAVE_BG
    641  f084				   .BgStore
    642  f084		       85 09		      sta	COLUBK
    643  f086
    644  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    645  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    646  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    647  f086							; M1X (LevelEnemySpare2; 0 → no M1) — ball selector 4, M1 selector 3,
    648  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    649  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    650  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
