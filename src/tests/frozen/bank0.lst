   2302  f69c							; No objects this frame: A = Temp = 0. Blank the sprite AND reset the
   2303  f69c							; flicker counter — with no objects the modulo below never runs, so
   2304  f69c							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   2305  f69c							; would run O(FlickerFrame) iterations in the VBL on the next room with
   2306  f69c							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   2307  f69c		       85 b4		      sta	FlickerFrame
