   4783  ffec		       8d f7 1f 	      sta	$1FF7	; select bank3 (record stream lives there)
   4784  ffef		       4c f8 f8 	      jmp	$F8F8	; bank3 HotOverlapBody (synced by verify_build)
   4785  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   4786  fff2
   4787  fff2							; ------------------------------------------------------------------------------
   4788  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   4789  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   4790  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   4791  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   4792  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   4793  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   4794  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   4795  fff2							;   One less push level too (no fold / no pad call inside the body).
   4796  fff2							;   Full behavior docs moved with the body.
   4797  fff2							; ------------------------------------------------------------------------------
