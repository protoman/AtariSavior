   2536  f95a		       a9 27		      lda	#39
   2537  f95c		       38		      sec
   2538  f95d		       e5 8b		      sbc	CollisionX
   2539  f95f				   .firstOk
   2540  f95f		       85 8e		      sta	CollisionEndX	; min text column
   2541  f961
