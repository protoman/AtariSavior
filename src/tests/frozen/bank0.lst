   1547  f429							; ------------------------------------------------------------------------------
   1548  f429							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1549  f429							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1550  f429							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1551  f429							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1552  f429							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1553  f429							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1554  f429							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1555  f429							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1556  f429							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1557  f429							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1558  f429							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1559  f429							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1560  f429							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1561  f429							; ------------------------------------------------------------------------------
   1562  f429				   UE_Tentacle
   1563  f429		       a5 ad		      lda	TickCounter
   1564  f42b		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1565  f42d							; = half the player's 1 px/frame (user
   1566  f42d							; 2026-10-10: &3 read as chunky/slow)
   1567  f42d		       d0 4b		      bne	.TentOut
   1568  f42f		       b5 bd		      lda	EnemyRamX,X
   1569  f431		       c5 80		      cmp	RoomX
   1570  f433		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1571  f435		       90 06		      bcc	.TentRight
   1572  f437		       38		      sec
   1573  f438		       e9 01		      sbc	#1	; step left
   1574  f43a		       4c 40 f4 	      jmp	.TentProbe
   1575  f43d				   .TentRight
   1576  f43d		       18		      clc
   1577  f43e		       69 01		      adc	#1	; step right
   1578  f440				   .TentProbe
   1579  f440		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1580  f442		       b0 36		      bcs	.TentOut
   1581  f444		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1582  f446							; Same-column cull: committed X is always probe-clear, so a candidate in
   1583  f446							; the same 4px column covers the same collision cells → result is known
   1584  f446							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1585  f446		       a5 88		      lda	Temp
   1586  f448		       55 bd		      eor	EnemyRamX,X
   1587  f44a		       29 fc		      and	#$FC
   1588  f44c		       f0 28		      beq	.TentCommit
   1589  f44e		       a5 80		      lda	RoomX
   1590  f450		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1591  f452		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1592  f454		       85 b8		      sta	ActiveObjectY
   1593  f456		       a5 88		      lda	Temp
   1594  f458		       c9 05		      cmp	#5
   1595  f45a		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1596  f45c							; PHM's negative visible-left wraps to 255
   1597  f45c							; (col garbage / ColOff OOB walk). cand<=4
   1598  f45c							; ink pokes off-screen anyway; RoomX=cand
   1599  f45c							; already covers cell0.
   1600  f45c		       38		      sec
   1601  f45d		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1602  f45f							; sits 5/7 px left of A (moth .Mvl convention,
   1603  f45f							; bank2), but PHM's PLAYER prologue derives
   1604  f45f							; lit-left = arg-4/arg-7 with the bin on
   1605  f45f							; RoomX-PlayerDir → box missed the cell left
   1606  f45f							; of the ink at cand 8/12 (sprite drew 1 px
   1607  f45f							; into the wall — bugs.md #4). cand-1 shifts
   1608  f45f							; the tested box 1 px left: cell-exact or 1 px
   1609  f45f							; conservative for every cand/facing pair
   1610  f45f							; (tools/test_cell_map.py tentacle section).
   1611  f45f				   .TentProbeX
   1612  f45f		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1613  f461		       b5 e2		      lda	EnemyRamY,X
   1614  f463		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1615  f465		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1616  f467							; (rect walk ldx/dex/tax) — slot was lost here
   1617  f467		       20 26 f9 	      jsr	PlayerHitsMap
   1618  f46a		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1619  f46c		       a5 b8		      lda	ActiveObjectY
   1620  f46e		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1621  f470		       a5 b7		      lda	ActiveObjectX
   1622  f472		       85 80		      sta	RoomX	; restore player X
   1623  f474		       b0 04		      bcs	.TentOut	; wall → hold position
   1624  f476				   .TentCommit
   1625  f476		       a5 88		      lda	Temp
   1626  f478		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1627  f47a				   .TentOut
   1628  f47a		       4c 24 f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1629  f47d
   1630  f47d							; ------------------------------------------------------------------------------
   1631  f47d							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1632  f47d							; there is no free ZP byte for per-slot movement state (phase/direction live
   1633  f47d							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1634  f47d							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1635  f47d							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1636  f47d							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1637  f47d							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1638  f47d							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1639  f47d							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1640  f47d							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1641  f47d							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1642  f47d							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1643  f47d							;	    the 60-frame game timer — gates from it wrap every second).
   1644  f47d							; Other types: straight ROM y (their movement stages come later).
   1645  f47d							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1646  f47d							; ------------------------------------------------------------------------------
   1647  f47d				   DeriveEnemyY
   1648  f47d							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1649  f47d							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1650  f47d		       a5 b1		      lda	EnemyDataLo
   1651  f47f		       85 e5		      sta	FetchPtr
   1652  f481		       a5 b2		      lda	EnemyDataHi
