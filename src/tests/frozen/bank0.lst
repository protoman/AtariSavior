   1745  f535							; Level management
   1746  f535							; ==============================================================================
   1747  f535							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1748  f535							; LevelDataTable stride: 12 bytes (S4 2026-10-19: start_x/y dropped — they
   1749  f535							; were always the constants 32/24)
   1750  f535							;   +0: start_room
   1751  f535							;   +1..+3: miner_room (b7 = faces right), miner_x, miner_y
   1752  f535							;   +4..+5: pfdata ptr (lo, hi)
   1753  f535							;   +6..+7: conn ptr (lo, hi)
   1754  f535							;   +8..+9: enemy ptr (lo, hi)
   1755  f535							; ------------------------------------------------------------------------------
   1756  f535				   LoadLevel
   1757  f535							; Stage leave/reload/advance: walls return + bombs refill to 5
   1758  f535		       a9 00		      lda	#0
   1759  f537		       85 b5		      sta	BombPacked	; state + WallMask bits (D1-B: no $F2 mirror)
   1760  f539		       85 f7		      sta	BombTimer
   1761  f53b		       85 c1		      sta	EnemyRamD	; clear dir + RoomDarkMask (bits 4-7) — level reset
   1762  f53d		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1763  f53f							;  game-over restart = LoseLife->ReloadLevel->
   1764  f53f							;  here; same-stage respawn keeps facing)
   1765  f53f		       85 9c		      sta	Hover	; bugs.md #1: stage entry lands normally; the
   1766  f541							;   respawn hover is armed only by LoseLife
   1767  f541		       a5 c0		      lda	LaserState
   1768  f543		       29 c7		      and	#%11000111	; clear RoomDarkMask rooms 4-7 (LaserState b5-2)
   1769  f545		       85 c0		      sta	LaserState
   1770  f547		       a9 05		      lda	#BOMBS_MAX
   1771  f549		       85 f0		      sta	PlayerBombs
   1772  f54b		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the
   1773  f54d		       c9 ff		      cmp	#$FF	; title preview (HUD score shows level+1)
   1774  f54f		       f0 04		      beq	.NoBanner
   1775  f551		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1776  f553		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
   1777  f555				   .NoBanner
   1778  f555							; Compute LevelDataTable pointer: base + Level * 12
   1779  f555							; Stride 12: start_room(1) + miner(3) + wall_colors(2) + ptrs(3×2)
   1780  f555		       a5 a3		      lda	Level
   1781  f557		       0a		      asl		; *2
   1782  f558		       85 88		      sta	Temp	; Temp = L * 2
   1783  f55a		       0a		      asl		; *4
   1784  f55b		       0a		      asl		; *8
   1785  f55c		       18		      clc
   1786  f55d		       65 88		      adc	Temp	; *10
   1787  f55f		       65 88		      adc	Temp	; *12
   1788  f561		       a8		      tay		; Y = Level * 12
   1789  f562
   1790  f562							; --- Fold batch (P2.7): LevelDataTable lives in bank2 at the frozen
   1791  f562							; address. Stage FetchPtr immediately before the batch; FoldIndirect
   1792  f562							; preserves X and Y (iny flow below unchanged), returns the byte in A.
   1793  f562							; The ldx #0 is kept for callers that expect X clear on entry. ---
   1794  f562		       a9 00		      lda	#<LEVEL_DATA_ADDR
