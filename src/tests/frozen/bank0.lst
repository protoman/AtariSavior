   2060  f58d							; BombTick — per-frame state machine (overscan).
   2061  f58d							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2062  f58d							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2063  f58d							; ------------------------------------------------------------------------------
   2064  f58d				   BombTick   subroutine
   2065  f58d		       a5 b5		      lda	BombPacked
   2066  f58f		       29 03		      and	#%00000011	; state
   2067  f591		       f0 41		      beq	.BTDone	; none
   2068  f593		       c9 01		      cmp	#1
   2069  f595		       f0 0f		      beq	.BTFuse
   2070  f597							; state 2 — exploding
   2071  f597		       c6 f7		      dec	BombTimer
   2072  f599		       d0 39		      bne	.BTDone
   2073  f59b		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2074  f59d		       29 fc		      and	#%11111100
   2075  f59f		       85 b5		      sta	BombPacked
   2076  f5a1		       a9 00		      lda	#0
   2077  f5a3		       85 f7		      sta	BombTimer
   2078  f5a5		       60		      rts
   2079  f5a6				   .BTFuse
   2080  f5a6		       c6 f7		      dec	BombTimer
   2081  f5a8		       d0 2a		      bne	.BTDone
   2082  f5aa		       a5 b5		      lda	BombPacked	; 1 → 2
   2083  f5ac		       29 fc		      and	#%11111100
   2084  f5ae		       09 02		      ora	#%00000010
   2085  f5b0		       85 b5		      sta	BombPacked
   2086  f5b2		       a9 3c		      lda	#60
   2087  f5b4		       85 f7		      sta	BombTimer
   2088  f5b6		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2089  f5b9		       aa		      tax
   2090  f5ba		       f0 08		      beq	.BTNoScore
   2091  f5bc				   .BTScore
   2092  f5bc		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2093  f5be		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2094  f5c1		       ca		      dex
   2095  f5c2		       d0 f8		      bne	.BTScore
   2096  f5c4				   .BTNoScore
   2097  f5c4		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2098  f5c7		       f0 05		      beq	.BTNoKill
   2099  f5c9		       a9 50		      lda	#$50	; +50 per kill — moved out of the pad body
   2100  f5cb		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2101  f5ce				   .BTNoKill
   2102  f5ce		       20 d5 f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2103  f5d1		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2104  f5d4				   .BTDone
   2105  f5d4		       60		      rts
