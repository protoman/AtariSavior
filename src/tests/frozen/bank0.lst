   3927  fdad							; ------------------------------------------------------------------------------
   3928  fdad							; BuildColupF — 12-byte final COLUPF image at ColupfBuf ($E7-$F2).
   3929  fdad							;   Stripe: rows 0,2 = LevelWallColor; row 1 = LevelWallColor2.
   3930  fdad							;   Hot rows overwrite with the TickCounter-bit5 pulse (amber/red).
   3931  fdad							;   $F0-$F2 (bombs) NO LONGER overlap-saved: body writes rows 0-2 only,
   3932  fdad							;   save/restore round trip deleted (S3.0b — window audit: zero writers).
   3933  fdad							;   Bank1 clobbers $E0-$EF during HUD; VBLANK rebuilds every frame.
   3934  fdad							; ------------------------------------------------------------------------------
   3935  fdad							; ------------------------------------------------------------------------------
   3936  fdad							; BuildColupF — MOVED to bank2 (S5.1) — CallPad_BuildColupF.
   3937  fdad							;   Hot-rect data (RoomRects) lives in bank2, so the body reads it with
   3938  fdad							;   direct (FetchPtr),Y — the shared $FEF6 fold block's sta $1FF4 always
   3939  fdad							;   returns to bank0, so a fold inside a bank1 body could not work.
   3940  fdad							;   The dark check is inlined there too: CallPad_IsRoomDark cannot nest
   3941  fdad							;   from a pad body (ReturnPad switches to bank0 mid-call).
   3942  fdad							;   Body: bank2.asm, pinned at $FC4F. Entry save block ($F0-$F2 → collision
   3943  fdad							;   temps) was dead (rows 0-2 only) — deleted with the .AfterRows restore
   3944  fdad							;   in S3.0b.
   3945  fdad							; ------------------------------------------------------------------------------
   3946  fdad
   3947  fdad							; UpdateBombSound moved to bank1 (leaf_move_plan batch A) — CallPad_UpdateBombSound.
   3948  fdad
   3949  fdad							; ------------------------------------------------------------------------------
   3950  fdad							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3951  fdad							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3952  fdad							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3953  fdad							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3954  fdad							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   3955  fdad							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   3956  fdad							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   3957  fdad							;   by tools/test_cell_map.py).
   3958  fdad							;   (The standalone CellSolid leaf that lived here moved INTO
   3959  fdad							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3960  fdad							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3961  fdad							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3962  fdad							; ------------------------------------------------------------------------------
   3963  fdad		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   3964  fdc1		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3965  fdcd		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3966  fdd5
   3967  fdd5							; ------------------------------------------------------------------------------
   3968  fdd5							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3969  fdd5							; BombTick `jsr` lands here (bank0), `sta $1FF6` switches to bank2, the `jmp`
   3970  fdd5							; is fetched from bank2's byte-identical mirror at this same address and
   3971  fdd5							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3972  fdd5							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3973  fdd5							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3974  fdd5							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3975  fdd5							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3976  fdd5							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3977  fdd5							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3978  fdd5							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3979  fdd5							; ------------------------------------------------------------------------------
   3980  fdd5		       00 00 00 	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3981  fdd8				   BombEnemyBlast
   3982  fdd8		       8d f6 1f 	      sta	$1FF6
   3983  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3984  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3985  fdde							;   span)
   3986  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3987  fdde							;   latch + feature gate pushed +14; same day
   3988  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3989  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3990  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3991  fdde							;   garbage path's `inc $4A,X` set wall bits
   3992  fdde							;   via $CA)
   3993  fdde
