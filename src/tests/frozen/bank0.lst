   1739  f52f							; Level management
   1740  f52f							; ==============================================================================
   1741  f52f							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1742  f52f							; LevelDataTable stride: 12 bytes (S4 2026-10-19: start_x/y dropped — they
   1743  f52f							; were always the constants 32/24)
   1744  f52f							;   +0: start_room
   1745  f52f							;   +1..+3: miner_room (b7 = faces right), miner_x, miner_y
   1746  f52f							;   +4..+5: pfdata ptr (lo, hi)
   1747  f52f							;   +6..+7: conn ptr (lo, hi)
   1748  f52f							;   +8..+9: enemy ptr (lo, hi)
   1749  f52f							; ------------------------------------------------------------------------------
