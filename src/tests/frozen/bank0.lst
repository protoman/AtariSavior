   2842  f8eb							; PlayerHitsMap — check player bounding box against the room's PF map
   2843  f8eb							; ==============================================================================
   2844  f8eb							; Boxes are in tile coordinates (col 0-19, row 0-2); the walk tests the
   2845  f8eb							; PF0/1/2Buf cell bits directly (cell_collision_plan 2.1) — no rect cache,
   2846  f8eb							; no rect-count limit. The playfield is reflected, so right-half display
   2847  f8eb							; cols mirror via 39-col IN THE PROLOGUE (walk sees left-half only).
   2848  f8eb							; Returns C=0 if clear, C=1 if blocked.
   2849  f8eb				   PlayerHitsMap
   2850  f8eb							; --- Tile row range (top, bottom) ---
   2851  f8eb							; Inlined row lookup: saves 2 JSR stack push levels (4B on stack) to keep SP >= $F8
   2852  f8eb		       a5 81		      lda	RoomY
   2853  f8ed		       4a		      lsr
   2854  f8ee		       4a		      lsr		; A = scanline >> 2
   2855  f8ef		       a8		      tay
   2856  f8f0		       b9 c6 f8 	      lda	YToRowTable,Y
   2857  f8f3		       85 8d		      sta	CollisionCellY	; top tile row
   2858  f8f5		       18		      clc
   2859  f8f6		       a5 81		      lda	RoomY
   2860  f8f8		       69 15		      adc	#PLAYER_SPRITE_H - 1
   2861  f8fa		       4a		      lsr
   2862  f8fb		       4a		      lsr
   2863  f8fc		       a8		      tay
   2864  f8fd		       b9 c6 f8 	      lda	YToRowTable,Y
   2865  f900		       85 8f		      sta	CollisionEndY	; bottom tile row
   2866  f902
