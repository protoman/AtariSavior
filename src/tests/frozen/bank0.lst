   4676  ff7d		       4c 87 ff 	      jmp	.LaserInit
   4677  ff80				   .LAdvKeep
   4678  ff80		       a5 92		      lda	RectCount
   4679  ff82		       85 83		      sta	LaserX
   4680  ff84		       4c 8a ff 	      jmp	.LaserGo	; committed: skip the eye restart
   4681  ff87				   .LaserInit
   4682  ff87		       20 b1 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   4683  ff8a				   .LaserGo
   4684  ff8a		       a5 83		      lda	LaserX
   4685  ff8c		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   4686  ff8e		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   4687  ff91		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   4688  ff93		       c9 50		      cmp	#$50
   4689  ff95		       f0 0a		      beq	.LaserKill
   4690  ff97		       c9 02		      cmp	#2
   4691  ff99		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   4692  ff9b							;   same as kill minus score — restart at
   4693  ff9b							;   the eye THIS frame, buzz keeps (b7).
   4694  ff9b							;   #9's blank + the wall-center hold clamp
   4695  ff9b							;   both superseded: a contact missile is
   4696  ff9b							;   consumed by walls. No hold state, no
