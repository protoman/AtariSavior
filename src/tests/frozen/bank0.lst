   4738  fff2							; LaserHitTest — MOVED to bank2 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   4739  fff2							;   Fold-free: enemy records are level data in bank2 (direct (FetchPtr),Y),
   4740  fff2							;   and the kill/lamp ACTIONS cannot run from a bank2 body (CallPads are
   4741  fff2							;   bank0->bank1 only — pads cannot nest from a pad body). Body returns a
   4742  fff2							;   RESULT CODE in A (+Z preserved through ReturnPad's sta/rts): 0 = miss,
   4743  fff2							;   #$50 = kill (dead bit already set), 1 = lamp. LaserInput's tail does
   4744  fff2							;   `beq / cmp #$50 / jsr CallPad_SetRoomDark | jsr CallPad_AddScore`.
   4745  fff2							;   One less push level too (no fold / no pad call inside the body).
   4746  fff2							;   Full behavior docs moved with the body.
   4747  fff2							; ------------------------------------------------------------------------------
   4748  fff2
   4749  fff2							; ==============================================================================
   4750  fff2							; Interrupt vectors ($FFF2-$FFF9 = fill — NEVER put code here: $FFF6-$FFF9
   4751  fff2							; decode as F6 hotspot mirrors on peek (see MothExitPad comment at $FC49))
   4752  fff2							; ==============================================================================
   4753  fff2							; ==============================================================================
   4754  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0	; pad to vectors at $FFFA
   4755  fffa
   4756  fffa		       08 f0		      .word.w	GameStart	; NMI vector
   4757  fffc		       08 f0		      .word.w	GameStart	; RESET vector
   4758  fffe		       08 f0		      .word.w	GameStart	; IRQ vector
