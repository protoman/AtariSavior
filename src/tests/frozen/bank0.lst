   2099  f607							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2100  f607							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2101  f607							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2102  f607							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2103  f607							; ------------------------------------------------------------------------------
   2104  f607				   UEDispatch
   2105  f607		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2106  f609							;   the single type-compare entry. 2026-10-22:
   2107  f609							;   a raft authored dir=right read $87, missed
   2108  f609							;   `cmp #ENEMY_RAFT` and its body never ran
   2109  f609							;   (no tide, no motion, no rider pin).
   2110  f609		       c9 07		      cmp	#ENEMY_RAFT
   2111  f60b		       d0 06		      bne	.UEDNotRaft
   2112  f60d		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2113  f610		       4c 32 f4 	      jmp	UE_Next
   2114  f613				   .UEDNotRaft
   2115  f613		       c9 03		      cmp	#ENEMY_TENTACLE
   2116  f615		       d0 03		      bne	.UEDNotTent
   2117  f617		       4c 37 f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2118  f61a				   .UEDNotTent
   2119  f61a		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2120  f61c		       d0 03		      bne	.UEDNotMoth
   2121  f61e		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2122  f621				   .UEDNotMoth
   2123  f621		       c9 02		      cmp	#ENEMY_SNAKE
   2124  f623		       d0 03		      bne	.UEDNotSnake
   2125  f625		       4c ee f3 	      jmp	UE_SnakeBody
   2126  f628				   .UEDNotSnake
   2127  f628		       4c 32 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2128  f62b							; (absolute jmps: this block is far from the
   2129  f62b							;  bodies — relative branches do not reach)
