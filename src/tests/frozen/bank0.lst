   3012  fcc7							; ------------------------------------------------------------------------------
   3013  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3014  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3015  fcc7							; caller; Y is animated from the screen top down to it).
   3016  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3017  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3018  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3019  fcc7							;
   3020  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3021  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3022  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3023  fcc7							;
   3024  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3025  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3026  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3027  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3028  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3029  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3030  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3031  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3032  fcc7							; ------------------------------------------------------------------------------
   3033  fcc7				   DropArm
   3034  fcc7		       a5 8a		      lda	DropTarget
   3035  fcc9		       c9 fd		      cmp	#$FD
   3036  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3037  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3038  fccd							;   tally cleared to 0 by TallyWork before its
   3039  fccd							;   LoadLevel — same-size swap 2026-10-06)
   3040  fccd		       a5 81		      lda	RoomY
   3041  fccf		       85 8a		      sta	DropTarget
   3042  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3043  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3044  fcd5		       a9 00		      lda	#0
   3045  fcd7		       85 81		      sta	RoomY
   3046  fcd9		       85 95		      sta	PlayerYSub
   3047  fcdb		       85 93		      sta	vyLo
   3048  fcdd		       85 94		      sta	vyHi
   3049  fcdf		       a5 c0		      lda	LaserState
