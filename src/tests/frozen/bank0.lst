   4071  ff0f							; ==============================================================================
   4072  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4073  ff0f							; ==============================================================================
   4074  ff0f							; Andrew Davie session-24 routine:
   4075  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4076  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4077  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4078  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4079  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4080  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4081  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4082  ff0f							;
   4083  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4084  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4085  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4086  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4087  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4088  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4089  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4090  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4091  ff0f				   SetObjectXPos subroutine
   4092  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4093  ff11		       38		      sec		; ensure carry flag
   4094  ff12				   .Div15Loop
   4095  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4096  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4097  ff16		       a8		      tay		; Y = remainder in -15..-1
   4098  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4099  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4100  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4101  ff1e		       60		      rts
   4102  ff1f
   4103  ff20					      org	$FF20
   4104  ff20
   4105  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   4106  ff20				   SetObjReflection
   4107  ff20		       a9 00		      lda	#0
   4108  ff22		       85 0c		      sta	REFP1
   4109  ff24		       a5 b6		      lda	ObjBase
   4110  ff26		       c9 54		      cmp	#OBJ_MINER
   4111  ff28		       d0 08		      bne	.SORdone
   4112  ff2a		       a5 a4		      lda	LevelMinerRoom
   4113  ff2c		       10 04		      bpl	.SORdone
   4114  ff2e		       a9 08		      lda	#$08
   4115  ff30		       85 0c		      sta	REFP1
   4116  ff32				   .SORdone
   4117  ff32		       60		      rts
