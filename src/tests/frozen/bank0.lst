   2013  f565		       29 07		      and	#%00000111	; b7 = dir AND b3 = the LAMP's mirror flag
   2014  f567							;   (type 13 = the wall-mirrored design), so
   2015  f567							;   both lamp types land on `cmp #LAMP`. Without
   2016  f567							;   it a dir=right enemy read $81+ and fell
