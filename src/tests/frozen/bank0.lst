    861  f11d							;   the old `cpy #PLAYER_SPRITE_H / bcs
    862  f11d							;   .GrpZero` here was DEAD 4c on the worst
    863  f11d							;   path (2+2, never taken — A0=11+ never
    864  f11d							;   reaches it, it goes to bcs .GrpSkip).
    865  f11d		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
