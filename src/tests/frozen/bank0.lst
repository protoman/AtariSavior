   3562  fcc1							; ------------------------------------------------------------------------------
   3563  fcc1							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3564  fcc1							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3565  fcc1							; caller; Y is animated from the screen top down to it).
   3566  fcc1							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3567  fcc1							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3568  fcc1							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3569  fcc1							;
   3570  fcc1							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3571  fcc1							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3572  fcc1							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3573  fcc1							;
   3574  fcc1							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3575  fcc1							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3576  fcc1							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3577  fcc1							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3578  fcc1							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3579  fcc1							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3580  fcc1							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3581  fcc1							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3582  fcc1							; ------------------------------------------------------------------------------
   3583  fcc1				   DropArm
   3584  fcc1		       a5 8a		      lda	DropTarget
   3585  fcc3		       c9 fd		      cmp	#$FD
   3586  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3587  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3588  fcc7							;   tally cleared to 0 by TallyWork before its
   3589  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3590  fcc7		       a5 81		      lda	RoomY
   3591  fcc9		       85 8a		      sta	DropTarget
   3592  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3593  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3594  fccf		       a9 00		      lda	#0
   3595  fcd1		       85 81		      sta	RoomY
   3596  fcd3		       85 95		      sta	PlayerYSub
   3597  fcd5		       85 93		      sta	vyLo
   3598  fcd7		       85 94		      sta	vyHi
