    914  f10b							; Inline stripe+hot test was 84-109c; budget is 76c/scanline.
    915  f10b		       b5 d3		      lda	ColupfBuf,X
    916  f10d		       85 08		      sta	COLUPF
    917  f10f		       85 88		      sta	Temp	; A1 (line-budget plan): band color for
    918  f111							; .ObjZero's A==8 restore — A already holds
    919  f111							; it, no reload
    920  f111		       85 07		      sta	COLUP1	; D6: M1 band color (left-col block) — P1
    921  f113							; inherits it until .Line's object path.
    922  f113							; Same c51 slot the old no-door path used
    923  f113							; (AFTER the left half, same rule as COLUPF)
    924  f113		       a5 8d		      lda	CollisionCellY	; P2b door color staged by the VBL:
    925  f115							; $80 = no door / $1C = yellow stripe
    926  f115		       30 04		      bmi	.M1done	; no door: COLUP1/Temp already hold the band
    927  f117							;   colour, nothing left to do
    928  f117		       85 07		      sta	COLUP1	; door: yellow (only visible on the door's
    929  f119							;   open bands — wall PF hides it elsewhere)
    930  f119		       85 88		      sta	Temp	; bugs.md #15: .ObjZero's plain restore must
    931  f11b							;   keep the stripe yellow
