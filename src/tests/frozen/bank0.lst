   3307  fd7e							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3308  fd7e							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3309  fd7e							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3310  fd7e							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3311  fd7e							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3312  fd7e							; DeriveEnemyY — no persistent movement state exists in RAM.
   3313  fd7e							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3314  fd7e							; block after the pads; pre-pad headroom is 1B).
   3315  fd7e							; ------------------------------------------------------------------------------
   3316  fd7e				   RefreshEnemyY
   3317  fd7e		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3318  fd80							; TickCounter is the 60-frame GAME timer
   3319  fd80							; (decrements 60->1, reloads) — gates derived
   3320  fd80							; from it wrapped every second (spider
   3321  fd80							; "teleported": (TC>>3)&63 only ever saw
   3322  fd80							; 0..7 and counted DOWN 0->7 = jump).
   3323  fd80		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3324  fd82		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3325  fd84				   .REYLoop		; every reader runs after refresh completes)
   3326  fd84		       ca		      dex
   3327  fd85		       20 c8 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3328  fd88		       95 e2		      sta	EnemyRamY,X
   3329  fd8a		       8a		      txa		; N/Z must come from X: flags after jsr are
   3330  fd8b		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3331  fd8d				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3332  fd8d							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3333  fd8d							; black rooms, broken PF, invisible sprites)
   3334  fd8d							; --- SELECT or RESET held → back to the old title / level-select screen
   3335  fd8d							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3336  fd8d							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3337  fd8d							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3338  fd8d							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3339  fd8d							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3340  fd8d							;     RESET held past LANDING still re-fires — press must be released
   3341  fd8d							;     before the drop-in finishes. ---
   3342  fd8d		       a5 8a		      lda	DropTarget
   3343  fd8f		       d0 17		      bne	.REYRts	; not idle: not ours
   3344  fd91		       ad 82 02 	      lda	SWCHB
   3345  fd94		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3346  fd96		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3347  fd98		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3348  fd9a		       f0 0c		      beq	.REYRts	; neither pressed
   3349  fd9c		       a9 ff		      lda	#$FF
   3350  fd9e		       85 8a		      sta	DropTarget	; title sentinel (intro $FD lands here too)
   3351  fda0		       20 84 f5 	      jsr	LoadLevel	; tail → DropArm .DATitle (score/objects)
   3352  fda3		       68		      pla		; drop OUR return address (LoadLevel already
   3353  fda4		       68		      pla		;   popped its own) — tail into TitleWork
   3354  fda5		       4c 38 fd 	      jmp	TitleWork
