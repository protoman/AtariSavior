   2969  fc80							; ReloadLevel — reset level to initial state (all enemies back, 3 lives).
   2970  fc80							; Reloads level data from ROM and respawns player at start.
   2971  fc80							; Score is NOT reset (persists across deaths).
   2972  fc80							; After fold pads to keep main code under $FC68.
   2973  fc80							; ------------------------------------------------------------------------------
   2974  fc80				   ReloadLevel
   2975  fc80		       a9 03		      lda	#3
   2976  fc82		       85 ac		      sta	PlayerLives
   2977  fc84		       a9 05		      lda	#BOMBS_MAX
   2978  fc86		       85 f0		      sta	PlayerBombs
