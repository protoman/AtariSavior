   1961  f631		       e6 88		      inc	Temp	; miner counts as a slot
   1962  f633				   .SONoMiner
   1963  f633		       a5 88		      lda	Temp
   1964  f635		       d0 09		      bne	.SONotNothing
   1965  f637							; No objects this frame: A = Temp = 0. Blank the sprite AND reset the
   1966  f637							; flicker counter — with no objects the modulo below never runs, so
   1967  f637							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   1968  f637							; would run O(FlickerFrame) iterations in the VBL on the next room with
   1969  f637							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   1970  f637		       85 b4		      sta	FlickerFrame
   1971  f639		       a9 ff		      lda	#$FF
