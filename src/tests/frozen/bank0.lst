   1767  f49c		       bc 77 f9 	      ldy	EnemyOffTable,X
   1768  f49f		       20 f6 fe 	      jsr	FoldIndirect	; type
   1769  f4a2		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1770  f4a4							;   missed and a dir-left enemy fell through to
   1771  f4a4							;   .DEYStatic (no bob)
   1772  f4a4		       c9 01		      cmp	#ENEMY_BAT
   1773  f4a6		       f0 18		      beq	.DEYTickNoShift
   1774  f4a8		       c9 03		      cmp	#ENEMY_TENTACLE
   1775  f4aa		       f0 1a		      beq	.DEYTickShift
   1776  f4ac		       c9 00		      cmp	#ENEMY_SPIDER
   1777  f4ae		       f0 2e		      beq	.DEYSpiderTick
   1778  f4b0		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1779  f4b2		       d0 06		      bne	.DEYStatic
   1780  f4b4		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1781  f4b7		       4c d3 f4 	      jmp	DEYDelta
   1782  f4ba				   .DEYStatic
   1783  f4ba		       c8		      iny
   1784  f4bb		       c8		      iny
   1785  f4bc		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1786  f4bf		       60		      rts
   1787  f4c0				   .DEYTickNoShift
   1788  f4c0		       a5 c2		      lda	EnemyRamP
   1789  f4c2		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1790  f4c3		       4c cb f4 	      jmp	.DEYBobTick
