   3028  fd37							; ------------------------------------------------------------------------------
   3029  fd37							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3030  fd37							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3031  fd37							; selected level number (digits band) and the credits; the theme plays here.
   3032  fd37							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3033  fd37							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3034  fd37							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3035  fd37							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3036  fd37							;	    the intro exit ate the first press and made #2 read as dead)
   3037  fd37							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3038  fd37							;	    the real drop-in → gameplay starts
   3039  fd37							; ($FD reaches here directly — merged title, 2026-10-19.)
   3040  fd37							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3041  fd37							; title-owned; the first play frame rewrites it as the step budget).
   3042  fd37							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3043  fd37							; ------------------------------------------------------------------------------
   3044  fd37				   TitleWork
   3045  fd37							; --- SELECT edge (TitleSelect, fill region) ---
   3046  fd37		       20 4f fc 	      jsr	CallPad_TitleSelect
   3047  fd3a		       90 03		      bcc	.TWselDone	; C=0: no edge
   3048  fd3c		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3049  fd3f				   .TWselDone
   3050  fd3f							; --- RESET edge ---
   3051  fd3f		       a5 97		      lda	StepsLeft
   3052  fd41		       29 01		      and	#%00000001
   3053  fd43		       f0 14		      beq	.TWrstDone
   3054  fd45		       ad 82 02 	      lda	SWCHB
   3055  fd48		       29 01		      and	#%00000001
   3056  fd4a		       d0 0d		      bne	.TWrstDone
   3057  fd4c		       a9 00		      lda	#0
   3058  fd4e		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3059  fd50		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3060  fd52		       85 f4		      sta	ScoreHu
   3061  fd54		       85 f5		      sta	ScoreTe
   3062  fd56		       20 20 fc 	      jsr	LoadLevel
   3063  fd59				   .TWrstDone
   3064  fd59		       ad 82 02 	      lda	SWCHB
   3065  fd5c		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3066  fd5e							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3067  fd5e							;     channel force-muted here — UpdateJetSound is skipped because
   3068  fd5e							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3069  fd5e							;     = 0, AUDV0 covered above). ---
   3070  fd5e				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3071  fd5e		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3072  fd60		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3073  fd62		       f0 0e		      beq	.TWmusic
   3074  fd64		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3075  fd66		       20 79 f5 	      jsr	BombTick
   3076  fd69				   .TWnoTick
   3077  fd69		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3078  fd6c		       a9 00		      lda	#0
   3079  fd6e		       85 1a		      sta	AUDV1
   3080  fd70		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3081  fd72				   .TWmusic		; title: music wins the audio regs
   3082  fd72		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3083  fd75				   .TWwait
