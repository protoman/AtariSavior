   1779  f53d		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1780  f53f							;  game-over restart = LoseLife->ReloadLevel->
   1781  f53f							;  here; same-stage respawn keeps facing)
   1782  f53f		       85 9c		      sta	Hover	; bugs.md #1: stage entry lands normally; the
   1783  f541							;   respawn hover is armed only by LoseLife
   1784  f541		       a5 c0		      lda	LaserState
   1785  f543		       29 c7		      and	#%11000111	; clear RoomDarkMask rooms 4-7 (LaserState b5-2)
   1786  f545		       85 c0		      sta	LaserState
   1787  f547		       a9 05		      lda	#BOMBS_MAX
   1788  f549		       85 f0		      sta	PlayerBombs
   1789  f54b		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the
   1790  f54d		       c9 ff		      cmp	#$FF	; title preview (HUD score shows level+1)
   1791  f54f		       f0 04		      beq	.NoBanner
   1792  f551		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1793  f553		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
   1794  f555				   .NoBanner
