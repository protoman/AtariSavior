   2305  f750							; Slot1Hook — called from the .Row setup (X = RowIdx = band). Swaps the live
   2306  f750							; trio when slot 1 lives in this band, then repositions P1 and strobes HMOVE
   2307  f750							; on the following line's HBLANK. Preserves X (RowIdx) and Y (running-Y: the
   2308  f750							; .Line loop relies on it being untouched between rows).
   2309  f750				   Slot1Hook
   2310  f750		       98		      tya
   2311  f751		       48		      pha		; save running-Y (SetObjectXPos does `tay`)
   2312  f752		       a5 eb		      lda	ObjTop1
   2313  f754		       18		      clc
   2314  f755		       65 81		      adc	RoomY
   2315  f757		       38		      sec
   2316  f758		       e9 01		      sbc	#1	; A = slot 1's absolute room Y
   2317  f75a		       dd 00 fe 	      cmp	BandStart,X
   2318  f75d		       90 24		      bcc	.SHout	; above this band
   2319  f75f		       dd 01 fe 	      cmp	BandStart+1,X
   2320  f762		       b0 1f		      bcs	.SHout	; in a later band
   2321  f764		       a5 ea		      lda	ObjBase1
   2322  f766		       85 b6		      sta	ObjBase
   2323  f768		       a5 eb		      lda	ObjTop1
   2324  f76a		       85 bb		      sta	ObjTop
   2325  f76c		       a5 ec		      lda	ObjX1
   2326  f76e		       85 b7		      sta	ActiveObjectX
   2327  f770		       a2 01		      ldx	#1
   2328  f772		       20 0f ff 	      jsr	SetObjectXPos	; its own WSYNC starts the positioning line
   2329  f775							; The frame's ONE HMOVE already ran in the VBL; this second one exists only
   2330  f775							; for slot 1's own fine adjust. HMP0/HMM0/HMBL still hold the PLAYER's,
   2331  f775							; the laser's and the ball's fine values, and HMOVE would apply them a
   2332  f775							; second time — the player's fine adjust doubled (drawn X advanced 2 px per
   2333  f775							; 1 px of RoomX, sawing +/-15 px as the fine value cycled: the "raft
   2334  f775							; zig-zag", user 2026-10-22). Clear them; HMP1 stays (set above).
   2335  f775							; THESE CLEARS MUST SIT BEFORE THE `sta WSYNC` BELOW: they cost ~14 cycles,
   2336  f775							; and an HMOVE written after cycle 0 of HBLANK gives up part of the fine
   2337  f775							; shift (late-HMOVE penalty) — slot 1's sprite then snaps in ~4 px steps
   2338  f775							; (user 2026-10-22: "raft moves one tile at a time").
   2339  f775		       a9 00		      lda	#0
   2340  f777		       85 20		      sta	HMP0
   2341  f779		       85 22		      sta	HMM0
   2342  f77b		       85 24		      sta	HMBL
   2343  f77d		       a6 92		      ldx	RowIdx
   2344  f77f		       85 02		      sta	WSYNC	; end of the positioning line
   2345  f781		       85 2a		      sta	HMOVE	; cycle 0 of the next line = HBLANK
   2346  f783				   .SHout
   2347  f783		       68		      pla
   2348  f784		       a8		      tay
   2349  f785		       60		      rts
