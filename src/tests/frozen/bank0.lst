   3520  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3521  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3522  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3523  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3524  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3525  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3526  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3527  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3528  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3529  fe9c							; ------------------------------------------------------------------------------
   3530  fe9c				   TallyWork
   3531  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3532  fe9f		       a8		      tay
   3533  fea0		       29 01		      and	#1
   3534  fea2		       f0 05		      beq	.TNoScore
   3535  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3536  fea6		       20 1a fc 	      jsr	CallPad_AddScore
   3537  fea9				   .TNoScore
   3538  fea9		       98		      tya
   3539  feaa		       29 04		      and	#4
   3540  feac		       f0 1e		      beq	.TLive
   3541  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3542  feb0		       a5 a3		      lda	Level
   3543  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3544  feb4		       d0 04		      bne	.TNotWrap
   3545  feb6		       a9 00		      lda	#0	; wrap past last level
   3546  feb8		       85 a3		      sta	Level
   3547  feba				   .TNotWrap
   3548  feba		       a9 00		      lda	#0
   3549  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3550  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3551  febe							;   pose ($FE must take the real-fall path)
   3552  febe		       20 4a f5 	      jsr	LoadLevel
   3553  fec1		       a9 78		      lda	#120	; reset timer for new level
   3554  fec3		       85 ae		      sta	BarLevel
   3555  fec5		       a9 3c		      lda	#60
   3556  fec7		       85 ad		      sta	TickCounter
