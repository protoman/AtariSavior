   4111  fdad							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   4112  fdad							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   4113  fdad							;   ranges before the walk; bank2 display-space walkers mirror first too).
   4114  fdad							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   4115  fdad							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   4116  fdad							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   4117  fdad							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   4118  fdad							;   by tools/test_cell_map.py).
   4119  fdad							;   (The standalone CellSolid leaf that lived here moved INTO
   4120  fdad							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   4121  fdad							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   4122  fdad							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   4123  fdad							; ------------------------------------------------------------------------------
   4124  fdad		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   4125  fdc1		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   4126  fdcd		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
