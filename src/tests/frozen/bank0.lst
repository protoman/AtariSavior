   2830  fb44		       bd 56 fb 	      lda	SBod,X
   2831  fb47		       85 84		      sta	LineCount
   2832  fb49		       e6 eb		      inc	VcrNext
   2833  fb4b		       c8		      iny		; running A0: setup WSYNC is a visible line like
   2834  fb4c							;   a body — without this the next .Line indexes
   2835  fb4c							;   sprite row A0 (armed sprite sat ~4 lines low)
   2836  fb4c		       85 02		      sta	WSYNC	; this line = the slice setup line
   2837  fb4e		       4c 36 f1 	      jmp	SliceReentry	; tail re-enters .Line via the global trampoline
   2838  fb51							;   (jsr/rts replaced 2026-10-15: +14c tail
   2839  fb51							;   stalled the first slice body line at 82c;
   2840  fb51							;   tail jmp costs 3c and pushes no stack)
   2841  fb51				   SBmask
   2842  fb51		       01 02 04 08*	      .byte.b	1,2,4,8,16	; state bit for slices 0-4
   2843  fb56				   SBod
   2844  fb56		       08 08 0c 08*	      .byte.b	8,8,12,8,8	; body lines per slice (5 setups + 44 = 49)
