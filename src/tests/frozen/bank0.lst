   3688  fcaf		       a5 8a		      lda	DropTarget
   3689  fcb1		       c9 fd		      cmp	#$FD
   3690  fcb3		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3691  fcb5							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3692  fcb5							;   tally cleared to 0 by TallyWork before its
   3693  fcb5							;   LoadLevel — same-size swap 2026-10-06)
   3694  fcb5		       a5 81		      lda	RoomY
   3695  fcb7		       85 8a		      sta	DropTarget
   3696  fcb9		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3697  fcbb		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3698  fcbd		       a9 00		      lda	#0
   3699  fcbf		       85 81		      sta	RoomY
