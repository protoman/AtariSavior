   4129  ff9d				   .LaserGo
   4130  ff9d		       a5 83		      lda	LaserX
   4131  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   4132  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   4133  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   4134  ffa6		       c9 50		      cmp	#$50
   4135  ffa8		       f0 0a		      beq	.LaserKill
   4136  ffaa		       c9 02		      cmp	#2
   4137  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   4138  ffae							;   same as kill minus score — restart at
   4139  ffae							;   the eye THIS frame, buzz keeps (b7).
   4140  ffae							;   #9's blank + the wall-center hold clamp
