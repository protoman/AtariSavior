   4067  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   4068  ff00							; ==============================================================================
   4069  ff00					      org	$FF00
   4070  ff00				   fineAdjustBegin
   4071  ff00		       70		      .byte.b	%01110000	; left 7
   4072  ff01		       60		      .byte.b	%01100000	; left 6
   4073  ff02		       50		      .byte.b	%01010000	; left 5
   4074  ff03		       40		      .byte.b	%01000000	; left 4
   4075  ff04		       30		      .byte.b	%00110000	; left 3
   4076  ff05		       20		      .byte.b	%00100000	; left 2
   4077  ff06		       10		      .byte.b	%00010000	; left 1
   4078  ff07		       00		      .byte.b	%00000000	; no movement
   4079  ff08		       f0		      .byte.b	%11110000	; right 1
   4080  ff09		       e0		      .byte.b	%11100000	; right 2
   4081  ff0a		       d0		      .byte.b	%11010000	; right 3
   4082  ff0b		       c0		      .byte.b	%11000000	; right 4
   4083  ff0c		       b0		      .byte.b	%10110000	; right 5
   4084  ff0d		       a0		      .byte.b	%10100000	; right 6
   4085  ff0e		       90		      .byte.b	%10010000	; right 7
   4086  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   4087  ff0f
   4088  ff0f							; ==============================================================================
   4089  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4090  ff0f							; ==============================================================================
   4091  ff0f							; Andrew Davie session-24 routine:
   4092  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4093  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4094  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4095  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4096  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4097  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4098  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4099  ff0f							;
   4100  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4101  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4102  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4103  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4104  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4105  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4106  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4107  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4108  ff0f				   SetObjectXPos subroutine
   4109  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4110  ff11		       38		      sec		; ensure carry flag
   4111  ff12				   .Div15Loop
   4112  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4113  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4114  ff16		       a8		      tay		; Y = remainder in -15..-1
   4115  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4116  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4117  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4118  ff1e		       60		      rts
   4119  ff1f
   4120  ff20					      org	$FF20
   4121  ff20
   4122  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   4123  ff20				   SetObjReflection
   4124  ff20		       a9 00		      lda	#0
   4125  ff22		       85 0c		      sta	REFP1
   4126  ff24		       a5 b6		      lda	ObjBase
   4127  ff26		       c9 5b		      cmp	#OBJ_MINER
   4128  ff28		       d0 08		      bne	.SORdone
   4129  ff2a		       a5 a4		      lda	LevelMinerRoom
   4130  ff2c		       10 04		      bpl	.SORdone
   4131  ff2e		       a9 08		      lda	#$08
   4132  ff30		       85 0c		      sta	REFP1
   4133  ff32				   .SORdone
   4134  ff32		       60		      rts
   4135  ff33
   4136  ff33							; ------------------------------------------------------------------------------
   4137  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4138  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4139  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   4140  ff33							; user spec: no piercing, no HERO comparison needed).
   4141  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4142  ff33							;						  left	RoomX-4)
   4143  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4144  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   4145  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4146  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4147  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4148  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4149  ff33							;     priority over M0 anyway).
   4150  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4151  ff33							;     press edge re-anchors).
   4152  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4153  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4154  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4155  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4156  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4157  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4158  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4159  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4160  ff33							; ------------------------------------------------------------------------------
   4161  ff33				   LaserInput
   4162  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4163  ff35		       8a		      txa
