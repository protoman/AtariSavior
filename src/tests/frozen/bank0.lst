   4032  fe06		       f2		      .byte.b	$f2	; bat — hue 15 luma 7 = brown
   4033  fe07		       c4		      .byte.b	$c4	; snake — hue 12 luma 2 = green
   4034  fe08		       0e		      .byte.b	$0e	; tentacle — hue 0 luma 7 = white
   4035  fe09		       22		      .byte.b	$22	; moth — hue 2 luma 1 = dark orange
   4036  fe0a		       0e		      .byte.b	$0e	; lamp (type 5) — white; dark rooms override to grey
   4037  fe0b		       1c		      .byte.b	$1C	; key (type 6) — yellow
