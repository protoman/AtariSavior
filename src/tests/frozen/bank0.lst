   4351  ff0f							; ==============================================================================
   4352  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4353  ff0f							; ==============================================================================
   4354  ff0f							; Andrew Davie session-24 routine:
   4355  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4356  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4357  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4358  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4359  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4360  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4361  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4362  ff0f							;
   4363  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4364  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4365  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4366  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4367  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4368  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4369  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4370  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4371  ff0f				   SetObjectXPos subroutine
   4372  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4373  ff11		       38		      sec		; ensure carry flag
   4374  ff12				   .Div15Loop
   4375  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4376  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4377  ff16		       a8		      tay		; Y = remainder in -15..-1
   4378  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4379  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4380  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4381  ff1e		       60		      rts
   4382  ff1f
   4383  ff20					      org	$FF20
   4384  ff20
   4385  ff20							; ------------------------------------------------------------------------------
   4386  ff20							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4387  ff20							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4388  ff20							; the facing until contact, then resets to the eye (single missile, KISS —
   4389  ff20							; user spec: no piercing, no HERO comparison needed).
   4390  ff20							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4391  ff20							;						  left	RoomX-4)
   4392  ff20							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4393  ff20							;     wrap) -> reset to eye (unsigned check catches both)
   4394  ff20							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4395  ff20							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4396  ff20							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4397  ff20							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4398  ff20							;     priority over M0 anyway).
   4399  ff20							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4400  ff20							;     press edge re-anchors).
   4401  ff20							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4402  ff20							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4403  ff20							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4404  ff20							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4405  ff20							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4406  ff20							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4407  ff20							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4408  ff20							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4409  ff20							; ------------------------------------------------------------------------------
   4410  ff20				   LaserInput
   4411  ff20		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4412  ff22		       8a		      txa
   4413  ff23		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4414  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4415  ff27		       8a		      txa
   4416  ff28		       29 80		      and	#LASER_HELD
   4417  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4418  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4419  ff2d		       85 c0		      sta	LaserState
   4420  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4421  ff31		       45 dd		      eor	DemoOn	; demo script presses (b7; 0 = no effect)
   4422  ff33		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4423  ff35							; below — moved here so the cap code could
   4424  ff35							; not push .LaserReleased past bmi's ±127)
