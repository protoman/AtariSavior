   1982  f51e							; CheckEnemyHit — player overlaps an enemy → remove enemy, lose life
   1983  f51e							; ------------------------------------------------------------------------------
   1984  f51e				   CheckEnemyHit
   1985  f51e							; Walk enemy list, check footprint overlap with each
   1986  f51e		       a5 b3		      lda	EnemyCount
   1987  f520		       d0 03		      bne	CEH_HasEnemies
   1988  f522		       4c 8d f5 	      jmp	CEH_NoHit	; no enemies
   1989  f525				   CEH_HasEnemies
   1990  f525							; --- Fold batch (P3.1): enemy record staged once — the loop reads type
   1991  f525							; at CEH_HasMore and writes no FetchPtr. ---
   1992  f525		       a5 b1		      lda	EnemyDataLo
   1993  f527		       85 e5		      sta	FetchPtr
   1994  f529		       a5 b2		      lda	EnemyDataHi
   1995  f52b		       85 e6		      sta	FetchPtr+1
   1996  f52d		       a0 00		      ldy	#0
   1997  f52f				   CEH_Loop
   1998  f52f		       c4 b3		      cpy	EnemyCount
   1999  f531		       90 03		      bcc	CEH_HasMore
   2000  f533		       4c 8d f5 	      jmp	CEH_NoHit	; walked all enemies, no hit
   2001  f536				   CEH_HasMore
   2002  f536		       84 b9		      sty	EnemyIndex
   2003  f538							; Skip dead enemies
   2004  f538		       a5 ba		      lda	EnemyDeadMask
   2005  f53a		       39 ca f3 	      and	EnemyBitTable,Y
   2006  f53d		       d0 48		      bne	CEHNext
   2007  f53f							; Live X and Y from RAM shadow (Y = slot here)
   2008  f53f		       b9 bd 00 	      lda	EnemyRamX,Y
   2009  f542		       85 b7		      sta	ActiveObjectX
   2010  f544		       b9 e2 00 	      lda	EnemyRamY,Y
   2011  f547		       85 b8		      sta	ActiveObjectY
   2012  f549							; Broad object bounds; lamp gets its 4px lit-width check after Y overlap.
   2013  f549		       a5 80		      lda	RoomX
   2014  f54b		       38		      sec
   2015  f54c		       e5 b7		      sbc	ActiveObjectX
   2016  f54e		       18		      clc
   2017  f54f		       69 06		      adc	#PLAYER_WIDTH - 1
   2018  f551		       c9 0e		      cmp	#PLAYER_WIDTH + ENEMY_WIDTH - 1
   2019  f553		       b0 32		      bcs	CEHNext	; no X overlap
   2020  f555		       85 8b		      sta	CollisionX	; keep x-overlap span for lamp's narrower box
   2021  f557							; Y overlap: player [RoomY, +11] vs enemy [ActiveObjectY, +11] — exact
   2022  f557		       a5 81		      lda	RoomY
   2023  f559		       38		      sec
   2024  f55a		       e5 b8		      sbc	ActiveObjectY
   2025  f55c		       18		      clc
   2026  f55d		       69 15		      adc	#PLAYER_SPRITE_H - 1
   2027  f55f		       c9 2b		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   2028  f561		       b0 24		      bcs	CEHNext	; no Y overlap
   2029  f563							; Lamp (type 5): crash → RoomDarkMask; lamp stays in rotation (grey), no life
   2030  f563		       a6 b9		      ldx	EnemyIndex
   2031  f565		       bc 77 f9 	      ldy	EnemyOffTable,X	; Y = EnemyIndex * 3
   2032  f568		       20 f6 fe 	      jsr	FoldIndirect	; type|dir
   2033  f56b		       4c 7a f9 	      jmp	CEHDispatch	; type dispatch lives in the $F97A hole (bank0's
   2034  f56e							;   main region is full): 0-4 kill, 5/13 lamp,
   2035  f56e							;   6 key, 7 raft, 14 power cell, 15 extra miner
   2036  f56e				   CEHkill
   2037  f56e							; Hit! Mark this enemy dead (bit = index)
   2038  f56e		       a5 ba		      lda	EnemyDeadMask
   2039  f570		       1d ca f3 	      ora	EnemyBitTable,X	; X = EnemyIndex (set at CEH hit)
   2040  f573		       85 ba		      sta	EnemyDeadMask
   2041  f575		       a9 50		      lda	#$50	; +50 points per kill
   2042  f577		       20 0b fc 	      jsr	CallPad_AddScore
   2043  f57a							; Lose a life (shared path — tail jmp: its rts returns to caller)
   2044  f57a		       4c 80 fc 	      jmp	LoseLife
   2045  f57d				   CEH_Lamp
   2046  f57d							; Broad overlap guarantees lower bound; narrow to lamp's 4 lit pixels.
   2047  f57d		       a5 8b		      lda	CollisionX
   2048  f57f		       c9 0e		      cmp	#PLAYER_WIDTH + LAMP_WIDTH - 1
   2049  f581		       b0 04		      bcs	CEHNext
   2050  f583							; Only fire once (bit already set → no-op); no life loss, not EnemyDeadMask
   2051  f583		       20 11 fc 	      jsr	CallPad_SetRoomDark
   2052  f586		       60		      rts
   2053  f587				   CEHNext
   2054  f587		       a4 b9		      ldy	EnemyIndex
   2055  f589		       c8		      iny
   2056  f58a		       4c 2f f5 	      jmp	CEH_Loop
   2057  f58d				   CEH_NoHit
   2058  f58d		       60		      rts
