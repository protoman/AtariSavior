   1727  f4d1		       a5 c2		      lda	EnemyRamP
   1728  f4d3		       4a		      lsr
   1729  f4d4		       4a		      lsr		; ÷4 gate (1 px per 4 frames)
   1730  f4d5		       29 3f		      and	#$3F	; p = 0..63
   1731  f4d7		       c9 30		      cmp	#48
   1732  f4d9		       90 04		      bcc	.DEYSUp
   1733  f4db		       a9 00		      lda	#0	; dwell: p 48..63 (clock wrap lands here)
   1734  f4dd		       f0 e7		      beq	DEYDelta	; always
   1735  f4df				   .DEYSUp
   1736  f4df		       c9 19		      cmp	#25
