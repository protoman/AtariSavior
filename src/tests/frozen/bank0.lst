    416 U00bc		       00 80	   LASER_HELD =	%10000000	; b7: fire held this frame (INPT4 D7=0)
    417 U00bc		       00 02	   LASER_ARMED =	%00000010	; b1: kernel .Line beam gate — ENAM0 =
    418 U00bc							;   (PlayerColTable bit1) & b1, so the beam
    419 U00bc							;   row is the table's bit1 row (index 2)
    420 U00bc		       00 82	   LASER_ON   =	%10000010	; b7+b1 in one ora (held AND armed)
