    356 U00bc							;   (4 missed the bulb from the far side)
    357 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER's lit pixels start at col 0 (the
    358 U00bc							;   art is stored facing right)
    359 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
