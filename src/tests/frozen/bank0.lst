   3790  fe05		       f2		      .byte.b	$f2	; bat — hue 15 luma 7 = brown
   3791  fe06		       c4		      .byte.b	$c4	; snake — hue 12 luma 2 = green
   3792  fe07		       0e		      .byte.b	$0e	; tentacle — hue 0 luma 7 = white
   3793  fe08		       22		      .byte.b	$22	; moth — hue 2 luma 1 = dark orange
   3794  fe09		       0e		      .byte.b	$0e	; lamp (type 5) — white; dark rooms override to grey
   3795  fe0a		       1c		      .byte.b	$1C	; key (type 6) — yellow
   3796  fe0b		       c4		      .byte.b	$c4	; raft (type 7) — green, matching the SNAKE art
