    840  f0d8							; --- Set PF registers for this tile row (TIA persists) ---
    841  f0d8							; Store ORDER is cycle-critical (thin-yellow-line fix, 2026-10-01): the
    842  f0d8							; stores land mid-visible (advance block then these pairs), so on the
    843  f0d8							; row1→row2 band-transition line the left half must keep the OLD band's
    844  f0d8							; PF+color while the right half may show the NEW band. Write cycles
    845  f0d8							; (cN = CPU cycles on the setup line, x = pixel at 4x, HBLANK ends c22.7):
    846  f0d8							;   PF0 w c34 x136 | PF1 w c41 x222 | COLUPF w c48 x296 |
    847  f0d8							;   COLUP1 w c51 x332 (D6 M1 band color — AFTER the left half, so the
    848  f0d8							;     transition line keeps the OLD band's M1/P1 color on the left, same
    849  f0d8							;     rule as COLUPF) |
    850  f0d8							;   ENABL w c58 (BandTab gate, +1c vs the old COLUBK pair) |
    851  f0d8							;   PF2 w c65 x500 (moved +3c — still past right-half PF2 pixels x449)
    852  f0d8							; COLUPF 3rd: color flips at x296 = past ALL left ON-pixels (PF1 ends
    853  f0d8							; x187, PF2 cell17 ends x287); cells18-19 (x288-319) are never ON in any
    854  f0d8							; model row (PF2 bits6/7 always 0) so the flip there is invisible (BG =
    855  f0d8							; COLUBK). PF2 LAST: store lands past every right-half PF2 pixel (x449)
    856  f0d8							; → right PF2 keeps OLD band (= BG post-blast = no yellow; pre-blast
    857  f0d8							; cell17 = new pattern's wall = looks new). Old order (PF2 3rd = w c48,
    858  f0d8							; COLUPF last = w c61 x447) painted right PF2 (x350-446) NEW pattern
    859  f0d8							; under OLD hot color = the blinking thin yellow line at y191/192.
    860  f0d8		       b5 c3		      lda	PF0Buf,X
    861  f0da		       85 0d		      sta	PF0
    862  f0dc		       b5 c7		      lda	PF1Buf,X
