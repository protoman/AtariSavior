   1967  f5e5							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   1968  f5e5							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   1969  f5e5							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   1970  f5e5							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   1971  f5e5							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   1972  f5e5							; this region is upstream of the pin, so it costs nothing at $FC67.
   1973  f5e5							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   1974  f5e5							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   1975  f5e5							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   1976  f5e5							; and normal deaths, resets on game-over reload.
   1977  f5e5							; ------------------------------------------------------------------------------
   1978  f5e5				   CEH_Key
   1979  f5e5		       a5 ba		      lda	EnemyDeadMask
   1980  f5e7		       1d b2 f3 	      ora	EnemyBitTable,X
   1981  f5ea		       85 ba		      sta	EnemyDeadMask
   1982  f5ec		       a5 a7		      lda	LevelStartRoom
   1983  f5ee		       09 80		      ora	#$80	; KeyHeld = b7
   1984  f5f0		       85 a7		      sta	LevelStartRoom
   1985  f5f2		       60		      rts
