   1921  f4f8		       c5 98		      cmp	RoomNo
   1922  f4fa		       d0 1b		      bne	.CMPDone	; not in miner's room
   1923  f4fc							; X overlap: player [RoomX, +6] vs 4px miner.
   1924  f4fc							; Accept iff RoomX - MinerX in [-6, +3].
   1925  f4fc		       a5 80		      lda	RoomX
   1926  f4fe		       38		      sec
   1927  f4ff		       e5 a5		      sbc	MinerX
