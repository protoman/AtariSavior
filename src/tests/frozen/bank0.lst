   2124  f926							; PlayerHitsMap — check player bounding box against the room's PF map
   2125  f926							; ==============================================================================
   2126  f926							; Boxes are in tile coordinates (col 0-19, row 0-2); the walk tests the
   2127  f926							; PF0/1/2Buf cell bits directly (cell_collision_plan 2.1) — no rect cache,
   2128  f926							; no rect-count limit. The playfield is reflected, so right-half display
   2129  f926							; cols mirror via 39-col IN THE PROLOGUE (walk sees left-half only).
   2130  f926							; Returns C=0 if clear, C=1 if blocked.
   2131  f926				   PlayerHitsMap
   2132  f926							; --- Tile row range (top, bottom) ---
   2133  f926							; Inlined row lookup: saves 2 JSR stack push levels (4B on stack) to keep SP >= $F8
   2134  f926		       a5 81		      lda	RoomY
   2135  f928		       4a		      lsr
   2136  f929		       4a		      lsr		; A = scanline >> 2
   2137  f92a		       a8		      tay
   2138  f92b		       b9 01 f9 	      lda	YToRowTable,Y
   2139  f92e		       85 8d		      sta	CollisionCellY	; top tile row
   2140  f930		       18		      clc
   2141  f931		       a5 81		      lda	RoomY
   2142  f933		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   2143  f935		       4a		      lsr
   2144  f936		       4a		      lsr
   2145  f937		       a8		      tay
   2146  f938		       b9 01 f9 	      lda	YToRowTable,Y
   2147  f93b		       85 8f		      sta	CollisionEndY	; bottom tile row
   2148  f93d
