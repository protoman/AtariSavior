   3050  fca5							; CheckBandTouch — overscan: if band on and sprite touches the water strip →
   3051  fca5							; life. Strip = bottom ~12 lines of the cave (bottom_band_plan rule 2);
   3052  fca5							; sprite origin RoomY >= 125 enters it (125 + PLAYER_SPRITE_H - 1 = 136).
   3053  fca5							; Same path as hot/enemy: lose life, then respawn 12 scanlines up (min 0).
   3054  fca5							; Band color = VBLANK-staged RoomBandColor ($D2, PF1Buf[3] dead-row alias;
   3055  fca5							; staged by the VBLANK fold from LevelEnemy+RoomNo*4+3 — a kernel-time fold
   3056  fca5							; overruns the .WaterRow line). Read inlined here and in .WaterRow (0 = off).
