   2049  f594							; BombTick — per-frame state machine (overscan).
   2050  f594							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2051  f594							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2052  f594							; ------------------------------------------------------------------------------
   2053  f594				   BombTick   subroutine
   2054  f594		       a5 b5		      lda	BombPacked
   2055  f596		       29 03		      and	#%00000011	; state
   2056  f598		       f0 41		      beq	.BTDone	; none
   2057  f59a		       c9 01		      cmp	#1
   2058  f59c		       f0 0f		      beq	.BTFuse
   2059  f59e							; state 2 — exploding
   2060  f59e		       c6 f7		      dec	BombTimer
   2061  f5a0		       d0 39		      bne	.BTDone
   2062  f5a2		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2063  f5a4		       29 fc		      and	#%11111100
   2064  f5a6		       85 b5		      sta	BombPacked
   2065  f5a8		       a9 00		      lda	#0
   2066  f5aa		       85 f7		      sta	BombTimer
   2067  f5ac		       60		      rts
   2068  f5ad				   .BTFuse
   2069  f5ad		       c6 f7		      dec	BombTimer
   2070  f5af		       d0 2a		      bne	.BTDone
   2071  f5b1		       a5 b5		      lda	BombPacked	; 1 → 2
   2072  f5b3		       29 fc		      and	#%11111100
   2073  f5b5		       09 02		      ora	#%00000010
   2074  f5b7		       85 b5		      sta	BombPacked
   2075  f5b9		       a9 3c		      lda	#60
   2076  f5bb		       85 f7		      sta	BombTimer
   2077  f5bd		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2078  f5c0		       aa		      tax
   2079  f5c1		       f0 08		      beq	.BTNoScore
   2080  f5c3				   .BTScore
   2081  f5c3		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2082  f5c5		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2083  f5c8		       ca		      dex
   2084  f5c9		       d0 f8		      bne	.BTScore
   2085  f5cb				   .BTNoScore
   2086  f5cb		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2087  f5ce		       f0 05		      beq	.BTNoKill
   2088  f5d0		       a9 50		      lda	#$50	; +50 per kill — moved out of the pad body
   2089  f5d2		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2090  f5d5				   .BTNoKill
   2091  f5d5		       20 dc f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2092  f5d8		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2093  f5db				   .BTDone
   2094  f5db		       60		      rts
