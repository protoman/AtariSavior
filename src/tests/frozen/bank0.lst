    493  f041							; ==============================================================================
    494  f041							; Frame loop
    495  f041							; ==============================================================================
    496  f041				   StartFrame
    497  f041
    498  f041							; ------------------------------------------------------------------------------
    499  f041							; VSYNC (3 scanlines)
    500  f041							; ------------------------------------------------------------------------------
    501  f041							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    502  f041							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    503  f041							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    504  f041							; does not advance the wall clock to the next scanline boundary (it is already
    505  f041							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    506  f041							; fraction depends on where the previous frame's overscan happened to end) —
    507  f041							; the whole screen shifted up 1 scanline on those frames = the jitter.
    508  f041							;
    509  f041							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    510  f041							; the next scanline boundary (even if we were already at it — the store is 3c
    511  f041							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    512  f041							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    513  f041							; the sim wall-model target is updated to match.
    514  f041		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    515  f043		       a9 02		      lda	#2
    516  f045		       85 00		      sta	VSYNC
    517  f047		       85 02		      sta	WSYNC
    518  f049		       85 02		      sta	WSYNC
    519  f04b		       85 02		      sta	WSYNC
    520  f04d		       a9 00		      lda	#0
    521  f04f		       85 00		      sta	VSYNC
    522  f051
    523  f051							; ------------------------------------------------------------------------------
    524  f051							; VBLANK (37 scanlines)
    525  f051							; ------------------------------------------------------------------------------
    526  f051		       a9 02		      lda	#2
    527  f053		       85 01		      sta	VBLANK	; turn on VBLANK
    528  f055
    529  f055							; --- Set TIM64T for VBLANK ---
    530  f055							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    531  f055							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    532  f055							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    533  f055							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    534  f055				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    535  f055		       a9 17		      lda	#23
    536  f057		       8d 96 02 	      sta	TIM64T
    537  f05a
    538  f05a							; --- Position player sprite horizontally ---
    539  f05a		       a5 80		      lda	RoomX
    540  f05c		       38		      sec
    541  f05d		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    542  f05f		       a2 00		      ldx	#0	; X=0 = player0
    543  f061		       20 0f ff 	      jsr	SetObjectXPos
    544  f064
    545  f064							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    546  f064							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    547  f064							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    548  f064							; now stages BallX into Temp; this block reads the staged copy. ---
    549  f064
    550  f064							; --- No sprite copy needed — kernel reads directly from ROM ---
    551  f064							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    552  f064							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    553  f064							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    554  f064
    555  f064							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    556  f064							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    557  f064							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    558  f064		       20 51 f6 	      jsr	SelectActiveObject
    559  f067
    560  f067							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    561  f067							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    562  f067							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    563  f067							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    564  f067							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    565  f067							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    566  f067		       20 38 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    567  f06a
    568  f06a							; --- Band-color cache → RoomBandColor ($D2) for kernel+overscan (P2.5) ---
    569  f06a							; ROM now lives in bank2: kernel-time fold is cycle-impossible on the
    570  f06a							; .WaterRow line, so fold HERE (VBLANK, timer-paced) and hand the kernel
    571  f06a							; a plain zp load. Stage FetchPtr immediately before the fold.
    572  f06a		       a5 98		      lda	RoomNo
    573  f06c		       0a		      asl
    574  f06d		       0a		      asl
    575  f06e		       09 03		      ora	#3	; Y = RoomNo*4+3 (RoomNo*4 low bits are 0)
    576  f070		       a8		      tay
    577  f071		       a5 af		      lda	LevelEnemyLo
    578  f073		       85 e5		      sta	FetchPtr
    579  f075		       a5 b0		      lda	LevelEnemyHi
    580  f077		       85 e6		      sta	FetchPtr+1
    581  f079		       a2 00		      ldx	#0
    582  f07b		       20 f6 fe 	      jsr	FoldIndirect
    583  f07e		       85 bc		      sta	RoomBandColor
    584  f080
    585  f080							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    586  f080							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    587  f080							; Dark room: black except the existing explosion blink (state=2).
    588  f080							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    589  f080							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    590  f080							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    591  f080							; no reader between this point and overscan's own `sta Temp` (joystick).
    592  f080		       a5 b5		      lda	BombPacked
    593  f082		       29 03		      and	#%00000011
    594  f084		       c9 02		      cmp	#2
    595  f086		       f0 0a		      beq	.BgBlink
    596  f088		       20 26 fc 	      jsr	CallPad_IsRoomDark
    597  f08b		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    598  f08d		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    599  f08f		       4c a2 f0 	      jmp	.BgStore
    600  f092				   .BgBlink
    601  f092							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    602  f092							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    603  f092							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    604  f092							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    605  f092							; 60 frames = exact 15 cycles, starts black at explosion.
    606  f092		       a9 3c		      lda	#60
    607  f094		       38		      sec
    608  f095		       e5 f7		      sbc	BombTimer
    609  f097		       29 03		      and	#3
    610  f099		       a8		      tay
    611  f09a		       b9 33 f8 	      lda	BombBlinkColors,Y
    612  f09d		       4c a2 f0 	      jmp	.BgStore
    613  f0a0				   .BgIdle
