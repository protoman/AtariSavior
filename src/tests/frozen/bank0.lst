   3648  ff00					      org	$FF00
   3649  ff00				   fineAdjustBegin
   3650  ff00		       70		      .byte.b	%01110000	; left 7
   3651  ff01		       60		      .byte.b	%01100000	; left 6
   3652  ff02		       50		      .byte.b	%01010000	; left 5
   3653  ff03		       40		      .byte.b	%01000000	; left 4
   3654  ff04		       30		      .byte.b	%00110000	; left 3
   3655  ff05		       20		      .byte.b	%00100000	; left 2
   3656  ff06		       10		      .byte.b	%00010000	; left 1
   3657  ff07		       00		      .byte.b	%00000000	; no movement
   3658  ff08		       f0		      .byte.b	%11110000	; right 1
   3659  ff09		       e0		      .byte.b	%11100000	; right 2
   3660  ff0a		       d0		      .byte.b	%11010000	; right 3
   3661  ff0b		       c0		      .byte.b	%11000000	; right 4
   3662  ff0c		       b0		      .byte.b	%10110000	; right 5
   3663  ff0d		       a0		      .byte.b	%10100000	; right 6
   3664  ff0e		       90		      .byte.b	%10010000	; right 7
