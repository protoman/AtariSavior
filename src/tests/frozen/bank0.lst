   3704  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   3705  ff00							; ==============================================================================
   3706  ff00					      org	$FF00
   3707  ff00				   fineAdjustBegin
   3708  ff00		       70		      .byte.b	%01110000	; left 7
   3709  ff01		       60		      .byte.b	%01100000	; left 6
   3710  ff02		       50		      .byte.b	%01010000	; left 5
   3711  ff03		       40		      .byte.b	%01000000	; left 4
   3712  ff04		       30		      .byte.b	%00110000	; left 3
   3713  ff05		       20		      .byte.b	%00100000	; left 2
   3714  ff06		       10		      .byte.b	%00010000	; left 1
   3715  ff07		       00		      .byte.b	%00000000	; no movement
   3716  ff08		       f0		      .byte.b	%11110000	; right 1
   3717  ff09		       e0		      .byte.b	%11100000	; right 2
   3718  ff0a		       d0		      .byte.b	%11010000	; right 3
   3719  ff0b		       c0		      .byte.b	%11000000	; right 4
   3720  ff0c		       b0		      .byte.b	%10110000	; right 5
   3721  ff0d		       a0		      .byte.b	%10100000	; right 6
   3722  ff0e		       90		      .byte.b	%10010000	; right 7
   3723  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
