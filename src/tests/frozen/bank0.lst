   4098  ff00							; ==============================================================================
   4099  ff00					      org	$FF00
   4100  ff00				   fineAdjustBegin
   4101  ff00		       70		      .byte.b	%01110000	; left 7
   4102  ff01		       60		      .byte.b	%01100000	; left 6
   4103  ff02		       50		      .byte.b	%01010000	; left 5
   4104  ff03		       40		      .byte.b	%01000000	; left 4
   4105  ff04		       30		      .byte.b	%00110000	; left 3
   4106  ff05		       20		      .byte.b	%00100000	; left 2
   4107  ff06		       10		      .byte.b	%00010000	; left 1
   4108  ff07		       00		      .byte.b	%00000000	; no movement
   4109  ff08		       f0		      .byte.b	%11110000	; right 1
   4110  ff09		       e0		      .byte.b	%11100000	; right 2
   4111  ff0a		       d0		      .byte.b	%11010000	; right 3
   4112  ff0b		       c0		      .byte.b	%11000000	; right 4
   4113  ff0c		       b0		      .byte.b	%10110000	; right 5
   4114  ff0d		       a0		      .byte.b	%10100000	; right 6
   4115  ff0e		       90		      .byte.b	%10010000	; right 7
   4116  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   4117  ff0f
   4118  ff0f							; ==============================================================================
   4119  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4120  ff0f							; ==============================================================================
   4121  ff0f							; Andrew Davie session-24 routine:
   4122  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4123  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4124  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4125  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4126  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4127  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4128  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4129  ff0f							;
   4130  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4131  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4132  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4133  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4134  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
