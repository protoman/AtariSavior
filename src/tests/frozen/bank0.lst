    982  f123							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
    983  f123							; ObjTop..ObjTop+11 window → row byte from ObjSprites[ObjBase + offset].
    984  f123							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
    985  f123							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
