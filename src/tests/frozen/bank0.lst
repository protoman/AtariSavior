   4524  ff00							; ==============================================================================
   4525  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   4526  ff00							; ==============================================================================
   4527  ff00					      org	$FF00
   4528  ff00				   fineAdjustBegin
   4529  ff00		       70		      .byte.b	%01110000	; left 7
   4530  ff01		       60		      .byte.b	%01100000	; left 6
   4531  ff02		       50		      .byte.b	%01010000	; left 5
   4532  ff03		       40		      .byte.b	%01000000	; left 4
   4533  ff04		       30		      .byte.b	%00110000	; left 3
   4534  ff05		       20		      .byte.b	%00100000	; left 2
   4535  ff06		       10		      .byte.b	%00010000	; left 1
   4536  ff07		       00		      .byte.b	%00000000	; no movement
   4537  ff08		       f0		      .byte.b	%11110000	; right 1
   4538  ff09		       e0		      .byte.b	%11100000	; right 2
   4539  ff0a		       d0		      .byte.b	%11010000	; right 3
   4540  ff0b		       c0		      .byte.b	%11000000	; right 4
   4541  ff0c		       b0		      .byte.b	%10110000	; right 5
   4542  ff0d		       a0		      .byte.b	%10100000	; right 6
   4543  ff0e		       90		      .byte.b	%10010000	; right 7
   4544  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   4545  ff0f
   4546  ff0f							; ==============================================================================
   4547  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4548  ff0f							; ==============================================================================
   4549  ff0f							; Andrew Davie session-24 routine:
   4550  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4551  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4552  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4553  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4554  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4555  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4556  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4557  ff0f							;
   4558  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4559  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4560  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4561  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4562  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4563  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4564  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4565  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4566  ff0f				   SetObjectXPos subroutine
   4567  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4568  ff11		       38		      sec		; ensure carry flag
   4569  ff12				   .Div15Loop
   4570  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4571  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4572  ff16		       a8		      tay		; Y = remainder in -15..-1
   4573  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4574  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4575  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4576  ff1e		       60		      rts
   4577  ff1f
   4578  ff20					      org	$FF20
