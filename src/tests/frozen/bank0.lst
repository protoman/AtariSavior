   1506  f3cb							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1507  f3cb							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1508  f3cb		       a5 b1		      lda	EnemyDataLo
   1509  f3cd		       85 e5		      sta	FetchPtr
   1510  f3cf		       a5 b2		      lda	EnemyDataHi
   1511  f3d1		       85 e6		      sta	FetchPtr+1
   1512  f3d3		       a2 00		      ldx	#0
