   2580  f7c7							; uses — the twin cannot be skipped or shortened.
   2581  f7c7							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2582  f7c7							; ------------------------------------------------------------------------------
   2583  f7c7							; M1ColFromMeta — A = the async M1 sprite column (M1X) for this room, or 0 when
   2584  f7c7							; the room carries no side-1 patch.
   2585  f7c7							; MetaA ($99, RoomPF0Lo here) = ((m1_col+1) << 4) | band_mask | b3, written
   2586  f7c7							; convert_room.meta_bytes; M1X = 8*col + 7 is that field's inverse. Deriving it
   2587  f7c7							; here (instead of staging at room load) keeps bank3's pinned code untouched,
   2588  f7c7							; and it feeds the hot-overlap box test too, which reads M1X.
   2589  f7c7							; Flags: Z is left SET when A = 0, so the caller can branch right after.
   2590  f7c7							; ------------------------------------------------------------------------------
   2591  f7c7							; ------------------------------------------------------------------------------
   2592  f7c7							; DoorLocked — a locked door (M1 patch cell, PF-open) hit by the player.
   2593  f7c7							; In: nothing new (the overlay's box scratch is live). Out: C=1 blocked, or a
   2594  f7c7							; tail jump into HotOverlapFlag when the room is HOT, where the overlap body
   2595  f7c7							; also gets to apply the hot hit.
   2596  f7c7							; Why: the locked case used to jump straight to HotOverlapFlag, and its bank3
   2597  f7c7							; body returns C=0 when the hot stream has no hit — a cold room's door was
   2598  f7c7							; therefore walk-through (user report: "door is not solid, neither with nor
   2599  f7c7							; without the key").
   2600  f7c7							; ------------------------------------------------------------------------------
   2601  f7c7				   DoorLocked
   2602  f7c7		       a5 9a		      lda	RoomPF0Hi	; staged MetaB
   2603  f7c9		       29 40		      and	#$40	; b6 = mid_band_type hot shape
   2604  f7cb		       d0 02		      bne	.DLhot
   2605  f7cd		       38		      sec		; cold room: the door is simply solid
   2606  f7ce		       60		      rts
   2607  f7cf				   .DLhot
   2608  f7cf		       4c ec ff 	      jmp	HotOverlapFlag	; hot band: overlap body owns the hit (C=1)
   2609  f7d2
   2610  f7d2				   M1ColFromMeta
   2611  f7d2		       a5 ba		      lda	EnemyDeadMask
   2612  f7d4		       29 10		      and	#$10	; b4 = M1 strip destroyed -> transparent
   2613  f7d6		       d0 1c		      bne	.M1Cgone	;   (the collision overlay honours the same
   2614  f7d8							;   bit, so the sprite now dies with it)
   2615  f7d8		       a5 99		      lda	RoomPF0Lo	; bank3 stages MetaA over this dead pointer byte
   2616  f7da		       4a		      lsr
   2617  f7db		       4a		      lsr
   2618  f7dc		       4a		      lsr
   2619  f7dd		       4a		      lsr		; A = m1_col+1 (0 = no side-1 strip)
   2620  f7de		       f0 18		      beq	.M1Cnone
   2621  f7e0		       0a		      asl
   2622  f7e1		       0a		      asl
   2623  f7e2		       0a		      asl		; 8*(col+1)
   2624  f7e3		       38		      sec
   2625  f7e4		       e9 01		      sbc	#1	; 8*col+7 = the LEFT-half M1 column
   2626  f7e6		       48		      pha
   2627  f7e7		       a5 99		      lda	RoomPF0Lo
   2628  f7e9		       29 01		      and	#$01	; MetaA b0 = strip on the RIGHT half
   2629  f7eb		       f0 05		      beq	.M1Cleft
   2630  f7ed		       68		      pla
   2631  f7ee		       18		      clc
   2632  f7ef		       69 50		      adc	#80	; right half: 87 + 8*col
   2633  f7f1		       60		      rts		; Z clear
   2634  f7f2				   .M1Cleft
   2635  f7f2		       68		      pla
   2636  f7f3		       60		      rts		; A = 7 + 8*col, Z clear
   2637  f7f4				   .M1Cgone
   2638  f7f4		       a9 00		      lda	#0
   2639  f7f6		       85 b0		      sta	M1X	; strip destroyed: keep the byte honest too
   2640  f7f8				   .M1Cnone
   2641  f7f8		       60		      rts		; A = 0, Z set -> caller skips the sprite
   2642  f7f9
   2643  f7f9							; ------------------------------------------------------------------------------
   2644  f7f9							; SOSkipTail — the rotation slot picked a DEAD enemy (or a taken key). It used
   2645  f7f9							; to draw nothing, so the survivor showed only every 2nd frame: kill the enemy
   2646  f7f9							; next to the miner and the MINER started flickering (user 2026-10-25), and a
   2647  f7f9							; two-enemy room flickered its survivor. Hand the slot on instead:
   2648  f7f9							;   1. the miner is here -> draw the miner (every frame once the enemy is gone);
   2649  f7f9							;   2. else the room's other enemy (index ^ 1) if it exists and is alive;
   2650  f7f9							;   3. else nothing.
   2651  f7f9							; Terminates: step 2 jumps into the live path only for a LIVE partner, and a
   2652  f7f9							; taken key can re-enter here only once per frame (its partner is then dead).
   2653  f7f9							; ------------------------------------------------------------------------------
   2654  f7f9				   SOSkipTail
   2655  f7f9		       a5 a4		      lda	LevelMinerRoom
   2656  f7fb		       29 7f		      and	#$7f
   2657  f7fd		       c5 98		      cmp	RoomNo
   2658  f7ff		       d0 03		      bne	.SOSkipOther
   2659  f801		       4c b3 f6 	      jmp	.SOMinerDraw
   2660  f804				   .SOSkipOther
   2661  f804		       a5 b9		      lda	EnemyIndex
   2662  f806		       49 01		      eor	#1
   2663  f808		       aa		      tax
   2664  f809		       c5 b3		      cmp	EnemyCount
   2665  f80b		       b0 0c		      bcs	.SOSkipNone	; no such enemy
   2666  f80d		       a5 ba		      lda	EnemyDeadMask
   2667  f80f		       3d c9 f3 	      and	EnemyBitTable,X
   2668  f812		       d0 05		      bne	.SOSkipNone	; partner dead too
   2669  f814		       86 b9		      stx	EnemyIndex
   2670  f816		       4c ec f6 	      jmp	.SOEnemyLive
   2671  f819				   .SOSkipNone
   2672  f819		       a9 ff		      lda	#$FF
   2673  f81b		       85 b6		      sta	ObjBase
   2674  f81d		       4c 37 f7 	      jmp	.SODone
