   3827  fc93							; ------------------------------------------------------------------------------
   3828  fc93							; CheckBandTouch — overscan: if band on and sprite touches the water strip →
   3829  fc93							; life. Strip = bottom ~12 lines of the cave (bottom_band_plan rule 2);
   3830  fc93							; sprite origin RoomY >= 115 enters it (115 + 21 = 136 = the same feet
   3831  fc93							; depth the 12-row sprite had at 125).
   3832  fc93							; Same path as hot/enemy: lose life, then respawn 12 scanlines up (min 0).
   3833  fc93							; Band color = VBLANK-staged RoomBandColor ($D2, PF1Buf[3] dead-row alias;
   3834  fc93							; staged by the VBLANK fold from LevelEnemy+RoomNo*4+3 — a kernel-time fold
   3835  fc93							; overruns the .WaterRow line). Read inlined here and in .WaterRow (0 = off).
   3836  fc93							; ------------------------------------------------------------------------------
   3837  fc93				   CheckBandTouch
   3838  fc93		       a5 bc		      lda	RoomBandColor
   3839  fc95		       f0 09		      beq	.CBTdone	; band off
   3840  fc97		       a5 81		      lda	RoomY
   3841  fc99		       c9 73		      cmp	#115	; feet (RoomY+21) reach 136 in the strip
   3842  fc9b		       90 03		      bcc	.CBTdone	; above strip
   3843  fc9d		       20 a1 fc 	      jsr	LoseLifeBand
   3844  fca0				   .CBTdone
   3845  fca0		       60		      rts
