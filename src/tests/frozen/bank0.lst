   2758  f945							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2759  f945							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2760  f945							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2761  f945							; into them), so room complexity is unbounded and geometry parity is proven
   2762  f945							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2763  f945							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2764  f945							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2765  f945							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2766  f945							; mirror; bank2 display-space walkers add their own when they convert).
   2767  f945							; RectCount = running row, CollisionX = running col (both were walk temps
   2768  f945							; before — same ZP, no new allocation).
   2769  f945							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2770  f945							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2771  f945							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2772  f945		       a5 8d		      lda	CollisionCellY
   2773  f947		       85 92		      sta	RectCount
   2774  f949				   .CWRow
   2775  f949		       a5 8e		      lda	CollisionEndX
   2776  f94b		       85 8b		      sta	CollisionX
   2777  f94d		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2778  f94e							;   was re-loaded every cell — −8c/cell walk
   2779  f94e							;   trim for the falling+probe heavy frame)
   2780  f94e				   .CWCol
   2781  f94e		       a4 92		      ldy	RectCount
   2782  f950		       98		      tya
   2783  f951		       18		      clc
   2784  f952		       7d a9 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2785  f955		       a8		      tay
   2786  f956		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2787  f959		       3d bd fd 	      and	ColMask,X	; bit for this source col
   2788  f95c		       d0 13		      bne	.CWHit	; solid (Z=0)
   2789  f95e		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2790  f960		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2791  f962		       e8		      inx
   2792  f963		       86 8b		      stx	CollisionX
   2793  f965		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
