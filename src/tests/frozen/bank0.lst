    378 U00bc							; Jetpack physics constants (HERO-style)
    379 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    380 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    381 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    382 U00bc							; capped by the -$0100 rise clamp. From rest the
    383 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    384 U00bc							; take-off still eases in (~0.15 s); from a
    385 U00bc							; terminal 1.5 px/frame fall a held jet applies
    386 U00bc							; JET_MAX immediately and stops it in ~10 frames
    387 U00bc							; (HERO feel, user report 2026-10-22 — the old
    388 U00bc							; ÷4 gate needed ~80 frames to beat gravity).
    389 U00bc		       01 80	   MAX_FALL   =	$0180	; max fall speed (positive = down). Was $0200
    390 U00bc							; (2.0 px/frame) — the terminal fall felt too
    391 U00bc							; fast (user report 2026-10-21): 1.5 px/frame.
    392 U00bc
