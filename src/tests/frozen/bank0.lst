   2935  f945							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2936  f945							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2937  f945							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2938  f945							; into them), so room complexity is unbounded and geometry parity is proven
   2939  f945							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2940  f945							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2941  f945							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2942  f945							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2943  f945							; mirror; bank2 display-space walkers add their own when they convert).
   2944  f945							; RectCount = running row, CollisionX = running col (both were walk temps
   2945  f945							; before — same ZP, no new allocation).
   2946  f945							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2947  f945							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2948  f945							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2949  f945		       a5 8d		      lda	CollisionCellY
   2950  f947		       85 92		      sta	RectCount
   2951  f949				   .CWRow
   2952  f949		       a5 8e		      lda	CollisionEndX
   2953  f94b		       85 8b		      sta	CollisionX
   2954  f94d		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2955  f94e							;   was re-loaded every cell — −8c/cell walk
   2956  f94e							;   trim for the falling+probe heavy frame)
   2957  f94e				   .CWCol
   2958  f94e		       a4 92		      ldy	RectCount
   2959  f950		       98		      tya
   2960  f951		       18		      clc
   2961  f952		       7d ad fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2962  f955		       a8		      tay
   2963  f956		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2964  f959		       3d c1 fd 	      and	ColMask,X	; bit for this source col
   2965  f95c		       d0 13		      bne	.CWHit	; solid (Z=0)
   2966  f95e		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2967  f960		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2968  f962		       e8		      inx
   2969  f963		       86 8b		      stx	CollisionX
   2970  f965		       d0 e7		      bne	.CWCol	; always (col never wraps to 0)
   2971  f967				   .CWRowDone
