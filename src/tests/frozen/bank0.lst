   3944  fef3		       4c 10 f1 	      jmp	$F110	; bank2 MothRoutine (dead in bank0; guard pins
   3945  fef6							;   bank0/bank2 operands == bank2.lst label)
   3946  fef6					      .ds	$FEF6 - *, 0	; pin address (main size drift must not move it)
   3947  fef6				   FoldIndirect
   3948  fef6		       8d f8 1f 	      sta	$1FF8
