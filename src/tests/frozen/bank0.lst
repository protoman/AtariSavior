   3560  fecf		       a9 00		      lda	#0
   3561  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3562  fed3				   .TWait
   3563  fed3		       ad 84 02 	      lda	INTIM
   3564  fed6		       d0 fb		      bne	.TWait
   3565  fed8		       4c 39 f0 	      jmp	StartFrame
