   3099  f9c1							;		     selector 3 = HMM1/RESM1, left-col block x = 7+8*col
   3100  f9c1							;		     (passed to SetObjectXPos as M1X+1 — Stella draws 8-wide
   3101  f9c1							;		     M1 one clock left of the [A-7,A] player contract).
   3102  f9c1							;		     ENAM1 latched #$02 for the whole cave (hero-style: 2
   3103  f9c1							;		     ENAM writes/frame — enable here, clear in .AfterRows);
   3104  f9c1							;		     walls hide the parked M1 in unpatched bands (PF > M1 in
   3105  f9c1							;		     the priority chain — convert enforces the solid cell).
   3106  f9c1							; Runs before the single HMOVE (HMP0+X shadow registers accumulate).
   3107  f9c1							; Sym path cost: jsr+rts overhead only — no RESP/HMP write, frames stay
