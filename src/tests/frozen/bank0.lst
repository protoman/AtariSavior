    336 U00bc		       00 0c	   PLAYER_HEIGHT =	12	; GRP1 object HIT BOX rows (enemy/miner) — the
    337 U00bc							;   player-vs-object overlap tests use this. It
    338 U00bc							;   is deliberately NOT the drawing window any
    339 U00bc							;   more (Phase 6, 2026-10-22): tall art must
    340 U00bc							;   not silently enlarge the hit boxes.
    341 U00bc		       00 10	   OBJ_WINDOW =	16	; GRP1 drawing window rows: the .Line test
    342 U00bc							;   `Y - ObjTop < OBJ_WINDOW`. Every design's
    343 U00bc							;   art + colour rows are sized to this
    344 U00bc							;   (ObjSprites/ObjColorTab, 9 x 16 = 144 B
    345 U00bc							;   each). Growing a design's ART past its old
    346 U00bc							;   12 rows is a per-type art change; the
    347 U00bc							;   window has the room reserved already.
    348 U00bc		       00 0c	   PLAYER_SPRITE_H =	12	; player sprite height in scanlines (8x12)
    349 U00bc		       00 07	   PLAYER_WIDTH =	7	; lit player sprite spans 7 pixels; REFP0 shift handled
    350 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    351 U00bc		       00 04	   LAMP_WIDTH =	4	; OBJ_LAMP uses GRP1's leftmost 4 lit pixels
    352 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    353 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    354 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    355 U00bc							; placed X, so the snake retreats a tile behind
    356 U00bc							; its placement and then comes out a tile — 2
    357 U00bc							; tiles of travel total. The editor cannot ask
    358 U00bc							; the user to place it 2 tiles from the border.
