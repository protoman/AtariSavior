   1934  f602				   .SOFull
   1935  f602		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   1936  f604							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   1937  f604		       a5 b5		      lda	BombPacked
   1938  f606		       29 03		      and	#%00000011
   1939  f608		       c9 01		      cmp	#1
   1940  f60a		       d0 19		      bne	.SOCount
   1941  f60c		       a5 f7		      lda	BombTimer
   1942  f60e		       29 03		      and	#3
   1943  f610		       d0 13		      bne	.SOCount	; 3 of 4 -> miner/enemy
   1944  f612		       a9 40		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   1945  f614		       85 b6		      sta	ObjBase
   1946  f616		       a5 f6		      lda	BombX
   1947  f618		       85 b7		      sta	ActiveObjectX
   1948  f61a		       a5 85		      lda	BombY
   1949  f61c		       85 b8		      sta	ActiveObjectY
   1950  f61e		       a9 46		      lda	#COLOR_BOMBS	; $46 red (P1 X set by the .SODone tail)
   1951  f620		       85 07		      sta	COLUP1
   1952  f622		       4c d1 f6 	      jmp	.SODone	; ObjTop/Bot from ActiveObjectY
   1953  f625				   .SOCount
   1954  f625							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   1955  f625		       a5 b3		      lda	EnemyCount
