   3612  fd32							; ------------------------------------------------------------------------------
   3613  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3614  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3615  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3616  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3617  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3618  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3619  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3620  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3621  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3622  fd32							;	    the real drop-in → gameplay starts
   3623  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3624  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3625  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3626  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3627  fd32							; ------------------------------------------------------------------------------
   3628  fd32				   TitleWork
   3629  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3630  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3631  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3632  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3633  fd3a				   .TWselDone
   3634  fd3a							; --- RESET edge ---
   3635  fd3a		       a5 97		      lda	StepsLeft
   3636  fd3c		       29 01		      and	#%00000001
   3637  fd3e		       f0 14		      beq	.TWrstDone
   3638  fd40		       ad 82 02 	      lda	SWCHB
   3639  fd43		       29 01		      and	#%00000001
   3640  fd45		       d0 0d		      bne	.TWrstDone
   3641  fd47		       a9 00		      lda	#0
   3642  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3643  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3644  fd4d		       85 f4		      sta	ScoreHu
   3645  fd4f		       85 f5		      sta	ScoreTe
   3646  fd51		       20 20 fc 	      jsr	LoadLevel
   3647  fd54				   .TWrstDone
   3648  fd54		       ad 82 02 	      lda	SWCHB
   3649  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3650  fd59							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3651  fd59							;     channel force-muted here — UpdateJetSound is skipped because
   3652  fd59							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3653  fd59							;     = 0, AUDV0 covered above). ---
   3654  fd59				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3655  fd59		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3656  fd5b		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3657  fd5d		       f0 0e		      beq	.TWmusic
   3658  fd5f		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3659  fd61		       20 94 f5 	      jsr	BombTick
   3660  fd64				   .TWnoTick
   3661  fd64		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3662  fd67		       a9 00		      lda	#0
   3663  fd69		       85 1a		      sta	AUDV1
   3664  fd6b		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3665  fd6d				   .TWmusic		; title: music wins the audio regs
   3666  fd6d		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3667  fd70				   .TWwait
   3668  fd70		       ad 84 02 	      lda	INTIM
   3669  fd73		       d0 fb		      bne	.TWwait
   3670  fd75		       4c 39 f0 	      jmp	StartFrame
   3671  fd78
   3672  fd78							; ------------------------------------------------------------------------------
   3673  fd78							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3674  fd78							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3675  fd78							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3676  fd78							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3677  fd78							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3678  fd78							; DeriveEnemyY — no persistent movement state exists in RAM.
   3679  fd78							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3680  fd78							; block after the pads; pre-pad headroom is 1B).
   3681  fd78							; ------------------------------------------------------------------------------
   3682  fd78				   RefreshEnemyY
   3683  fd78
   3684  fd78		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3685  fd7a							; TickCounter is the 60-frame GAME timer
   3686  fd7a							; (decrements 60->1, reloads) — gates derived
   3687  fd7a							; from it wrapped every second (spider
   3688  fd7a							; "teleported": (TC>>3)&63 only ever saw
   3689  fd7a							; 0..7 and counted DOWN 0->7 = jump).
   3690  fd7a		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3691  fd7c		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3692  fd7e				   .REYLoop		; every reader runs after refresh completes)
   3693  fd7e		       ca		      dex
   3694  fd7f		       20 92 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3695  fd82		       95 e2		      sta	EnemyRamY,X
   3696  fd84		       8a		      txa		; N/Z must come from X: flags after jsr are
   3697  fd85		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3698  fd87				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3699  fd87							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3700  fd87							; black rooms, broken PF, invisible sprites)
   3701  fd87							; --- SELECT or RESET held → back to the old title / level-select screen
   3702  fd87							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3703  fd87							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3704  fd87							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3705  fd87							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3706  fd87							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3707  fd87							;     RESET held past LANDING still re-fires — press must be released
   3708  fd87							;     before the drop-in finishes. ---
   3709  fd87		       a5 8a		      lda	DropTarget
   3710  fd89		       d0 17		      bne	.REYRts	; not idle: not ours
   3711  fd8b		       ad 82 02 	      lda	SWCHB
   3712  fd8e		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3713  fd90		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3714  fd92		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3715  fd94		       f0 0c		      beq	.REYRts	; neither pressed
   3716  fd96		       a9 ff		      lda	#$FF
   3717  fd98		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3718  fd9a		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3719  fd9d		       68		      pla		; drop OUR return address (LoadLevel already
   3720  fd9e		       68		      pla		;   popped its own) — tail into TitleWork
   3721  fd9f		       4c 32 fd 	      jmp	TitleWork
   3722  fda2				   .REYRts
   3723  fda2		       60		      rts
   3724  fda3
   3725  fda3							; ------------------------------------------------------------------------------
   3726  fda3							; BuildColupF — 12-byte final COLUPF image at ColupfBuf ($E7-$F2).
   3727  fda3							;   Stripe: rows 0,2 = LevelWallColor; row 1 = LevelWallColor2.
   3728  fda3							;   Hot rows overwrite with TickCounter-bit4 pulse (COLOR_HOT_Y/R).
   3729  fda3							;   $F0-$F2 (bombs) NO LONGER overlap-saved: body writes rows 0-2 only,
   3730  fda3							;   save/restore round trip deleted (S3.0b — window audit: zero writers).
   3731  fda3							;   Bank1 clobbers $E0-$EF during HUD; VBLANK rebuilds every frame.
   3732  fda3							; ------------------------------------------------------------------------------
   3733  fda3							; ------------------------------------------------------------------------------
   3734  fda3							; BuildColupF — MOVED to bank2 (S5.1) — CallPad_BuildColupF.
   3735  fda3							;   Hot-rect data (RoomRects) lives in bank2, so the body reads it with
   3736  fda3							;   direct (FetchPtr),Y — the shared $FEF6 fold block's sta $1FF6 always
   3737  fda3							;   returns to bank0, so a fold inside a bank1 body could not work.
   3738  fda3							;   The dark check is inlined there too: CallPad_IsRoomDark cannot nest
   3739  fda3							;   from a pad body (ReturnPad switches to bank0 mid-call).
   3740  fda3							;   Body: bank2.asm, pinned at $FC4F. Entry save block ($F0-$F2 → collision
   3741  fda3							;   temps) was dead (rows 0-2 only) — deleted with the .AfterRows restore
   3742  fda3							;   in S3.0b.
   3743  fda3							; ------------------------------------------------------------------------------
   3744  fda3
   3745  fda3							; UpdateBombSound moved to bank1 (leaf_move_plan batch A) — CallPad_UpdateBombSound.
   3746  fda3
   3747  fda3							; ------------------------------------------------------------------------------
   3748  fda3							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3749  fda3							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3750  fda3							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3751  fda3							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3752  fda3							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3753  fda3							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3754  fda3							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3755  fda3							;   tools/test_cell_map.py).
   3756  fda3							;   (The standalone CellSolid leaf that lived here moved INTO
   3757  fda3							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3758  fda3							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3759  fda3							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3760  fda3							; ------------------------------------------------------------------------------
   3761  fda3		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3762  fdb7		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3763  fdc3		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3764  fdcb
   3765  fdcb							; ------------------------------------------------------------------------------
   3766  fdcb							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   3767  fdcb							; BombTick `jsr` lands here (bank0), `sta $1FF8` switches to bank2, the `jmp`
   3768  fdcb							; is fetched from bank2's byte-identical mirror at this same address and
   3769  fdcb							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   3770  fdcb							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   3771  fdcb							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   3772  fdcb							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   3773  fdcb							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   3774  fdcb							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   3775  fdcb							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   3776  fdcb							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   3777  fdcb							; ------------------------------------------------------------------------------
   3778  fdcb		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   3779  fdd8				   BombEnemyBlast
   3780  fdd8		       8d f8 1f 	      sta	$1FF8
   3781  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3782  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3783  fdde							;   span)
   3784  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3785  fdde							;   latch + feature gate pushed +14; same day
   3786  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3787  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3788  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3789  fdde							;   garbage path's `inc $4A,X` set wall bits
   3790  fdde							;   via $CA)
   3791  fdde
   3792  fdde							; ------------------------------------------------------------------------------
   3793  fdde							; PickPlayerFrame tramp RETIRED (2026-10-20, repack chunk 1): the body now
   3794  fdde							; lives in bank0 ($F9F5 region), so the VBL `jsr PickPlayerFrame` resolves
   3795  fdde							; in-bank and the 6-byte `sta $1FF8 / jmp $F3C4` pad plus its bank2 mirror
   3796  fdde							; are gone. PlayerWalkA/B flow up to $FDDE (nothing pins them any more).
   3797  fdde							; ------------------------------------------------------------------------------
