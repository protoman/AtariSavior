   3345  fda2							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3346  fda2							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3347  fda2							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3348  fda2							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3349  fda2							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3350  fda2							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3351  fda2							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3352  fda2							;   tools/test_cell_map.py).
   3353  fda2							;   (The standalone CellSolid leaf that lived here moved INTO
   3354  fda2							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3355  fda2							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3356  fda2							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3357  fda2							; ------------------------------------------------------------------------------
   3358  fda2		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3359  fdb6		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3360  fdc2		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
