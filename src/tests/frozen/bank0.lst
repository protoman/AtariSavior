   3576  fd32							; ------------------------------------------------------------------------------
   3577  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3578  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3579  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3580  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3581  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3582  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3583  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3584  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3585  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3586  fd32							;	    the real drop-in → gameplay starts
   3587  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3588  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3589  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3590  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3591  fd32							; ------------------------------------------------------------------------------
   3592  fd32				   TitleWork
   3593  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3594  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3595  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3596  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3597  fd3a				   .TWselDone
   3598  fd3a							; --- RESET edge ---
   3599  fd3a		       a5 97		      lda	StepsLeft
   3600  fd3c		       29 01		      and	#%00000001
   3601  fd3e		       f0 14		      beq	.TWrstDone
   3602  fd40		       ad 82 02 	      lda	SWCHB
   3603  fd43		       29 01		      and	#%00000001
   3604  fd45		       d0 0d		      bne	.TWrstDone
   3605  fd47		       a9 00		      lda	#0
   3606  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3607  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3608  fd4d		       85 f4		      sta	ScoreHu
   3609  fd4f		       85 f5		      sta	ScoreTe
   3610  fd51		       20 20 fc 	      jsr	LoadLevel
   3611  fd54				   .TWrstDone
   3612  fd54		       ad 82 02 	      lda	SWCHB
   3613  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
