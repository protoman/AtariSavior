   1855  f4de		       29 3f		      and	#$3F	; p = 0..63
   1856  f4e0		       c9 30		      cmp	#48
   1857  f4e2		       90 04		      bcc	.DEYSUp
   1858  f4e4		       a9 00		      lda	#0	; dwell: p 48..63 (clock wrap lands here)
   1859  f4e6		       f0 e7		      beq	DEYDelta	; always
   1860  f4e8				   .DEYSUp
