    418 U00bc							; ==============================================================================
    419 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    420 U00bc							; ==============================================================================
    421 U00bc							; Bank3 is the power-up bank. Its stub does:
    422 U00bc							;   lda #0 / sta $1FF6 → selects bank0
    423 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    424 U00bc							; ==============================================================================
    425  10000 ????				       seg	code
    426  f000					      org	$F000
    427  f000
    428  f000							; --- 5-byte bankswitching pad ---
    429  f000							; After bank3's stub selects us, CPU arrives here.
    430  f000							; We jump over the pad into the real init code.
    431  f000		       a9 00		      lda	#0
    432  f002		       8d f6 1f 	      sta	$1FF6	; ensure bank0 selected (idempotent)
    433  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    434  f008							; (NOT deletable: $F008 = GameStart is a
    435  f008							;  hardcoded cross-bank entry — bank1
    436  f008							;  stub `jmp $F008`; this jmp also keeps
    437  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    438  f008							;  fold-pad byte guard fires when it moves)
    439  f008							;  + F0xx landmarks fixed)
    440  f008
    441  f008				   GameStart
    442  f008		       78		      sei		; disable interrupts
    443  f009		       d8		      cld		; clear decimal mode
    444  f00a		       a2 ff		      ldx	#$FF
    445  f00c		       9a		      txs		; stack pointer = $FF
    446  f00d
    447  f00d							; --- Clear zero-page RAM ---
    448  f00d		       a9 00		      lda	#0
    449  f00f		       a2 80		      ldx	#$80
    450  f011				   .ClearZP
    451  f011		       95 00		      sta	$00,X
    452  f013		       e8		      inx
    453  f014		       d0 fb		      bne	.ClearZP
    454  f016
    455  f016							; --- Initialize game state ---
    456  f016		       a9 00		      lda	#0
    457  f018		       85 a3		      sta	Level
    458  f01a		       a9 03		      lda	#3
    459  f01c		       85 ac		      sta	PlayerLives
    460  f01e		       a9 05		      lda	#BOMBS_MAX
    461  f020		       85 f0		      sta	PlayerBombs
    462  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    463  f022		       a9 3c		      lda	#60
    464  f024		       85 ad		      sta	TickCounter
    465  f026		       a9 78		      lda	#120
    466  f028		       85 ae		      sta	BarLevel	; bar starts full
    467  f02a							; --- Intro screen: DropTarget=$FD sentinel (2026-10-06 — SAVIOR splash
    468  f02a							;     shows ONCE at power-on; first SELECT/RESET edge anywhere moves to
    469  f02a							;     the old title $FF = first room + HUD stage count; valid fall
    470  f02a							;     targets are Y ≤ 191, sentinels $FD/$FE/$FF all "not a fall"). ---
    471  f02a		       a9 fd		      lda	#$FD
    472  f02c		       85 8a		      sta	DropTarget
    473  f02e
    474  f02e							; --- Load first level ---
    475  f02e		       20 91 f5 	      jsr	LoadLevel
    476  f031		       a9 14		      lda	#20
    477  f033		       85 80		      sta	RoomX	; title flight starts on left side
    478  f035		       a9 00		      lda	#0
    479  f037		       85 81		      sta	RoomY	; offset in title's fixed flight window
    480  f039
    481  f039							; --- Set player color ---
