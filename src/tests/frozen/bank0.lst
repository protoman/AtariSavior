   1793  f4c0		       a5 c2		      lda	EnemyRamP
   1794  f4c2		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1795  f4c3		       4c cb f4 	      jmp	.DEYBobTick
