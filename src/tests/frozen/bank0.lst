   2254  f65d		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2255  f65f							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2256  f65f		       a5 b5		      lda	BombPacked
   2257  f661		       29 03		      and	#%00000011
   2258  f663		       c9 01		      cmp	#1
