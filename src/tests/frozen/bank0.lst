   3454  fda9							; ------------------------------------------------------------------------------
   3455  fda9							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3456  fda9							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3457  fda9							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3458  fda9							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3459  fda9							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3460  fda9							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3461  fda9							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3462  fda9							;   tools/test_cell_map.py).
   3463  fda9							;   (The standalone CellSolid leaf that lived here moved INTO
   3464  fda9							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3465  fda9							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3466  fda9							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3467  fda9							; ------------------------------------------------------------------------------
   3468  fda9		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3469  fdbd		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3470  fdc9		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   3471  fdd1
