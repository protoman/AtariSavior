   3330  fd7e							; ------------------------------------------------------------------------------
   3331  fd7e							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3332  fd7e							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3333  fd7e							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3334  fd7e							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3335  fd7e							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3336  fd7e							; DeriveEnemyY — no persistent movement state exists in RAM.
   3337  fd7e							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3338  fd7e							; block after the pads; pre-pad headroom is 1B).
   3339  fd7e							; ------------------------------------------------------------------------------
   3340  fd7e				   RefreshEnemyY
   3341  fd7e		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3342  fd80							; TickCounter is the 60-frame GAME timer
   3343  fd80							; (decrements 60->1, reloads) — gates derived
   3344  fd80							; from it wrapped every second (spider
   3345  fd80							; "teleported": (TC>>3)&63 only ever saw
   3346  fd80							; 0..7 and counted DOWN 0->7 = jump).
   3347  fd80		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3348  fd82		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3349  fd84				   .REYLoop		; every reader runs after refresh completes)
   3350  fd84		       ca		      dex
   3351  fd85		       20 ac f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3352  fd88		       95 e2		      sta	EnemyRamY,X
   3353  fd8a		       8a		      txa		; N/Z must come from X: flags after jsr are
   3354  fd8b		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3355  fd8d				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3356  fd8d							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3357  fd8d							; black rooms, broken PF, invisible sprites)
   3358  fd8d							; --- SELECT or RESET held → back to the old title / level-select screen
   3359  fd8d							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3360  fd8d							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3361  fd8d							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3362  fd8d							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3363  fd8d							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3364  fd8d							;     RESET held past LANDING still re-fires — press must be released
   3365  fd8d							;     before the drop-in finishes. ---
   3366  fd8d		       a5 8a		      lda	DropTarget
   3367  fd8f		       d0 17		      bne	.REYRts	; not idle: not ours
   3368  fd91		       ad 82 02 	      lda	SWCHB
   3369  fd94		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3370  fd96		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3371  fd98		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3372  fd9a		       f0 0c		      beq	.REYRts	; neither pressed
   3373  fd9c		       a9 ff		      lda	#$FF
   3374  fd9e		       85 8a		      sta	DropTarget	; title sentinel (intro $FD lands here too)
   3375  fda0		       20 68 f5 	      jsr	LoadLevel	; tail → DropArm .DATitle (score/objects)
   3376  fda3		       68		      pla		; drop OUR return address (LoadLevel already
   3377  fda4		       68		      pla		;   popped its own) — tail into TitleWork
   3378  fda5		       4c 38 fd 	      jmp	TitleWork
