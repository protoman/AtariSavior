   2666  f9ba		       f0 06		      beq	.OTsym	; sym: clc/rts in bank0, never switches
   2667  f9bc		       8d f8 1f 	      sta	$1FF8	; select bank2 (F6 ignores the value)
   2668  f9bf		       4c 00 fe 	      jmp	$FE00	; bank2 PHMOverlay (dead in bank0 — the
   2669  f9c2							; twin's jmp operand is the live one)
   2670  f9c2				   .OTsym
   2671  f9c2		       18		      clc
