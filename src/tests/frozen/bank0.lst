   3823  fe90							; end is kept so FoldIndirect stays at $FE90.
   3824  fe90							; BOTH same-page 4c fetches (verify guards);
   3825  fe90							; end $FE8F -> HOF tramp $FE90 (shifted +$10,
   3826  fe90							; mirrors+HOF_ENTRY/LHT_ENTRY synced)
