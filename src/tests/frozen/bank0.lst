   3794  fe05		       f2		      .byte.b	$f2	; bat — hue 15 luma 7 = brown
   3795  fe06		       c4		      .byte.b	$c4	; snake — hue 12 luma 2 = green
   3796  fe07		       0e		      .byte.b	$0e	; tentacle — hue 0 luma 7 = white
   3797  fe08		       22		      .byte.b	$22	; moth — hue 2 luma 1 = dark orange
   3798  fe09		       0e		      .byte.b	$0e	; lamp (type 5) — white; dark rooms override to grey
   3799  fe0a		       1c		      .byte.b	$1C	; key (type 6) — yellow
   3800  fe0b		       c4		      .byte.b	$c4	; raft (type 7) — green, matching the SNAKE art
   3801  fe0c							; slot it borrows ($c4 = ObjColorTab slot 6). User
