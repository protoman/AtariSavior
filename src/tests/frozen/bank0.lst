    889  f129							; BeamMask = {0,0,2,0,0...} → ENAM0 on RoomY+2 only (single yellow
    890  f129							; strip — user directive 2026-10-08: the red row-3 strip is gone;
    891  f129							; kill window in LaserHitTestBody keeps rows RoomY+2..3 = superset).
