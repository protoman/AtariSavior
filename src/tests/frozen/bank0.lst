    856  f0e7							; inherits it until .Line's object path.
    857  f0e7							; Same c51 slot the old no-door path used
    858  f0e7							; (AFTER the left half, same rule as COLUPF)
    859  f0e7		       a5 8d		      lda	CollisionCellY	; P2b door color staged by the VBL:
    860  f0e9							; $80 = no door / $1C = yellow stripe
    861  f0e9		       30 04		      bmi	.M1done	; no door: COLUP1/Temp already hold the band
    862  f0eb							;   colour, nothing left to do
    863  f0eb		       85 07		      sta	COLUP1	; door: yellow (only visible on the door's
    864  f0ed							;   open bands — wall PF hides it elsewhere)
    865  f0ed		       85 88		      sta	Temp	; bugs.md #15: .ObjZero's plain restore must
    866  f0ef							;   keep the stripe yellow
