   3730  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3731  ff3a		       8a		      txa
   3732  ff3b		       29 80		      and	#LASER_HELD
   3733  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
