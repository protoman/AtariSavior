   3292  fd37							; ------------------------------------------------------------------------------
   3293  fd37							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3294  fd37							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3295  fd37							; selected level number (digits band) and the credits; the theme plays here.
   3296  fd37							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3297  fd37							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3298  fd37							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3299  fd37							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3300  fd37							;	    the intro exit ate the first press and made #2 read as dead)
   3301  fd37							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3302  fd37							;	    the real drop-in → gameplay starts
   3303  fd37							; ($FD reaches here directly — merged title, 2026-10-19.)
   3304  fd37							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3305  fd37							; title-owned; the first play frame rewrites it as the step budget).
   3306  fd37							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3307  fd37							; ------------------------------------------------------------------------------
   3308  fd37				   TitleWork
   3309  fd37							; --- SELECT edge (TitleSelect, fill region) ---
   3310  fd37		       20 4f fc 	      jsr	CallPad_TitleSelect
   3311  fd3a		       90 03		      bcc	.TWselDone	; C=0: no edge
   3312  fd3c		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3313  fd3f				   .TWselDone
   3314  fd3f							; --- RESET edge ---
   3315  fd3f		       a5 97		      lda	StepsLeft
   3316  fd41		       29 01		      and	#%00000001
   3317  fd43		       f0 14		      beq	.TWrstDone
   3318  fd45		       ad 82 02 	      lda	SWCHB
   3319  fd48		       29 01		      and	#%00000001
   3320  fd4a		       d0 0d		      bne	.TWrstDone
   3321  fd4c		       a9 00		      lda	#0
   3322  fd4e		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3323  fd50		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3324  fd52		       85 f4		      sta	ScoreHu
   3325  fd54		       85 f5		      sta	ScoreTe
   3326  fd56		       20 20 fc 	      jsr	LoadLevel
   3327  fd59				   .TWrstDone
   3328  fd59		       ad 82 02 	      lda	SWCHB
   3329  fd5c		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3330  fd5e							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3331  fd5e							;     channel force-muted here — UpdateJetSound is skipped because
   3332  fd5e							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3333  fd5e							;     = 0, AUDV0 covered above). ---
