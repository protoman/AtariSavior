   3146  fcc7							; ------------------------------------------------------------------------------
   3147  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3148  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3149  fcc7							; caller; Y is animated from the screen top down to it).
   3150  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3151  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3152  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3153  fcc7							;
   3154  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3155  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3156  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3157  fcc7							;
   3158  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3159  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3160  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3161  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3162  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3163  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3164  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3165  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3166  fcc7							; ------------------------------------------------------------------------------
   3167  fcc7				   DropArm
   3168  fcc7		       a5 8a		      lda	DropTarget
   3169  fcc9		       c9 fd		      cmp	#$FD
   3170  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FD intro / $FF old title → static
   3171  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3172  fccd							;   tally cleared to 0 by TallyWork before its
   3173  fccd							;   LoadLevel — same-size swap 2026-10-06)
   3174  fccd		       a5 81		      lda	RoomY
   3175  fccf		       85 8a		      sta	DropTarget
   3176  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3177  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3178  fcd5		       a9 00		      lda	#0
   3179  fcd7		       85 81		      sta	RoomY
   3180  fcd9		       85 95		      sta	PlayerYSub
   3181  fcdb		       85 93		      sta	vyLo
   3182  fcdd		       85 94		      sta	vyHi
   3183  fcdf		       a5 c0		      lda	LaserState
   3184  fce1		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3185  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3186  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3187  fce7		       85 83		      sta	LaserX
   3188  fce9		       18		      clc
   3189  fcea		       60		      rts
