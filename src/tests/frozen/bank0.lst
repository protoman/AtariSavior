   2558  f974		       a5 8e		      lda	CollisionEndX
   2559  f976		       c5 8c		      cmp	CollisionCellX
   2560  f978		       90 06		      bcc	.colsOk
   2561  f97a		       a6 8c		      ldx	CollisionCellX
