   2247  f7af		       d0 2a		      bne	.BTDone
   2248  f7b1		       a5 b5		      lda	BombPacked	; 1 → 2
   2249  f7b3		       29 fc		      and	#%11111100
   2250  f7b5		       09 02		      ora	#%00000010
   2251  f7b7		       85 b5		      sta	BombPacked
   2252  f7b9		       a9 3c		      lda	#60
   2253  f7bb		       85 f7		      sta	BombTimer
