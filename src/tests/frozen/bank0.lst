   3253  fd58		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3254  fd5a		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3255  fd5c		       f0 0e		      beq	.TWmusic
