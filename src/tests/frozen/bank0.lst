    491 U00bc							; ==============================================================================
    492 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    493 U00bc							; ==============================================================================
    494 U00bc							; Bank3 is the power-up bank. Its stub does:
    495 U00bc							;   lda #0 / sta $1FF4 → selects bank0
    496 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    497 U00bc							; ==============================================================================
    498  10000 ????				       seg	code
    499  f000					      org	$F000
    500  f000
    501  f000							; --- 5-byte bankswitching pad ---
    502  f000							; After bank3's stub selects us, CPU arrives here.
    503  f000							; We jump over the pad into the real init code.
    504  f000		       a9 00		      lda	#0
    505  f002		       8d f4 1f 	      sta	$1FF4	; ensure bank0 selected (idempotent)
    506  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    507  f008							; (NOT deletable: $F008 = GameStart is a
    508  f008							;  hardcoded cross-bank entry — bank1
    509  f008							;  stub `jmp $F008`; this jmp also keeps
    510  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    511  f008							;  fold-pad byte guard fires when it moves)
    512  f008							;  + F0xx landmarks fixed)
    513  f008
    514  f008				   GameStart
    515  f008		       78		      sei		; disable interrupts
    516  f009		       d8		      cld		; clear decimal mode
    517  f00a		       a2 ff		      ldx	#$FF
    518  f00c		       9a		      txs		; stack pointer = $FF
    519  f00d
    520  f00d							; --- Clear zero-page RAM ---
    521  f00d		       a9 00		      lda	#0
    522  f00f		       a2 80		      ldx	#$80
    523  f011				   .ClearZP
    524  f011		       95 00		      sta	$00,X
    525  f013		       e8		      inx
    526  f014		       d0 fb		      bne	.ClearZP
    527  f016
    528  f016							; --- Initialize game state ---
    529  f016		       a9 00		      lda	#0
    530  f018		       85 a3		      sta	Level
    531  f01a		       a9 03		      lda	#3
    532  f01c		       85 ac		      sta	PlayerLives
    533  f01e		       a9 05		      lda	#BOMBS_MAX
    534  f020		       85 f0		      sta	PlayerBombs
    535  f022							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s
    536  f022		       a9 3c		      lda	#60
    537  f024		       85 ad		      sta	TickCounter
    538  f026		       a9 78		      lda	#120
    539  f028		       85 ae		      sta	BarLevel	; bar starts full
    540  f02a							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    541  f02a							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    542  f02a							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    543  f02a							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    544  f02a							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    545  f02a		       a9 ff		      lda	#$FF
    546  f02c		       85 8a		      sta	DropTarget
    547  f02e
    548  f02e							; --- Load first level (the title previews it on the live stage:
    549  f02e							;     LoadLevel leaves the player at the level start, no flight) ---
    550  f02e		       20 20 fc 	      jsr	LoadLevel
    551  f031
    552  f031							; --- Set player color ---
    553  f031		       a9 48		      lda	#COLOR_PLAYER
    554  f033		       85 06		      sta	COLUP0
    555  f035
    556  f035							; --- Set playfield to reflected mode + priority ---
    557  f035							; D0=1 = reflect (left half mirrors to right)
    558  f035							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    559  f035							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    560  f035							; disabled at kernel entry, size only matters once Phase 3 enables it)
    561  f035		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    562  f037		       85 0a		      sta	CTRLPF
    563  f039
    564  f039							; ==============================================================================
    565  f039							; Frame loop
    566  f039							; ==============================================================================
    567  f039				   StartFrame
    568  f039
    569  f039							; ------------------------------------------------------------------------------
    570  f039							; VSYNC (3 scanlines)
    571  f039							; ------------------------------------------------------------------------------
    572  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    573  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    574  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    575  f039							; does not advance the wall clock to the next scanline boundary (it is already
    576  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    577  f039							; fraction depends on where the previous frame's overscan happened to end) —
    578  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    579  f039							;
    580  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    581  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    582  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    583  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    584  f039							; the sim wall-model target is updated to match.
    585  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    586  f03b		       a9 02		      lda	#2
    587  f03d		       85 00		      sta	VSYNC
    588  f03f		       85 02		      sta	WSYNC
    589  f041		       85 02		      sta	WSYNC
    590  f043		       85 02		      sta	WSYNC
    591  f045		       a9 00		      lda	#0
    592  f047		       85 00		      sta	VSYNC
    593  f049
    594  f049							; ------------------------------------------------------------------------------
    595  f049							; VBLANK (37 scanlines)
    596  f049							; ------------------------------------------------------------------------------
    597  f049		       a9 02		      lda	#2
    598  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    599  f04d
    600  f04d							; --- Set TIM64T for VBLANK ---
    601  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    602  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    603  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    604  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    605  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    606  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    607  f04d							; Worst 1059c of the 1472c window = 413c margin.
    608  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    609  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    610  f04d							; 2026-10-25: #23 -> #31 (flicker hunt, bugs.md #16). With #23 a room whose
    611  f04d							; GRP1 objects alternate (FlickerFrame) ran the heavy VBL path ~35c PAST
    612  f04d							; the timer on every other frame: the SOXP WSYNC straddled a line edge, the
    613  f04d							; poll exited at once, the entry anchor took the NEXT line -> 270/271 line
    614  f04d							; frames alternating = visible flicker. #24 (+64c) fixed that room, but the
    615  f04d							; two-object phase rooms (level 6 room 4) still overran ~40c on a 16-frame
    616  f04d							; cycle (the object X moves the div15 count) and flipped 271<->272 in
    617  f04d							; blocks. Then the whole-stage sweep (211 rooms) showed ~60 rooms with
    618  f04d							; two enemies + M1/ball patches overrunning by up to 5 lines (4 positioning
    619  f04d							; WSYNCs + the slot-1 staging ~ 1830c effective). The overscan real work is
    620  f04d							; only ~1520c of its 3200c, so the split moved: V #25->#31, O #50->#44 (the
    621  f04d							; V+O sum stays 75 = 272 lines). Result: every shipped room is a constant
    622  f04d							; 272 lines (level 20: constant 273), worst VBL poll slack ~107c.
    623  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    624  f04d		       a9 1f		      lda	#31
    625  f04f		       8d 96 02 	      sta	TIM64T
    626  f052
    627  f052							; --- Position player sprite horizontally ---
    628  f052		       a5 80		      lda	RoomX
    629  f054		       38		      sec
    630  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    631  f057		       a2 00		      ldx	#0	; X=0 = player0
    632  f059		       20 0f ff 	      jsr	SetObjectXPos
    633  f05c
    634  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    635  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    636  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    637  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    638  f05c
    639  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    640  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    641  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    642  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    643  f05c
    644  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
