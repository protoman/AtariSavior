   1861  f5cb							; ==============================================================================
   1862  f5cb							; Miner pickup — check if player overlaps miner, advance to next level
   1863  f5cb							; ==============================================================================
   1864  f5cb				   CheckMinerPickup
   1865  f5cb		       a5 a4		      lda	LevelMinerRoom
   1866  f5cd		       29 7f		      and	#$7f
   1867  f5cf		       c5 98		      cmp	RoomNo
   1868  f5d1		       d0 1b		      bne	.CMPDone	; not in miner's room
   1869  f5d3							; X overlap: player [RoomX, +6] vs 4px miner.
   1870  f5d3							; Accept iff RoomX - MinerX in [-6, +3].
   1871  f5d3		       a5 80		      lda	RoomX
   1872  f5d5		       38		      sec
   1873  f5d6		       e5 a5		      sbc	MinerX
   1874  f5d8		       18		      clc
   1875  f5d9		       69 06		      adc	#PLAYER_WIDTH - 1
   1876  f5db		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1877  f5dd		       b0 0f		      bcs	.CMPDone	; no X overlap
   1878  f5df							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1879  f5df							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1880  f5df		       a5 81		      lda	RoomY
   1881  f5e1		       38		      sec
   1882  f5e2		       e5 a6		      sbc	MinerY
   1883  f5e4		       18		      clc
   1884  f5e5		       69 0b		      adc	#PLAYER_SPRITE_H - 1
   1885  f5e7		       c9 13		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1886  f5e9		       b0 03		      bcs	.CMPDone	; no Y overlap
   1887  f5eb							; Pickup! Arm the level-bonus tally (frozen count-up, then advance).
   1888  f5eb							; TallyArm (bank2, via TallyTramp) snapshots time/bombs/lives into
   1889  f5eb							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
   1890  f5eb							; TallyWork, whose done path does the old tail (level++/LoadLevel/bar).
   1891  f5eb		       20 e6 ff 	      jsr	TallyTramp
