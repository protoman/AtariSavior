   1037  f1a6							; --- Bomb: edge-detect Down (D1, 0=pressed) ---
   1038  f1a6		       a5 88		      lda	Temp
   1039  f1a8		       29 02		      and	#%00000010
   1040  f1aa		       f0 09		      beq	.BombHeld
