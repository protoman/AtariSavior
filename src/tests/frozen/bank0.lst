   2083  f5c6		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2084  f5c9				   .BTNoKill
   2085  f5c9		       20 d0 f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2086  f5cc		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2087  f5cf				   .BTDone
   2088  f5cf		       60		      rts
