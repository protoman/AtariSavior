   4251  ff7e		       4c 9a ff 	      jmp	.LaserInit
   4252  ff81				   .LAdvCapL
   4253  ff81		       a5 80		      lda	RoomX
   4254  ff83		       38		      sec
   4255  ff84		       e9 14		      sbc	#20
   4256  ff86		       b0 02		      bcs	.LAdvCapLs
   4257  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4258  ff8a				   .LAdvCapLs
