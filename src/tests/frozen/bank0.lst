    386 U00bc							; Jetpack physics constants (HERO-style)
    387 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    388 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    389 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    390 U00bc							; capped by the -$0100 rise clamp. From rest the
    391 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    392 U00bc							; take-off still eases in (~0.15 s); from a
    393 U00bc							; terminal 1.5 px/frame fall a held jet applies
    394 U00bc							; JET_MAX immediately and stops it in ~10 frames
    395 U00bc							; (HERO feel, user report 2026-10-22 — the old
    396 U00bc							; ÷4 gate needed ~80 frames to beat gravity).
    397 U00bc		       01 80	   MAX_FALL   =	$0180	; max fall speed (positive = down). Was $0200
    398 U00bc							; (2.0 px/frame) — the terminal fall felt too
    399 U00bc							; fast (user report 2026-10-21): 1.5 px/frame.
    400 U00bc
    401 U00bc		       00 0f	   JET_AUD_BASE =	$0F	; engine AUDF base: freq = base - JetPower/8 - sputter
    402 U00bc		       00 08	   JET_AUD_VOL =	$08	; engine volume while Up is held
    403 U00bc		       00 02	   LASER_AUD_C =	2	; laser ch0 control: div-15 tone = low pitch
    404 U00bc		       00 09	   LASER_AUD_V =	9	; laser ch0 volume while fire held
