   3703  fd78							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3704  fd78							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3705  fd78							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3706  fd78							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3707  fd78							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3708  fd78							; DeriveEnemyY — no persistent movement state exists in RAM.
   3709  fd78							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3710  fd78							; block after the pads; pre-pad headroom is 1B).
   3711  fd78							; ------------------------------------------------------------------------------
   3712  fd78				   RefreshEnemyY
   3713  fd78
   3714  fd78		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3715  fd7a							; TickCounter is the 60-frame GAME timer
   3716  fd7a							; (decrements 60->1, reloads) — gates derived
   3717  fd7a							; from it wrapped every second (spider
   3718  fd7a							; "teleported": (TC>>3)&63 only ever saw
   3719  fd7a							; 0..7 and counted DOWN 0->7 = jump).
   3720  fd7a		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3721  fd7c		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3722  fd7e				   .REYLoop		; every reader runs after refresh completes)
   3723  fd7e		       ca		      dex
   3724  fd7f		       20 89 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3725  fd82		       95 e2		      sta	EnemyRamY,X
   3726  fd84		       8a		      txa		; N/Z must come from X: flags after jsr are
   3727  fd85		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3728  fd87				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3729  fd87							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3730  fd87							; black rooms, broken PF, invisible sprites)
   3731  fd87							; --- SELECT or RESET held → back to the old title / level-select screen
   3732  fd87							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3733  fd87							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3734  fd87							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3735  fd87							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3736  fd87							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3737  fd87							;     RESET held past LANDING still re-fires — press must be released
   3738  fd87							;     before the drop-in finishes. ---
   3739  fd87		       a5 8a		      lda	DropTarget
   3740  fd89		       d0 17		      bne	.REYRts	; not idle: not ours
   3741  fd8b		       ad 82 02 	      lda	SWCHB
   3742  fd8e		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3743  fd90		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3744  fd92		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3745  fd94		       f0 0c		      beq	.REYRts	; neither pressed
   3746  fd96		       a9 ff		      lda	#$FF
   3747  fd98		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3748  fd9a		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3749  fd9d		       68		      pla		; drop OUR return address (LoadLevel already
   3750  fd9e		       68		      pla		;   popped its own) — tail into TitleWork
   3751  fd9f		       4c 32 fd 	      jmp	TitleWork
