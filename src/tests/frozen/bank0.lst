   1516  f3d9		       4c 34 f4 	      jmp	UE_Exit
   1517  f3dc				   UE_Alive
   1518  f3dc		       a5 ba		      lda	EnemyDeadMask
   1519  f3de		       3d c2 f3 	      and	EnemyBitTable,X
   1520  f3e1		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1521  f3e3		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1522  f3e6		       20 f6 fe 	      jsr	FoldIndirect	; type|dir (UEDispatch masks b7)
   1523  f3e9		       4c 05 f6 	      jmp	UEDispatch	; UEDispatch replaces the old
   1524  f3ec							; 18 B per-type compare chain with one 3 B jmp:
   1525  f3ec							; frees 15 B of pre-pad headroom and gives the
   1526  f3ec							; type tables room for the raft byte.
