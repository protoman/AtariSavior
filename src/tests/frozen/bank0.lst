   2973  f969		       c5 8f		      cmp	CollisionEndY	; row == bottom?
   2974  f96b		       f0 07		      beq	.CWNoHit
   2975  f96d		       e6 92		      inc	RectCount
   2976  f96f		       d0 d8		      bne	.CWRow	; always (row never wraps to 0)
   2977  f971				   .CWHit
