   2756  f947		       85 92		      sta	RectCount
   2757  f949				   .CWRow
   2758  f949		       a5 8e		      lda	CollisionEndX
   2759  f94b		       85 8b		      sta	CollisionX
   2760  f94d		       aa		      tax		; X = col, seeded ONCE per row (bugs.md #31:
   2761  f94e							;   was re-loaded every cell — −8c/cell walk
   2762  f94e							;   trim for the falling+probe heavy frame)
   2763  f94e				   .CWCol
   2764  f94e		       a4 92		      ldy	RectCount
   2765  f950		       98		      tya
   2766  f951		       18		      clc
   2767  f952		       7d a9 fd 	      adc	ColOff,X	; PF0/PF1/PF2 group offset (0/3/6)
   2768  f955		       a8		      tay
   2769  f956		       b9 c3 00 	      lda	PF0Buf,Y	; $C3+row+off — the byte the kernel renders
   2770  f959		       3d bd fd 	      and	ColMask,X	; bit for this source col
   2771  f95c		       d0 13		      bne	.CWHit	; solid (Z=0)
   2772  f95e		       e4 8c		      cpx	CollisionCellX	; col == max? (X == CollisionX, stx below keeps
   2773  f960		       f0 05		      beq	.CWRowDone	;   the memory walk-temp fresh for HotOverlapFlag)
   2774  f962		       e8		      inx
