   2320  f72e							; Position GRP1 from ActiveObjectX — ONE shared call for every object
   2321  f72e							; path (bomb/miner/enemy). ac4c3ee moved the bomb's SOXP to the drop and
   2322  f72e							; the bomb path skipped it, so the bomb rendered at the last enemy/miner
   2323  f72e							; X (looked pinned near the room's other object).
   2324  f72e							; Phase 6 (2026-10-22): ONE `cmp #$FF` decides BOTH "position P1" and
   2325  f72e							; "stage or park ObjTop". The old `bmi` sentinel test died with the 16-row
   2326  f72e							; stride: OBJ_BOMB = 128 = $80 sets bit 7, so the bomb's P1 was never
   2327  f72e							; positioned and its ObjTop was parked (tools/test_bomb_render_x.py).
   2328  f72e							; It is ONE comparison because the VBL window pays for 2 c but not the
   2329  f72e							; 6 c that three `cmp/beq` sites cost (test_phase3_ball: 268-line frames).
   2330  f72e							; RULE: never test ObjBase/ObjBase1 with `bmi` — $FF is the ONLY
   2331  f72e							; "no object" (slot 1 only ever holds enemies/miner, all < $80, but slot 0
   2332  f72e							; reaches $80 with the bomb).
   2333  f72e		       a5 b6		      lda	ObjBase
   2334  f730		       c9 ff		      cmp	#$FF
   2335  f732		       f0 18		      beq	.SOBlank
   2336  f734		       a5 b7		      lda	ActiveObjectX
   2337  f736		       a2 01		      ldx	#1
   2338  f738		       20 0f ff 	      jsr	SetObjectXPos
   2339  f73b		       20 20 ff 	      jsr	SetObjReflection
   2340  f73e							; Set ObjTop for kernel GRP1 visibility check.
   2341  f73e							; S2.2: ObjTop stored RoomY-relative (ObjTopRel = ActiveObjectY-RoomY+1) so
   2342  f73e							; the kernel compares against running-Y (`tya`) instead of `lda Scanline`
   2343  f73e							; — frees 9c/line (lda Scanline + inc Scanline) for the laser beam write.
   2344  f73e							; Kernel .Grp1 does: tya / sec / sbc ObjTop / cmp #OBJ_WINDOW / bcs.
   2345  f73e							; ObjBot (write-only, no readers): stores removed S1.5, decl removed
   2346  f73e							; S3.0b (was last sequential decl — no address shift).
   2347  f73e		       a5 b8		      lda	ActiveObjectY
   2348  f740		       38		      sec
   2349  f741		       e5 81		      sbc	RoomY
   2350  f743		       18		      clc
   2351  f744		       69 01		      adc	#1	; A = ActiveObjectY - RoomY + 1 (mod 256)
   2352  f746		       85 bb		      sta	ObjTop
   2353  f748		       20 e5 fb 	      jsr	StageSlot1	; Phase 5: pair a second object in a higher band
   2354  f74b		       60		      rts
   2355  f74c				   .SOBlank
   2356  f74c		       20 20 ff 	      jsr	SetObjReflection	; REFP1/NUSIZ1 are reset EVERY frame (the bank1
   2357  f74f							;   HUD leaves both set for the score)
   2358  f74f		       a9 90		      lda	#144	; Park the GRP1 window off-cave for EVERY
   2359  f751		       38		      sec		; RoomY. The kernel draws when running-Y
   2360  f752		       e5 81		      sbc	RoomY	; (Scanline-RoomY) - ObjTopRel < OBJ_WINDOW =
   2361  f754		       85 bb		      sta	ObjTop	; Scanline-(RoomY+ObjTopRel); parking ObjTopRel
   2362  f756		       4c e5 fb 	      jmp	StageSlot1	; = 144-RoomY → Scanline-144 ∈ [112,255] →
   2363  f759							; never in window. Tail-jmp (not jsr/rts): the
   2364  f759							; ORIGINAL caller frame, 9 c cheaper, and it
   2365  f759							; still clears slot 1 (no slot 0 to pair).
   2366  f759							; A CONSTANT 144 wrapped for RoomY ≥ 112
   2367  f759							; (Scanline-(144+RY) mod 256 ∈ [0,7]) and drew
   2368  f759							; ObjSprites[row+ObjBase]; with the key art at
   2369  f759							; slot 0 (ObjBase=$FF → row 1..11 = KEY rows)
   2370  f759							; that leaked the key onto the player's rows
   2371  f759							; (user 2026-10-17).
