   3948  ff0f							; ==============================================================================
   3949  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3950  ff0f							; ==============================================================================
   3951  ff0f							; Andrew Davie session-24 routine:
   3952  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3953  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3954  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3955  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3956  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3957  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3958  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3959  ff0f							;
   3960  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3961  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3962  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3963  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3964  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3965  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3966  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3967  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3968  ff0f				   SetObjectXPos subroutine
   3969  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   3970  ff11		       38		      sec		; ensure carry flag
   3971  ff12				   .Div15Loop
   3972  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   3973  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   3974  ff16		       a8		      tay		; Y = remainder in -15..-1
   3975  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   3976  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   3977  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   3978  ff1e		       60		      rts
   3979  ff1f
   3980  ff20					      org	$FF20
   3981  ff20
   3982  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   3983  ff20				   SetObjReflection
   3984  ff20		       a9 00		      lda	#0
   3985  ff22		       85 0c		      sta	REFP1
   3986  ff24		       a5 b6		      lda	ObjBase
   3987  ff26		       c9 54		      cmp	#OBJ_MINER
   3988  ff28		       d0 08		      bne	.SORdone
   3989  ff2a		       a5 a4		      lda	LevelMinerRoom
   3990  ff2c		       10 04		      bpl	.SORdone
   3991  ff2e		       a9 08		      lda	#$08
   3992  ff30		       85 0c		      sta	REFP1
   3993  ff32				   .SORdone
   3994  ff32		       60		      rts
