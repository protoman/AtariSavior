   3906  fe90							; end is kept so FoldIndirect stays at $FE90.
   3907  fe90							; BOTH same-page 4c fetches (verify guards);
   3908  fe90							; end $FE8F -> HOF tramp $FE90 (shifted +$10,
   3909  fe90							; mirrors+HOF_ENTRY/LHT_ENTRY synced)
