   4187  ff20							; ------------------------------------------------------------------------------
   4188  ff20							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4189  ff20							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4190  ff20							; the facing until contact, then resets to the eye (single missile, KISS —
   4191  ff20							; user spec: no piercing, no HERO comparison needed).
   4192  ff20							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4193  ff20							;						  left	RoomX-4)
   4194  ff20							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4195  ff20							;     wrap) -> reset to eye (unsigned check catches both)
   4196  ff20							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4197  ff20							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4198  ff20							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4199  ff20							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4200  ff20							;     priority over M0 anyway).
   4201  ff20							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4202  ff20							;     press edge re-anchors).
   4203  ff20							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4204  ff20							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4205  ff20							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4206  ff20							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4207  ff20							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4208  ff20							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4209  ff20							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4210  ff20							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4211  ff20							; ------------------------------------------------------------------------------
   4212  ff20				   LaserInput
   4213  ff20		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4214  ff22		       8a		      txa
   4215  ff23		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4216  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4217  ff27		       8a		      txa
   4218  ff28		       29 80		      and	#LASER_HELD
   4219  ff2a		       4a		      lsr		; old held (b7) -> new prev (b6)
   4220  ff2b		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4221  ff2d		       85 c0		      sta	LaserState
   4222  ff2f		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4223  ff31		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4224  ff33							; below — moved here so the cap code could
   4225  ff33							; not push .LaserReleased past bmi's ±127)
   4226  ff33				   .LaserReleased
   4227  ff33		       a9 00		      lda	#0
   4228  ff35		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4229  ff37							; otherwise -> bars slid across screen
   4230  ff37		       60		      rts		; LaserX kept; next press edge re-anchors
   4231  ff38				   .LaserFire
   4232  ff38		       a5 c0		      lda	LaserState
   4233  ff3a		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4234  ff3c		       85 c0		      sta	LaserState
   4235  ff3e		       8a		      txa
   4236  ff3f		       29 80		      and	#LASER_HELD
   4237  ff41		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4238  ff43							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4239  ff43							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4240  ff43							; step would jump out of the 8px wall with no candidate ever inside it
   4241  ff43							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4242  ff43							; here (b7 held from the ora above). Open-hold cadence alternates
   4243  ff43							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4244  ff43		       a5 c0		      lda	LaserState
   4245  ff45		       29 01		      and	#LASER_REARM
   4246  ff47		       f0 04		      beq	.LAdvStep
   4247  ff49		       c6 c0		      dec	LaserState
   4248  ff4b		       d0 3a		      bne	.LaserInit
   4249  ff4d							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4250  ff4d							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4251  ff4d							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4252  ff4d							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4253  ff4d							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4254  ff4d				   .LAdvStep
   4255  ff4d		       a4 82		      ldy	PlayerDir
   4256  ff4f		       a5 83		      lda	LaserX
   4257  ff51		       18		      clc
