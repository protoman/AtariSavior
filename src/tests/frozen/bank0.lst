   1581  f472							; ------------------------------------------------------------------------------
   1582  f472							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1583  f472							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1584  f472							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1585  f472							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1586  f472							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1587  f472							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1588  f472							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1589  f472							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1590  f472							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1591  f472							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1592  f472							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1593  f472							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1594  f472							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1595  f472							; ------------------------------------------------------------------------------
   1596  f472				   UE_Tentacle
   1597  f472		       a5 ad		      lda	TickCounter
   1598  f474		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1599  f476							; = half the player's 1 px/frame (user
   1600  f476							; 2026-10-10: &3 read as chunky/slow)
   1601  f476		       d0 4b		      bne	.TentOut
   1602  f478		       b5 bd		      lda	EnemyRamX,X
   1603  f47a		       c5 80		      cmp	RoomX
   1604  f47c		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1605  f47e		       90 06		      bcc	.TentRight
   1606  f480		       38		      sec
   1607  f481		       e9 01		      sbc	#1	; step left
   1608  f483		       4c 89 f4 	      jmp	.TentProbe
   1609  f486				   .TentRight
   1610  f486		       18		      clc
   1611  f487		       69 01		      adc	#1	; step right
   1612  f489				   .TentProbe
   1613  f489		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1614  f48b		       b0 36		      bcs	.TentOut
   1615  f48d		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1616  f48f							; Same-column cull: committed X is always probe-clear, so a candidate in
   1617  f48f							; the same 4px column covers the same collision cells → result is known
   1618  f48f							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1619  f48f		       a5 88		      lda	Temp
   1620  f491		       55 bd		      eor	EnemyRamX,X
   1621  f493		       29 fc		      and	#$FC
   1622  f495		       f0 28		      beq	.TentCommit
   1623  f497		       a5 80		      lda	RoomX
   1624  f499		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1625  f49b		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1626  f49d		       85 b8		      sta	ActiveObjectY
   1627  f49f		       a5 88		      lda	Temp
   1628  f4a1		       c9 05		      cmp	#5
   1629  f4a3		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1630  f4a5							; PHM's negative visible-left wraps to 255
   1631  f4a5							; (col garbage / ColOff OOB walk). cand<=4
   1632  f4a5							; ink pokes off-screen anyway; RoomX=cand
   1633  f4a5							; already covers cell0.
   1634  f4a5		       38		      sec
   1635  f4a6		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1636  f4a8							; sits 5/7 px left of A (moth .Mvl convention,
   1637  f4a8							; bank2), but PHM's PLAYER prologue derives
   1638  f4a8							; lit-left = arg-4/arg-7 with the bin on
