   3488  ff00					      org	$FF00
   3489  ff00				   fineAdjustBegin
   3490  ff00		       70		      .byte.b	%01110000	; left 7
   3491  ff01		       60		      .byte.b	%01100000	; left 6
   3492  ff02		       50		      .byte.b	%01010000	; left 5
   3493  ff03		       40		      .byte.b	%01000000	; left 4
   3494  ff04		       30		      .byte.b	%00110000	; left 3
   3495  ff05		       20		      .byte.b	%00100000	; left 2
   3496  ff06		       10		      .byte.b	%00010000	; left 1
   3497  ff07		       00		      .byte.b	%00000000	; no movement
   3498  ff08		       f0		      .byte.b	%11110000	; right 1
   3499  ff09		       e0		      .byte.b	%11100000	; right 2
   3500  ff0a		       d0		      .byte.b	%11010000	; right 3
   3501  ff0b		       c0		      .byte.b	%11000000	; right 4
   3502  ff0c		       b0		      .byte.b	%10110000	; right 5
   3503  ff0d		       a0		      .byte.b	%10100000	; right 6
   3504  ff0e		       90		      .byte.b	%10010000	; right 7
   3505  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
