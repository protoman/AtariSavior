   4327  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   4328  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   4329  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   4330  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   4331  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   4332  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   4333  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   4334  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   4335  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   4336  fe9c							; ------------------------------------------------------------------------------
   4337  fe9c				   TallyWork
   4338  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   4339  fe9f		       a8		      tay
   4340  fea0		       29 01		      and	#1
   4341  fea2		       f0 05		      beq	.TNoScore
   4342  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4343  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4344  fea9				   .TNoScore
   4345  fea9		       98		      tya
   4346  feaa		       29 04		      and	#4
   4347  feac		       f0 1e		      beq	.TLive
   4348  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4349  feb0		       a5 a3		      lda	Level
   4350  feb2		       c9 04		      cmp	#LEVEL_COUNT
   4351  feb4		       d0 04		      bne	.TNotWrap
   4352  feb6		       a9 00		      lda	#0	; wrap past last level
   4353  feb8		       85 a3		      sta	Level
   4354  feba				   .TNotWrap
   4355  feba		       a9 00		      lda	#0
   4356  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4357  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4358  febe							;   pose ($FE must take the real-fall path)
   4359  febe		       20 20 fc 	      jsr	LoadLevel
   4360  fec1		       a9 78		      lda	#120	; reset timer for new level
   4361  fec3		       85 ae		      sta	BarLevel
   4362  fec5		       a9 3c		      lda	#60
   4363  fec7		       85 ad		      sta	TickCounter
   4364  fec9		       4c 35 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4365  fecc				   .TLive
