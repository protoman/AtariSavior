   2191  f60c							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2192  f60c							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2193  f60c							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2194  f60c							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2195  f60c							; ------------------------------------------------------------------------------
   2196  f60c				   UEDispatch
   2197  f60c		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2198  f60e							;   the single type-compare entry. 2026-10-22:
   2199  f60e							;   a raft authored dir=right read $87, missed
   2200  f60e							;   `cmp #ENEMY_RAFT` and its body never ran
   2201  f60e							;   (no tide, no motion, no rider pin).
   2202  f60e		       c9 07		      cmp	#ENEMY_RAFT
   2203  f610		       d0 06		      bne	.UEDNotRaft
   2204  f612		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2205  f615		       4c 3b f4 	      jmp	UE_Next
   2206  f618				   .UEDNotRaft
   2207  f618		       c9 03		      cmp	#ENEMY_TENTACLE
   2208  f61a		       d0 03		      bne	.UEDNotTent
   2209  f61c		       4c 42 f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2210  f61f				   .UEDNotTent
   2211  f61f		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2212  f621		       d0 03		      bne	.UEDNotMoth
   2213  f623		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2214  f626				   .UEDNotMoth
   2215  f626		       c9 02		      cmp	#ENEMY_SNAKE
   2216  f628		       d0 03		      bne	.UEDNotSnake
   2217  f62a		       4c f7 f3 	      jmp	UE_SnakeBody
   2218  f62d				   .UEDNotSnake
   2219  f62d		       4c 3b f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2220  f630							; (absolute jmps: this block is far from the
   2221  f630							;  bodies — relative branches do not reach)
