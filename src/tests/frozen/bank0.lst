   1986  f521		       4c 8c f5 	      jmp	CEH_NoHit	; no enemies
   1987  f524				   CEH_HasEnemies
   1988  f524							; --- Fold batch (P3.1): enemy record staged once — the loop reads type
   1989  f524							; at CEH_HasMore and writes no FetchPtr. ---
   1990  f524		       a5 b1		      lda	EnemyDataLo
   1991  f526		       85 e5		      sta	FetchPtr
   1992  f528		       a5 b2		      lda	EnemyDataHi
   1993  f52a		       85 e6		      sta	FetchPtr+1
   1994  f52c		       a0 00		      ldy	#0
   1995  f52e				   CEH_Loop
   1996  f52e		       c4 b3		      cpy	EnemyCount
   1997  f530		       90 03		      bcc	CEH_HasMore
