   4042  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4043  ff4f		       85 c0		      sta	LaserState
   4044  ff51		       8a		      txa
   4045  ff52		       29 80		      and	#LASER_HELD
   4046  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4047  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4048  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4049  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   4050  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4051  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   4052  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4053  ff56		       a5 c0		      lda	LaserState
   4054  ff58		       29 01		      and	#LASER_REARM
   4055  ff5a		       f0 04		      beq	.LAdvStep
