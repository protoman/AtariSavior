   1016  f18b
   1017  f18b							; --- Set TIM64T for overscan ---
   1018  f18b							; P3.4: overscan work worst 2104c (heavy, enemy room, rect cache in) →
   1019  f18b							; #50 = 3200c = 1096c headroom (was #35 = 2240c = 136c — positive but
   1020  f18b							; too tight for transition frames). V(#23)+O(#50) = 73 units = 262 lines.
   1021  f18b		       a9 32		      lda	#50
   1022  f18d		       8d 96 02 	      sta	TIM64T
