   3787  ff81				   .LAdvCapL
   3788  ff81		       a5 80		      lda	RoomX
   3789  ff83		       38		      sec
   3790  ff84		       e9 14		      sbc	#20
   3791  ff86		       b0 02		      bcs	.LAdvCapLs
   3792  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
