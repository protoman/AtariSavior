    383 U00bc							;   4: YToRowTable is indexed by line>>2, so a
    384 U00bc							;   band boundary off the 4-line grid would map
    385 U00bc							;   up to 3 lines to the wrong band.
    386 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    387 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE (unchanged from
    388 U00bc							;   the 3×48 era: the cave is the same height,
    389 U00bc							;   divided into one more band. PLAYER_MAX_Y,
    390 U00bc							;   the water surface and the raft tide all
    391 U00bc							;   keep their absolute line numbers.)
    392 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × 48)
    393 U00bc
    394 U00bc							; GRP1 sprite design offsets into ObjSprites (12 bytes each; 0 = blank/off)
    395 U00bc		       00 00	   OBJ_NONE   =	0
    396 U00bc		       00 00	   OBJ_KEY    =	0	; design offsets. A design owns its block, so each
    397 U00bc		       00 10	   OBJ_MOTH   =	16	; offset = the sum of the heights above it;
    398 U00bc		       00 1e	   OBJ_SPIDER =	30	; ObjHeightTab carries the matching row count.
    399 U00bc		       00 2d	   OBJ_LAMP   =	45	; Heights (user art 2026-10-22): MOTH 14,
    400 U00bc		       00 37	   OBJ_TENTACLE =	55	; SPIDER 15, LAMP 10, TENTACLE 14, BAT 10,
    401 U00bc		       00 45	   OBJ_BAT    =	69	; SNAKE 6, MINER 16, BOMB 8, RAFT 2, KEY 16.
    402 U00bc		       00 4f	   OBJ_SNAKE  =	79
    403 U00bc		       00 55	   OBJ_MINER  =	85
    404 U00bc		       00 65	   OBJ_BOMB   =	101
    405 U00bc		       00 6d	   OBJ_RAFT   =	109
    406 U00bc		       00 0c	   OBJ_CELL   =	12	; the power cell borrows the KEY block's free rows 12-15
    407 U00bc		       00 6f	   OBJ_LAMP_R =	111	; the wall-MIRRORED lamp: enemy TYPE 13
    408 U00bc							;   (b3-0 holds 8-15 unused). The converter
    409 U00bc							;   picks 5 or 13 from the wall the lamp
    410 U00bc							;   hangs on (user 2026-10-22).
    411 U00bc		       00 08	   OBJ_BOMB_H =	8	; the bomb owns no type slot: its draw window
    412 U00bc							;   is staged by hand in SelectActiveObject
    413 U00bc
    414 U00bc							; Player bounds (must stay inside cave walls)
    415 U00bc		       00 04	   PLAYER_MIN_X =	4	; sprite flush with left edge (HERO)
    416 U00bc		       00 9f	   PLAYER_MAX_X =	159	; horizontal logical-position clamp
    417 U00bc		       00 00	   PLAYER_MIN_Y =	0
    418 U00bc		       00 7a	   PLAYER_MAX_Y =	122	; CAVE_LINES - PLAYER_SPRITE_H (feet at 143)
    419 U00bc
    420 U00bc							; Jetpack physics constants (HERO-style)
    421 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    422 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    423 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    424 U00bc							; capped by the -$0100 rise clamp. From rest the
    425 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    426 U00bc							; take-off still eases in (~0.15 s); from a
    427 U00bc							; terminal 1.5 px/frame fall a held jet applies
    428 U00bc							; JET_MAX immediately and stops it in ~10 frames
    429 U00bc							; (HERO feel, user report 2026-10-22 — the old
    430 U00bc							; ÷4 gate needed ~80 frames to beat gravity).
    431 U00bc		       01 80	   MAX_FALL   =	$0180	; max fall speed (positive = down). Was $0200
    432 U00bc							; (2.0 px/frame) — the terminal fall felt too
    433 U00bc							; fast (user report 2026-10-21): 1.5 px/frame.
    434 U00bc
    435 U00bc		       00 0f	   JET_AUD_BASE =	$0F	; engine AUDF base: freq = base - JetPower/8 - sputter
    436 U00bc		       00 08	   JET_AUD_VOL =	$08	; engine volume while Up is held
    437 U00bc		       00 02	   LASER_AUD_C =	2	; laser ch0 control: div-15 tone = low pitch
    438 U00bc		       00 09	   LASER_AUD_V =	9	; laser ch0 volume while fire held
    439 U00bc
    440 U00bc
    441 U00bc
    442 U00bc							; Facing direction of the player sprite's eye
    443 U00bc		       00 00	   FACING_RIGHT =	0
    444 U00bc		       00 01	   FACING_LEFT =	1
