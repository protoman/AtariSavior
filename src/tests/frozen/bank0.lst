    393 U00bc							; Jetpack physics constants (HERO-style)
    394 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    395 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    396 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    397 U00bc							; capped by the -$0100 rise clamp. From rest the
    398 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    399 U00bc							; take-off still eases in (~0.15 s); from a
    400 U00bc							; terminal 1.5 px/frame fall a held jet applies
    401 U00bc							; JET_MAX immediately and stops it in ~10 frames
    402 U00bc							; (HERO feel, user report 2026-10-22 — the old
    403 U00bc							; ÷4 gate needed ~80 frames to beat gravity).
    404 U00bc		       01 80	   MAX_FALL   =	$0180	; max fall speed (positive = down). Was $0200
    405 U00bc							; (2.0 px/frame) — the terminal fall felt too
    406 U00bc							; fast (user report 2026-10-21): 1.5 px/frame.
    407 U00bc
