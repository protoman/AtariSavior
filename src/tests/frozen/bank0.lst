    614  f086
    615  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    616  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    617  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    618  f086							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    619  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    620  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    621  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    622  f086		       20 c1 f9 	      jsr	PositionBallM1
    623  f089
    624  f089							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    625  f089							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    626  f089							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    627  f089							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    628  f089							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    629  f089							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    630  f089							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    631  f089							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    632  f089		       a5 c2		      lda	EnemyRamP
    633  f08b		       29 f0		      and	#$F0
    634  f08d		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    635  f08f		       4a		      lsr
    636  f090		       4a		      lsr
    637  f091		       4a		      lsr
    638  f092		       4a		      lsr		; A = p (1..15)
    639  f093		       c9 08		      cmp	#8
    640  f095		       90 04		      bcc	.TideTri
    641  f097		       a9 00		      lda	#0	; rest phase p8-15
    642  f099		       f0 09		      beq	.TideBase	; always
    643  f09b				   .TideTri
    644  f09b		       c9 04		      cmp	#4
    645  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    646  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    647  f0a1		       38		      sec
    648  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
    649  f0a4				   .TideBase
    650  f0a4		       18		      clc
    651  f0a5		       69 24		      adc	#36
