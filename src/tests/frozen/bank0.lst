   3546  fd78							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3547  fd78							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3548  fd78							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3549  fd78							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3550  fd78							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3551  fd78							; DeriveEnemyY — no persistent movement state exists in RAM.
   3552  fd78							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3553  fd78							; block after the pads; pre-pad headroom is 1B).
   3554  fd78							; ------------------------------------------------------------------------------
   3555  fd78				   RefreshEnemyY
   3556  fd78
   3557  fd78		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3558  fd7a							; TickCounter is the 60-frame GAME timer
   3559  fd7a							; (decrements 60->1, reloads) — gates derived
   3560  fd7a							; from it wrapped every second (spider
   3561  fd7a							; "teleported": (TC>>3)&63 only ever saw
   3562  fd7a							; 0..7 and counted DOWN 0->7 = jump).
   3563  fd7a		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3564  fd7c		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3565  fd7e				   .REYLoop		; every reader runs after refresh completes)
   3566  fd7e		       ca		      dex
   3567  fd7f		       20 89 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3568  fd82		       95 e2		      sta	EnemyRamY,X
   3569  fd84		       8a		      txa		; N/Z must come from X: flags after jsr are
   3570  fd85		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3571  fd87				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3572  fd87							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3573  fd87							; black rooms, broken PF, invisible sprites)
   3574  fd87							; --- SELECT or RESET held → back to the old title / level-select screen
   3575  fd87							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3576  fd87							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3577  fd87							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3578  fd87							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3579  fd87							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3580  fd87							;     RESET held past LANDING still re-fires — press must be released
   3581  fd87							;     before the drop-in finishes. ---
   3582  fd87		       a5 8a		      lda	DropTarget
   3583  fd89		       d0 17		      bne	.REYRts	; not idle: not ours
   3584  fd8b		       ad 82 02 	      lda	SWCHB
   3585  fd8e		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3586  fd90		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3587  fd92		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3588  fd94		       f0 0c		      beq	.REYRts	; neither pressed
   3589  fd96		       a9 ff		      lda	#$FF
   3590  fd98		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3591  fd9a		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3592  fd9d		       68		      pla		; drop OUR return address (LoadLevel already
   3593  fd9e		       68		      pla		;   popped its own) — tail into TitleWork
   3594  fd9f		       4c 32 fd 	      jmp	TitleWork
