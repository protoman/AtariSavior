   1277  f208							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1278  f208							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1279  f208							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1280  f208							;	   catches the fall in ~10 frames from terminal $0180.
   1281  f208							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1282  f208							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1283  f208							;	   gone: it kept thrust below gravity for ~32 frames.
   1284  f208							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1285  f208							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1286  f208							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1287  f208							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1288  f208							;	   1.0s hover was too long — halved); then the flag clears and
   1289  f208							;	   normal gravity resumes (fall ~0.85s after release). State
   1290  f208							;	   lives in JetPower, NOT
   1291  f208							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1292  f208							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1293  f208							;	   rising frame — both clobbered a StepsLeft-based float.
   1294  f208							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1295  f208							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1296  f208							;	   (headroom stays $FC67).
   1297  f208							; ------------------------------------------------------------------------------
   1298  f208		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1299  f20a		       24 88		      bit	Temp
   1300  f20c		       d0 25		      bne	.JetDecay
   1301  f20e		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1302  f210		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1303  f212		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1304  f214		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1305  f216				   .JetRamp
   1306  f216							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1307  f216							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1308  f216							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1309  f216							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1310  f216							; ~80 frames = more than a room height of extra falling). The ramp only
   1311  f216							; applies from rest / while already rising, so take-off still eases in.
   1312  f216		       a5 94		      lda	vyHi
   1313  f218		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1314  f21a		       05 93		      ora	vyLo
   1315  f21c		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1316  f21e		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1317  f220		       85 96		      sta	JetPower
   1318  f222		       4c 5f f2 	      jmp	.Gravity
   1319  f225				   .JetClimb
   1320  f225		       a5 96		      lda	JetPower
   1321  f227		       c9 30		      cmp	#JET_MAX
   1322  f229		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1323  f22b		       18		      clc
   1324  f22c		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1325  f22e		       85 96		      sta	JetPower
   1326  f230		       4c 5f f2 	      jmp	.Gravity
   1327  f233				   .JetDecay		; Up NOT held this frame
   1328  f233		       a5 96		      lda	JetPower
   1329  f235		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1330  f237		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1331  f239		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1332  f23b		       05 93		      ora	vyLo
   1333  f23d		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1334  f23f							;   climb to stop, do NOT float
   1335  f23f		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1336  f241		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1337  f243		       4c 5f f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1338  f246				   .FloatRun
   1339  f246		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1340  f248		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1341  f24a		       29 7f		      and	#$7F
   1342  f24c		       d0 04		      bne	.FRActive
   1343  f24e		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1344  f250		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1345  f252				   .FRActive
   1346  f252		       a5 94		      lda	vyHi
   1347  f254		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1348  f256		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1349  f258		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1350  f25a		       85 94		      sta	vyHi
   1351  f25c		       4c a4 f2 	      jmp	.Integrate
