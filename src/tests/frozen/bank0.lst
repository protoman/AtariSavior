   1960  f519							; TallyTicks and sets DropTarget=$FE; each frame's dispatch then runs
   1961  f519							; TallyWork, whose done path does the old tail (level++/LoadLevel/bar).
   1962  f519		       20 98 f9 	      jsr	RescuePrimary	; clears the primary's bit; the tally runs only when
   1963  f51c							;   it was the last miner (RescuePrimary/MinerRescued)
   1964  f51c				   .CMPDone
   1965  f51c		       60		      rts
