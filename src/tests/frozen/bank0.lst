   1466  f3ba							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1467  f3ba							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1468  f3ba							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1469  f3ba							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1470  f3ba							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1471  f3ba							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1472  f3ba							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1473  f3ba							; so the first move is the retreat into its wall. Ignores editor range_* per
   1474  f3ba							; user 2026-09-23. No wall collision.
   1475  f3ba							; ------------------------------------------------------------------------------
   1476  f3ba				   UpdateEnemies
   1477  f3ba		       a5 b3		      lda	EnemyCount
   1478  f3bc		       d0 01		      bne	UE_Start
   1479  f3be		       60		      rts
   1480  f3bf				   UE_Start
   1481  f3bf							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1482  f3bf							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1483  f3bf		       a5 b1		      lda	EnemyDataLo
   1484  f3c1		       85 e5		      sta	FetchPtr
   1485  f3c3		       a5 b2		      lda	EnemyDataHi
   1486  f3c5		       85 e6		      sta	FetchPtr+1
   1487  f3c7		       a2 00		      ldx	#0
   1488  f3c9				   UE_Loop
   1489  f3c9		       e4 b3		      cpx	EnemyCount
   1490  f3cb		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1491  f3cd		       4c 28 f4 	      jmp	UE_Exit
   1492  f3d0				   UE_Alive
   1493  f3d0		       a5 ba		      lda	EnemyDeadMask
   1494  f3d2		       3d b6 f3 	      and	EnemyBitTable,X
   1495  f3d5		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1496  f3d7		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*3 = type offset
   1497  f3da		       20 f6 fe 	      jsr	FoldIndirect	; type
   1498  f3dd		       4c f7 f5 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1499  f3e0							; 18 B per-type compare chain with one 3 B jmp:
   1500  f3e0							; frees 15 B of pre-pad headroom and gives the
   1501  f3e0							; type tables room for the raft byte.
   1502  f3e0				   UE_SnakeBody
   1503  f3e0		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1504  f3e2		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1505  f3e4		       d0 3e		      bne	UE_Next
   1506  f3e6							; live dir bit: 1 = right, 0 = left
   1507  f3e6		       bd b6 f3 	      lda	EnemyBitTable,X
   1508  f3e9		       25 c1		      and	EnemyRamD
   1509  f3eb		       d0 1d		      bne	UE_SnakeRight
   1510  f3ed				   UE_SnakeLeft
   1511  f3ed		       d6 bd		      dec	EnemyRamX,X
   1512  f3ef		       c8		      iny		; +1 = ROM spawn X
   1513  f3f0		       20 f6 fe 	      jsr	FoldIndirect
   1514  f3f3		       85 88		      sta	Temp
   1515  f3f5		       38		      sec
   1516  f3f6		       e9 04		      sbc	#SNAKE_PATROL	; rmin = spawn - SNAKE_PATROL: SYMMETRIC patrol
   1517  f3f8							; (user 2026-10-19) — no dir read needed, the
   1518  f3f8							; range is the placement ± one tile either way
   1519  f3f8		       85 88		      sta	Temp
   1520  f3fa		       b5 bd		      lda	EnemyRamX,X
   1521  f3fc		       c5 88		      cmp	Temp
   1522  f3fe		       b0 24		      bcs	UE_Next	; X >= rmin OK
   1523  f400		       a5 88		      lda	Temp
   1524  f402		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1525  f404		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1526  f407		       4c 24 f4 	      jmp	UE_Next
   1527  f40a				   UE_SnakeRight
   1528  f40a		       f6 bd		      inc	EnemyRamX,X
   1529  f40c		       c8		      iny		; +1 = ROM spawn X
   1530  f40d		       20 f6 fe 	      jsr	FoldIndirect
   1531  f410		       85 88		      sta	Temp
   1532  f412		       18		      clc
   1533  f413		       69 04		      adc	#SNAKE_PATROL	; rmax = spawn + SNAKE_PATROL (symmetric)
   1534  f415		       85 88		      sta	Temp
   1535  f417		       b5 bd		      lda	EnemyRamX,X
   1536  f419		       c5 88		      cmp	Temp
   1537  f41b		       90 07		      bcc	UE_Next	; X < rmax OK
   1538  f41d		       a5 88		      lda	Temp
   1539  f41f		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1540  f421		       20 78 fc 	      jsr	UE_FlipDir	; at or past max → turn left
   1541  f424				   UE_Next
