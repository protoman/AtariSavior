   2559  f942		       c9 0f		      cmp	#15
   2560  f944		       b0 06		      bcs	.off7
   2561  f946		       38		      sec
   2562  f947		       e9 04		      sbc	#4	; P0 target <15: visible left = X - 4
   2563  f949		       4c 4e f9 	      jmp	.gotVL
   2564  f94c				   .off7
   2565  f94c		       e9 07		      sbc	#7	; P0 target >=15: visible left = X - 7
   2566  f94e				   .gotVL
   2567  f94e		       18		      clc
   2568  f94f		       65 82		      adc	PlayerDir	; reflected sprite's first lit bit is column 1
