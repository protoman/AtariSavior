   1255  f2a2							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1256  f2a2							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1257  f2a2							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1258  f2a2							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1259  f2a2							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1260  f2a2							;     resumes (he lifts off). No Up -> hovers in place.
   1261  f2a2				   .Integrate
   1262  f2a2		       a5 9c		      lda	Hover
   1263  f2a4		       f0 13		      beq	.DoInt
   1264  f2a6		       a5 96		      lda	JetPower
   1265  f2a8		       c9 09		      cmp	#GRAVITY + 1
   1266  f2aa		       b0 09		      bcs	.HoverEnd
   1267  f2ac		       a9 00		      lda	#0
   1268  f2ae		       85 93		      sta	vyLo
   1269  f2b0		       85 94		      sta	vyHi
