   4020  ff0f							; ==============================================================================
   4021  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4022  ff0f							; ==============================================================================
   4023  ff0f							; Andrew Davie session-24 routine:
   4024  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4025  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4026  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4027  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4028  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4029  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4030  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4031  ff0f							;
   4032  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4033  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4034  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4035  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4036  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4037  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4038  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4039  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4040  ff0f				   SetObjectXPos subroutine
   4041  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4042  ff11		       38		      sec		; ensure carry flag
   4043  ff12				   .Div15Loop
   4044  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4045  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4046  ff16		       a8		      tay		; Y = remainder in -15..-1
   4047  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4048  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4049  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4050  ff1e		       60		      rts
   4051  ff1f
   4052  ff20					      org	$FF20
   4053  ff20
   4054  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   4055  ff20				   SetObjReflection
   4056  ff20		       a9 00		      lda	#0
   4057  ff22		       85 0c		      sta	REFP1
   4058  ff24		       a5 b6		      lda	ObjBase
   4059  ff26		       c9 7a		      cmp	#OBJ_MINER
   4060  ff28		       d0 08		      bne	.SORdone
   4061  ff2a		       a5 a4		      lda	LevelMinerRoom
   4062  ff2c		       10 04		      bpl	.SORdone
   4063  ff2e		       a9 08		      lda	#$08
   4064  ff30		       85 0c		      sta	REFP1
   4065  ff32				   .SORdone
   4066  ff32		       60		      rts
   4067  ff33
   4068  ff33							; ------------------------------------------------------------------------------
   4069  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4070  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4071  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   4072  ff33							; user spec: no piercing, no HERO comparison needed).
   4073  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4074  ff33							;						  left	RoomX-4)
   4075  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4076  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   4077  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4078  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4079  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4080  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4081  ff33							;     priority over M0 anyway).
   4082  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4083  ff33							;     press edge re-anchors).
   4084  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4085  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4086  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4087  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4088  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4089  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4090  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4091  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4092  ff33							; ------------------------------------------------------------------------------
   4093  ff33				   LaserInput
   4094  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4095  ff35		       8a		      txa
   4096  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4097  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4098  ff3a		       8a		      txa
   4099  ff3b		       29 80		      and	#LASER_HELD
   4100  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4101  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4102  ff40		       85 c0		      sta	LaserState
   4103  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4104  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4105  ff46							; below — moved here so the cap code could
   4106  ff46							; not push .LaserReleased past bmi's ±127)
   4107  ff46				   .LaserReleased
   4108  ff46		       a9 00		      lda	#0
   4109  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4110  ff4a							; otherwise -> bars slid across screen
   4111  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   4112  ff4b				   .LaserFire
   4113  ff4b		       a5 c0		      lda	LaserState
   4114  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4115  ff4f		       85 c0		      sta	LaserState
   4116  ff51		       8a		      txa
   4117  ff52		       29 80		      and	#LASER_HELD
   4118  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4119  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4120  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4121  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   4122  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4123  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   4124  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4125  ff56		       a5 c0		      lda	LaserState
   4126  ff58		       29 01		      and	#LASER_REARM
   4127  ff5a		       f0 04		      beq	.LAdvStep
   4128  ff5c		       c6 c0		      dec	LaserState
   4129  ff5e		       d0 3a		      bne	.LaserInit
   4130  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   4131  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   4132  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   4133  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   4134  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   4135  ff60				   .LAdvStep
   4136  ff60		       a4 82		      ldy	PlayerDir
