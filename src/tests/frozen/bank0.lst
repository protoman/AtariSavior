    371 U00bc		       00 1e	   OBJ_SPIDER =	30	; ObjHeightTab carries the matching row count.
    372 U00bc		       00 2d	   OBJ_LAMP   =	45	; Heights (user art 2026-10-22): MOTH 14,
    373 U00bc		       00 3d	   OBJ_TENTACLE =	61	; SPIDER 15, TENTACLE 14, BAT 10, SNAKE 6,
    374 U00bc		       00 4b	   OBJ_BAT    =	75	; RAFT 2, the rest 16.
    375 U00bc		       00 55	   OBJ_SNAKE  =	85
    376 U00bc		       00 5b	   OBJ_MINER  =	91
