    716  f099		       f0 09		      beq	.TideBase	; always
    717  f09b				   .TideTri
    718  f09b		       c9 04		      cmp	#4
    719  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    720  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    721  f0a1		       38		      sec
    722  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
