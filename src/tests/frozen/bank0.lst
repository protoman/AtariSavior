   2022  f5b3		       d0 2a		      bne	.BTDone
   2023  f5b5		       a5 b5		      lda	BombPacked	; 1 → 2
   2024  f5b7		       29 fc		      and	#%11111100
   2025  f5b9		       09 02		      ora	#%00000010
   2026  f5bb		       85 b5		      sta	BombPacked
   2027  f5bd		       a9 3c		      lda	#60
   2028  f5bf		       85 f7		      sta	BombTimer
   2029  f5c1		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2030  f5c4		       aa		      tax
   2031  f5c5		       f0 08		      beq	.BTNoScore
   2032  f5c7				   .BTScore
