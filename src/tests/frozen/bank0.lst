   1155  f230							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1156  f230							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1157  f230							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1158  f230							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1159  f230							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1160  f230							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1161  f230							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1162  f230							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1163  f230							;	   1.0s hover was too long — halved); then the flag clears and
   1164  f230							;	   normal gravity resumes (fall ~0.85s after release). State
   1165  f230							;	   lives in JetPower, NOT
   1166  f230							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1167  f230							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1168  f230							;	   rising frame — both clobbered a StepsLeft-based float.
   1169  f230							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1170  f230							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1171  f230							;	   (headroom stays $FC67).
   1172  f230							; ------------------------------------------------------------------------------
   1173  f230		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1174  f232		       24 88		      bit	Temp
   1175  f234		       d0 21		      bne	.JetDecay
   1176  f236		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1177  f238		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1178  f23a		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1179  f23c		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1180  f23e				   .RampStart
   1181  f23e		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1182  f240		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1183  f242		       d0 3f		      bne	.Gravity
   1184  f244		       a5 96		      lda	JetPower
   1185  f246		       c9 14		      cmp	#JET_MAX
   1186  f248		       b0 06		      bcs	.JetCapped
   1187  f24a		       18		      clc
   1188  f24b		       69 01		      adc	#1
   1189  f24d		       4c 52 f2 	      jmp	.JetSet
   1190  f250				   .JetCapped
   1191  f250		       a9 14		      lda	#JET_MAX
   1192  f252				   .JetSet
   1193  f252		       85 96		      sta	JetPower
   1194  f254		       4c 83 f2 	      jmp	.Gravity
   1195  f257				   .JetDecay		; Up NOT held this frame
   1196  f257		       a5 96		      lda	JetPower
   1197  f259		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1198  f25b		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1199  f25d		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1200  f25f		       05 93		      ora	vyLo
   1201  f261		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1202  f263							;   climb to stop, do NOT float
   1203  f263		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1204  f265		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1205  f267		       4c 83 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1206  f26a				   .FloatRun
   1207  f26a		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1208  f26c		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1209  f26e		       29 7f		      and	#$7F
   1210  f270		       d0 04		      bne	.FRActive
   1211  f272		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1212  f274		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1213  f276				   .FRActive
   1214  f276		       a5 94		      lda	vyHi
   1215  f278		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1216  f27a		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1217  f27c		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1218  f27e		       85 94		      sta	vyHi
   1219  f280		       4c c0 f2 	      jmp	.Integrate
