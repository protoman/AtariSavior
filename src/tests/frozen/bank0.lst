   1172  f236		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1173  f238		       4c 54 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1174  f23b				   .FloatRun
   1175  f23b		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1176  f23d		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1177  f23f		       29 7f		      and	#$7F
