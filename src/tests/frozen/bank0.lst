   3513  fcc1							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3514  fcc1							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3515  fcc1							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3516  fcc1							;
   3517  fcc1							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3518  fcc1							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3519  fcc1							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3520  fcc1							;
   3521  fcc1							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3522  fcc1							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3523  fcc1							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3524  fcc1							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3525  fcc1							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3526  fcc1							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3527  fcc1							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3528  fcc1							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3529  fcc1							; ------------------------------------------------------------------------------
   3530  fcc1				   DropArm
   3531  fcc1		       a5 8a		      lda	DropTarget
   3532  fcc3		       c9 fd		      cmp	#$FD
   3533  fcc5		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3534  fcc7							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3535  fcc7							;   tally cleared to 0 by TallyWork before its
   3536  fcc7							;   LoadLevel — same-size swap 2026-10-06)
   3537  fcc7		       a5 81		      lda	RoomY
   3538  fcc9		       85 8a		      sta	DropTarget
   3539  fccb		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3540  fccd		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3541  fccf		       a9 00		      lda	#0
   3542  fcd1		       85 81		      sta	RoomY
   3543  fcd3		       85 95		      sta	PlayerYSub
   3544  fcd5		       85 93		      sta	vyLo
   3545  fcd7		       85 94		      sta	vyHi
   3546  fcd9		       a5 c0		      lda	LaserState
   3547  fcdb		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3548  fcdd		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3549  fcdf		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3550  fce1		       85 83		      sta	LaserX
   3551  fce3		       18		      clc
   3552  fce4		       60		      rts
   3553  fce5				   .DATitle
   3554  fce5							; Title: player already placed at level start by LoadLevel. Hide all
   3555  fce5							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3556  fce5							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3557  fce5							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3558  fce5		       a9 00		      lda	#0
   3559  fce7		       85 b3		      sta	EnemyCount
   3560  fce9		       a9 ff		      lda	#$FF
   3561  fceb		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3562  fced							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3563  fced							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3564  fced							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3565  fced							; preview still renders dark.
   3566  fced		       a5 c0		      lda	LaserState
   3567  fcef		       29 3d		      and	#LASER_KEEP
   3568  fcf1		       85 c0		      sta	LaserState
   3569  fcf3		       a5 a3		      lda	Level
   3570  fcf5		       18		      clc
   3571  fcf6		       69 01		      adc	#1	; 1-based level number (the title SELECT)
   3572  fcf8		       20 08 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3573  fcfb		       a9 00		      lda	#0
   3574  fcfd		       85 f3		      sta	ScoreTh
   3575  fcff		       85 f4		      sta	ScoreHu
   3576  fd01		       18		      clc
   3577  fd02		       60		      rts
   3578  fd03
   3579  fd03				   DropStep
   3580  fd03		       a5 8a		      lda	DropTarget
   3581  fd05		       f0 28		      beq	.DSdone	; idle (target 0 = nothing to fall)
   3582  fd07		       c9 ff		      cmp	#$FF
   3583  fd09		       f0 27		      beq	TitleWork	; merged title = stage preview + level select
   3584  fd0b		       c9 fe		      cmp	#$FE
   3585  fd0d		       d0 03		      bne	.DSfall
   3586  fd0f		       4c 9c fe 	      jmp	TallyWork	; level-bonus tally sentinel (bank2 step)
   3587  fd12				   .DSfall
   3588  fd12		       4a		      lsr
   3589  fd13		       4a		      lsr
   3590  fd14		       4a		      lsr
   3591  fd15		       4a		      lsr
   3592  fd16		       a8		      tay
   3593  fd17		       b9 e9 f9 	      lda	DropSpeedTable,y
   3594  fd1a		       18		      clc
   3595  fd1b		       65 95		      adc	PlayerYSub
   3596  fd1d		       85 95		      sta	PlayerYSub
   3597  fd1f		       90 0e		      bcc	.DSdone	; subpixel: no whole pixel yet this frame
   3598  fd21		       e6 81		      inc	RoomY
   3599  fd23		       a5 81		      lda	RoomY
   3600  fd25		       c5 8a		      cmp	DropTarget
   3601  fd27		       90 06		      bcc	.DSdone
   3602  fd29		       a9 00		      lda	#0
   3603  fd2b		       85 8a		      sta	DropTarget	; arrived — input/physics resume next frame
   3604  fd2d		       85 96		      sta	JetPower	; clean resume (no phantom thrust hop)
   3605  fd2f				   .DSdone
   3606  fd2f		       4c 37 f3 	      jmp	OverscanAudio	; rejoin past physics/collision (no rts)
   3607  fd32
   3608  fd32							; DropSpeedTable moved to the pre-pad free region ($F9FB) — post-pad before
   3609  fd32							; the $FDE1 pin was full (bugs.md #1 Hover needs the room). Read is abs,Y, so
   3610  fd32							; its address is irrelevant to DropStep.
