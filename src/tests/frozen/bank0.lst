   1827  f586		       85 f7		      sta	BombTimer
   1828  f588		       85 c1		      sta	EnemyRamD	; clear dir + RoomDarkMask (bits 4-7) — level reset
   1829  f58a		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1830  f58c							;  game-over restart = LoseLife->ReloadLevel->
   1831  f58c							;  here; same-stage respawn keeps facing)
   1832  f58c		       85 9c		      sta	Hover	; bugs.md #1: stage entry lands normally; the
   1833  f58e							;   respawn hover is armed only by LoseLife
   1834  f58e		       a5 c0		      lda	LaserState
   1835  f590		       29 c7		      and	#%11000111	; clear RoomDarkMask rooms 4-7 (LaserState b5-2)
   1836  f592		       85 c0		      sta	LaserState
   1837  f594		       a9 05		      lda	#BOMBS_MAX
   1838  f596		       85 f0		      sta	PlayerBombs
   1839  f598		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the boot
   1840  f59a		       c9 fd		      cmp	#$FD	; intro call ($FD = attract pending — TallyTicks
   1841  f59c		       f0 04		      beq	.NoBanner	; alias must stay 0 for the intro phase machine)
   1842  f59e		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1843  f5a0		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
   1844  f5a2				   .NoBanner
