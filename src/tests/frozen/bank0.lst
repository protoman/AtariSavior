   1988  f5f3							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   1989  f5f3							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   1990  f5f3							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   1991  f5f3							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   1992  f5f3							; ------------------------------------------------------------------------------
   1993  f5f3				   UEDispatch
   1994  f5f3		       c9 07		      cmp	#ENEMY_RAFT
   1995  f5f5		       d0 06		      bne	.UEDNotRaft
   1996  f5f7		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   1997  f5fa		       4c 20 f4 	      jmp	UE_Next
   1998  f5fd				   .UEDNotRaft
   1999  f5fd		       c9 03		      cmp	#ENEMY_TENTACLE
   2000  f5ff		       d0 03		      bne	.UEDNotTent
   2001  f601		       4c 25 f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2002  f604				   .UEDNotTent
   2003  f604		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2004  f606		       d0 03		      bne	.UEDNotMoth
   2005  f608		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2006  f60b				   .UEDNotMoth
   2007  f60b		       c9 02		      cmp	#ENEMY_SNAKE
   2008  f60d		       d0 03		      bne	.UEDNotSnake
   2009  f60f		       4c dc f3 	      jmp	UE_SnakeBody
   2010  f612				   .UEDNotSnake
   2011  f612		       4c 20 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
