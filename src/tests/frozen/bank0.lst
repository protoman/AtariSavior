   2209  f632							; ==============================================================================
   2210  f632							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2211  f632							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2212  f632							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2213  f632							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2214  f632							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2215  f632							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2216  f632							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2217  f632							; ==============================================================================
   2218  f632				   SelectActiveObject
   2219  f632							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2220  f632							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2221  f632							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2222  f632							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2223  f632							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2224  f632							; middle of the screen" the moment the points counting started).
   2225  f632		       a5 8a		      lda	DropTarget
   2226  f634		       c9 fe		      cmp	#$FE
   2227  f636		       d0 2d		      bne	.SOFull
   2228  f638		       a9 00		      lda	#0
   2229  f63a		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2230  f63c		       a9 ff		      lda	#$FF
   2231  f63e		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2232  f640							;   `0 = no object` comment was wrong and the
   2233  f640							;   tally-without-miner frame staged ObjTop from
   2234  f640							;   a stale Y, i.e. a stray key sprite)
   2235  f640		       a5 a4		      lda	LevelMinerRoom
   2236  f642		       29 7f		      and	#$7f
   2237  f644		       c5 98		      cmp	RoomNo
   2238  f646		       f0 03		      beq	.SOTallyMiner
   2239  f648		       4c 44 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2240  f64b				   .SOTallyMiner
   2241  f64b		       a9 55		      lda	#OBJ_MINER
   2242  f64d		       85 b6		      sta	ObjBase
   2243  f64f		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2244  f651		       85 9d		      sta	ObjHeight
   2245  f653		       a5 a5		      lda	MinerX
   2246  f655		       85 b7		      sta	ActiveObjectX
   2247  f657		       a5 a6		      lda	MinerY
   2248  f659		       18		      clc
