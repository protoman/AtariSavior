   1530  f3f3		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1531  f3f5		       d0 3e		      bne	UE_Next
   1532  f3f7							; live dir bit: 1 = right, 0 = left
   1533  f3f7		       bd c7 f3 	      lda	EnemyBitTable,X
   1534  f3fa		       25 c1		      and	EnemyRamD
   1535  f3fc		       d0 1d		      bne	UE_SnakeRight
   1536  f3fe				   UE_SnakeLeft
   1537  f3fe		       d6 bd		      dec	EnemyRamX,X
