   1671  f450		       b0 36		      bcs	.TentOut
   1672  f452		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1673  f454							; Same-column cull: committed X is always probe-clear, so a candidate in
   1674  f454							; the same 4px column covers the same collision cells → result is known
   1675  f454							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
