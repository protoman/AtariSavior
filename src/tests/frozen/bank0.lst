   1042  f126		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
   1043  f128		       c5 9d		      cmp	ObjHeight	; per-type window (all 16 today). COST: a ZP
   1044  f12a							;   compare is 3 c vs the immediate's 2 c, so
