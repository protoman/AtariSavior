    199 U00bc							; Score ZP variables (shared with bank1 HUD — addresses MUST match bank1)
    200 U00bc							; $F3-$F5 live score only — $F6 is BombX (bank1 ScoreOn is unused).
    201 U00bc		       00 f3	   ScoreTh    =	$F3	; score thousands digit (0-9)
