    400 U00bc		       00 08	   JET_AUD_VOL =	$08	; engine volume while Up is held
    401 U00bc		       00 02	   LASER_AUD_C =	2	; laser ch0 control: div-15 tone = low pitch
    402 U00bc		       00 09	   LASER_AUD_V =	9	; laser ch0 volume while fire held
