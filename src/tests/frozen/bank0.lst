    713  f095		       90 04		      bcc	.TideTri
    714  f097		       a9 00		      lda	#0	; rest phase p8-15
    715  f099		       f0 09		      beq	.TideBase	; always
    716  f09b				   .TideTri
    717  f09b		       c9 04		      cmp	#4
    718  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    719  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    720  f0a1		       38		      sec
    721  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
