   4664  ff57		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4665  ff59		       90 03		      bcc	.LAdvCap
   4666  ff5b		       4c 87 ff 	      jmp	.LaserInit
   4667  ff5e				   .LAdvCap
   4668  ff5e		       a5 82		      lda	PlayerDir
   4669  ff60		       d0 0c		      bne	.LAdvCapL
   4670  ff62		       a5 80		      lda	RoomX
   4671  ff64		       18		      clc
