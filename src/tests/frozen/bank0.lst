   2230  f62c							; ==============================================================================
   2231  f62c							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2232  f62c							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2233  f62c							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2234  f62c							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2235  f62c							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2236  f62c							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2237  f62c							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2238  f62c							; ==============================================================================
   2239  f62c				   SelectActiveObject
   2240  f62c							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2241  f62c							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2242  f62c							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2243  f62c							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2244  f62c							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2245  f62c							; middle of the screen" the moment the points counting started).
   2246  f62c		       a5 8a		      lda	DropTarget
   2247  f62e		       c9 fe		      cmp	#$FE
   2248  f630		       d0 2d		      bne	.SOFull
   2249  f632		       a9 00		      lda	#0
   2250  f634		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2251  f636		       a9 ff		      lda	#$FF
   2252  f638		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2253  f63a							;   `0 = no object` comment was wrong and the
   2254  f63a							;   tally-without-miner frame staged ObjTop from
   2255  f63a							;   a stale Y, i.e. a stray key sprite)
   2256  f63a		       a5 a4		      lda	LevelMinerRoom
   2257  f63c		       29 7f		      and	#$7f
   2258  f63e		       c5 98		      cmp	RoomNo
   2259  f640		       f0 03		      beq	.SOTallyMiner
   2260  f642		       4c 3b f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2261  f645				   .SOTallyMiner
   2262  f645		       a9 55		      lda	#OBJ_MINER
   2263  f647		       85 b6		      sta	ObjBase
   2264  f649		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2265  f64b		       85 9d		      sta	ObjHeight
   2266  f64d		       a5 a5		      lda	MinerX
   2267  f64f		       85 b7		      sta	ActiveObjectX
   2268  f651		       a5 a6		      lda	MinerY
   2269  f653		       18		      clc
   2270  f654		       69 03		      adc	#3	; same 3px offset as the normal miner path
   2271  f656		       85 b8		      sta	ActiveObjectY
   2272  f658		       a9 66		      lda	#NC_66	; purple (hue 6, luma 3)
   2273  f65a		       85 07		      sta	COLUP1
   2274  f65c		       4c 3b f7 	      jmp	.SODone
   2275  f65f				   .SOFull
   2276  f65f		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2277  f661							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2278  f661		       a5 b5		      lda	BombPacked
   2279  f663		       29 03		      and	#%00000011
   2280  f665		       c9 01		      cmp	#1
   2281  f667		       d0 1d		      bne	.SOCount
   2282  f669		       a5 f7		      lda	BombTimer
   2283  f66b		       29 03		      and	#3
