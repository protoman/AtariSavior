   3997  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3998  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3999  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   4000  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   4001  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   4002  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   4003  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   4004  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   4005  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   4006  fe9c							; ------------------------------------------------------------------------------
   4007  fe9c				   TallyWork
   4008  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   4009  fe9f		       a8		      tay
   4010  fea0		       29 01		      and	#1
   4011  fea2		       f0 05		      beq	.TNoScore
   4012  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   4013  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   4014  fea9				   .TNoScore
   4015  fea9		       98		      tya
   4016  feaa		       29 04		      and	#4
   4017  feac		       f0 1e		      beq	.TLive
   4018  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4019  feb0		       a5 a3		      lda	Level
   4020  feb2		       c9 04		      cmp	#LEVEL_COUNT
   4021  feb4		       d0 04		      bne	.TNotWrap
   4022  feb6		       a9 00		      lda	#0	; wrap past last level
   4023  feb8		       85 a3		      sta	Level
   4024  feba				   .TNotWrap
   4025  feba		       a9 00		      lda	#0
   4026  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4027  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4028  febe							;   pose ($FE must take the real-fall path)
   4029  febe		       20 20 fc 	      jsr	LoadLevel
   4030  fec1		       a9 78		      lda	#120	; reset timer for new level
   4031  fec3		       85 ae		      sta	BarLevel
   4032  fec5		       a9 3c		      lda	#60
   4033  fec7		       85 ad		      sta	TickCounter
   4034  fec9		       4c 30 f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   4035  fecc				   .TLive
   4036  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   4037  fecf		       a9 00		      lda	#0
   4038  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   4039  fed3				   .TWait
   4040  fed3		       ad 84 02 	      lda	INTIM
   4041  fed6		       d0 fb		      bne	.TWait
   4042  fed8		       4c 39 f0 	      jmp	StartFrame
