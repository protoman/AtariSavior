   3327  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3328  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3329  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3330  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3331  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3332  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3333  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3334  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3335  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3336  fe9c							; ------------------------------------------------------------------------------
   3337  fe9c				   TallyWork
   3338  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3339  fe9f		       a8		      tay
   3340  fea0		       29 01		      and	#1
   3341  fea2		       f0 05		      beq	.TNoScore
   3342  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3343  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3344  fea9				   .TNoScore
   3345  fea9		       98		      tya
   3346  feaa		       29 04		      and	#4
   3347  feac		       f0 1e		      beq	.TLive
   3348  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3349  feb0		       a5 a3		      lda	Level
   3350  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3351  feb4		       d0 04		      bne	.TNotWrap
   3352  feb6		       a9 00		      lda	#0	; wrap past last level
   3353  feb8		       85 a3		      sta	Level
   3354  feba				   .TNotWrap
   3355  feba		       a9 00		      lda	#0
   3356  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3357  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3358  febe							;   pose ($FE must take the real-fall path)
   3359  febe		       20 20 fc 	      jsr	LoadLevel
   3360  fec1		       a9 78		      lda	#120	; reset timer for new level
   3361  fec3		       85 ae		      sta	BarLevel
   3362  fec5		       a9 3c		      lda	#60
   3363  fec7		       85 ad		      sta	TickCounter
   3364  fec9		       4c 1e f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3365  fecc				   .TLive
   3366  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3367  fecf		       a9 00		      lda	#0
   3368  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3369  fed3				   .TWait
   3370  fed3		       ad 84 02 	      lda	INTIM
   3371  fed6		       d0 fb		      bne	.TWait
   3372  fed8		       4c 39 f0 	      jmp	StartFrame
