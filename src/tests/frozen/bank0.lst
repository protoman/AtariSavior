   1257  f202							; Vertical movement — HERO-style jetpack physics
   1258  f202							; ------------------------------------------------------------------------------
   1259  f202							; Gravity pulls down, holding Up fires jetpack (JetPower ramps with inertia).
   1260  f202							; Velocity is integrated through PlayerYSub and walked pixel-by-pixel via
   1261  f202							; StepDown/StepUp so collision stops flush at walls/doorways.
   1262  f202							; ------------------------------------------------------------------------------
   1263  f202				   UpdateP0Vertical
   1264  f202							; --- Clear HotBump (Temp b7) — set again only if this frame bumps hot rock ---
   1265  f202		       a5 88		      lda	Temp
   1266  f204		       29 7f		      and	#%01111111
   1267  f206		       85 88		      sta	Temp
   1268  f208
   1269  f208							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1270  f208							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1271  f208							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1272  f208							;	   catches the fall in ~10 frames from terminal $0180.
   1273  f208							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1274  f208							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1275  f208							;	   gone: it kept thrust below gravity for ~32 frames.
   1276  f208							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1277  f208							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1278  f208							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1279  f208							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1280  f208							;	   1.0s hover was too long — halved); then the flag clears and
   1281  f208							;	   normal gravity resumes (fall ~0.85s after release). State
   1282  f208							;	   lives in JetPower, NOT
   1283  f208							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1284  f208							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1285  f208							;	   rising frame — both clobbered a StepsLeft-based float.
   1286  f208							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1287  f208							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1288  f208							;	   (headroom stays $FC67).
   1289  f208							; ------------------------------------------------------------------------------
   1290  f208		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1291  f20a		       24 88		      bit	Temp
   1292  f20c		       d0 25		      bne	.JetDecay
   1293  f20e		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1294  f210		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1295  f212		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1296  f214		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1297  f216				   .JetRamp
   1298  f216							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1299  f216							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1300  f216							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1301  f216							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1302  f216							; ~80 frames = more than a room height of extra falling). The ramp only
   1303  f216							; applies from rest / while already rising, so take-off still eases in.
   1304  f216		       a5 94		      lda	vyHi
   1305  f218		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1306  f21a		       05 93		      ora	vyLo
   1307  f21c		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1308  f21e		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1309  f220		       85 96		      sta	JetPower
   1310  f222		       4c 5f f2 	      jmp	.Gravity
   1311  f225				   .JetClimb
   1312  f225		       a5 96		      lda	JetPower
   1313  f227		       c9 30		      cmp	#JET_MAX
   1314  f229		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1315  f22b		       18		      clc
   1316  f22c		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1317  f22e		       85 96		      sta	JetPower
   1318  f230		       4c 5f f2 	      jmp	.Gravity
   1319  f233				   .JetDecay		; Up NOT held this frame
   1320  f233		       a5 96		      lda	JetPower
   1321  f235		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1322  f237		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1323  f239		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1324  f23b		       05 93		      ora	vyLo
   1325  f23d		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1326  f23f							;   climb to stop, do NOT float
   1327  f23f		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1328  f241		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1329  f243		       4c 5f f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1330  f246				   .FloatRun
   1331  f246		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1332  f248		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1333  f24a		       29 7f		      and	#$7F
   1334  f24c		       d0 04		      bne	.FRActive
   1335  f24e		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1336  f250		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1337  f252				   .FRActive
   1338  f252		       a5 94		      lda	vyHi
   1339  f254		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1340  f256		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1341  f258		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1342  f25a		       85 94		      sta	vyHi
   1343  f25c		       4c a4 f2 	      jmp	.Integrate
   1344  f25f
   1345  f25f							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1346  f25f							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1347  f25f							;     only — subtracting $80+ would blast the player upward.
   1348  f25f				   .Gravity
   1349  f25f		       18		      clc
   1350  f260		       a5 93		      lda	vyLo
   1351  f262		       69 08		      adc	#<GRAVITY
   1352  f264		       85 93		      sta	vyLo
   1353  f266		       a5 94		      lda	vyHi
   1354  f268		       69 00		      adc	#>GRAVITY
   1355  f26a		       85 94		      sta	vyHi
   1356  f26c		       a5 96		      lda	JetPower
   1357  f26e		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1358  f270		       38		      sec
   1359  f271		       a5 93		      lda	vyLo
   1360  f273		       e5 96		      sbc	JetPower
   1361  f275		       85 93		      sta	vyLo
   1362  f277		       a5 94		      lda	vyHi
   1363  f279		       e9 00		      sbc	#0
   1364  f27b		       85 94		      sta	vyHi
   1365  f27d				   .ThrustSkip
