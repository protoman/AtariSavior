   3852  fd62		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3853  fd64							; TickCounter is the 60-frame GAME timer
   3854  fd64							; (decrements 60->1, reloads) — gates derived
   3855  fd64							; from it wrapped every second (spider
   3856  fd64							; "teleported": (TC>>3)&63 only ever saw
   3857  fd64							; 0..7 and counted DOWN 0->7 = jump).
   3858  fd64		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3859  fd66		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3860  fd68				   .REYLoop		; every reader runs after refresh completes)
   3861  fd68		       ca		      dex
   3862  fd69		       20 93 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3863  fd6c		       95 e2		      sta	EnemyRamY,X
   3864  fd6e		       8a		      txa		; N/Z must come from X: flags after jsr are
   3865  fd6f		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3866  fd71				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3867  fd71							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3868  fd71							; black rooms, broken PF, invisible sprites)
   3869  fd71							; --- SELECT or RESET held → back to the old title / level-select screen
   3870  fd71							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3871  fd71							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3872  fd71							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3873  fd71							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3874  fd71							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3875  fd71							;     RESET held past LANDING still re-fires — press must be released
   3876  fd71							;     before the drop-in finishes. ---
   3877  fd71		       a5 8a		      lda	DropTarget
   3878  fd73		       d0 27		      bne	.REYRts	; not idle: not ours
   3879  fd75		       ad 82 02 	      lda	SWCHB
   3880  fd78		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3881  fd7a		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3882  fd7c		       f0 1e		      beq	.REYRts	; neither pressed
   3883  fd7e		       a9 e8		      lda	#%11101000	; latch: SELECT/RESET/UP/DOWN/FIRE count as "held" (no
   3884  fd80		       85 97		      sta	StepsLeft	;   re-fire, no instant start if fire is down)
   3885  fd82		       a9 ff		      lda	#$FF
   3886  fd84		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3887  fd86		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   3888  fd88		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   3889  fd8a		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   3890  fd8c							;   game must clear them for a clean melody
   3891  fd8c		       a9 78		      lda	#120	; the power bar and its clock start over too
   3892  fd8e		       85 ae		      sta	BarLevel	;   (user 2026-11-11: SELECT during a game kept
   3893  fd90		       a9 3c		      lda	#TICKS_PER_SEC	;   the half-empty bar)
   3894  fd92		       85 ad		      sta	TickCounter
   3895  fd94		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3896  fd97		       68		      pla		; drop OUR return address (LoadLevel already
   3897  fd98		       68		      pla		;   popped its own) — tail into TitleWork
   3898  fd99		       4c 24 fd 	      jmp	TitleWork
