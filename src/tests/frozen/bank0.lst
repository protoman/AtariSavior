   2290  f68a				   .SOCount
   2291  f68a							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   2292  f68a		       a5 b3		      lda	EnemyCount
   2293  f68c		       85 88		      sta	Temp
