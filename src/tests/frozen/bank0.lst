   2285  f7e6		       d0 2a		      bne	.BTDone
   2286  f7e8		       a5 b5		      lda	BombPacked	; 1 → 2
   2287  f7ea		       29 fc		      and	#%11111100
   2288  f7ec		       09 02		      ora	#%00000010
   2289  f7ee		       85 b5		      sta	BombPacked
