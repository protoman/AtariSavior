   3879  fd0b		       c9 ff		      cmp	#$FF
   3880  fd0d		       f0 27		      beq	TitleWork	; merged title = stage preview + level select
   3881  fd0f		       c9 fe		      cmp	#$FE
   3882  fd11		       d0 03		      bne	.DSfall
   3883  fd13		       4c 9c fe 	      jmp	TallyWork	; level-bonus tally sentinel (bank2 step)
   3884  fd16				   .DSfall
