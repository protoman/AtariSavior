   2596  f951		       a8		      tay		; Y = visible_left
   2597  f952		       4a		      lsr
   2598  f953		       4a		      lsr
   2599  f954		       c9 14		      cmp	#TILE_COLUMNS
   2600  f956		       90 07		      bcc	.firstOk
   2601  f958		       85 8b		      sta	CollisionX
   2602  f95a		       a9 27		      lda	#39
   2603  f95c		       38		      sec
   2604  f95d		       e5 8b		      sbc	CollisionX
