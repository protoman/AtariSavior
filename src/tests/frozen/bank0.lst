   1031  f124							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
   1032  f124							; ObjTop..ObjTop+11 window → row byte from ObjSprites[ObjBase + offset].
   1033  f124							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
   1034  f124							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
   1035  f124							; (mod 256, exact). In-object iff result 0..OBJ_WINDOW-1 → `cmp/bcs`
   1036  f124							; (C=0 in range → adc adds exact ObjBase). Replaces
   1037  f124							; `lda Scanline/sec/sbc/bcc` (−6c in-range) and the `inc Scanline` (−5c)
   1038  f124							; — Scanline now unused. OBJ_WINDOW (16) is the DRAWING window; the hit
   1039  f124							; box stays PLAYER_HEIGHT (12) — see the constant block.
