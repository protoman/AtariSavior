   4023  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   4024  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   4025  fd3e				   .TWselDone
   4026  fd3e							; --- RESET edge ---
   4027  fd3e		       a5 97		      lda	StepsLeft
