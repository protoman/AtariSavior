    465 U00bc		       00 1e	   COLOR_P_YELLOW =	NC_1E	; hue 1 luma 7 = yellow face
    466 U00bc		       00 08	   COLOR_P_GRAY =	NC_08	; hue 0 luma 4 = grey pack + boots
    467 U00bc		       00 00	   COLOR_CAVE_BG =	NC_00	; black interior
    468 U00bc		       00 84	   COLOR_CAVE_WALL =	NC_84	; hue 8 luma 2 = dark grey-blue
    469 U00bc		       00 06	   COLOR_HUD_BG =	NC_06	; hue 0 luma 3 = grey
    470 U00bc		       00 1e	   COLOR_TIMER =	NC_1E	; hue 1 luma 7 = yellow
    471 U00bc		       00 c6	   COLOR_LIVES =	NC_C6	; hue 12 luma 3 = green
    472 U00bc		       00 46	   COLOR_BOMBS =	NC_46	; hue 4 luma 3 = red
    473 U00bc		       00 0e	   COLOR_SCORE =	NC_0E	; hue 0 luma 7 = white
    474 U00bc		       00 6a	   COLOR_TITLE =	NC_6A	; hue 6 luma 5 = purple (title text)
    475 U00bc
    476 U00bc							; Dark room (lamp crashed): medium grey objects, black PF; fuse PF dark grey
    477 U00bc		       00 0a	   COLOR_DARK_OBJ =	NC_0A	; hue 0 luma 5 = medium grey (lamp + enemies)
    478 U00bc		       00 04	   COLOR_DARK_PF =	NC_04	; hue 0 luma 2 = very dark grey (bomb fuse walls)
    479 U00bc
