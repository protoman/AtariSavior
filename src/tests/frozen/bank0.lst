    783  f0f9							; (2026-10-15) GRP0 blank REMOVED: +5c pushed the rows0/1 setup
    784  f0f9							; segment to 75c armed (>=74 = write lands next line = +1 stall line
    785  f0f9							; = whole-screen shift). The blank only traded a stale-byte duplicate
    786  f0f9							; for a blank line at band boundaries — shipped pre-99b8e86 without
    787  f0f9							; either; case15 filters zero writes so the Y-align guard is unaffected.
    788  f0f9							; --- Scanlines this pass: rows 0/1 = 48; row 2 = 36+off (tide, CollisionX).
    789  f0f9							; The bottom water strip (last 12-off lines, bottom_band_plan rule 2)
    790  f0f9							; renders in .WaterRow after this pass — its own setup line + (11-off)
    791  f0f9							; bodies keeps the row-2 total at 49 lines (setup+48) exactly.
    792  f0f9							; Split tail (2026-10-05, row1 setup gap 77->74): row1 gate used to pay
    793  f0f9							; `bne` 3c to skip the tide load AND share the WSYNC — gap was 77 (stall,
    794  f0f9							; +1 line/frame). Rows 0/1 now store+WSYNC before the tide block, then
    795  f0f9							; jmp over it (+3c charged to the FIRST body line = 66max+3jmp+3WSYNC
    796  f0f9							; = 72 <=76). Row2 path byte-identical in cost (cpx/beqT/lda/sta/WSYNC
    797  f0f9							; = 11+3 = 76, zero margin — the `beq` target is 9 bytes ahead, same
    798  f0f9							; page, T=3c; do not let this block grow toward a page edge).
    799  f0f9							; A1 gap fix (2026-10-05): `sta Temp` (+3c in .Row) pushed gaps to
    800  f0f9							; 77/79 = stall EVERY frame (265-line frames). `sta LineCount` moved
    801  f0f9							; AFTER `sta WSYNC` — same bytes, -3c from the gap window, +3c to the
    802  f0f9							; first body line (66max+3LC[+3jmp]+3WSYNC = 75 rows0/1, 72 row2).
    803  f0f9							; LineCount is not read until the line's `dec` tail — the early store
    804  f0f9							; was never required; keep the store strictly between WSYNC and .Line.
    805  f0f9		       e0 02		      cpx	#TILE_ROWS-1
    806  f0fb		       f0 09		      beq	.RowLinesTide	; row 2: tide count (36+off) from CollisionX
    807  f0fd							; rows 0/1: fixed 48 lines (the vcrunch shutter slice derive is gone).
    808  f0fd		       a9 30		      lda	#48
    809  f0ff							; --- Sync to next scanline (rows 0/1) ---
    810  f0ff		       85 02		      sta	WSYNC
    811  f101		       85 84		      sta	LineCount
    812  f103		       4c 0c f1 	      jmp	.Line
    813  f106				   .RowLinesTide
    814  f106		       a5 8b		      lda	CollisionX	; 36..39 — VBL tide calc (see VBL comment)
    815  f108							; --- Sync to next scanline (row 2; falls straight into .Line) ---
    816  f108		       85 02		      sta	WSYNC
    817  f10a		       85 84		      sta	LineCount
    818  f10c
    819  f10c				   .Line
    820  f10c							; --- Player sprite: color for THIS line, graphics byte for NEXT line ---
    821  f10c							; GRP0 written on line S displays on line S+1 (latched at the sprite's
    822  f10c							; window start after the write) — index graphics with A0+1 ($ff wraps
    823  f10c							; to 0 = row0 on the line before the sprite).
    824  f10c							; Running-Y: Y = A0 = Scanline - RoomY is computed ONCE at kernel entry
    825  f10c							; (sec/sbc RoomY/tay); .Line's iny advances it (Y = A0+1 after the
    826  f10c							; graphics write = A0 of the next line). Nothing between rows may touch
    827  f10c							; Y — the water-strip band-color read is an inlined `lda` (Y untouched).
    828  f10c							; Cycle budget — MEASURED (sim_frame_budget, bugs.md #29 Class A):
    829  f10c							; the old worst path (in-window color/beam/GRP0 + object in-range) was
    830  f10c							; 78c: WSYNC write landed 2c into the next line -> full-line stall ->
    831  f10c							; +1 scanline on every frame whose object window overlapped the A0=11
    832  f10c							; line (24 stalls in the SIM_LEVEL=2 window, always even frames —
    833  f10c							; SelectActiveObject parity rotation). Root fix: the color/beam gate
    834  f10c							; below stops at A0=10; row 11 inherits row 10's COLUP0/ENAM0 writes
    835  f10c							; (PlayerColTable [10]==[11], verify_build asserts) because
    836  f10c							; GRP0 row11 is fetched on line A0=10 already ("row11 shows via
    837  f10c							; line10"). Worst path measured 2026-10-15 (vcrunch jitter hunt):
    838  f10c							; in-window color/beam/GRP0 + object in-range = 69c between WSs,
    839  f10c							; start-to-start d=72 — was 73/76 (= stall zone 74-76, whole-screen
    840  f10c							; +1-line jitter) until the dead `cpy #12 / bcs .GrpZero` (4c, never
    841  f10c							; taken on the A0<=10 color path) moved to .GrpSkip. Budget: work
    842  f10c							; <= 70c / d <= 73 — a 74-76 segment stalls a full scanline.
    843  f10c							; ObjSprites+71 must stay in the $FExx page (else lda ObjSprites,X
    844  f10c							; page-crosses, +1c on the GRP1 fetch) — verify_build enforces this.
    845  f10c							; Branch targets all same-page (3c taken) and PlayerColTable in $F8xx
    846  f10c							; (verify_build guards the A0=10 page-cross budget).
    847  f10c							; GRP1 object section clobbers X (ObjSprites index) — row counter lives in
    848  f10c							; RowIdx and X is reloaded after bne. Row-advance +6c on the .Row setup
    849  f10c							; scanline (segment 63c -> 69c <= 76c): frame length unchanged.
    850  f10c							; The old Scanline/sec/sbc/tay prefix cost 10c more (body 66c -> WSYNC
    851  f10c							; write on cycle 76 = one cycle late): WSYNC stalled a full line per
    852  f10c							; overlapping scanline — stretched cave row, HUD pushed down, and with
    853  f10c							; GRP1 flicker rotation the frame length alternated (one-tile oscillation).
    854  f10c							; Keep the hot path at <= 70c work: an overrun duplicates the scanline.
    855  f10c		       c0 0b		      cpy	#PLAYER_SPRITE_H - 1
    856  f10e		       b0 3d		      bcs	.GrpSkip	; A0 >= 11 (incl $ff): no color/beam this line.
    857  f110							; A0=11 skips too (Class-A stall line): rows
    858  f110							; 10/11 share color+beam bytes, so row 10's
    859  f110							; writes are still in effect here.
    860  f110							; --- Laser S2.2: ENAM0 = PlayerColTable bit1 & LaserState.b1 ----------
    861  f110							; Phase 0 (2026-10-21): the retired BeamMask table duplicated bit 1 of
    862  f110							; PlayerColTable for a separate 4c fetch. One yellow strip on RoomY+2
    863  f110							; only (user directive 2026-10-08: the red row-3 strip is gone; the kill
    864  f110							; window in LaserHitTestBody keeps rows RoomY+2..3 = superset of the
    865  f110							; draw). In-window path only (Y<=11), so outside the window ENAM0 keeps
    866  f110							; its last write ($00 at A0=10) — no HUD artifact. verify_build asserts
    867  f110							; bit1 is set at index 2 and nowhere else, and that rows 10/11 stay equal
    868  f110							; (the A0=11 gate skip inherits row 10's writes).
    869  f110		       b9 f5 f8 	      lda	PlayerColTable,Y	; 4c — per-row color; bit 1 = ENAM0 enable
    870  f113		       85 06		      sta	COLUP0	; applies to this line (colour bit0 = don't-care)
    871  f115		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
    872  f117		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
    873  f119		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
    874  f11a							;   Color/beam gate entered only with A0<=10
    875  f11a							;   -> after iny Y<=11: always fetchable, so
    876  f11a							;   the old `cpy #PLAYER_SPRITE_H / bcs
    877  f11a							;   .GrpZero` here was DEAD 4c on the worst
    878  f11a							;   path (2+2, never taken — A0=11+ never
    879  f11a							;   reaches it, it goes to bcs .GrpSkip).
    880  f11a		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
    881  f11c		       85 1b		      sta	GRP0
    882  f11e				   .Grp1
    883  f11e
    884  f11e							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
    885  f11e							; ObjTop..ObjTop+7 window → row byte from ObjSprites[ObjBase + offset].
    886  f11e							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
    887  f11e							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
    888  f11e							; (mod 256, exact). In-object iff result 0..7 → `cmp #8/bcs` (C=0 in
    889  f11e							; range → adc adds exact ObjBase). Replaces `lda Scanline/sec/sbc/bcc`
    890  f11e							; (−6c in-range) and the `inc Scanline` (−5c) — Scanline now unused.
    891  f11e		       98		      tya
    892  f11f		       38		      sec
    893  f120		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
    894  f122		       c9 08		      cmp	#PLAYER_HEIGHT
    895  f124		       b0 4c		      bcs	.ObjZero	; above (negative mod ≥65) or at/below bottom
    896  f126		       65 b6		      adc	ObjBase
    897  f128		       aa		      tax
    898  f129		       bd 48 fe 	      lda	ObjSprites,X
    899  f12c		       85 1c		      sta	GRP1
    900  f12e		       bd 00 fe 	      lda	ObjColorTab,X	; per-row object color (+5c cross — the cycle sum
    901  f131							; equals the probe's proven pass: 5c beam + 4c
    902  f131							; color after phase 0's beam fold)
    903  f131		       85 07		      sta	COLUP1
    904  f133				   .AfterObj
    905  f133
