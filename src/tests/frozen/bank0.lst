   1021  f123							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
   1022  f123							; ObjTop..ObjTop+11 window → row byte from ObjSprites[ObjBase + offset].
   1023  f123							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
   1024  f123							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
   1025  f123							; (mod 256, exact). In-object iff result 0..OBJ_WINDOW-1 → `cmp/bcs`
   1026  f123							; (C=0 in range → adc adds exact ObjBase). Replaces
   1027  f123							; `lda Scanline/sec/sbc/bcc` (−6c in-range) and the `inc Scanline` (−5c)
