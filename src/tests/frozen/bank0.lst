   3884  fe90							; $F744 fill (Phase 6: tall art). The $FE8F
   3885  fe90							; end is kept so FoldIndirect stays at $FE90.
   3886  fe90							; BOTH same-page 4c fetches (verify guards);
   3887  fe90							; end $FE8F -> HOF tramp $FE90 (shifted +$10,
   3888  fe90							; mirrors+HOF_ENTRY/LHT_ENTRY synced)
   3889  fe90							; ------------------------------------------------------------------------------
   3890  fe90							; ObjColorTab — per-scanline GRP1 object colors, stride 8 = ObjSprites
   3891  fe90							; stride; indexed by the same X = ObjBase + r in .Grp1 at $FE00 (4c, same
   3892  fe90							; page for all 72 B — the passing +7 probe's exact cycle sum). Row colors
   3893  fe90							; per OBJ_* slot: type color x8 (matches EnemyColorTable /
   3894  fe90							; SelectActiveObject frame colors — no visual change for enemies/lamp/bomb);
   3895  fe90							; MINER slot = miner.png purple/pink/grey -> nearest NTSC $54/$4A/$08.
   3896  fe90							; NOTE: dark rooms no longer force grey objects — the frame-level $0A write
