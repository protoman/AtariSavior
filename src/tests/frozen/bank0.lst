   2148  f62d				   SelectActiveObject
   2149  f62d							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2150  f62d							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2151  f62d							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2152  f62d							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2153  f62d							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2154  f62d							; middle of the screen" the moment the points counting started).
   2155  f62d		       a5 8a		      lda	DropTarget
