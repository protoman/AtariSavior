   1775  f552		       4a		      lsr
   1776  f553		       4a		      lsr
   1777  f554		       4a		      lsr
   1778  f555		       29 0f		      and	#$0f
   1779  f557		       c9 0f		      cmp	#$0f
   1780  f559		       f0 07		      beq	.NoUp
   1781  f55b		       20 d0 fb 	      jsr	EnterRoom
