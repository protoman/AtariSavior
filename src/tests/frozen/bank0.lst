    810  f0d4							; Kernel: 192 visible scanlines
    811  f0d4							; ==============================================================================
    812  f0d4							; Structure:
    813  f0d4							;   .Row (×3): set PF registers once per color band, init scanline counter
    814  f0d4							;   .Line (×48): render one scanline — sprite check + loop control
    815  f0d4							;
    816  f0d4							; PF registers persist in TIA, so writing once per tile row is sufficient.
    817  f0d4							; The inner .Line loop has NO PF writes — only sprite rendering.
    818  f0d4							; ==============================================================================
