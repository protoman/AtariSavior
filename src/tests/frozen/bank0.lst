    510  f039							; ==============================================================================
    511  f039							; Frame loop
    512  f039							; ==============================================================================
    513  f039				   StartFrame
    514  f039
    515  f039							; ------------------------------------------------------------------------------
    516  f039							; VSYNC (3 scanlines)
    517  f039							; ------------------------------------------------------------------------------
    518  f039							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    519  f039							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    520  f039							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    521  f039							; does not advance the wall clock to the next scanline boundary (it is already
    522  f039							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    523  f039							; fraction depends on where the previous frame's overscan happened to end) —
    524  f039							; the whole screen shifted up 1 scanline on those frames = the jitter.
    525  f039							;
    526  f039							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    527  f039							; the next scanline boundary (even if we were already at it — the store is 3c
    528  f039							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    529  f039							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    530  f039							; the sim wall-model target is updated to match.
    531  f039		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    532  f03b		       a9 02		      lda	#2
    533  f03d		       85 00		      sta	VSYNC
    534  f03f		       85 02		      sta	WSYNC
    535  f041		       85 02		      sta	WSYNC
    536  f043		       85 02		      sta	WSYNC
    537  f045		       a9 00		      lda	#0
    538  f047		       85 00		      sta	VSYNC
    539  f049
    540  f049							; ------------------------------------------------------------------------------
    541  f049							; VBLANK (37 scanlines)
    542  f049							; ------------------------------------------------------------------------------
    543  f049		       a9 02		      lda	#2
    544  f04b		       85 01		      sta	VBLANK	; turn on VBLANK
    545  f04d
    546  f04d							; --- Set TIM64T for VBLANK ---
    547  f04d							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    548  f04d							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    549  f04d							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    550  f04d							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    551  f04d							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    552  f04d							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    553  f04d							; Worst 1059c of the 1472c window = 413c margin.
    554  f04d							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    555  f04d							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    556  f04d				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    557  f04d		       a9 17		      lda	#23
    558  f04f		       8d 96 02 	      sta	TIM64T
    559  f052
    560  f052							; --- Position player sprite horizontally ---
    561  f052		       a5 80		      lda	RoomX
    562  f054		       38		      sec
    563  f055		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    564  f057		       a2 00		      ldx	#0	; X=0 = player0
    565  f059		       20 0f ff 	      jsr	SetObjectXPos
    566  f05c
    567  f05c							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    568  f05c							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    569  f05c							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
    570  f05c							; now stages BallX into Temp; this block reads the staged copy. ---
    571  f05c
    572  f05c							; --- No sprite copy needed — kernel reads directly from ROM ---
    573  f05c							; Do NOT HMOVE here: wait until P1 is positioned too. An early HMOVE
    574  f05c							; applied stale bank1 HMP1 (score), and a second HMOVE after SelectActiveObject
    575  f05c							; applied HMP0 twice → player fine-adjust doubled (visual teleport/jitter).
    576  f05c
    577  f05c							; --- Select which object GRP1 draws this frame (miner or enemy) ---
    578  f05c							; Reads EnemyRamY ($E2) — no VBL writer of $E2 exists (Y writers are
    579  f05c							; overscan-only, score ptrs are HUD-only), so no ordering constraint.
    580  f05c							; A1 2026-10-20: body back in bank0 (was C1's bank2 copy) — the enemy
    581  f05c							; records are level data in bank2/bank3, so the type byte is fetched
    582  f05c							; through FoldIndirect again (~46c/frame more than the bank2 copy).
    583  f05c		       20 29 f6 	      jsr	SelectActiveObject
    584  f05f
    585  f05f							; --- PF0: NO per-frame refresh since S3.4 — EnemyRamY moved to $E2-$E4,
    586  f05f							; so $C3-$C5 keep the EnterRoom pattern forever (the old LoadPF0Only
    587  f05f							; repair = 3 folds ≈ 130c/frame is deleted). PF1/PF2 rows 0-2 likewise
    588  f05f							; have no per-frame writer; full 9-fold rebuild only on EnterRoom.
    589  f05f							; Plan 5.1: the S6.1 every-frame ApplyBombWalls re-apply is GONE —
    590  f05f							; BombMarkWalls punches holes once at the fuse 1->2 edge.
    591  f05f		       20 17 fc 	      jsr	CallPad_BuildColupF	; stripe+hot COLUPF bytes into ColupfBuf ($E7-$F2)
    592  f062
    593  f062							; --- Band color: RoomBandColor ($BC) is staged ONCE per room by
    594  f062							; EnterRoomB2 (C2 2026-10-20: b6 of the room's RoomShapes byte; the
    595  f062							; 2026-10-04 up-exit fix). The
    596  f062							; old per-frame VBL fold that re-read the same ROM byte is
    597  f062							; REDUNDANT since then and is deleted (2026-10-19): it saved nothing the
    598  f062							; kernel needs, cost ~30c of VBL time, and it was a level-data read in
    599  f062							; the VBL path (the read that made a bank3 data move need another
    600  f062							; reader). test_band_restage covers the contract.
    601  f062
    602  f062							; --- Cave COLUBK for this frame → written DIRECTLY (Phase 3) ---
    603  f062							; state=2: blink (60-BombTimer)&3 → black/yellow/red/yellow; else COLOR_CAVE_BG
    604  f062							; Dark room: black except the existing explosion blink (state=2).
    605  f062							; Phase 3: .Row no longer re-stores Temp→COLUBK per band (the slot now
    606  f062							; holds the BandTab ENABL gate), so this store IS the cave's COLUBK.
    607  f062							; Temp is free here onward for the staged BallX (bank2 StageBandTab) —
    608  f062							; no reader between this point and overscan's own `sta Temp` (joystick).
    609  f062		       a5 b5		      lda	BombPacked
    610  f064		       29 03		      and	#%00000011
    611  f066		       c9 02		      cmp	#2
    612  f068		       f0 0a		      beq	.BgBlink
    613  f06a		       20 0e fc 	      jsr	CallPad_IsRoomDark
    614  f06d		       f0 13		      beq	.BgIdle	; lit room → COLOR_CAVE_BG
    615  f06f		       a9 00		      lda	#COLOR_CAVE_BG	; dark → black
    616  f071		       4c 84 f0 	      jmp	.BgStore
    617  f074				   .BgBlink
    618  f074							; Constant-time phase: the old %3 subtract loop ran (elapsed)/3 iterations
    619  f074							; (up to 19 × 9c ≈ 171c) and GREW every frame for 60 frames — with a thin
    620  f074							; wall punched (ApplyBombWalls +224c) it blew the #23 VBL window late in
    621  f074							; state2 → 263-line frames → explosion flicker (2026-09-29). &3 = 4-phase,
    622  f074							; 60 frames = exact 15 cycles, starts black at explosion.
    623  f074		       a9 3c		      lda	#60
    624  f076		       38		      sec
    625  f077		       e5 f7		      sbc	BombTimer
    626  f079		       29 03		      and	#3
    627  f07b		       a8		      tay
    628  f07c		       b9 f3 f5 	      lda	BombBlinkColors,Y
    629  f07f		       4c 84 f0 	      jmp	.BgStore
    630  f082				   .BgIdle
    631  f082		       a9 00		      lda	#COLOR_CAVE_BG
    632  f084				   .BgStore
    633  f084		       85 09		      sta	COLUBK
    634  f086
    635  f086							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    636  f086							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    637  f086							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    638  f086							; M1X (LevelEnemySpare2; 0 → no M1) — ball selector 4, M1 selector 3,
    639  f086							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    640  f086							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    641  f086							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    642  f086		       20 c1 f9 	      jsr	PositionBallM1
    643  f089
    644  f089							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    645  f089							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    646  f089							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    647  f089							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    648  f089							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    649  f089							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    650  f089							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
