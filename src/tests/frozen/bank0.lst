   1191  f203							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1192  f203							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1193  f203							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1194  f203							;	   catches the fall in ~10 frames from terminal $0180.
   1195  f203							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1196  f203							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1197  f203							;	   gone: it kept thrust below gravity for ~32 frames.
   1198  f203							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1199  f203							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1200  f203							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1201  f203							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1202  f203							;	   1.0s hover was too long — halved); then the flag clears and
   1203  f203							;	   normal gravity resumes (fall ~0.85s after release). State
   1204  f203							;	   lives in JetPower, NOT
   1205  f203							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1206  f203							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1207  f203							;	   rising frame — both clobbered a StepsLeft-based float.
   1208  f203							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1209  f203							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1210  f203							;	   (headroom stays $FC67).
   1211  f203							; ------------------------------------------------------------------------------
   1212  f203		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1213  f205		       24 88		      bit	Temp
   1214  f207		       d0 25		      bne	.JetDecay
   1215  f209		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1216  f20b		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1217  f20d		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1218  f20f		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1219  f211				   .JetRamp
   1220  f211							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1221  f211							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1222  f211							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1223  f211							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1224  f211							; ~80 frames = more than a room height of extra falling). The ramp only
   1225  f211							; applies from rest / while already rising, so take-off still eases in.
   1226  f211		       a5 94		      lda	vyHi
   1227  f213		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1228  f215		       05 93		      ora	vyLo
   1229  f217		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1230  f219		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1231  f21b		       85 96		      sta	JetPower
   1232  f21d		       4c 5a f2 	      jmp	.Gravity
   1233  f220				   .JetClimb
   1234  f220		       a5 96		      lda	JetPower
   1235  f222		       c9 30		      cmp	#JET_MAX
   1236  f224		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1237  f226		       18		      clc
   1238  f227		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1239  f229		       85 96		      sta	JetPower
   1240  f22b		       4c 5a f2 	      jmp	.Gravity
   1241  f22e				   .JetDecay		; Up NOT held this frame
   1242  f22e		       a5 96		      lda	JetPower
   1243  f230		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1244  f232		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1245  f234		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1246  f236		       05 93		      ora	vyLo
   1247  f238		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1248  f23a							;   climb to stop, do NOT float
   1249  f23a		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1250  f23c		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1251  f23e		       4c 5a f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1252  f241				   .FloatRun
   1253  f241		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1254  f243		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1255  f245		       29 7f		      and	#$7F
   1256  f247		       d0 04		      bne	.FRActive
   1257  f249		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1258  f24b		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1259  f24d				   .FRActive
   1260  f24d		       a5 94		      lda	vyHi
