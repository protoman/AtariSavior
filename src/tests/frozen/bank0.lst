   1932  f4f9							; Miner pickup — check if player overlaps miner, advance to next level
   1933  f4f9							; ==============================================================================
   1934  f4f9				   CheckMinerPickup
   1935  f4f9		       a5 a4		      lda	LevelMinerRoom
   1936  f4fb		       29 7f		      and	#$7f
   1937  f4fd		       c5 98		      cmp	RoomNo
   1938  f4ff		       d0 1b		      bne	.CMPDone	; not in miner's room
   1939  f501							; X overlap: player [RoomX, +6] vs 4px miner.
   1940  f501							; Accept iff RoomX - MinerX in [-6, +3].
   1941  f501		       a5 80		      lda	RoomX
   1942  f503		       38		      sec
   1943  f504		       e5 a5		      sbc	MinerX
   1944  f506		       18		      clc
   1945  f507		       69 06		      adc	#PLAYER_WIDTH - 1
   1946  f509		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1947  f50b		       b0 0f		      bcs	.CMPDone	; no X overlap
   1948  f50d							; Y overlap: player [RoomY, +11] vs miner [MinerY, +11]
   1949  f50d							; accept iff RoomY - MinerY in [-11, +11]  (add 11, compare 23)
   1950  f50d		       a5 81		      lda	RoomY
   1951  f50f		       38		      sec
   1952  f510		       e5 a6		      sbc	MinerY
   1953  f512		       18		      clc
   1954  f513		       69 15		      adc	#PLAYER_SPRITE_H - 1
   1955  f515		       c9 2b		      cmp	#PLAYER_SPRITE_H + PLAYER_HEIGHT - 1
   1956  f517		       b0 03		      bcs	.CMPDone	; no Y overlap
