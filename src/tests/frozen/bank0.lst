   2169  f5fa							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2170  f5fa							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2171  f5fa							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2172  f5fa							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2173  f5fa							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2174  f5fa							; this region is upstream of the pin, so it costs nothing at $FC67.
   2175  f5fa							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2176  f5fa							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2177  f5fa							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2178  f5fa							; and normal deaths, resets on game-over reload.
   2179  f5fa							; ------------------------------------------------------------------------------
   2180  f5fa				   CEH_Key
   2181  f5fa		       a5 ba		      lda	EnemyDeadMask
   2182  f5fc		       1d ca f3 	      ora	EnemyBitTable,X
   2183  f5ff		       85 ba		      sta	EnemyDeadMask
   2184  f601		       a5 a7		      lda	LevelStartRoom
   2185  f603		       09 80		      ora	#$80	; KeyHeld = b7
   2186  f605		       85 a7		      sta	LevelStartRoom
   2187  f607		       a9 09		      lda	#9	; pickup blip (pitch 9)
   2188  f609		       4c 3c fc 	      jmp	PickupSnd
