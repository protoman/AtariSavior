   2227  f690				   .SOCount
   2228  f690							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   2229  f690		       a5 b3		      lda	EnemyCount
   2230  f692		       85 88		      sta	Temp
   2231  f694		       a5 a4		      lda	LevelMinerRoom
   2232  f696		       29 7f		      and	#$7f
