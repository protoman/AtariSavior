   1654  f485		       bc b2 f9 	      ldy	EnemyOffTable,X
   1655  f488		       20 f6 fe 	      jsr	FoldIndirect	; type
   1656  f48b		       c9 01		      cmp	#ENEMY_BAT
   1657  f48d		       f0 18		      beq	.DEYTickNoShift
   1658  f48f		       c9 03		      cmp	#ENEMY_TENTACLE
   1659  f491		       f0 1a		      beq	.DEYTickShift
   1660  f493		       c9 00		      cmp	#ENEMY_SPIDER
   1661  f495		       f0 2e		      beq	.DEYSpiderTick
   1662  f497		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1663  f499		       d0 06		      bne	.DEYStatic
   1664  f49b		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1665  f49e		       4c ba f4 	      jmp	DEYDelta
   1666  f4a1				   .DEYStatic
   1667  f4a1		       c8		      iny
   1668  f4a2		       c8		      iny
   1669  f4a3		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
