    729  f0d2							; Kernel: 192 visible scanlines
    730  f0d2							; ==============================================================================
    731  f0d2							; Structure:
    732  f0d2							;   .Row (×3): set PF registers once per color band, init scanline counter
    733  f0d2							;   .Line (×48): render one scanline — sprite check + loop control
    734  f0d2							;
    735  f0d2							; PF registers persist in TIA, so writing once per tile row is sufficient.
    736  f0d2							; The inner .Line loop has NO PF writes — only sprite rendering.
