   1754  f533		       85 f7		      sta	BombTimer
   1755  f535		       85 c1		      sta	EnemyRamD	; clear dir + RoomDarkMask (bits 4-7) — level reset
   1756  f537		       85 82		      sta	PlayerDir	; face right on every stage entry (new stage,
   1757  f539							;  game-over restart = LoseLife->ReloadLevel->
   1758  f539							;  here; same-stage respawn keeps facing)
   1759  f539		       85 9c		      sta	Hover	; bugs.md #1: stage entry lands normally; the
   1760  f53b							;   respawn hover is armed only by LoseLife
   1761  f53b		       a5 c0		      lda	LaserState
   1762  f53d		       29 c7		      and	#%11000111	; clear RoomDarkMask rooms 4-7 (LaserState b5-2)
   1763  f53f		       85 c0		      sta	LaserState
   1764  f541		       a9 05		      lda	#BOMBS_MAX
   1765  f543		       85 f0		      sta	PlayerBombs
   1766  f545		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the
   1767  f547		       c9 ff		      cmp	#$FF	; title preview (HUD score shows level+1)
   1768  f549		       f0 04		      beq	.NoBanner
   1769  f54b		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1770  f54d		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
   1771  f54f				   .NoBanner
   1772  f54f							; Compute LevelDataTable pointer: base + Level * 12
   1773  f54f							; Stride 12: start_room(1) + miner(3) + wall_colors(2) + ptrs(3×2)
   1774  f54f		       a5 a3		      lda	Level
   1775  f551		       0a		      asl		; *2
   1776  f552		       85 88		      sta	Temp	; Temp = L * 2
   1777  f554		       0a		      asl		; *4
   1778  f555		       0a		      asl		; *8
   1779  f556		       18		      clc
   1780  f557		       65 88		      adc	Temp	; *10
   1781  f559		       65 88		      adc	Temp	; *12
   1782  f55b		       a8		      tay		; Y = Level * 12
   1783  f55c
   1784  f55c							; --- Fold batch (P2.7): LevelDataTable lives in bank2 at the frozen
   1785  f55c							; address. Stage FetchPtr immediately before the batch; FoldIndirect
   1786  f55c							; preserves X and Y (iny flow below unchanged), returns the byte in A.
   1787  f55c							; The ldx #0 is kept for callers that expect X clear on entry. ---
   1788  f55c		       a9 00		      lda	#<LEVEL_DATA_ADDR
   1789  f55e		       85 e5		      sta	FetchPtr
   1790  f560		       a9 f7		      lda	#>LEVEL_DATA_ADDR
