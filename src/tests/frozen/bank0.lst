    503 U00bc							; ==============================================================================
    504 U00bc							; ROM start — F6 bankswitch (16K, 4 banks × 4K)
    505 U00bc							; ==============================================================================
    506 U00bc							; Bank3 is the power-up bank. Its stub does:
    507 U00bc							;   lda #0 / sta $1FF4 → selects bank0
    508 U00bc							; Bank0 pad at $F000-$F004 ensures the jump into GameStart works.
    509 U00bc							; ==============================================================================
    510  10000 ????				       seg	code
    511  f000					      org	$F000
    512  f000
    513  f000							; --- 5-byte bankswitching pad ---
    514  f000							; After bank3's stub selects us, CPU arrives here.
    515  f000							; We jump over the pad into the real init code.
    516  f000		       a9 00		      lda	#0
    517  f002		       8d f4 1f 	      sta	BK_GENERAL	; ensure bank0 selected (idempotent)
    518  f005		       4c 08 f0 	      jmp	GameStart	; jump over pad to init code
    519  f008							; (NOT deletable: $F008 = GameStart is a
    520  f008							;  hardcoded cross-bank entry — bank1
    521  f008							;  stub `jmp $F008`; this jmp also keeps
    522  f008							;  $F190 Overscan (bank1 stub literal tracks it —
    523  f008							;  fold-pad byte guard fires when it moves)
    524  f008							;  + F0xx landmarks fixed)
    525  f008
    526  f008				   GameStart
    527  f008		       78		      sei		; disable interrupts
    528  f009		       d8		      cld		; clear decimal mode
    529  f00a		       a2 ff		      ldx	#$FF
    530  f00c		       9a		      txs		; stack pointer = $FF
    531  f00d
    532  f00d							; --- A game over (bank4 SkRelease) leaves the magic $5A/$A5 in $8B/$8E: the
    533  f00d							;     title then keeps the level just played (user 2026-11-11). Y = Level or 0.
    534  f00d		       a0 00		      ldy	#0
    535  f00f		       a5 8b		      lda	$8B
    536  f011		       c9 5a		      cmp	#$5A
    537  f013		       d0 0c		      bne	.NoKeepLv
    538  f015		       a5 8e		      lda	$8E
    539  f017		       c9 a5		      cmp	#$A5
    540  f019		       d0 06		      bne	.NoKeepLv
    541  f01b		       a4 a3		      ldy	Level
    542  f01d		       98		      tya
    543  f01e		       09 80		      ora	#$80	; bit 7 = "game-over restart": the title ignores keys for ~1 s
    544  f020		       a8		      tay		;   (TitleSelect grace; stripped again below)
    545  f021				   .NoKeepLv
    546  f021							; --- Clear zero-page RAM ---
    547  f021		       a9 00		      lda	#0
    548  f023		       a2 80		      ldx	#$80
    549  f025				   .ClearZP
    550  f025		       95 00		      sta	$00,X
    551  f027		       e8		      inx
    552  f028		       d0 fb		      bne	.ClearZP
    553  f02a		       84 a3		      sty	Level
    554  f02c
    555  f02c							; --- Title key grace (user 2026-11-11: dying while tapping UP stepped the title's
    556  f02c							;     level, 8 -> 9). After a game-over restart (Level bit 7, set above) BombY - dead
    557  f02c							;     on title frames, written only when a bomb drops - counts $C4 -> 0 (60 frames)
    558  f02c							;     in TitleSelect, which ignores every key meanwhile. A cold boot has no grace.
    559  f02c		       a5 a3		      lda	Level
    560  f02e		       10 08		      bpl	.NoGrace
    561  f030		       29 7f		      and	#$7F
    562  f032		       85 a3		      sta	Level
    563  f034		       a9 c4		      lda	#$C4
    564  f036		       85 85		      sta	BombY
    565  f038				   .NoGrace
    566  f038							; --- Initialize game state --- (ClearZP left A = 0 and Level = 0)
    567  f038		       a9 03		      lda	#3
    568  f03a		       85 ac		      sta	PlayerLives
    569  f03c		       a9 05		      lda	#BOMBS_MAX
    570  f03e		       85 f0		      sta	PlayerBombs
    571  f040							; Initialize timer: 60 frames/step × 120 = 7200 = 120.0s (50 on PAL: the same
    572  f040							; 120 real seconds at 50 Hz)
    573  f040		       a9 3c		      lda	#TICKS_PER_SEC
    574  f042		       85 ad		      sta	TickCounter
    575  f044		       a9 78		      lda	#120
    576  f046		       85 ae		      sta	BarLevel	; bar starts full
    577  f048		       a9 00		      lda	#0
    578  f04a		       20 08 fc 	      jsr	CallPad_SaveKey	; SaveKey BOOT: Level := the saved stage (the
    579  f04d							;   title then comes up on it); no key = no-op
    580  f04d							; --- Merged title: DropTarget=$FF (2026-10-19). The CAVE kernel renders
    581  f04d							;     the stage (room 0 + player + HUD whose score shows level+1); a band
    582  f04d							;     hook overlays the SAVIOR logo and the credits, and the theme plays.
    583  f04d							;     SELECT cycles the level, RESET starts the game. Valid fall targets
    584  f04d							;     are Y ≤ 191; sentinels $FF/$FE are "not a fall". ---
    585  f04d		       a9 ff		      lda	#$FF
    586  f04f		       85 8a		      sta	DropTarget
    587  f051
    588  f051							; --- Load first level (the title previews it on the live stage:
    589  f051							;     LoadLevel leaves the player at the level start, no flight) ---
    590  f051		       20 20 fc 	      jsr	LoadLevel
    591  f054
    592  f054							; --- Set player color ---
    593  f054		       a9 48		      lda	#COLOR_PLAYER
    594  f056		       85 06		      sta	COLUP0
    595  f058
    596  f058							; --- Set playfield to reflected mode + priority ---
    597  f058							; D0=1 = reflect (left half mirrors to right)
    598  f058							; D2=1 = playfield priority (player drawn BEHIND walls, like HERO)
    599  f058							; D5-D4=%11 = 8-clock ball (D6 overlay mask; Phase 2 — ball stays
    600  f058							; disabled at kernel entry, size only matters once Phase 3 enables it)
    601  f058		       a9 35		      lda	#$35	; CTRLPF: reflect + priority + ball 8 clk
    602  f05a		       85 0a		      sta	CTRLPF
    603  f05c
    604  f05c							; ==============================================================================
    605  f05c							; Frame loop
    606  f05c							; ==============================================================================
    607  f05c				   StartFrame
    608  f05c
    609  f05c							; ------------------------------------------------------------------------------
    610  f05c							; VSYNC (3 scanlines)
    611  f05c							; ------------------------------------------------------------------------------
    612  f05c							; FIX (bugs.md #29 Class C): the OLD block started with `sta VSYNC` immediately
    613  f05c							; at frame entry, so the CPU was still inside the 76-cycle HBLANK when it
    614  f05c							; wrote VSYNC=$02 and the first `sta WSYNC`. A WSYNC that lands inside HBLANK
    615  f05c							; does not advance the wall clock to the next scanline boundary (it is already
    616  f05c							; there), so the VSYNC pulse was 2 lines instead of 3 on ~30% of frames (the
    617  f05c							; fraction depends on where the previous frame's overscan happened to end) —
    618  f05c							; the whole screen shifted up 1 scanline on those frames = the jitter.
    619  f05c							;
    620  f05c							; FIX: re-anchor first with an unconditional `sta WSYNC`. This always stalls to
    621  f05c							; the next scanline boundary (even if we were already at it — the store is 3c
    622  f05c							; past the HBLANK start so it always advances). THEN the 3 WSYNCs are a clean,
    623  f05c							; deterministic 3-scanline VSYNC pulse. Costs 1 scanline/frame (262 -> 263);
    624  f05c							; the sim wall-model target is updated to match.
    625  f05c		       85 02		      sta	WSYNC	; re-anchor to scanline boundary (always stalls)
    626  f05e		       a9 02		      lda	#2
    627  f060		       85 00		      sta	VSYNC
    628  f062		       85 02		      sta	WSYNC
    629  f064		       85 02		      sta	WSYNC
    630  f066		       85 02		      sta	WSYNC
    631  f068		       a9 00		      lda	#0
    632  f06a		       85 00		      sta	VSYNC
    633  f06c
    634  f06c							; ------------------------------------------------------------------------------
    635  f06c							; VBLANK (37 scanlines)
    636  f06c							; ------------------------------------------------------------------------------
    637  f06c		       a9 02		      lda	#2
    638  f06e		       85 01		      sta	VBLANK	; turn on VBLANK
    639  f070
    640  f070							; --- Set TIM64T for VBLANK ---
    641  f070							; P3.4 measured: VBLANK work worst 1311c (mean 1235c) after the rect
    642  f070							; cache (enter-copy + direct walk). #23 = 1472c = 161c headroom.
    643  f070							; A1 2026-10-20: SelectActiveObject is back in bank0 (C1 reverted), so the
    644  f070							; per-object FoldIndirect + CallPad_IsRoomDark cost is back: +46c on EVERY
    645  f070							; measured worst frame (sim_frame_budget: default 1013->1059c, FLY=Y
    646  f070							; 1078->1124c, FLY=X 1052->1098c, FLY=M 1051->1097c; wall model unchanged).
    647  f070							; Worst 1059c of the 1472c window = 413c margin.
    648  f070							; Frame budget: V(#23) + O(#50) = 73 TIM64T units → 3 + 19.4 + 197.5 +
    649  f070							; 42.1 = 262 lines. (#75 was the pre-trim 293-line frame.)
    650  f070							; 2026-10-25: #23 -> #31 (flicker hunt, bugs.md #16). With #23 a room whose
    651  f070							; GRP1 objects alternate (FlickerFrame) ran the heavy VBL path ~35c PAST
    652  f070							; the timer on every other frame: the SOXP WSYNC straddled a line edge, the
    653  f070							; poll exited at once, the entry anchor took the NEXT line -> 270/271 line
    654  f070							; frames alternating = visible flicker. #24 (+64c) fixed that room, but the
    655  f070							; two-object phase rooms (level 6 room 4) still overran ~40c on a 16-frame
    656  f070							; cycle (the object X moves the div15 count) and flipped 271<->272 in
    657  f070							; blocks. Then the whole-stage sweep (211 rooms) showed ~60 rooms with
    658  f070							; two enemies + M1/ball patches overrunning by up to 5 lines (4 positioning
    659  f070							; WSYNCs + the slot-1 staging ~ 1830c effective). The overscan real work is
    660  f070							; only ~1520c of its 3200c, so the split moved: V #25->#31, O #50->#44 (the
    661  f070							; V+O sum stays 75 = 272 lines). Result: every shipped room is a constant
    662  f070							; 272 lines (level 20: constant 273), worst VBL poll slack ~107c.
    663  f070				   VBLTimer		; sim: VBL work window starts here (TIM64T)
    664  f070		       a9 2d		      lda	#VBL_UNITS	; 31 on NTSC; PAL adds blank lines (colors.inc)
    665  f072		       8d 96 02 	      sta	TIM64T
    666  f075
    667  f075							; --- Position player sprite horizontally ---
    668  f075		       a5 80		      lda	RoomX
    669  f077		       38		      sec
    670  f078		       e5 82		      sbc	PlayerDir	; counter REFP0's one-pixel shift when reflected
    671  f07a		       a2 00		      ldx	#0	; X=0 = player0
    672  f07c		       20 0f ff 	      jsr	SetObjectXPos
    673  f07f
    674  f07f							; --- D6/D7 ball staging MOVED after .BgStore (Phase 3): the meta block
    675  f07f							; lives in bank2's models_data — a bank0 (RoomPF0Lo) read fetched bank0's
    676  f07f							; $F9xx zero pad (flag always 0). bank2 StageBandTab (BuildColupF tail)
