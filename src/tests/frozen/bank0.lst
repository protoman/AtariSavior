   4248  feac		       f0 1e		      beq	.TLive
   4249  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   4250  feb0		       a5 a3		      lda	Level
   4251  feb2		       c9 04		      cmp	#LEVEL_COUNT
   4252  feb4		       d0 04		      bne	.TNotWrap
   4253  feb6		       a9 00		      lda	#0	; wrap past last level
   4254  feb8		       85 a3		      sta	Level
   4255  feba				   .TNotWrap
   4256  feba		       a9 00		      lda	#0
   4257  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4258  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4259  febe							;   pose ($FE must take the real-fall path)
   4260  febe		       20 20 fc 	      jsr	LoadLevel
   4261  fec1		       a9 78		      lda	#120	; reset timer for new level
   4262  fec3		       85 ae		      sta	BarLevel
   4263  fec5		       a9 3c		      lda	#60
   4264  fec7		       85 ad		      sta	TickCounter
