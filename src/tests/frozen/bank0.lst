   1084  f1f4							; --- Laser (S1+S2.1): fire state + M0 beam position (body after fold pads) ---
   1085  f1f4		       20 33 ff 	      jsr	LaserInput	; state + RESM0/HMM0/ENAM0; Temp (joystick) untouched
   1086  f1f7
   1087  f1f7							; ------------------------------------------------------------------------------
   1088  f1f7							; Vertical movement — HERO-style jetpack physics
   1089  f1f7							; ------------------------------------------------------------------------------
   1090  f1f7							; Gravity pulls down, holding Up fires jetpack (JetPower ramps with inertia).
   1091  f1f7							; Velocity is integrated through PlayerYSub and walked pixel-by-pixel via
   1092  f1f7							; StepDown/StepUp so collision stops flush at walls/doorways.
   1093  f1f7							; ------------------------------------------------------------------------------
   1094  f1f7				   UpdateP0Vertical
   1095  f1f7							; --- Clear HotBump (Temp b7) — set again only if this frame bumps hot rock ---
   1096  f1f7		       a5 88		      lda	Temp
   1097  f1f9		       29 7f		      and	#%01111111
   1098  f1fb		       85 88		      sta	Temp
   1099  f1fd
   1100  f1fd							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1101  f1fd							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1102  f1fd							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1103  f1fd							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1104  f1fd							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1105  f1fd							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1106  f1fd							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1107  f1fd							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1108  f1fd							;	   1.0s hover was too long — halved); then the flag clears and
   1109  f1fd							;	   normal gravity resumes (fall ~0.85s after release). State
   1110  f1fd							;	   lives in JetPower, NOT
   1111  f1fd							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1112  f1fd							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1113  f1fd							;	   rising frame — both clobbered a StepsLeft-based float.
   1114  f1fd							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1115  f1fd							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1116  f1fd							;	   (headroom stays $FC67).
   1117  f1fd							; ------------------------------------------------------------------------------
   1118  f1fd		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1119  f1ff		       24 88		      bit	Temp
   1120  f201		       d0 21		      bne	.JetDecay
   1121  f203		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1122  f205		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1123  f207		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1124  f209		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1125  f20b				   .RampStart
   1126  f20b		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1127  f20d		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1128  f20f		       d0 3f		      bne	.Gravity
   1129  f211		       a5 96		      lda	JetPower
   1130  f213		       c9 14		      cmp	#JET_MAX
   1131  f215		       b0 06		      bcs	.JetCapped
   1132  f217		       18		      clc
   1133  f218		       69 01		      adc	#1
   1134  f21a		       4c 1f f2 	      jmp	.JetSet
   1135  f21d				   .JetCapped
   1136  f21d		       a9 14		      lda	#JET_MAX
   1137  f21f				   .JetSet
   1138  f21f		       85 96		      sta	JetPower
   1139  f221		       4c 50 f2 	      jmp	.Gravity
   1140  f224				   .JetDecay		; Up NOT held this frame
   1141  f224		       a5 96		      lda	JetPower
   1142  f226		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1143  f228		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1144  f22a		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1145  f22c		       05 93		      ora	vyLo
   1146  f22e		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1147  f230							;   climb to stop, do NOT float
   1148  f230		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1149  f232		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1150  f234		       4c 50 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1151  f237				   .FloatRun
   1152  f237		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1153  f239		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1154  f23b		       29 7f		      and	#$7F
   1155  f23d		       d0 04		      bne	.FRActive
   1156  f23f		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1157  f241		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1158  f243				   .FRActive
   1159  f243		       a5 94		      lda	vyHi
   1160  f245		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1161  f247		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1162  f249		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1163  f24b		       85 94		      sta	vyHi
   1164  f24d		       4c 8d f2 	      jmp	.Integrate
   1165  f250
   1166  f250							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1167  f250							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1168  f250							;     only — subtracting $80+ would blast the player upward.
   1169  f250				   .Gravity
   1170  f250		       18		      clc
   1171  f251		       a5 93		      lda	vyLo
   1172  f253		       69 08		      adc	#<GRAVITY
   1173  f255		       85 93		      sta	vyLo
   1174  f257		       a5 94		      lda	vyHi
   1175  f259		       69 00		      adc	#>GRAVITY
   1176  f25b		       85 94		      sta	vyHi
   1177  f25d		       a5 96		      lda	JetPower
   1178  f25f		       30 0d		      bmi	.ThrustSkip	; float: no thrust subtraction
   1179  f261		       38		      sec
   1180  f262		       a5 93		      lda	vyLo
   1181  f264		       e5 96		      sbc	JetPower
   1182  f266		       85 93		      sta	vyLo
   1183  f268		       a5 94		      lda	vyHi
   1184  f26a		       e9 00		      sbc	#0
   1185  f26c		       85 94		      sta	vyHi
   1186  f26e				   .ThrustSkip
   1187  f26e
   1188  f26e							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1189  f26e		       a5 94		      lda	vyHi
   1190  f270		       30 0f		      bmi	.RiseClamp
   1191  f272		       c9 02		      cmp	#>MAX_FALL
   1192  f274		       90 17		      bcc	.Integrate
   1193  f276		       a9 02		      lda	#>MAX_FALL
   1194  f278		       85 94		      sta	vyHi
   1195  f27a		       a9 00		      lda	#<MAX_FALL
   1196  f27c		       85 93		      sta	vyLo
   1197  f27e		       4c 8d f2 	      jmp	.Integrate
   1198  f281				   .RiseClamp
   1199  f281		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1200  f283		       b0 08		      bcs	.Integrate
   1201  f285		       a9 ff		      lda	#$ff
   1202  f287		       85 94		      sta	vyHi
   1203  f289		       a9 00		      lda	#$00
   1204  f28b		       85 93		      sta	vyLo	; vy = -$0100
   1205  f28d
   1206  f28d							; --- Signed whole-pixel displacement this frame = carry + vyHi. ---
   1207  f28d							;     Respawn hover (bugs.md #1) runs HERE so every velocity path reaches it
   1208  f28d							;     (the clamp above `jmp .Integrate`s past anything placed earlier). While
   1209  f28d							;     Hover is set, pin Y (vy=0, no fall) but let the jet ramp run; once thrust
   1210  f28d							;     can beat gravity (JetPower >= GRAVITY+1) clear it and normal physics
   1211  f28d							;     resumes (he lifts off). No Up -> hovers in place.
   1212  f28d				   .Integrate
   1213  f28d		       a5 9c		      lda	Hover
   1214  f28f		       f0 13		      beq	.DoInt
   1215  f291		       a5 96		      lda	JetPower
   1216  f293		       c9 09		      cmp	#GRAVITY + 1
   1217  f295		       b0 09		      bcs	.HoverEnd
   1218  f297		       a9 00		      lda	#0
   1219  f299		       85 93		      sta	vyLo
   1220  f29b		       85 94		      sta	vyHi
   1221  f29d		       4c a4 f2 	      jmp	.DoInt
   1222  f2a0				   .HoverEnd
   1223  f2a0		       a9 00		      lda	#0
   1224  f2a2		       85 9c		      sta	Hover
   1225  f2a4				   .DoInt
   1226  f2a4		       18		      clc
   1227  f2a5		       a5 95		      lda	PlayerYSub
   1228  f2a7		       65 93		      adc	vyLo
   1229  f2a9		       85 95		      sta	PlayerYSub
   1230  f2ab		       a9 00		      lda	#0
   1231  f2ad		       65 94		      adc	vyHi
   1232  f2af		       f0 1c		      beq	.NoVMove
   1233  f2b1		       30 0c		      bmi	.UpSteps
   1234  f2b3		       85 97		      sta	StepsLeft	; positive = falling (down)
   1235  f2b5				   .JFalling
   1236  f2b5		       20 55 f3 	      jsr	StepDown
   1237  f2b8		       c6 97		      dec	StepsLeft
   1238  f2ba		       d0 f9		      bne	.JFalling
   1239  f2bc		       4c cd f2 	      jmp	.NoVMove
   1240  f2bf				   .UpSteps
   1241  f2bf		       49 ff		      eor	#$ff
   1242  f2c1		       18		      clc
   1243  f2c2		       69 01		      adc	#1	; magnitude of upward displacement
   1244  f2c4		       85 97		      sta	StepsLeft
   1245  f2c6				   .JRising
   1246  f2c6		       20 8e f3 	      jsr	StepUp
   1247  f2c9		       c6 97		      dec	StepsLeft
   1248  f2cb		       d0 f9		      bne	.JRising
   1249  f2cd				   .NoVMove
