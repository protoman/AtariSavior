   1215  f20c							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1216  f20c							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1217  f20c							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1218  f20c							;	   catches the fall in ~10 frames from terminal $0180.
   1219  f20c							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1220  f20c							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1221  f20c							;	   gone: it kept thrust below gravity for ~32 frames.
   1222  f20c							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1223  f20c							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1224  f20c							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1225  f20c							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1226  f20c							;	   1.0s hover was too long — halved); then the flag clears and
   1227  f20c							;	   normal gravity resumes (fall ~0.85s after release). State
   1228  f20c							;	   lives in JetPower, NOT
   1229  f20c							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1230  f20c							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1231  f20c							;	   rising frame — both clobbered a StepsLeft-based float.
   1232  f20c							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1233  f20c							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1234  f20c							;	   (headroom stays $FC67).
   1235  f20c							; ------------------------------------------------------------------------------
   1236  f20c		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1237  f20e		       24 88		      bit	Temp
   1238  f210		       d0 25		      bne	.JetDecay
   1239  f212		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1240  f214		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1241  f216		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1242  f218		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1243  f21a				   .JetRamp
   1244  f21a							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1245  f21a							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1246  f21a							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1247  f21a							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1248  f21a							; ~80 frames = more than a room height of extra falling). The ramp only
   1249  f21a							; applies from rest / while already rising, so take-off still eases in.
   1250  f21a		       a5 94		      lda	vyHi
   1251  f21c		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1252  f21e		       05 93		      ora	vyLo
   1253  f220		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1254  f222		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1255  f224		       85 96		      sta	JetPower
   1256  f226		       4c 63 f2 	      jmp	.Gravity
   1257  f229				   .JetClimb
   1258  f229		       a5 96		      lda	JetPower
   1259  f22b		       c9 30		      cmp	#JET_MAX
   1260  f22d		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1261  f22f		       18		      clc
   1262  f230		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1263  f232		       85 96		      sta	JetPower
   1264  f234		       4c 63 f2 	      jmp	.Gravity
