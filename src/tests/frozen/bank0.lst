   1946  f62e		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1947  f630		       b0 0f		      bcs	.CMPDone	; no X overlap
   1948  f632							; Y overlap: player [RoomY, +11] vs miner [MinerY, +7]
   1949  f632							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
