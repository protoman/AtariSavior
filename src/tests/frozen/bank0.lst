   3781  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3782  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3783  fdde							;   span)
   3784  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3785  fdde							;   latch + feature gate pushed +14; same day
   3786  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3787  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3788  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3789  fdde							;   garbage path's `inc $4A,X` set wall bits
   3790  fdde							;   via $CA)
