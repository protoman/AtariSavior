   1432  f3b6							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1433  f3b6							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1434  f3b6							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1435  f3b6							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1436  f3b6							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1437  f3b6							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1438  f3b6							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1439  f3b6							; so the first move is the retreat into its wall. Ignores editor range_* per
   1440  f3b6							; user 2026-09-23. No wall collision.
   1441  f3b6							; ------------------------------------------------------------------------------
   1442  f3b6				   UpdateEnemies
   1443  f3b6		       a5 b3		      lda	EnemyCount
   1444  f3b8		       d0 01		      bne	UE_Start
   1445  f3ba		       60		      rts
   1446  f3bb				   UE_Start
   1447  f3bb							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1448  f3bb							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1449  f3bb		       a5 b1		      lda	EnemyDataLo
   1450  f3bd		       85 e5		      sta	FetchPtr
   1451  f3bf		       a5 b2		      lda	EnemyDataHi
   1452  f3c1		       85 e6		      sta	FetchPtr+1
   1453  f3c3		       a2 00		      ldx	#0
   1454  f3c5				   UE_Loop
   1455  f3c5		       e4 b3		      cpx	EnemyCount
   1456  f3c7		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1457  f3c9		       4c 24 f4 	      jmp	UE_Exit
   1458  f3cc				   UE_Alive
   1459  f3cc		       a5 ba		      lda	EnemyDeadMask
   1460  f3ce		       3d b2 f3 	      and	EnemyBitTable,X
   1461  f3d1		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1462  f3d3		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1463  f3d6		       20 f6 fe 	      jsr	FoldIndirect	; type
   1464  f3d9		       4c 14 f8 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1465  f3dc							; 18 B per-type compare chain with one 3 B jmp:
   1466  f3dc							; frees 15 B of pre-pad headroom and gives the
   1467  f3dc							; type tables room for the raft byte.
   1468  f3dc				   UE_SnakeBody
   1469  f3dc		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1470  f3de		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1471  f3e0		       d0 3e		      bne	UE_Next
   1472  f3e2							; live dir bit: 1 = right, 0 = left
   1473  f3e2		       bd b2 f3 	      lda	EnemyBitTable,X
   1474  f3e5		       25 c1		      and	EnemyRamD
   1475  f3e7		       d0 1d		      bne	UE_SnakeRight
   1476  f3e9				   UE_SnakeLeft
