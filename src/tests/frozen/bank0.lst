   1542  f407		       e9 04		      sbc	#SNAKE_PATROL	; rmin = spawn - SNAKE_PATROL: SYMMETRIC patrol
   1543  f409							; (user 2026-10-19) — no dir read needed, the
   1544  f409							; range is the placement ± one tile either way
   1545  f409		       85 88		      sta	Temp
   1546  f40b		       b5 bd		      lda	EnemyRamX,X
   1547  f40d		       c5 88		      cmp	Temp
   1548  f40f		       b0 24		      bcs	UE_Next	; X >= rmin OK
   1549  f411		       a5 88		      lda	Temp
   1550  f413		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1551  f415		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1552  f418		       4c 35 f4 	      jmp	UE_Next
   1553  f41b				   UE_SnakeRight
