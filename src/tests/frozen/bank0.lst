   1752  f490							; ------------------------------------------------------------------------------
   1753  f490							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1754  f490							; there is no free ZP byte for per-slot movement state (phase/direction live
   1755  f490							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1756  f490							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1757  f490							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1758  f490							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1759  f490							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1760  f490							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1761  f490							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1762  f490							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1763  f490							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1764  f490							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1765  f490							;	    the 60-frame game timer — gates from it wrap every second).
   1766  f490							; Other types: straight ROM y (their movement stages come later).
   1767  f490							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1768  f490							; ------------------------------------------------------------------------------
   1769  f490				   DeriveEnemyY
   1770  f490							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1771  f490							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1772  f490		       a5 b1		      lda	EnemyDataLo
   1773  f492		       85 e5		      sta	FetchPtr
   1774  f494		       a5 b2		      lda	EnemyDataHi
   1775  f496		       85 e6		      sta	FetchPtr+1
   1776  f498		       bc 77 f9 	      ldy	EnemyOffTable,X
   1777  f49b		       20 f6 fe 	      jsr	FoldIndirect	; type
   1778  f49e		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1779  f4a0							;   missed and a dir-left enemy fell through to
   1780  f4a0							;   .DEYStatic (no bob)
   1781  f4a0		       c9 01		      cmp	#ENEMY_BAT
   1782  f4a2		       f0 18		      beq	.DEYTickNoShift
   1783  f4a4		       c9 03		      cmp	#ENEMY_TENTACLE
   1784  f4a6		       f0 1a		      beq	.DEYTickShift
   1785  f4a8		       c9 00		      cmp	#ENEMY_SPIDER
   1786  f4aa		       f0 2e		      beq	.DEYSpiderTick
   1787  f4ac		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1788  f4ae		       d0 06		      bne	.DEYStatic
   1789  f4b0		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1790  f4b3		       4c cf f4 	      jmp	DEYDelta
   1791  f4b6				   .DEYStatic
   1792  f4b6		       c8		      iny
   1793  f4b7		       c8		      iny
   1794  f4b8		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1795  f4bb		       60		      rts
   1796  f4bc				   .DEYTickNoShift
   1797  f4bc		       a5 c2		      lda	EnemyRamP
   1798  f4be		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1799  f4bf		       4c c7 f4 	      jmp	.DEYBobTick
   1800  f4c2				   .DEYTickShift
   1801  f4c2		       a5 c2		      lda	EnemyRamP
   1802  f4c4		       4a		      lsr
   1803  f4c5		       4a		      lsr
   1804  f4c6		       4a		      lsr		; ÷8 gate
