   4292  ff70		       38		      sec
   4293  ff71		       e9 14		      sbc	#20
   4294  ff73		       b0 02		      bcs	.LAdvCapLs
   4295  ff75		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
