   1929  f504		       c9 0a		      cmp	#PLAYER_WIDTH + MINER_WIDTH - 1
   1930  f506		       b0 0f		      bcs	.CMPDone	; no X overlap
   1931  f508							; Y overlap: player [RoomY, +11] vs miner [MinerY, +11]
