   3648  fd32							; ------------------------------------------------------------------------------
   3649  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3650  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3651  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3652  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3653  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3654  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3655  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3656  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3657  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3658  fd32							;	    the real drop-in → gameplay starts
   3659  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3660  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3661  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3662  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3663  fd32							; ------------------------------------------------------------------------------
   3664  fd32				   TitleWork
   3665  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3666  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3667  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3668  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3669  fd3a				   .TWselDone
   3670  fd3a							; --- RESET edge ---
   3671  fd3a		       a5 97		      lda	StepsLeft
   3672  fd3c		       29 01		      and	#%00000001
   3673  fd3e		       f0 14		      beq	.TWrstDone
   3674  fd40		       ad 82 02 	      lda	SWCHB
   3675  fd43		       29 01		      and	#%00000001
   3676  fd45		       d0 0d		      bne	.TWrstDone
   3677  fd47		       a9 00		      lda	#0
   3678  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3679  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3680  fd4d		       85 f4		      sta	ScoreHu
   3681  fd4f		       85 f5		      sta	ScoreTe
   3682  fd51		       20 20 fc 	      jsr	LoadLevel
   3683  fd54				   .TWrstDone
   3684  fd54		       ad 82 02 	      lda	SWCHB
   3685  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3686  fd59							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3687  fd59							;     channel force-muted here — UpdateJetSound is skipped because
   3688  fd59							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3689  fd59							;     = 0, AUDV0 covered above). ---
   3690  fd59				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3691  fd59		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3692  fd5b		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3693  fd5d		       f0 0e		      beq	.TWmusic
   3694  fd5f		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3695  fd61		       20 98 f5 	      jsr	BombTick
   3696  fd64				   .TWnoTick
   3697  fd64		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3698  fd67		       a9 00		      lda	#0
   3699  fd69		       85 1a		      sta	AUDV1
   3700  fd6b		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3701  fd6d				   .TWmusic		; title: music wins the audio regs
   3702  fd6d		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3703  fd70				   .TWwait
   3704  fd70		       ad 84 02 	      lda	INTIM
   3705  fd73		       d0 fb		      bne	.TWwait
   3706  fd75		       4c 39 f0 	      jmp	StartFrame
