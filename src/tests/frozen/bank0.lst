   3642  fe9c							; TallyWork — level-bonus count-up (user spec 2026-10-02): reaching the miner
   3643  fe9c							; freezes the frame (dispatch bypasses input/physics/enemies via DropTarget
   3644  fe9c							; $FE), bank2 TallyEntry adds +50 every 4 frames and writes the coin tone
   3645  fe9c							; (every 200 pts); when TallyTicks hits 0 the done path advances the level
   3646  fe9c							; exactly like the old CheckMinerPickup tail, then rejoins OverscanAudio.
   3647  fe9c							;   Event bits in A (through ReturnPad sta/rts): b0 = add 50, b2 = done.
   3648  fe9c							;   Tail mirrors TitleWork: UpdateBombSound holds the coin (BombSnd>0), jet
   3649  fe9c							;   muted, own INTIM wait -> StartFrame: timer block skipped = frozen scene.
   3650  fe9c							; Lives in the $FE8C LHT..moth fill (bank0 has no pre-pad headroom).
   3651  fe9c							; ------------------------------------------------------------------------------
   3652  fe9c				   TallyWork
   3653  fe9c		       20 e6 ff 	      jsr	TallyTramp	; A = event (bank2 TallyEntry step)
   3654  fe9f		       a8		      tay
   3655  fea0		       29 01		      and	#1
   3656  fea2		       f0 05		      beq	.TNoScore
   3657  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3658  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3659  fea9				   .TNoScore
   3660  fea9		       98		      tya
   3661  feaa		       29 04		      and	#4
   3662  feac		       f0 1e		      beq	.TLive
   3663  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3664  feb0		       a5 a3		      lda	Level
   3665  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3666  feb4		       d0 04		      bne	.TNotWrap
   3667  feb6		       a9 00		      lda	#0	; wrap past last level
   3668  feb8		       85 a3		      sta	Level
   3669  feba				   .TNotWrap
   3670  feba		       a9 00		      lda	#0
   3671  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   3672  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   3673  febe							;   pose ($FE must take the real-fall path)
   3674  febe		       20 35 f5 	      jsr	LoadLevel
   3675  fec1		       a9 78		      lda	#120	; reset timer for new level
   3676  fec3		       85 ae		      sta	BarLevel
   3677  fec5		       a9 3c		      lda	#60
   3678  fec7		       85 ad		      sta	TickCounter
   3679  fec9		       4c 1e f3 	      jmp	OverscanAudio	; normal sounds + timer resume
   3680  fecc				   .TLive
   3681  fecc		       20 fc fb 	      jsr	CallPad_UpdateBombSound	; hold/silence ch0 for the coin blip
   3682  fecf		       a9 00		      lda	#0
   3683  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3684  fed3				   .TWait
   3685  fed3		       ad 84 02 	      lda	INTIM
   3686  fed6		       d0 fb		      bne	.TWait
   3687  fed8		       4c 39 f0 	      jmp	StartFrame
