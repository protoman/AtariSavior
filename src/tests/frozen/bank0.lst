    387 U00bc							; line before the sprite must match row0 or a
    388 U00bc							; gold fringe shows above the sprite
    389 U00bc							; Player sprite per-row colors (PlayerColTable)
    390 U00bc		       00 48	   COLOR_P_RED =	$48	; hue 4 luma 4 = red body
    391 U00bc		       00 1e	   COLOR_P_YELLOW =	$1E	; hue 1 luma 7 = yellow face
    392 U00bc		       00 08	   COLOR_P_GRAY =	$08	; hue 0 luma 4 = grey pack + boots
    393 U00bc		       00 00	   COLOR_CAVE_BG =	$00	; black interior
    394 U00bc		       00 84	   COLOR_CAVE_WALL =	$84	; hue 8 luma 2 = dark grey-blue
    395 U00bc		       00 06	   COLOR_HUD_BG =	$06	; hue 0 luma 3 = grey
    396 U00bc		       00 1e	   COLOR_TIMER =	$1E	; hue 1 luma 7 = yellow
    397 U00bc		       00 c6	   COLOR_LIVES =	$C6	; hue 12 luma 3 = green
    398 U00bc		       00 46	   COLOR_BOMBS =	$46	; hue 4 luma 3 = red
    399 U00bc		       00 0e	   COLOR_SCORE =	$0E	; hue 0 luma 7 = white
    400 U00bc		       00 6a	   COLOR_TITLE =	$6A	; hue 6 luma 5 = purple (title text)
    401 U00bc
    402 U00bc							; Dark room (lamp crashed): medium grey objects, black PF; fuse PF dark grey
    403 U00bc		       00 0a	   COLOR_DARK_OBJ =	$0A	; hue 0 luma 5 = medium grey (lamp + enemies)
    404 U00bc		       00 04	   COLOR_DARK_PF =	$04	; hue 0 luma 2 = very dark grey (bomb fuse walls)
