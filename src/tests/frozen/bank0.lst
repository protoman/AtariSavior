    856  f118		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
    857  f11a		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
    858  f11c		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
    859  f11d							;   Color/beam gate entered only with A0<=10
