   4688  ff9e		       4c a4 ff 	      jmp	.LaserContact
   4689  ffa1				   .LaserKill
   4690  ffa1		       20 0b fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   4691  ffa4				   .LaserContact
