    752  f0ac							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    753  f0ac							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    754  f0ac							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
