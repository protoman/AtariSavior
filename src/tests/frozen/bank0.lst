   1810  f552							; LevelDataTable stride: 12 bytes (S4 2026-10-19: start_x/y dropped — they
   1811  f552							; were always the constants 32/24)
   1812  f552							;   +0: start_room
   1813  f552							;   +1..+3: miner_room (b7 = faces right), miner_x, miner_y
