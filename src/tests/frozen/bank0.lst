   3985  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3986  ff0f							; ==============================================================================
   3987  ff0f							; Andrew Davie session-24 routine:
   3988  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3989  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3990  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3991  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3992  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3993  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3994  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3995  ff0f							;
   3996  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3997  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3998  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3999  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4000  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4001  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4002  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4003  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4004  ff0f				   SetObjectXPos subroutine
   4005  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4006  ff11		       38		      sec		; ensure carry flag
   4007  ff12				   .Div15Loop
   4008  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4009  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4010  ff16		       a8		      tay		; Y = remainder in -15..-1
   4011  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4012  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4013  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4014  ff1e		       60		      rts
   4015  ff1f
