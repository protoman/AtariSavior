   2177  f60e							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2178  f60e							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2179  f60e							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2180  f60e							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2181  f60e							; ------------------------------------------------------------------------------
   2182  f60e				   UEDispatch
   2183  f60e		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2184  f610							;   the single type-compare entry. 2026-10-22:
   2185  f610							;   a raft authored dir=right read $87, missed
   2186  f610							;   `cmp #ENEMY_RAFT` and its body never ran
   2187  f610							;   (no tide, no motion, no rider pin).
   2188  f610		       c9 07		      cmp	#ENEMY_RAFT
   2189  f612		       d0 06		      bne	.UEDNotRaft
   2190  f614		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2191  f617		       4c 37 f4 	      jmp	UE_Next
   2192  f61a				   .UEDNotRaft
   2193  f61a		       c9 03		      cmp	#ENEMY_TENTACLE
   2194  f61c		       d0 03		      bne	.UEDNotTent
   2195  f61e		       4c 3c f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2196  f621				   .UEDNotTent
   2197  f621		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2198  f623		       d0 03		      bne	.UEDNotMoth
   2199  f625		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2200  f628				   .UEDNotMoth
   2201  f628		       c9 02		      cmp	#ENEMY_SNAKE
   2202  f62a		       d0 03		      bne	.UEDNotSnake
   2203  f62c		       4c f3 f3 	      jmp	UE_SnakeBody
   2204  f62f				   .UEDNotSnake
   2205  f62f		       4c 37 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2206  f632							; (absolute jmps: this block is far from the
   2207  f632							;  bodies — relative branches do not reach)
