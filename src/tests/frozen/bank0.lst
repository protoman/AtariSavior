   3460  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   3461  fdde							;   .HOVfeature; NOT in the TitleJetColors
   3462  fdde							;   span)
   3463  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   3464  fdde							;   latch + feature gate pushed +14; same day
   3465  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   3466  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   3467  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   3468  fdde							;   garbage path's `inc $4A,X` set wall bits
   3469  fdde							;   via $CA)
