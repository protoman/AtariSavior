   3338  fd3b		       90 03		      bcc	.TWselDone	; C=0: no edge
   3339  fd3d		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3340  fd40				   .TWselDone
   3341  fd40							; --- RESET edge ---
   3342  fd40		       a5 97		      lda	StepsLeft
   3343  fd42		       29 01		      and	#%00000001
   3344  fd44		       f0 14		      beq	.TWrstDone
   3345  fd46		       ad 82 02 	      lda	SWCHB
   3346  fd49		       29 01		      and	#%00000001
   3347  fd4b		       d0 0d		      bne	.TWrstDone
   3348  fd4d		       a9 00		      lda	#0
   3349  fd4f		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3350  fd51		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3351  fd53		       85 f4		      sta	ScoreHu
   3352  fd55		       85 f5		      sta	ScoreTe
   3353  fd57		       20 20 fc 	      jsr	LoadLevel
   3354  fd5a				   .TWrstDone
   3355  fd5a		       ad 82 02 	      lda	SWCHB
