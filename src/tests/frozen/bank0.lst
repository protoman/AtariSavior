   2066  f589							; BombTick — per-frame state machine (overscan).
   2067  f589							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2068  f589							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2069  f589							; ------------------------------------------------------------------------------
   2070  f589				   BombTick   subroutine
   2071  f589		       a5 b5		      lda	BombPacked
   2072  f58b		       29 03		      and	#%00000011	; state
   2073  f58d		       f0 1e		      beq	.BTDone	; none
   2074  f58f		       c9 01		      cmp	#1
   2075  f591		       f0 26		      beq	.BTFuse
   2076  f593							; state 2 — exploding
   2077  f593		       c6 f7		      dec	BombTimer
   2078  f595		       f0 17		      beq	.BTEnd
   2079  f597		       a5 f7		      lda	BombTimer
   2080  f599		       c9 3b		      cmp	#59	; the frame AFTER the blast edge: enemy kill, player
   2081  f59b		       d0 10		      bne	.BTDone	;   hit and the noise burst (2026-11: they used to
   2082  f59d							;   share the edge frame with BombMarkWalls, ~920c,
   2083  f59d							;   and pushed that overscan up to 6 lines long)
   2084  f59d		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2085  f5a0		       f0 05		      beq	.BTNoKill
   2086  f5a2		       a9 50		      lda	#$50	; +50 per kill — moved out of the pad body
   2087  f5a4		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2088  f5a7				   .BTNoKill
   2089  f5a7		       20 d2 f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2090  f5aa		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2091  f5ad				   .BTDone
   2092  f5ad		       60		      rts
   2093  f5ae				   .BTEnd
   2094  f5ae		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2095  f5b0		       29 fc		      and	#%11111100
   2096  f5b2		       85 b5		      sta	BombPacked
   2097  f5b4		       a9 00		      lda	#0
   2098  f5b6		       85 f7		      sta	BombTimer
   2099  f5b8		       60		      rts
   2100  f5b9				   .BTFuse
   2101  f5b9		       c6 f7		      dec	BombTimer
   2102  f5bb		       d0 f0		      bne	.BTDone
   2103  f5bd		       e6 b5		      inc	BombPacked	; state 1 -> 2 (b1:0 = 01 -> 10; no carry into b2)
   2104  f5bf		       a9 3c		      lda	#60
   2105  f5c1		       85 f7		      sta	BombTimer
   2106  f5c3		       20 1a fc 	      jsr	CallPad_BombMarkWalls	; S6.3: set WallMask; A = #walls newly broken
   2107  f5c6		       aa		      tax
   2108  f5c7		       f0 08		      beq	.BTNoScore
   2109  f5c9				   .BTScore
   2110  f5c9		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2111  f5cb		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2112  f5ce		       ca		      dex
   2113  f5cf		       d0 f8		      bne	.BTScore
   2114  f5d1				   .BTNoScore
   2115  f5d1		       60		      rts		; enemy/player/sound follow next frame (timer 59)
