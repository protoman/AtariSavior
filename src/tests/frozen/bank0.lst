   4524  ff55				   .LAdvS
   4525  ff55		       85 92		      sta	RectCount	; candidate (not committed yet)
   4526  ff57		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   4527  ff59		       90 03		      bcc	.LAdvCap
   4528  ff5b		       4c 87 ff 	      jmp	.LaserInit
   4529  ff5e				   .LAdvCap
   4530  ff5e		       a5 82		      lda	PlayerDir
   4531  ff60		       d0 0c		      bne	.LAdvCapL
   4532  ff62		       a5 80		      lda	RoomX
   4533  ff64		       18		      clc
   4534  ff65		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   4535  ff67		       c5 92		      cmp	RectCount
   4536  ff69		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   4537  ff6b		       4c 87 ff 	      jmp	.LaserInit
   4538  ff6e				   .LAdvCapL
   4539  ff6e		       a5 80		      lda	RoomX
   4540  ff70		       38		      sec
   4541  ff71		       e9 14		      sbc	#20
   4542  ff73		       b0 02		      bcs	.LAdvCapLs
   4543  ff75		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   4544  ff77				   .LAdvCapLs
   4545  ff77		       c5 92		      cmp	RectCount	; cap vs cand
   4546  ff79		       f0 05		      beq	.LAdvKeep
   4547  ff7b		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   4548  ff7d		       4c 87 ff 	      jmp	.LaserInit
   4549  ff80				   .LAdvKeep
   4550  ff80		       a5 92		      lda	RectCount
   4551  ff82		       85 83		      sta	LaserX
   4552  ff84		       4c 8a ff 	      jmp	.LaserGo	; committed: skip the eye restart
   4553  ff87				   .LaserInit
   4554  ff87		       20 b1 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   4555  ff8a				   .LaserGo
   4556  ff8a		       a5 83		      lda	LaserX
   4557  ff8c		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   4558  ff8e		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   4559  ff91		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   4560  ff93		       c9 50		      cmp	#$50
   4561  ff95		       f0 0a		      beq	.LaserKill
   4562  ff97		       c9 02		      cmp	#2
   4563  ff99		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   4564  ff9b							;   same as kill minus score — restart at
   4565  ff9b							;   the eye THIS frame, buzz keeps (b7).
   4566  ff9b							;   #9's blank + the wall-center hold clamp
   4567  ff9b							;   both superseded: a contact missile is
   4568  ff9b							;   consumed by walls. No hold state, no
   4569  ff9b							;   cap reorder, no pass-through possible.
   4570  ff9b		       20 11 fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   4571  ff9e		       4c a4 ff 	      jmp	.LaserContact
   4572  ffa1				   .LaserKill
   4573  ffa1		       20 0b fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   4574  ffa4				   .LaserContact
