   1529  f425							; ------------------------------------------------------------------------------
   1530  f425							; UE_Tentacle — chase RoomX: 1 px toward the player every 4th frame, gated by
   1531  f425							; a wall probe. Probe reuses PlayerHitsMap via RoomX/RoomY swap (plan spec):
   1532  f425							; save player xy in ActiveObjectX/Y scratch (NOT the stack — 3 pha drove SP to
   1533  f425							; $F4 and jsr return bytes stomped BombTimer $F7 / BombX $F6 every 4th frame,
   1534  f425							; so the fuse never reached 0), put candidate X + live tentacle Y, call,
   1535  f425							; restore from scratch (lda/sta do not disturb C), commit only when C=0.
   1536  f425							; Slot X likewise saved in EnemyIndex (PHM clobbers X in its rect walk
   1537  f425							; — E3 gate bug: the commit wrote to EnemyRamX[row] instead of
   1538  f425							; EnemyRamX[slot] → frozen X). All three bytes are write-before-read for
   1539  f425							; every reader (SelectActiveObject/CheckEnemyHit rewrite before reading).
   1540  f425							; Candidate >= 160 (incl. wrap 255) rejected before probe — room edge hold.
   1541  f425							; In: X = enemy slot. Clobbers A/Y/Temp/X (X restored around the probe).
   1542  f425							; Entered via JMP from the dispatch; every path exits .TentOut → jmp UE_Next.
   1543  f425							; ------------------------------------------------------------------------------
   1544  f425				   UE_Tentacle
   1545  f425		       a5 ad		      lda	TickCounter
   1546  f427		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1547  f429							; = half the player's 1 px/frame (user
   1548  f429							; 2026-10-10: &3 read as chunky/slow)
   1549  f429		       d0 4b		      bne	.TentOut
   1550  f42b		       b5 bd		      lda	EnemyRamX,X
   1551  f42d		       c5 80		      cmp	RoomX
   1552  f42f		       f0 45		      beq	.TentOut	; aligned with player X → hold
   1553  f431		       90 06		      bcc	.TentRight
   1554  f433		       38		      sec
   1555  f434		       e9 01		      sbc	#1	; step left
   1556  f436		       4c 3c f4 	      jmp	.TentProbe
   1557  f439				   .TentRight
   1558  f439		       18		      clc
   1559  f43a		       69 01		      adc	#1	; step right
   1560  f43c				   .TentProbe
   1561  f43c		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1562  f43e		       b0 36		      bcs	.TentOut
   1563  f440		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1564  f442							; Same-column cull: committed X is always probe-clear, so a candidate in
   1565  f442							; the same 4px column covers the same collision cells → result is known
   1566  f442							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1567  f442		       a5 88		      lda	Temp
   1568  f444		       55 bd		      eor	EnemyRamX,X
   1569  f446		       29 fc		      and	#$FC
   1570  f448		       f0 28		      beq	.TentCommit
   1571  f44a		       a5 80		      lda	RoomX
   1572  f44c		       85 b7		      sta	ActiveObjectX	; save player position in ZP scratch (was pha:
   1573  f44e		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1574  f450		       85 b8		      sta	ActiveObjectY
   1575  f452		       a5 88		      lda	Temp
   1576  f454		       c9 05		      cmp	#5
   1577  f456		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1578  f458							; PHM's negative visible-left wraps to 255
   1579  f458							; (col garbage / ColOff OOB walk). cand<=4
   1580  f458							; ink pokes off-screen anyway; RoomX=cand
   1581  f458							; already covers cell0.
   1582  f458		       38		      sec
   1583  f459		       e9 01		      sbc	#1	; #4: per-enemy origin offset — tentacle ink
   1584  f45b							; sits 5/7 px left of A (moth .Mvl convention,
   1585  f45b							; bank2), but PHM's PLAYER prologue derives
   1586  f45b							; lit-left = arg-4/arg-7 with the bin on
   1587  f45b							; RoomX-PlayerDir → box missed the cell left
   1588  f45b							; of the ink at cand 8/12 (sprite drew 1 px
   1589  f45b							; into the wall — bugs.md #4). cand-1 shifts
   1590  f45b							; the tested box 1 px left: cell-exact or 1 px
   1591  f45b							; conservative for every cand/facing pair
   1592  f45b							; (tools/test_cell_map.py tentacle section).
   1593  f45b				   .TentProbeX
   1594  f45b		       85 80		      sta	RoomX	; probe as the tentacle (candidate x [-1])
   1595  f45d		       b5 e2		      lda	EnemyRamY,X
   1596  f45f		       85 81		      sta	RoomY	; live tentacle y (refreshed this overscan)
   1597  f461		       86 b9		      stx	EnemyIndex	; save slot: PlayerHitsMap clobbers X
   1598  f463							; (rect walk ldx/dex/tax) — slot was lost here
   1599  f463		       20 26 f9 	      jsr	PlayerHitsMap
   1600  f466		       a6 b9		      ldx	EnemyIndex	; X = slot again (ldx/sta preserve C)
   1601  f468		       a5 b8		      lda	ActiveObjectY
   1602  f46a		       85 81		      sta	RoomY	; restore player Y (lda/sta preserve C)
   1603  f46c		       a5 b7		      lda	ActiveObjectX
   1604  f46e		       85 80		      sta	RoomX	; restore player X
   1605  f470		       b0 04		      bcs	.TentOut	; wall → hold position
   1606  f472				   .TentCommit
   1607  f472		       a5 88		      lda	Temp
   1608  f474		       95 bd		      sta	EnemyRamX,X	; clear → commit candidate step
   1609  f476				   .TentOut
   1610  f476		       4c 20 f4 	      jmp	UE_Next	; tail exit (rts would need a dispatch jsr)
   1611  f479
   1612  f479							; ------------------------------------------------------------------------------
   1613  f479							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1614  f479							; there is no free ZP byte for per-slot movement state (phase/direction live
   1615  f479							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1616  f479							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1617  f479							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1618  f479							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1619  f479							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1620  f479							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1621  f479							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1622  f479							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1623  f479							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1624  f479							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1625  f479							;	    the 60-frame game timer — gates from it wrap every second).
   1626  f479							; Other types: straight ROM y (their movement stages come later).
   1627  f479							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1628  f479							; ------------------------------------------------------------------------------
   1629  f479				   DeriveEnemyY
   1630  f479							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1631  f479							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1632  f479		       a5 b1		      lda	EnemyDataLo
