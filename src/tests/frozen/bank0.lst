   1502  f3f6		       b5 bd		      lda	EnemyRamX,X
   1503  f3f8		       c5 88		      cmp	Temp
   1504  f3fa		       b0 24		      bcs	UE_Next	; X >= rmin OK
   1505  f3fc		       a5 88		      lda	Temp
   1506  f3fe		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1507  f400		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1508  f403		       4c 20 f4 	      jmp	UE_Next
   1509  f406				   UE_SnakeRight
   1510  f406		       f6 bd		      inc	EnemyRamX,X
   1511  f408		       c8		      iny		; +1 = ROM spawn X
   1512  f409		       20 f6 fe 	      jsr	FoldIndirect
   1513  f40c		       85 88		      sta	Temp
   1514  f40e		       18		      clc
   1515  f40f		       69 04		      adc	#SNAKE_PATROL	; rmax = spawn + SNAKE_PATROL (symmetric)
   1516  f411		       85 88		      sta	Temp
   1517  f413		       b5 bd		      lda	EnemyRamX,X
   1518  f415		       c5 88		      cmp	Temp
   1519  f417		       90 07		      bcc	UE_Next	; X < rmax OK
   1520  f419		       a5 88		      lda	Temp
   1521  f41b		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
