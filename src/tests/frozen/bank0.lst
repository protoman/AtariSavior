   1719  f4c6		       85 88		      sta	Temp
   1720  f4c8		       c8		      iny
   1721  f4c9		       c8		      iny
   1722  f4ca		       20 f6 fe 	      jsr	FoldIndirect	; ROM spawn y
   1723  f4cd		       18		      clc
   1724  f4ce		       65 88		      adc	Temp
