   1697  f4b3		       a5 c2		      lda	EnemyRamP
   1698  f4b5		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1699  f4b6		       4c be f4 	      jmp	.DEYBobTick
