    714  f08a							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    715  f08a							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    716  f08a							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
