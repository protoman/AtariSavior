    354 U00bc		       00 dd	   DemoOn     =	$DD	; b7 = virtual FIRE press (EOR-ed onto INPT4 D7),
    355 U00bc							;   b6 = the demo is playing, b5-0 = the title's Level
    356 U00bc		       00 de	   DemoPos    =	$DE	; script index; title idle: 5-second counter, high part
    357 U00bc		       00 df	   DemoDur    =	$DF	; frames left in this script step; title idle: low part
    358 U00bc		       00 e2	   EnemyRamY  =	$E2	; 3 bytes: live Y per enemy ($E2-$E4) —
    359 U00bc							;   private since S3.4; see contract above
