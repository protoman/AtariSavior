   1691  f4b7		       20 f6 fe 	      jsr	FoldIndirect	; type
   1692  f4ba		       c9 01		      cmp	#ENEMY_BAT
   1693  f4bc		       f0 18		      beq	.DEYTickNoShift
   1694  f4be		       c9 03		      cmp	#ENEMY_TENTACLE
   1695  f4c0		       f0 1a		      beq	.DEYTickShift
   1696  f4c2		       c9 00		      cmp	#ENEMY_SPIDER
   1697  f4c4		       f0 2e		      beq	.DEYSpiderTick
