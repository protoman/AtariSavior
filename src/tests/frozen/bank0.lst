   1749  f4ec							; accept iff RoomY - MinerY in [-11, +7]  (add 11, compare 19)
   1750  f4ec		       a5 81		      lda	RoomY
   1751  f4ee		       38		      sec
   1752  f4ef		       e5 a6		      sbc	MinerY
   1753  f4f1		       18		      clc
