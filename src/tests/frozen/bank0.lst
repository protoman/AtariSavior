   4106  fda5							; ------------------------------------------------------------------------------
   4107  fda5							; BuildColupF — 12-byte final COLUPF image at ColupfBuf ($E7-$F2).
   4108  fda5							;   Stripe: rows 0,2 = LevelWallColor; row 1 = LevelWallColor2.
   4109  fda5							;   Hot rows overwrite with the TickCounter-bit5 pulse (amber/red).
   4110  fda5							;   $F0-$F2 (bombs) NO LONGER overlap-saved: body writes rows 0-2 only,
   4111  fda5							;   save/restore round trip deleted (S3.0b — window audit: zero writers).
   4112  fda5							;   Bank1 clobbers $E0-$EF during HUD; VBLANK rebuilds every frame.
   4113  fda5							; ------------------------------------------------------------------------------
   4114  fda5							; ------------------------------------------------------------------------------
   4115  fda5							; BuildColupF — MOVED to bank2 (S5.1) — CallPad_BuildColupF.
   4116  fda5							;   Hot-rect data (RoomRects) lives in bank2, so the body reads it with
   4117  fda5							;   direct (FetchPtr),Y — the shared $FEF6 fold block's sta $1FF4 always
   4118  fda5							;   returns to bank0, so a fold inside a bank1 body could not work.
   4119  fda5							;   The dark check is inlined there too: CallPad_IsRoomDark cannot nest
   4120  fda5							;   from a pad body (ReturnPad switches to bank0 mid-call).
   4121  fda5							;   Body: bank2.asm, pinned at $FC4F. Entry save block ($F0-$F2 → collision
   4122  fda5							;   temps) was dead (rows 0-2 only) — deleted with the .AfterRows restore
   4123  fda5							;   in S3.0b.
   4124  fda5							; ------------------------------------------------------------------------------
   4125  fda5
   4126  fda5							; UpdateBombSound moved to bank1 (leaf_move_plan batch A) — CallPad_UpdateBombSound.
   4127  fda5
   4128  fda5							; ------------------------------------------------------------------------------
   4129  fda5							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   4130  fda5							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   4131  fda5							;   ranges before the walk; bank2 display-space walkers mirror first too).
   4132  fda5							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   4133  fda5							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   4134  fda5							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   4135  fda5							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   4136  fda5							;   by tools/test_cell_map.py).
   4137  fda5							;   (The standalone CellSolid leaf that lived here moved INTO
   4138  fda5							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   4139  fda5							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   4140  fda5							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   4141  fda5							; ------------------------------------------------------------------------------
   4142  fda5		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   4143  fdb9		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   4144  fdc5		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   4145  fdcd
   4146  fdcd							; ------------------------------------------------------------------------------
   4147  fdcd							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   4148  fdcd							; BombTick `jsr` lands here (bank0), `sta $1FF6` switches to bank2, the `jmp`
   4149  fdcd							; is fetched from bank2's byte-identical mirror at this same address and
   4150  fdcd							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   4151  fdcd							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   4152  fdcd							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   4153  fdcd							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   4154  fdcd							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   4155  fdcd							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   4156  fdcd							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   4157  fdcd							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   4158  fdcd							; ------------------------------------------------------------------------------
   4159  fdcd		       00 00 00 00*	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   4160  fdd8				   BombEnemyBlast
   4161  fdd8		       8d f6 1f 	      sta	$1FF6
   4162  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
