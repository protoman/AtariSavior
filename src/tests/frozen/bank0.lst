   2878  f8f6		       a5 81		      lda	RoomY
   2879  f8f8		       69 15		      adc	#PLAYER_SPRITE_H - 1
   2880  f8fa		       4a		      lsr
   2881  f8fb		       4a		      lsr
   2882  f8fc		       a8		      tay
   2883  f8fd		       b9 c6 f8 	      lda	YToRowTable,Y
