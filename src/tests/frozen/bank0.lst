    903  f125							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
    904  f125							; ObjTop..ObjTop+7 window → row byte from ObjSprites[ObjBase + offset].
    905  f125							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
    906  f125							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
