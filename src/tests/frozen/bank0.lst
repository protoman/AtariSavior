   3739  ff33							; ------------------------------------------------------------------------------
   3740  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3741  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3742  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3743  ff33							; user spec: no piercing, no HERO comparison needed).
   3744  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3745  ff33							;						  left	RoomX-4)
   3746  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3747  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3748  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3749  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3750  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3751  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3752  ff33							;     priority over M0 anyway).
   3753  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3754  ff33							;     press edge re-anchors).
   3755  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3756  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3757  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3758  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3759  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3760  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3761  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3762  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3763  ff33							; ------------------------------------------------------------------------------
   3764  ff33				   LaserInput
   3765  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3766  ff35		       8a		      txa
   3767  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3768  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3769  ff3a		       8a		      txa
   3770  ff3b		       29 80		      and	#LASER_HELD
   3771  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3772  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3773  ff40		       85 c0		      sta	LaserState
   3774  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3775  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3776  ff46							; below — moved here so the cap code could
   3777  ff46							; not push .LaserReleased past bmi's ±127)
   3778  ff46				   .LaserReleased
   3779  ff46		       a9 00		      lda	#0
   3780  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   3781  ff4a							; otherwise -> bars slid across screen
   3782  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   3783  ff4b				   .LaserFire
   3784  ff4b		       a5 c0		      lda	LaserState
   3785  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   3786  ff4f		       85 c0		      sta	LaserState
   3787  ff51		       8a		      txa
   3788  ff52		       29 80		      and	#LASER_HELD
   3789  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   3790  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   3791  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   3792  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   3793  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   3794  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   3795  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   3796  ff56		       a5 c0		      lda	LaserState
   3797  ff58		       29 01		      and	#LASER_REARM
   3798  ff5a		       f0 04		      beq	.LAdvStep
   3799  ff5c		       c6 c0		      dec	LaserState
   3800  ff5e		       d0 3a		      bne	.LaserInit
   3801  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   3802  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   3803  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   3804  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   3805  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   3806  ff60				   .LAdvStep
   3807  ff60		       a4 82		      ldy	PlayerDir
   3808  ff62		       a5 83		      lda	LaserX
   3809  ff64		       18		      clc
   3810  ff65		       79 de ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   3811  ff68				   .LAdvS
   3812  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   3813  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   3814  ff6c		       90 03		      bcc	.LAdvCap
   3815  ff6e		       4c 9a ff 	      jmp	.LaserInit
   3816  ff71				   .LAdvCap
   3817  ff71		       a5 82		      lda	PlayerDir
   3818  ff73		       d0 0c		      bne	.LAdvCapL
   3819  ff75		       a5 80		      lda	RoomX
   3820  ff77		       18		      clc
   3821  ff78		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   3822  ff7a		       c5 92		      cmp	RectCount
   3823  ff7c		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   3824  ff7e		       4c 9a ff 	      jmp	.LaserInit
   3825  ff81				   .LAdvCapL
   3826  ff81		       a5 80		      lda	RoomX
   3827  ff83		       38		      sec
   3828  ff84		       e9 14		      sbc	#20
   3829  ff86		       b0 02		      bcs	.LAdvCapLs
   3830  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   3831  ff8a				   .LAdvCapLs
   3832  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
   3833  ff8c		       f0 05		      beq	.LAdvKeep
   3834  ff8e		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   3835  ff90		       4c 9a ff 	      jmp	.LaserInit
   3836  ff93				   .LAdvKeep
   3837  ff93		       a5 92		      lda	RectCount
   3838  ff95		       85 83		      sta	LaserX
   3839  ff97		       4c 9d ff 	      jmp	.LaserGo	; committed: skip the eye restart
   3840  ff9a				   .LaserInit
   3841  ff9a		       20 c4 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   3842  ff9d				   .LaserGo
   3843  ff9d		       a5 83		      lda	LaserX
   3844  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   3845  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   3846  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   3847  ffa6		       c9 50		      cmp	#$50
   3848  ffa8		       f0 0a		      beq	.LaserKill
   3849  ffaa		       c9 02		      cmp	#2
   3850  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   3851  ffae							;   same as kill minus score — restart at
   3852  ffae							;   the eye THIS frame, buzz keeps (b7).
   3853  ffae							;   #9's blank + the wall-center hold clamp
   3854  ffae							;   both superseded: a contact missile is
   3855  ffae							;   consumed by walls. No hold state, no
   3856  ffae							;   cap reorder, no pass-through possible.
   3857  ffae		       20 2c fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   3858  ffb1		       4c b7 ff 	      jmp	.LaserContact
   3859  ffb4				   .LaserKill
   3860  ffb4		       20 20 fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   3861  ffb7				   .LaserContact
   3862  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   3863  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
   3864  ffbc							; (b0 was 0: travel only runs with b0 clear,
   3865  ffbc							; rearm dec'd it before this init) — flush
