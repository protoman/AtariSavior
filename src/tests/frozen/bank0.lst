   2168  f60e							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2169  f60e							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2170  f60e							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2171  f60e							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2172  f60e							; ------------------------------------------------------------------------------
   2173  f60e				   UEDispatch
   2174  f60e		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2175  f610							;   the single type-compare entry. 2026-10-22:
   2176  f610							;   a raft authored dir=right read $87, missed
   2177  f610							;   `cmp #ENEMY_RAFT` and its body never ran
   2178  f610							;   (no tide, no motion, no rider pin).
   2179  f610		       c9 07		      cmp	#ENEMY_RAFT
   2180  f612		       d0 06		      bne	.UEDNotRaft
