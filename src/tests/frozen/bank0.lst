   1217  f274		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1218  f276				   .FRActive
   1219  f276		       a5 94		      lda	vyHi
   1220  f278		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1221  f27a		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1222  f27c		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1223  f27e		       85 94		      sta	vyHi
   1224  f280		       4c c0 f2 	      jmp	.Integrate
