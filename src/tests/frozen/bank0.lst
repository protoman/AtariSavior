   2165  f5f9							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2166  f5f9							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2167  f5f9							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2168  f5f9							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2169  f5f9							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2170  f5f9							; this region is upstream of the pin, so it costs nothing at $FC67.
   2171  f5f9							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2172  f5f9							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2173  f5f9							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2174  f5f9							; and normal deaths, resets on game-over reload.
   2175  f5f9							; ------------------------------------------------------------------------------
   2176  f5f9				   CEH_Key
   2177  f5f9		       a5 ba		      lda	EnemyDeadMask
   2178  f5fb		       1d c9 f3 	      ora	EnemyBitTable,X
   2179  f5fe		       85 ba		      sta	EnemyDeadMask
   2180  f600		       a5 a7		      lda	LevelStartRoom
   2181  f602		       09 80		      ora	#$80	; KeyHeld = b7
   2182  f604		       85 a7		      sta	LevelStartRoom
   2183  f606		       a9 09		      lda	#9	; pickup blip (pitch 9)
   2184  f608		       4c 3c fc 	      jmp	PickupSnd
