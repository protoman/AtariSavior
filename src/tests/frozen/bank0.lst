   2304  f7bb		       d0 39		      bne	.BTDone
   2305  f7bd		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2306  f7bf		       29 fc		      and	#%11111100
   2307  f7c1		       85 b5		      sta	BombPacked
   2308  f7c3		       a9 00		      lda	#0
   2309  f7c5		       85 f7		      sta	BombTimer
