   1084  f144		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
   1085  f146		       c5 9d		      cmp	ObjHeight	; per-type window (all 16 today). COST: a ZP
