   3427  fda8							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   3428  fda8							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   3429  fda8							;   ranges before the walk; bank2 display-space walkers mirror first too).
   3430  fda8							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   3431  fda8							;   that col (0/3/6 = PF0/PF1/PF2 row byte). ColMask: the col's bit in that
   3432  fda8							;   byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2 LSB-first
   3433  fda8							;   (12-19); matches convert_room.pf_values (plan 0.2 spec, proven by
   3434  fda8							;   tools/test_cell_map.py).
   3435  fda8							;   (The standalone CellSolid leaf that lived here moved INTO
   3436  fda8							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   3437  fda8							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   3438  fda8							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   3439  fda8							; ------------------------------------------------------------------------------
   3440  fda8		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 3,3,3,3,3,3,3,3, 6,6,6,6,6,6,6,6
   3441  fdbc		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   3442  fdc8		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
