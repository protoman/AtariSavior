   2166  f636							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2167  f636							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2168  f636							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2169  f636							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2170  f636							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2171  f636							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2172  f636							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2173  f636							; ==============================================================================
   2174  f636				   SelectActiveObject
   2175  f636							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2176  f636							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2177  f636							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2178  f636							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2179  f636							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2180  f636							; middle of the screen" the moment the points counting started).
   2181  f636		       a5 8a		      lda	DropTarget
   2182  f638		       c9 fe		      cmp	#$FE
   2183  f63a		       d0 2d		      bne	.SOFull
   2184  f63c		       a9 00		      lda	#0
   2185  f63e		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2186  f640		       a9 ff		      lda	#$FF
   2187  f642		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2188  f644							;   `0 = no object` comment was wrong and the
   2189  f644							;   tally-without-miner frame staged ObjTop from
   2190  f644							;   a stale Y, i.e. a stray key sprite)
   2191  f644		       a5 a4		      lda	LevelMinerRoom
   2192  f646		       29 7f		      and	#$7f
   2193  f648		       c5 98		      cmp	RoomNo
   2194  f64a		       f0 03		      beq	.SOTallyMiner
   2195  f64c		       4c 49 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2196  f64f				   .SOTallyMiner
   2197  f64f		       a9 55		      lda	#OBJ_MINER
   2198  f651		       85 b6		      sta	ObjBase
   2199  f653		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2200  f655		       85 9d		      sta	ObjHeight
   2201  f657		       a5 a5		      lda	MinerX
   2202  f659		       85 b7		      sta	ActiveObjectX
   2203  f65b		       a5 a6		      lda	MinerY
   2204  f65d		       18		      clc
