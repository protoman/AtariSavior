   3956  ff00							; ==============================================================================
   3957  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   3958  ff00							; ==============================================================================
   3959  ff00					      org	$FF00
   3960  ff00				   fineAdjustBegin
   3961  ff00		       70		      .byte.b	%01110000	; left 7
   3962  ff01		       60		      .byte.b	%01100000	; left 6
   3963  ff02		       50		      .byte.b	%01010000	; left 5
   3964  ff03		       40		      .byte.b	%01000000	; left 4
   3965  ff04		       30		      .byte.b	%00110000	; left 3
   3966  ff05		       20		      .byte.b	%00100000	; left 2
   3967  ff06		       10		      .byte.b	%00010000	; left 1
   3968  ff07		       00		      .byte.b	%00000000	; no movement
   3969  ff08		       f0		      .byte.b	%11110000	; right 1
   3970  ff09		       e0		      .byte.b	%11100000	; right 2
   3971  ff0a		       d0		      .byte.b	%11010000	; right 3
   3972  ff0b		       c0		      .byte.b	%11000000	; right 4
   3973  ff0c		       b0		      .byte.b	%10110000	; right 5
   3974  ff0d		       a0		      .byte.b	%10100000	; right 6
   3975  ff0e		       90		      .byte.b	%10010000	; right 7
   3976  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   3977  ff0f
   3978  ff0f							; ==============================================================================
   3979  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3980  ff0f							; ==============================================================================
   3981  ff0f							; Andrew Davie session-24 routine:
   3982  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3983  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3984  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3985  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3986  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3987  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3988  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3989  ff0f							;
   3990  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3991  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3992  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3993  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3994  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3995  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3996  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3997  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3998  ff0f				   SetObjectXPos subroutine
   3999  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4000  ff11		       38		      sec		; ensure carry flag
   4001  ff12				   .Div15Loop
   4002  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4003  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4004  ff16		       a8		      tay		; Y = remainder in -15..-1
   4005  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4006  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4007  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4008  ff1e		       60		      rts
   4009  ff1f
   4010  ff20					      org	$FF20
   4011  ff20
   4012  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   4013  ff20				   SetObjReflection
   4014  ff20		       a9 00		      lda	#0
   4015  ff22		       85 0c		      sta	REFP1
   4016  ff24		       a5 b6		      lda	ObjBase
   4017  ff26		       c9 70		      cmp	#OBJ_MINER
   4018  ff28		       d0 08		      bne	.SORdone
   4019  ff2a		       a5 a4		      lda	LevelMinerRoom
   4020  ff2c		       10 04		      bpl	.SORdone
   4021  ff2e		       a9 08		      lda	#$08
   4022  ff30		       85 0c		      sta	REFP1
   4023  ff32				   .SORdone
   4024  ff32		       60		      rts
   4025  ff33
   4026  ff33							; ------------------------------------------------------------------------------
   4027  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4028  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4029  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   4030  ff33							; user spec: no piercing, no HERO comparison needed).
   4031  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4032  ff33							;						  left	RoomX-4)
   4033  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4034  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   4035  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4036  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4037  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4038  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4039  ff33							;     priority over M0 anyway).
   4040  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4041  ff33							;     press edge re-anchors).
   4042  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4043  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4044  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4045  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4046  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4047  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4048  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4049  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4050  ff33							; ------------------------------------------------------------------------------
   4051  ff33				   LaserInput
   4052  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4053  ff35		       8a		      txa
   4054  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4055  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4056  ff3a		       8a		      txa
   4057  ff3b		       29 80		      and	#LASER_HELD
   4058  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4059  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4060  ff40		       85 c0		      sta	LaserState
   4061  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4062  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4063  ff46							; below — moved here so the cap code could
   4064  ff46							; not push .LaserReleased past bmi's ±127)
   4065  ff46				   .LaserReleased
   4066  ff46		       a9 00		      lda	#0
   4067  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4068  ff4a							; otherwise -> bars slid across screen
   4069  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   4070  ff4b				   .LaserFire
   4071  ff4b		       a5 c0		      lda	LaserState
   4072  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4073  ff4f		       85 c0		      sta	LaserState
   4074  ff51		       8a		      txa
   4075  ff52		       29 80		      and	#LASER_HELD
   4076  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4077  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4078  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4079  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   4080  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   4081  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   4082  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   4083  ff56		       a5 c0		      lda	LaserState
   4084  ff58		       29 01		      and	#LASER_REARM
   4085  ff5a		       f0 04		      beq	.LAdvStep
