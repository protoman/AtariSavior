    872  f0e7							; Same c51 slot the old no-door path used
    873  f0e7							; (AFTER the left half, same rule as COLUPF)
    874  f0e7		       a5 8d		      lda	CollisionCellY	; P2b door color staged by the VBL:
    875  f0e9							; $80 = no door / $1C = yellow stripe
    876  f0e9		       30 04		      bmi	.M1done	; no door: COLUP1/Temp already hold the band
    877  f0eb							;   colour, nothing left to do
