   1843  f5a5		       85 f0		      sta	PlayerBombs
   1844  f5a7		       a5 8a		      lda	DropTarget	; #18: arm the LV001 banner except on the boot
   1845  f5a9		       c9 fd		      cmp	#$FD	; intro call ($FD = attract pending — TallyTicks
   1846  f5ab		       f0 04		      beq	.NoBanner	; alias must stay 0 for the intro phase machine)
   1847  f5ad		       a9 f8		      lda	#(LV_SHOW_FRAMES|$80)	; bit7 = banner flag: decs down to $80; any
   1848  f5af		       85 f2		      sta	LevelShowTimer	; tally ARM (<=127) kills it instantly
