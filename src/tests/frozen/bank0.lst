   2149  f5f4							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2150  f5f4							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2151  f5f4							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2152  f5f4							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2153  f5f4							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2154  f5f4							; this region is upstream of the pin, so it costs nothing at $FC67.
   2155  f5f4							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2156  f5f4							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2157  f5f4							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2158  f5f4							; and normal deaths, resets on game-over reload.
   2159  f5f4							; ------------------------------------------------------------------------------
   2160  f5f4				   CEH_Key
   2161  f5f4		       a5 ba		      lda	EnemyDeadMask
   2162  f5f6		       1d c9 f3 	      ora	EnemyBitTable,X
   2163  f5f9		       85 ba		      sta	EnemyDeadMask
   2164  f5fb		       a5 a7		      lda	LevelStartRoom
   2165  f5fd		       09 80		      ora	#$80	; KeyHeld = b7
   2166  f5ff		       85 a7		      sta	LevelStartRoom
