   1189  f239				   .JetDecay		; Up NOT held this frame
   1190  f239		       a5 96		      lda	JetPower
   1191  f23b		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1192  f23d		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1193  f23f		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1194  f241		       05 93		      ora	vyLo
   1195  f243		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1196  f245							;   climb to stop, do NOT float
   1197  f245		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1198  f247		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1199  f249		       4c 65 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1200  f24c				   .FloatRun
   1201  f24c		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1202  f24e		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1203  f250		       29 7f		      and	#$7F
   1204  f252		       d0 04		      bne	.FRActive
