   3981  fd24							; ------------------------------------------------------------------------------
   3982  fd24							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3983  fd24							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3984  fd24							; selected level number (digits band) and the credits; the theme plays here.
   3985  fd24							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3986  fd24							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3987  fd24							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3988  fd24							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3989  fd24							;	    the intro exit ate the first press and made #2 read as dead)
   3990  fd24							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3991  fd24							;	    the real drop-in → gameplay starts
   3992  fd24							; ($FD reaches here directly — merged title, 2026-10-19.)
   3993  fd24							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3994  fd24							; title-owned; the first play frame rewrites it as the step budget).
   3995  fd24							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3996  fd24							; ------------------------------------------------------------------------------
   3997  fd24				   TitleWork
   3998  fd24		       a9 04		      lda	#4
   3999  fd26		       20 08 fc 	      jsr	CallPad_SaveKey	; stage number <-> high score in the HUD score window
   4000  fd29							;   (here DropTarget is still $FF: a RESET below
   4001  fd29							;   zeroes the score; the op does no I2C)
   4002  fd29							; --- SELECT edge (TitleSelect, fill region) ---
   4003  fd29		       20 4f fc 	      jsr	CallPad_TitleSelect
   4004  fd2c		       90 03		      bcc	.TWselDone	; C=0: no edge
   4005  fd2e		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   4006  fd31				   .TWselDone
   4007  fd31							; --- RESET edge ---
   4008  fd31		       a5 97		      lda	StepsLeft
   4009  fd33		       29 01		      and	#%00000001
   4010  fd35		       f0 19		      beq	.TWrstDone
   4011  fd37		       ad 82 02 	      lda	SWCHB
   4012  fd3a		       29 01		      and	#%00000001
   4013  fd3c		       d0 12		      bne	.TWrstDone
   4014  fd3e		       a9 00		      lda	#0
   4015  fd40		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   4016  fd42		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   4017  fd44		       85 f4		      sta	ScoreHu
   4018  fd46		       85 f5		      sta	ScoreTe
   4019  fd48		       a9 01		      lda	#1
   4020  fd4a		       20 08 fc 	      jsr	CallPad_SaveKey	; SaveKey RESUME: on the saved stage, lives +
   4021  fd4d							;   score := the saved ones (before LoadLevel,
   4022  fd4d							;   which rebuilds the buffers the op borrows)
   4023  fd4d		       20 20 fc 	      jsr	LoadLevel
   4024  fd50				   .TWrstDone
   4025  fd50		       ad 82 02 	      lda	SWCHB
   4026  fd53		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   4027  fd55							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   4028  fd55							;     channel force-muted here — UpdateJetSound is skipped because
   4029  fd55							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   4030  fd55							;     = 0, AUDV0 covered above). ---
   4031  fd55				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   4032  fd55		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   4033  fd57		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   4034  fd59		       f0 0e		      beq	.TWmusic
   4035  fd5b		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   4036  fd5d		       20 8e f5 	      jsr	BombTick
   4037  fd60				   .TWnoTick
   4038  fd60		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   4039  fd63		       a9 00		      lda	#0
   4040  fd65		       85 1a		      sta	AUDV1
   4041  fd67		       f0 03		      beq	.TWwait	; A=0 -> always taken
   4042  fd69				   .TWmusic		; title: music wins the audio regs
   4043  fd69		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   4044  fd6c				   .TWwait
   4045  fd6c		       ad 84 02 	      lda	INTIM
   4046  fd6f		       d0 fb		      bne	.TWwait
   4047  fd71		       4c 3a f0 	      jmp	StartFrame
