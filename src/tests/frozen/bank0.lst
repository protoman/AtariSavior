   1525  f406		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1526  f409		       20 f6 fe 	      jsr	FoldIndirect	; type
   1527  f40c		       4c 3c f8 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1528  f40f							; 18 B per-type compare chain with one 3 B jmp:
