   1739  f451		       69 01		      adc	#1	; step right
   1740  f453				   .TentProbe
   1741  f453		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1742  f455		       b0 36		      bcs	.TentOut
   1743  f457		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1744  f459							; Same-column cull: committed X is always probe-clear, so a candidate in
   1745  f459							; the same 4px column covers the same collision cells → result is known
   1746  f459							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1747  f459		       a5 88		      lda	Temp
   1748  f45b		       55 bd		      eor	EnemyRamX,X
   1749  f45d		       29 fc		      and	#$FC
   1750  f45f		       f0 28		      beq	.TentCommit
   1751  f461		       a5 80		      lda	RoomX
