   2181  f5f8							; CEH_Key — type-6 key pickup (docs/feature_tiles_plan.md Phase 5): latch
   2182  f5f8							; KeyHeld ($A7 b7) and mark the key slot dead so it vanishes, with NO life
   2183  f5f8							; loss. X = EnemyIndex (set by CheckEnemyHit's hit path); reached via
   2184  f5f8							; `jmp CEH_Key` from that dispatch. Lives in the $F82C pre-pad pin gap
   2185  f5f8							; (177B slack before the $F8DD sprite pin); pre-pad END headroom is 1B but
   2186  f5f8							; this region is upstream of the pin, so it costs nothing at $FC67.
   2187  f5f8							; KEY is one per level, so KeyHeld is a single bit (no per-key storage).
   2188  f5f8							; LevelStartRoom b7 resets when LoadLevel rewrites $A7 (:1875) before its own
   2189  f5f8							; read at :1922, so no reader mask is needed; KeyHeld survives room changes
   2190  f5f8							; and normal deaths, resets on game-over reload.
   2191  f5f8							; ------------------------------------------------------------------------------
   2192  f5f8				   CEH_Key
   2193  f5f8		       a5 ba		      lda	EnemyDeadMask
   2194  f5fa		       1d c7 f3 	      ora	EnemyBitTable,X
   2195  f5fd		       85 ba		      sta	EnemyDeadMask
   2196  f5ff		       a5 a7		      lda	LevelStartRoom
   2197  f601		       09 80		      ora	#$80	; KeyHeld = b7
   2198  f603		       85 a7		      sta	LevelStartRoom
   2199  f605		       a9 09		      lda	#9	; pickup blip (pitch 9)
   2200  f607		       4c 3c fc 	      jmp	PickupSnd
