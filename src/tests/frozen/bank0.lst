    907  f12d							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
    908  f12d							; ObjTop..ObjTop+7 window → row byte from ObjSprites[ObjBase + offset].
    909  f12d							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
    910  f12d							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
    911  f12d							; (mod 256, exact). In-object iff result 0..7 → `cmp #8/bcs` (C=0 in
    912  f12d							; range → adc adds exact ObjBase). Replaces `lda Scanline/sec/sbc/bcc`
    913  f12d							; (−6c in-range) and the `inc Scanline` (−5c) — Scanline now unused.
    914  f12d		       98		      tya
    915  f12e		       38		      sec
    916  f12f		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
    917  f131		       c9 08		      cmp	#PLAYER_HEIGHT
    918  f133		       b0 55		      bcs	.ObjZero	; above (negative mod ≥65) or at/below bottom
    919  f135		       65 b6		      adc	ObjBase
