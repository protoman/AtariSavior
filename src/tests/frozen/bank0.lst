   3665  fd32							; ------------------------------------------------------------------------------
   3666  fd32							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3667  fd32							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3668  fd32							; selected level number (digits band) and the credits; the theme plays here.
   3669  fd32							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3670  fd32							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3671  fd32							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3672  fd32							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3673  fd32							;	    the intro exit ate the first press and made #2 read as dead)
   3674  fd32							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3675  fd32							;	    the real drop-in → gameplay starts
   3676  fd32							; ($FD reaches here directly — merged title, 2026-10-19.)
   3677  fd32							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3678  fd32							; title-owned; the first play frame rewrites it as the step budget).
   3679  fd32							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3680  fd32							; ------------------------------------------------------------------------------
   3681  fd32				   TitleWork
   3682  fd32							; --- SELECT edge (TitleSelect, fill region) ---
   3683  fd32		       20 4f fc 	      jsr	CallPad_TitleSelect
   3684  fd35		       90 03		      bcc	.TWselDone	; C=0: no edge
   3685  fd37		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3686  fd3a				   .TWselDone
   3687  fd3a							; --- RESET edge ---
   3688  fd3a		       a5 97		      lda	StepsLeft
   3689  fd3c		       29 01		      and	#%00000001
   3690  fd3e		       f0 14		      beq	.TWrstDone
   3691  fd40		       ad 82 02 	      lda	SWCHB
   3692  fd43		       29 01		      and	#%00000001
   3693  fd45		       d0 0d		      bne	.TWrstDone
   3694  fd47		       a9 00		      lda	#0
   3695  fd49		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3696  fd4b		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3697  fd4d		       85 f4		      sta	ScoreHu
   3698  fd4f		       85 f5		      sta	ScoreTe
   3699  fd51		       20 20 fc 	      jsr	LoadLevel
   3700  fd54				   .TWrstDone
   3701  fd54		       ad 82 02 	      lda	SWCHB
   3702  fd57		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3703  fd59							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3704  fd59							;     channel force-muted here — UpdateJetSound is skipped because
   3705  fd59							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3706  fd59							;     = 0, AUDV0 covered above). ---
   3707  fd59				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3708  fd59		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3709  fd5b		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3710  fd5d		       f0 0e		      beq	.TWmusic
