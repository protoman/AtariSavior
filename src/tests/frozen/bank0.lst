   3667  fedb							; BeamMask — per-scanline ENAM0 values for the in-window kernel path (S2.2).
   3668  fedb							; Indexed by Y = A0 = Scanline - RoomY, rows 0-11 only.
   3669  fedb							; Rows 2-3 = $02 (beam on: RoomY+2..RoomY+3 = eye rows — yellow face row 2 +
   3670  fedb							; red row 3 = two-tone beam; kept per user decision: single-red rows could
   3671  fedb							; not also reach floor-standing enemies without kill-window churn); rest $00.
   3672  fedb							; 2026-10-08 user directive: ONE strip, yellow — row 2 only ($02 at index 2),
   3673  fedb							; row 3 dropped. Kill window in LaserHitTestBody stays rows RoomY+2..3 = a
   3674  fedb							; superset of the 1-line draw (floor-standing reach preserved).
   3675  fedb							; Lives in the $FExx page: `lda BeamMask,Y` from .Line ($F1xx) fetches in
   3676  fedb							; 4c when operand+11 stays in-page (1c reclaim toward the ObjColorTab
   3677  fedb							; write; verify_build asserts the no-cross operand range).
   3678  fedb							; ------------------------------------------------------------------------------
   3679  fedb				   BeamMask
   3680  fedb		       00 00 02 00*	      .byte.b	0,0,2,0,0,0,0,0,0,0,0,0
   3681  fee7
   3682  fee7
   3683  fee7					      .ds	$FEE7 - *, 0	; bank0↔bank1 CallPad (leaf_move_plan Step 0)
   3684  fee7				   CallPad_MothYDerive
   3685  fee7		       8d f7 1f 	      sta	$1FF7
   3686  feea		       4c 38 f0 	      jmp	$F038
   3687  feed
   3688  feed		       00 00 00 	      .ds	$FEF0 - *, 0	; fill tramp..moth gap (drift-proof)
   3689  fef0				   UE_MothTramp
