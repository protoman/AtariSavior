   3802  ff81		       a5 80		      lda	RoomX
   3803  ff83		       38		      sec
   3804  ff84		       e9 14		      sbc	#20
   3805  ff86		       b0 02		      bcs	.LAdvCapLs
   3806  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   3807  ff8a				   .LAdvCapLs
