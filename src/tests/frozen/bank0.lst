   1151  f21a							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1152  f21a							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1153  f21a							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1154  f21a							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1155  f21a							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1156  f21a							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1157  f21a							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1158  f21a							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1159  f21a							;	   1.0s hover was too long — halved); then the flag clears and
   1160  f21a							;	   normal gravity resumes (fall ~0.85s after release). State
   1161  f21a							;	   lives in JetPower, NOT
   1162  f21a							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1163  f21a							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1164  f21a							;	   rising frame — both clobbered a StepsLeft-based float.
   1165  f21a							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1166  f21a							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1167  f21a							;	   (headroom stays $FC67).
   1168  f21a							; ------------------------------------------------------------------------------
   1169  f21a		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1170  f21c		       24 88		      bit	Temp
   1171  f21e		       d0 21		      bne	.JetDecay
   1172  f220		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1173  f222		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1174  f224		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1175  f226		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1176  f228				   .RampStart
   1177  f228		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1178  f22a		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1179  f22c		       d0 3f		      bne	.Gravity
   1180  f22e		       a5 96		      lda	JetPower
   1181  f230		       c9 14		      cmp	#JET_MAX
   1182  f232		       b0 06		      bcs	.JetCapped
   1183  f234		       18		      clc
   1184  f235		       69 01		      adc	#1
   1185  f237		       4c 3c f2 	      jmp	.JetSet
   1186  f23a				   .JetCapped
   1187  f23a		       a9 14		      lda	#JET_MAX
