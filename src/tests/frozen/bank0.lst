   1741  f455		       b0 36		      bcs	.TentOut
   1742  f457		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1743  f459							; Same-column cull: committed X is always probe-clear, so a candidate in
   1744  f459							; the same 4px column covers the same collision cells → result is known
   1745  f459							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1746  f459		       a5 88		      lda	Temp
