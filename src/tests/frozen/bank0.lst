   3259  fd55				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3260  fd55		       a5 8a		      lda	DropTarget	; merged title ($FD): music owns AUD0/AUD1,
   3261  fd57		       c9 fd		      cmp	#$FD	;   no bomb fuse/tick on title frames
   3262  fd59		       f0 0e		      beq	.TWmusic
