    215 U00bc							; Score ZP variables (shared with bank1 HUD — addresses MUST match bank1)
    216 U00bc							; $F3-$F5 live score only — $F6 is BombX (bank1 ScoreOn is unused).
    217 U00bc		       00 f3	   ScoreTh    =	$F3	; score thousands digit (0-9)
    218 U00bc		       00 f4	   ScoreHu    =	$F4	; score hundreds digit (0-9)
    219 U00bc		       00 f5	   ScoreTe    =	$F5	; score tens digit (0-9)
    220 U00bc							; PF0ScoreBuf/PF1ScoreBuf removed (S3.0): dead legacy EQUs — the 48px
    221 U00bc							; sprite score never used PF score buffers (decl-only, zero references).
    222 U00bc
    223 U00bc							; P3.4 rect cache — solid rect list copied once per EnterRoom, walked directly
    224 U00bc							; by PlayerHitsMap with NO bank2 fold (fold mid-function switched the EXECUTION
    225 U00bc							; bank; only byte-identical pad code may span a switch). Layout (S3.2 —
    226 U00bc							; UNIFORM STRIDE: all 5 rects contiguous, no windows, no .Stage3):
    227 U00bc							;   $89       count	    (RcBase — sequential decl; MUST stay outside
    228 U00bc							;			     bank1's $E0-$EF stomp zone: the first attempt
    229 U00bc							;			     had count/rect4.h inside it and scorePtr writes
    230 U00bc							;			     zeroed rect4.h every HUD frame → probes passed
    231 U00bc							;			     through rect4 walls = tentacle walked inside
    232 U00bc							;			     walls. Keep ALL persistent cache bytes < $E0.)
    233 U00bc							;   $CC-$DF  rect0..rect4 (walk: FetchPtr base RcW1=$CC, Y=0..19, stride 4;
    234 U00bc							;			    mask index = Y>>2, table has a $00 entry for
    235 U00bc							;			    index 4 = rect4 never masked)
    236 U00bc							; rect4 x,y,w,h live IN the cache ($DC-$DF) since S3.2 — the old split
    237 U00bc							; slots are gone (DropTarget $8A keeps the allocation byte), Rc4W retired.
    238 U00bc							; Buffers packed: PF0 $C3-$C5, PF1 $C6-$C8, PF2 $C9-$CB (rows 0-2 only).
    239 U00bc							; ($E0/$E1 are spare/stomp-zone — never persistent bank0 state.)
    240 U00bc		       00 cc	   RcW1       =	$CC	; walk FetchPtr base (rect0 x at Y=0; Y→$DF)
    241 U00bc							; Rc4W/Rc4H retired (S3.2): rect4.w/h = cache bytes $DE/$DF, reached by
    242 U00bc							; the uniform stride like every other field. RcBase is the $89 decl above.
    243 U00bc
    244 U00bc							; PF cave buffers (copied from ROM during VBLANK, read by kernel via absolute indexed)
    245 U00bc							; These share ZP space with bank1's HUD variables — safe because bank1
    246 U00bc							; runs AFTER the cave kernel. Bank1 overwrites them during HUD band;
    247 U00bc							; VBLANK re-populates them before the next kernel frame.
    248 U00bc		       00 c3	   PF0Buf     =	$C3	; 3 bytes: TilePF0 rows 0-2 (stride-3 data S4.2)
    249 U00bc							; (rows 0-2 pure since S3.4 — Y moved to $E2)
    250 U00bc		       00 c6	   PF1Buf     =	$C6	; rows 0-2 only (S3.1 packed; was $CF)
    251 U00bc		       00 bc	   RoomBandColor =	$BC	; band-color cache (level_bank_plan P2.5) —
    252 U00bc							; own byte since S3.1 (was $D2 = PF1Buf[3];
    253 U00bc							; history: FIX 2026-09-28 was $D1 = PF1Buf[2]
    254 U00bc							; collision → mid-wall gap; alias class now
    255 U00bc							; gone entirely). Writer: VBLANK stage AFTER
    256 U00bc							; LoadPFBuffer/BuildColupF (fold from
    257 U00bc							; LevelEnemy+RoomNo*4+3). Readers: kernel
    258 U00bc							; .WaterRow (direct lda, plain abs = 4c any
    259 U00bc							; address) + overscan CheckBandTouch. Window:
    260 U00bc							; VBL write → kernel + overscan read same
    261 U00bc							; frame ($BC is nobody else's byte) → next
    262 U00bc							; VBL restages.
    263 U00bc		       00 c9	   PF2Buf     =	$C9	; rows 0-2 only (S3.1 packed; was $DB-$E6)
    264 U00bc		       00 e7	   ColupfBuf  =	$E7	; 12 bytes: final COLUPF per tile row (stripe+hot)
    265 U00bc		       00 e5	   FetchPtr   =	$E5	; fold-indirect pointer ($E5 lo, $E6 hi) —
    266 U00bc							; MOVED S3.2 to free $E0 for rect4.h (cache
    267 U00bc							; $CD-$E0 now uniform). Sits in bank1's
    268 U00bc							; stomp zone (scorePtr3-hi/scorePtr4-lo) —
    269 U00bc							; time-partitioned: bank0 stages only inside
    270 U00bc							; VBL/overscan batches, bank1 rebuilds in
    271 U00bc							; HUD after both windows. Contract (fold
    272 U00bc							; wins): stage addr immediately before a
    273 U00bc							; FoldIndirect batch.
    274 U00bc		       00 ed	   BandTab    =	$ED	; Phase 3 asym ball: staged Band0/1/2
    275 U00bc							; ($ff = ball band, $00 = mirror). Written
    276 U00bc							; by bank2 StageBandTab (BuildColupF tail,
    277 U00bc							; every VBL) BEFORE this frame's cave; read
    278 U00bc							; by .Row's ENABL gate; bank1 HUD stomps
    279 U00bc							; $ED-$EF (scbrdTmp etc.) only AFTER the
    280 U00bc							; cave read — staged-only window, like
    281 U00bc							; FetchPtr. Next VBL restages.
    282 U00bc							; Enemy RAM shadow — live X/Y + packed flags. ROM records are read-only.
    283 U00bc							; Sequential vars end at $BB (ObjBot removed S3.0b); $BC = RoomBandColor,
    284 U00bc							; $BD-$BF EnemyRam, $C0 LaserState, $C1-$C2 EnemyRamD/P.
    285 U00bc							; Score lives at $F3-$F5 only ($F6/$F7 = BombX/BombTimer).
    286 U00bc							; EnemyRamY ($E2, 3B) — private bytes since S3.4 (was an alias over
    287 U00bc							; PF0Buf rows 0-2). It deliberately sits INSIDE bank1's HUD stomp zone
    288 U00bc							; ($E0-$EF score ptrs, written every frame) because every write and every
    289 U00bc							; read land inside one safe window:
    290 U00bc							;   [HUD stomp $E2-$E4] → [overscan: RefreshEnemyY/LoadEnemyRam WRITE]
    291 U00bc							;   → [CEH / Laser / moth READ] → [next VBL: SelectActiveObject READ]
    292 U00bc							;   → [HUD stomp ...]. No reader ever sits between the stomp and the write.
    293 U00bc							;   writers: RefreshEnemyY via DeriveEnemyY (overscan entry, EVERY frame —
    294 U00bc							;	      live Y is derived from ROM spawn + EnemyRamP clock, no stored
    295 U00bc							;	      movement state) + LoadEnemyRam (EnterRoom init);
    296 U00bc							;   readers: SelectActiveObject (VBLANK), CheckEnemyHit + LaserHitTest +
    297 U00bc							;	      moth walk (overscan, after the refresh).
    298 U00bc							; Effect: $C3-$C5 = pure PF0Buf rows 0-2, never stomped → the per-frame
    299 U00bc							;   VBL repair (LoadPF0Only, ~130c + 3 folds) is deleted; full
    300 U00bc							;   LoadPFBuffer runs only on EnterRoom (PF1/PF2 rows 0-2 likewise have
    301 U00bc							;   no per-frame writer). bank1 owns $E0-$EF during HUD; bank0 never keeps
    302 U00bc							;   other persistent state there (FetchPtr $E0/$E1 = staged only).
    303 U00bc		       00 bd	   EnemyRamX  =	$BD	; 3 bytes: live X per enemy ($BD-$BF, slots 0-2
    304 U00bc							; only — enemies+lamps capped at 3 by editor
    305 U00bc							; kMaxRoomElements, convert_level MAX_ENEMIES,
    306 U00bc							; verify_build; slot 3 would collide with $C0)
    307 U00bc		       00 c0	   LaserState =	$C0	; laser: b7 fire held this frame,
    308 U00bc							;   b6 fire held last frame (press-edge),
    309 U00bc							;   b5-2 RoomDarkMask rooms 4-7,
    310 U00bc							;   b1 beam gate for the kernel .Line
    311 U00bc							;     (BeamMask = $02 shares b1; mirror of b7)
    312 U00bc		       00 c1	   EnemyRamD  =	$C1	; dir bits 0-3 = enemy 0-3 (1=right, 0=left)
    313 U00bc		       00 c2	   EnemyRamP  =	$C2	; bits0-3 moth phase (shared/sync); bits4-7
    314 U00bc							;   vdir for spider/bat/tentacle (1=down)
