    313 U00bc							; Constants
    314 U00bc							; ==============================================================================
    315 U00bc		       00 08	   PLAYER_HEIGHT =	8	; GRP1 object (enemy/miner) height; player uses PLAYER_SPRITE_H
    316 U00bc		       00 0c	   PLAYER_SPRITE_H =	12	; player sprite height in scanlines (8x12)
    317 U00bc		       00 07	   PLAYER_WIDTH =	7	; lit player sprite spans 7 pixels; REFP0 shift handled
    318 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    319 U00bc		       00 04	   LAMP_WIDTH =	4	; OBJ_LAMP uses GRP1's leftmost 4 lit pixels
    320 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER spans 4 lit GRP1 pixels
    321 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
    322 U00bc							; 2026-10-19): the patrol is SYMMETRIC about the
    323 U00bc							; placed X, so the snake retreats a tile behind
    324 U00bc							; its placement and then comes out a tile — 2
    325 U00bc							; tiles of travel total. The editor cannot ask
    326 U00bc							; the user to place it 2 tiles from the border.
    327 U00bc		       00 14	   TILE_COLUMNS =	20	; columns per half (reflected playfield)
    328 U00bc		       00 03	   TILE_ROWS  =	3	; number of playable color bands
    329 U00bc		       00 30	   LINES_PER_TILE =	48	; scanlines per tile row
    330 U00bc		       00 01	   HUD_ROWS   =	1	; HUD band (48 scanlines)
    331 U00bc		       00 90	   CAVE_LINES =	144	; TILE_ROWS × LINES_PER_TILE
    332 U00bc		       00 c0	   VISIBLE_LINES =	192	; CAVE_LINES + (HUD_ROWS × LINES_PER_TILE)
    333 U00bc
