   2235  f62e							; ==============================================================================
   2236  f62e							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2237  f62e							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2238  f62e							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2239  f62e							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2240  f62e							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2241  f62e							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2242  f62e							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2243  f62e							; ==============================================================================
   2244  f62e				   SelectActiveObject
   2245  f62e							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2246  f62e							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2247  f62e							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2248  f62e							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2249  f62e							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2250  f62e							; middle of the screen" the moment the points counting started).
   2251  f62e		       a5 8a		      lda	DropTarget
   2252  f630		       c9 fe		      cmp	#$FE
   2253  f632		       d0 2d		      bne	.SOFull
   2254  f634		       a9 00		      lda	#0
   2255  f636		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2256  f638		       a9 ff		      lda	#$FF
   2257  f63a		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2258  f63c							;   `0 = no object` comment was wrong and the
   2259  f63c							;   tally-without-miner frame staged ObjTop from
   2260  f63c							;   a stale Y, i.e. a stray key sprite)
   2261  f63c		       a5 a4		      lda	LevelMinerRoom
   2262  f63e		       29 7f		      and	#$7f
   2263  f640		       c5 98		      cmp	RoomNo
   2264  f642		       f0 03		      beq	.SOTallyMiner
   2265  f644		       4c 3d f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2266  f647				   .SOTallyMiner
   2267  f647		       a9 55		      lda	#OBJ_MINER
   2268  f649		       85 b6		      sta	ObjBase
   2269  f64b		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2270  f64d		       85 9d		      sta	ObjHeight
   2271  f64f		       a5 a5		      lda	MinerX
   2272  f651		       85 b7		      sta	ActiveObjectX
   2273  f653		       a5 a6		      lda	MinerY
   2274  f655		       18		      clc
   2275  f656		       69 03		      adc	#3	; same 3px offset as the normal miner path
   2276  f658		       85 b8		      sta	ActiveObjectY
