   3202  fcf8		       85 f5		      sta	ScoreTe	; ones digit (LEVEL_COUNT ≤ 9 — ≥10 needs
   3203  fcfa		       a9 00		      lda	#0	;  a packed-BCD tens digit here)
   3204  fcfc		       85 f3		      sta	ScoreTh
   3205  fcfe		       85 f4		      sta	ScoreHu
