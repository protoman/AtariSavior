   1401  f35d							; StepDown: try one pixel of downward movement (called per pixel of vy).
   1402  f35d							; A pixel is rejected when the footprint enters a solid tile (player lands
   1403  f35d							; and vy is zeroed). At PLAYER_MAX_Y the room's down connection is followed.
   1404  f35d							; Sets BombPacked b7 (OnGround) on land / floor; clears when free-falling.
   1405  f35d							; ------------------------------------------------------------------------------
   1406  f35d				   StepDown   subroutine
   1407  f35d		       a5 81		      lda	RoomY
   1408  f35f		       c9 84		      cmp	#PLAYER_MAX_Y
   1409  f361		       b0 1d		      bcs	.SDBottom
   1410  f363		       e6 81		      inc	RoomY
   1411  f365		       20 26 f9 	      jsr	PlayerHitsMap
   1412  f368		       90 0f		      bcc	.SDAir
   1413  f36a		       c6 81		      dec	RoomY
   1414  f36c		       a9 00		      lda	#0
   1415  f36e		       85 93		      sta	vyLo
   1416  f370		       85 94		      sta	vyHi
   1417  f372		       a5 b5		      lda	BombPacked
   1418  f374		       09 80		      ora	#%10000000	; landed — OnGround
   1419  f376		       85 b5		      sta	BombPacked
   1420  f378		       60		      rts
   1421  f379				   .SDAir
   1422  f379		       a5 b5		      lda	BombPacked
   1423  f37b		       29 7f		      and	#%01111111	; still falling — not ground
   1424  f37d		       85 b5		      sta	BombPacked
   1425  f37f		       60		      rts
   1426  f380				   .SDBottom
   1427  f380		       20 d9 fb 	      jsr	ExitRoomDown
   1428  f383		       a5 81		      lda	RoomY
   1429  f385		       c9 84		      cmp	#PLAYER_MAX_Y
   1430  f387		       d0 0c		      bne	.SDDone	; changed room (EnterRoom cleared b7)
   1431  f389		       a5 b5		      lda	BombPacked
   1432  f38b		       09 80		      ora	#%10000000	; no down exit — standing on floor
   1433  f38d		       85 b5		      sta	BombPacked
   1434  f38f		       a9 00		      lda	#0
   1435  f391		       85 93		      sta	vyLo
   1436  f393		       85 94		      sta	vyHi
