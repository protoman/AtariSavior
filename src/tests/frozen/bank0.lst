   2866  f945							; --- Cell walk (cell_collision_plan 2.1): test the PF buffers directly ---
   2867  f945							; The ZP rect cache ($CC-$DF, 5-slot limit) is gone from THIS walker: the
   2868  f945							; render buffers PF0/1/2Buf ARE the map (BombMarkWalls punches bomb holes
   2869  f945							; into them), so room complexity is unbounded and geometry parity is proven
   2870  f945							; by tools/test_cell_map.py (box vs geometry, all models/rooms).
   2871  f945							; Prologue ranges (all left-half space): CollisionCellY = top row,
   2872  f945							; CollisionEndY = bottom row, CollisionEndX = min col, CollisionCellX = max
   2873  f945							; col — cols are endpoint-mirrored above, so ALWAYS 0-19 here (no in-loop
   2874  f945							; mirror; bank2 display-space walkers add their own when they convert).
   2875  f945							; RectCount = running row, CollisionX = running col (both were walk temps
   2876  f945							; before — same ZP, no new allocation).
   2877  f945							; Exits: HIT -> jmp HotOverlapFlag (tail, C=1 contract preserved);
   2878  f945							;	  miss -> clc / rts. Stack depth during the walk = old walk exactly
   2879  f945							;	  (no jsr added — sim_bomb_fuse gameplay min-SP guard stays $F8).
   2880  f945		       a5 8d		      lda	CollisionCellY
   2881  f947		       85 92		      sta	RectCount
   2882  f949				   .CWRow
