   3274  fce5							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3275  fce5							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3276  fce5		       a9 00		      lda	#0
   3277  fce7		       85 b3		      sta	EnemyCount
   3278  fce9		       a9 ff		      lda	#$FF
   3279  fceb		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3280  fced							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3281  fced							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3282  fced							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3283  fced							; preview still renders dark.
