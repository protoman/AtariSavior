   2690  f81e		       3d ca f3 	      and	EnemyBitTable,X
   2691  f821		       d0 05		      bne	.SOSkipNone	; partner dead too
   2692  f823		       86 b9		      stx	EnemyIndex
   2693  f825		       4c f6 f6 	      jmp	.SOEnemyLive
