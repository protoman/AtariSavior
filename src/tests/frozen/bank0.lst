   1726  f43e		       29 01		      and	#1	; ÷2 gate: 1 px / 2 frames = 0.5 px/frame
   1727  f440							; = half the player's 1 px/frame (user
   1728  f440							; 2026-10-10: &3 read as chunky/slow)
