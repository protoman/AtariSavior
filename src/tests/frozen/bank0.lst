   1753  f465		       a5 81		      lda	RoomY	; the 3-pha path hit min SP $F4 → bomb stomp)
   1754  f467		       85 b8		      sta	ActiveObjectY
   1755  f469		       a5 88		      lda	Temp
   1756  f46b		       c9 05		      cmp	#5
   1757  f46d		       90 03		      bcc	.TentProbeX	; cand<=4: offset would push RoomX to <=3 —
   1758  f46f							; PHM's negative visible-left wraps to 255
   1759  f46f							; (col garbage / ColOff OOB walk). cand<=4
   1760  f46f							; ink pokes off-screen anyway; RoomX=cand
   1761  f46f							; already covers cell0.
