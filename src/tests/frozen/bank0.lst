    405 U00bc							; Jetpack physics constants (HERO-style)
    406 U00bc		       00 08	   GRAVITY    =	$0008	; gravity per frame (signed 16-bit, + = down)
    407 U00bc		       00 30	   JET_MAX    =	$30	; max jet thrust accumulator = 48 (was $20).
    408 U00bc							; Net climb accel = JET_MAX - GRAVITY = 40/frame^2,
    409 U00bc							; capped by the -$0100 rise clamp. From rest the
    410 U00bc							; ramp (+1/frame) clears gravity at ~9 frames, so
    411 U00bc							; take-off still eases in (~0.15 s); from a
    412 U00bc							; terminal 1.5 px/frame fall a held jet applies
    413 U00bc							; JET_MAX immediately and stops it in ~10 frames
    414 U00bc							; (HERO feel, user report 2026-10-22 — the old
    415 U00bc							; ÷4 gate needed ~80 frames to beat gravity).
    416 U00bc		       01 80	   MAX_FALL   =	$0180	; max fall speed (positive = down). Was $0200
    417 U00bc							; (2.0 px/frame) — the terminal fall felt too
    418 U00bc							; fast (user report 2026-10-21): 1.5 px/frame.
