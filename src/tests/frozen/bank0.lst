    380 U00bc		       00 08	   LAMP_WIDTH =	8	; OBJ_LAMP's art spans all 8 pixels now
    381 U00bc							;   (4 missed the bulb from the far side)
    382 U00bc		       00 04	   MINER_WIDTH =	4	; OBJ_MINER's lit pixels start at col 0 (the
    383 U00bc							;   art is stored facing right)
    384 U00bc		       00 04	   SNAKE_PATROL =	4	; ONE TILE each side of the spawn (user
