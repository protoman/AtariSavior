   4032  fd7c							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   4033  fd7c							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   4034  fd7c							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   4035  fd7c							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   4036  fd7c							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   4037  fd7c							; DeriveEnemyY — no persistent movement state exists in RAM.
   4038  fd7c							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   4039  fd7c							; block after the pads; pre-pad headroom is 1B).
   4040  fd7c							; ------------------------------------------------------------------------------
   4041  fd7c				   RefreshEnemyY
   4042  fd7c
   4043  fd7c		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   4044  fd7e							; TickCounter is the 60-frame GAME timer
   4045  fd7e							; (decrements 60->1, reloads) — gates derived
   4046  fd7e							; from it wrapped every second (spider
   4047  fd7e							; "teleported": (TC>>3)&63 only ever saw
   4048  fd7e							; 0..7 and counted DOWN 0->7 = jump).
   4049  fd7e		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   4050  fd80		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   4051  fd82				   .REYLoop		; every reader runs after refresh completes)
   4052  fd82		       ca		      dex
   4053  fd83		       20 90 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   4054  fd86		       95 e2		      sta	EnemyRamY,X
   4055  fd88		       8a		      txa		; N/Z must come from X: flags after jsr are
   4056  fd89		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   4057  fd8b				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   4058  fd8b							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   4059  fd8b							; black rooms, broken PF, invisible sprites)
   4060  fd8b							; --- SELECT or RESET held → back to the old title / level-select screen
   4061  fd8b							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   4062  fd8b							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   4063  fd8b							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   4064  fd8b							;     through TitleWork RESET, level-triggered here) cannot bounce back
   4065  fd8b							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   4066  fd8b							;     RESET held past LANDING still re-fires — press must be released
   4067  fd8b							;     before the drop-in finishes. ---
   4068  fd8b		       a5 8a		      lda	DropTarget
   4069  fd8d		       d0 1d		      bne	.REYRts	; not idle: not ours
   4070  fd8f		       ad 82 02 	      lda	SWCHB
   4071  fd92		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   4072  fd94		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   4073  fd96		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   4074  fd98		       f0 12		      beq	.REYRts	; neither pressed
   4075  fd9a		       a9 ff		      lda	#$FF
   4076  fd9c		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   4077  fd9e		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   4078  fda0		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   4079  fda2		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   4080  fda4							;   game must clear them for a clean melody
   4081  fda4		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   4082  fda7		       68		      pla		; drop OUR return address (LoadLevel already
   4083  fda8		       68		      pla		;   popped its own) — tail into TitleWork
   4084  fda9		       4c 36 fd 	      jmp	TitleWork
