   3745  ff33							; ------------------------------------------------------------------------------
   3746  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3747  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3748  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3749  ff33							; user spec: no piercing, no HERO comparison needed).
   3750  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3751  ff33							;						  left	RoomX-4)
   3752  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3753  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3754  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3755  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3756  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3757  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3758  ff33							;     priority over M0 anyway).
   3759  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3760  ff33							;     press edge re-anchors).
   3761  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3762  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3763  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3764  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3765  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3766  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3767  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3768  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3769  ff33							; ------------------------------------------------------------------------------
   3770  ff33				   LaserInput
   3771  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3772  ff35		       8a		      txa
   3773  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3774  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3775  ff3a		       8a		      txa
   3776  ff3b		       29 80		      and	#LASER_HELD
   3777  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3778  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3779  ff40		       85 c0		      sta	LaserState
   3780  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3781  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3782  ff46							; below — moved here so the cap code could
   3783  ff46							; not push .LaserReleased past bmi's ±127)
   3784  ff46				   .LaserReleased
   3785  ff46		       a9 00		      lda	#0
   3786  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   3787  ff4a							; otherwise -> bars slid across screen
