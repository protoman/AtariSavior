   4411  feb4		       d0 04		      bne	.TNotWrap
   4412  feb6		       a9 00		      lda	#0	; wrap past last level
   4413  feb8		       85 a3		      sta	Level
   4414  feba				   .TNotWrap
   4415  feba		       a9 00		      lda	#0
   4416  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
   4417  febe							;   `cmp #$FD / bcs` treats ≥$FD as sentinel
   4418  febe							;   pose ($FE must take the real-fall path)
   4419  febe		       20 20 fc 	      jsr	LoadLevel
   4420  fec1		       a9 78		      lda	#120	; reset timer for new level
