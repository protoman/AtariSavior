   3933  fcdd		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3934  fcdf		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3935  fce1		       85 83		      sta	LaserX
