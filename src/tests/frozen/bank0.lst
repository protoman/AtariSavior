   3885  fce5							; Title: player already placed at level start by LoadLevel. Hide all
   3886  fce5							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3887  fce5							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3888  fce5							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3889  fce5		       a9 00		      lda	#0
   3890  fce7		       85 b3		      sta	EnemyCount
   3891  fce9		       a9 ff		      lda	#$FF
   3892  fceb		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3893  fced							; Preview seat (user 2026-10-24): the title draws the REAL cave in band 0
   3894  fced							; and seats the player 6 px down from the very top, so his head is not
   3895  fced							; clipped by the top of the screen (RoomY = 0 cut it). (RoomY = 36 put him
   3896  fced							; inside band 1's wall: the playfield has priority over sprites, so he
   3897  fced							; showed as a sliver.)
   3898  fced		       a9 06		      lda	#6
   3899  fcef		       85 81		      sta	RoomY
   3900  fcf1							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3901  fcf1							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3902  fcf1							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3903  fcf1							; preview still renders dark.
   3904  fcf1		       a5 c0		      lda	LaserState
   3905  fcf3		       29 3d		      and	#LASER_KEEP
   3906  fcf5		       85 c0		      sta	LaserState
   3907  fcf7		       a5 a3		      lda	Level
   3908  fcf9		       18		      clc
   3909  fcfa		       69 01		      adc	#1	; 1-based level number (the title SELECT)
   3910  fcfc		       20 12 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3911  fcff		       a9 00		      lda	#0
   3912  fd01		       85 f3		      sta	ScoreTh
   3913  fd03		       85 f4		      sta	ScoreHu
   3914  fd05		       18		      clc
   3915  fd06		       60		      rts
