   1586  f3e8		       20 f6 fe 	      jsr	FoldIndirect	; type|dir (UEDispatch masks b7)
   1587  f3eb		       4c 07 f6 	      jmp	UEDispatch	; UEDispatch replaces the old
   1588  f3ee							; 18 B per-type compare chain with one 3 B jmp:
   1589  f3ee							; frees 15 B of pre-pad headroom and gives the
