   4049  fd74							; ------------------------------------------------------------------------------
   4050  fd74							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   4051  fd74							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   4052  fd74							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   4053  fd74							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   4054  fd74							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   4055  fd74							; DeriveEnemyY — no persistent movement state exists in RAM.
   4056  fd74							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   4057  fd74							; block after the pads; pre-pad headroom is 1B).
   4058  fd74							; ------------------------------------------------------------------------------
   4059  fd74				   RefreshEnemyY
   4060  fd74
   4061  fd74		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   4062  fd76							; TickCounter is the 60-frame GAME timer
   4063  fd76							; (decrements 60->1, reloads) — gates derived
   4064  fd76							; from it wrapped every second (spider
   4065  fd76							; "teleported": (TC>>3)&63 only ever saw
   4066  fd76							; 0..7 and counted DOWN 0->7 = jump).
   4067  fd76		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   4068  fd78		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   4069  fd7a				   .REYLoop		; every reader runs after refresh completes)
   4070  fd7a		       ca		      dex
   4071  fd7b		       20 96 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   4072  fd7e		       95 e2		      sta	EnemyRamY,X
   4073  fd80		       8a		      txa		; N/Z must come from X: flags after jsr are
   4074  fd81		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   4075  fd83				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   4076  fd83							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   4077  fd83							; black rooms, broken PF, invisible sprites)
   4078  fd83							; --- SELECT or RESET held → back to the old title / level-select screen
   4079  fd83							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   4080  fd83							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   4081  fd83							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   4082  fd83							;     through TitleWork RESET, level-triggered here) cannot bounce back
   4083  fd83							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   4084  fd83							;     RESET held past LANDING still re-fires — press must be released
   4085  fd83							;     before the drop-in finishes. ---
   4086  fd83		       a5 8a		      lda	DropTarget
   4087  fd85		       d0 1d		      bne	.REYRts	; not idle: not ours
   4088  fd87		       ad 82 02 	      lda	SWCHB
   4089  fd8a		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   4090  fd8c		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   4091  fd8e		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   4092  fd90		       f0 12		      beq	.REYRts	; neither pressed
   4093  fd92		       a9 ff		      lda	#$FF
   4094  fd94		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   4095  fd96		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   4096  fd98		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   4097  fd9a		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   4098  fd9c							;   game must clear them for a clean melody
   4099  fd9c		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   4100  fd9f		       68		      pla		; drop OUR return address (LoadLevel already
   4101  fda0		       68		      pla		;   popped its own) — tail into TitleWork
   4102  fda1		       4c 24 fd 	      jmp	TitleWork
   4103  fda4				   .REYRts
   4104  fda4		       60		      rts
