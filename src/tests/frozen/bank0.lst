   1439  f3b6							; UpdateEnemies — per-type live motion from RAM shadow (overscan).
   1440  f3b6							; E0: loop runs EVERY frame; each type carries its own speed gate (snake
   1441  f3b6							; ÷4 here; bat ungated, spider ÷8, tentacle ÷2/÷8, moth ÷2 in E1-E4).
   1442  f3b6							; Snake patrol: bounds are SYMMETRIC about the ROM spawn X (± SNAKE_PATROL =
   1443  f3b6							; one tile, user 2026-10-19 — see the constant): retreat a tile behind the
   1444  f3b6							; placement, come out a tile, repeat. The ROM dir names the side it comes OUT
   1445  f3b6							; on: the loader inverts a snake's live dir at room load (bank2 EnterRoomB2),
   1446  f3b6							; so the first move is the retreat into its wall. Ignores editor range_* per
   1447  f3b6							; user 2026-09-23. No wall collision.
   1448  f3b6							; ------------------------------------------------------------------------------
   1449  f3b6				   UpdateEnemies
   1450  f3b6		       a5 b3		      lda	EnemyCount
   1451  f3b8		       d0 01		      bne	UE_Start
   1452  f3ba		       60		      rts
   1453  f3bb				   UE_Start
   1454  f3bb							; --- Fold batch (P3.1): enemy record — staged once, every UE read this
   1455  f3bb							; frame (type + snake spawn/dir) folds against it; loop writes no FetchPtr.
   1456  f3bb		       a5 b1		      lda	EnemyDataLo
   1457  f3bd		       85 e5		      sta	FetchPtr
   1458  f3bf		       a5 b2		      lda	EnemyDataHi
   1459  f3c1		       85 e6		      sta	FetchPtr+1
   1460  f3c3		       a2 00		      ldx	#0
   1461  f3c5				   UE_Loop
   1462  f3c5		       e4 b3		      cpx	EnemyCount
   1463  f3c7		       90 03		      bcc	UE_Alive	; P3.1 stage/folds pushed UE_Exit >127B away
   1464  f3c9		       4c 24 f4 	      jmp	UE_Exit
   1465  f3cc				   UE_Alive
   1466  f3cc		       a5 ba		      lda	EnemyDeadMask
   1467  f3ce		       3d b2 f3 	      and	EnemyBitTable,X
   1468  f3d1		       d0 4d		      bne	UE_Next	; dead enemy does not move
   1469  f3d3		       bc b2 f9 	      ldy	EnemyOffTable,X	; Y = X*4 = type offset
   1470  f3d6		       20 f6 fe 	      jsr	FoldIndirect	; type
   1471  f3d9		       4c fa f7 	      jmp	UEDispatch	; UEDispatch ($F82C pin gap) replaces the old
   1472  f3dc							; 18 B per-type compare chain with one 3 B jmp:
   1473  f3dc							; frees 15 B of pre-pad headroom and gives the
   1474  f3dc							; type tables room for the raft byte.
   1475  f3dc				   UE_SnakeBody
   1476  f3dc		       a5 ad		      lda	TickCounter	; snake: 1 px / 8 frames (user 2026-10-19:
   1477  f3de		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1478  f3e0		       d0 3e		      bne	UE_Next
   1479  f3e2							; live dir bit: 1 = right, 0 = left
   1480  f3e2		       bd b2 f3 	      lda	EnemyBitTable,X
   1481  f3e5		       25 c1		      and	EnemyRamD
   1482  f3e7		       d0 1d		      bne	UE_SnakeRight
   1483  f3e9				   UE_SnakeLeft
   1484  f3e9		       d6 bd		      dec	EnemyRamX,X
   1485  f3eb		       c8		      iny		; +1 = ROM spawn X
   1486  f3ec		       20 f6 fe 	      jsr	FoldIndirect
   1487  f3ef		       85 88		      sta	Temp
   1488  f3f1		       38		      sec
   1489  f3f2		       e9 04		      sbc	#SNAKE_PATROL	; rmin = spawn - SNAKE_PATROL: SYMMETRIC patrol
   1490  f3f4							; (user 2026-10-19) — no dir read needed, the
   1491  f3f4							; range is the placement ± one tile either way
   1492  f3f4		       85 88		      sta	Temp
   1493  f3f6		       b5 bd		      lda	EnemyRamX,X
   1494  f3f8		       c5 88		      cmp	Temp
   1495  f3fa		       b0 24		      bcs	UE_Next	; X >= rmin OK
   1496  f3fc		       a5 88		      lda	Temp
   1497  f3fe		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1498  f400		       20 78 fc 	      jsr	UE_FlipDir	; below min → turn right
   1499  f403		       4c 20 f4 	      jmp	UE_Next
   1500  f406				   UE_SnakeRight
   1501  f406		       f6 bd		      inc	EnemyRamX,X
   1502  f408		       c8		      iny		; +1 = ROM spawn X
   1503  f409		       20 f6 fe 	      jsr	FoldIndirect
   1504  f40c		       85 88		      sta	Temp
   1505  f40e		       18		      clc
   1506  f40f		       69 04		      adc	#SNAKE_PATROL	; rmax = spawn + SNAKE_PATROL (symmetric)
   1507  f411		       85 88		      sta	Temp
   1508  f413		       b5 bd		      lda	EnemyRamX,X
   1509  f415		       c5 88		      cmp	Temp
   1510  f417		       90 07		      bcc	UE_Next	; X < rmax OK
   1511  f419		       a5 88		      lda	Temp
   1512  f41b		       95 bd		      sta	EnemyRamX,X	; clamp to exact bound
   1513  f41d		       20 78 fc 	      jsr	UE_FlipDir	; at or past max → turn left
   1514  f420				   UE_Next
