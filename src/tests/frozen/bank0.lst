   2115  f5cb		       a9 75		      lda	#$75	; +75 points per broken wall (moved out of
   2116  f5cd		       20 0b fc 	      jsr	CallPad_AddScore	;   BMW — pads cannot nest from a pad body)
   2117  f5d0		       ca		      dex
   2118  f5d1		       d0 f8		      bne	.BTScore
   2119  f5d3				   .BTNoScore
