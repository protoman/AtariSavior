   2386  f836							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2387  f836							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF7`
   2388  f836							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2389  f836							; not from here. That is the same FoldIndirect discipline every other tramp
   2390  f836							; uses — the twin cannot be skipped or shortened.
   2391  f836							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2392  f836		       00 00 00 00*	      .ds	$F8C0 - *, 0
   2393  f8c0				   CallPad_RaftBody
   2394  f8c0		       8d f7 1f 	      sta	$1FF7	; select bank1 (last byte fetched from bank0)
   2395  f8c3		       4c e3 fd 	      jmp	$FDE3	; bank1 RaftBody — returns via bank1's ReturnPad
   2396  f8c6
