   2789  f8eb							; PlayerHitsMap — check player bounding box against the room's PF map
   2790  f8eb							; ==============================================================================
   2791  f8eb							; Boxes are in tile coordinates (col 0-19, row 0-2); the walk tests the
   2792  f8eb							; PF0/1/2Buf cell bits directly (cell_collision_plan 2.1) — no rect cache,
   2793  f8eb							; no rect-count limit. The playfield is reflected, so right-half display
   2794  f8eb							; cols mirror via 39-col IN THE PROLOGUE (walk sees left-half only).
   2795  f8eb							; Returns C=0 if clear, C=1 if blocked.
   2796  f8eb				   PlayerHitsMap
   2797  f8eb							; --- Tile row range (top, bottom) ---
   2798  f8eb							; Inlined row lookup: saves 2 JSR stack push levels (4B on stack) to keep SP >= $F8
   2799  f8eb		       a5 81		      lda	RoomY
   2800  f8ed		       4a		      lsr
   2801  f8ee		       4a		      lsr		; A = scanline >> 2
   2802  f8ef		       a8		      tay
   2803  f8f0		       b9 c6 f8 	      lda	YToRowTable,Y
   2804  f8f3		       85 8d		      sta	CollisionCellY	; top tile row
   2805  f8f5		       18		      clc
   2806  f8f6		       a5 81		      lda	RoomY
   2807  f8f8		       69 15		      adc	#PLAYER_SPRITE_H - 1
   2808  f8fa		       4a		      lsr
   2809  f8fb		       4a		      lsr
   2810  f8fc		       a8		      tay
   2811  f8fd		       b9 c6 f8 	      lda	YToRowTable,Y
   2812  f900		       85 8f		      sta	CollisionEndY	; bottom tile row
   2813  f902
   2814  f902							; --- Visible left pixel -> text column range ---
   2815  f902							; RESP0 target is RoomX-PlayerDir; offset varies by its coarse bin.
   2816  f902		       38		      sec
   2817  f903		       a5 80		      lda	RoomX
   2818  f905		       e5 82		      sbc	PlayerDir
   2819  f907		       c9 0f		      cmp	#15
   2820  f909		       b0 06		      bcs	.off7
   2821  f90b		       38		      sec
   2822  f90c		       e9 04		      sbc	#4	; P0 target <15: visible left = X - 4
   2823  f90e		       4c 13 f9 	      jmp	.gotVL
   2824  f911				   .off7
   2825  f911		       e9 07		      sbc	#7	; P0 target >=15: visible left = X - 7
   2826  f913				   .gotVL
   2827  f913		       18		      clc
   2828  f914		       65 82		      adc	PlayerDir	; reflected sprite's first lit bit is column 1
   2829  f916							; first block = visible_left / 4 -> text column
   2830  f916		       a8		      tay		; Y = visible_left
   2831  f917		       4a		      lsr
   2832  f918		       4a		      lsr
   2833  f919		       c9 14		      cmp	#TILE_COLUMNS
   2834  f91b		       90 07		      bcc	.firstOk
   2835  f91d		       85 8b		      sta	CollisionX
   2836  f91f		       a9 27		      lda	#39
   2837  f921		       38		      sec
   2838  f922		       e5 8b		      sbc	CollisionX
   2839  f924				   .firstOk
   2840  f924		       85 8e		      sta	CollisionEndX	; min text column
   2841  f926
   2842  f926							; last block = (visible_left + PLAYER_WIDTH - 1) / 4 -> text column
   2843  f926		       98		      tya		; A = visible_left
   2844  f927		       18		      clc
   2845  f928		       69 06		      adc	#PLAYER_WIDTH - 1
   2846  f92a		       4a		      lsr
   2847  f92b		       4a		      lsr
   2848  f92c		       c9 14		      cmp	#TILE_COLUMNS
   2849  f92e		       90 07		      bcc	.lastOk
   2850  f930		       85 8b		      sta	CollisionX
   2851  f932		       a9 27		      lda	#39
   2852  f934		       38		      sec
   2853  f935		       e5 8b		      sbc	CollisionX
   2854  f937				   .lastOk
   2855  f937		       85 8c		      sta	CollisionCellX	; max text column
   2856  f939
