   2382  f759							; Slot1Hook — called from the .Row setup (X = RowIdx = band). Swaps the live
   2383  f759							; trio when slot 1 lives in this band, then repositions P1 and strobes HMOVE
   2384  f759							; on the following line's HBLANK. Preserves X (RowIdx) and Y (running-Y: the
   2385  f759							; .Line loop relies on it being untouched between rows).
   2386  f759				   Slot1Hook
   2387  f759		       98		      tya
   2388  f75a		       48		      pha		; save running-Y (SetObjectXPos does `tay`)
   2389  f75b		       a5 eb		      lda	ObjTop1
   2390  f75d		       18		      clc
   2391  f75e		       65 81		      adc	RoomY
   2392  f760		       38		      sec
   2393  f761		       e9 01		      sbc	#1	; A = slot 1's absolute room Y
   2394  f763		       dd 00 fe 	      cmp	BandStart,X
   2395  f766		       90 24		      bcc	.SHout	; above this band
   2396  f768		       dd 01 fe 	      cmp	BandStart+1,X
   2397  f76b		       b0 1f		      bcs	.SHout	; in a later band
   2398  f76d		       a5 ea		      lda	ObjBase1
   2399  f76f		       85 b6		      sta	ObjBase
   2400  f771		       a5 eb		      lda	ObjTop1
   2401  f773		       85 bb		      sta	ObjTop
   2402  f775		       a5 ec		      lda	ObjX1
   2403  f777		       85 b7		      sta	ActiveObjectX
   2404  f779		       a2 01		      ldx	#1
   2405  f77b		       20 0f ff 	      jsr	SetObjectXPos	; its own WSYNC starts the positioning line
   2406  f77e							; The frame's ONE HMOVE already ran in the VBL; this second one exists only
   2407  f77e							; for slot 1's own fine adjust. HMP0/HMM0/HMBL still hold the PLAYER's,
   2408  f77e							; the laser's and the ball's fine values, and HMOVE would apply them a
   2409  f77e							; second time — the player's fine adjust doubled (drawn X advanced 2 px per
   2410  f77e							; 1 px of RoomX, sawing +/-15 px as the fine value cycled: the "raft
   2411  f77e							; zig-zag", user 2026-10-22). Clear them; HMP1 stays (set above).
   2412  f77e							; THESE CLEARS MUST SIT BEFORE THE `sta WSYNC` BELOW: they cost ~14 cycles,
   2413  f77e							; and an HMOVE written after cycle 0 of HBLANK gives up part of the fine
   2414  f77e							; shift (late-HMOVE penalty) — slot 1's sprite then snaps in ~4 px steps
   2415  f77e							; (user 2026-10-22: "raft moves one tile at a time").
   2416  f77e		       a9 00		      lda	#0
   2417  f780		       85 20		      sta	HMP0
   2418  f782		       85 22		      sta	HMM0
   2419  f784		       85 24		      sta	HMBL
   2420  f786		       a6 92		      ldx	RowIdx
   2421  f788		       85 02		      sta	WSYNC	; end of the positioning line
   2422  f78a		       85 2a		      sta	HMOVE	; cycle 0 of the next line = HBLANK
   2423  f78c				   .SHout
   2424  f78c		       68		      pla
   2425  f78d		       a8		      tay
   2426  f78e		       60		      rts
