   3114  fcc7							; ------------------------------------------------------------------------------
   3115  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   3116  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   3117  fcc7							; caller; Y is animated from the screen top down to it).
   3118  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   3119  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   3120  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   3121  fcc7							;
   3122  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   3123  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   3124  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   3125  fcc7							;
   3126  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   3127  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   3128  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   3129  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   3130  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   3131  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   3132  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   3133  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   3134  fcc7							; ------------------------------------------------------------------------------
   3135  fcc7				   DropArm
   3136  fcc7		       a5 8a		      lda	DropTarget
   3137  fcc9		       c9 fd		      cmp	#$FD
   3138  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   3139  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   3140  fccd							;   tally cleared to 0 by TallyWork before its
   3141  fccd							;   LoadLevel — same-size swap 2026-10-06)
   3142  fccd		       a5 81		      lda	RoomY
   3143  fccf		       85 8a		      sta	DropTarget
   3144  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   3145  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   3146  fcd5		       a9 00		      lda	#0
   3147  fcd7		       85 81		      sta	RoomY
   3148  fcd9		       85 95		      sta	PlayerYSub
   3149  fcdb		       85 93		      sta	vyLo
   3150  fcdd		       85 94		      sta	vyHi
   3151  fcdf		       a5 c0		      lda	LaserState
   3152  fce1		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   3153  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   3154  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   3155  fce7		       85 83		      sta	LaserX
   3156  fce9		       18		      clc
   3157  fcea		       60		      rts
