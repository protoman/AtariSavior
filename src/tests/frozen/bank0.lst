   1699  f4c8		       d0 06		      bne	.DEYStatic
   1700  f4ca		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1701  f4cd		       4c e9 f4 	      jmp	DEYDelta
   1702  f4d0				   .DEYStatic
   1703  f4d0		       c8		      iny
   1704  f4d1		       c8		      iny
   1705  f4d2		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1706  f4d5		       60		      rts
   1707  f4d6				   .DEYTickNoShift
   1708  f4d6		       a5 c2		      lda	EnemyRamP
   1709  f4d8		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1710  f4d9		       4c e1 f4 	      jmp	.DEYBobTick
   1711  f4dc				   .DEYTickShift
   1712  f4dc		       a5 c2		      lda	EnemyRamP
