   1744  f451		       69 01		      adc	#1	; step right
   1745  f453				   .TentProbe
   1746  f453		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1747  f455		       b0 36		      bcs	.TentOut
   1748  f457		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1749  f459							; Same-column cull: committed X is always probe-clear, so a candidate in
   1750  f459							; the same 4px column covers the same collision cells → result is known
   1751  f459							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1752  f459		       a5 88		      lda	Temp
