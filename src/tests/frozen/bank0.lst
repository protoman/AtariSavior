   1266  f202							; Vertical movement — HERO-style jetpack physics
   1267  f202							; ------------------------------------------------------------------------------
   1268  f202							; Gravity pulls down, holding Up fires jetpack (JetPower ramps with inertia).
   1269  f202							; Velocity is integrated through PlayerYSub and walked pixel-by-pixel via
   1270  f202							; StepDown/StepUp so collision stops flush at walls/doorways.
   1271  f202							; ------------------------------------------------------------------------------
   1272  f202				   UpdateP0Vertical
   1273  f202							; --- Clear HotBump (Temp b7) — set again only if this frame bumps hot rock ---
   1274  f202		       a5 88		      lda	Temp
   1275  f204		       29 7f		      and	#%01111111
   1276  f206		       85 88		      sta	Temp
   1277  f208
   1278  f208							; --- Jet thrust accumulator while Up is held (cap JET_MAX).
   1279  f208							;     2026-10-22 (user report: a full-speed fall could not be stopped):
   1280  f208							;	 * FALLING (vy > 0): thrust jumps straight to JET_MAX — the jet
   1281  f208							;	   catches the fall in ~10 frames from terminal $0180.
   1282  f208							;	 * from rest / while rising: +1 EVERY frame, so take-off eases in.
   1283  f208							;	 * the old ÷4 ramp gate (EnemyRamP & 3, ~1s spin-up, bugs #31) is
   1284  f208							;	   gone: it kept thrust below gravity for ~32 frames.
   1285  f208							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1286  f208							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1287  f208							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1288  f208							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1289  f208							;	   1.0s hover was too long — halved); then the flag clears and
   1290  f208							;	   normal gravity resumes (fall ~0.85s after release). State
   1291  f208							;	   lives in JetPower, NOT
   1292  f208							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1293  f208							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1294  f208							;	   rising frame — both clobbered a StepsLeft-based float.
   1295  f208							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1296  f208							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1297  f208							;	   (headroom stays $FC67).
   1298  f208							; ------------------------------------------------------------------------------
   1299  f208		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1300  f20a		       24 88		      bit	Temp
   1301  f20c		       d0 25		      bne	.JetDecay
   1302  f20e		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1303  f210		       10 04		      bpl	.JetRamp	;   (b7 flag) — WITHOUT this guard the
   1304  f212		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1305  f214		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1306  f216				   .JetRamp
   1307  f216							; HERO feel (user 2026-10-22): a HELD jet catches a fall at once. While
   1308  f216							; falling, thrust jumps straight to JET_MAX, so a terminal 1.5 px/frame
   1309  f216							; fall is stopped in ~10 frames instead of the ~1 s spin-up the old
   1310  f216							; `EnemyRamP & 3` ramp gate needed (thrust stayed under gravity for
   1311  f216							; ~80 frames = more than a room height of extra falling). The ramp only
   1312  f216							; applies from rest / while already rising, so take-off still eases in.
   1313  f216		       a5 94		      lda	vyHi
   1314  f218		       30 0b		      bmi	.JetClimb	; already rising -> ramp
   1315  f21a		       05 93		      ora	vyLo
   1316  f21c		       f0 07		      beq	.JetClimb	; at rest -> ramp
   1317  f21e		       a9 30		      lda	#JET_MAX	; falling: full thrust this frame
   1318  f220		       85 96		      sta	JetPower
   1319  f222		       4c 5f f2 	      jmp	.Gravity
   1320  f225				   .JetClimb
   1321  f225		       a5 96		      lda	JetPower
   1322  f227		       c9 30		      cmp	#JET_MAX
   1323  f229		       b0 34		      bcs	.Gravity	; already full: nothing to add
   1324  f22b		       18		      clc
   1325  f22c		       69 01		      adc	#1	; +1 EVERY frame (ramp gate removed)
   1326  f22e		       85 96		      sta	JetPower
   1327  f230		       4c 5f f2 	      jmp	.Gravity
   1328  f233				   .JetDecay		; Up NOT held this frame
   1329  f233		       a5 96		      lda	JetPower
   1330  f235		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1331  f237		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1332  f239		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1333  f23b		       05 93		      ora	vyLo
   1334  f23d		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1335  f23f							;   climb to stop, do NOT float
   1336  f23f		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1337  f241		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1338  f243		       4c 5f f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1339  f246				   .FloatRun
   1340  f246		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1341  f248		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1342  f24a		       29 7f		      and	#$7F
   1343  f24c		       d0 04		      bne	.FRActive
   1344  f24e		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1345  f250		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1346  f252				   .FRActive
   1347  f252		       a5 94		      lda	vyHi
   1348  f254		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1349  f256		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1350  f258		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1351  f25a		       85 94		      sta	vyHi
   1352  f25c		       4c a4 f2 	      jmp	.Integrate
