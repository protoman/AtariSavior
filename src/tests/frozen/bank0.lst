    704  f08f		       4a		      lsr
    705  f090		       4a		      lsr
    706  f091		       4a		      lsr
    707  f092		       4a		      lsr		; A = p (1..15)
    708  f093		       c9 08		      cmp	#8
    709  f095		       90 04		      bcc	.TideTri
    710  f097		       a9 00		      lda	#0	; rest phase p8-15
    711  f099		       f0 09		      beq	.TideBase	; always
    712  f09b				   .TideTri
    713  f09b		       c9 04		      cmp	#4
    714  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    715  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    716  f0a1		       38		      sec
    717  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
    718  f0a4				   .TideBase
