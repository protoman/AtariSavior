   1083  f1f7							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1084  f1f7							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1085  f1f7							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1086  f1f7							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1087  f1f7							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1088  f1f7							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1089  f1f7							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1090  f1f7							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1091  f1f7							;	   1.0s hover was too long — halved); then the flag clears and
   1092  f1f7							;	   normal gravity resumes (fall ~0.85s after release). State
   1093  f1f7							;	   lives in JetPower, NOT
   1094  f1f7							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1095  f1f7							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1096  f1f7							;	   rising frame — both clobbered a StepsLeft-based float.
   1097  f1f7							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1098  f1f7							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1099  f1f7							;	   (headroom stays $FC67).
   1100  f1f7							; ------------------------------------------------------------------------------
   1101  f1f7		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1102  f1f9		       24 88		      bit	Temp
   1103  f1fb		       d0 21		      bne	.JetDecay
   1104  f1fd		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1105  f1ff		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1106  f201		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1107  f203		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1108  f205				   .RampStart
   1109  f205		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1110  f207		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1111  f209		       d0 3f		      bne	.Gravity
   1112  f20b		       a5 96		      lda	JetPower
   1113  f20d		       c9 14		      cmp	#JET_MAX
   1114  f20f		       b0 06		      bcs	.JetCapped
   1115  f211		       18		      clc
   1116  f212		       69 01		      adc	#1
   1117  f214		       4c 19 f2 	      jmp	.JetSet
   1118  f217				   .JetCapped
   1119  f217		       a9 14		      lda	#JET_MAX
   1120  f219				   .JetSet
   1121  f219		       85 96		      sta	JetPower
   1122  f21b		       4c 4a f2 	      jmp	.Gravity
   1123  f21e				   .JetDecay		; Up NOT held this frame
   1124  f21e		       a5 96		      lda	JetPower
   1125  f220		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1126  f222		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1127  f224		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1128  f226		       05 93		      ora	vyLo
   1129  f228		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1130  f22a							;   climb to stop, do NOT float
   1131  f22a		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1132  f22c		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1133  f22e		       4c 4a f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1134  f231				   .FloatRun
   1135  f231		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1136  f233		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1137  f235		       29 7f		      and	#$7F
   1138  f237		       d0 04		      bne	.FRActive
   1139  f239		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1140  f23b		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1141  f23d				   .FRActive
   1142  f23d		       a5 94		      lda	vyHi
   1143  f23f		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1144  f241		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1145  f243		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1146  f245		       85 94		      sta	vyHi
   1147  f247		       4c 87 f2 	      jmp	.Integrate
