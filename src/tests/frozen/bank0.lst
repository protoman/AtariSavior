   3229  fd34		       90 03		      bcc	.TWselDone	; C=0: no edge
   3230  fd36		       20 4a f5 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3231  fd39				   .TWselDone
   3232  fd39							; --- RESET edge ---
   3233  fd39		       a5 97		      lda	StepsLeft
   3234  fd3b		       29 01		      and	#%00000001
   3235  fd3d		       f0 14		      beq	.TWrstDone
   3236  fd3f		       ad 82 02 	      lda	SWCHB
   3237  fd42		       29 01		      and	#%00000001
   3238  fd44		       d0 0d		      bne	.TWrstDone
   3239  fd46		       a9 00		      lda	#0
   3240  fd48		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3241  fd4a		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3242  fd4c		       85 f4		      sta	ScoreHu
   3243  fd4e		       85 f5		      sta	ScoreTe
   3244  fd50		       20 4a f5 	      jsr	LoadLevel
   3245  fd53				   .TWrstDone
   3246  fd53		       ad 82 02 	      lda	SWCHB
   3247  fd56		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
