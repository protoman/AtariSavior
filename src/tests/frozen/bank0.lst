   1380  f364		       a9 00		      lda	#0
   1381  f366		       85 93		      sta	vyLo
   1382  f368		       85 94		      sta	vyHi
   1383  f36a		       a5 b5		      lda	BombPacked
   1384  f36c		       09 80		      ora	#%10000000	; landed — OnGround
   1385  f36e		       85 b5		      sta	BombPacked
   1386  f370		       60		      rts
   1387  f371				   .SDAir
   1388  f371		       a5 b5		      lda	BombPacked
   1389  f373		       29 7f		      and	#%01111111	; still falling — not ground
   1390  f375		       85 b5		      sta	BombPacked
   1391  f377		       60		      rts
   1392  f378				   .SDBottom
   1393  f378		       20 d9 fb 	      jsr	ExitRoomDown
   1394  f37b		       a5 81		      lda	RoomY
   1395  f37d		       c9 84		      cmp	#PLAYER_MAX_Y
   1396  f37f		       d0 0c		      bne	.SDDone	; changed room (EnterRoom cleared b7)
   1397  f381		       a5 b5		      lda	BombPacked
   1398  f383		       09 80		      ora	#%10000000	; no down exit — standing on floor
   1399  f385		       85 b5		      sta	BombPacked
   1400  f387		       a9 00		      lda	#0
   1401  f389		       85 93		      sta	vyLo
