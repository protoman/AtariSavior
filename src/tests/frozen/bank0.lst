    617  f0a4
    618  f0a4							; --- D6 objects (asym ball + M1): ONE VBL call (pre-pad = 1B headroom) ---
    619  f0a4							; PositionBallM1 (fill hole at $F9C4, bank0-only) reads Temp (staged
    620  f0a4							; BallX; 0 ⇔ symmetric → no RESPBL/HMBL, sym frames bit-identical) and
    621  f0a4							; CollisionEndX (staged M1X; 0 → no M1) — ball selector 4, M1 selector 3,
    622  f0a4							; ENAM1 latched on when M1X≠0. Runs before the single HMOVE below
    623  f0a4							; (HMP0+X shadow registers accumulate). Per-band ENABL comes from BandTab
    624  f0a4							; at each .Row setup line; .AfterRows clears ENABL+ENAM1 before the HUD.
    625  f0a4		       20 c4 f9 	      jsr	PositionBallM1
    626  f0a7
    627  f0a7							; --- Tide row2 body count → CollisionX (kernel carrier; idle during kernel) ---
    628  f0a7							; Water band surface drifts 0-3 lines down/up. off = triangle(p),
    629  f0a7							; p = EnemyRamP>>4 (free-running clock, 16 frames per pixel = gentle
    630  f0a7							; wave speed): p0-3 = down (0→3), p4-7 = back up (3→0), p8-15 = rest
    631  f0a7							; (~2.1 s at 0). 256-frame period wraps 15→0 with off=0 both sides (no
    632  f0a7							; jump). Stores 36+off; kernel .Row row2 uses it, .WaterRow derives
    633  f0a7							; 47-count. CollisionX is overscan-only elsewhere — this VBL write is
    634  f0a7							; the last before the kernel read (stomp-zone safe, no new ZP byte).
    635  f0a7		       a5 c2		      lda	EnemyRamP
    636  f0a9		       29 f0		      and	#$F0
    637  f0ab		       f0 15		      beq	.TideBase	; p=0 → off 0 (A already 0)
    638  f0ad		       4a		      lsr
    639  f0ae		       4a		      lsr
    640  f0af		       4a		      lsr
    641  f0b0		       4a		      lsr		; A = p (1..15)
    642  f0b1		       c9 08		      cmp	#8
    643  f0b3		       90 04		      bcc	.TideTri
    644  f0b5		       a9 00		      lda	#0	; rest phase p8-15
    645  f0b7		       f0 09		      beq	.TideBase	; always
    646  f0b9				   .TideTri
    647  f0b9		       c9 04		      cmp	#4
    648  f0bb		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
