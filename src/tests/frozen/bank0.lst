   3914  fcd3							; Title: player already placed at level start by LoadLevel. Hide all
   3915  fcd3							; GRP1 objects (EnemyCount=0 → SelectActiveObject's no-object path
   3916  fcd3							; blanks ObjBase/ObjTop) and drop the miner slot so SELECT/RESET reloads
   3917  fcd3							; refresh them via EnterRoom. HUD score = level+1 ("000001" = level 0).
   3918  fcd3		       a9 00		      lda	#0
   3919  fcd5		       85 b3		      sta	EnemyCount
   3920  fcd7		       a9 ff		      lda	#$FF
   3921  fcd9		       85 a4		      sta	LevelMinerRoom	; ROOM_NONE: no miner slot, no pickup
   3922  fcdb							; Preview seat (user 2026-10-24): the title draws the REAL cave in band 0
   3923  fcdb							; and seats the player 6 px down from the very top, so his head is not
   3924  fcdb							; clipped by the top of the screen (RoomY = 0 cut it). (RoomY = 36 put him
   3925  fcdb							; inside band 1's wall: the playfield has priority over sprites, so he
   3926  fcdb							; showed as a sliver.)
   3927  fcdb		       a9 06		      lda	#6
   3928  fcdd		       85 81		      sta	RoomY
   3929  fcdf							; No beam on the title: band 0 is the CAVE .Line now, which re-enables
   3930  fcdf							; ENAM0 from PlayerColTable bit1 & LaserState. Clear held+gate (b7/b1) only —
   3931  fcdf							; LASER_KEEP keeps b0 and the rooms 4-7 dark mask, so a dark-room
   3932  fcdf							; preview still renders dark.
   3933  fcdf		       a5 c0		      lda	LaserState
   3934  fce1		       29 3d		      and	#LASER_KEEP
   3935  fce3		       85 c0		      sta	LaserState
   3936  fce5		       a5 a3		      lda	Level
   3937  fce7		       18		      clc
   3938  fce8		       69 01		      adc	#1	; 1-based level number (the title SELECT)
   3939  fcea		       20 12 fb 	      jsr	TitleBcd	; A → packed BCD in ScoreTe (bank0 fill)
   3940  fced		       a9 00		      lda	#0
