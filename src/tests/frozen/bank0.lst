   4048  fdad							; ------------------------------------------------------------------------------
   4049  fdad							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   4050  fdad							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   4051  fdad							;   ranges before the walk; bank2 display-space walkers mirror first too).
   4052  fdad							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   4053  fdad							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   4054  fdad							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   4055  fdad							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   4056  fdad							;   by tools/test_cell_map.py).
   4057  fdad							;   (The standalone CellSolid leaf that lived here moved INTO
   4058  fdad							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   4059  fdad							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   4060  fdad							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   4061  fdad							; ------------------------------------------------------------------------------
   4062  fdad		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   4063  fdc1		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   4064  fdcd		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
   4065  fdd5
   4066  fdd5							; ------------------------------------------------------------------------------
   4067  fdd5							; BombEnemyBlast — bank2 entry tramp ($FDD8, lamp-safe S9 2026-10-07): the
   4068  fdd5							; BombTick `jsr` lands here (bank0), `sta $1FF6` switches to bank2, the `jmp`
   4069  fdd5							; is fetched from bank2's byte-identical mirror at this same address and
   4070  fdd5							; lands on the body at $FD87 (the lamp type-check reads enemy records that
   4071  fdd5							; live in bank2). Body tail-jmps ReturnPad ($FBF8); A = 1 kill (BombTick
   4072  fdd5							; awards +50 — pads cannot nest), 0 none. Old inline body ($F87F, 66B)
   4073  fdd5							; deleted: the region re-packs into the gap before the $FBD6 fold pin
   4074  fdd5							; (pre-pad headroom stays 1B — pins absorb upstream shrink, not the org).
   4075  fdd5							; TWIN: bank2.asm mirrors these exact 6 bytes at $FDD8 (the pad after
   4076  fdd5							; .HOVdone). The PickPlayerFrame pin that used to absorb the size is gone
   4077  fdd5							; (retired 2026-10-20); the $FC49 / $FBF8 pins bound this block today.
   4078  fdd5							; ------------------------------------------------------------------------------
   4079  fdd5		       00 00 00 	      .ds	$FDD8 - *, 0	; pin: bank2's blast-tramp mirror is at $FDD8
   4080  fdd8				   BombEnemyBlast
   4081  fdd8		       8d f6 1f 	      sta	$1FF6
   4082  fddb		       4c 87 fd 	      jmp	$FD87	; BombEnemyBlastBody (bank2.lst — after
   4083  fdde							;   .HOVfeature; NOT in the TitleJetColors
   4084  fdde							;   span)
   4085  fdde							;   (2026-10-13: was $FD79 — crush-kill b6
   4086  fdde							;   latch + feature gate pushed +14; same day
   4087  fdde							;   was $FD6C — .HOVfeature pushed +13; 2026-
   4088  fdde							;   10-10: was $FD6B — 1-byte stale operand =
   4089  fdde							;   entry mid-instruction at `lda EnemyCount+1`;
   4090  fdde							;   garbage path's `inc $4A,X` set wall bits
   4091  fdde							;   via $CA)
   4092  fdde
