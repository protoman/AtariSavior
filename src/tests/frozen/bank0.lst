    882  f121							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
    883  f121							; ObjTop..ObjTop+7 window → row byte from ObjSprites[ObjBase + offset].
    884  f121							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
    885  f121							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
    886  f121							; (mod 256, exact). In-object iff result 0..7 → `cmp #8/bcs` (C=0 in
    887  f121							; range → adc adds exact ObjBase). Replaces `lda Scanline/sec/sbc/bcc`
    888  f121							; (−6c in-range) and the `inc Scanline` (−5c) — Scanline now unused.
    889  f121		       98		      tya
    890  f122		       38		      sec
    891  f123		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
    892  f125		       c9 08		      cmp	#PLAYER_HEIGHT
