   1724  f48b							; ------------------------------------------------------------------------------
   1725  f48b							; DeriveEnemyY — live Y for enemy slot X. Moving types are DERIVED, not stored:
   1726  f48b							; there is no free ZP byte for per-slot movement state (phase/direction live
   1727  f48b							; in the shared EnemyRamP/EnemyRamD bitfields), so the formula is
   1728  f48b							; re-evaluated from ROM spawn + the EnemyRamP frame clock at each refresh.
   1729  f48b							; Bat:     spawn..spawn+2, 1 px / 2 frames, triangle(EnemyRamP>>1 & 3).
   1730  f48b							; Tentacle: spawn..spawn+2, 1 px / 8 frames, triangle(EnemyRamP>>3 & 3).
   1731  f48b							; Spider:  spawn..spawn+24, 1 px / 4 frames, p=(EnemyRamP>>2)&63,
   1732  f48b							;	    down first with dwell at top: delta = p<25 ? p : (p<48 ? 48-p : 0).
   1733  f48b							;	    Gate ÷4 (not spec ÷8): phase period must divide the 256-step clock
   1734  f48b							;	    wrap — 48-step÷8 phases never align (teleport), 64-step÷4 does.
   1735  f48b							;	    Dwell absorbs the 256 mod 64 leftover (wrap lands in dwell zone).
   1736  f48b							; Clock:   EnemyRamP, inc'd once per frame in RefreshEnemyY (TickCounter is
   1737  f48b							;	    the 60-frame game timer — gates from it wrap every second).
   1738  f48b							; Other types: straight ROM y (their movement stages come later).
   1739  f48b							; In: X = enemy slot. Out: A = live Y. Clobbers A/Y.
   1740  f48b							; ------------------------------------------------------------------------------
   1741  f48b				   DeriveEnemyY
   1742  f48b							; --- Fold batch (P3.1): enemy records live in bank2; stage per entry so
   1743  f48b							; any caller works. Stage is A/X-only — caller's slot in X survives. ---
   1744  f48b		       a5 b1		      lda	EnemyDataLo
   1745  f48d		       85 e5		      sta	FetchPtr
   1746  f48f		       a5 b2		      lda	EnemyDataHi
   1747  f491		       85 e6		      sta	FetchPtr+1
   1748  f493		       bc 77 f9 	      ldy	EnemyOffTable,X
   1749  f496		       20 f6 fe 	      jsr	FoldIndirect	; type
   1750  f499		       29 7f		      and	#%01111111	; b7 = dir: without the mask every compare below
   1751  f49b							;   missed and a dir-left enemy fell through to
   1752  f49b							;   .DEYStatic (no bob)
   1753  f49b		       c9 01		      cmp	#ENEMY_BAT
   1754  f49d		       f0 18		      beq	.DEYTickNoShift
   1755  f49f		       c9 03		      cmp	#ENEMY_TENTACLE
   1756  f4a1		       f0 1a		      beq	.DEYTickShift
   1757  f4a3		       c9 00		      cmp	#ENEMY_SPIDER
   1758  f4a5		       f0 2e		      beq	.DEYSpiderTick
   1759  f4a7		       c9 04		      cmp	#ENEMY_MOTH	; E4: Y arm — CallPad to bank1 (leaf_move_plan)
   1760  f4a9		       d0 06		      bne	.DEYStatic
   1761  f4ab		       20 e7 fe 	      jsr	CallPad_MothYDerive
   1762  f4ae		       4c ca f4 	      jmp	DEYDelta
   1763  f4b1				   .DEYStatic
   1764  f4b1		       c8		      iny
   1765  f4b2		       c8		      iny
   1766  f4b3		       20 f6 fe 	      jsr	FoldIndirect	; static types: ROM y
   1767  f4b6		       60		      rts
   1768  f4b7				   .DEYTickNoShift
   1769  f4b7		       a5 c2		      lda	EnemyRamP
   1770  f4b9		       4a		      lsr		; ÷2: 1 px / 2 frames (bat half speed, E-gate fix)
   1771  f4ba		       4c c2 f4 	      jmp	.DEYBobTick
   1772  f4bd				   .DEYTickShift
   1773  f4bd		       a5 c2		      lda	EnemyRamP
   1774  f4bf		       4a		      lsr
   1775  f4c0		       4a		      lsr
   1776  f4c1		       4a		      lsr		; ÷8 gate
