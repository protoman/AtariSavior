    981  f181							; --- Call bank1 for 13+2 HUD rendering via fold-pad at $FC68 ---
    982  f181							; The fold-pad at $FC68 has identical bytes in bank0 and bank1:
    983  f181							;   $FC68: lda #1 / sta $1FF7 / jmp $F540
    984  f181							; After sta $1FF7, CPU reads next instruction from bank1 at $FC6D.
    985  f181							; Bank1's $FC6D has the same jmp $F540 → seamless bank switch.
    986  f181		       4c 68 fc 	      jmp	$FC68	; jump to fold-pad (switches to bank1, runs MenuMain)
    987  f184							; Bank1's MenuMain returns to bank0 via: lda #0 / sta $1FF6 / jmp Overscan
    988  f184
