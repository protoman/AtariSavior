   1955  f604							; ==============================================================================
   1956  f604							; SelectActiveObject — choose the single GRP1 object to draw this frame.
   1957  f604							; The TIA has one GRP1 sprite, so objects flicker by rotating slots each frame.
   1958  f604							; Sets ObjBase, ActiveObjectX, ActiveObjectY, ObjTop, COLUP1.
   1959  f604							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   1960  f604							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0
   1961  f604							; (~15 Hz); other frames normal miner/enemy rotation (FlickerFrame alone).
   1962  f604							; One GRP1: cannot draw bomb + entity same frame.
   1963  f604							; ------------------------------------------------------------------------------
   1964  f604				   SelectActiveObject
   1965  f604							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   1966  f604							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   1967  f604							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   1968  f604							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   1969  f604							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   1970  f604							; middle of the screen" the moment the points counting started).
   1971  f604		       a5 8a		      lda	DropTarget
   1972  f606		       c9 fe		      cmp	#$FE
   1973  f608		       d0 27		      bne	.SOFull
   1974  f60a		       a9 00		      lda	#0
   1975  f60c		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   1976  f60e		       85 b6		      sta	ObjBase	; 0 = no object
   1977  f610		       a5 a4		      lda	LevelMinerRoom
   1978  f612		       29 7f		      and	#$7f
