   2925  fcc7							; ------------------------------------------------------------------------------
   2926  fcc7							; DropArm / DropStep — the ONE spawn drop-in (user rule: same code for every
   2927  fcc7							; restart, only the destiny X/Y changes — X is already in RoomX, placed by the
   2928  fcc7							; caller; Y is animated from the screen top down to it).
   2929  fcc7							; Triggers: stage start / game over / level advance (LoadLevel tail),
   2930  fcc7							; enemy/blast/timer/hot death (.LLStay, same position), water (LoseLifeBand,
   2931  fcc7							; Y-12). All tail-call it -> zero added stack depth (sim_bomb_fuse guard).
   2932  fcc7							;
   2933  fcc7							; DropArm (A implied = current RoomY, C=0 out): freezes RoomY as DropTarget,
   2934  fcc7							; starts the sprite at the top (RoomY=0), zeroes physics + laser state so
   2935  fcc7							; descent is clean (LaserInput is skipped by the gate; beam gate forced 0).
   2936  fcc7							;
   2937  fcc7							; DropStep (runs instead of input/physics/collision while DropTarget != 0):
   2938  fcc7							; 8.8 accumulator PlayerYSub += DropSpeedTable[DropTarget>>4]; carry ->
   2939  fcc7							; inc RoomY; arrival (RoomY >= DropTarget) -> DropTarget = 0, normal control
   2940  fcc7							; resumes next frame. Speed table = Y*256/(60+Y/2) sampled per 16px tier ->
   2941  fcc7							; fall lasts ~60+Y/2 frames = 1.0-2.2 s (shallow start = quicker arrival).
   2942  fcc7							; Tail-jumps to OverscanAudio: bomb/laser/input/physics/horizontal/hot/band/
   2943  fcc7							; miner/enemy-hit/BombTick are all bypassed (enemies + bombs frozen 1-2 s,
   2944  fcc7							; timer keeps running; bank1 UpdateJetSound hears DropTarget as throttle).
   2945  fcc7							; ------------------------------------------------------------------------------
   2946  fcc7				   DropArm
   2947  fcc7		       a5 8a		      lda	DropTarget
   2948  fcc9		       c9 fd		      cmp	#$FD
   2949  fccb		       b0 1e		      bcs	.DATitle	; sentinels $FF title / $FE tally → static
   2950  fccd							;   pose (real fall Y ≤ $BF → C=0 below; $FE
   2951  fccd							;   tally cleared to 0 by TallyWork before its
   2952  fccd							;   LoadLevel — same-size swap 2026-10-06)
   2953  fccd		       a5 81		      lda	RoomY
   2954  fccf		       85 8a		      sta	DropTarget
   2955  fcd1		       a9 04		      lda	#4	; 1..7 = jet "burning": VBL flutter runs
   2956  fcd3		       85 96		      sta	JetPower	;   (JP/8=0 keeps bank1 pitch at idle base)
   2957  fcd5		       a9 00		      lda	#0
   2958  fcd7		       85 81		      sta	RoomY
   2959  fcd9		       85 95		      sta	PlayerYSub
   2960  fcdb		       85 93		      sta	vyLo
   2961  fcdd		       85 94		      sta	vyHi
   2962  fcdf		       a5 c0		      lda	LaserState
   2963  fce1		       29 3c		      and	#LASER_DARK	; reset laser, keep rooms 4-7 dark (parity:
   2964  fce3		       85 c0		      sta	LaserState	; EnemyRamD bits survive DropArm too)
   2965  fce5		       a9 00		      lda	#0	; A out = 0 (DropArm contract, was sta LaserState)
   2966  fce7		       85 83		      sta	LaserX
   2967  fce9		       18		      clc
   2968  fcea		       60		      rts
