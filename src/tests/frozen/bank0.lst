   3247  fd7e							; ------------------------------------------------------------------------------
   3248  fd7e							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3249  fd7e							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3250  fd7e							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3251  fd7e							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3252  fd7e							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3253  fd7e							; DeriveEnemyY — no persistent movement state exists in RAM.
   3254  fd7e							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3255  fd7e							; block after the pads; pre-pad headroom is 1B).
   3256  fd7e							; ------------------------------------------------------------------------------
   3257  fd7e				   RefreshEnemyY
   3258  fd7e		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3259  fd80							; TickCounter is the 60-frame GAME timer
   3260  fd80							; (decrements 60->1, reloads) — gates derived
   3261  fd80							; from it wrapped every second (spider
   3262  fd80							; "teleported": (TC>>3)&63 only ever saw
   3263  fd80							; 0..7 and counted DOWN 0->7 = jump).
   3264  fd80		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3265  fd82		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3266  fd84				   .REYLoop		; every reader runs after refresh completes)
   3267  fd84		       ca		      dex
   3268  fd85		       20 d5 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3269  fd88		       95 e2		      sta	EnemyRamY,X
   3270  fd8a		       8a		      txa		; N/Z must come from X: flags after jsr are
   3271  fd8b		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3272  fd8d				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3273  fd8d							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3274  fd8d							; black rooms, broken PF, invisible sprites)
   3275  fd8d							; --- SELECT or RESET held → back to the old title / level-select screen
   3276  fd8d							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3277  fd8d							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3278  fd8d							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3279  fd8d							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3280  fd8d							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3281  fd8d							;     RESET held past LANDING still re-fires — press must be released
   3282  fd8d							;     before the drop-in finishes. ---
   3283  fd8d		       a5 8a		      lda	DropTarget
   3284  fd8f		       d0 17		      bne	.REYRts	; not idle: not ours
   3285  fd91		       ad 82 02 	      lda	SWCHB
   3286  fd94		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3287  fd96		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3288  fd98		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
