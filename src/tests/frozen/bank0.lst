   1144  f22e							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1145  f22e							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1146  f22e							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1147  f22e							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1148  f22e							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1149  f22e							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1150  f22e							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1151  f22e							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1152  f22e							;	   1.0s hover was too long — halved); then the flag clears and
   1153  f22e							;	   normal gravity resumes (fall ~0.85s after release). State
   1154  f22e							;	   lives in JetPower, NOT
   1155  f22e							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1156  f22e							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1157  f22e							;	   rising frame — both clobbered a StepsLeft-based float.
   1158  f22e							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1159  f22e							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1160  f22e							;	   (headroom stays $FC67).
   1161  f22e							; ------------------------------------------------------------------------------
   1162  f22e		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1163  f230		       24 88		      bit	Temp
   1164  f232		       d0 21		      bne	.JetDecay
   1165  f234		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1166  f236		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1167  f238		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1168  f23a		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1169  f23c				   .RampStart
   1170  f23c		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1171  f23e		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1172  f240		       d0 3f		      bne	.Gravity
   1173  f242		       a5 96		      lda	JetPower
   1174  f244		       c9 14		      cmp	#JET_MAX
   1175  f246		       b0 06		      bcs	.JetCapped
   1176  f248		       18		      clc
   1177  f249		       69 01		      adc	#1
   1178  f24b		       4c 50 f2 	      jmp	.JetSet
   1179  f24e				   .JetCapped
   1180  f24e		       a9 14		      lda	#JET_MAX
   1181  f250				   .JetSet
   1182  f250		       85 96		      sta	JetPower
   1183  f252		       4c 81 f2 	      jmp	.Gravity
   1184  f255				   .JetDecay		; Up NOT held this frame
   1185  f255		       a5 96		      lda	JetPower
   1186  f257		       f0 28		      beq	.Gravity	; 0: idle / normal fall
   1187  f259		       30 0d		      bmi	.FloatRun	; b7 set: float already active -> step it
   1188  f25b		       a5 94		      lda	vyHi	; RELEASE EDGE (thrust 1..127, b7 clear):
   1189  f25d		       05 93		      ora	vyLo
   1190  f25f		       f0 20		      beq	.Gravity	;   vy == 0 (DropArm JP=4 residue) — no
   1191  f261							;   climb to stop, do NOT float
   1192  f261		       a9 b6		      lda	#$80+54	;   $B6 = float flag | 54-frame countdown:
   1193  f263		       85 96		      sta	JetPower	;   ~26f climb-decel + ~28f pinned-Y
   1194  f265		       4c 81 f2 	      jmp	.Gravity	;   (user: 1s hover too long ->
   1195  f268				   .FloatRun
   1196  f268		       c6 96		      dec	JetPower	;   halved to ~0.5s); fall ~0.85s
   1197  f26a		       a5 96		      lda	JetPower	;   after release. tick: $B6..$81
   1198  f26c		       29 7f		      and	#$7F
   1199  f26e		       d0 04		      bne	.FRActive
   1200  f270		       85 96		      sta	JetPower	; A = 0: countdown done -> flag cleared,
   1201  f272		       f0 0d		      beq	.Gravity	;   normal gravity fall from here
   1202  f274				   .FRActive
   1203  f274		       a5 94		      lda	vyHi
   1204  f276		       30 09		      bmi	.Gravity	; still climbing: gravity-only decel
   1205  f278		       a9 00		      lda	#0	; rise stopped: pin Y for the rest of
   1206  f27a		       85 93		      sta	vyLo	;   the countdown (~1.0s hover)
   1207  f27c		       85 94		      sta	vyHi
   1208  f27e		       4c be f2 	      jmp	.Integrate
