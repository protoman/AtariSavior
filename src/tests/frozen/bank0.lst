   3673  fd78							; ------------------------------------------------------------------------------
   3674  fd78							; RefreshEnemyY — write live Y → EnemyRamY (every slot, live or dead).
   3675  fd78							; Runs at overscan entry: inside the safe window (after the HUD score-ptr
   3676  fd78							; stomp of $E2-$E4, before LaserInput / CheckEnemyHit / moth / next frame's
   3677  fd78							; SelectActiveObject read it) — see the EnemyRamY contract at the ZP map.
   3678  fd78							; E1: moving types (bat) get ROM spawn + TickCounter-derived offset via
   3679  fd78							; DeriveEnemyY — no persistent movement state exists in RAM.
   3680  fd78							; Clobbers A/X/Y. Moved post-pad 2026-10-02 (SELECT → title needs this
   3681  fd78							; block after the pads; pre-pad headroom is 1B).
   3682  fd78							; ------------------------------------------------------------------------------
   3683  fd78				   RefreshEnemyY
   3684  fd78
   3685  fd78		       e6 c2		      inc	EnemyRamP	; free-running frame clock (wraps 0-255).
   3686  fd7a							; TickCounter is the 60-frame GAME timer
   3687  fd7a							; (decrements 60->1, reloads) — gates derived
   3688  fd7a							; from it wrapped every second (spider
   3689  fd7a							; "teleported": (TC>>3)&63 only ever saw
   3690  fd7a							; 0..7 and counted DOWN 0->7 = jump).
   3691  fd7a		       a6 b3		      ldx	EnemyCount	; countdown loop (-2 B vs forward; derive
   3692  fd7c		       f0 09		      beq	.REYDone	; order n-1..0 — derivations independent,
   3693  fd7e				   .REYLoop		; every reader runs after refresh completes)
   3694  fd7e		       ca		      dex
   3695  fd7f		       20 94 f4 	      jsr	DeriveEnemyY	; A = live Y (ROM copy, or derived for bat)
   3696  fd82		       95 e2		      sta	EnemyRamY,X
   3697  fd84		       8a		      txa		; N/Z must come from X: flags after jsr are
   3698  fd85		       d0 f7		      bne	.REYLoop	; the sign of the DERIVED Y byte (bpl ran
   3699  fd87				   .REYDone		; away at X=$FF, writing $1C2/$1C1/... =
   3700  fd87							; mirrored EnemyRamP/EnemyRamD/TIA = blink,
   3701  fd87							; black rooms, broken PF, invisible sprites)
   3702  fd87							; --- SELECT or RESET held → back to the old title / level-select screen
   3703  fd87							;     ($FF = first room + HUD count). Gate: DropTarget == 0 EXACTLY
   3704  fd87							;     (idle/landed). Sentinels ($FD/$FF/$FE) skip via ≠0; a DROP-IN
   3705  fd87							;     fall (Y≠0) also skips — so the press that STARTED the game (held
   3706  fd87							;     through TitleWork RESET, level-triggered here) cannot bounce back
   3707  fd87							;     to the title while falling (bounce-fixed 2026-10-06). Residual:
   3708  fd87							;     RESET held past LANDING still re-fires — press must be released
   3709  fd87							;     before the drop-in finishes. ---
   3710  fd87		       a5 8a		      lda	DropTarget
   3711  fd89		       d0 1d		      bne	.REYRts	; not idle: not ours
   3712  fd8b		       ad 82 02 	      lda	SWCHB
   3713  fd8e		       85 97		      sta	StepsLeft	; latch so TitleWork sees "held" (no re-fire)
   3714  fd90		       29 03		      and	#%00000011	; SELECT b1 + RESET b0 (level-triggered,
   3715  fd92		       c9 03		      cmp	#%00000011	;   same style as the old SELECT-only check)
   3716  fd94		       f0 12		      beq	.REYRts	; neither pressed
   3717  fd96		       a9 ff		      lda	#$FF
   3718  fd98		       85 8a		      sta	DropTarget	; merged title sentinel ($FF, 2026-10-19)
   3719  fd9a		       a9 00		      lda	#0	; restart the title theme: bank1's melody state
   3720  fd9c		       85 f6		      sta	BombX	;   lives in BombX/BombTimer while the title
   3721  fd9e		       85 f7		      sta	BombTimer	;   runs (both dead there), so returning from a
   3722  fda0							;   game must clear them for a clean melody
   3723  fda0		       20 20 fc 	      jsr	LoadLevel	; reload the level-start room for the preview
   3724  fda3		       68		      pla		; drop OUR return address (LoadLevel already
   3725  fda4		       68		      pla		;   popped its own) — tail into TitleWork
   3726  fda5		       4c 32 fd 	      jmp	TitleWork
   3727  fda8				   .REYRts
   3728  fda8		       60		      rts
