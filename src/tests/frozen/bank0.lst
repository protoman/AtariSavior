   2131  f62b							; ==============================================================================
   2132  f62b							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2133  f62b							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2134  f62b							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2135  f62b							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2136  f62b							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2137  f62b							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2138  f62b							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2139  f62b							; ==============================================================================
   2140  f62b				   SelectActiveObject
   2141  f62b							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2142  f62b							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2143  f62b							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2144  f62b							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2145  f62b							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2146  f62b							; middle of the screen" the moment the points counting started).
   2147  f62b		       a5 8a		      lda	DropTarget
   2148  f62d		       c9 fe		      cmp	#$FE
   2149  f62f		       d0 2d		      bne	.SOFull
   2150  f631		       a9 00		      lda	#0
   2151  f633		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2152  f635		       a9 ff		      lda	#$FF
   2153  f637		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2154  f639							;   `0 = no object` comment was wrong and the
   2155  f639							;   tally-without-miner frame staged ObjTop from
   2156  f639							;   a stale Y, i.e. a stray key sprite)
   2157  f639		       a5 a4		      lda	LevelMinerRoom
   2158  f63b		       29 7f		      and	#$7f
   2159  f63d		       c5 98		      cmp	RoomNo
   2160  f63f		       f0 03		      beq	.SOTallyMiner
   2161  f641		       4c 3a f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2162  f644				   .SOTallyMiner
   2163  f644		       a9 7a		      lda	#OBJ_MINER
   2164  f646		       85 b6		      sta	ObjBase
   2165  f648		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2166  f64a		       85 9d		      sta	ObjHeight
   2167  f64c		       a5 a5		      lda	MinerX
   2168  f64e		       85 b7		      sta	ActiveObjectX
   2169  f650		       a5 a6		      lda	MinerY
