   3232  fd38							; ------------------------------------------------------------------------------
   3233  fd38							; TitleWork — level-select screen (DropTarget = $FF sentinel, dispatched from
   3234  fd38							; DropStep every frame). Player stands at the level start: no gravity, no
   3235  fd38							; enemies (count/miner cleared by DropArm .DATitle), no sound, timer frozen
   3236  fd38							; (tail skips the TickCounter/BarLevel block). HUD score = level+1.
   3237  fd38							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3238  fd38							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3239  fd38							;	    the intro exit ate the first press and made #2 read as dead)
   3240  fd38							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3241  fd38							;	    the real drop-in → gameplay starts
   3242  fd38							; (Intro $FD never reaches here — DropStep routes it to TitleIntro.)
   3243  fd38							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3244  fd38							; title-owned; the first play frame rewrites it as the step budget).
   3245  fd38							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3246  fd38							; ------------------------------------------------------------------------------
   3247  fd38				   TitleWork
   3248  fd38							; --- SELECT edge (TitleSelect, fill region) ---
   3249  fd38		       20 4f fc 	      jsr	CallPad_TitleSelect
   3250  fd3b		       90 03		      bcc	.TWselDone	; C=0: no edge
   3251  fd3d		       20 82 f5 	      jsr	LoadLevel	; title arm re-runs → score/objects refreshed
   3252  fd40				   .TWselDone
   3253  fd40							; --- RESET edge ---
   3254  fd40		       a5 97		      lda	StepsLeft
   3255  fd42		       29 01		      and	#%00000001
   3256  fd44		       f0 14		      beq	.TWrstDone
   3257  fd46		       ad 82 02 	      lda	SWCHB
   3258  fd49		       29 01		      and	#%00000001
   3259  fd4b		       d0 0d		      bne	.TWrstDone
   3260  fd4d		       a9 00		      lda	#0
   3261  fd4f		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3262  fd51		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3263  fd53		       85 f4		      sta	ScoreHu
   3264  fd55		       85 f5		      sta	ScoreTe
   3265  fd57		       20 82 f5 	      jsr	LoadLevel
   3266  fd5a				   .TWrstDone
   3267  fd5a		       ad 82 02 	      lda	SWCHB
   3268  fd5d		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3269  fd5f							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3270  fd5f							;     channel force-muted here — UpdateJetSound is skipped because
   3271  fd5f							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3272  fd5f							;     = 0, AUDV0 covered above). ---
