    999  f130							; --- Player sprite: color for THIS line, graphics byte for NEXT line ---
   1000  f130							; GRP0 written on line S displays on line S+1 (latched at the sprite's
   1001  f130							; window start after the write) — index graphics with A0+1 ($ff wraps
   1002  f130							; to 0 = row0 on the line before the sprite).
   1003  f130							; CORRECTED 2026-10-22 (Phase 4): that "line S+1" is only true for a
   1004  f130							; sprite whose pixels come AFTER the store. Per Stella's Player::grp /
   1005  f130							; updatePattern, a GRP write lands in myPatternNew and renders at once, so
   1006  f130							; the boundary is the sprite's own pixel start (cycle ~(61+X)/3). With
   1007  f130							; VDELP0=1 (set in the VBL, see the comment there) the live pattern is
   1008  f130							; `myPatternOld`, latched by the GRP1 store at c58, so P0 is correct for
   1009  f130							; every X < 113 px and its art row r sits on the SAME scanline as
   1010  f130							; PlayerColTable[r] (COLUP0 lands at c19, before all pixels) — i.e. the
   1011  f130							; art and its per-row colours finally agree. Do not reorder the colour
   1012  f130							; path behind the graphics: COLUP0 must stay the first store in the body.
   1013  f130							; Running-Y: Y = A0 = Scanline - RoomY is computed ONCE at kernel entry
   1014  f130							; (sec/sbc RoomY/tay); .Line's iny advances it (Y = A0+1 after the
   1015  f130							; graphics write = A0 of the next line). Nothing between rows may touch
   1016  f130							; Y — the water-strip band-color read is an inlined `lda` (Y untouched).
   1017  f130							; Cycle budget — MEASURED (sim_frame_budget, bugs.md #29 Class A):
   1018  f130							; the old worst path (in-window color/beam/GRP0 + object in-range) was
   1019  f130							; 78c: WSYNC write landed 2c into the next line -> full-line stall ->
   1020  f130							; +1 scanline on every frame whose object window overlapped the A0=11
   1021  f130							; line (24 stalls in the SIM_LEVEL=2 window, always even frames —
   1022  f130							; SelectActiveObject parity rotation). Root fix: the color/beam gate
   1023  f130							; below stops at A0=10; row 11 inherits row 10's COLUP0/ENAM0 writes
   1024  f130							; (PlayerColTable [10]==[11], verify_build asserts) because
   1025  f130							; GRP0 row11 is fetched on line A0=10 already ("row11 shows via
   1026  f130							; line10"). Worst path measured 2026-10-15 (vcrunch jitter hunt):
   1027  f130							; in-window color/beam/GRP0 + object in-range = 69c between WSs,
   1028  f130							; start-to-start d=72 — was 73/76 (= stall zone 74-76, whole-screen
   1029  f130							; +1-line jitter) until the dead `cpy #12 / bcs .GrpZero` (4c, never
   1030  f130							; taken on the A0<=10 color path) moved to .GrpSkip. Budget: work
   1031  f130							; <= 70c / d <= 73 — a 74-76 segment stalls a full scanline.
   1032  f130							; ObjSprites+107 must stay in ONE page (else lda ObjSprites,X
   1033  f130							; page-crosses, +1c on the GRP1 fetch) — verify_build enforces this.
   1034  f130							; Branch targets all same-page (3c taken) and PlayerColTable in $F8xx
   1035  f130							; (verify_build guards the A0=10 page-cross budget).
   1036  f130							; GRP1 object section clobbers X (ObjSprites index) — row counter lives in
   1037  f130							; RowIdx and X is reloaded after bne. Row-advance +6c on the .Row setup
   1038  f130							; scanline (segment 63c -> 69c <= 76c): frame length unchanged.
   1039  f130							; The old Scanline/sec/sbc/tay prefix cost 10c more (body 66c -> WSYNC
   1040  f130							; write on cycle 76 = one cycle late): WSYNC stalled a full line per
   1041  f130							; overlapping scanline — stretched cave row, HUD pushed down, and with
   1042  f130							; GRP1 flicker rotation the frame length alternated (one-tile oscillation).
   1043  f130							; Keep the hot path at <= 70c work: an overrun duplicates the scanline.
   1044  f130		       c0 15		      cpy	#PLAYER_SPRITE_H - 1
   1045  f132		       b0 3d		      bcs	.GrpSkip	; A0 >= 11 (incl $ff): no color/beam this line.
   1046  f134							; A0=11 skips too (Class-A stall line): rows
   1047  f134							; 10/11 share color+beam bytes, so row 10's
   1048  f134							; writes are still in effect here.
   1049  f134							; --- Laser S2.2: ENAM0 = PlayerColTable bit1 & LaserState.b1 ----------
   1050  f134							; Phase 0 (2026-10-21): the retired BeamMask table duplicated bit 1 of
   1051  f134							; PlayerColTable for a separate 4c fetch. One yellow strip on RoomY+2
   1052  f134							; only (user directive 2026-10-08: the red row-3 strip is gone; the kill
   1053  f134							; window in LaserHitTestBody keeps rows RoomY+2..3 = superset of the
   1054  f134							; draw). In-window path only (Y<=11), so outside the window ENAM0 keeps
   1055  f134							; its last write ($00 at A0=10) — no HUD artifact. verify_build asserts
   1056  f134							; bit1 is set at index 2 and nowhere else, and that rows 10/11 stay equal
   1057  f134							; (the A0=11 gate skip inherits row 10's writes).
   1058  f134		       b9 65 fe 	      lda	PlayerColTable,Y	; 4c — per-row color; bit 1 = ENAM0 enable
   1059  f137		       85 06		      sta	COLUP0	; applies to this line (colour bit0 = don't-care)
   1060  f139		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
   1061  f13b		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
   1062  f13d		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
   1063  f13e							;   Color/beam gate entered only with A0<=10
   1064  f13e							;   -> after iny Y<=11: always fetchable, so
   1065  f13e							;   the old `cpy #PLAYER_SPRITE_H / bcs
   1066  f13e							;   .GrpZero` here was DEAD 4c on the worst
   1067  f13e							;   path (2+2, never taken — A0=11+ never
   1068  f13e							;   reaches it, it goes to bcs .GrpSkip).
   1069  f13e		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
   1070  f140		       85 1b		      sta	GRP0
