   1340  f25f							; --- Physics: vy += GRAVITY (gravity), vy -= JetPower (jet thrust). ---
   1341  f25f							;     JetPower b7 = float flag (bugs #31): float frames add gravity
   1342  f25f							;     only — subtracting $80+ would blast the player upward.
   1343  f25f				   .Gravity
   1344  f25f		       18		      clc
   1345  f260		       a5 93		      lda	vyLo
   1346  f262		       69 08		      adc	#<GRAVITY
   1347  f264		       85 93		      sta	vyLo
   1348  f266		       a5 94		      lda	vyHi
   1349  f268		       69 00		      adc	#>GRAVITY
   1350  f26a		       85 94		      sta	vyHi
