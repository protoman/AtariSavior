    885  f121							; --- GRP1 SECOND (object/enemy sprite): one design row per scanline ---
    886  f121							; ObjTop..ObjTop+7 window → row byte from ObjSprites[ObjBase + offset].
    887  f121							; Object off: ObjBase=$FF sentinel (ObjTop parked 144). S2.2: ObjTop is RoomY-relative;
    888  f121							; Y here = A0+1 = next line's A0, so `Y - ObjTopRel` = Scanline - ObjTop
    889  f121							; (mod 256, exact). In-object iff result 0..7 → `cmp #8/bcs` (C=0 in
    890  f121							; range → adc adds exact ObjBase). Replaces `lda Scanline/sec/sbc/bcc`
    891  f121							; (−6c in-range) and the `inc Scanline` (−5c) — Scanline now unused.
    892  f121		       98		      tya
    893  f122		       38		      sec
    894  f123		       e5 bb		      sbc	ObjTop	; A = Y - ObjTopRel (= Scanline - ObjTop, mod 256)
    895  f125		       c9 08		      cmp	#PLAYER_HEIGHT
    896  f127		       b0 4c		      bcs	.ObjZero	; above (negative mod ≥65) or at/below bottom
    897  f129		       65 b6		      adc	ObjBase
    898  f12b		       aa		      tax
    899  f12c		       bd 48 fe 	      lda	ObjSprites,X
    900  f12f		       85 1c		      sta	GRP1
    901  f131		       bd 00 fe 	      lda	ObjColorTab,X	; per-row object color (+5c cross — the cycle sum
