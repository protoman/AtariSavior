   3796  ff33							; ------------------------------------------------------------------------------
   3797  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3798  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3799  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3800  ff33							; user spec: no piercing, no HERO comparison needed).
   3801  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3802  ff33							;						  left	RoomX-4)
   3803  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3804  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3805  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3806  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3807  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3808  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3809  ff33							;     priority over M0 anyway).
   3810  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3811  ff33							;     press edge re-anchors).
   3812  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3813  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3814  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3815  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3816  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3817  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3818  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3819  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3820  ff33							; ------------------------------------------------------------------------------
   3821  ff33				   LaserInput
   3822  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3823  ff35		       8a		      txa
   3824  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3825  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3826  ff3a		       8a		      txa
   3827  ff3b		       29 80		      and	#LASER_HELD
   3828  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3829  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3830  ff40		       85 c0		      sta	LaserState
   3831  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3832  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3833  ff46							; below — moved here so the cap code could
   3834  ff46							; not push .LaserReleased past bmi's ±127)
   3835  ff46				   .LaserReleased
   3836  ff46		       a9 00		      lda	#0
   3837  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   3838  ff4a							; otherwise -> bars slid across screen
   3839  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   3840  ff4b				   .LaserFire
   3841  ff4b		       a5 c0		      lda	LaserState
   3842  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   3843  ff4f		       85 c0		      sta	LaserState
   3844  ff51		       8a		      txa
   3845  ff52		       29 80		      and	#LASER_HELD
   3846  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   3847  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   3848  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   3849  ff56							; step would jump out of the 8px wall with no candidate ever inside it
   3850  ff56							; (pass-through, 2026-10-10). dec clears b0; bne .LaserInit: state ≠ 0
   3851  ff56							; here (b7 held from the ora above). Open-hold cadence alternates
   3852  ff56							; travel-consume / eye-retest = 1 LWC per frame, same as before.
   3853  ff56		       a5 c0		      lda	LaserState
   3854  ff58		       29 01		      and	#LASER_REARM
   3855  ff5a		       f0 04		      beq	.LAdvStep
   3856  ff5c		       c6 c0		      dec	LaserState
   3857  ff5e		       d0 3a		      bne	.LaserInit
   3858  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   3859  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   3860  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   3861  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   3862  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   3863  ff60				   .LAdvStep
   3864  ff60		       a4 82		      ldy	PlayerDir
   3865  ff62		       a5 83		      lda	LaserX
   3866  ff64		       18		      clc
   3867  ff65		       79 de ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   3868  ff68				   .LAdvS
