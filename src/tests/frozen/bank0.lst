   2353  f80e							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2354  f80e							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2355  f80e							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2356  f80e							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2357  f80e							; ------------------------------------------------------------------------------
   2358  f80e				   UEDispatch
   2359  f80e		       c9 07		      cmp	#ENEMY_RAFT
   2360  f810		       d0 06		      bne	.UEDNotRaft
   2361  f812		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2362  f815		       4c 1a f4 	      jmp	UE_Next
   2363  f818				   .UEDNotRaft
   2364  f818		       c9 03		      cmp	#ENEMY_TENTACLE
   2365  f81a		       d0 03		      bne	.UEDNotTent
