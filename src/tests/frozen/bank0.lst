   1397  f37d		       c9 84		      cmp	#PLAYER_MAX_Y
   1398  f37f		       d0 0c		      bne	.SDDone	; changed room (EnterRoom cleared b7)
   1399  f381		       a5 b5		      lda	BombPacked
   1400  f383		       09 80		      ora	#%10000000	; no down exit — standing on floor
   1401  f385		       85 b5		      sta	BombPacked
