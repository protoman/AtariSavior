   2700  f9b5							; ==============================================================================
   2701  f9b5							; E4 moth exit tramp ($FC49-$FC4E) — bank2 executes `sta $1FF6` at $FC49
   2702  f9b5							; (byte-identical slice, guard: verify_build), then the fetch at $FC4C comes
   2703  f9b5							; from bank0 = `jmp UE_Next` (real label here — no cross-bank address sync).
   2704  f9b5							; bank0's `sta $1FF6` copy never runs; bank2's bytes from $FC4C never run.
   2705  f9b5							;
   2706  f9b5							; MUST stay off $FFF6-$FFF9: those are the ONLY addresses in code space where
   2707  f9b5							; (addr & $1FFF) lands in $1FF6-$1FF9 = F6 hotspot mirrors. Stella's
   2708  f9b5							; CartridgeEnhanced::peek (CartEnh.cxx:157, ADDR_MASK=$1FFF) calls
   2709  f9b5							; checkSwitchBank on READS — the old $FFF2 placement fetched the `jmp`
   2710  f9b5							; operands at $FFF6/$FFF7 and flipped banks mid-instruction (operand hi from
   2711  f9b5							; bank1 = $00 -> jmp $007D -> HUD runaway, 359/360-line frames, 5-byte stack
   2712  f9b5							; leak per rogue Overscan entry -> SP decayed to $E1 -> frame-3 crash where
   2713  f9b5							; jsr RefreshEnemyY's return landed on FetchPtr). Real F6 is write-only, but
   2714  f9b5							; no fetched byte may ever sit in the mirror zone.
   2715  f9b5							; ==============================================================================
   2716  f9b5							; ==============================================================================
   2717  f9b5							; Cross-bank call pads (docs/leaf_move_plan.md) — byte-identical copies live in
   2718  f9b5							; bank1 at the SAME addresses. F6 hotspots switch on ANY write — the written
   2719  f9b5							; value is ignored (proven by FoldIndirect's `sta $1FF6` carrying data bytes) —
   2720  f9b5							; so the pads `sta $1FF7`/`sta $1FF6` with A AS-IS: A/X/Y/flags pass through
   2721  f9b5							; unchanged, making the pad equivalent to the original inlined `jsr`.
   2722  f9b5							; (2026-09-30 bug: `lda #1` before `sta $1FF7` clobbered A — ClearPFColumn
   2723  f9b5							; punched col 1 instead of the bomb's col, AddScore added +1 instead of
   2724  f9b5							; +50/+75. Hole appeared at screen col 1 + mirror col 18 = "second tile from
   2725  f9b5							; each edge"; collision stayed correct because WallMask is separate.)
   2726  f9b5							; `sta` does not touch flags — IsRoomDark's `beq` contract survives the
   2727  f9b5							; return. Carry survives. No stack use.
   2728  f9b5							; ==============================================================================
   2729  f9b5		       00 00 00 	      .ds	$F9B8 - *, 0	; Phase 4 overlay tramp — shared address with
   2730  f9b8							; bank2's twin image (40B bank2 hole before
   2731  f9b8							; org $F9D9); F6-safe ($F9B1 & $1FFF ∉ hotspots)
   2732  f9b8				   OverlayTramp
   2733  f9b8		       a5 84		      lda	LineCount	; packed asym byte (0 = symmetric)
   2734  f9ba		       f0 06		      beq	.OTsym	; sym: clc/rts in bank0, never switches
   2735  f9bc		       8d f8 1f 	      sta	$1FF8	; select bank2 (F6 ignores the value)
   2736  f9bf		       4c 00 fe 	      jmp	$FE00	; bank2 PHMOverlay (dead in bank0 — the
   2737  f9c2							; twin's jmp operand is the live one)
   2738  f9c2				   .OTsym
