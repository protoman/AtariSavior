   4020  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   4021  ff00							; ==============================================================================
   4022  ff00					      org	$FF00
   4023  ff00				   fineAdjustBegin
   4024  ff00		       70		      .byte.b	%01110000	; left 7
   4025  ff01		       60		      .byte.b	%01100000	; left 6
   4026  ff02		       50		      .byte.b	%01010000	; left 5
   4027  ff03		       40		      .byte.b	%01000000	; left 4
   4028  ff04		       30		      .byte.b	%00110000	; left 3
   4029  ff05		       20		      .byte.b	%00100000	; left 2
   4030  ff06		       10		      .byte.b	%00010000	; left 1
   4031  ff07		       00		      .byte.b	%00000000	; no movement
   4032  ff08		       f0		      .byte.b	%11110000	; right 1
   4033  ff09		       e0		      .byte.b	%11100000	; right 2
   4034  ff0a		       d0		      .byte.b	%11010000	; right 3
   4035  ff0b		       c0		      .byte.b	%11000000	; right 4
   4036  ff0c		       b0		      .byte.b	%10110000	; right 5
   4037  ff0d		       a0		      .byte.b	%10100000	; right 6
   4038  ff0e		       90		      .byte.b	%10010000	; right 7
   4039  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
