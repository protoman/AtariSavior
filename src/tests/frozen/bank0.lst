    369 U00bc		       00 08	   ENEMY_WIDTH =	8	; snake GRP1 width ($ff = 8 px) — flush-out span
    370 U00bc		       00 08	   LAMP_WIDTH =	8	; OBJ_LAMP's art spans all 8 pixels now
