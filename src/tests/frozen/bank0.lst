   2208  f632							; ==============================================================================
   2209  f632							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2210  f632							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2211  f632							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2212  f632							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2213  f632							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2214  f632							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2215  f632							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2216  f632							; ==============================================================================
   2217  f632				   SelectActiveObject
   2218  f632							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2219  f632							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2220  f632							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2221  f632							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2222  f632							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2223  f632							; middle of the screen" the moment the points counting started).
   2224  f632		       a5 8a		      lda	DropTarget
   2225  f634		       c9 fe		      cmp	#$FE
   2226  f636		       d0 2d		      bne	.SOFull
   2227  f638		       a9 00		      lda	#0
   2228  f63a		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2229  f63c		       a9 ff		      lda	#$FF
   2230  f63e		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2231  f640							;   `0 = no object` comment was wrong and the
   2232  f640							;   tally-without-miner frame staged ObjTop from
   2233  f640							;   a stale Y, i.e. a stray key sprite)
   2234  f640		       a5 a4		      lda	LevelMinerRoom
   2235  f642		       29 7f		      and	#$7f
   2236  f644		       c5 98		      cmp	RoomNo
   2237  f646		       f0 03		      beq	.SOTallyMiner
   2238  f648		       4c 45 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2239  f64b				   .SOTallyMiner
   2240  f64b		       a9 55		      lda	#OBJ_MINER
   2241  f64d		       85 b6		      sta	ObjBase
   2242  f64f		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2243  f651		       85 9d		      sta	ObjHeight
   2244  f653		       a5 a5		      lda	MinerX
   2245  f655		       85 b7		      sta	ActiveObjectX
   2246  f657		       a5 a6		      lda	MinerY
   2247  f659		       18		      clc
   2248  f65a		       69 03		      adc	#3	; same 3px offset as the normal miner path
   2249  f65c		       85 b8		      sta	ActiveObjectY
   2250  f65e		       a9 66		      lda	#$66	; purple (hue 6, luma 3)
   2251  f660		       85 07		      sta	COLUP1
   2252  f662		       4c 45 f7 	      jmp	.SODone
   2253  f665				   .SOFull
   2254  f665		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2255  f667							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2256  f667		       a5 b5		      lda	BombPacked
   2257  f669		       29 03		      and	#%00000011
   2258  f66b		       c9 01		      cmp	#1
   2259  f66d		       d0 1d		      bne	.SOCount
   2260  f66f		       a5 f7		      lda	BombTimer
   2261  f671		       29 03		      and	#3
   2262  f673		       d0 17		      bne	.SOCount	; 3 of 4 -> miner/enemy
   2263  f675		       a9 65		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   2264  f677		       85 b6		      sta	ObjBase
   2265  f679		       a9 08		      lda	#OBJ_BOMB_H	; bomb design height (8-row art; OBJ_WINDOW
   2266  f67b							;   would draw the RAFT rows underneath)
