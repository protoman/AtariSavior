   1873  f585		       d0 39		      bne	.BTDone
   1874  f587		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   1875  f589		       29 fc		      and	#%11111100
   1876  f58b		       85 b5		      sta	BombPacked
   1877  f58d		       a9 00		      lda	#0
