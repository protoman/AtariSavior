   3950  fd36							; ------------------------------------------------------------------------------
   3951  fd36							; TitleWork — merged title/level-select screen (DropTarget = $FD sentinel,
   3952  fd36							; dispatched from DropStep every frame). The TitleKernel shows the logo, the
   3953  fd36							; selected level number (digits band) and the credits; the theme plays here.
   3954  fd36							; No gravity/enemies/sound beyond the music (frame is title-owned; timer
   3955  fd36							; frozen). SELECT cycles Level, RESET starts the game at the selected level.
   3956  fd36							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3957  fd36							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3958  fd36							;	    the intro exit ate the first press and made #2 read as dead)
   3959  fd36							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3960  fd36							;	    the real drop-in → gameplay starts
   3961  fd36							; ($FD reaches here directly — merged title, 2026-10-19.)
   3962  fd36							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3963  fd36							; title-owned; the first play frame rewrites it as the step budget).
   3964  fd36							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3965  fd36							; ------------------------------------------------------------------------------
   3966  fd36				   TitleWork
   3967  fd36							; --- SELECT edge (TitleSelect, fill region) ---
   3968  fd36		       20 4f fc 	      jsr	CallPad_TitleSelect
   3969  fd39		       90 03		      bcc	.TWselDone	; C=0: no edge
   3970  fd3b		       20 20 fc 	      jsr	LoadLevel	; preview + HUD score follow the selected level
   3971  fd3e				   .TWselDone
   3972  fd3e							; --- RESET edge ---
   3973  fd3e		       a5 97		      lda	StepsLeft
   3974  fd40		       29 01		      and	#%00000001
   3975  fd42		       f0 14		      beq	.TWrstDone
   3976  fd44		       ad 82 02 	      lda	SWCHB
   3977  fd47		       29 01		      and	#%00000001
   3978  fd49		       d0 0d		      bne	.TWrstDone
   3979  fd4b		       a9 00		      lda	#0
   3980  fd4d		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3981  fd4f		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3982  fd51		       85 f4		      sta	ScoreHu
   3983  fd53		       85 f5		      sta	ScoreTe
   3984  fd55		       20 20 fc 	      jsr	LoadLevel
   3985  fd58				   .TWrstDone
   3986  fd58		       ad 82 02 	      lda	SWCHB
   3987  fd5b		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3988  fd5d							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3989  fd5d							;     channel force-muted here — UpdateJetSound is skipped because
   3990  fd5d							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3991  fd5d							;     = 0, AUDV0 covered above). ---
   3992  fd5d				   TitleTailAudio		; tail: TitleWork falls in (no rts)
   3993  fd5d		       a5 8a		      lda	DropTarget	; merged title ($FF): music owns AUD0/AUD1,
   3994  fd5f		       c9 ff		      cmp	#$FF	;   no bomb fuse/tick on title frames
   3995  fd61		       f0 0e		      beq	.TWmusic
   3996  fd63		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3997  fd65		       20 88 f5 	      jsr	BombTick
   3998  fd68				   .TWnoTick
   3999  fd68		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   4000  fd6b		       a9 00		      lda	#0
   4001  fd6d		       85 1a		      sta	AUDV1
   4002  fd6f		       f0 03		      beq	.TWwait	; A=0 -> always taken
   4003  fd71				   .TWmusic		; title: music wins the audio regs
   4004  fd71		       20 55 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   4005  fd74				   .TWwait
   4006  fd74		       ad 84 02 	      lda	INTIM
   4007  fd77		       d0 fb		      bne	.TWwait
   4008  fd79		       4c 39 f0 	      jmp	StartFrame
