   2592  f9c8							;   the player contract — Ball.hxx/Missile.hxx
   2593  f9c8							;   renderCounterOffset=-4 vs Player.hxx=-5
   2594  f9c8							;   (same class as the M1 +1 below)
   2595  f9c8		       a2 04		      ldx	#4	; selector 4: HMP0+4=HMBL, RESP0+4=RESPBL
   2596  f9ca		       20 0f ff 	      jsr	SetObjectXPos
