   2219  f62f							; ==============================================================================
   2220  f62f							; SelectActiveObject — choose the single GRP1 object to draw this frame (A1
   2221  f62f							; revert: back in bank0; C1's bank2 copy is gone). TIA has one GRP1 sprite, so
   2222  f62f							; objects flicker by rotating slots. Sets ObjBase, ActiveObjectX,
   2223  f62f							; ActiveObjectY, ObjTop, COLUP1 and P1's hardware X (SetObjectXPos).
   2224  f62f							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   2225  f62f							; The enemy TYPE byte is level data in bank2/bank3 → FoldIndirect; the
   2226  f62f							; room-dark test is bank1's IsRoomDark → CallPad_IsRoomDark.
   2227  f62f							; ==============================================================================
   2228  f62f				   SelectActiveObject
   2229  f62f							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   2230  f62f							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   2231  f62f							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   2232  f62f							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   2233  f62f							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   2234  f62f							; middle of the screen" the moment the points counting started).
   2235  f62f		       a5 8a		      lda	DropTarget
   2236  f631		       c9 fe		      cmp	#$FE
   2237  f633		       d0 2d		      bne	.SOFull
   2238  f635		       a9 00		      lda	#0
   2239  f637		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   2240  f639		       a9 ff		      lda	#$FF
   2241  f63b		       85 b6		      sta	ObjBase	; $FF = no object (0 is the KEY design — the old
   2242  f63d							;   `0 = no object` comment was wrong and the
   2243  f63d							;   tally-without-miner frame staged ObjTop from
   2244  f63d							;   a stale Y, i.e. a stray key sprite)
   2245  f63d		       a5 a4		      lda	LevelMinerRoom
   2246  f63f		       29 7f		      and	#$7f
   2247  f641		       c5 98		      cmp	RoomNo
   2248  f643		       f0 03		      beq	.SOTallyMiner
   2249  f645		       4c 40 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   2250  f648				   .SOTallyMiner
   2251  f648		       a9 55		      lda	#OBJ_MINER
   2252  f64a		       85 b6		      sta	ObjBase
   2253  f64c		       a9 10		      lda	#OBJ_WINDOW	; miner design height (tally path)
   2254  f64e		       85 9d		      sta	ObjHeight
