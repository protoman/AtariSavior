   2613  f7d2							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2614  f7d2							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF5`
   2615  f7d2							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2616  f7d2							; not from here. That is the same FoldIndirect discipline every other tramp
   2617  f7d2							; uses — the twin cannot be skipped or shortened.
   2618  f7d2							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2619  f7d2							; ------------------------------------------------------------------------------
   2620  f7d2							; M1ColFromMeta — A = the async M1 sprite column (M1X) for this room, or 0 when
   2621  f7d2							; the room carries no side-1 patch.
   2622  f7d2							; MetaA ($99, RoomPF0Lo here) = ((m1_col+1) << 4) | band_mask | b3, written
   2623  f7d2							; convert_room.meta_bytes; M1X = 8*col + 7 is that field's inverse. Deriving it
   2624  f7d2							; here (instead of staging at room load) keeps bank3's pinned code untouched,
   2625  f7d2							; and it feeds the hot-overlap box test too, which reads M1X.
   2626  f7d2							; Flags: Z is left SET when A = 0, so the caller can branch right after.
   2627  f7d2							; ------------------------------------------------------------------------------
   2628  f7d2							; ------------------------------------------------------------------------------
   2629  f7d2							; DoorLocked — a locked door (M1 patch cell, PF-open) hit by the player.
   2630  f7d2							; In: nothing new (the overlay's box scratch is live). Out: C=1 blocked, or a
   2631  f7d2							; tail jump into HotOverlapFlag when the room is HOT, where the overlap body
   2632  f7d2							; also gets to apply the hot hit.
   2633  f7d2							; Why: the locked case used to jump straight to HotOverlapFlag, and its bank3
   2634  f7d2							; body returns C=0 when the hot stream has no hit — a cold room's door was
   2635  f7d2							; therefore walk-through (user report: "door is not solid, neither with nor
   2636  f7d2							; without the key").
   2637  f7d2							; ------------------------------------------------------------------------------
   2638  f7d2				   DoorLocked
   2639  f7d2		       a5 9a		      lda	RoomPF0Hi	; staged MetaB
   2640  f7d4		       29 40		      and	#$40	; b6 = mid_band_type hot shape
   2641  f7d6		       d0 02		      bne	.DLhot
   2642  f7d8		       38		      sec		; cold room: the door is simply solid
   2643  f7d9		       60		      rts
   2644  f7da				   .DLhot
   2645  f7da		       4c ec ff 	      jmp	HotOverlapFlag	; hot band: overlap body owns the hit (C=1)
   2646  f7dd
   2647  f7dd				   M1ColFromMeta
   2648  f7dd		       a5 ba		      lda	EnemyDeadMask
   2649  f7df		       29 10		      and	#$10	; b4 = M1 strip destroyed -> transparent
   2650  f7e1		       d0 1c		      bne	.M1Cgone	;   (the collision overlay honours the same
   2651  f7e3							;   bit, so the sprite now dies with it)
   2652  f7e3		       a5 99		      lda	RoomPF0Lo	; bank3 stages MetaA over this dead pointer byte
   2653  f7e5		       4a		      lsr
   2654  f7e6		       4a		      lsr
   2655  f7e7		       4a		      lsr
   2656  f7e8		       4a		      lsr		; A = m1_col+1 (0 = no side-1 strip)
   2657  f7e9		       f0 18		      beq	.M1Cnone
   2658  f7eb		       0a		      asl
   2659  f7ec		       0a		      asl
   2660  f7ed		       0a		      asl		; 8*(col+1)
   2661  f7ee		       38		      sec
   2662  f7ef		       e9 01		      sbc	#1	; 8*col+7 = the LEFT-half M1 column
   2663  f7f1		       48		      pha
   2664  f7f2		       a5 99		      lda	RoomPF0Lo
   2665  f7f4		       29 01		      and	#$01	; MetaA b0 = strip on the RIGHT half
   2666  f7f6		       f0 05		      beq	.M1Cleft
   2667  f7f8		       68		      pla
   2668  f7f9		       18		      clc
   2669  f7fa		       69 50		      adc	#80	; right half: 87 + 8*col
   2670  f7fc		       60		      rts		; Z clear
   2671  f7fd				   .M1Cleft
   2672  f7fd		       68		      pla
   2673  f7fe		       60		      rts		; A = 7 + 8*col, Z clear
   2674  f7ff				   .M1Cgone
   2675  f7ff		       a9 00		      lda	#0
   2676  f801		       85 b0		      sta	M1X	; strip destroyed: keep the byte honest too
   2677  f803				   .M1Cnone
   2678  f803		       60		      rts		; A = 0, Z set -> caller skips the sprite
