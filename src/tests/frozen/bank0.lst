   3735  ff5e		       d0 3a		      bne	.LaserInit
   3736  ff60							; --- travel: +/-4 px toward the facing (PlayerDir live), capped at the
   3737  ff60							; old S3 sweep extent (SweepOff max 16: right tip <= RoomX+20, left
   3738  ff60							; floor max(RoomX-20,0)) — past the cap restarts at the eye, the
   3739  ff60							; triangle-loop feel of the sweep (user: beam "moved way beyond the
   3740  ff60							; limit"). RectCount = free scratch (LWC re-owns it for its row walk).
   3741  ff60				   .LAdvStep
   3742  ff60		       a4 82		      ldy	PlayerDir
   3743  ff62		       a5 83		      lda	LaserX
   3744  ff64		       18		      clc
   3745  ff65		       79 de ff 	      adc	StepDelta,y	; dir 0 = +4, dir 1 = -4 (table after eye)
   3746  ff68				   .LAdvS
   3747  ff68		       85 92		      sta	RectCount	; candidate (not committed yet)
   3748  ff6a		       c9 a0		      cmp	#160	; right edge >=160 OR left underflow wrap
   3749  ff6c		       90 03		      bcc	.LAdvCap
   3750  ff6e		       4c 9a ff 	      jmp	.LaserInit
   3751  ff71				   .LAdvCap
   3752  ff71		       a5 82		      lda	PlayerDir
   3753  ff73		       d0 0c		      bne	.LAdvCapL
   3754  ff75		       a5 80		      lda	RoomX
   3755  ff77		       18		      clc
   3756  ff78		       69 14		      adc	#20	; old max tip = RoomX + 4 + SweepOff(16)
   3757  ff7a		       c5 92		      cmp	RectCount
   3758  ff7c		       b0 15		      bcs	.LAdvKeep	; cap >= cand -> within old laser extent
   3759  ff7e		       4c 9a ff 	      jmp	.LaserInit
   3760  ff81				   .LAdvCapL
   3761  ff81		       a5 80		      lda	RoomX
   3762  ff83		       38		      sec
   3763  ff84		       e9 14		      sbc	#20
   3764  ff86		       b0 02		      bcs	.LAdvCapLs
   3765  ff88		       a9 00		      lda	#0	; old left clamp floor (extent >= 0)
   3766  ff8a				   .LAdvCapLs
   3767  ff8a		       c5 92		      cmp	RectCount	; cap vs cand
   3768  ff8c		       f0 05		      beq	.LAdvKeep
   3769  ff8e		       90 03		      bcc	.LAdvKeep	; cap < cand -> cand still above floor
   3770  ff90		       4c 9a ff 	      jmp	.LaserInit
   3771  ff93				   .LAdvKeep
   3772  ff93		       a5 92		      lda	RectCount
   3773  ff95		       85 83		      sta	LaserX
   3774  ff97		       4c 9d ff 	      jmp	.LaserGo	; committed: skip the eye restart
   3775  ff9a				   .LaserInit
   3776  ff9a		       20 c4 ff 	      jsr	.LaserEye	; edge/offscreen: restart at the eye
   3777  ff9d				   .LaserGo
   3778  ff9d		       a5 83		      lda	LaserX
   3779  ff9f		       85 8b		      sta	CollisionX	; cur arg for LaserHitTest (drawn [A-7,A])
   3780  ffa1		       20 96 fe 	      jsr	LaserHitTest	; A = 0 / $50 kill / 1 lamp / 2 wall
   3781  ffa4		       f0 16		      beq	.LaserPos	; no contact: keep travelling
   3782  ffa6		       c9 50		      cmp	#$50
   3783  ffa8		       f0 0a		      beq	.LaserKill
   3784  ffaa		       c9 02		      cmp	#2
   3785  ffac		       f0 09		      beq	.LaserContact	; wall CONSUMES the missile (user 2026-10-10):
   3786  ffae							;   same as kill minus score — restart at
   3787  ffae							;   the eye THIS frame, buzz keeps (b7).
   3788  ffae							;   #9's blank + the wall-center hold clamp
   3789  ffae							;   both superseded: a contact missile is
   3790  ffae							;   consumed by walls. No hold state, no
   3791  ffae							;   cap reorder, no pass-through possible.
   3792  ffae		       20 26 fc 	      jsr	CallPad_SetRoomDark	; lamp crash = player-body touch (no kill)
   3793  ffb1		       4c b7 ff 	      jmp	.LaserContact
   3794  ffb4				   .LaserKill
   3795  ffb4		       20 1a fc 	      jsr	CallPad_AddScore	; A = $50 BCD (dead bit already set in body)
   3796  ffb7				   .LaserContact
   3797  ffb7		       20 c4 ff 	      jsr	.LaserEye	; consumed -> restart at the eye THIS frame
   3798  ffba		       e6 c0		      inc	LaserState	; b0 rearm: next held frame re-tests the eye
   3799  ffbc							; (b0 was 0: travel only runs with b0 clear,
   3800  ffbc							; rearm dec'd it before this init) — flush
