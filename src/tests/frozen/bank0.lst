   1895  f5ef							; ==============================================================================
   1896  f5ef							; SelectActiveObject — choose the single GRP1 object to draw this frame.
   1897  f5ef							; The TIA has one GRP1 sprite, so objects flicker by rotating slots each frame.
   1898  f5ef							; Sets ObjBase, ActiveObjectX, ActiveObjectY, ObjTop, COLUP1.
   1899  f5ef							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   1900  f5ef							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0
   1901  f5ef							; (~15 Hz); other frames normal miner/enemy rotation (FlickerFrame alone).
   1902  f5ef							; One GRP1: cannot draw bomb + entity same frame.
   1903  f5ef							; ------------------------------------------------------------------------------
   1904  f5ef				   SelectActiveObject
   1905  f5ef							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   1906  f5ef							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   1907  f5ef							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   1908  f5ef							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   1909  f5ef							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   1910  f5ef							; middle of the screen" the moment the points counting started).
   1911  f5ef		       a5 8a		      lda	DropTarget
   1912  f5f1		       c9 fe		      cmp	#$FE
   1913  f5f3		       d0 27		      bne	.SOFull
   1914  f5f5		       a9 00		      lda	#0
   1915  f5f7		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   1916  f5f9		       85 b6		      sta	ObjBase	; 0 = no object
   1917  f5fb		       a5 a4		      lda	LevelMinerRoom
   1918  f5fd		       29 7f		      and	#$7f
   1919  f5ff		       c5 98		      cmp	RoomNo
   1920  f601		       f0 03		      beq	.SOTallyMiner
   1921  f603		       4c eb f6 	      jmp	.SODone	; miner not here -> nothing drawn
   1922  f606				   .SOTallyMiner
   1923  f606		       a9 38		      lda	#OBJ_MINER
   1924  f608		       85 b6		      sta	ObjBase
   1925  f60a		       a5 a5		      lda	MinerX
   1926  f60c		       85 b7		      sta	ActiveObjectX
   1927  f60e		       a5 a6		      lda	MinerY
   1928  f610		       18		      clc
   1929  f611		       69 03		      adc	#3	; same 3px offset as the normal miner path
   1930  f613		       85 b8		      sta	ActiveObjectY
   1931  f615		       a9 66		      lda	#$66	; purple (hue 6, luma 3)
   1932  f617		       85 07		      sta	COLUP1
   1933  f619		       4c eb f6 	      jmp	.SODone
   1934  f61c				   .SOFull
   1935  f61c		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   1936  f61e							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   1937  f61e		       a5 b5		      lda	BombPacked
   1938  f620		       29 03		      and	#%00000011
   1939  f622		       c9 01		      cmp	#1
   1940  f624		       d0 19		      bne	.SOCount
   1941  f626		       a5 f7		      lda	BombTimer
   1942  f628		       29 03		      and	#3
   1943  f62a		       d0 13		      bne	.SOCount	; 3 of 4 -> miner/enemy
   1944  f62c		       a9 40		      lda	#OBJ_BOMB	; bomb design offset into ObjSprites
   1945  f62e		       85 b6		      sta	ObjBase
   1946  f630		       a5 f6		      lda	BombX
   1947  f632		       85 b7		      sta	ActiveObjectX
   1948  f634		       a5 85		      lda	BombY
   1949  f636		       85 b8		      sta	ActiveObjectY
   1950  f638		       a9 46		      lda	#COLOR_BOMBS	; $46 red (P1 X set by the .SODone tail)
   1951  f63a		       85 07		      sta	COLUP1
   1952  f63c		       4c eb f6 	      jmp	.SODone	; ObjTop/Bot from ActiveObjectY
   1953  f63f				   .SOCount
   1954  f63f							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
   1955  f63f		       a5 b3		      lda	EnemyCount
   1956  f641		       85 88		      sta	Temp
   1957  f643		       a5 a4		      lda	LevelMinerRoom
   1958  f645		       29 7f		      and	#$7f
   1959  f647		       c5 98		      cmp	RoomNo
   1960  f649		       d0 02		      bne	.SONoMiner
   1961  f64b		       e6 88		      inc	Temp	; miner counts as a slot
   1962  f64d				   .SONoMiner
   1963  f64d		       a5 88		      lda	Temp
   1964  f64f		       d0 09		      bne	.SONotNothing
   1965  f651							; No objects this frame: A = Temp = 0. Blank the sprite AND reset the
   1966  f651							; flicker counter — with no objects the modulo below never runs, so
   1967  f651							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   1968  f651							; would run O(FlickerFrame) iterations in the VBL on the next room with
   1969  f651							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   1970  f651		       85 b4		      sta	FlickerFrame
   1971  f653		       a9 ff		      lda	#$FF
   1972  f655		       85 b6		      sta	ObjBase
   1973  f657		       4c eb f6 	      jmp	.SODone
   1974  f65a				   .SONotNothing
   1975  f65a							; FlickerFrame already advanced at entry — modulo into 0..(slot count-1)
   1976  f65a				   .SOModLoop
   1977  f65a		       a5 b4		      lda	FlickerFrame
   1978  f65c		       c5 88		      cmp	Temp
   1979  f65e		       90 08		      bcc	.SOModDone
   1980  f660		       38		      sec
   1981  f661		       e5 88		      sbc	Temp
   1982  f663		       85 b4		      sta	FlickerFrame
   1983  f665		       4c 5a f6 	      jmp	.SOModLoop
   1984  f668				   .SOModDone
   1985  f668							; FlickerFrame is now 0..(slot count-1)
   1986  f668							; Check if slot 0 is the miner
   1987  f668		       a5 b4		      lda	FlickerFrame
   1988  f66a		       d0 1c		      bne	.SOEnemy
   1989  f66c		       a5 88		      lda	Temp
   1990  f66e		       c5 b3		      cmp	EnemyCount
   1991  f670		       f0 16		      beq	.SOEnemy	; no miner slot in this room
   1992  f672							; This slot is the miner
