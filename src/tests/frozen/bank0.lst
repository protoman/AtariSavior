   3433  ff0f							; ==============================================================================
   3434  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3435  ff0f							; ==============================================================================
   3436  ff0f							; Andrew Davie session-24 routine:
   3437  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3438  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3439  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3440  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3441  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3442  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3443  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3444  ff0f							;
   3445  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3446  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3447  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3448  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3449  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3450  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3451  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3452  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3453  ff0f				   SetObjectXPos subroutine
   3454  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   3455  ff11		       38		      sec		; ensure carry flag
   3456  ff12				   .Div15Loop
   3457  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   3458  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   3459  ff16		       a8		      tay		; Y = remainder in -15..-1
   3460  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   3461  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   3462  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   3463  ff1e		       60		      rts
   3464  ff1f
   3465  ff20					      org	$FF20
   3466  ff20
   3467  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   3468  ff20				   SetObjReflection
   3469  ff20		       a9 00		      lda	#0
   3470  ff22		       85 0c		      sta	REFP1
   3471  ff24		       a5 b6		      lda	ObjBase
   3472  ff26		       c9 38		      cmp	#OBJ_MINER
   3473  ff28		       d0 08		      bne	.SORdone
   3474  ff2a		       a5 a4		      lda	LevelMinerRoom
   3475  ff2c		       10 04		      bpl	.SORdone
   3476  ff2e		       a9 08		      lda	#$08
   3477  ff30		       85 0c		      sta	REFP1
   3478  ff32				   .SORdone
   3479  ff32		       60		      rts
   3480  ff33
   3481  ff33							; ------------------------------------------------------------------------------
   3482  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   3483  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   3484  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   3485  ff33							; user spec: no piercing, no HERO comparison needed).
   3486  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   3487  ff33							;						  left	RoomX-4)
   3488  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   3489  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   3490  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   3491  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   3492  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   3493  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   3494  ff33							;     priority over M0 anyway).
   3495  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   3496  ff33							;     press edge re-anchors).
   3497  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   3498  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   3499  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   3500  ff33							; (BeamMask = $02 shares b1 — ENAM0 = BeamMask & LaserState; the old
   3501  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   3502  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   3503  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   3504  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   3505  ff33							; ------------------------------------------------------------------------------
   3506  ff33				   LaserInput
   3507  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   3508  ff35		       8a		      txa
   3509  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   3510  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   3511  ff3a		       8a		      txa
   3512  ff3b		       29 80		      and	#LASER_HELD
   3513  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   3514  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   3515  ff40		       85 c0		      sta	LaserState
   3516  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   3517  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   3518  ff46							; below — moved here so the cap code could
   3519  ff46							; not push .LaserReleased past bmi's ±127)
   3520  ff46				   .LaserReleased
   3521  ff46		       a9 00		      lda	#0
   3522  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
