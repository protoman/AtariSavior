   3550  feb4		       d0 04		      bne	.TNotWrap
   3551  feb6		       a9 00		      lda	#0	; wrap past last level
   3552  feb8		       85 a3		      sta	Level
   3553  feba				   .TNotWrap
   3554  feba		       a9 00		      lda	#0
   3555  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
