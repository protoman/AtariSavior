   3426  fe9f		       a8		      tay
   3427  fea0		       29 01		      and	#1
   3428  fea2		       f0 05		      beq	.TNoScore
   3429  fea4		       a9 50		      lda	#$50	; BCD +50 per tick (pack is $50 exactly)
   3430  fea6		       20 0b fc 	      jsr	CallPad_AddScore
   3431  fea9				   .TNoScore
   3432  fea9		       98		      tya
   3433  feaa		       29 04		      and	#4
   3434  feac		       f0 1e		      beq	.TLive
   3435  feae		       e6 a3		      inc	Level	; --- done: advance (old CheckMinerPickup tail)
   3436  feb0		       a5 a3		      lda	Level
   3437  feb2		       c9 04		      cmp	#LEVEL_COUNT
   3438  feb4		       d0 04		      bne	.TNotWrap
   3439  feb6		       a9 00		      lda	#0	; wrap past last level
   3440  feb8		       85 a3		      sta	Level
   3441  feba				   .TNotWrap
   3442  feba		       a9 00		      lda	#0
   3443  febc		       85 8a		      sta	DropTarget	; clear $FE BEFORE LoadLevel — DropArm's new
