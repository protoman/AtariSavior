   2678  f809		       29 7f		      and	#$7f
   2679  f80b		       c5 98		      cmp	RoomNo
   2680  f80d		       d0 03		      bne	.SOSkipOther
   2681  f80f		       4c bc f6 	      jmp	.SOMinerDraw
   2682  f812				   .SOSkipOther
   2683  f812		       a5 b9		      lda	EnemyIndex
   2684  f814		       49 01		      eor	#1
   2685  f816		       aa		      tax
   2686  f817		       c5 b3		      cmp	EnemyCount
   2687  f819		       b0 0c		      bcs	.SOSkipNone	; no such enemy
   2688  f81b		       a5 ba		      lda	EnemyDeadMask
   2689  f81d		       3d c9 f3 	      and	EnemyBitTable,X
   2690  f820		       d0 05		      bne	.SOSkipNone	; partner dead too
   2691  f822		       86 b9		      stx	EnemyIndex
   2692  f824		       4c f5 f6 	      jmp	.SOEnemyLive
   2693  f827				   .SOSkipNone
   2694  f827		       a9 ff		      lda	#$FF
   2695  f829		       85 b6		      sta	ObjBase
