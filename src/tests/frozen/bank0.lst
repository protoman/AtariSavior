   2240  f6a2							; flicker counter — with no objects the modulo below never runs, so
   2241  f6a2							; FlickerFrame would grow unbounded and .SOModLoop (a subtract loop)
   2242  f6a2							; would run O(FlickerFrame) iterations in the VBL on the next room with
   2243  f6a2							; objects (measured +533c / +7 lines room-crossing spike, 2026-10-16).
   2244  f6a2		       85 b4		      sta	FlickerFrame
