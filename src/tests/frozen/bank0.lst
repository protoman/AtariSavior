    893  f0f7							; --- Phase 5: is the second GRP1 object in THIS band? ---------------
    894  f0f7							; Sits in the setup window's free tail (~59c after PF2, before the WSYNC
    895  f0f7							; that ends the pass, so the phased stores above never move). The early
    896  f0f7							; out costs 5c; Slot1Hook pays 2 extra lines ONLY on the band that hosts
    897  f0f7							; slot 1 (SetObjectXPos WSYNC line + the HMOVE line).
    898  f0f7		       a5 ea		      lda	ObjBase1	; $FF = none. `bmi` is still valid HERE (slot 1
    899  f0f9		       30 03		      bmi	Slot1Keep	;   only holds an enemy design or the miner,
    900  f0fb							;   all < $80; the bomb never reaches slot 1).
    901  f0fb							;   Slot 0 must use `cmp #$FF` — see .SODone.
    902  f0fb		       4c 60 f7 	      jmp	Slot1Hook	; NOT jsr: when the hook positions P1 it owns
