   1532  f3fb		       29 07		      and	#7	;   halved from /4 — it read as too fast)
   1533  f3fd		       d0 3e		      bne	UE_Next
   1534  f3ff							; live dir bit: 1 = right, 0 = left
   1535  f3ff		       bd cf f3 	      lda	EnemyBitTable,X
   1536  f402		       25 c1		      and	EnemyRamD
