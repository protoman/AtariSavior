   1957  f60c							; ==============================================================================
   1958  f60c							; SelectActiveObject — choose the single GRP1 object to draw this frame.
   1959  f60c							; The TIA has one GRP1 sprite, so objects flicker by rotating slots each frame.
   1960  f60c							; Sets ObjBase, ActiveObjectX, ActiveObjectY, ObjTop, COLUP1.
   1961  f60c							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
   1962  f60c							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0
   1963  f60c							; (~15 Hz); other frames normal miner/enemy rotation (FlickerFrame alone).
   1964  f60c							; One GRP1: cannot draw bomb + entity same frame.
   1965  f60c							; ------------------------------------------------------------------------------
   1966  f60c				   SelectActiveObject
   1967  f60c							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
   1968  f60c							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
   1969  f60c							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
   1970  f60c							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
   1971  f60c							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
   1972  f60c							; middle of the screen" the moment the points counting started).
   1973  f60c		       a5 8a		      lda	DropTarget
   1974  f60e		       c9 fe		      cmp	#$FE
   1975  f610		       d0 27		      bne	.SOFull
   1976  f612		       a9 00		      lda	#0
   1977  f614		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
   1978  f616		       85 b6		      sta	ObjBase	; 0 = no object
   1979  f618		       a5 a4		      lda	LevelMinerRoom
   1980  f61a		       29 7f		      and	#$7f
   1981  f61c		       c5 98		      cmp	RoomNo
   1982  f61e		       f0 03		      beq	.SOTallyMiner
   1983  f620		       4c 08 f7 	      jmp	.SODone	; miner not here -> nothing drawn
   1984  f623				   .SOTallyMiner
   1985  f623		       a9 38		      lda	#OBJ_MINER
