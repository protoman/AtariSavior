   1820  f591							; LoadLevel: read LevelDataTable entry for current Level, init pointers, enter room.
   1821  f591							; LevelDataTable stride: 14 bytes
   1822  f591							;   +0..+2: start_room, start_x, start_y
   1823  f591							;   +3..+5: miner_room (b7 = faces right), miner_x, miner_y
   1824  f591							;   +6..+7: pfdata ptr (lo, hi)
   1825  f591							;   +8..+9: conn ptr (lo, hi)
   1826  f591							;  +10..+11: enemy ptr (lo, hi)
