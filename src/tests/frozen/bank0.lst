   3441  fecf		       a9 00		      lda	#0
   3442  fed1		       85 1a		      sta	AUDV1	; jet muted (UpdateJetSound skipped)
   3443  fed3				   .TWait
   3444  fed3		       ad 84 02 	      lda	INTIM
   3445  fed6		       d0 fb		      bne	.TWait
   3446  fed8		       4c 39 f0 	      jmp	StartFrame
