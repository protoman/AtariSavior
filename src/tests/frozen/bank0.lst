   3274  fd5f							;   tail-jumps (label — jumps, not falls)
   3275  fd5f		       a5 8a		      lda	DropTarget	; title sentinels ($FD/$FF/$FE): the intro's
   3276  fd61		       c9 fd		      cmp	#$FD	;   TitleSequence owns its fuse — skip
   3277  fd63		       f0 0e		      beq	.TWmusic	;   $FD intro: music owns AUD0/AUD1
   3278  fd65		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
