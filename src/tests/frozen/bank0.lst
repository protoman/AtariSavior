   3669  ff00							; ==============================================================================
   3670  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   3671  ff00							; ==============================================================================
   3672  ff00					      org	$FF00
   3673  ff00				   fineAdjustBegin
   3674  ff00		       70		      .byte.b	%01110000	; left 7
   3675  ff01		       60		      .byte.b	%01100000	; left 6
   3676  ff02		       50		      .byte.b	%01010000	; left 5
   3677  ff03		       40		      .byte.b	%01000000	; left 4
   3678  ff04		       30		      .byte.b	%00110000	; left 3
   3679  ff05		       20		      .byte.b	%00100000	; left 2
   3680  ff06		       10		      .byte.b	%00010000	; left 1
   3681  ff07		       00		      .byte.b	%00000000	; no movement
   3682  ff08		       f0		      .byte.b	%11110000	; right 1
   3683  ff09		       e0		      .byte.b	%11100000	; right 2
   3684  ff0a		       d0		      .byte.b	%11010000	; right 3
   3685  ff0b		       c0		      .byte.b	%11000000	; right 4
   3686  ff0c		       b0		      .byte.b	%10110000	; right 5
   3687  ff0d		       a0		      .byte.b	%10100000	; right 6
   3688  ff0e		       90		      .byte.b	%10010000	; right 7
   3689  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   3690  ff0f
   3691  ff0f							; ==============================================================================
   3692  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   3693  ff0f							; ==============================================================================
   3694  ff0f							; Andrew Davie session-24 routine:
   3695  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   3696  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   3697  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   3698  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   3699  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   3700  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   3701  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   3702  ff0f							;
   3703  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   3704  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   3705  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   3706  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   3707  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   3708  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   3709  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   3710  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   3711  ff0f				   SetObjectXPos subroutine
   3712  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   3713  ff11		       38		      sec		; ensure carry flag
   3714  ff12				   .Div15Loop
   3715  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   3716  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   3717  ff16		       a8		      tay		; Y = remainder in -15..-1
   3718  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   3719  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   3720  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   3721  ff1e		       60		      rts
   3722  ff1f
   3723  ff20					      org	$FF20
   3724  ff20
   3725  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   3726  ff20				   SetObjReflection
   3727  ff20		       a9 00		      lda	#0
   3728  ff22		       85 0c		      sta	REFP1
   3729  ff24		       a5 b6		      lda	ObjBase
   3730  ff26		       c9 38		      cmp	#OBJ_MINER
   3731  ff28		       d0 08		      bne	.SORdone
   3732  ff2a		       a5 a4		      lda	LevelMinerRoom
   3733  ff2c		       10 04		      bpl	.SORdone
   3734  ff2e		       a9 08		      lda	#$08
   3735  ff30		       85 0c		      sta	REFP1
   3736  ff32				   .SORdone
   3737  ff32		       60		      rts
