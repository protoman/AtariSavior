    744  f0f3							;   COLUP1 w c51 x332 (D6 M1 band color — AFTER the left half, so the
    745  f0f3							;     transition line keeps the OLD band's M1/P1 color on the left, same
    746  f0f3							;     rule as COLUPF) |
