   3187  fd38							; ------------------------------------------------------------------------------
   3188  fd38							; TitleWork — level-select screen (DropTarget = $FF sentinel, dispatched from
   3189  fd38							; DropStep every frame). Player stands at the level start: no gravity, no
   3190  fd38							; enemies (count/miner cleared by DropArm .DATitle), no sound, timer frozen
   3191  fd38							; (tail skips the TickCounter/BarLevel block). HUD score = level+1.
   3192  fd38							;   SELECT (SWCHB b1, active-low EDGE) → jsr TitleSelect (fill): level+1,
   3193  fd38							;	    wrap → 000001, reload room 0 (swallow removed 2026-10-07, 8b —
   3194  fd38							;	    the intro exit ate the first press and made #2 read as dead)
   3195  fd38							;   RESET  (SWCHB b0, active-low EDGE) → score 000000, LoadLevel tail arms
   3196  fd38							;	    the real drop-in → gameplay starts
   3197  fd38							; (Intro $FD never reaches here — DropStep routes it to TitleIntro.)
   3198  fd38							; StepsLeft = previous SWCHB sample (physics is skipped on title, so it is
   3199  fd38							; title-owned; the first play frame rewrites it as the step budget).
   3200  fd38							; Console switches are read again after any jsr (LoadLevel clobbers X/Y/A).
   3201  fd38							; ------------------------------------------------------------------------------
   3202  fd38				   TitleWork
   3203  fd38							; --- SELECT edge (TitleSelect, fill region) ---
   3204  fd38		       20 4f fc 	      jsr	CallPad_TitleSelect
   3205  fd3b		       90 03		      bcc	.TWselDone	; C=0: no edge
   3206  fd3d		       20 91 f5 	      jsr	LoadLevel	; title arm re-runs → score/objects refreshed
   3207  fd40				   .TWselDone
   3208  fd40							; --- RESET edge ---
   3209  fd40		       a5 97		      lda	StepsLeft
   3210  fd42		       29 01		      and	#%00000001
   3211  fd44		       f0 14		      beq	.TWrstDone
   3212  fd46		       ad 82 02 	      lda	SWCHB
   3213  fd49		       29 01		      and	#%00000001
   3214  fd4b		       d0 0d		      bne	.TWrstDone
   3215  fd4d		       a9 00		      lda	#0
   3216  fd4f		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3217  fd51		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3218  fd53		       85 f4		      sta	ScoreHu
   3219  fd55		       85 f5		      sta	ScoreTe
   3220  fd57		       20 91 f5 	      jsr	LoadLevel
   3221  fd5a				   .TWrstDone
   3222  fd5a		       ad 82 02 	      lda	SWCHB
   3223  fd5d		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3224  fd5f							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
   3225  fd5f							;     channel force-muted here — UpdateJetSound is skipped because
   3226  fd5f							;     $FF would read as "falling" and buzz; laser skipped (LaserState
   3227  fd5f							;     = 0, AUDV0 covered above). ---
   3228  fd5f				   TitleTailAudio		; shared: TitleWork falls in; TitleIntro
   3229  fd5f							;   tail-jumps (label — jumps, not falls)
   3230  fd5f		       a5 8a		      lda	DropTarget	; title sentinels ($FD/$FF/$FE): the intro's
   3231  fd61		       c9 fd		      cmp	#$FD	;   TitleSequence owns its fuse — skip
   3232  fd63		       f0 0e		      beq	.TWmusic	;   $FD intro: music owns AUD0/AUD1
   3233  fd65		       d0 03		      bne	.TWnoTick	;   BombTick's blast side effects on titles
   3234  fd67		       20 cb f7 	      jsr	BombTick
   3235  fd6a				   .TWnoTick
   3236  fd6a		       20 fc fb 	      jsr	CallPad_UpdateBombSound
   3237  fd6d		       a9 00		      lda	#0
   3238  fd6f		       85 1a		      sta	AUDV1
   3239  fd71		       f0 03		      beq	.TWwait	; A=0 -> always taken
   3240  fd73				   .TWmusic		; intro: tick AFTER TitleSequence so the music
   3241  fd73		       20 61 fc 	      jsr	CallPad_MusicTick	;   wins the audio registers every frame
   3242  fd76				   .TWwait
