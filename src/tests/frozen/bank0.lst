    724  f09d		       90 05		      bcc	.TideBase	; p 1-3: off = p (A holds it)
    725  f09f		       49 ff		      eor	#$FF	; p 4-7: off = 7-p
    726  f0a1		       38		      sec
    727  f0a2		       69 07		      adc	#7	; ~p + 7 + 1 = 7-p (mod 256)
