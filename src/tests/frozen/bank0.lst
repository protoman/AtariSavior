   2244  f7a6		       d0 39		      bne	.BTDone
   2245  f7a8		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2246  f7aa		       29 fc		      and	#%11111100
   2247  f7ac		       85 b5		      sta	BombPacked
   2248  f7ae		       a9 00		      lda	#0
