   2597  f9c3		       f0 08		      beq	.M1
   2598  f9c5		       18		      clc
   2599  f9c6		       69 01		      adc	#1	; #9: Stella draws ball/missile 1 clock left of
   2600  f9c8							;   the player contract — Ball.hxx/Missile.hxx
