   3235  fd34		       90 00		      bcc	.TWselDone	; C=0: no edge
   3236  fd36							; No LoadLevel here: the merged title renders no room and the digits band
   3237  fd36							; reads Level directly (2026-10-19).
   3238  fd36				   .TWselDone
   3239  fd36							; --- RESET edge ---
   3240  fd36		       a5 97		      lda	StepsLeft
   3241  fd38		       29 01		      and	#%00000001
   3242  fd3a		       f0 14		      beq	.TWrstDone
   3243  fd3c		       ad 82 02 	      lda	SWCHB
   3244  fd3f		       29 01		      and	#%00000001
   3245  fd41		       d0 0d		      bne	.TWrstDone
   3246  fd43		       a9 00		      lda	#0
   3247  fd45		       85 8a		      sta	DropTarget	; leave title → LoadLevel tail arms real fall
   3248  fd47		       85 f3		      sta	ScoreTh	; gameplay score starts at 000000
   3249  fd49		       85 f4		      sta	ScoreHu
   3250  fd4b		       85 f5		      sta	ScoreTe
   3251  fd4d		       20 52 f5 	      jsr	LoadLevel
   3252  fd50				   .TWrstDone
   3253  fd50		       ad 82 02 	      lda	SWCHB
   3254  fd53		       85 97		      sta	StepsLeft	; remember sample for next frame's edges
   3255  fd55							; --- Frame audio: ch0 silenced by UpdateBombSound (BombSnd=0); jet
