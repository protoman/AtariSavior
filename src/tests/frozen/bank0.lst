   1279  f278							; --- Clamp fall speed: down at MAX_FALL, up at -$0100. ---
   1280  f278							; The high byte alone is NOT enough (2026-10-22): `cmp #>MAX_FALL` with vyHi
   1281  f278							; == $01 is EQUAL, so the old code rewrote vy to exactly $0180 for every speed
   1282  f278							; in $0100..$017F — a falling player's thrust was computed and then thrown
   1283  f278							; away every frame (vy: $0180 -> $0188 -> $0158 -> clamped back to $0180), so
   1284  f278							; the jet could not slow a fall at all. Compare the low byte when the high
   1285  f278							; bytes match.
   1286  f278		       a5 94		      lda	vyHi
   1287  f27a		       30 17		      bmi	.RiseClamp
   1288  f27c		       c9 01		      cmp	#>MAX_FALL
   1289  f27e		       90 1f		      bcc	.Integrate	; below 1 px/frame: no clamp
   1290  f280		       d0 06		      bne	.FallClamp	; above: clamp
   1291  f282		       a5 93		      lda	vyLo
   1292  f284		       c9 80		      cmp	#<MAX_FALL
   1293  f286		       90 17		      bcc	.Integrate	; $01xx but under MAX_FALL: no clamp
   1294  f288				   .FallClamp
   1295  f288		       a9 01		      lda	#>MAX_FALL
   1296  f28a		       85 94		      sta	vyHi
   1297  f28c		       a9 80		      lda	#<MAX_FALL
   1298  f28e		       85 93		      sta	vyLo
   1299  f290		       4c 9f f2 	      jmp	.Integrate
   1300  f293				   .RiseClamp
   1301  f293		       c9 ff		      cmp	#$ff	; vyHi == $ff -> |vy| <= $0100, keep it
   1302  f295		       b0 08		      bcs	.Integrate
   1303  f297		       a9 ff		      lda	#$ff
   1304  f299		       85 94		      sta	vyHi
   1305  f29b		       a9 00		      lda	#$00
   1306  f29d		       85 93		      sta	vyLo	; vy = -$0100
