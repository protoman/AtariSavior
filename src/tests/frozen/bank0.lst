   2250  f65c		       85 b8		      sta	ActiveObjectY
   2251  f65e		       a9 66		      lda	#$66	; purple (hue 6, luma 3)
   2252  f660		       85 07		      sta	COLUP1
   2253  f662		       4c 44 f7 	      jmp	.SODone
   2254  f665				   .SOFull
   2255  f665		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2256  f667							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2257  f667		       a5 b5		      lda	BombPacked
   2258  f669		       29 03		      and	#%00000011
   2259  f66b		       c9 01		      cmp	#1
   2260  f66d		       d0 1d		      bne	.SOCount
   2261  f66f		       a5 f7		      lda	BombTimer
   2262  f671		       29 03		      and	#3
   2263  f673		       d0 17		      bne	.SOCount	; 3 of 4 -> miner/enemy
