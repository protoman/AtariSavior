    957  f170		       85 1b		      sta	GRP0
    958  f172		       4c 21 f1 	      jmp	.Grp1
    959  f175				   .ObjZero
    960  f175		       d0 04		      bne	.ObjNoRes	; flags live from `cmp #PLAYER_HEIGHT` upstream:
    961  f177							; A==8 ONLY = first line below the window — the
    962  f177							; only line where COLUP1 still holds the object
    963  f177							; color (all other obj-out lines: band color from
    964  f177							; .Row is intact, or this line already restored).
