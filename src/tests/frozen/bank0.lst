   2036  f8de		       7e		      .byte.b	%01111110	; row 1
   2037  f8df		       7c		      .byte.b	%01111100	; row 2 — yellow face
   2038  f8e0		       7e		      .byte.b	%01111110	; row 3
   2039  f8e1		       7c		      .byte.b	%01111100	; row 4 — grey pack
   2040  f8e2		       fe		      .byte.b	%11111110	; row 5
   2041  f8e3		       fe		      .byte.b	%11111110	; row 6
   2042  f8e4		       3e		      .byte.b	%00111110	; row 7 — jet frame A
