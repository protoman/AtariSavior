   1123  f201							; --- Jet thrust accumulator: +1 every 4th frame while Up is held
   1124  f201							;     (cap JET_MAX). BUGS #31 (2026-10-11, clarified spec):
   1125  f201							;	 * spin-up: ÷4 ramp gate (EnemyRamP & 3) — net lift at exactly
   1126  f201							;	   60f = 1.0s of held-Up (user-confirmed "perfect").
   1127  f201							;	 * release -> FLOAT: JetPower takes b7 as the float flag and the
   1128  f201							;	   low 7 bits as a 54-frame countdown ($80|54 = $B6). Phase A:
   1129  f201							;	   gravity-only decel stops the climb in ~0.3s; then Y is pinned
   1130  f201							;	   (vy re-zeroed every frame) for ~0.5s (user retest: the first
   1131  f201							;	   1.0s hover was too long — halved); then the flag clears and
   1132  f201							;	   normal gravity resumes (fall ~0.85s after release). State
   1133  f201							;	   lives in JetPower, NOT
   1134  f201							;	   StepsLeft: StepsLeft is the RefreshEnemyY SWCHB latch's byte
   1135  f201							;	   (title edge-detect contract) and .UpSteps rewrites it every
   1136  f201							;	   rising frame — both clobbered a StepsLeft-based float.
   1137  f201							;	 * Sound is press-gated (SWCHA D4) — buzz starts on the press.
   1138  f201							;	 * +~50B here: absorbed by the pre-pad $F8DD pad slack
   1139  f201							;	   (headroom stays $FC67).
   1140  f201							; ------------------------------------------------------------------------------
   1141  f201		       a9 01		      lda	#%00000001	; test D0 (up, after 4x LSR)
   1142  f203		       24 88		      bit	Temp
   1143  f205		       d0 21		      bne	.JetDecay
   1144  f207		       a5 96		      lda	JetPower	; Up held: cancel an active float first
   1145  f209		       10 04		      bpl	.RampStart	;   (b7 flag) — WITHOUT this guard the
   1146  f20b		       a9 00		      lda	#0	;   clear would wipe JetPower every held
   1147  f20d		       85 96		      sta	JetPower	;   frame and the ramp could never build
   1148  f20f				   .RampStart
   1149  f20f		       a5 c2		      lda	EnemyRamP	; ramp gate: +1 only on the free-running
   1150  f211		       29 03		      and	#3	;   clock's phase 0 (every 4th frame)
   1151  f213		       d0 3f		      bne	.Gravity
   1152  f215		       a5 96		      lda	JetPower
   1153  f217		       c9 14		      cmp	#JET_MAX
   1154  f219		       b0 06		      bcs	.JetCapped
   1155  f21b		       18		      clc
