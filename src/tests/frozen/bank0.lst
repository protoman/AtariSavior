   4156  fd9d							; ColOff/ColMask — cell-walk lookup tables (cell_collision_plan).
   4157  fd9d							;   Indexed by LEFT-HALF source col 0-19 (PHM prologue mirrors right-half
   4158  fd9d							;   ranges before the walk; bank2 display-space walkers mirror first too).
   4159  fd9d							;   ColOff: byte offset from PF0Buf+row ($C3+row) to the register holding
   4160  fd9d							;   that col (0/4/8 = PF0/PF1/PF2 row byte, N=4 stride 4). ColMask: the col's
   4161  fd9d							;   bit in that byte — PF0 bit4+col (cols 0-3), PF1 MSB-first (4-11), PF2
   4162  fd9d							;   LSB-first (12-19); matches convert_room.pf_values (plan 0.2 spec, proven
   4163  fd9d							;   by tools/test_cell_map.py).
   4164  fd9d							;   (The standalone CellSolid leaf that lived here moved INTO
   4165  fd9d							;   PlayerHitsMap's walk as inline code — a jsr in the walk cost 2B of
   4166  fd9d							;   stack depth and would break sim_bomb_fuse's gameplay min-SP >= $F8
   4167  fd9d							;   guard; the post-pad slot keeps these tables abs,X-reachable.)
   4168  fd9d							; ------------------------------------------------------------------------------
   4169  fd9d		       00 00 00 00*ColOff     .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
   4170  fdb1		       10 20 40 80*ColMask    .byte.b	$10,$20,$40,$80,$80,$40,$20,$10,$08,$04,$02,$01
   4171  fdbd		       01 02 04 08*	      .byte.b	$01,$02,$04,$08,$10,$20,$40,$80
