   2570  f951		       a8		      tay		; Y = visible_left
   2571  f952		       4a		      lsr
   2572  f953		       4a		      lsr
   2573  f954		       c9 14		      cmp	#TILE_COLUMNS
   2574  f956		       90 07		      bcc	.firstOk
   2575  f958		       85 8b		      sta	CollisionX
   2576  f95a		       a9 27		      lda	#39
   2577  f95c		       38		      sec
   2578  f95d		       e5 8b		      sbc	CollisionX
   2579  f95f				   .firstOk
   2580  f95f		       85 8e		      sta	CollisionEndX	; min text column
   2581  f961
   2582  f961							; last block = (visible_left + PLAYER_WIDTH - 1) / 4 -> text column
   2583  f961		       98		      tya		; A = visible_left
   2584  f962		       18		      clc
   2585  f963		       69 06		      adc	#PLAYER_WIDTH - 1
   2586  f965		       4a		      lsr
   2587  f966		       4a		      lsr
   2588  f967		       c9 14		      cmp	#TILE_COLUMNS
   2589  f969		       90 07		      bcc	.lastOk
   2590  f96b		       85 8b		      sta	CollisionX
   2591  f96d		       a9 27		      lda	#39
   2592  f96f		       38		      sec
   2593  f970		       e5 8b		      sbc	CollisionX
   2594  f972				   .lastOk
   2595  f972		       85 8c		      sta	CollisionCellX	; max text column
   2596  f974
   2597  f974							; Ensure min <= max (blocks 20+ reverse the column order)
   2598  f974		       a5 8e		      lda	CollisionEndX
   2599  f976		       c5 8c		      cmp	CollisionCellX
   2600  f978		       90 06		      bcc	.colsOk
   2601  f97a		       a6 8c		      ldx	CollisionCellX
