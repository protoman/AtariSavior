   1760  f534		       20 d0 fb 	      jsr	EnterRoom
   1761  f537		       a9 00		      lda	#PLAYER_MIN_Y
   1762  f539		       85 81		      sta	RoomY	; enter at the top edge
   1763  f53b				   .NoDown
