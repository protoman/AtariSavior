    942  f111							; --- Player sprite: color for THIS line, graphics byte for NEXT line ---
    943  f111							; GRP0 written on line S displays on line S+1 (latched at the sprite's
    944  f111							; window start after the write) — index graphics with A0+1 ($ff wraps
    945  f111							; to 0 = row0 on the line before the sprite).
    946  f111							; CORRECTED 2026-10-22 (Phase 4): that "line S+1" is only true for a
    947  f111							; sprite whose pixels come AFTER the store. Per Stella's Player::grp /
    948  f111							; updatePattern, a GRP write lands in myPatternNew and renders at once, so
    949  f111							; the boundary is the sprite's own pixel start (cycle ~(61+X)/3). With
    950  f111							; VDELP0=1 (set in the VBL, see the comment there) the live pattern is
    951  f111							; `myPatternOld`, latched by the GRP1 store at c58, so P0 is correct for
    952  f111							; every X < 113 px and its art row r sits on the SAME scanline as
    953  f111							; PlayerColTable[r] (COLUP0 lands at c19, before all pixels) — i.e. the
    954  f111							; art and its per-row colours finally agree. Do not reorder the colour
    955  f111							; path behind the graphics: COLUP0 must stay the first store in the body.
    956  f111							; Running-Y: Y = A0 = Scanline - RoomY is computed ONCE at kernel entry
    957  f111							; (sec/sbc RoomY/tay); .Line's iny advances it (Y = A0+1 after the
    958  f111							; graphics write = A0 of the next line). Nothing between rows may touch
    959  f111							; Y — the water-strip band-color read is an inlined `lda` (Y untouched).
    960  f111							; Cycle budget — MEASURED (sim_frame_budget, bugs.md #29 Class A):
    961  f111							; the old worst path (in-window color/beam/GRP0 + object in-range) was
    962  f111							; 78c: WSYNC write landed 2c into the next line -> full-line stall ->
    963  f111							; +1 scanline on every frame whose object window overlapped the A0=11
    964  f111							; line (24 stalls in the SIM_LEVEL=2 window, always even frames —
    965  f111							; SelectActiveObject parity rotation). Root fix: the color/beam gate
    966  f111							; below stops at A0=10; row 11 inherits row 10's COLUP0/ENAM0 writes
    967  f111							; (PlayerColTable [10]==[11], verify_build asserts) because
    968  f111							; GRP0 row11 is fetched on line A0=10 already ("row11 shows via
    969  f111							; line10"). Worst path measured 2026-10-15 (vcrunch jitter hunt):
    970  f111							; in-window color/beam/GRP0 + object in-range = 69c between WSs,
    971  f111							; start-to-start d=72 — was 73/76 (= stall zone 74-76, whole-screen
    972  f111							; +1-line jitter) until the dead `cpy #12 / bcs .GrpZero` (4c, never
    973  f111							; taken on the A0<=10 color path) moved to .GrpSkip. Budget: work
    974  f111							; <= 70c / d <= 73 — a 74-76 segment stalls a full scanline.
    975  f111							; ObjSprites+107 must stay in ONE page (else lda ObjSprites,X
    976  f111							; page-crosses, +1c on the GRP1 fetch) — verify_build enforces this.
    977  f111							; Branch targets all same-page (3c taken) and PlayerColTable in $F8xx
    978  f111							; (verify_build guards the A0=10 page-cross budget).
    979  f111							; GRP1 object section clobbers X (ObjSprites index) — row counter lives in
    980  f111							; RowIdx and X is reloaded after bne. Row-advance +6c on the .Row setup
    981  f111							; scanline (segment 63c -> 69c <= 76c): frame length unchanged.
    982  f111							; The old Scanline/sec/sbc/tay prefix cost 10c more (body 66c -> WSYNC
    983  f111							; write on cycle 76 = one cycle late): WSYNC stalled a full line per
    984  f111							; overlapping scanline — stretched cave row, HUD pushed down, and with
    985  f111							; GRP1 flicker rotation the frame length alternated (one-tile oscillation).
    986  f111							; Keep the hot path at <= 70c work: an overrun duplicates the scanline.
    987  f111		       c0 15		      cpy	#PLAYER_SPRITE_H - 1
    988  f113		       b0 3d		      bcs	.GrpSkip	; A0 >= 11 (incl $ff): no color/beam this line.
    989  f115							; A0=11 skips too (Class-A stall line): rows
    990  f115							; 10/11 share color+beam bytes, so row 10's
    991  f115							; writes are still in effect here.
    992  f115							; --- Laser S2.2: ENAM0 = PlayerColTable bit1 & LaserState.b1 ----------
    993  f115							; Phase 0 (2026-10-21): the retired BeamMask table duplicated bit 1 of
    994  f115							; PlayerColTable for a separate 4c fetch. One yellow strip on RoomY+2
    995  f115							; only (user directive 2026-10-08: the red row-3 strip is gone; the kill
    996  f115							; window in LaserHitTestBody keeps rows RoomY+2..3 = superset of the
    997  f115							; draw). In-window path only (Y<=11), so outside the window ENAM0 keeps
    998  f115							; its last write ($00 at A0=10) — no HUD artifact. verify_build asserts
    999  f115							; bit1 is set at index 2 and nowhere else, and that rows 10/11 stay equal
   1000  f115							; (the A0=11 gate skip inherits row 10's writes).
   1001  f115		       b9 65 fe 	      lda	PlayerColTable,Y	; 4c — per-row color; bit 1 = ENAM0 enable
   1002  f118		       85 06		      sta	COLUP0	; applies to this line (colour bit0 = don't-care)
   1003  f11a		       25 c0		      and	LaserState	; 3c — beam gate: b1 armed only while fire held
   1004  f11c		       85 1d		      sta	ENAM0	; 3c (bar showed without fire before this)
   1005  f11e		       c8		      iny		; Y = A0+1 ($ff wraps to 0 = sprite row 0).
   1006  f11f							;   Color/beam gate entered only with A0<=10
   1007  f11f							;   -> after iny Y<=11: always fetchable, so
   1008  f11f							;   the old `cpy #PLAYER_SPRITE_H / bcs
   1009  f11f							;   .GrpZero` here was DEAD 4c on the worst
   1010  f11f							;   path (2+2, never taken — A0=11+ never
   1011  f11f							;   reaches it, it goes to bcs .GrpSkip).
   1012  f11f		       b1 86		      lda	(Grp0Ptr),Y	; 5c — byte for the NEXT scanline
   1013  f121		       85 1b		      sta	GRP0
   1014  f123				   .Grp1
