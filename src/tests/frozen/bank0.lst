   4341  ff00							; ==============================================================================
   4342  ff00							; Fine-adjust table for SetObjectXPos — MUST be page-aligned ($xx00)
   4343  ff00							; ==============================================================================
   4344  ff00					      org	$FF00
   4345  ff00				   fineAdjustBegin
   4346  ff00		       70		      .byte.b	%01110000	; left 7
   4347  ff01		       60		      .byte.b	%01100000	; left 6
   4348  ff02		       50		      .byte.b	%01010000	; left 5
   4349  ff03		       40		      .byte.b	%01000000	; left 4
   4350  ff04		       30		      .byte.b	%00110000	; left 3
   4351  ff05		       20		      .byte.b	%00100000	; left 2
   4352  ff06		       10		      .byte.b	%00010000	; left 1
   4353  ff07		       00		      .byte.b	%00000000	; no movement
   4354  ff08		       f0		      .byte.b	%11110000	; right 1
   4355  ff09		       e0		      .byte.b	%11100000	; right 2
   4356  ff0a		       d0		      .byte.b	%11010000	; right 3
   4357  ff0b		       c0		      .byte.b	%11000000	; right 4
   4358  ff0c		       b0		      .byte.b	%10110000	; right 5
   4359  ff0d		       a0		      .byte.b	%10100000	; right 6
   4360  ff0e		       90		      .byte.b	%10010000	; right 7
   4361  ff0e		       fe 0f	   fineAdjustTable EQU	fineAdjustBegin - %11110001	; = fineAdjustBegin - 241
   4362  ff0f
   4363  ff0f							; ==============================================================================
   4364  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4365  ff0f							; ==============================================================================
   4366  ff0f							; Andrew Davie session-24 routine:
   4367  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4368  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4369  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4370  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4371  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4372  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4373  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4374  ff0f							;
   4375  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4376  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4377  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4378  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4379  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4380  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4381  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4382  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4383  ff0f				   SetObjectXPos subroutine
   4384  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4385  ff11		       38		      sec		; ensure carry flag
   4386  ff12				   .Div15Loop
   4387  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4388  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4389  ff16		       a8		      tay		; Y = remainder in -15..-1
   4390  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4391  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4392  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4393  ff1e		       60		      rts
   4394  ff1f
   4395  ff20					      org	$FF20
   4396  ff20
   4397  ff20							; ------------------------------------------------------------------------------
   4398  ff20							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4399  ff20							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4400  ff20							; the facing until contact, then resets to the eye (single missile, KISS —
   4401  ff20							; user spec: no piercing, no HERO comparison needed).
   4402  ff20							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4403  ff20							;						  left	RoomX-4)
   4404  ff20							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4405  ff20							;     wrap) -> reset to eye (unsigned check catches both)
   4406  ff20							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4407  ff20							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4408  ff20							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4409  ff20							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4410  ff20							;     priority over M0 anyway).
   4411  ff20							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4412  ff20							;     press edge re-anchors).
   4413  ff20							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4414  ff20							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4415  ff20							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4416  ff20							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4417  ff20							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4418  ff20							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4419  ff20							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4420  ff20							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4421  ff20							; ------------------------------------------------------------------------------
   4422  ff20				   LaserInput
   4423  ff20		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4424  ff22		       8a		      txa
   4425  ff23		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4426  ff25		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4427  ff27		       8a		      txa
