   2504  f850							; CallPad_RaftBody — bank1 RaftBody entry. Pinned at $F8C0 with a
   2505  f850							; BYTE-IDENTICAL twin in bank1 (bank1.asm, same address): the `sta $1FF7`
   2506  f850							; switches banks, so the `jmp` opcode AND its operand are fetched from bank1,
   2507  f850							; not from here. That is the same FoldIndirect discipline every other tramp
   2508  f850							; uses — the twin cannot be skipped or shortened.
   2509  f850							; Guard: verify_build.check_raft_tramp (identity + operand == bank1 RaftBody).
   2510  f850					      .ds	$F850 - *, 0	; ObjSprites: 12 rows/type = 108 B.
   2511  f850							; Base low byte $50 + max index 107 =
   2512  f850							; 187 -> `lda ObjSprites,X` stays in one
   2513  f850							; page (verify_build guard).
   2514  f850							; 12 rows per type, bits 7-4 (col0 = bit7). Offsets come from the OBJ_*
   2515  f850							; EQUs via ObjSpriteOffTable (stride 12).
   2516  f850				   ObjSprites
   2517  f850							; KEY (offset 0): bow, shaft, stepped teeth
   2518  f850		       3c 42 5a 42*	      .byte.b	$3C,$42,$5A,$42,$3C,$18,$18,$18,$18,$1C,$18,$10
   2519  f85c							; MOTH (12): antennae, upper wing pair, body, lower wing pair, taper
   2520  f85c		       90 60 f0 f0*	      .byte.b	$90,$60,$F0,$F0,$60,$90,$F0,$F0,$60,$90,$60,$30
