   3708  ff2a		       a5 a4		      lda	LevelMinerRoom
   3709  ff2c		       10 04		      bpl	.SORdone
   3710  ff2e		       a9 08		      lda	#$08
   3711  ff30		       85 0c		      sta	REFP1
   3712  ff32				   .SORdone
