   1667  f446		       e9 01		      sbc	#1	; step left
   1668  f448		       4c 4e f4 	      jmp	.TentProbe
   1669  f44b				   .TentRight
   1670  f44b		       18		      clc
   1671  f44c		       69 01		      adc	#1	; step right
   1672  f44e				   .TentProbe
   1673  f44e		       c9 a0		      cmp	#160	; 160..255 = off right edge or wrap → hold
   1674  f450		       b0 36		      bcs	.TentOut
   1675  f452		       85 88		      sta	Temp	; Temp = candidate X (free in overscan)
   1676  f454							; Same-column cull: committed X is always probe-clear, so a candidate in
   1677  f454							; the same 4px column covers the same collision cells → result is known
   1678  f454							; (C=0) and the full PlayerHitsMap swap/probe can be skipped.
   1679  f454		       a5 88		      lda	Temp
