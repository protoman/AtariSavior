   2013  f56d		       90 05		      bcc	.CEHkill	; 0-4 (LAMP handled above) = enemy: lose life
   2014  f56f		       d0 1c		      bne	CEHNext	; 7 = RAFT: a platform is walked on, not hit
   2015  f571		       4c 00 f6 	      jmp	CEH_Key	; 6 = key
