   2174  f659		       85 07		      sta	COLUP1
   2175  f65b		       4c 3a f7 	      jmp	.SODone
   2176  f65e				   .SOFull
   2177  f65e		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
   2178  f660							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
   2179  f660		       a5 b5		      lda	BombPacked
   2180  f662		       29 03		      and	#%00000011
