    370 U00bc		       00 00	   OBJ_NONE   =	0
    371 U00bc		       00 00	   OBJ_KEY    =	0	; type-6 KEY design = the offset-0 slot
    372 U00bc		       00 10	   OBJ_MOTH   =	16	; stride = OBJ_WINDOW (16 rows/design, Phase 6)
    373 U00bc		       00 20	   OBJ_SPIDER =	32
    374 U00bc		       00 30	   OBJ_LAMP   =	48
