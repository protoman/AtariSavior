   1282  f2f6		       a5 80		      lda	RoomX
   1283  f2f8		       c9 9f		      cmp	#PLAYER_MAX_X
   1284  f2fa		       f0 0c		      beq	.ExitRight	; at right edge -> room exit
   1285  f2fc		       e6 80		      inc	RoomX
   1286  f2fe		       20 26 f9 	      jsr	PlayerHitsMap
