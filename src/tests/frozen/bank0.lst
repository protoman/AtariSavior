   1961  f51f				   CEH_HasEnemies
   1962  f51f							; --- Fold batch (P3.1): enemy record staged once — the loop reads type
   1963  f51f							; at CEH_HasMore and writes no FetchPtr. ---
   1964  f51f		       a5 b1		      lda	EnemyDataLo
   1965  f521		       85 e5		      sta	FetchPtr
