   4041  ff0f							; ==============================================================================
   4042  ff0f							; SetObjectXPos — horizontal positioning via RESP0/HMP0
   4043  ff0f							; ==============================================================================
   4044  ff0f							; Andrew Davie session-24 routine:
   4045  ff0f							; Rolls the divide-by-15 and the delay loop into one unit.
   4046  ff0f							; The page-aligned fineAdjustTable ($FF00) guarantees every RESP0 write lands
   4047  ff0f							; on the same clock grid, mapping the sprite 1:1 to pixel (0..159).
   4048  ff0f							; Input: A = horizontal position (0-159 color clocks); drawn = [A-7, A]
   4049  ff0f							;	  X = object selector (0 = HMP0/RESP0 player, 1 = HMP1/RESP1 object,
   4050  ff0f							;	      2 = HMM0/RESM0 laser, 4 = HMBL/RESPBL ball — bank1 bar already
   4051  ff0f							;	      uses 4; HMP0+4=$24=HMBL, RESP0+4=$14=RESPBL)
   4052  ff0f							;
   4053  ff0f							; Lives in the $FF10-$FF1F gap (exactly 16 bytes, before org $FF20) — moved
   4054  ff0f							; here 2026-09-26 (laser S1): the `jsr LaserInput` (+3 pre-pad) had pushed
   4055  ff0f							; .Div15Loop across the $F8/$F9 page, turning `bcs .Div15Loop` from 3c into
   4056  ff0f							; 4c = 6c per /15 iteration (contract: 5c). RESP0 then fired 3 color-clocks
   4057  ff0f							; late per coarse step -> sprites drifted right ~3*(X/15) px and wrapped past
   4058  ff0f							; 160 (spider appeared at the left edge). Placement inside ONE page makes the
   4059  ff0f							; 5c contract structurally safe; verify_build asserts the exact range.
   4060  ff0f							; DO NOT move this routine to an address where bcs and .Div15Loop differ in page.
   4061  ff0f				   SetObjectXPos subroutine
   4062  ff0f		       85 02		      sta	WSYNC	; sync to start of scanline
   4063  ff11		       38		      sec		; ensure carry flag
   4064  ff12				   .Div15Loop
   4065  ff12		       e9 0f		      sbc	#15	; coarse delay (15 clocks / 5 cycles per loop)
   4066  ff14		       b0 fc		      bcs	.Div15Loop	; loop until carry clear (remainder in -15..-1)
   4067  ff16		       a8		      tay		; Y = remainder in -15..-1
   4068  ff17		       b9 0f fe 	      lda	fineAdjustTable,Y	; 5 cycles (page-cross guaranteed) -> fine offset
   4069  ff1a		       95 20		      sta	HMP0,X	; store fine offset
   4070  ff1c		       95 10		      sta	RESP0,X	; store coarse offset
   4071  ff1e		       60		      rts
   4072  ff1f
   4073  ff20					      org	$FF20
   4074  ff20
   4075  ff20							; Set REFP1/NUSIZ1 each frame; bank1 HUD may have changed both registers.
   4076  ff20				   SetObjReflection
   4077  ff20		       a9 00		      lda	#0
   4078  ff22		       85 0c		      sta	REFP1
   4079  ff24		       a5 b6		      lda	ObjBase
   4080  ff26		       c9 70		      cmp	#OBJ_MINER
   4081  ff28		       d0 08		      bne	.SORdone
   4082  ff2a		       a5 a4		      lda	LevelMinerRoom
   4083  ff2c		       10 04		      bpl	.SORdone
   4084  ff2e		       a9 08		      lda	#$08
   4085  ff30		       85 0c		      sta	REFP1
   4086  ff32				   .SORdone
   4087  ff32		       60		      rts
   4088  ff33
   4089  ff33							; ------------------------------------------------------------------------------
   4090  ff33							; LaserInput — contact missile (redesign 2026-10-08, replaces the S3 sweep):
   4091  ff33							; the beam is ONE 8px bar that LEAVES the EYE and travels +/-4px/frame toward
   4092  ff33							; the facing until contact, then resets to the eye (single missile, KISS —
   4093  ff33							; user spec: no piercing, no HERO comparison needed).
   4094  ff33							;   press edge (b7 held, b6 prev): LaserX = eye  (right RoomX-1 = nose,
   4095  ff33							;						  left	RoomX-4)
   4096  ff33							;   held frame: LaserX +/-4; LaserX >= 160 (right edge OR left underflow
   4097  ff33							;     wrap) -> reset to eye (unsigned check catches both)
   4098  ff33							;   contact (bank2 LaserHitTestBody): A = 0 continue / $50 kill (+score,
   4099  ff33							;     dead bit set in body) / 1 lamp (SetRoomDark) / 2 wall tip -> all three
   4100  ff33							;     contact kinds reset LaserX = eye BEFORE positioning (missile consumed;
   4101  ff33							;     tip-in-wall never draws: contact frame restarts at the eye; PF has
   4102  ff33							;     priority over M0 anyway).
   4103  ff33							;   release: b7/b1 cleared in the prologue, HMM0 = 0; LaserX kept (next
   4104  ff33							;     press edge re-anchors).
   4105  ff33							; PIXEL MODEL (unchanged): SetObjectXPos arg A -> drawn M0 = [A-7, A].
   4106  ff33							; LaserState: b7 held, b6 prev (press edge), b5-2 dark, b1 = .Line gate,
   4107  ff33							; b0 = rearm (contact consumed last frame — re-test the eye next frame)
   4108  ff33							; (PlayerColTable bit1 shares b1 — ENAM0 = bit1 & LaserState; the old
   4109  ff33							; LaserBeamOn $02 byte now holds LaserX, there was no free ZP byte).
   4110  ff33							; S5.4: kill/lamp/wall ACTIONS run here (pad body returns only A).
   4111  ff33							; Overscan: VBLANK on, end waits on TIM64T — SetObjectXPos's WSYNC costs 1
   4112  ff33							; of 30 lines. Temp (joystick) intact. Lives after $FF20 (pre-$FF00 full).
   4113  ff33							; ------------------------------------------------------------------------------
   4114  ff33				   LaserInput
   4115  ff33		       a6 c0		      ldx	LaserState	; X = old state (b7 held, b6 prev, b5-2 dark)
   4116  ff35		       8a		      txa
   4117  ff36		       29 3d		      and	#LASER_KEEP	; keep dark bits + b0 rearm (else this store
   4118  ff38		       85 c0		      sta	LaserState	; wipes them — inc at contact must survive)
   4119  ff3a		       8a		      txa
   4120  ff3b		       29 80		      and	#LASER_HELD
   4121  ff3d		       4a		      lsr		; old held (b7) -> new prev (b6)
   4122  ff3e		       05 c0		      ora	LaserState	; prev in b6; b7/b1 cleared for this frame
   4123  ff40		       85 c0		      sta	LaserState
   4124  ff42		       a5 0c		      lda	INPT4	; active-low fire button, D7: 0 = pressed
   4125  ff44		       10 05		      bpl	.LaserFire	; pressed: arm + travel (released sits right
   4126  ff46							; below — moved here so the cap code could
   4127  ff46							; not push .LaserReleased past bmi's ±127)
   4128  ff46				   .LaserReleased
   4129  ff46		       a9 00		      lda	#0
   4130  ff48		       85 22		      sta	HMM0	; HMOVE re-applied stale fine offset
   4131  ff4a							; otherwise -> bars slid across screen
   4132  ff4a		       60		      rts		; LaserX kept; next press edge re-anchors
   4133  ff4b				   .LaserFire
   4134  ff4b		       a5 c0		      lda	LaserState
   4135  ff4d		       09 82		      ora	#LASER_ON	; b7 held + b1 armed (kernel .Line gate)
   4136  ff4f		       85 c0		      sta	LaserState
   4137  ff51		       8a		      txa
   4138  ff52		       29 80		      and	#LASER_HELD
   4139  ff54		       f0 44		      beq	.LaserInit	; press edge: (re)start at the eye
   4140  ff56							; --- rearm (b0): last frame a contact consumed the missile — re-test
   4141  ff56							; the EYE instead of stepping. Flush hold: eye sits mid-tile and the +4
   4142  ff56							; step would jump out of the 8px wall with no candidate ever inside it
