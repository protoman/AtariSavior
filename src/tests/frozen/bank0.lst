   2203  f60a							; UEDispatch — the enemy-type dispatch tail, moved out of UpdateEnemies into the
   2204  f60a							; $F82C pin gap (upstream of the $F8DD sprite pin, so the pre-pad END is
   2205  f60a							; unaffected and the 15 B the folded chain frees stays free). Every non-raft arm
   2206  f60a							; tail-jumps, exactly like the old inline chain, so the stack depth is unchanged.
   2207  f60a							; ------------------------------------------------------------------------------
   2208  f60a				   UEDispatch
   2209  f60a		       29 7f		      and	#%01111111	; record byte = type|dir (b7): mask it here, at
   2210  f60c							;   the single type-compare entry. 2026-10-22:
   2211  f60c							;   a raft authored dir=right read $87, missed
   2212  f60c							;   `cmp #ENEMY_RAFT` and its body never ran
   2213  f60c							;   (no tide, no motion, no rider pin).
   2214  f60c		       c9 07		      cmp	#ENEMY_RAFT
   2215  f60e		       d0 06		      bne	.UEDNotRaft
   2216  f610		       20 c0 f8 	      jsr	CallPad_RaftBody	; bank1 body; returns past this jmp (ReturnPad)
   2217  f613		       4c 38 f4 	      jmp	UE_Next
   2218  f616				   .UEDNotRaft
   2219  f616		       c9 03		      cmp	#ENEMY_TENTACLE
   2220  f618		       d0 03		      bne	.UEDNotTent
   2221  f61a		       4c 3f f4 	      jmp	UE_Tentacle	; tail jmp: saves 2 push bytes (stack guard)
   2222  f61d				   .UEDNotTent
   2223  f61d		       c9 04		      cmp	#ENEMY_MOTH	; E4: moth body runs in bank2 (code fold)
   2224  f61f		       d0 03		      bne	.UEDNotMoth
   2225  f621		       4c f0 fe 	      jmp	UE_MothTramp	; tail jmp: 0 push (stack guard, like tentacle)
   2226  f624				   .UEDNotMoth
   2227  f624		       c9 02		      cmp	#ENEMY_SNAKE
   2228  f626		       d0 03		      bne	.UEDNotSnake
   2229  f628		       4c f4 f3 	      jmp	UE_SnakeBody
   2230  f62b				   .UEDNotSnake
   2231  f62b		       4c 38 f4 	      jmp	UE_Next	; other types: no X motion (Y is derived)
   2232  f62e							; (absolute jmps: this block is far from the
   2233  f62e							;  bodies — relative branches do not reach)
