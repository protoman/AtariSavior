   2071  f58b							; BombTick — per-frame state machine (overscan).
   2072  f58b							;   state1 fuse: dec BombTimer, at 0 → state=2 timer=60 (blast = S5/S6/S9)
   2073  f58b							;   state2: dec BombTimer, at 0 → state=0 (mask stays; saved on EnterRoom)
   2074  f58b							; ------------------------------------------------------------------------------
   2075  f58b				   BombTick   subroutine
   2076  f58b		       a5 b5		      lda	BombPacked
   2077  f58d		       29 03		      and	#%00000011	; state
   2078  f58f		       f0 1e		      beq	.BTDone	; none
   2079  f591		       c9 01		      cmp	#1
   2080  f593		       f0 26		      beq	.BTFuse
   2081  f595							; state 2 — exploding
   2082  f595		       c6 f7		      dec	BombTimer
   2083  f597		       f0 17		      beq	.BTEnd
   2084  f599		       a5 f7		      lda	BombTimer
   2085  f59b		       c9 3b		      cmp	#59	; the frame AFTER the blast edge: enemy kill, player
   2086  f59d		       d0 10		      bne	.BTDone	;   hit and the noise burst (2026-11: they used to
   2087  f59f							;   share the edge frame with BombMarkWalls, ~920c,
   2088  f59f							;   and pushed that overscan up to 6 lines long)
   2089  f59f		       20 d8 fd 	      jsr	BombEnemyBlast	; S9: A = 1 kill (bank2, lamp-safe), 0 none
   2090  f5a2		       f0 05		      beq	.BTNoKill
   2091  f5a4		       a9 50		      lda	#$50	; +50 per kill — moved out of the pad body
   2092  f5a6		       20 0b fc 	      jsr	CallPad_AddScore	;   (pads cannot nest; same shape as BMW above)
   2093  f5a9				   .BTNoKill
   2094  f5a9		       20 d4 f5 	      jsr	BombPlayerBlast	; S5: player ±1 col any Y → life (may ReloadLevel → clears masks)
   2095  f5ac		       20 05 fc 	      jsr	CallPad_BombSndExplode	; S10: noise burst
   2096  f5af				   .BTDone
   2097  f5af		       60		      rts
   2098  f5b0				   .BTEnd
   2099  f5b0		       a5 b5		      lda	BombPacked	; clear state bits only (keep mask + DownPrev)
   2100  f5b2		       29 fc		      and	#%11111100
   2101  f5b4		       85 b5		      sta	BombPacked
   2102  f5b6		       a9 00		      lda	#0
   2103  f5b8		       85 f7		      sta	BombTimer
   2104  f5ba		       60		      rts
