    128  f16a							; ==============================================================================
    129  f16a							; DemoHook (attract mode, 2026-11) — runs at the END of every non-plain frame
    130  f16a							; (title, drop-in, tally, demo), from TransBody. Entered with A != 0.
    131  f16a							;   title idle  : 300 frames (5 s) with every title input released -> start the demo
    132  f16a							;   demo	 : play DemoScript through StickA/DemoOn (EOR-ed onto the real
    133  f16a							;		   SWCHA/INPT4 reads), any real input -> back to the title
    134  f16a							;   reload	 : LevelConnSpare = $A0 makes TransBody run LoadLevel in a blank
    135  f16a							;		   frame (like a room change); DropTarget decides the result:
    136  f16a							;		   0 = the real drop-in (demo), $FF = the title preview.
    137  f16a							; The demo is the REAL game on the selected stage (so the logo/credits band hook
    138  f16a							; of the title is off by design); lives are topped up every frame, nothing saves.
    139  f16a							; ==============================================================================
    140  f16a		       00 00 00 00*	      .ds	$F200 - *, 0
    141  f200				   DemoHook
    142  f200		       a5 dd		      lda	DemoOn
    143  f202		       d0 3c		      bne	.DHdemo
    144  f204		       a5 8a		      lda	DropTarget
    145  f206		       c9 ff		      cmp	#$FF
    146  f208		       d0 33		      bne	.DHout	; drop-in fall / tally sentinel: not ours
    147  f20a		       a5 97		      lda	StepsLeft	; title's last input sample (1 = released)
    148  f20c		       29 17		      and	#$17
    149  f20e		       c9 17		      cmp	#$17
    150  f210		       d0 20		      bne	.DHidleReset
    151  f212		       e6 df		      inc	DemoDur
    152  f214		       a5 df		      lda	DemoDur
    153  f216		       c9 96		      cmp	#IDLE_FRAMES
    154  f218		       90 1e		      bcc	.DHwait
    155  f21a		       a9 00		      lda	#0
    156  f21c		       85 df		      sta	DemoDur
    157  f21e		       e6 de		      inc	DemoPos
    158  f220		       a5 de		      lda	DemoPos
    159  f222		       c9 02		      cmp	#2
    160  f224		       90 12		      bcc	.DHwait
    161  f226		       a5 a3		      lda	Level
    162  f228		       09 40		      ora	#$40
    163  f22a		       85 dd		      sta	DemoOn	; 5 s of nothing: play (remembering the title's stage)
    164  f22c		       a9 00		      lda	#0
    165  f22e		       85 a3		      sta	Level	; the demo is scripted on stage 1 whatever is selected
    166  f230		       f0 59		      beq	DHreload	; always taken
    167  f232				   .DHidleReset
    168  f232		       a9 00		      lda	#0
    169  f234		       85 df		      sta	DemoDur
    170  f236		       85 de		      sta	DemoPos
    171  f238				   .DHwait		; a title frame ends with its overscan timer
    172  f238		       ad 84 02 	      lda	INTIM
    173  f23b		       d0 fb		      bne	.DHwait
    174  f23d				   .DHout
    175  f23d		       4c 58 fc 	      jmp	$FC58
    176  f240				   .DHdemo
    177  f240		       a5 8a		      lda	DropTarget
    178  f242		       c9 ff		      cmp	#$FF
    179  f244		       f0 6d		      beq	DHabort	; a console switch (REY) already sent us to the title:
    180  f246							;   only the stage number and the preview are left to fix
    181  f246		       ad 80 02 	      lda	SWCHA
    182  f249		       29 f0		      and	#$F0
    183  f24b		       c9 f0		      cmp	#$F0
    184  f24d		       d0 64		      bne	DHabort	; stick moved
    185  f24f		       a5 0c		      lda	INPT4
    186  f251		       10 60		      bpl	DHabort	; fire
    187  f253		       ad 82 02 	      lda	SWCHB
    188  f256		       29 03		      and	#3
    189  f258		       c9 03		      cmp	#3
    190  f25a		       d0 57		      bne	DHabort	; SELECT / RESET
    191  f25c		       a9 03		      lda	#3
    192  f25e		       85 ac		      sta	PlayerLives	; the demo never loses
    193  f260		       c6 df		      dec	DemoDur
    194  f262		       d0 d9		      bne	.DHout	; mid-step: the virtual presses stay
    195  f264		       a4 de		      ldy	DemoPos
    196  f266		       b9 dc f2 	      lda	DemoScript,y	; step = duration, presses (D7-D4 = R L D U, D0 = fire)
    197  f269		       f0 20		      beq	DHloop	; 0 = end of script: restart it
    198  f26b		       85 df		      sta	DemoDur
    199  f26d		       b9 dd f2 	      lda	DemoScript+1,y
    200  f270		       aa		      tax
    201  f271		       29 f0		      and	#$F0
    202  f273		       85 dc		      sta	StickA
    203  f275		       a5 dd		      lda	DemoOn
    204  f277		       29 7f		      and	#$7F
    205  f279		       85 dd		      sta	DemoOn
    206  f27b		       8a		      txa
    207  f27c		       4a		      lsr		; C = fire
    208  f27d		       90 06		      bcc	.DHnoFire
    209  f27f		       a5 dd		      lda	DemoOn
    210  f281		       09 80		      ora	#$80	; EOR-ed onto INPT4 D7: pressed
    211  f283		       85 dd		      sta	DemoOn
    212  f285				   .DHnoFire
    213  f285		       c8		      iny
    214  f286		       c8		      iny
    215  f287		       84 de		      sty	DemoPos
    216  f289		       d0 b2		      bne	.DHout	; always taken (script < 256 B)
    217  f28b				   DHloop
    218  f28b				   DHreload
    219  f28b		       a5 dd		      lda	DemoOn
    220  f28d		       29 7f		      and	#$7F
    221  f28f		       85 dd		      sta	DemoOn	; fire released
    222  f291		       a9 00		      lda	#0
    223  f293		       85 dc		      sta	StickA
    224  f295		       85 de		      sta	DemoPos
    225  f297		       85 8a		      sta	DropTarget	; 0 -> LoadLevel arms the real drop-in
    226  f299		       85 f3		      sta	ScoreTh
    227  f29b		       85 f4		      sta	ScoreHu
    228  f29d		       85 f5		      sta	ScoreTe
    229  f29f		       85 f6		      sta	BombX	; the title melody's state byte
    230  f2a1		       a9 01		      lda	#1
    231  f2a3		       85 df		      sta	DemoDur	; next frame fetches step 0
    232  f2a5		       a9 03		      lda	#3
    233  f2a7		       85 ac		      sta	PlayerLives
    234  f2a9		       a9 3c		      lda	#TICKS_PER_SEC
    235  f2ab		       85 ad		      sta	TickCounter
    236  f2ad		       a9 78		      lda	#120
    237  f2af		       85 ae		      sta	BarLevel
    238  f2b1		       d0 22		      bne	DHpend
    239  f2b3				   DHabort		; back to the title (the REY exit's state)
    240  f2b3		       a5 dd		      lda	DemoOn
    241  f2b5		       29 3f		      and	#$3F
    242  f2b7		       85 a3		      sta	Level	; the stage the player had selected
    243  f2b9		       a9 00		      lda	#0
    244  f2bb		       85 dd		      sta	DemoOn
    245  f2bd		       85 dc		      sta	StickA
    246  f2bf		       85 de		      sta	DemoPos
    247  f2c1		       85 df		      sta	DemoDur
    248  f2c3		       85 f6		      sta	BombX
    249  f2c5		       85 f7		      sta	BombTimer
    250  f2c7		       85 f3		      sta	ScoreTh
    251  f2c9		       85 f4		      sta	ScoreHu
    252  f2cb		       85 f5		      sta	ScoreTe
    253  f2cd		       a9 e8		      lda	#%11101000	; SELECT/RESET/UP/DOWN/FIRE count as held: no instant start
    254  f2cf		       85 97		      sta	StepsLeft
    255  f2d1		       a9 ff		      lda	#$FF
    256  f2d3		       85 8a		      sta	DropTarget
    257  f2d5				   DHpend
    258  f2d5		       a9 a0		      lda	#$A0
    259  f2d7		       85 a2		      sta	LevelConnSpare
    260  f2d9		       4c 07 f1 	      jmp	TBgo
    261  f2dc
    262  f2dc							; The script: duration (frames), presses. Presses: $80 right, $40 left, $20 down
    263  f2dc							; (drops the bomb on its press edge, standing only), $10 up (jet), $01 fire (laser).
    264  f2dc							; Stage 1 (the pocket under the start): fall in, walk to both walls, drop a bomb,
    265  f2dc							; fly out over it (the laser fires while flying), hover until it has gone off,
    266  f2dc							; then glide back to the drop-in spot (X=39, Y=0, facing right) for a seamless loop. The first step covers the drop-in (~72 frames) and the free fall.
    267  f2dc				   DemoScript
    268  f2dc		       8c 00		      .byte.b	140, $00	; drop-in + fall to the floor
    269  f2de		       0c 80		      .byte.b	12, $80	; walk right to the wall
    270  f2e0		       0e 40		      .byte.b	14, $40	; walk left (faces left)
    271  f2e2		       03 20		      .byte.b	3, $20	; DOWN: bomb
    272  f2e4		       02 00		      .byte.b	2, $00
    273  f2e6		       0e 80		      .byte.b	14, $80	; walk right, away from it
    274  f2e8		       28 10		      .byte.b	40, $10	; jet up out of the pocket
    275  f2ea		       1e 90		      .byte.b	30, $90	; up + right
    276  f2ec		       28 11		      .byte.b	40, $11	; up + FIRE: laser
    277  f2ee		       23 50		      .byte.b	35, $50	; up + left
    278  f2f0		       23 90		      .byte.b	35, $90	; up + right
    279  f2f2		       28 11		      .byte.b	40, $11	; up + FIRE
    280  f2f4		       1e 10		      .byte.b	30, $10
    281  f2f6		       27 50		      .byte.b	39, $50	; up + left along the ceiling ...
    282  f2f8		       06 90		      .byte.b	6, $90	; ... and back right: ends at X=39, facing right, Y=0 --
    283  f2fa		       0a 10		      .byte.b	10, $10	;   exactly where the next drop-in starts (a seamless loop)
    284  f2fc		       00		      .byte.b	0	; end: restart the demo
    285  f2fd
    286  f2fd		       00 00 00 00*	      .ds	$FBD0 - *, 0
    287  fbd0		       8d f6 1f 	      sta	$1FF6	; twin of bank0's EnterRoom tramp (bank2 has the jmp)
    288  fbd3		       00 00 00 00*	      .ds	$FBF8 - *, 0
    289  fbf8				   ReturnPad
    290  fbf8		       8d f4 1f 	      sta	$1FF4	; the every-bank ReturnPad contract (bank0 rts at $FBFB)
    291  fbfb		       00 00 00 00*	      .ds	$FC08 - *, 0
    292  fc08		       8d f8 1f 	      sta	$1FF8	; twin of CallPad_SaveKey (bank4 serves the jmp at $FC0B)
    293  fc0b		       00 00 00 00*	      .ds	$FC20 - *, 0
    294  fc20		       8d f6 1f 	      sta	$1FF6	; twin of LoadLevel (bank2 serves the jmp at $FC23)
    295  fc23		       00 00 00 00*	      .ds	$FC58 - *, 0
    296  fc58		       8d f4 1f 	      sta	$1FF4	; bank0 $FC5B = jmp StartFrame
    297  fc5b		       4c 00 f1 	      jmp	TransBody	; $FC5B: fetched after bank0's `sta $1FF9` at $FC58
    298  fc5e		       00 00 00 	      .ds	$FC61 - *, 0
    299  fc61		       4c 5b f1 	      jmp	TransFinish	; $FC61: after bank0's second pad at $FC5E
    300  fc64					      .ds	$FC64 - *, 0
    301  fc64		       4c 52 f1 	      jmp	TransAfterSave	; $FC64: after bank0's third pad at $FC61
