    184  f000							;   staged here, copied by Slot1Hook)
    185  f000		       00 06	   KEY	      =	6	; enemy record type 6 = the phase-5 key
    186  f000		       00 0e	   CELL       =	14	; type 14 = the power cell (KEY|8)
    187  f000		       00 0f	   MINER2     =	15	; type 15 = an extra miner to rescue
