   1608  fc4f							; In: A = target position, FetchPtr = level base + n. Out: A = room index,
   1609  fc4f							; C = 0 found / 1 none. Clobbers A/Y only (X is the caller's direction).
   1610  fc4f				   ExitScanB2
   1611  fc4f		       85 a2		      sta	LevelConnSpare
   1612  fc51		       a0 00		      ldy	#0
