------- FILE banks.inc LEVEL 2 PASS 1
      0  0000 ????				      include	"banks.inc"	; BK_* bank selectors by role
      1  0000 ????						; ==============================================================================
      2  0000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  0000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  0000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  0000 ????						;
      6  0000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  0000 ????						; ==============================================================================
      8  0000 ????	       00 00	   BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  0000 ????	       00 01	   BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  0000 ????	       00 02	   BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  0000 ????	       00 03	   BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  0000 ????	       00 04	   BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  0000 ????	       00 04	   BKI_TRANS  =	4	; version header, blank transition frame, attract script
     14  0000 ????	       00 06	   BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  0000 ????	       00 07	   BKI_PROLOGUE =	7	; cave kernel start-up code
     16  0000 ????	       00 04	   BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     17  0000 ????
     18  0000 ????	       1f f4	   BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  0000 ????	       1f f5	   BK_HUD     =	$1FF4 + BKI_HUD
     20  0000 ????	       1f f6	   BK_ROOMS   =	$1FF4 + BKI_ROOMS
     21  0000 ????	       1f f7	   BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     22  0000 ????	       1f f8	   BK_SAVE    =	$1FF4 + BKI_SAVE
     23  0000 ????	       1f f8	   BK_TRANS   =	$1FF4 + BKI_TRANS
     24  0000 ????	       1f fa	   BK_CAVE    =	$1FF4 + BKI_CAVE
     25  0000 ????	       1f fb	   BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     26  0000 ????	       1f f8	   BK_MODELS  =	$1FF4 + BKI_MODELS
------- FILE bank5.asm
      9  f000					      org	$F000
     10  f000		       a9 00		      lda	#0
     11  f002		       8d f4 1f 	      sta	BK_GENERAL	; boot stub (every bank): select bank0, whose $F005 is `jmp $F008`
     12  f005
     13  f005		       00 00 00 00*	      .ds	$FFFA - *, 0
     14  fffa		       00 f0		      .word.w	$F000	; NMI (never used)
     15  fffc		       00 f0		      .word.w	$F000	; RESET -> this bank's stub
     16  fffe		       00 f0		      .word.w	$F000	; IRQ (never used)
