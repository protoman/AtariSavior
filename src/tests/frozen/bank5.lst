------- FILE bank2.asm
------- FILE banks.inc LEVEL 3 PASS 2
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  10000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  10000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  10000 ????						;
      6  10000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  10000 ????						; ==============================================================================
      8  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  10000 ????		00 01	    BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  10000 ????		00 02	    BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  10000 ????		00 03	    BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  10000 ????		00 04	    BKI_TRANS  =	4	; version header, blank transition frame, attract script
     14  10000 ????		00 06	    BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  10000 ????		00 07	    BKI_PROLOGUE =	7	; cave kernel start-up code
     16  10000 ????		00 05	    BKI_ROOMS_B =	5	; room bank B: identical code to ROOMS (bank2), the data of the levels past LEVEL_SPLIT
     17  10000 ????		00 04	    BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     18  10000 ????
     19  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     20  10000 ????		1f f5	    BK_HUD     =	$1FF4 + BKI_HUD
     21  10000 ????		1f f6	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     22  10000 ????		1f f7	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     23  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     24  10000 ????		1f f8	    BK_TRANS   =	$1FF4 + BKI_TRANS
     25  10000 ????		1f fa	    BK_CAVE    =	$1FF4 + BKI_CAVE
     26  10000 ????		1f fb	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     27  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
     28  10000 ????		1f f9	    BK_ROOMS_B =	$1FF4 + BKI_ROOMS_B
------- FILE bank2.asm
      4  10000 ????			   -	       IFNCONST	ROOMS_B
      5  10000 ????			   -ROOMS_B    =	0	; 1 when bank5.asm assembles this file as the room bank B (levels past LEVEL_SPLIT)
      6  10000 ????				       ENDIF
      7  10000 ????						; ==============================================================================
      8  10000 ????						; Bank2 stub — selects bank0, jumps to GameStart
      9  10000 ????						; ==============================================================================
     10  10000 ????				       seg	code
     11  f000					      org	$F000
     12  f000
     13  f000		       00 e5	   FetchPtr   =	$E5	; must match kernel.asm (operand baked in;
     14  f000							; moved S3.2 from $E0 — frees $E0 for
     15  f000							; rect4.h in the uniform rect cache)
     16  f000		       00 02	   WSYNC      =	$02	; TIA — values must match kernel.asm (equ-sync)
     17  f000		       00 04	   NUSIZ0     =	$04
     18  f000		       00 05	   NUSIZ1     =	$05
     19  f000		       00 06	   COLUP0     =	$06
     20  f000		       00 07	   COLUP1     =	$07
     21  f000		       00 09	   COLUBK     =	$09	; kernel line 41
     22  f000		       00 0b	   REFP0      =	$0B	; kernel line 43
     23  f000		       00 48	   COLOR_PLAYER =	NC_48	; must match kernel.asm
     24  f000		       00 10	   RESP0      =	$10
     25  f000		       00 11	   RESP1      =	$11
     26  f000		       00 20	   HMP0       =	$20	; TIA — for the SetObjectXPos_t2 title copy
     27  f000		       00 21	   HMP1       =	$21
     28  f000		       00 12	   RESM0      =	$12
     29  f000		       00 13	   RESM1      =	$13
