      9  f307							; Per-level entry (stride 7, (d) 2026-10-20): miner room/x, both wall
     10  f307							; colors, then the level's room-table base and its ROOM COUNT.
     11  f307							; start x/y (32/24), start_room (0) and miner_y (84) are kernel
     12  f307							; constants now — the converter rejects other values.
     13  f307							; Inside a level block (n = ROOM COUNT, C2 2026-10-20; C5 extras):
     14  f307							;   base + 0	RoomShapes     1 B/room (shape idx b5-0 | band b6 |
     15  f307							;				 owns-extras b7; shape = the table below)
     16  f307							;   base + n	RoomPositions  1 B/room (LEVEL_FORMAT 2: x<<4|y,
     17  f307							;				 exits derived by scanning it)
     18  f307							;   base + 2n	RoomCounts     1 B/room (count<<6 | extras ordinal)
     19  f307							;   base + 3n	EnemyDataTable 3 B/record (type b3-0|dir b7, x, y;
     20  f307							;				 first record index derived)
     21  f307							;   .. 	AsyncExtras    variable, one record per owns-extras room
     22  f307							;				 (C5; after the enemy records — the
     23  f307							;				 loader derives its base from the count
     24  f307							;				 column sum). Flags/MetaA/MetaB,
     25  f307							;				 1 B/patch, 1 B/feature, then the
     26  f307							;				 FEATURE-record stream when the room
     27  f307							;				 has feature cells (C11: no hot records).
     28  f307		       00 0b	   LEVEL_SHAPE_COUNT =	11
     29  f307		       00 00	   SHAPE_M0   =	0
     30  f307		       00 01	   SHAPE_M1   =	1
     31  f307		       00 02	   SHAPE_M2   =	2
