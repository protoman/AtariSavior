------- FILE generated/levels_equ.asm LEVEL 3 PASS 2
      0  f000					      include	"generated/levels_equ.asm"	; BAND_COLOR (0 bytes of ROM)
      1  f000							; Generated by convert_level.py --levels. Do not edit by hand.
      2  f000							; One bottom-band color for the whole game: the room record keeps only
      3  f000							; the per-room FLAG (convert_level rejects a second
      4  f000							; color — extend the format first if that is ever needed).
      5  f000		       00 80	   BAND_COLOR =	$80
------- FILE bank2.asm
    209  f000
    210  f000							; --- 5-byte stub ---
    211  f000		       a9 00		      lda	#0
    212  f002		       8d f4 1f 	      sta	BK_GENERAL	; select bank0
    213  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    214  f008
    215  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    216  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF6 / jmp $F010).
    217  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    218  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    219  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    220  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    221  f008							; = Origin Reverse.
    222  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    223  f010				   EnterRoomB2
    224  f010		       85 98		      sta	RoomNo
    225  f012		       20 02 fc 	      jsr	SetRoomExits	; RoomExits: which sides have a room (bomb gate)
    226  f015		       a4 98		      ldy	RoomNo	; Y = room (C2: every column is 1 B/room)
    227  f017		       a5 9f		      lda	LevelPFDataLo
    228  f019		       85 e5		      sta	FetchPtr
    229  f01b		       a5 a0		      lda	LevelPFDataHi
    230  f01d		       85 e6		      sta	FetchPtr+1
    231  f01f		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b6-0 | band b7
    232  f021		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    233  f023							;   SHAPE ADDRESS TABLE lives in that bank,
    234  f023							;   so bank2 needs no bank3 label). Loader
    235  f023							;   scratch: overwritten with MetaA later.
    236  f023		       85 88		      sta	Temp
    237  f025							; band flag b7 → RoomBandColor (staged BEFORE the block reader — the
    238  f025							; reader never writes it, and this is the only writer in the game).
    239  f025							; LAYOUT 8 (2026-10-24): the index is 7 bits and the band flag moved to b7;
    240  f025							; the owns-extras bit is GONE (a room has a record iff its counts byte
    241  f025							; carries a nonzero extras ordinal, which is exactly what ExtrasLoad
    242  f025							; indexes with — b7 was redundant). (A still holds the byte.)
    243  f025		       29 80		      and	#$80
    244  f027		       f0 02		      beq	.EBnoBand
    245  f029		       a9 80		      lda	#BAND_COLOR
    246  f02b				   .EBnoBand
    247  f02b		       85 bc		      sta	RoomBandColor
    248  f02d							; TilePF0 is no longer stored per room: bank3's block reader derives it
    249  f02d							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    250  f02d
    251  f02d							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    252  f02d							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    253  f02d							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    254  f02d							; (records stay contiguous in room order), so the old packed index byte
    255  f02d							; and its 31-record/level cap are gone. The band COLOR is the global
    256  f02d							; BAND_COLOR (one water color per game).
    257  f02d							; LevelConnSpare is free here: it only carries the exit-scan target, and
    258  f02d							; that scan has already returned when EnterRoomB2 is entered.
    259  f02d		       a4 98		      ldy	RoomNo	; Y = room (one byte per record)
    260  f02f							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    261  f02f							; low byte loses the first carry (the second `adc n` consumes it) and the
    262  f02f							; high byte then misses that carry — level 14 of a 20-level stage read its
    263  f02f							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    264  f02f		       a5 a1		      lda	LevelRoomN
    265  f031		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    266  f032		       18		      clc
    267  f033		       65 9f		      adc	LevelPFDataLo
    268  f035		       85 e5		      sta	FetchPtr
    269  f037		       a5 a0		      lda	LevelPFDataHi
    270  f039		       69 00		      adc	#0
    271  f03b		       85 e6		      sta	FetchPtr+1
    272  f03d		       b1 e5		      lda	(FetchPtr),Y
    273  f03f		       4a		      lsr
    274  f040		       4a		      lsr
    275  f041		       4a		      lsr
    276  f042		       4a		      lsr
    277  f043		       4a		      lsr
    278  f044		       4a		      lsr		; count = b7-6
    279  f045		       85 b3		      sta	EnemyCount
    280  f047		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    281  f049		       a0 00		      ldy	#0
    282  f04b		       98		      tya		; (= lda #0)
    283  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    284  f04e				   .EBSumLoop
    285  f04e		       c4 88		      cpy	Temp
    286  f050		       f0 11		      beq	.EBSumDone
    287  f052		       b1 e5		      lda	(FetchPtr),Y
    288  f054		       4a		      lsr
    289  f055		       4a		      lsr
    290  f056		       4a		      lsr
    291  f057		       4a		      lsr
    292  f058		       4a		      lsr
    293  f059		       4a		      lsr		; each earlier room's count (0..3)
    294  f05a		       18		      clc
    295  f05b		       65 a2		      adc	LevelConnSpare
    296  f05d		       85 a2		      sta	LevelConnSpare
    297  f05f		       c8		      iny
    298  f060		       4c 4e f0 	      jmp	.EBSumLoop
    299  f063				   .EBSumDone
    300  f063		       a5 e5		      lda	FetchPtr
    301  f065		       18		      clc
    302  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    303  f068		       85 b1		      sta	EnemyDataLo
    304  f06a		       a5 e6		      lda	FetchPtr+1
    305  f06c		       69 00		      adc	#0
    306  f06e		       85 b2		      sta	EnemyDataHi
    307  f070		       a5 a2		      lda	LevelConnSpare
    308  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    309  f073		       18		      clc
    310  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    311  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    312  f078		       85 b1		      sta	EnemyDataLo
    313  f07a		       a5 b2		      lda	EnemyDataHi
    314  f07c		       69 00		      adc	#0
    315  f07e		       85 b2		      sta	EnemyDataHi
    316  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    317  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    318  f084
    319  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    320  f084		       85 b5		      sta	BombPacked
    321  f086		       85 f7		      sta	BombTimer
    322  f088		       85 f1		      sta	BombSnd
    323  f08a		       85 19		      sta	AUDV0
