------- FILE bank5.asm
      4  f000					      org	$F000
      5  f000							; Power-up stub (every bank has it: F4 powers up in an undefined bank): `lda #0 /
      6  f000							; sta $1FF4` selects bank0, whose $F005 is `jmp GameStart`. Guard: verify_build
      7  f000							; check_boot_banks (all 8 banks).
      8  f000		       a9 00		      lda	#0
      9  f002		       8d f4 1f 	      sta	$1FF4
     10  f005							; ==============================================================================
     11  f005							; Bank5 — free 4K window in the F4 (32K, 8 banks) layout.
     12  f005							; ==============================================================================
     13  f005							; Besides the stub, only the version header lives here ($F005: "S.A.V.I.O.R. <VERSION>", 0 - build.sh
     14  f005							; writes version.asm from the VERSION file). The file still assembles to a full 4K
     15  f005							; image: the tail is filled to the vector area, and the vectors are emitted (unused,
     16  f005							; but every bank image must be 4096 B and DASM only writes what is emitted).
     17  f005							; Hotspot for this bank: $1FF9 (F4: bank = addr - $1FF4).
     18  f005							; ==============================================================================
     19  f005				   RomVersion
------- FILE version.asm LEVEL 2 PASS 2
      0  f005					      include	"version.asm"
      1  f005							; generated by build.sh from VERSION - do not edit
      2  f005		       53 2e 41 2e*	      .byte.b	"S.A.V.I.O.R. 1.1.0", 0
------- FILE bank5.asm
     21  f018
     22  f018							; ==============================================================================
     23  f018							; TransBody — the blank ROOM-TRANSITION frame (2026-11). An exit sets
     24  f018							; LevelConnSpare = room | $80 (bank2 ExitDirB2); EnterRoom's 1000-2000c would
     25  f018							; overrun the overscan, so every gameplay frame ends in bank0's Transition pad
     26  f018							; ($FC58: `sta $1FF9`, then this bank's `jmp TransBody` at $FC5B):
     27  f018							;   not pending -> `jmp $FC58` = our `sta $1FF4` there; bank0 $FC5B runs
     28  f018							;		    `jmp StartFrame` (cost: ~22c per frame).
     29  f018							;   pending	 -> emit one blank frame: VSYNC, VBLANK stays on, EnterRoom
     30  f018							;		    (it ends in ReturnPad, whose rts lands on bank0's second pad
     31  f018							;		    $FC5E because we push $FC5D), then TransFinish pads the
     32  f018							;		    frame to 272 lines and leaves through $FC58 the same way.
     33  f018							; EnterRoom's chain zeroes LevelConnSpare (bank3 ERLoadDone): flag consumed.
     34  f018							; ==============================================================================
     35  f018		       00 00	   VSYNC      =	$00
     36  f018		       02 96	   TIM64T     =	$0296
     37  f018		       02 84	   INTIM      =	$0284
     38  f018		       00 02	   WSYNC      =	$02
     39  f018		       00 3e	   TF_LINES   =	54 + TV_CAVE_LINES - 272	; scanlines after the 255-unit timer (tuned: 272 total on NTSC)
     40  f018		       00 a2	   LevelConnSpare =	$A2
     41  f018		       00 8a	   DropTarget =	$8A
     42  f018		       00 97	   StepsLeft  =	$97
     43  f018		       00 ac	   PlayerLives =	$AC
     44  f018		       00 ad	   TickCounter =	$AD
     45  f018		       00 ae	   BarLevel   =	$AE
     46  f018		       00 f3	   ScoreTh    =	$F3
     47  f018		       00 f4	   ScoreHu    =	$F4
     48  f018		       00 f5	   ScoreTe    =	$F5
     49  f018		       00 f6	   BombX      =	$F6
     50  f018		       00 f7	   BombTimer  =	$F7
     51  f018		       00 dc	   StickA     =	$DC
     52  f018		       00 dd	   DemoOn     =	$DD	; b7 = virtual FIRE, b6 = demo playing, b5-0 = the title's Level
     53  f018		       00 a3	   Level      =	$A3
     54  f018		       00 de	   DemoPos    =	$DE
     55  f018		       00 df	   DemoDur    =	$DF
     56  f018		       00 19	   AUDV0      =	$19
     57  f018		       00 1a	   AUDV1      =	$1A
     58  f018		       02 80	   SWCHA      =	$0280
     59  f018		       02 82	   SWCHB      =	$0282
     60  f018		       00 0c	   INPT4      =	$0C
     61  f018		       00 96	   IDLE_FRAMES =	150	; x2 passes = 300 frames = 5 s of an untouched title
     62  f018		       00 00 00 00*	      .ds	$F100 - *, 0
     63  f100				   TransBody
     64  f100		       a5 a2		      lda	LevelConnSpare
     65  f102		       30 03		      bmi	TBgo
     66  f104		       4c 00 f2 	      jmp	DemoHook	; the title or the demo (a plain frame never gets here:
     67  f107							;   bank0's TailHook sends only pending/demo frames)
     68  f107				   TBgo
     69  f107		       85 02		      sta	WSYNC
     70  f109		       a9 02		      lda	#2
     71  f10b		       85 00		      sta	VSYNC
     72  f10d		       85 02		      sta	WSYNC
     73  f10f		       85 02		      sta	WSYNC
     74  f111		       85 02		      sta	WSYNC
     75  f113		       a9 00		      lda	#0
     76  f115		       85 00		      sta	VSYNC
     77  f117		       a9 ff		      lda	#255
