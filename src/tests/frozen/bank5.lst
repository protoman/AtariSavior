    143  f000
    144  f000							; ==============================================================================
    145  f000							; A/B ROOM-BANK ROUTER (banks plan layout v3, docs/agents/banks.md). Two identical room banks: A (bank2) holds
    146  f000							; levels 1..LEVEL_SPLIT, B (bank5, this file assembled with ROOMS_B = 1) the rest. Every bank0 pad that reaches
    147  f000							; level data keeps `sta BK_ROOMS` (= A); A's slot at pad+3 is `jmp Stub_x`. The stub tests RoomExits b7
    148  f000							; ("this level is in B", set by B's LoadLevelB2 / SetRoomExits, cleared by A's) with flags only - A/X/Y are
    149  f000							; untouched - and either jumps to the body here or `sta BK_ROOMS_B`, after which the fetch 10 bytes on comes
    150  f000							; from B, which holds `jmp body` at the same address. A and B are byte-identical EXCEPT the stub zones and
    151  f000							; the generated data windows.
    152  f000							; ==============================================================================
    153  f000					      MAC	rstub
    154  f000				   Stub_{1}
    155  f000					      IF	ROOMS_B
    156  f000					      .ds	10, 0
    157  f000					      jmp	{2}
    158  f000					      ELSE
    159  f000					      bit	RoomExits
    160  f000					      bmi	*+5
    161  f000					      jmp	{2}
    162  f000					      sta	BK_ROOMS_B
    163  f000					      .ds	3, 0
    164  f000					      ENDIF
    165  f000					      ENDM		; {1} = stub name, {2} = body
    166  f000		       00 a8	   LevelStartX =	$A8	; level start x (kernel constant 39 = cell 4)
    167  f000		       00 a9	   LevelStartY =	$A9	; level start y (kernel constant 24)
    168  f000		       00 9c	   Hover      =	$9C	; respawn hover flag — cleared on stage entry
    169  f000		       00 f2	   LevelShowTimer =	$F2	; LV001 banner countdown (kernel $F2)
    170  f000		       00 05	   BOMBS_MAX  =	5	; kernel constant
    171  f000		       00 78	   LV_SHOW_FRAMES =	120	; kernel constant (banner frames)
    172  f000							; --- room-exit handlers (MOVED here, C3 2026-10-20) — hand-copies, equ-sync --
    173  f000		       00 04	   PLAYER_MIN_X =	4	; kernel EQU (sprite flush with the left edge)
    174  f000		       00 9f	   PLAYER_MAX_X =	159	; kernel EQU (horizontal logical clamp)
    175  f000		       00 00	   PLAYER_MIN_Y =	0
