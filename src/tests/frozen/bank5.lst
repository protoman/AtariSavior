    193  f000		       00 10	   OBJ_MOTH   =	16	;   hand-copies of kernel.asm — the equ-sync
    194  f000		       00 1e	   OBJ_SPIDER =	30	;   guard checks hex AND decimal values)
    195  f000		       00 2d	   OBJ_LAMP   =	45
