   1992  ffee
   1993  ffee				   EnemyBitTable
   1994  ffee		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; slot-indexed dead/dir bits
   1995  fff2
   1996  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   1997  fff2
   1998  fff2							; Pad to vectors at $FFFA ($FFF2-$FFF9 = fill — never code: $FFF6-$FFF9
   1999  fff2							; are F6 hotspot mirrors on peek, see MothExitPad at $FC49)
   2000  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0
   2001  fffa
   2002  fffa							; Interrupt vectors
   2003  fffa		       00 f0		      .word.w	$F000	; NMI vector
   2004  fffc		       00 f0		      .word.w	$F000	; RESET vector
   2005  fffe		       00 f0		      .word.w	$F000	; IRQ vector
