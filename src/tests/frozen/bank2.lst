    905  f410		       a9 00		      lda	#0
    906  f412		       2a		      rol
    907  f413		       f0 02		      beq	.SBTb0z
    908  f415		       a9 ff		      lda	#$ff
    909  f417				   .SBTb0z
    910  f417		       85 ed		      sta	BandTab
    911  f419		       b1 99		      lda	(RoomPF0Lo),Y
    912  f41b		       4a		      lsr
    913  f41c		       4a		      lsr		; band1 bit -> carry
    914  f41d		       a9 00		      lda	#0
    915  f41f		       2a		      rol
    916  f420		       f0 02		      beq	.SBTb1z
    917  f422		       a9 ff		      lda	#$ff
    918  f424				   .SBTb1z
    919  f424		       85 ee		      sta	BandTab+1
    920  f426		       b1 99		      lda	(RoomPF0Lo),Y
    921  f428		       4a		      lsr
