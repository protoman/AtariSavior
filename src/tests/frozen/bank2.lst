    883  f401							; ------------------------------------------------------------------------------
    884  f401							; StageBandTab — asym meta: decode packed model meta into bank0 ZP for the cave.
    885  f401							; Reached from BuildColupF's tail (BCFDarkRun jmp here); ends at ReturnPad so
    886  f401							; the VBL jsr returns to bank0 (pads must not nest — no rts here).
    887  f401							; WHY here: the room meta is STAGED at room entry (RoomMetaA/B — see
    888  f401							; EnterRoomB2), so this body reads ZP only; it no longer touches level data.
    889  f401							; That is what makes it movable to bank3 (next chunk: C2's space).
    890  f401							; Packed meta (bugs.md 28 point 1): TilePF0+9 = MetaA = (m1_col+1)<<4 |
    891  f401							; band_mask (b0-2 = band0/1/2 gates); TilePF0+10 = MetaB = ball_col+1
    892  f401							; (0 = feature absent). Expanded to the old RAM shapes:
    893  f401							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates (.Row ENABL reads
    894  f401							;			  bit0; the pack's `bit`/`bpl` reads bit7)
    895  f401							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 ⇔ symmetric → skip;
    896  f401							;			  verify_build enforces)
    897  f401							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    898  f401							; Window: staged every VBL → read by cave → bank1 HUD stomps $ED-$EF after
    899  f401							; the cave read → overscan rewrites $88 (joystick) after the ball read.
    900  f401							; ------------------------------------------------------------------------------
    901  f401				   StageBandTab
    902  f401							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    903  f401							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    904  f401							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    905  f401							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    906  f401							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    907  f401							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    908  f401							; no-ball path below blanks BandTab so it never enables the ball.
    909  f401							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    910  f401							; the pack uses $8F).
    911  f401		       a5 99		      lda	RoomMetaA	; MetaA
    912  f403		       29 01		      and	#$01
    913  f405		       aa		      tax
    914  f406		       bd ba f4 	      lda	M1OffTab,X
    915  f409		       85 92		      sta	RectCount
    916  f40b		       a5 99		      lda	RoomMetaA	; MetaA
    917  f40d		       4a		      lsr		; band0 bit -> carry
    918  f40e		       a9 00		      lda	#0
    919  f410		       2a		      rol
    920  f411		       f0 02		      beq	.SBTb0z
    921  f413		       a9 ff		      lda	#$ff
    922  f415				   .SBTb0z
    923  f415		       85 ed		      sta	BandTab
    924  f417		       a5 99		      lda	RoomMetaA
    925  f419		       4a		      lsr
    926  f41a		       4a		      lsr		; band1 bit -> carry
    927  f41b		       a9 00		      lda	#0
    928  f41d		       2a		      rol
    929  f41e		       f0 02		      beq	.SBTb1z
    930  f420		       a9 ff		      lda	#$ff
    931  f422				   .SBTb1z
    932  f422		       85 ee		      sta	BandTab+1
    933  f424		       a5 99		      lda	RoomMetaA
    934  f426		       4a		      lsr
    935  f427		       4a		      lsr
    936  f428		       4a		      lsr		; band2 bit -> carry
    937  f429		       a9 00		      lda	#0
    938  f42b		       2a		      rol
