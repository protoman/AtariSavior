   1130  f6c8		       a9 84		      lda	#132	; the BALL: the key square, right side of the row
   1131  f6ca		       a2 04		      ldx	#4	; selector 4 = RESBL/HMBL
   1132  f6cc		       20 47 f8 	      jsr	SetObjectXPos_b1
