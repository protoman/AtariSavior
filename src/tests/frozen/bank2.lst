    189  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    190  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF6 / jmp $F010).
    191  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    192  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    193  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    194  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    195  f008							; = Origin Reverse.
    196  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    197  f010				   EnterRoomB2
    198  f010		       85 98		      sta	RoomNo
    199  f012		       20 02 fc 	      jsr	SetRoomExits	; RoomExits: which sides have a room (bomb gate)
    200  f015		       a4 98		      ldy	RoomNo	; Y = room (C2: every column is 1 B/room)
    201  f017		       a5 9f		      lda	LevelPFDataLo
    202  f019		       85 e5		      sta	FetchPtr
    203  f01b		       a5 a0		      lda	LevelPFDataHi
    204  f01d		       85 e6		      sta	FetchPtr+1
    205  f01f		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b6-0 | band b7
    206  f021		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    207  f023							;   SHAPE ADDRESS TABLE lives in that bank,
    208  f023							;   so bank2 needs no bank3 label). Loader
    209  f023							;   scratch: overwritten with MetaA later.
    210  f023		       85 88		      sta	Temp
    211  f025							; band flag b7 → RoomBandColor (staged BEFORE the block reader — the
    212  f025							; reader never writes it, and this is the only writer in the game).
    213  f025							; LAYOUT 8 (2026-10-24): the index is 7 bits and the band flag moved to b7;
    214  f025							; the owns-extras bit is GONE (a room has a record iff its counts byte
    215  f025							; carries a nonzero extras ordinal, which is exactly what ExtrasLoad
    216  f025							; indexes with — b7 was redundant). (A still holds the byte.)
    217  f025		       29 80		      and	#$80
    218  f027		       f0 02		      beq	.EBnoBand
    219  f029		       a9 80		      lda	#BAND_COLOR
    220  f02b				   .EBnoBand
    221  f02b		       85 bc		      sta	RoomBandColor
    222  f02d							; TilePF0 is no longer stored per room: bank3's block reader derives it
    223  f02d							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    224  f02d
    225  f02d							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    226  f02d							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    227  f02d							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    228  f02d							; (records stay contiguous in room order), so the old packed index byte
    229  f02d							; and its 31-record/level cap are gone. The band COLOR is the global
    230  f02d							; BAND_COLOR (one water color per game).
    231  f02d							; LevelConnSpare is free here: it only carries the exit-scan target, and
    232  f02d							; that scan has already returned when EnterRoomB2 is entered.
    233  f02d		       a4 98		      ldy	RoomNo	; Y = room (one byte per record)
    234  f02f							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    235  f02f							; low byte loses the first carry (the second `adc n` consumes it) and the
    236  f02f							; high byte then misses that carry — level 14 of a 20-level stage read its
    237  f02f							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    238  f02f		       a5 a1		      lda	LevelRoomN
    239  f031		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    240  f032		       18		      clc
