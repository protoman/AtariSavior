   2029  fd08		       a9 00		      lda	#0
   2030  fd0a				   .M1got
   2031  fd0a		       85 8e		      sta	CollisionEndX
   2032  fd0c		       a5 ba		      lda	EnemyDeadMask
   2033  fd0e		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   2034  fd10		       f0 04		      beq	.M1stage
   2035  fd12		       a9 00		      lda	#0
   2036  fd14		       85 8e		      sta	CollisionEndX
   2037  fd16				   .M1stage
   2038  fd16							; --- BallX staging: Temp ($88) ---
   2039  fd16							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   2040  fd16							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   2041  fd16							; GONE (user 2026-10-12: door must look like the plain async strip;
   2042  fd16							; only the key/bomb semantics differ). One write per VBL is the
   2043  fd16							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   2044  fd16		       a9 35		      lda	#$35
   2045  fd18		       85 0a		      sta	CTRLPF
   2046  fd1a		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
   2047  fd1c		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
   2048  fd1e							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
   2049  fd1e							; and fake a 1-cell ball at x72-79 on a
   2050  fd1e							; hot-without-ball model
   2051  fd1e		       f0 0b		      beq	.SBTnoBall
   2052  fd20		       0a		      asl
   2053  fd21		       0a		      asl
   2054  fd22		       0a		      asl		; *8
