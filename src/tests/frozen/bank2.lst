    681  f2eb		       4a		      lsr
    682  f2ec		       4a		      lsr		; committed raw col
    683  f2ed		       85 8b		      sta	CollisionX	; scratch (range anchor already consumed)
    684  f2ef		       a5 88		      lda	Temp
    685  f2f1		       4a		      lsr
    686  f2f2		       4a		      lsr		; candidate raw col
    687  f2f3		       c5 8b		      cmp	CollisionX
    688  f2f5		       d0 07		      bne	.MothGateWalk	; new column -> must probe
    689  f2f7		       a5 88		      lda	Temp
    690  f2f9		       95 bd		      sta	EnemyRamX,X	; same box -> arrival state was clear -> commit
    691  f2fb		       4c 28 f2 	      jmp	MothExit
    692  f2fe				   .MothGateWalk
    693  f2fe		       4c 50 f1 	      jmp	MothDoWalk
