   2052  fd7a		       f0 ef		      beq	HOVnext	; vcrunch skip (HOVnext pops the loop Y)
   2053  fd7c		       4c fc fb 	      jmp	HOVFeatPre	; → pre-read fields (bank2 ROM) → bank3 dispatch
   2054  fd7f		       00 00 00 00*	      .ds	8, 0	; pad: 2+2+3+8 = 15B = old body size
