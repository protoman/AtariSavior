   1474  fb71		       e0 01		      cpx	#1
   1475  fb73		       d0 03		      bne	.hcN
   1476  fb75		       a9 01		      lda	#1	; full=1: n always 1
   1477  fb77		       60		      rts
   1478  fb78				   .hcN
