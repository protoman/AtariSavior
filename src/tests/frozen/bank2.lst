------- FILE bank2.asm
    156  f000
    157  f000							; --- 5-byte stub ---
    158  f000		       a9 00		      lda	#0
    159  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    160  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    161  f008
    162  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    163  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    164  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    165  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    166  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    167  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    168  f008							; = Origin Reverse.
    169  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    170  f010				   EnterRoomB2
    171  f010		       85 98		      sta	RoomNo
    172  f012		       0a		      asl
    173  f013		       a8		      tay		; Y = room * 2 (C3: ONE word per room)
    174  f014		       a5 9f		      lda	LevelPFDataLo
    175  f016		       85 e5		      sta	FetchPtr
    176  f018		       a5 a0		      lda	LevelPFDataHi
    177  f01a		       85 e6		      sta	FetchPtr+1
    178  f01c		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: rects ptr lo
    179  f01e		       85 90		      sta	RoomRectsLo
    180  f020		       c8		      iny
    181  f021		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    182  f023		       85 91		      sta	RoomRectsHi
    183  f025							; TilePF0 is no longer stored per room: bank3's block reader derives it
    184  f025							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    185  f025
    186  f025							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    187  f025							;     live in BANK3 (the level-data bank). One tail-jump into the block
    188  f025							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    189  f025							;     0 pushes (the room-load chain sits at the measured SP floor).
    190  f025		       4c 50 f4 	      jmp	ERBlocksPad
    191  f028				   ERBlocksDone
    192  f028
    193  f028							; --- enemy record for this room (C2 2026-10-20, packed 1 B 2026-10-20) ---
    194  f028							; byte = count<<6 | first record index<<1 | bottom-band flag.
    195  f028							; RoomEnemies = level base + 4n, enemy records = level base + 5n
    196  f028							; (2026-10-20: the enemy record is ONE byte/room now)
    197  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    198  f028							; The band COLOR is the global BAND_COLOR (one water color per game).
    199  f028		       a5 98		      lda	RoomNo
    200  f02a		       a8		      tay		; Y = room (one byte per record)
    201  f02b		       a5 9f		      lda	LevelPFDataLo
    202  f02d		       18		      clc
    203  f02e		       65 a1		      adc	LevelRoomN
    204  f030		       65 a1		      adc	LevelRoomN
    205  f032		       65 a1		      adc	LevelRoomN
    206  f034		       65 a1		      adc	LevelRoomN	; base + 4n = RoomEnemies
    207  f036		       85 e5		      sta	FetchPtr
    208  f038		       a5 a0		      lda	LevelPFDataHi
    209  f03a		       69 00		      adc	#0
    210  f03c		       85 e6		      sta	FetchPtr+1
    211  f03e		       b1 e5		      lda	(FetchPtr),Y
    212  f040		       4a		      lsr
    213  f041		       4a		      lsr
    214  f042		       4a		      lsr
    215  f043		       4a		      lsr
    216  f044		       4a		      lsr
    217  f045		       4a		      lsr		; count = b7-6
    218  f046		       85 b3		      sta	EnemyCount
    219  f048		       a5 e5		      lda	FetchPtr
    220  f04a		       18		      clc
    221  f04b		       65 a1		      adc	LevelRoomN	; base + 5n = enemy records (1 B/room)
    222  f04d		       85 b1		      sta	EnemyDataLo
    223  f04f		       a5 e6		      lda	FetchPtr+1
    224  f051		       69 00		      adc	#0
    225  f053		       85 b2		      sta	EnemyDataHi
    226  f055		       b1 e5		      lda	(FetchPtr),Y
    227  f057		       4a		      lsr		; first record index → b4-0 (was b5-1)
    228  f058		       29 1f		      and	#$1F
    229  f05a		       0a		      asl
