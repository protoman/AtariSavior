   2024  fd16							; --- BallX staging: Temp ($88) ---
   2025  fd16							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   2026  fd16							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   2027  fd16							; GONE (user 2026-10-12: door must look like the plain async strip;
   2028  fd16							; only the key/bomb semantics differ). One write per VBL is the
   2029  fd16							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   2030  fd16		       a9 35		      lda	#$35
