    716  f301							; ------------------------------------------------------------------------------
    717  f301							; TallyEntry — level-bonus tally body (user spec 2026-10-02). Entered from
    718  f301							; bank0's TallyTramp ($FFE6) via jsr; tail-jmps ReturnPad ($FBF8) so A (and
    719  f301							; Z) survive back to the bank0 caller.
    720  f301							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    721  f301							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    722  f301							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    723  f301							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    724  f301							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    725  f301							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    726  f301							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    727  f301							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    728  f301							; Pinned $F313 (org $F9D9 below: level data pins the overflow = build fails).
    729  f301							; Was $F310 → $F313 (Phase 4 walk-head; kernel TallyEntry EQU moves with
    730  f301							; it — both jmp operands are symbolic). The LWC M1 tip test (2026-10-08)
    731  f301							; funds itself by moving ColOff/ColMask past this pin (see their comment).
    732  f301							; ------------------------------------------------------------------------------
    733  f301		       00 00 00 00*	      .ds	$F313 - *, 0
    734  f313				   TallyEntry
    735  f313		       a5 8a		      lda	DropTarget
    736  f315		       f0 36		      beq	.TEArm
    737  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    738  f319		       d0 2d		      bne	.TEIdle
    739  f31b		       a9 04		      lda	#4
    740  f31d		       85 ad		      sta	TickCounter
    741  f31f		       c6 f2		      dec	TallyTicks
    742  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    743  f323		       a5 f2		      lda	TallyTicks
    744  f325		       29 03		      and	#3
    745  f327		       d0 15		      bne	.TEOne	; tick only
    746  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    747  f32b		       85 f1		      sta	BombSnd
    748  f32d		       a9 04		      lda	#4
    749  f32f		       85 15		      sta	AUDC0	; square
    750  f331		       a9 18		      lda	#24
    751  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    752  f335		       a9 08		      lda	#8
    753  f337		       85 19		      sta	AUDV0
    754  f339		       a9 03		      lda	#3	; tick + coin
    755  f33b		       4c f8 fb 	      jmp	ReturnPad
    756  f33e				   .TEOne
    757  f33e		       a9 01		      lda	#1	; tick only
    758  f340		       4c f8 fb 	      jmp	ReturnPad
    759  f343				   .TEFinal
    760  f343		       a9 07		      lda	#7	; tick + coin + done
    761  f345		       4c f8 fb 	      jmp	ReturnPad
    762  f348				   .TEIdle
    763  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    764  f34a		       4c f8 fb 	      jmp	ReturnPad
    765  f34d				   .TEArm
    766  f34d		       a5 ae		      lda	BarLevel
    767  f34f		       18		      clc
    768  f350		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    769  f352		       a2 00		      ldx	#0
    770  f354				   .TEDiv
    771  f354		       c9 06		      cmp	#6
    772  f356		       90 06		      bcc	.TEDivSum
    773  f358		       38		      sec
    774  f359		       e9 06		      sbc	#6
    775  f35b		       e8		      inx		; X = time ticks (0..20; BarLevel <= 120)
    776  f35c		       d0 f6		      bne	.TEDiv
    777  f35e				   .TEDivSum
    778  f35e		       20 80 f8 	      jsr	TallySum	; TallyTicks = ticks + 20 + bombs + 2*lives
