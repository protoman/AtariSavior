    256  f091		       b0 36		      bcs	EBLER_Done
    257  f093		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    258  f096		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    259  f098		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    260  f09a		       c8		      iny		; +1 = x
    261  f09b		       b1 e5		      lda	(FetchPtr),Y
    262  f09d		       95 bd		      sta	EnemyRamX,X
    263  f09f		       c8		      iny		; +2 = y
    264  f0a0		       b1 e5		      lda	(FetchPtr),Y
    265  f0a2		       95 e2		      sta	EnemyRamY,X
