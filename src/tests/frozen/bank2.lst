   2029  fd00		       0a		      asl
   2030  fd01		       0a		      asl		; *8
   2031  fd02		       18		      clc
   2032  fd03		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   2033  fd05		       4c 0a fd 	      jmp	.M1got
   2034  fd08				   .M1zero
   2035  fd08		       a9 00		      lda	#0
   2036  fd0a				   .M1got
   2037  fd0a		       85 8e		      sta	CollisionEndX
   2038  fd0c		       a5 ba		      lda	EnemyDeadMask
   2039  fd0e		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   2040  fd10		       f0 04		      beq	.M1stage
   2041  fd12		       a9 00		      lda	#0
   2042  fd14		       85 8e		      sta	CollisionEndX
   2043  fd16				   .M1stage
   2044  fd16							; --- BallX staging: Temp ($88) ---
   2045  fd16							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
   2046  fd16							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
   2047  fd16							; GONE (user 2026-10-12: door must look like the plain async strip;
   2048  fd16							; only the key/bomb semantics differ). One write per VBL is the
   2049  fd16							; cave's value (the HUD's own $05/$35 dance runs after the cave).
   2050  fd16		       a9 35		      lda	#$35
   2051  fd18		       85 0a		      sta	CTRLPF
   2052  fd1a		       a5 9a		      lda	RoomMetaB	; MetaB = ball_col+1 (0 = none)
   2053  fd1c		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
   2054  fd1e							; (retired door/vcrunch flag) AND b6 (hot) — b6 used to survive
   2055  fd1e							; and fake a 1-cell ball at x72-79 on a
   2056  fd1e							; hot-without-ball model
   2057  fd1e		       f0 0b		      beq	.SBTnoBall
   2058  fd20		       0a		      asl
   2059  fd21		       0a		      asl
   2060  fd22		       0a		      asl		; *8
