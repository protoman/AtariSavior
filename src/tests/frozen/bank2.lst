   1453  f949							; for that left-half cell (PF0: bits4-7 left-to-right; PF1: bits7-0;
   1454  f949							; PF2: bits0-7 reversed). Pairs never straddle a register (even 2c).
   1455  f949				   PhMaskTab
   1456  f949		       30 c0		      .byte.b	$30, $C0	; PF0 pairs (0,1) (2,3)
   1457  f94b		       c0 30 0c 03	      .byte.b	$C0, $30, $0C, $03	; PF1 pairs (4,5) (6,7) (8,9) (10,11)
   1458  f94f		       03 0c 30 c0	      .byte.b	$03, $0C, $30, $C0	; PF2 pairs (12,13) ... (18,19)
   1459  f953		       00 00 00 00*	      .ds	$F970 - *, 0	; pinned: bank1 .BMWDone jmp operand ($F970)
   1460  f970				   M1StripBlast
   1461  f970							; Phase 4 M1 strip blast — entered from bank1 BombMarkWalls .BMWDone
   1462  f970							; via the $F9AC shared pad (`sta $1FF8 / jmp $F970`; 0 pushes). Bank2-
   1463  f970							; only job (P2b stager): the packed meta (TilePF0+9/+10) lives in THIS
   1464  f970							; bank's ROM — read the door flags + left-strip dcol, stage them, let
   1465  f970							; bank1 StripBlastCheck run BOTH overlap takes (the blast window is
   1466  f970							; left-half cols 0..19 and stays READ-ONLY here).
   1467  f970							; Staging contract (both scratch bytes free in this flow):
   1468  f970							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
   1469  f970							;   Temp ($88 = bank1 BMWScratch) := $FF when MetaB b7 (right door)
   1470  f970							;   so the ball-strip take can never fire. Key pickup (P5) sets b3/b4
   1471  f970							;   for doors instead (comment hook at the takes).
   1472  f970		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
   1473  f972		       c9 14		      cmp	#20
   1474  f974		       b0 1d		      bcs	.M1SBnone	; right bomb → left strip unreachable
   1475  f976		       a5 ba		      lda	EnemyDeadMask
   1476  f978		       29 10		      and	#$10	; b4 already set → nothing to stage
   1477  f97a		       d0 17		      bne	.M1SBnone
   1478  f97c		       a0 09		      ldy	#9
   1479  f97e		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
   1480  f980		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
   1481  f982		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
   1482  f984		       b1 99		      lda	(RoomPF0Lo),Y	; reload (and clobbered A)
   1483  f986		       4a		      lsr
   1484  f987		       4a		      lsr
   1485  f988		       4a		      lsr
   1486  f989		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
   1487  f98a							;   high end — bank1's hi test rejects)
   1488  f98a		       38		      sec
   1489  f98b		       e9 01		      sbc	#1	; ℓ = left_col
   1490  f98d		       0a		      asl		; 2ℓ = strip left dcol
   1491  f98e		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
   1492  f990		       4c 97 f9 	      jmp	.M1SBdoorR
   1493  f993				   .M1SBnone
   1494  f993		       a9 ff		      lda	#$FF
   1495  f995		       85 92		      sta	RectCount	; no left strip this frame
   1496  f997				   .M1SBdoorR
   1497  f997		       a0 0a		      ldy	#10
   1498  f999		       b1 99		      lda	(RoomPF0Lo),Y	; MetaB, b7 = right door
   1499  f99b		       10 04		      bpl	.M1SBout
   1500  f99d		       a0 ff		      ldy	#$FF
   1501  f99f		       84 88		      sty	Temp	; = bank1's BMWScratch ($88) — "no strip"
   1502  f9a1				   .M1SBout
   1503  f9a1		       4c b2 f9 	      jmp	M1ToBank1	; shared pad $F9B2 (sta $1FF7 / jmp $F937,
   1504  f9a4							; byte-identical in bank1) → StripBlastCheck
   1505  f9a4
   1506  f9a4		       00 00 00 00*	      .ds	$F9AC - *, 0	; shared cross-bank pad — byte-IDENTICAL twin
   1507  f9ac							; of bank1's $F9A4 block (identity asserted
   1508  f9ac							; in test_bomb_strip). After either `sta $1FFx`
   1509  f9ac							; the next opcode fetch comes from the newly
   1510  f9ac							; selected bank at pc+3, so the `jmp` bytes
   1511  f9ac							; must match in both banks (F6 pad rule).
   1512  f9ac				   M1ToBank2		; reached bank1-side after `sta $1FF8`
   1513  f9ac		       8d f8 1f 	      sta	$1FF8	; switch bank1 → bank2
   1514  f9af		       4c 70 f9 	      jmp	$F970	; M1StripBlast
   1515  f9b2				   M1ToBank1		; = $F9B2 — M1StripBlast jmps here bank2-side
   1516  f9b2		       8d f7 1f 	      sta	$1FF7	; switch bank2 → bank1
   1517  f9b5		       4c 37 f9 	      jmp	$F937	; StripBlastCheck
   1518  f9b8
   1519  f9b8					      .ds	$F9B8 - *, 0	; Phase 4 overlay tramp twin (kernel.asm's
   1520  f9b8							; copy sits at the same address — bank0
   1521  f9b8							; executes +0..+6, the bank2 fetch starts
   1522  f9b8							; at the jmp; the clc/rts tail is bank0-only)
   1523  f9b8				   OverlayTramp
   1524  f9b8		       a5 84		      lda	LineCount	; dead in bank2 (entry arrives at +7)
   1525  f9ba		       f0 06		      beq	.OTsym
   1526  f9bc		       8d f8 1f 	      sta	$1FF8
   1527  f9bf		       4c 00 fe 	      jmp	PHMOverlay
   1528  f9c2				   .OTsym
   1529  f9c2		       18		      clc
   1530  f9c3		       60		      rts
   1531  f9c4
   1532  f9c4							; --- Level data, main window $F9D9..$FBD6 (509B; pads pin the end).
   1533  f9c4							; Level 3 (~104B) spills to the $F901 gap and level 4 + levels_index
   1534  f9c4							; (~128B) to the $F767 gap above (bugs.md 27 — re-place on growth).
   1535  f9d9					      org	$F9D9
