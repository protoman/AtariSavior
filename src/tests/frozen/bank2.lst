   2021  fcfd		       f0 09		      beq	.M1zero
   2022  fcff		       0a		      asl
   2023  fd00		       0a		      asl
   2024  fd01		       0a		      asl		; *8
   2025  fd02		       18		      clc
   2026  fd03		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
   2027  fd05		       4c 0a fd 	      jmp	.M1got
