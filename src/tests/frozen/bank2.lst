   1478  fc4c							; Room-exit handlers — MOVED from bank0 (C3, 2026-10-20; were $F4DB-$F535 = 90 B).
   1479  fc4c							; C1 (2026-10-20): LEVEL_FORMAT 2 — there is NO connection table any more. Each
   1480  fc4c							; room owns ONE grid-position byte (x<<4|y, normalised to the level origin) at
   1481  fc4c							; level base + n (C2 2026-10-20: the 3 B record is three columns, so the
   1482  fc4c							; position column still starts one block-of-n in), and an exit is resolved by
   1483  fc4c							; stepping that byte by a direction delta ($FF up / $01 down / $F0 left /
   1484  fc4c							; $10 right) and SCANNING the level's position column for a match (<= 20
   1485  fc4c							; iterations, cold path = room load only).
   1486  fc4c							;
   1487  fc4c							; Why no boundary guard is needed: a nibble of 15 never occurs in a stored
   1488  fc4c							; position (POSITION_SPAN = 15 in convert_level.py, nibble 15 = sentinel), and
   1489  fc4c							; stepping off the grid always wraps the moved nibble to 15 — so an exit past
   1490  fc4c							; the grid edge can never match a room. The old nibble-room-index pack capped a
   1491  fc4c							; level at 15 rooms; this lifts it to 225 grid cells (20 rooms/level with room
   1492  fc4c							; to spare) at 1 B/room instead of 2.
   1493  fc4c							;
   1494  fc4c							; Entry: bank0's `jsr ExitRoomXxx` pad ($FBD9-$FBE4, `sta $1FF6`) -> the `jmp`
   1495  fc4c							; halves at $FBDC-$FBE5 above. Every exit path ends in a `jmp`:
   1496  fc4c							;   * no exit	    -> ReturnPad (bank0 `rts` pops the caller's jsr frame)
   1497  fc4c							;   * room changed -> `jmp EnterRoomB2`, whose own `jmp ReturnPad` does the same
   1498  fc4c							; The opposite-edge placement is written BEFORE EnterRoomB2 because EnterRoom
   1499  fc4c							; never reads/writes RoomX/RoomY (verified in EnterRoomB2 + B3RoomBlocks), and
   1500  fc4c							; Y is used for the constant so A keeps the ROOM INDEX EnterRoomB2 stores.
   1501  fc4c							; Guard: verify_build.check_exit_handlers.
   1502  fc4c							; ==============================================================================
   1503  fc4c		       00 00 00 	      .ds	$FC4F - *, 0
   1504  fc4f							; Scan the level's position column for the target byte.
   1505  fc4f							; In: A = target position, FetchPtr = level base + n. Out: A = room index,
   1506  fc4f							; C = 0 found / 1 none. Clobbers A/Y only (X is the caller's direction).
   1507  fc4f				   ExitScanB2
   1508  fc4f		       85 a2		      sta	LevelConnSpare
   1509  fc51		       a0 00		      ldy	#0
   1510  fc53				   .EScanLoop
   1511  fc53		       b1 e5		      lda	(FetchPtr),Y
