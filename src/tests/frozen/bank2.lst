    952  f864		       00 00 00 00*	      .ds	$F880 - *, 0
    953  f880							; TallySum — the level-bonus total for TallyEntry (frozen-scene frame).
    954  f880							; Split OUT of the inline TallyEntry region (it ends at a hard org) into bank2's
    955  f880							; free slack before the $F970 pin. IN: X = time ticks (0..20). OUT: TallyTicks
    956  f880							; set; A clobbered, X/Y kept. The bomb count MUST be masked: PlayerBombs' high
    957  f880							; bits carry the raft's take-off ramp state (b7 flag, b6-3 level — see the
    958  f880							; kernel EQU contract), and a stale ride would otherwise inflate the bonus.
    959  f880							; Temp ($88) is free here: the tally frame bypasses the input (its joystick
    960  f880							; store) and the next VBL restages Temp anyway.
    961  f880				   TallySum
    962  f880		       a5 f0		      lda	PlayerBombs
    963  f882		       29 07		      and	#%00000111	; bombs only, never the ramp bits
    964  f884		       85 88		      sta	Temp
    965  f886		       8a		      txa
    966  f887		       18		      clc
    967  f888		       69 14		      adc	#20	; miner reach = 1000 pts
    968  f88a		       65 88		      adc	Temp	; + 50 per unspent bomb (chain carry ok)
    969  f88c		       85 f2		      sta	TallyTicks
    970  f88e		       a5 ac		      lda	PlayerLives
    971  f890		       0a		      asl		; + 100 per life = 2 ticks
    972  f891		       18		      clc
    973  f892		       65 f2		      adc	TallyTicks
    974  f894		       85 f2		      sta	TallyTicks
    975  f896		       60		      rts
    976  f897
    977  f897		       00 00 00 00*	      .ds	$F8B7 - *, 0	; spill-pool gap
    978  f8b7							; (was the $F8DD jet-art twin pin — deleted
