   1959  ffe6		       0f 0e 0c 08	      .byte.b	15,14,12,8	; rows 0..3 -> mask bits >= row (N=4: the
   1960  ffea							;   pack carries four gates, b3 = band 3)
   1961  ffea				   OvTail
   1962  ffea		       01 03 07 0f	      .byte.b	1,3,7,15	; rows 0..3 -> mask bits <= row
   1963  ffee
   1964  ffee				   EnemyBitTable
   1965  ffee		       01 02 04 08	      .byte.b	$01, $02, $04, $08	; slot-indexed dead/dir bits
   1966  fff2
   1967  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   1968  fff2
   1969  fff2							; Pad to vectors at $FFFA ($FFF2-$FFF9 = fill — never code: $FFF6-$FFF9
   1970  fff2							; are F6 hotspot mirrors on peek, see MothExitPad at $FC49)
   1971  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0
   1972  fffa
   1973  fffa							; Interrupt vectors
   1974  fffa		       00 f0		      .word.w	$F000	; NMI vector
   1975  fffc		       00 f0		      .word.w	$F000	; RESET vector
   1976  fffe		       00 f0		      .word.w	$F000	; IRQ vector
