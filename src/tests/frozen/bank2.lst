   1453  f924							; Phase 3 blink masks — pair index (2c>>1) → the two adjacent PF bits
   1454  f924							; for that left-half cell (PF0: bits4-7 left-to-right; PF1: bits7-0;
   1455  f924							; PF2: bits0-7 reversed). Pairs never straddle a register (even 2c).
   1456  f924				   PhMaskTab
   1457  f924		       30 c0		      .byte.b	$30, $C0	; PF0 pairs (0,1) (2,3)
   1458  f926		       c0 30 0c 03	      .byte.b	$C0, $30, $0C, $03	; PF1 pairs (4,5) (6,7) (8,9) (10,11)
   1459  f92a		       03 0c 30 c0	      .byte.b	$03, $0C, $30, $C0	; PF2 pairs (12,13) ... (18,19)
   1460  f92e		       00 00 00 00*	      .ds	$F970 - *, 0	; pinned: bank1 .BMWDone jmp operand ($F970)
   1461  f970				   M1StripBlast
   1462  f970							; Phase 4 M1 strip blast — entered from bank1 BombMarkWalls .BMWDone
   1463  f970							; via the $F9AC shared pad (`sta $1FF8 / jmp $F970`; 0 pushes). Bank2-
   1464  f970							; only job (P2b stager): the packed meta (TilePF0+9/+10) lives in THIS
   1465  f970							; bank's ROM — read the door flags + left-strip dcol, stage them, let
   1466  f970							; bank1 StripBlastCheck run BOTH overlap takes (the blast window is
   1467  f970							; left-half cols 0..19 and stays READ-ONLY here).
   1468  f970							; Staging contract (both scratch bytes free in this flow):
   1469  f970							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
   1470  f970							;   Temp ($88 = bank1 BMWScratch) := $FF when MetaB b7 (right door)
   1471  f970							;   so the ball-strip take can never fire. Key pickup (P5) sets b3/b4
   1472  f970							;   for doors instead (comment hook at the takes).
   1473  f970		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
   1474  f972		       c9 14		      cmp	#20
   1475  f974		       b0 1d		      bcs	.M1SBnone	; right bomb → left strip unreachable
   1476  f976		       a5 ba		      lda	EnemyDeadMask
   1477  f978		       29 10		      and	#$10	; b4 already set → nothing to stage
   1478  f97a		       d0 17		      bne	.M1SBnone
   1479  f97c		       a0 09		      ldy	#9
   1480  f97e		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
   1481  f980		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
   1482  f982		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
   1483  f984		       b1 99		      lda	(RoomPF0Lo),Y	; reload (and clobbered A)
   1484  f986		       4a		      lsr
   1485  f987		       4a		      lsr
   1486  f988		       4a		      lsr
   1487  f989		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
   1488  f98a							;   high end — bank1's hi test rejects)
   1489  f98a		       38		      sec
   1490  f98b		       e9 01		      sbc	#1	; ℓ = left_col
   1491  f98d		       0a		      asl		; 2ℓ = strip left dcol
   1492  f98e		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
   1493  f990		       4c 97 f9 	      jmp	.M1SBdoorR
   1494  f993				   .M1SBnone
   1495  f993		       a9 ff		      lda	#$FF
   1496  f995		       85 92		      sta	RectCount	; no left strip this frame
   1497  f997				   .M1SBdoorR
   1498  f997		       a0 0a		      ldy	#10
