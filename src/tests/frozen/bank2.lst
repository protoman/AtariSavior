   2018  fd0c		       a5 ba		      lda	EnemyDeadMask
   2019  fd0e		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
   2020  fd10		       f0 04		      beq	.M1stage
   2021  fd12		       a9 00		      lda	#0
