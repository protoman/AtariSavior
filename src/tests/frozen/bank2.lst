    655  f301							; ------------------------------------------------------------------------------
    656  f301							; TallyEntry — level-bonus award + frozen hold (user decision 2026-10-19,
    657  f301							; replacing the 2026-10-02 count-up: A+C = award at once, keep the hold).
    658  f301							; Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps ReturnPad
    659  f301							; ($FBF8) so A (and Z) survive back to the bank0 caller.
    660  f301							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    661  f301							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    662  f301							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then award the WHOLE amount
    663  f301							;     (TallyAward, one BCD add in this frame), reload TallyTicks as the HOLD
    664  f301							;     countdown (TALLY_HOLD frames, final score visible), clear jet/beam, set
    665  f301							;     DropTarget = $FE.
    666  f301							;   DropTarget == $FE (every held frame) -> dec TallyTicks. Event A: b2 = done
    667  f301							;     (last hold frame), 0 = no event. No coin tone, no pacing divider.
    668  f301							; Pinned $F313 (org $F9D9 below: level data pins the overflow = build fails).
    669  f301							; Was $F310 → $F313 (Phase 4 walk-head; kernel TallyEntry EQU moves with
    670  f301							; it — both jmp operands are symbolic). The LWC M1 tip test (2026-10-08)
    671  f301							; funds itself by moving ColOff/ColMask past this pin (see their comment).
    672  f301							; ------------------------------------------------------------------------------
    673  f301		       00 24	   TALLY_HOLD =	36	; frozen frames after the award (~0.6 s)
    674  f301		       00 00 00 00*	      .ds	$F313 - *, 0
    675  f313				   TallyEntry
    676  f313		       a5 8a		      lda	DropTarget
    677  f315		       f0 0e		      beq	.TEArm
    678  f317		       c6 f2		      dec	TallyTicks	; hold: 1 frame per unit
    679  f319		       f0 05		      beq	.TEDone
    680  f31b		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    681  f31d		       4c f8 fb 	      jmp	ReturnPad
    682  f320				   .TEDone
    683  f320		       a9 04		      lda	#4	; b2 = done
    684  f322		       4c f8 fb 	      jmp	ReturnPad
    685  f325				   .TEArm
    686  f325		       a5 ae		      lda	BarLevel
    687  f327		       18		      clc
