------- FILE bank2.asm
    142  f000
    143  f000							; --- 5-byte stub ---
    144  f000		       a9 00		      lda	#0
    145  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    146  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    147  f008
    148  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    149  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    150  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    151  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    152  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    153  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    154  f008							; = Origin Reverse.
    155  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    156  f010				   EnterRoomB2
    157  f010		       85 98		      sta	RoomNo
    158  f012		       0a		      asl
    159  f013		       a8		      tay		; Y = room * 2 (C3: ONE word per room)
    160  f014		       a5 9f		      lda	LevelPFDataLo
    161  f016		       85 e5		      sta	FetchPtr
    162  f018		       a5 a0		      lda	LevelPFDataHi
    163  f01a		       85 e6		      sta	FetchPtr+1
    164  f01c		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: rects ptr lo
    165  f01e		       85 90		      sta	RoomRectsLo
    166  f020		       c8		      iny
    167  f021		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    168  f023		       85 91		      sta	RoomRectsHi
    169  f025							; TilePF0 is no longer stored per room: bank3's block reader derives it
    170  f025							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    171  f025
    172  f025							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    173  f025							;     live in BANK3 (the level-data bank). One tail-jump into the block
    174  f025							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    175  f025							;     0 pushes (the room-load chain sits at the measured SP floor).
    176  f025		       4c 50 f4 	      jmp	ERBlocksPad
    177  f028				   ERBlocksDone
    178  f028
    179  f028							; --- enemy record for this room (C2 2026-10-20, packed 1 B 2026-10-20) ---
    180  f028							; byte = count<<6 | first record index<<1 | bottom-band flag.
    181  f028							; RoomEnemies = level base + 4n, enemy records = level base + 5n
    182  f028							; (2026-10-20: the enemy record is ONE byte/room now)
    183  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    184  f028							; The band COLOR is the global BAND_COLOR (one water color per game).
    185  f028		       a5 98		      lda	RoomNo
    186  f02a		       a8		      tay		; Y = room (one byte per record)
    187  f02b		       a5 9f		      lda	LevelPFDataLo
    188  f02d		       18		      clc
    189  f02e		       65 a1		      adc	LevelRoomN
    190  f030		       65 a1		      adc	LevelRoomN
    191  f032		       65 a1		      adc	LevelRoomN
    192  f034		       65 a1		      adc	LevelRoomN	; base + 4n = RoomEnemies
    193  f036		       85 e5		      sta	FetchPtr
    194  f038		       a5 a0		      lda	LevelPFDataHi
    195  f03a		       69 00		      adc	#0
    196  f03c		       85 e6		      sta	FetchPtr+1
    197  f03e		       b1 e5		      lda	(FetchPtr),Y
    198  f040		       4a		      lsr
    199  f041		       4a		      lsr
    200  f042		       4a		      lsr
    201  f043		       4a		      lsr
    202  f044		       4a		      lsr
    203  f045		       4a		      lsr		; count = b7-6
    204  f046		       85 b3		      sta	EnemyCount
    205  f048		       a5 e5		      lda	FetchPtr
    206  f04a		       18		      clc
    207  f04b		       65 a1		      adc	LevelRoomN	; base + 5n = enemy records (1 B/room)
    208  f04d		       85 b1		      sta	EnemyDataLo
    209  f04f		       a5 e6		      lda	FetchPtr+1
    210  f051		       69 00		      adc	#0
    211  f053		       85 b2		      sta	EnemyDataHi
    212  f055		       b1 e5		      lda	(FetchPtr),Y
    213  f057		       4a		      lsr		; first record index → b4-0 (was b5-1)
    214  f058		       29 1f		      and	#$1F
    215  f05a		       0a		      asl
    216  f05b		       0a		      asl		; *4 (index <= 31 → fits one byte)
    217  f05c		       18		      clc
    218  f05d		       65 b1		      adc	EnemyDataLo
    219  f05f		       85 b1		      sta	EnemyDataLo
    220  f061		       a5 b2		      lda	EnemyDataHi
    221  f063		       69 00		      adc	#0
    222  f065		       85 b2		      sta	EnemyDataHi
    223  f067		       b1 e5		      lda	(FetchPtr),Y	; raw record: b0 = bottom-band flag
    224  f069		       29 01		      and	#$01
    225  f06b		       f0 02		      beq	.EBnoBand
    226  f06d		       a9 80		      lda	#BAND_COLOR
    227  f06f				   .EBnoBand
    228  f06f		       85 bc		      sta	RoomBandColor	; SOURCE room's band on the transition frame
    229  f071		       a9 00		      lda	#0	; (also the bomb reset seed below)
    230  f073		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    231  f075
