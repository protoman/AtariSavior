    160  f010		       85 98		      sta	RoomNo
    161  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    162  f013		       a5 9f		      lda	LevelPFDataLo
    163  f015		       85 e5		      sta	FetchPtr
