    133  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    134  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    135  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    136  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    137  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    138  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    139  f008							; = Origin Reverse.
    140  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    141  f010				   EnterRoomB2
    142  f010		       85 98		      sta	RoomNo
    143  f012		       0a		      asl
    144  f013		       0a		      asl
    145  f014		       a8		      tay		; Y = room * 4
    146  f015		       a5 9f		      lda	LevelPFDataLo
    147  f017		       85 e5		      sta	FetchPtr
    148  f019		       a5 a0		      lda	LevelPFDataHi
    149  f01b		       85 e6		      sta	FetchPtr+1
    150  f01d		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: PF0 ptr lo
    151  f01f		       85 99		      sta	RoomPF0Lo
    152  f021		       c8		      iny
    153  f022		       b1 e5		      lda	(FetchPtr),Y	; PF0 ptr hi
    154  f024		       85 9a		      sta	RoomPF0Hi
    155  f026		       c8		      iny
    156  f027		       b1 e5		      lda	(FetchPtr),Y	; rects ptr lo
    157  f029		       85 90		      sta	RoomRectsLo
    158  f02b		       c8		      iny
    159  f02c		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    160  f02e		       85 91		      sta	RoomRectsHi
    161  f030
    162  f030							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    163  f030							;     live in BANK3 (the level-data bank). One tail-jump into the block
    164  f030							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    165  f030							;     0 pushes (the room-load chain sits at the measured SP floor).
    166  f030		       4c 50 f4 	      jmp	ERBlocksPad
    167  f033				   ERBlocksDone
    168  f033
    169  f033							; --- enemy record for this room (4 bytes: ptr_lo, ptr_hi, count, band) ---
    170  f033		       a5 98		      lda	RoomNo
    171  f035		       0a		      asl
    172  f036		       0a		      asl
    173  f037		       a8		      tay
    174  f038		       a5 af		      lda	LevelEnemyLo
    175  f03a		       85 e5		      sta	FetchPtr
    176  f03c		       a5 b0		      lda	LevelEnemyHi
    177  f03e		       85 e6		      sta	FetchPtr+1
