   1927  ff21		       85 e1		      sta	scorePtr1+1
   1928  ff23		       85 e3		      sta	scorePtr2+1
   1929  ff25		       85 e5		      sta	scorePtr3+1
   1930  ff27		       85 e7		      sta	scorePtr4+1
   1931  ff29		       85 e9		      sta	scorePtr5+1
   1932  ff2b		       85 eb		      sta	scorePtr6+1
   1933  ff2d
   1934  ff2d		       a5 f2		      lda	LevelShowTimer
   1935  ff2f		       29 80		      and	#$80	; bit7 = banner flag (#18; tally ARM clears it)
   1936  ff31		       f0 1f		      beq	.scoreLows
