    273  f0af							; first move must be the retreat into its
    274  f0af							; wall (user 2026-10-19). Nothing else
    275  f0af							; reads the ROM dir: the patrol bounds are
    276  f0af							; spawn ± SNAKE_PATROL.
    277  f0af				   EBLER_Dir
    278  f0af		       a8		      tay		; Y = dir, re-setting N from A (the cpy
