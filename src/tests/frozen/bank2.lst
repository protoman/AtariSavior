   1945  ff43		       bd 05 f8 	      lda	LvOnes8,X	; (a div-10 loop cost +12c per tens digit: level 20's
   1946  ff46		       85 e8		      sta	scorePtr5	;  banner ran a whole scanline long, 273-line frames)
   1947  ff48		       bd 19 f8 	      lda	LvTens8,X
   1948  ff4b		       85 e6		      sta	scorePtr4
