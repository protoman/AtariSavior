    190  f02a		       a8		      tay		; Y = room (one byte per record)
    191  f02b		       a5 9f		      lda	LevelPFDataLo
    192  f02d		       18		      clc
    193  f02e		       65 a1		      adc	LevelRoomN
    194  f030		       65 a1		      adc	LevelRoomN
    195  f032		       65 a1		      adc	LevelRoomN	; base + 3n = RoomEnemies
    196  f034		       85 e5		      sta	FetchPtr
    197  f036		       a5 a0		      lda	LevelPFDataHi
    198  f038		       69 00		      adc	#0
    199  f03a		       85 e6		      sta	FetchPtr+1
    200  f03c		       b1 e5		      lda	(FetchPtr),Y
    201  f03e		       4a		      lsr
    202  f03f		       4a		      lsr
    203  f040		       4a		      lsr
    204  f041		       4a		      lsr
    205  f042		       4a		      lsr
    206  f043		       4a		      lsr		; count = b7-6
    207  f044		       85 b3		      sta	EnemyCount
    208  f046		       a5 e5		      lda	FetchPtr
    209  f048		       18		      clc
    210  f049		       65 a1		      adc	LevelRoomN	; base + 4n = enemy records (1 B/room)
    211  f04b		       85 b1		      sta	EnemyDataLo
    212  f04d		       a5 e6		      lda	FetchPtr+1
    213  f04f		       69 00		      adc	#0
    214  f051		       85 b2		      sta	EnemyDataHi
    215  f053		       b1 e5		      lda	(FetchPtr),Y
    216  f055		       4a		      lsr		; first record index → b4-0 (was b5-1)
    217  f056		       29 1f		      and	#$1F
    218  f058		       0a		      asl
