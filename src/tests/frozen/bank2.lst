    850  f401							; ------------------------------------------------------------------------------
    851  f401							; StageBandTab — asym meta: decode packed model meta into bank0 ZP for the cave.
    852  f401							; Reached from BuildColupF's tail (BCFDarkRun jmp here); ends at ReturnPad so
    853  f401							; the VBL jsr returns to bank0 (pads must not nest — no rts here).
    854  f401							; WHY here: models_data lives in THIS bank — a bank0 (RoomPF0Lo),Y read
    855  f401							; fetches bank0's $F9xx zero pad (the Phase 2 ball block silently read zeros).
    856  f401							; Packed meta (bugs.md 28 point 1): TilePF0+9 = MetaA = (m1_col+1)<<4 |
    857  f401							; band_mask (b0-2 = band0/1/2 gates); TilePF0+10 = MetaB = ball_col+1
    858  f401							; (0 = feature absent). Expanded to the old RAM shapes:
    859  f401							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates (.Row ENABL reads
    860  f401							;			  bit0; the pack's `bit`/`bpl` reads bit7)
    861  f401							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 ⇔ symmetric → skip;
    862  f401							;			  verify_build enforces)
    863  f401							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    864  f401							; Window: staged every VBL → read by cave → bank1 HUD stomps $ED-$EF after
    865  f401							; the cave read → overscan rewrites $88 (joystick) after the ball read.
    866  f401							; ------------------------------------------------------------------------------
    867  f401				   StageBandTab
    868  f401							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    869  f401		       a0 09		      ldy	#9
    870  f403							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    871  f403							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    872  f403							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    873  f403							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    874  f403							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    875  f403							; no-ball path below blanks BandTab so it never enables the ball.
    876  f403							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    877  f403							; the pack uses $8F).
    878  f403		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
    879  f405		       29 01		      and	#$01
    880  f407		       aa		      tax
    881  f408		       bd c0 f4 	      lda	M1OffTab,X
    882  f40b		       85 92		      sta	RectCount
    883  f40d		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
    884  f40f		       4a		      lsr		; band0 bit -> carry
    885  f410		       a9 00		      lda	#0
    886  f412		       2a		      rol
    887  f413		       f0 02		      beq	.SBTb0z
    888  f415		       a9 ff		      lda	#$ff
    889  f417				   .SBTb0z
    890  f417		       85 ed		      sta	BandTab
    891  f419		       b1 99		      lda	(RoomPF0Lo),Y
    892  f41b		       4a		      lsr
    893  f41c		       4a		      lsr		; band1 bit -> carry
    894  f41d		       a9 00		      lda	#0
    895  f41f		       2a		      rol
    896  f420		       f0 02		      beq	.SBTb1z
    897  f422		       a9 ff		      lda	#$ff
    898  f424				   .SBTb1z
    899  f424		       85 ee		      sta	BandTab+1
    900  f426		       b1 99		      lda	(RoomPF0Lo),Y
    901  f428		       4a		      lsr
    902  f429		       4a		      lsr
    903  f42a		       4a		      lsr		; band2 bit -> carry
    904  f42b		       a9 00		      lda	#0
    905  f42d		       2a		      rol
    906  f42e		       f0 02		      beq	.SBTb2z
    907  f430		       a9 ff		      lda	#$ff
    908  f432				   .SBTb2z
    909  f432		       85 ef		      sta	BandTab+2
    910  f434							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
    911  f434							; set it this overscan) → blank all band gates so the cave renders no
    912  f434							; strip; the pack below then emits mask 0 → every overlay stays
    913  f434							; transparent too. BandTab restages from ROM next room entry. ---
    914  f434		       a5 ba		      lda	EnemyDeadMask
    915  f436		       29 08		      and	#$08
    916  f438		       f0 08		      beq	.SBTstripAlive
