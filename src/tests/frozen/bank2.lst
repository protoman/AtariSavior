    983  f8b7							; Phase 3 blink masks — pair index (2c>>1) → the two adjacent PF bits
    984  f8b7							; for that left-half cell (PF0: bits4-7 left-to-right; PF1: bits7-0;
    985  f8b7							; PF2: bits0-7 reversed). Pairs never straddle a register (even 2c).
    986  f8b7		       00 00 00 00*	      .ds	$F970 - *, 0	; pinned: bank1 .BMWDone jmp operand ($F970)
    987  f970				   M1StripBlast
    988  f970							; Phase 4 M1 strip blast — entered from bank1 BombMarkWalls .BMWDone
    989  f970							; via the $F9AC shared pad (`sta $1FF8 / jmp $F970`; 0 pushes). Bank2-
    990  f970							; only job (P2b stager): the packed meta (TilePF0+9/+10) lives in THIS
    991  f970							; bank's ROM — read the door flags + left-strip dcol, stage them, let
    992  f970							; bank1 StripBlastCheck run BOTH overlap takes (the blast window is
    993  f970							; left-half cols 0..19 and stays READ-ONLY here).
    994  f970							; Staging contract (both scratch bytes free in this flow):
    995  f970							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
    996  f970							;   Temp ($88 = bank1 BMWScratch) := $FF when MetaB b7 (right door)
    997  f970							;   so the ball-strip take can never fire. Key pickup (P5) sets b3/b4
    998  f970							;   for doors instead (comment hook at the takes).
    999  f970		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
   1000  f972		       c9 14		      cmp	#20
   1001  f974		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
   1002  f976		       a5 ba		      lda	EnemyDeadMask
   1003  f978		       29 10		      and	#$10	; b4 already set → nothing to stage
   1004  f97a		       d0 15		      bne	.M1SBnone
   1005  f97c		       a5 99		      lda	RoomMetaA	; MetaA
   1006  f97e		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
   1007  f980		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
   1008  f982		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
   1009  f984		       4a		      lsr
   1010  f985		       4a		      lsr
   1011  f986		       4a		      lsr
   1012  f987		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
   1013  f988							;   high end — bank1's hi test rejects)
