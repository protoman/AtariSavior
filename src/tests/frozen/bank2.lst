------- FILE generated/levels_equ.asm LEVEL 2 PASS 2
      0  f000					      include	"generated/levels_equ.asm"	; BAND_COLOR (0 bytes of ROM)
      1  f000							; Generated by convert_level.py --levels. Do not edit by hand.
      2  f000							; One bottom-band color for the whole game: the room record keeps only
      3  f000							; the per-room FLAG (convert_level rejects a second
      4  f000							; color — extend the format first if that is ever needed).
      5  f000		       00 80	   BAND_COLOR =	$80
------- FILE bank2.asm
    170  f000
    171  f000							; --- 5-byte stub ---
    172  f000		       a9 00		      lda	#0
    173  f002		       8d f4 1f 	      sta	$1FF4	; select bank0
    174  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    175  f008
    176  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    177  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF6 / jmp $F010).
    178  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    179  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    180  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    181  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    182  f008							; = Origin Reverse.
    183  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    184  f010				   EnterRoomB2
    185  f010		       85 98		      sta	RoomNo
    186  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    187  f013		       a5 9f		      lda	LevelPFDataLo
    188  f015		       85 e5		      sta	FetchPtr
    189  f017		       a5 a0		      lda	LevelPFDataHi
    190  f019		       85 e6		      sta	FetchPtr+1
    191  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b6-0 | band b7
    192  f01d		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    193  f01f							;   SHAPE ADDRESS TABLE lives in that bank,
    194  f01f							;   so bank2 needs no bank3 label). Loader
    195  f01f							;   scratch: overwritten with MetaA later.
    196  f01f		       85 88		      sta	Temp
    197  f021							; band flag b7 → RoomBandColor (staged BEFORE the block reader — the
    198  f021							; reader never writes it, and this is the only writer in the game).
    199  f021							; LAYOUT 8 (2026-10-24): the index is 7 bits and the band flag moved to b7;
    200  f021							; the owns-extras bit is GONE (a room has a record iff its counts byte
    201  f021							; carries a nonzero extras ordinal, which is exactly what ExtrasLoad
    202  f021							; indexes with — b7 was redundant).
    203  f021		       a5 88		      lda	Temp
    204  f023		       29 80		      and	#$80
    205  f025		       f0 02		      beq	.EBnoBand
    206  f027		       a9 80		      lda	#BAND_COLOR
    207  f029				   .EBnoBand
    208  f029		       85 bc		      sta	RoomBandColor
    209  f02b							; TilePF0 is no longer stored per room: bank3's block reader derives it
    210  f02b							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    211  f02b
    212  f02b							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    213  f02b							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    214  f02b							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    215  f02b							; (records stay contiguous in room order), so the old packed index byte
    216  f02b							; and its 31-record/level cap are gone. The band COLOR is the global
    217  f02b							; BAND_COLOR (one water color per game).
    218  f02b							; LevelConnSpare is free here: it only carries the exit-scan target, and
    219  f02b							; that scan has already returned when EnterRoomB2 is entered.
    220  f02b		       a5 98		      lda	RoomNo
    221  f02d		       a8		      tay		; Y = room (one byte per record)
    222  f02e							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    223  f02e							; low byte loses the first carry (the second `adc n` consumes it) and the
    224  f02e							; high byte then misses that carry — level 14 of a 20-level stage read its
    225  f02e							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    226  f02e		       a5 a1		      lda	LevelRoomN
    227  f030		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    228  f031		       18		      clc
    229  f032		       65 9f		      adc	LevelPFDataLo
    230  f034		       85 e5		      sta	FetchPtr
    231  f036		       a5 a0		      lda	LevelPFDataHi
    232  f038		       69 00		      adc	#0
    233  f03a		       85 e6		      sta	FetchPtr+1
    234  f03c		       b1 e5		      lda	(FetchPtr),Y
    235  f03e		       4a		      lsr
    236  f03f		       4a		      lsr
    237  f040		       4a		      lsr
    238  f041		       4a		      lsr
    239  f042		       4a		      lsr
    240  f043		       4a		      lsr		; count = b7-6
    241  f044		       85 b3		      sta	EnemyCount
    242  f046		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    243  f048		       a0 00		      ldy	#0
    244  f04a		       a9 00		      lda	#0
    245  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    246  f04e				   .EBSumLoop
    247  f04e		       c4 88		      cpy	Temp
    248  f050		       f0 11		      beq	.EBSumDone
    249  f052		       b1 e5		      lda	(FetchPtr),Y
    250  f054		       4a		      lsr
    251  f055		       4a		      lsr
    252  f056		       4a		      lsr
    253  f057		       4a		      lsr
    254  f058		       4a		      lsr
    255  f059		       4a		      lsr		; each earlier room's count (0..3)
    256  f05a		       18		      clc
    257  f05b		       65 a2		      adc	LevelConnSpare
    258  f05d		       85 a2		      sta	LevelConnSpare
    259  f05f		       c8		      iny
    260  f060		       4c 4e f0 	      jmp	.EBSumLoop
    261  f063				   .EBSumDone
    262  f063		       a5 e5		      lda	FetchPtr
    263  f065		       18		      clc
    264  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    265  f068		       85 b1		      sta	EnemyDataLo
    266  f06a		       a5 e6		      lda	FetchPtr+1
    267  f06c		       69 00		      adc	#0
    268  f06e		       85 b2		      sta	EnemyDataHi
    269  f070		       a5 a2		      lda	LevelConnSpare
    270  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    271  f073		       18		      clc
    272  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    273  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    274  f078		       85 b1		      sta	EnemyDataLo
    275  f07a		       a5 b2		      lda	EnemyDataHi
    276  f07c		       69 00		      adc	#0
    277  f07e		       85 b2		      sta	EnemyDataHi
    278  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    279  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    280  f084
    281  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    282  f084		       85 b5		      sta	BombPacked
    283  f086		       85 f7		      sta	BombTimer
    284  f088		       85 f1		      sta	BombSnd
    285  f08a		       85 19		      sta	AUDV0
    286  f08c
    287  f08c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    288  f08c
    289  f08c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    290  f08c		       a5 c1		      lda	EnemyRamD
    291  f08e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    292  f090		       85 c1		      sta	EnemyRamD
    293  f092		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    294  f094		       85 c2		      sta	EnemyRamP
    295  f096		       a5 b1		      lda	EnemyDataLo
    296  f098		       85 e5		      sta	FetchPtr
    297  f09a		       a5 b2		      lda	EnemyDataHi
    298  f09c		       85 e6		      sta	FetchPtr+1
    299  f09e		       a2 00		      ldx	#0
    300  f0a0				   EBLER_Loop
    301  f0a0		       e4 b3		      cpx	EnemyCount
    302  f0a2		       b0 39		      bcs	EBLER_Done
    303  f0a4		       bc 01 f3 	      ldy	EnemyOffTable,X	; Y = X*3 record offset
    304  f0a7		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (b3-0) | dir (b7: 1 = left)
    305  f0a9		       85 88		      sta	Temp	; Temp = raw record byte (free: EnterRoom)
    306  f0ab		       c8		      iny		; +1 = x
    307  f0ac		       b1 e5		      lda	(FetchPtr),Y
