    669  f313		       a5 8a		      lda	DropTarget
    670  f315		       f0 36		      beq	.TEArm
    671  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    672  f319		       d0 2d		      bne	.TEIdle
    673  f31b		       a9 04		      lda	#4
    674  f31d		       85 ad		      sta	TickCounter
    675  f31f		       c6 f2		      dec	TallyTicks
    676  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    677  f323		       a5 f2		      lda	TallyTicks
    678  f325		       29 03		      and	#3
    679  f327		       d0 15		      bne	.TEOne	; tick only
    680  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    681  f32b		       85 f1		      sta	BombSnd
    682  f32d		       a9 04		      lda	#4
    683  f32f		       85 15		      sta	AUDC0	; square
    684  f331		       a9 18		      lda	#24
    685  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    686  f335		       a9 08		      lda	#8
    687  f337		       85 19		      sta	AUDV0
    688  f339		       a9 03		      lda	#3	; tick + coin
    689  f33b		       4c f8 fb 	      jmp	ReturnPad
    690  f33e				   .TEOne
    691  f33e		       a9 01		      lda	#1	; tick only
    692  f340		       4c f8 fb 	      jmp	ReturnPad
    693  f343				   .TEFinal
    694  f343		       a9 07		      lda	#7	; tick + coin + done
    695  f345		       4c f8 fb 	      jmp	ReturnPad
    696  f348				   .TEIdle
    697  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    698  f34a		       4c f8 fb 	      jmp	ReturnPad
    699  f34d				   .TEArm
