    152  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    153  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    154  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    155  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    156  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    157  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    158  f008							; = Origin Reverse.
    159  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    160  f010				   EnterRoomB2
    161  f010		       85 98		      sta	RoomNo
    162  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    163  f013		       a5 9f		      lda	LevelPFDataLo
    164  f015		       85 e5		      sta	FetchPtr
    165  f017		       a5 a0		      lda	LevelPFDataHi
    166  f019		       85 e6		      sta	FetchPtr+1
    167  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b5-0 | band b6 | b7 extras
    168  f01d		       85 88		      sta	Temp
    169  f01f		       29 3f		      and	#$3F	; shape index (C2 2026-10-20)
    170  f021		       0a		      asl		; *2: LEVEL_ShapeTable is a word table
    171  f022		       aa		      tax
