    993  f472		       18		      clc
    994  f473		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    995  f475							; calibrated SetObjectXPos arg (S6b: arg A
    996  f475							; draws clocks [A-7, A]; right_col c occupies
    997  f475							; [80+8c, 87+8c]). PHMOverlay recomputes this
