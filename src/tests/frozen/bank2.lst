    976  f44e		       4c 53 f4 	      jmp	.M1got
    977  f451				   .M1zero
    978  f451		       a9 00		      lda	#0
    979  f453				   .M1got
    980  f453		       85 8e		      sta	CollisionEndX
    981  f455		       a5 ba		      lda	EnemyDeadMask
    982  f457		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    983  f459		       f0 04		      beq	.M1stage
    984  f45b		       a9 00		      lda	#0
    985  f45d		       85 8e		      sta	CollisionEndX
    986  f45f				   .M1stage
    987  f45f							; --- BallX staging: Temp ($88) ---
    988  f45f							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    989  f45f							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    990  f45f							; GONE (user 2026-10-12: door must look like the plain async strip;
    991  f45f							; only the key/bomb semantics differ). One write per VBL is the
    992  f45f							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    993  f45f		       a9 35		      lda	#$35
