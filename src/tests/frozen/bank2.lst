    528  f35a
    529  f35a							; ==============================================================================
    530  f35a							; Title music player (2026-10-16; merged title screen 2026-10-19). Ticked once
    531  f35a							; per title frame from TitleTailAudio via CallPad_MusicTick (bank0<->bank1
    532  f35a							; @ $FC61). Plays the original theme "Hollow Earth".
    533  f35a							; Packed one byte per step (2026-10-20, was 102 B of (duration,note) pairs):
    534  f35a							;   byte = note_code*4 + duration_code
    535  f35a							;   note_code = AUDF, $3E = rest, $3F = loop; duration_code indexes MelDur.
    536  f35a							; Data is GENERATED by tools/gen_intro_theme.py from the readable pairs.
    537  f35a							; AUD0 = Lead ($0C), volume 7, single voice.
    538  f35a							; ==============================================================================
    539  f35a							; --- Melody state: BombX/BombTimer ($F6/$F7) ------------------------------
    540  f35a							; The theme plays ONLY on title frames, and on those frames the bomb block
    541  f35a							; never runs (DropTarget != 0 -> DropStep skips it), so the bomb's two bytes are
    542  f35a							; dead for exactly as long as the music is alive. Sharing them here frees
    543  f35a							; $9D/$9E, which the CAVE kernel needs on BOTH kinds of frame (the title
    544  f35a							; previews the stage with real room objects) — that is where the per-type
    545  f35a							; object height will live. Restart on return: the title-entry path zeroes both.
    546  f35a							; Contract: nothing may read BombX/BombTimer while a title frame is running.
    547  f35a		       00 f6	   MelPtr     =	$F6	; = kernel BombX   (dead on the title)
    548  f35a		       00 f7	   MelTimer   =	$F7	; = kernel BombTimer (dead on the title)
    549  f35a
    550  f35a				   MusicTick
    551  f35a		       a9 00		      lda	#0
    552  f35c		       85 1a		      sta	AUDV1	; bass voice off (melody only)
    553  f35e		       a6 f6		      ldx	MelPtr
    554  f360		       a5 f7		      lda	MelTimer
    555  f362		       f0 0d		      beq	.MelLoad
    556  f364		       c6 f7		      dec	MelTimer
    557  f366		       bd b0 f3 	      lda	MusicMel,X	; re-assert the current note (survives SFX);
    558  f369							;   MelPtr already points at the NEXT step, so
    559  f369							;   this mirrors the pre-pack (duration,note)
    560  f369							;   player's MusicMel+1,X read, keeps the same
    561  f369							;   audible melody
    562  f369		       4a		      lsr
    563  f36a		       4a		      lsr		; note code = AUDF / $3E rest / $3F loop
    564  f36b		       20 98 f3 	      jsr	MelApply
    565  f36e		       4c f8 fb 	      jmp	ReturnPad
    566  f371				   .MelLoad
    567  f371		       bd b0 f3 	      lda	MusicMel,X
    568  f374		       29 03		      and	#3
    569  f376		       a8		      tay
    570  f377		       b9 e3 f3 	      lda	MelDur,Y	; duration code -> frames
    571  f37a		       85 f7		      sta	MelTimer
    572  f37c		       bd b0 f3 	      lda	MusicMel,X
    573  f37f		       4a		      lsr
    574  f380		       4a		      lsr
    575  f381		       c9 3f		      cmp	#$3F	; loop step (duration 0, so never re-asserted)
    576  f383		       f0 0c		      beq	.MelLoop
    577  f385		       20 98 f3 	      jsr	MelApply
    578  f388		       8a		      txa
    579  f389		       18		      clc
    580  f38a		       69 01		      adc	#1
    581  f38c		       85 f6		      sta	MelPtr
    582  f38e		       4c f8 fb 	      jmp	ReturnPad
    583  f391				   .MelLoop
    584  f391		       a9 00		      lda	#0
    585  f393		       85 f6		      sta	MelPtr
    586  f395		       4c f8 fb 	      jmp	ReturnPad
    587  f398
    588  f398							; MelApply: A = note code. Starts the Lead at that pitch, or silences AUD0 on
    589  f398							; a rest ($3E). $3F (loop) HOLDS the tone the load frame started - the old
    590  f398							; paired player's `cmp #$FF / beq .MelDone` arm, kept for an identical melody.
    591  f398				   MelApply
    592  f398		       c9 3f		      cmp	#$3F
    593  f39a		       f0 13		      beq	.MAHold
    594  f39c		       c9 3e		      cmp	#$3E
    595  f39e		       f0 0b		      beq	.MAOff
    596  f3a0		       85 17		      sta	AUDF0
    597  f3a2		       a9 0c		      lda	#$0C	; Lead
    598  f3a4		       85 15		      sta	AUDC0
    599  f3a6		       a9 07		      lda	#7
    600  f3a8		       85 19		      sta	AUDV0
    601  f3aa		       60		      rts
    602  f3ab				   .MAOff
    603  f3ab		       a9 00		      lda	#0
    604  f3ad		       85 19		      sta	AUDV0
    605  f3af				   .MAHold
    606  f3af		       60		      rts
    607  f3b0
------- FILE art/intro_theme.asm LEVEL 2 PASS 3
      0  f3b0					      include	"art/intro_theme.asm"
      1  f3b0							; Intro theme: 'hollow earth' - adventurous, with dread (original, 2026-10-16).
      2  f3b0							; GENERATED by tools/gen_intro_theme.py - edit the pairs there, not here.
      3  f3b0							; E minor; every AUDF is in tune on the TIA Lead ($0C). Single voice.
      4  f3b0							; One byte per step: note code * 4 + duration code.
      5  f3b0							;   note code = AUDF ($3E = rest, $3F = loop); duration code -> MelDur.
      6  f3b0				   MusicMel
      7  f3b0		       7c 6c 68 5c*	      .byte.b	$7C,$6C,$68,$5C,$51,$4C,$50,$5C,$68,$6C,$7C,$7D,$F9,$7C,$68,$7C
      8  f3c0		       f8 3e 3c 34*	      .byte.b	$F8,$3E,$3C,$34,$2C,$24,$21,$24,$20,$1D,$24,$20,$1E,$7C,$7C,$68
      9  f3d0		       68 5c 5c 51*	      .byte.b	$68,$5C,$5C,$51,$4D,$49,$4D,$51,$7E,$3C,$40,$3C,$34,$2D,$25,$21
     10  f3e0		       1d 7e ff 	      .byte.b	$1D,$7E,$FF
     11  f3e3				   MelDur		; duration code -> frames
     12  f3e3		       1e 3c 78 00	      .byte.b	$1E,$3C,$78,$00
------- FILE bank2.asm
    609  f3e7
    610  f3e7							; $F3E3-$F41E is free (the packed theme reclaimed 2026-10-20). M1StripBlast
    611  f3e7							; stays pinned at $F41F because bank1's TallyEntry address is hand-copied into
    612  f3e7							; kernel.asm's TallyTramp EQU and tools/test_bomb_strip.py pins this label;
    613  f3e7							; new bank1 leaves can go in this hole.
    614  f3e7		       00 00 00 00*	      .ds	$F41F - *, 0
    615  f41f
    616  f41f							; M1StripBlast moved to the gameplay bank (bank 3).
    617  f41f		       00 00 00 00*	      .ds	$F44F - *, 0	; TallyEntry stays pinned at $F44F (bank0 TallyTramp operand)
    618  f44f
    619  f44f							; ------------------------------------------------------------------------------
    620  f44f							; TallyEntry — level-bonus tally body (moved from bank2 2026-10-20, repack
    621  f44f							; chunk 3: it touches ZP/TIA only, and the tally frame runs the bank1 HUD
    622  f44f							; anyway). Entered from bank0's TallyTramp ($FFE6) via jsr; tail-jmps
    623  f44f							; ReturnPad ($FBF8, bank1 copy) so A (and Z) survive back to the bank0 caller.
    624  f44f							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    625  f44f							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    626  f44f							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    627  f44f							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    628  f44f							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    629  f44f							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    630  f44f							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    631  f44f							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    632  f44f							; The old hard `org $F313` pin and bank2's `org $F880` TallySum slot are gone
    633  f44f							; with the move; both bodies now flow in bank1's $F41F-$F53F fill.
    634  f44f							; ------------------------------------------------------------------------------
    635  f44f				   TallyEntry
    636  f44f		       a5 8a		      lda	DropTarget
    637  f451		       f0 36		      beq	.TEArm
    638  f453		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    639  f455		       d0 2d		      bne	.TEIdle
    640  f457		       a9 04		      lda	#4
    641  f459		       85 ad		      sta	TickCounter
    642  f45b		       c6 f2		      dec	TallyTicks
    643  f45d		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    644  f45f		       a5 f2		      lda	TallyTicks
    645  f461		       29 03		      and	#3
    646  f463		       d0 15		      bne	.TEOne	; tick only
    647  f465		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    648  f467		       85 f1		      sta	BombSnd
    649  f469		       a9 04		      lda	#4
    650  f46b		       85 15		      sta	AUDC0	; square
    651  f46d		       a9 18		      lda	#24
    652  f46f		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    653  f471		       a9 08		      lda	#8
    654  f473		       85 19		      sta	AUDV0
    655  f475		       a9 03		      lda	#3	; tick + coin
    656  f477		       4c f8 fb 	      jmp	ReturnPad
    657  f47a				   .TEOne
    658  f47a		       a9 01		      lda	#1	; tick only
    659  f47c		       4c f8 fb 	      jmp	ReturnPad
    660  f47f				   .TEFinal
    661  f47f		       a9 07		      lda	#7	; tick + coin + done
    662  f481		       4c f8 fb 	      jmp	ReturnPad
    663  f484				   .TEIdle
    664  f484		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    665  f486		       4c f8 fb 	      jmp	ReturnPad
    666  f489				   .TEArm
    667  f489		       a5 ae		      lda	BarLevel
    668  f48b		       18		      clc
    669  f48c		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    670  f48e		       a2 00		      ldx	#0
    671  f490				   .TEDiv
    672  f490		       c9 06		      cmp	#6
    673  f492		       90 06		      bcc	.TEDivSum
    674  f494		       38		      sec
    675  f495		       e9 06		      sbc	#6
    676  f497		       e8		      inx		; X = time ticks (0..20; BarLevel <= 120)
    677  f498		       d0 f6		      bne	.TEDiv
    678  f49a				   .TEDivSum
    679  f49a		       20 b0 f4 	      jsr	TallySum	; TallyTicks = ticks + 20 + bombs + 2*lives
    680  f49d							; (masking the raft's ramp bits out of
    681  f49d							; PlayerBombs needs the split helper below)
    682  f49d		       a9 04		      lda	#4
    683  f49f		       85 ad		      sta	TickCounter	; fresh pace divider
    684  f4a1		       a9 00		      lda	#0
    685  f4a3		       85 96		      sta	JetPower	; frozen frame: no thrust flutter
    686  f4a5		       85 83		      sta	LaserX	; drop any live beam (travel restarts on press)
    687  f4a7		       a9 fe		      lda	#$FE
    688  f4a9		       85 8a		      sta	DropTarget
    689  f4ab		       a9 00		      lda	#0
    690  f4ad		       4c f8 fb 	      jmp	ReturnPad
    691  f4b0
    692  f4b0							; TallySum — the level-bonus total for TallyEntry (frozen-scene frame).
    693  f4b0							; Split out of the inline region in bank2 (which ended at a hard org); now a
    694  f4b0							; same-bank jsr in the same fill.
    695  f4b0				   TallySum
    696  f4b0		       a5 f0		      lda	PlayerBombs
    697  f4b2		       29 07		      and	#%00000111	; bombs only, never the raft ramp bits
    698  f4b4		       85 88		      sta	BMWScratch	; $88 = kernel Temp — NOT bank1's Temp ($AD =
    699  f4b6							; TickCounter: writing it stalls the game timer)
    700  f4b6		       8a		      txa
    701  f4b7		       18		      clc
    702  f4b8		       69 14		      adc	#20	; miner reach = 1000 pts
    703  f4ba		       65 88		      adc	BMWScratch	; + 50 per unspent bomb (chain carry ok)
    704  f4bc		       85 f2		      sta	TallyTicks
    705  f4be		       a5 ac		      lda	PlayerLives
    706  f4c0		       0a		      asl		; + 100 per life = 2 ticks
    707  f4c1		       18		      clc
    708  f4c2		       65 f2		      adc	TallyTicks
    709  f4c4		       85 f2		      sta	TallyTicks
    710  f4c6		       60		      rts
