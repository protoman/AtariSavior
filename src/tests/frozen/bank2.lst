   2131  fd4b		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
   2132  fd4c		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
   2133  fd4d		       4a		      lsr
   2134  fd4e		       0a		      asl
   2135  fd4f		       0a		      asl
   2136  fd50		       0a		      asl
   2137  fd51		       0a		      asl
