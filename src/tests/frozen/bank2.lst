    161  f000
    162  f000							; --- 5-byte stub ---
    163  f000		       a9 00		      lda	#0
    164  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    165  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    166  f008
    167  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    168  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    169  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    170  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    171  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    172  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    173  f008							; = Origin Reverse.
    174  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    175  f010				   EnterRoomB2
    176  f010		       85 98		      sta	RoomNo
    177  f012		       0a		      asl
    178  f013		       a8		      tay		; Y = room * 2 (C3: ONE word per room)
    179  f014		       a5 9f		      lda	LevelPFDataLo
    180  f016		       85 e5		      sta	FetchPtr
    181  f018		       a5 a0		      lda	LevelPFDataHi
    182  f01a		       85 e6		      sta	FetchPtr+1
    183  f01c		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: rects ptr lo
    184  f01e		       85 90		      sta	RoomRectsLo
    185  f020		       c8		      iny
    186  f021		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    187  f023		       85 91		      sta	RoomRectsHi
    188  f025							; TilePF0 is no longer stored per room: bank3's block reader derives it
    189  f025							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    190  f025
    191  f025							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    192  f025							;     live in BANK3 (the level-data bank). One tail-jump into the block
    193  f025							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    194  f025							;     0 pushes (the room-load chain sits at the measured SP floor).
    195  f025		       4c 50 f4 	      jmp	ERBlocksPad
    196  f028				   ERBlocksDone
    197  f028
    198  f028							; --- enemy record for this room (C2 2026-10-20, packed 1 B 2026-10-20) ---
    199  f028							; byte = count<<6 | first record index<<1 | bottom-band flag.
    200  f028							; RoomEnemies = level base + 4n, enemy records = level base + 5n
    201  f028							; (2026-10-20: the enemy record is ONE byte/room now)
    202  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    203  f028							; The band COLOR is the global BAND_COLOR (one water color per game).
    204  f028		       a5 98		      lda	RoomNo
    205  f02a		       a8		      tay		; Y = room (one byte per record)
    206  f02b		       a5 9f		      lda	LevelPFDataLo
    207  f02d		       18		      clc
    208  f02e		       65 a1		      adc	LevelRoomN
    209  f030		       65 a1		      adc	LevelRoomN
    210  f032		       65 a1		      adc	LevelRoomN
    211  f034		       65 a1		      adc	LevelRoomN	; base + 4n = RoomEnemies
    212  f036		       85 e5		      sta	FetchPtr
    213  f038		       a5 a0		      lda	LevelPFDataHi
    214  f03a		       69 00		      adc	#0
    215  f03c		       85 e6		      sta	FetchPtr+1
    216  f03e		       b1 e5		      lda	(FetchPtr),Y
    217  f040		       4a		      lsr
    218  f041		       4a		      lsr
    219  f042		       4a		      lsr
    220  f043		       4a		      lsr
    221  f044		       4a		      lsr
    222  f045		       4a		      lsr		; count = b7-6
    223  f046		       85 b3		      sta	EnemyCount
    224  f048		       a5 e5		      lda	FetchPtr
    225  f04a		       18		      clc
    226  f04b		       65 a1		      adc	LevelRoomN	; base + 5n = enemy records (1 B/room)
    227  f04d		       85 b1		      sta	EnemyDataLo
