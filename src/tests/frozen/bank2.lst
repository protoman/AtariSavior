    182  f028							; --- enemy record for this room (C2 2026-10-20, packed 1 B 2026-10-20) ---
    183  f028							; byte = count<<6 | first record index<<1 | bottom-band flag.
    184  f028							; RoomEnemies = level base + 3n, enemy records = level base + 4n
    185  f028							; (C1 2026-10-20: RoomPositions took over the old +2n..+3n slot at
    186  f028							; 1 B/room, so the enemy tables moved down one block-n).
    187  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    188  f028							; The band COLOR is the global BAND_COLOR (one water color per game).
