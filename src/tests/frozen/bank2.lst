   1014  fe9c							; kernel's `sta $1FF8 / jmp $F110` — operand drift fails the guard.
   1015  fe9c							; ------------------------------------------------------------------------------
   1016  fe9c		       00 00 00 00*	      .ds	$FEF0 - *, 0
   1017  fef0				   UE_MothTramp
   1018  fef0		       8d f8 1f 	      sta	$1FF8
   1019  fef3		       4c 10 f1 	      jmp	MothRoutine
   1020  fef6					      .ds	$FEF6 - *, 0
   1021  fef6				   FoldIndirect
   1022  fef6		       8d f8 1f 	      sta	$1FF8
   1023  fef9		       b1 e5		      lda	(FetchPtr),Y
   1024  fefb		       8d f6 1f 	      sta	$1FF6
   1025  fefe		       60		      rts
   1026  feff
   1027  feff							; ------------------------------------------------------------------------------
   1028  feff							; LaserHitTestBody — MOVED from bank0 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   1029  feff							; Contact-missile kill (redesign 2026-10-08): CollisionX = LaserX (cur M0
   1030  feff							; arg, stored by LaserInput .LaserGo), drawn M0 = [A-7, A]. The body tests
   1031  feff							; ONE tip cell for wall first, then the missile's OWN body box against each
   1032  feff							; live enemy — no piercing: first contact wins and the caller resets the
   1033  feff							; beam to the eye. Vertical: beam rows [RoomY+2, RoomY+3] vs enemy [Y,+7] ->
   1034  feff							; (RoomY-Y)+3 in [0..8]. Horizontal (same convention as CheckEnemyHit):
   1035  feff							; |eLo-lo| <= 7 via (d+7) in [0..14]; caller keeps arg in [0,159].
   1036  feff							; Fold-free: enemy records are level data in THIS bank — stage once, direct
   1037  feff							; `lda (FetchPtr),Y` for the type (was `jsr FoldIndirect`).
   1038  feff							; RESULT PROTOCOL (pads cannot nest from a pad body — the kill/lamp/wall
   1039  feff							; ACTIONS stay in bank0's LaserInput): every exit returns A + Z through
   1040  feff							; ReturnPad (sta/rts preserve both): A=0 no contact (keep travelling) /
   1041  feff							; #$50 kill (dead bit set here, caller scores + resets) / A=1 lamp (caller
   1042  feff							; does CallPad_SetRoomDark + resets) / A=2 wall tip (caller resets, no
   1043  feff							; score). First live enemy in span only (dead mask skips it next frame —
   1044  feff							; no resurrection, no double score).
   1045  feff							; Does NOT touch Temp (joystick still live at the call site).
   1046  feff							; Wall first: the body tail-jmps to LaserWallClamp ($F25A) — tip cell
   1047  feff							; (patch-strip + mirrored PF rows) — solid returns A=2 straight through
   1048  feff							; ReturnPad (enemies behind the wall survive); clear ends
   1049  feff							; `jmp LaserClampDone` (back here = enemy loop): stack depth unchanged.
   1050  feff							; Clobbers A/X/Y/FetchPtr + CollisionCellY/CollisionEndY, RectCount,
   1051  feff							; CollisionEndX (strip marker); MODIFIES NOTHING else (no clamp any more).
   1052  feff							; ------------------------------------------------------------------------------
   1053  feff		       00		      .ds	$FF00 - *, 0	; pinned: bank0 tramp operand is literal $FF00
   1054  ff00				   LaserHitTestBody
   1055  ff00		       4c 5a f2 	      jmp	LaserWallClamp	; contact: tip-cell wall test FIRST (A=2 or
   1056  ff03							; fall into the enemy loop via LaserClampDone)
   1057  ff03				   LaserClampDone
   1058  ff03							; --- Stage (P3.1): enemy record pointer — loop writes no FetchPtr ---
   1059  ff03		       a5 b1		      lda	EnemyDataLo
   1060  ff05		       85 e5		      sta	FetchPtr
   1061  ff07		       a5 b2		      lda	EnemyDataHi
   1062  ff09		       85 e6		      sta	FetchPtr+1
   1063  ff0b		       a2 00		      ldx	#0
   1064  ff0d				   .LHLoop
   1065  ff0d		       e4 b3		      cpx	EnemyCount
   1066  ff0f		       b0 3c		      bcs	.LHTOut
   1067  ff11		       a5 ba		      lda	EnemyDeadMask
   1068  ff13		       3d 55 ff 	      and	EnemyBitTable,X
   1069  ff16		       d0 32		      bne	.LHNext
   1070  ff18		       a5 81		      lda	RoomY
   1071  ff1a		       38		      sec
   1072  ff1b		       f5 e2		      sbc	EnemyRamY,X
   1073  ff1d		       18		      clc
   1074  ff1e		       69 03		      adc	#3	; (RoomY-eY)+3 in [0..8] = eY in [RoomY-5, RoomY+3]
   1075  ff20		       c9 09		      cmp	#9	; out of beam rows RoomY+2..3
   1076  ff22		       b0 26		      bcs	.LHNext
   1077  ff24		       b5 bd		      lda	EnemyRamX,X
   1078  ff26		       38		      sec
   1079  ff27		       e5 8b		      sbc	CollisionX
   1080  ff29		       18		      clc
   1081  ff2a		       69 07		      adc	#7	; kill == drawn overlap: beam [A-7,A] x
   1082  ff2c							; enemy [eX-7,eX] (SAME arg-box convention
   1083  ff2c							; CheckEnemyHit uses for RoomX vs eX) ->
   1084  ff2c							; eX in [A-7, A+7] <=> (eX-A)+7 in [0..14].
   1085  ff2c							; S6b's adc #14 was a 7px-LEFT shift: it
   1086  ff2c							; killed empty space left of the beam and
   1087  ff2c							; missed every enemy overlapping the tip
   1088  ff2c							; from the right (laser_collision_tip_bug).
   1089  ff2c		       c9 0f		      cmp	#15	; bcs -> miss
   1090  ff2e		       b0 1a		      bcs	.LHNext
   1091  ff30				   .LHHit
   1092  ff30		       bc 52 ff 	      ldy	EnemyOffTable,X	; type offset into staged record
   1093  ff33		       b1 e5		      lda	(FetchPtr),Y	; direct — level data in this bank (was fold)
   1094  ff35		       c9 05		      cmp	#LAMP
   1095  ff37		       f0 0c		      beq	.LHLamp
   1096  ff39		       a5 ba		      lda	EnemyDeadMask
   1097  ff3b		       1d 55 ff 	      ora	EnemyBitTable,X
   1098  ff3e		       85 ba		      sta	EnemyDeadMask
   1099  ff40		       a9 50		      lda	#$50	; result: kill — caller adds #$50 score
   1100  ff42		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (A/Z/C preserved)
   1101  ff45				   .LHLamp
   1102  ff45		       a9 01		      lda	#1	; result: lamp — caller crashes the lamp
   1103  ff47		       4c f8 fb 	      jmp	ReturnPad
   1104  ff4a				   .LHNext
   1105  ff4a		       e8		      inx
   1106  ff4b		       d0 c0		      bne	.LHLoop
   1107  ff4d				   .LHTOut
   1108  ff4d		       a9 00		      lda	#0	; result: miss (Z set for caller's beq)
   1109  ff4f		       4c f8 fb 	      jmp	ReturnPad
   1110  ff52
