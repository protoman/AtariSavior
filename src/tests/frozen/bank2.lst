    721  f313				   TallyEntry
    722  f313		       a5 8a		      lda	DropTarget
    723  f315		       f0 36		      beq	.TEArm
    724  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    725  f319		       d0 2d		      bne	.TEIdle
    726  f31b		       a9 04		      lda	#4
    727  f31d		       85 ad		      sta	TickCounter
    728  f31f		       c6 f2		      dec	TallyTicks
    729  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    730  f323		       a5 f2		      lda	TallyTicks
    731  f325		       29 03		      and	#3
    732  f327		       d0 15		      bne	.TEOne	; tick only
    733  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    734  f32b		       85 f1		      sta	BombSnd
    735  f32d		       a9 04		      lda	#4
    736  f32f		       85 15		      sta	AUDC0	; square
    737  f331		       a9 18		      lda	#24
    738  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    739  f335		       a9 08		      lda	#8
    740  f337		       85 19		      sta	AUDV0
    741  f339		       a9 03		      lda	#3	; tick + coin
    742  f33b		       4c f8 fb 	      jmp	ReturnPad
    743  f33e				   .TEOne
    744  f33e		       a9 01		      lda	#1	; tick only
    745  f340		       4c f8 fb 	      jmp	ReturnPad
    746  f343				   .TEFinal
    747  f343		       a9 07		      lda	#7	; tick + coin + done
    748  f345		       4c f8 fb 	      jmp	ReturnPad
    749  f348				   .TEIdle
    750  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    751  f34a		       4c f8 fb 	      jmp	ReturnPad
    752  f34d				   .TEArm
    753  f34d		       a5 ae		      lda	BarLevel
    754  f34f		       18		      clc
    755  f350		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    756  f352		       a2 00		      ldx	#0
    757  f354				   .TEDiv
    758  f354		       c9 06		      cmp	#6
    759  f356		       90 06		      bcc	.TEDivSum
    760  f358		       38		      sec
    761  f359		       e9 06		      sbc	#6
