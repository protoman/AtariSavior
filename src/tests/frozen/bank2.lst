    851  f401							; ------------------------------------------------------------------------------
    852  f401							; StageBandTab — asym meta: decode packed model meta into bank0 ZP for the cave.
    853  f401							; Reached from BuildColupF's tail (BCFDarkRun jmp here); ends at ReturnPad so
    854  f401							; the VBL jsr returns to bank0 (pads must not nest — no rts here).
    855  f401							; WHY here: models_data lives in THIS bank — a bank0 (RoomPF0Lo),Y read
    856  f401							; fetches bank0's $F9xx zero pad (the Phase 2 ball block silently read zeros).
    857  f401							; Packed meta (bugs.md 28 point 1): TilePF0+9 = MetaA = (m1_col+1)<<4 |
    858  f401							; band_mask (b0-2 = band0/1/2 gates); TilePF0+10 = MetaB = ball_col+1
    859  f401							; (0 = feature absent). Expanded to the old RAM shapes:
    860  f401							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates (.Row ENABL reads
    861  f401							;			  bit0; the pack's `bit`/`bpl` reads bit7)
    862  f401							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 ⇔ symmetric → skip;
    863  f401							;			  verify_build enforces)
    864  f401							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    865  f401							; Window: staged every VBL → read by cave → bank1 HUD stomps $ED-$EF after
    866  f401							; the cave read → overscan rewrites $88 (joystick) after the ball read.
    867  f401							; ------------------------------------------------------------------------------
    868  f401				   StageBandTab
    869  f401							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    870  f401		       a0 09		      ldy	#9
    871  f403							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    872  f403							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    873  f403							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    874  f403							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    875  f403							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    876  f403							; no-ball path below blanks BandTab so it never enables the ball.
    877  f403							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    878  f403							; the pack uses $8F).
    879  f403		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
    880  f405		       29 01		      and	#$01
    881  f407		       aa		      tax
    882  f408		       bd c0 f4 	      lda	M1OffTab,X
    883  f40b		       85 92		      sta	RectCount
    884  f40d		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
    885  f40f		       4a		      lsr		; band0 bit -> carry
    886  f410		       a9 00		      lda	#0
    887  f412		       2a		      rol
    888  f413		       f0 02		      beq	.SBTb0z
    889  f415		       a9 ff		      lda	#$ff
    890  f417				   .SBTb0z
    891  f417		       85 ed		      sta	BandTab
    892  f419		       b1 99		      lda	(RoomPF0Lo),Y
    893  f41b		       4a		      lsr
    894  f41c		       4a		      lsr		; band1 bit -> carry
    895  f41d		       a9 00		      lda	#0
    896  f41f		       2a		      rol
    897  f420		       f0 02		      beq	.SBTb1z
    898  f422		       a9 ff		      lda	#$ff
    899  f424				   .SBTb1z
    900  f424		       85 ee		      sta	BandTab+1
    901  f426		       b1 99		      lda	(RoomPF0Lo),Y
    902  f428		       4a		      lsr
    903  f429		       4a		      lsr
    904  f42a		       4a		      lsr		; band2 bit -> carry
    905  f42b		       a9 00		      lda	#0
    906  f42d		       2a		      rol
    907  f42e		       f0 02		      beq	.SBTb2z
    908  f430		       a9 ff		      lda	#$ff
