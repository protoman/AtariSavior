   1057  ff20		       c9 09		      cmp	#9	; out of beam rows RoomY+2..3
   1058  ff22		       b0 26		      bcs	.LHNext
   1059  ff24		       b5 bd		      lda	EnemyRamX,X
   1060  ff26		       38		      sec
