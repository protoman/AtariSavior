   1607  fedb							; $FEF3 runs after bank0's switch. Assembles to the same 6 bytes as
   1608  fedb							; kernel's `sta $1FF8 / jmp $F110` — operand drift fails the guard.
   1609  fedb							; ------------------------------------------------------------------------------
   1610  fedb		       00 00 00 00*	      .ds	$FEF0 - *, 0
   1611  fef0				   UE_MothTramp
   1612  fef0		       8d f8 1f 	      sta	$1FF8
   1613  fef3		       4c 10 f1 	      jmp	MothRoutine
   1614  fef6					      .ds	$FEF6 - *, 0
   1615  fef6				   FoldIndirect
   1616  fef6		       8d f8 1f 	      sta	$1FF8
   1617  fef9		       b1 e5		      lda	(FetchPtr),Y
   1618  fefb		       8d f6 1f 	      sta	$1FF6
   1619  fefe		       60		      rts
   1620  feff
   1621  feff							; ------------------------------------------------------------------------------
   1622  feff							; LaserHitTestBody — MOVED from bank0 (S5.4, entry tramp $FE86 -> `jmp $FF00`).
   1623  feff							; Contact-missile kill (redesign 2026-10-08): CollisionX = LaserX (cur M0
   1624  feff							; arg, stored by LaserInput .LaserGo), drawn M0 = [A-7, A]. The body tests
   1625  feff							; ONE tip cell for wall first, then the missile's OWN body box against each
   1626  feff							; live enemy — no piercing: first contact wins and the caller resets the
   1627  feff							; beam to the eye. Vertical: beam rows [RoomY+2, RoomY+3] vs enemy [Y,+7] ->
   1628  feff							; (RoomY-Y)+3 in [0..8]. Horizontal (same convention as CheckEnemyHit):
   1629  feff							; |eLo-lo| <= 7 via (d+7) in [0..14]; caller keeps arg in [0,159].
   1630  feff							; Fold-free: enemy records are level data in THIS bank — stage once, direct
   1631  feff							; `lda (FetchPtr),Y` for the type (was `jsr FoldIndirect`).
   1632  feff							; RESULT PROTOCOL (pads cannot nest from a pad body — the kill/lamp/wall
   1633  feff							; ACTIONS stay in bank0's LaserInput): every exit returns A + Z through
   1634  feff							; ReturnPad (sta/rts preserve both): A=0 no contact (keep travelling) /
   1635  feff							; #$50 kill (dead bit set here, caller scores + resets) / A=1 lamp (caller
   1636  feff							; does CallPad_SetRoomDark + resets) / A=2 wall tip (caller resets, no
   1637  feff							; score). First live enemy in span only (dead mask skips it next frame —
   1638  feff							; no resurrection, no double score).
   1639  feff							; Does NOT touch Temp (joystick still live at the call site).
   1640  feff							; Wall first: the body tail-jmps to LaserWallClamp ($F25A) — tip cell
   1641  feff							; (patch-strip + mirrored PF rows) — solid returns A=2 straight through
   1642  feff							; ReturnPad (enemies behind the wall survive); clear ends
   1643  feff							; `jmp LaserClampDone` (back here = enemy loop): stack depth unchanged.
   1644  feff							; Clobbers A/X/Y/FetchPtr + CollisionCellY/CollisionEndY, RectCount,
   1645  feff							; CollisionEndX (strip marker); MODIFIES NOTHING else (no clamp any more).
   1646  feff							; ------------------------------------------------------------------------------
   1647  feff		       00		      .ds	$FF00 - *, 0	; pinned: bank0 tramp operand is literal $FF00
   1648  ff00				   LaserHitTestBody
   1649  ff00		       4c 5a f2 	      jmp	LaserWallClamp	; contact: tip-cell wall test FIRST (A=2 or
   1650  ff03							; fall into the enemy loop via LaserClampDone)
   1651  ff03				   LaserClampDone
   1652  ff03							; --- Stage (P3.1): enemy record pointer — loop writes no FetchPtr ---
   1653  ff03		       a5 b1		      lda	EnemyDataLo
   1654  ff05		       85 e5		      sta	FetchPtr
   1655  ff07		       a5 b2		      lda	EnemyDataHi
   1656  ff09		       85 e6		      sta	FetchPtr+1
   1657  ff0b		       a2 00		      ldx	#0
   1658  ff0d				   .LHLoop
   1659  ff0d		       e4 b3		      cpx	EnemyCount
   1660  ff0f		       b0 3c		      bcs	.LHTOut
   1661  ff11		       a5 ba		      lda	EnemyDeadMask
   1662  ff13		       3d 55 ff 	      and	EnemyBitTable,X
   1663  ff16		       d0 32		      bne	.LHNext
   1664  ff18		       a5 81		      lda	RoomY
   1665  ff1a		       38		      sec
   1666  ff1b		       f5 e2		      sbc	EnemyRamY,X
   1667  ff1d		       18		      clc
   1668  ff1e		       69 03		      adc	#3	; (RoomY-eY)+3 in [0..8] = eY in [RoomY-5, RoomY+3]
   1669  ff20		       c9 09		      cmp	#9	; out of beam rows RoomY+2..3
   1670  ff22		       b0 26		      bcs	.LHNext
   1671  ff24		       b5 bd		      lda	EnemyRamX,X
   1672  ff26		       38		      sec
   1673  ff27		       e5 8b		      sbc	CollisionX
   1674  ff29		       18		      clc
   1675  ff2a		       69 07		      adc	#7	; kill == drawn overlap: beam [A-7,A] x
   1676  ff2c							; enemy [eX-7,eX] (SAME arg-box convention
   1677  ff2c							; CheckEnemyHit uses for RoomX vs eX) ->
   1678  ff2c							; eX in [A-7, A+7] <=> (eX-A)+7 in [0..14].
   1679  ff2c							; S6b's adc #14 was a 7px-LEFT shift: it
   1680  ff2c							; killed empty space left of the beam and
   1681  ff2c							; missed every enemy overlapping the tip
   1682  ff2c							; from the right (laser_collision_tip_bug).
   1683  ff2c		       c9 0f		      cmp	#15	; bcs -> miss
   1684  ff2e		       b0 1a		      bcs	.LHNext
   1685  ff30				   .LHHit
   1686  ff30		       bc 52 ff 	      ldy	EnemyOffTable,X	; type offset into staged record
   1687  ff33		       b1 e5		      lda	(FetchPtr),Y	; direct — level data in this bank (was fold)
   1688  ff35		       c9 05		      cmp	#LAMP
   1689  ff37		       f0 0c		      beq	.LHLamp
   1690  ff39		       a5 ba		      lda	EnemyDeadMask
   1691  ff3b		       1d 55 ff 	      ora	EnemyBitTable,X
   1692  ff3e		       85 ba		      sta	EnemyDeadMask
   1693  ff40		       a9 50		      lda	#$50	; result: kill — caller adds #$50 score
   1694  ff42		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (A/Z/C preserved)
   1695  ff45				   .LHLamp
   1696  ff45		       a9 01		      lda	#1	; result: lamp — caller crashes the lamp
   1697  ff47		       4c f8 fb 	      jmp	ReturnPad
   1698  ff4a				   .LHNext
   1699  ff4a		       e8		      inx
   1700  ff4b		       d0 c0		      bne	.LHLoop
   1701  ff4d				   .LHTOut
   1702  ff4d		       a9 00		      lda	#0	; result: miss (Z set for caller's beq)
   1703  ff4f		       4c f8 fb 	      jmp	ReturnPad
   1704  ff52
   1705  ff52							; Type-offset table (copy of kernel EnemyOffTable: enemy index * 4; S4.1) and
   1706  ff52							; dead-bit table (copy of kernel EnemyBitTable) — bank0 ROM is not visible
   1707  ff52							; from here; labels keep the kernel-side test anchors working.
   1708  ff52				   EnemyOffTable
   1709  ff52		       00 04 08 	      .byte.b	0,4,8
   1710  ff55
   1711  ff55				   EnemyBitTable
   1712  ff55		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1713  ff59
   1714  ff59							; ------------------------------------------------------------------------------
   1715  ff59							; VcrShutter — sprite-shutter staging (vcrunch_shutter_plan Phase B).
   1716  ff59							; Tail-entered from PhVcrPre (PhaseBlink walk, 0 pushes — the VBL chain sits
   1717  ff59							; on the measured SP floor) and tail-exits at .PhRec.
   1718  ff59							;   IN:  FetchPtr = hot record stream, Y = record base (class byte)
   1719  ff59							;   OUT: Y = base+4 (.PhRec contract: its iny -> base+5 = next class)
   1720  ff59							;   Clobbers A/X/Y + LineCount/CollisionCellX/CollisionEndY/Temp (all
   1721  ff59							;   PhaseBlink scratch in this window; the pack rebuilds CollisionEndY
   1722  ff59							;   after PhaseBlink returns). NO stack use.
   1723  ff59							; - Punches the vcrunch bbox OPEN in PF0/1/2Buf (pair-range AND): the ball
   1724  ff59							;   block would hide under a solid cell (CTRLPF priority), and the render
   1725  ff59							;   and the cell walk share the buffers by design. Reflect mirrors the
   1726  ff59							;   punched left-half cell to the right half.
   1727  ff59							; - Stages Temp = mirrored BallX = 159-4x (right edge; >= 87 so the pack's
   1728  ff59							;   (Temp-87)>>3 decode stays valid) and BandTab[band..band+h-1] = $ff —
   1729  ff59							;   the D6 ball machinery then renders the block with zero kernel changes.
   1730  ff59							; ------------------------------------------------------------------------------
   1731  ff59							; Tally entry tramp slice ($FFE6-$FFEB, byte-identical with kernel.asm —
   1732  ff59							; guard: check_moth_tramp). bank0 executes `sta $1FF8`; the fetch at $FFE9
   1733  ff59							; comes from THIS bank = `jmp TallyEntry`. Neither bank runs its other half.
   1734  ff59		       00 00 00 00*	      .ds	$FFE6 - *, 0
   1735  ffe6				   TallyTramp
   1736  ffe6		       8d f8 1f 	      sta	$1FF8
   1737  ffe9		       4c 13 f3 	      jmp	TallyEntry
   1738  ffec
   1739  ffec							; ------------------------------------------------------------------------------
   1740  ffec							; HotOverlapFlag (bank2-side, A3): OvM1Block/OvShutScan reach it with `jmp`
   1741  ffec							; while bank2 is selected, so THIS copy is the live one. Bank3 has no room
   1742  ffec							; at $FE93 (OvShutBand .OSline), so the pad sits at $FFEC like bank0's;
   1743  ffec							; the `jmp` at +3 is fetched from bank3's $FFEF image.
   1744  ffec							; ------------------------------------------------------------------------------
   1745  ffec					      .ds	$FFEC - *, 0
   1746  ffec				   HotOverlapFlag
   1747  ffec		       8d f9 1f 	      sta	$1FF9	; select bank3
   1748  ffef		       4c 7f f6 	      jmp	$F67F	; bank3 HotOverlapBody (synced by verify_build)
   1749  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   1750  fff2
   1751  fff2							; Pad to vectors at $FFFA ($FFF2-$FFF9 = fill — never code: $FFF6-$FFF9
   1752  fff2							; are F6 hotspot mirrors on peek, see MothExitPad at $FC49)
   1753  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0
   1754  fffa
   1755  fffa							; Interrupt vectors
   1756  fffa		       00 f0		      .word.w	$F000	; NMI vector
   1757  fffc		       00 f0		      .word.w	$F000	; RESET vector
   1758  fffe		       00 f0		      .word.w	$F000	; IRQ vector
