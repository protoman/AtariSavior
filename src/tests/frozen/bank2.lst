   1945  fcad
   1946  fcad							; ------------------------------------------------------------------------------
   1947  fcad							; BuildColupF + HotOverlapBody moved to bank3 (A3 2026-10-19 — they walk the
   1948  fcad							; level-data record stream, which now lives there). The space below is fill;
   1949  fcad							; BombEnemyBlastBody stays PINNED at its original address so the bank0/bank2
   1950  fcad							; blast-tramp literals ($FDD8 twins) need no resync.
   1951  fcad							; ------------------------------------------------------------------------------
   1952  fcad							; ------------------------------------------------------------------
   1953  fcad							; C2 (2026-10-20): B3StageBand + M1OffTab (was bank3 $FC38-$FCF2).
   1954  fcad							; Called from BCFDarkRun (`jmp B3StageBand`) and bank1's HUD fold; ends
   1955  fcad							; `jmp ReturnPad`. ZP/TIA only — no level-data read.
   1956  fcad							; ------------------------------------------------------------------
   1957  fcad		       00 00 00 00*	      .ds	$FCB8 - *, 0
   1958  fcb8				   B3StageBand
   1959  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1960  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1961  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1962  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1963  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1964  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1965  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1966  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1967  fcb8							; the pack uses $8F).
   1968  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1969  fcba		       29 01		      and	#$01
   1970  fcbc		       aa		      tax
   1971  fcbd		       bd 71 fd 	      lda	M1OffTab,X
   1972  fcc0		       85 92		      sta	RectCount
   1973  fcc2		       a5 99		      lda	RoomMetaA	; MetaA
   1974  fcc4		       4a		      lsr		; band0 bit -> carry
   1975  fcc5		       a9 00		      lda	#0
   1976  fcc7		       2a		      rol
   1977  fcc8		       f0 02		      beq	.SBTb0z
   1978  fcca		       a9 ff		      lda	#$ff
   1979  fccc				   .SBTb0z
   1980  fccc		       85 ed		      sta	BandTab
   1981  fcce		       a5 99		      lda	RoomMetaA
   1982  fcd0		       4a		      lsr
   1983  fcd1		       4a		      lsr		; band1 bit -> carry
   1984  fcd2		       a9 00		      lda	#0
   1985  fcd4		       2a		      rol
   1986  fcd5		       f0 02		      beq	.SBTb1z
   1987  fcd7		       a9 ff		      lda	#$ff
   1988  fcd9				   .SBTb1z
   1989  fcd9		       85 ee		      sta	BandTab+1
   1990  fcdb		       a5 99		      lda	RoomMetaA
   1991  fcdd		       4a		      lsr
   1992  fcde		       4a		      lsr
   1993  fcdf		       4a		      lsr		; band2 bit -> carry
   1994  fce0		       a9 00		      lda	#0
   1995  fce2		       2a		      rol
   1996  fce3		       f0 02		      beq	.SBTb2z
   1997  fce5		       a9 ff		      lda	#$ff
   1998  fce7				   .SBTb2z
   1999  fce7		       85 ef		      sta	BandTab+2
   2000  fce9							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
   2001  fce9							; set it this overscan) → blank all band gates so the cave renders no
   2002  fce9							; strip; the pack below then emits mask 0 → every overlay stays
   2003  fce9							; transparent too. BandTab restages from ROM next room entry. ---
   2004  fce9		       a5 ba		      lda	EnemyDeadMask
   2005  fceb		       29 08		      and	#$08
   2006  fced		       f0 08		      beq	.SBTstripAlive
   2007  fcef		       a9 00		      lda	#0
