   1955  fcc7		       00 00 00 	      .byte.b	0, 0, 0
   1956  fcca		       4c 98 fb 	      jmp	PhNext	; hcrunch PF staging return (Y = base+2)
   1957  fccd		       00 00 00 	      .byte.b	0, 0, 0
