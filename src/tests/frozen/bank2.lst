   1474  f924							; Phase 3 blink masks — pair index (2c>>1) → the two adjacent PF bits
   1475  f924							; for that left-half cell (PF0: bits4-7 left-to-right; PF1: bits7-0;
   1476  f924							; PF2: bits0-7 reversed). Pairs never straddle a register (even 2c).
   1477  f924				   PhMaskTab
   1478  f924		       30 c0		      .byte.b	$30, $C0	; PF0 pairs (0,1) (2,3)
   1479  f926		       c0 30 0c 03	      .byte.b	$C0, $30, $0C, $03	; PF1 pairs (4,5) (6,7) (8,9) (10,11)
   1480  f92a		       03 0c 30 c0	      .byte.b	$03, $0C, $30, $C0	; PF2 pairs (12,13) ... (18,19)
   1481  f92e		       00 00 00 00*	      .ds	$F970 - *, 0	; pinned: bank1 .BMWDone jmp operand ($F970)
   1482  f970				   M1StripBlast
   1483  f970							; Phase 4 M1 strip blast — entered from bank1 BombMarkWalls .BMWDone
   1484  f970							; via the $F9AC shared pad (`sta $1FF8 / jmp $F970`; 0 pushes). Bank2-
   1485  f970							; only job (P2b stager): the packed meta (TilePF0+9/+10) lives in THIS
   1486  f970							; bank's ROM — read the door flags + left-strip dcol, stage them, let
   1487  f970							; bank1 StripBlastCheck run BOTH overlap takes (the blast window is
   1488  f970							; left-half cols 0..19 and stays READ-ONLY here).
   1489  f970							; Staging contract (both scratch bytes free in this flow):
   1490  f970							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
   1491  f970							;   Temp ($88 = bank1 BMWScratch) := $FF when MetaB b7 (right door)
   1492  f970							;   so the ball-strip take can never fire. Key pickup (P5) sets b3/b4
   1493  f970							;   for doors instead (comment hook at the takes).
   1494  f970		       a5 92		      lda	RectCount	; original screen col (BMW prologue stash)
   1495  f972		       c9 14		      cmp	#20
   1496  f974		       b0 1b		      bcs	.M1SBnone	; right bomb → left strip unreachable
   1497  f976		       a5 ba		      lda	EnemyDeadMask
   1498  f978		       29 10		      and	#$10	; b4 already set → nothing to stage
   1499  f97a		       d0 15		      bne	.M1SBnone
   1500  f97c		       a5 99		      lda	RoomMetaA	; MetaA
   1501  f97e		       29 08		      and	#$08	; b3 = left door (key-only, bomb-immune)
   1502  f980		       d0 0f		      bne	.M1SBnone	; stays $FF: bank1 takes no left strip
   1503  f982		       a5 99		      lda	RoomMetaA	; reload (and clobbered A)
   1504  f984		       4a		      lsr
   1505  f985		       4a		      lsr
   1506  f986		       4a		      lsr
   1507  f987		       4a		      lsr		; m1_col+1 (0 = no M1 → 2ℓ = $FE, off the
   1508  f988							;   high end — bank1's hi test rejects)
   1509  f988		       38		      sec
   1510  f989		       e9 01		      sbc	#1	; ℓ = left_col
   1511  f98b		       0a		      asl		; 2ℓ = strip left dcol
   1512  f98c		       85 92		      sta	RectCount	; staged (nothing after this reads the col)
   1513  f98e		       4c 95 f9 	      jmp	.M1SBdoorR
   1514  f991				   .M1SBnone
   1515  f991		       a9 ff		      lda	#$FF
   1516  f993		       85 92		      sta	RectCount	; no left strip this frame
   1517  f995				   .M1SBdoorR
   1518  f995		       a5 9a		      lda	RoomMetaB	; MetaB, b7 = right door
   1519  f997		       10 04		      bpl	.M1SBout
   1520  f999		       a0 ff		      ldy	#$FF
