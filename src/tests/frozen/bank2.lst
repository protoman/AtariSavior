    235  f092							; --- PF rebuild: one 9-byte read (PF0+PF1+PF2 rows are contiguous in
    236  f092							;     ROM and in RAM: PF0Buf $C3 + Y covers $C3-$CB = all 9 rows) ---
    237  f092		       a5 99		      lda	RoomPF0Lo
    238  f094		       85 e5		      sta	FetchPtr
    239  f096		       a5 9a		      lda	RoomPF0Hi
    240  f098		       85 e6		      sta	FetchPtr+1
    241  f09a		       a0 00		      ldy	#0
    242  f09c				   .EBpf
    243  f09c		       b1 e5		      lda	(FetchPtr),Y
    244  f09e		       99 c3 00 	      sta	PF0Buf,Y
    245  f0a1		       c8		      iny
    246  f0a2		       c0 09		      cpy	#9
    247  f0a4		       d0 f6		      bne	.EBpf
    248  f0a6
    249  f0a6							; --- room meta staging: MetaA/MetaB → the pointer bytes ($99/$9A) ---
    250  f0a6							; The block pointer is DEAD from here on (the 9-byte copy above was its
    251  f0a6							; last reader), so the pair carries the room's meta for the whole visit.
    252  f0a6							; EVERY bank2 meta reader uses RoomMetaA/B — that is what lets the VBL
    253  f0a6							; band chain move to bank3 later with no (RoomPF0Lo),Y read left.
    254  f0a6							; Y = 9 on entry from the copy loop above (so no LDY here).
    255  f0a6		       b1 e5		      lda	(FetchPtr),Y	; MetaA (Y = 9)
    256  f0a8		       85 99		      sta	RoomMetaA	; = RoomPF0Lo — pointer lo dies here
    257  f0aa		       c8		      iny
    258  f0ab		       b1 e5		      lda	(FetchPtr),Y	; MetaB (Y = 10)
    259  f0ad		       85 9a		      sta	RoomMetaB	; = RoomPF0Hi — pointer hi dies here
    260  f0af
    261  f0af							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    262  f0af		       a5 c1		      lda	EnemyRamD
    263  f0b1		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    264  f0b3		       85 c1		      sta	EnemyRamD
    265  f0b5		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    266  f0b7		       85 c2		      sta	EnemyRamP
    267  f0b9		       a5 b1		      lda	EnemyDataLo
    268  f0bb		       85 e5		      sta	FetchPtr
    269  f0bd		       a5 b2		      lda	EnemyDataHi
    270  f0bf		       85 e6		      sta	FetchPtr+1
    271  f0c1		       a2 00		      ldx	#0
    272  f0c3				   EBLER_Loop
    273  f0c3		       e4 b3		      cpx	EnemyCount
    274  f0c5		       b0 36		      bcs	EBLER_Done
    275  f0c7		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    276  f0ca		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    277  f0cc		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    278  f0ce		       c8		      iny		; +1 = x
    279  f0cf		       b1 e5		      lda	(FetchPtr),Y
    280  f0d1		       95 bd		      sta	EnemyRamX,X
    281  f0d3		       c8		      iny		; +2 = y
    282  f0d4		       b1 e5		      lda	(FetchPtr),Y
    283  f0d6		       95 e2		      sta	EnemyRamY,X
    284  f0d8		       c8		      iny		; +3 = dir ($FF = left)
    285  f0d9		       b1 e5		      lda	(FetchPtr),Y
    286  f0db		       a4 88		      ldy	Temp	; record type
    287  f0dd		       c0 02		      cpy	#SNAKE
    288  f0df		       d0 02		      bne	EBLER_Dir
    289  f0e1		       49 ff		      eor	#$FF	; SNAKE: the authored dir = where it will
    290  f0e3							; come OUT, so invert the live bit — the
    291  f0e3							; first move must be the retreat into its
    292  f0e3							; wall (user 2026-10-19). Nothing else
    293  f0e3							; reads the ROM dir: the patrol bounds are
    294  f0e3							; spawn ± SNAKE_PATROL.
    295  f0e3				   EBLER_Dir
    296  f0e3		       a8		      tay		; Y = dir, re-setting N from A (the cpy
    297  f0e4							; above clobbered the flags `bmi` needs;
    298  f0e4							; Y is reloaded at the loop top)
    299  f0e4		       30 0a		      bmi	EBLER_Left
    300  f0e6		       bd 55 ff 	      lda	EnemyBitTable,X	; face right → set bit
    301  f0e9		       05 c1		      ora	EnemyRamD
    302  f0eb		       85 c1		      sta	EnemyRamD
    303  f0ed		       4c f9 f0 	      jmp	EBLER_Next
    304  f0f0				   EBLER_Left
    305  f0f0		       bd 55 ff 	      lda	EnemyBitTable,X	; face left → clear bit
    306  f0f3		       49 ff		      eor	#$FF
    307  f0f5		       25 c1		      and	EnemyRamD
    308  f0f7		       85 c1		      sta	EnemyRamD
    309  f0f9				   EBLER_Next
    310  f0f9		       e8		      inx
    311  f0fa		       4c c3 f0 	      jmp	EBLER_Loop
    312  f0fd				   EBLER_Done
