    903  f632							; PlayerDir<<3 (bit3 = mirror, kernel.asm:602), FooterPtr1 = bomb state (draw rows), COLUP1 = fuse color or
    904  f632							; COLUBK = explosion blink color (same (60-BombTimer)&3 table as the game's
    905  f632							; BombBlinkColors). Band tail restores COLUBK/REFP0 before the footer.
