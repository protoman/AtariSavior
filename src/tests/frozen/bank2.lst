------- FILE generated/levels_equ.asm LEVEL 2 PASS 2
      0  f000					      include	"generated/levels_equ.asm"	; BAND_COLOR (0 bytes of ROM)
      1  f000							; Generated by convert_level.py --levels. Do not edit by hand.
      2  f000							; One bottom-band color for the whole game: the room record keeps only
      3  f000							; the per-room FLAG (convert_level rejects a second
      4  f000							; color — extend the format first if that is ever needed).
      5  f000		       00 80	   BAND_COLOR =	$80
------- FILE bank2.asm
    169  f000
    170  f000							; --- 5-byte stub ---
    171  f000		       a9 00		      lda	#0
    172  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    173  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    174  f008
    175  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    176  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    177  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    178  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    179  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    180  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    181  f008							; = Origin Reverse.
    182  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    183  f010				   EnterRoomB2
    184  f010		       85 98		      sta	RoomNo
    185  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    186  f013		       a5 9f		      lda	LevelPFDataLo
    187  f015		       85 e5		      sta	FetchPtr
    188  f017		       a5 a0		      lda	LevelPFDataHi
    189  f019		       85 e6		      sta	FetchPtr+1
    190  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b5-0 | band b6 | b7 extras
    191  f01d		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    192  f01f							;   SHAPE ADDRESS TABLE lives in that bank,
    193  f01f							;   so bank2 needs no bank3 label). Loader
    194  f01f							;   scratch: overwritten with MetaA later.
    195  f01f		       85 88		      sta	Temp
    196  f021							; band flag b6 → RoomBandColor (staged BEFORE the block reader — the
    197  f021							; reader never writes it, and this is the only writer in the game).
    198  f021		       a5 88		      lda	Temp
    199  f023		       29 40		      and	#$40
    200  f025		       f0 02		      beq	.EBnoBand
    201  f027		       a9 80		      lda	#BAND_COLOR
    202  f029				   .EBnoBand
    203  f029		       85 bc		      sta	RoomBandColor
    204  f02b							; TilePF0 is no longer stored per room: bank3's block reader derives it
    205  f02b							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    206  f02b
    207  f02b							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    208  f02b							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    209  f02b							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    210  f02b							; (records stay contiguous in room order), so the old packed index byte
    211  f02b							; and its 31-record/level cap are gone. The band COLOR is the global
    212  f02b							; BAND_COLOR (one water color per game).
    213  f02b							; LevelConnSpare is free here: it only carries the exit-scan target, and
    214  f02b							; that scan has already returned when EnterRoomB2 is entered.
    215  f02b		       a5 98		      lda	RoomNo
    216  f02d		       a8		      tay		; Y = room (one byte per record)
    217  f02e							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    218  f02e							; low byte loses the first carry (the second `adc n` consumes it) and the
    219  f02e							; high byte then misses that carry — level 14 of a 20-level stage read its
    220  f02e							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    221  f02e		       a5 a1		      lda	LevelRoomN
    222  f030		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    223  f031		       18		      clc
    224  f032		       65 9f		      adc	LevelPFDataLo
    225  f034		       85 e5		      sta	FetchPtr
    226  f036		       a5 a0		      lda	LevelPFDataHi
    227  f038		       69 00		      adc	#0
    228  f03a		       85 e6		      sta	FetchPtr+1
    229  f03c		       b1 e5		      lda	(FetchPtr),Y
    230  f03e		       4a		      lsr
    231  f03f		       4a		      lsr
    232  f040		       4a		      lsr
    233  f041		       4a		      lsr
    234  f042		       4a		      lsr
    235  f043		       4a		      lsr		; count = b7-6
    236  f044		       85 b3		      sta	EnemyCount
    237  f046		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    238  f048		       a0 00		      ldy	#0
    239  f04a		       a9 00		      lda	#0
    240  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    241  f04e				   .EBSumLoop
    242  f04e		       c4 88		      cpy	Temp
    243  f050		       f0 11		      beq	.EBSumDone
    244  f052		       b1 e5		      lda	(FetchPtr),Y
    245  f054		       4a		      lsr
    246  f055		       4a		      lsr
    247  f056		       4a		      lsr
    248  f057		       4a		      lsr
    249  f058		       4a		      lsr
    250  f059		       4a		      lsr		; each earlier room's count (0..3)
    251  f05a		       18		      clc
    252  f05b		       65 a2		      adc	LevelConnSpare
    253  f05d		       85 a2		      sta	LevelConnSpare
    254  f05f		       c8		      iny
    255  f060		       4c 4e f0 	      jmp	.EBSumLoop
    256  f063				   .EBSumDone
    257  f063		       a5 e5		      lda	FetchPtr
    258  f065		       18		      clc
    259  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    260  f068		       85 b1		      sta	EnemyDataLo
    261  f06a		       a5 e6		      lda	FetchPtr+1
    262  f06c		       69 00		      adc	#0
    263  f06e		       85 b2		      sta	EnemyDataHi
    264  f070		       a5 a2		      lda	LevelConnSpare
    265  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    266  f073		       18		      clc
    267  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    268  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    269  f078		       85 b1		      sta	EnemyDataLo
    270  f07a		       a5 b2		      lda	EnemyDataHi
    271  f07c		       69 00		      adc	#0
    272  f07e		       85 b2		      sta	EnemyDataHi
    273  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    274  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    275  f084
    276  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    277  f084		       85 b5		      sta	BombPacked
    278  f086		       85 f7		      sta	BombTimer
    279  f088		       85 f1		      sta	BombSnd
    280  f08a		       85 19		      sta	AUDV0
    281  f08c
    282  f08c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    283  f08c
    284  f08c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    285  f08c		       a5 c1		      lda	EnemyRamD
    286  f08e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    287  f090		       85 c1		      sta	EnemyRamD
    288  f092		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    289  f094		       85 c2		      sta	EnemyRamP
    290  f096		       a5 b1		      lda	EnemyDataLo
    291  f098		       85 e5		      sta	FetchPtr
    292  f09a		       a5 b2		      lda	EnemyDataHi
    293  f09c		       85 e6		      sta	FetchPtr+1
    294  f09e		       a2 00		      ldx	#0
    295  f0a0				   EBLER_Loop
    296  f0a0		       e4 b3		      cpx	EnemyCount
    297  f0a2		       b0 3a		      bcs	EBLER_Done
    298  f0a4		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*3 record offset
    299  f0a7		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (b3-0) | dir (b7: 1 = left)
    300  f0a9		       85 88		      sta	Temp	; Temp = raw record byte (free: EnterRoom)
    301  f0ab		       c8		      iny		; +1 = x
    302  f0ac		       b1 e5		      lda	(FetchPtr),Y
    303  f0ae		       95 bd		      sta	EnemyRamX,X
    304  f0b0		       c8		      iny		; +2 = y
    305  f0b1		       b1 e5		      lda	(FetchPtr),Y
    306  f0b3		       95 e2		      sta	EnemyRamY,X
    307  f0b5		       a5 88		      lda	Temp
    308  f0b7		       29 0f		      and	#$0F	; record type
    309  f0b9		       c9 02		      cmp	#SNAKE
