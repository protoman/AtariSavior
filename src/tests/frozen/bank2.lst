    127  f008
    128  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    129  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    130  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    131  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    132  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    133  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    134  f008							; = Origin Reverse.
    135  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    136  f010				   EnterRoomB2
    137  f010		       85 98		      sta	RoomNo
    138  f012		       0a		      asl
    139  f013		       a8		      tay		; Y = room * 2 (C3: ONE word per room)
    140  f014		       a5 9f		      lda	LevelPFDataLo
    141  f016		       85 e5		      sta	FetchPtr
    142  f018		       a5 a0		      lda	LevelPFDataHi
    143  f01a		       85 e6		      sta	FetchPtr+1
    144  f01c		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: rects ptr lo
    145  f01e		       85 90		      sta	RoomRectsLo
    146  f020		       c8		      iny
    147  f021		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    148  f023		       85 91		      sta	RoomRectsHi
    149  f025							; TilePF0 is no longer stored per room: bank3's block reader derives it
    150  f025							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    151  f025
    152  f025							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    153  f025							;     live in BANK3 (the level-data bank). One tail-jump into the block
    154  f025							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    155  f025							;     0 pushes (the room-load chain sits at the measured SP floor).
    156  f025		       4c 50 f4 	      jmp	ERBlocksPad
    157  f028				   ERBlocksDone
    158  f028
    159  f028							; --- enemy record for this room (C2 2026-10-20: 2 bytes) ------------------
    160  f028							; byte0 = count<<5 | first record index, byte1 = bottom-band color.
    161  f028							; RoomEnemies = level base + 4n, enemy records = level base + 6n
    162  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    163  f028		       a5 98		      lda	RoomNo
    164  f02a		       0a		      asl
    165  f02b		       a8		      tay		; Y = room * 2
    166  f02c		       a5 9f		      lda	LevelPFDataLo
    167  f02e		       18		      clc
    168  f02f		       65 a1		      adc	LevelRoomN
    169  f031		       65 a1		      adc	LevelRoomN
    170  f033		       65 a1		      adc	LevelRoomN
    171  f035		       65 a1		      adc	LevelRoomN	; base + 4n = RoomEnemies
    172  f037		       85 e5		      sta	FetchPtr
    173  f039		       a5 a0		      lda	LevelPFDataHi
    174  f03b		       69 00		      adc	#0
    175  f03d		       85 e6		      sta	FetchPtr+1
    176  f03f		       b1 e5		      lda	(FetchPtr),Y
    177  f041		       4a		      lsr
    178  f042		       4a		      lsr
    179  f043		       4a		      lsr
    180  f044		       4a		      lsr
    181  f045		       4a		      lsr		; count = b7-5
    182  f046		       85 b3		      sta	EnemyCount
    183  f048		       a5 e5		      lda	FetchPtr
    184  f04a		       18		      clc
    185  f04b		       65 a1		      adc	LevelRoomN
    186  f04d		       65 a1		      adc	LevelRoomN	; base + 6n = enemy records
    187  f04f		       85 b1		      sta	EnemyDataLo
    188  f051		       a5 e6		      lda	FetchPtr+1
    189  f053		       69 00		      adc	#0
    190  f055		       85 b2		      sta	EnemyDataHi
    191  f057		       b1 e5		      lda	(FetchPtr),Y
    192  f059		       29 1f		      and	#$1F	; first record index
    193  f05b		       0a		      asl
    194  f05c		       0a		      asl		; *4 (index <= 31 → fits one byte)
    195  f05d		       18		      clc
    196  f05e		       65 b1		      adc	EnemyDataLo
