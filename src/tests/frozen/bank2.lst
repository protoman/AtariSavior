    754  f307							;   $FCB8-$FD86  207 B  B3StageBand (+ M1OffTab)
    755  f307							;   $FF59-$FFE5  141 B  HOVFeatEntry
    756  f307							; Reserving them turns an overflow into a named pad instead of a ROM error.
    757  f307							; ------------------------------------------------------------------------------
    758  f307					      .ds	$F307 - *, 0
