   2080  fd35							; --- NUSIZ1 owned here since P2b (kernel's VBL $30 restore deleted) ---
   2081  fd35							; Constant $30 (P1 single, M1 8 clk): the door distinction is COLOR
   2082  fd35							; (yellow $1C staged below), not width — the 4clk block read as "half
   2083  fd35							; a tile", the 2clk thin stripe as "only one strip" (user, 2026-10-12).
   2084  fd35		       a9 30		      lda	#$30
