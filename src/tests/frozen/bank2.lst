    234  f06b		       a5 e6		      lda	FetchPtr+1
    235  f06d		       69 00		      adc	#0
    236  f06f		       85 b2		      sta	EnemyDataHi
    237  f071		       a5 a2		      lda	LevelConnSpare
    238  f073		       0a		      asl
    239  f074		       0a		      asl		; *4 (records are 4 B; index <= 63)
    240  f075		       18		      clc
    241  f076		       65 b1		      adc	EnemyDataLo
    242  f078		       85 b1		      sta	EnemyDataLo
    243  f07a		       a5 b2		      lda	EnemyDataHi
    244  f07c		       69 00		      adc	#0
