------- FILE generated/levels_equ.asm LEVEL 2 PASS 2
      0  f000					      include	"generated/levels_equ.asm"	; BAND_COLOR (0 bytes of ROM)
      1  f000							; Generated by convert_level.py --levels. Do not edit by hand.
      2  f000							; One bottom-band color for the whole game: the room record keeps only
      3  f000							; the per-room FLAG (convert_level rejects a second
      4  f000							; color — extend the format first if that is ever needed).
      5  f000		       00 80	   BAND_COLOR =	$80
------- FILE bank2.asm
    178  f000
    179  f000							; --- 5-byte stub ---
    180  f000		       a9 00		      lda	#0
    181  f002		       8d f4 1f 	      sta	$1FF4	; select bank0
    182  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    183  f008
    184  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    185  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF6 / jmp $F010).
    186  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    187  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    188  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    189  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    190  f008							; = Origin Reverse.
    191  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    192  f010				   EnterRoomB2
    193  f010		       85 98		      sta	RoomNo
    194  f012		       20 02 fc 	      jsr	SetRoomExits	; RoomExits: which sides have a room (bomb gate)
    195  f015		       a4 98		      ldy	RoomNo	; Y = room (C2: every column is 1 B/room)
    196  f017		       a5 9f		      lda	LevelPFDataLo
    197  f019		       85 e5		      sta	FetchPtr
    198  f01b		       a5 a0		      lda	LevelPFDataHi
    199  f01d		       85 e6		      sta	FetchPtr+1
    200  f01f		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b6-0 | band b7
    201  f021		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    202  f023							;   SHAPE ADDRESS TABLE lives in that bank,
    203  f023							;   so bank2 needs no bank3 label). Loader
    204  f023							;   scratch: overwritten with MetaA later.
    205  f023		       85 88		      sta	Temp
    206  f025							; band flag b7 → RoomBandColor (staged BEFORE the block reader — the
    207  f025							; reader never writes it, and this is the only writer in the game).
    208  f025							; LAYOUT 8 (2026-10-24): the index is 7 bits and the band flag moved to b7;
    209  f025							; the owns-extras bit is GONE (a room has a record iff its counts byte
    210  f025							; carries a nonzero extras ordinal, which is exactly what ExtrasLoad
    211  f025							; indexes with — b7 was redundant). (A still holds the byte.)
    212  f025		       29 80		      and	#$80
    213  f027		       f0 02		      beq	.EBnoBand
    214  f029		       a9 80		      lda	#BAND_COLOR
    215  f02b				   .EBnoBand
    216  f02b		       85 bc		      sta	RoomBandColor
    217  f02d							; TilePF0 is no longer stored per room: bank3's block reader derives it
    218  f02d							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    219  f02d
    220  f02d							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    221  f02d							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    222  f02d							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    223  f02d							; (records stay contiguous in room order), so the old packed index byte
    224  f02d							; and its 31-record/level cap are gone. The band COLOR is the global
    225  f02d							; BAND_COLOR (one water color per game).
    226  f02d							; LevelConnSpare is free here: it only carries the exit-scan target, and
    227  f02d							; that scan has already returned when EnterRoomB2 is entered.
    228  f02d		       a4 98		      ldy	RoomNo	; Y = room (one byte per record)
    229  f02f							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    230  f02f							; low byte loses the first carry (the second `adc n` consumes it) and the
    231  f02f							; high byte then misses that carry — level 14 of a 20-level stage read its
    232  f02f							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    233  f02f		       a5 a1		      lda	LevelRoomN
    234  f031		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    235  f032		       18		      clc
    236  f033		       65 9f		      adc	LevelPFDataLo
    237  f035		       85 e5		      sta	FetchPtr
    238  f037		       a5 a0		      lda	LevelPFDataHi
    239  f039		       69 00		      adc	#0
    240  f03b		       85 e6		      sta	FetchPtr+1
    241  f03d		       b1 e5		      lda	(FetchPtr),Y
    242  f03f		       4a		      lsr
    243  f040		       4a		      lsr
    244  f041		       4a		      lsr
    245  f042		       4a		      lsr
    246  f043		       4a		      lsr
    247  f044		       4a		      lsr		; count = b7-6
    248  f045		       85 b3		      sta	EnemyCount
    249  f047		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    250  f049		       a0 00		      ldy	#0
    251  f04b		       98		      tya		; (= lda #0)
    252  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    253  f04e				   .EBSumLoop
    254  f04e		       c4 88		      cpy	Temp
    255  f050		       f0 11		      beq	.EBSumDone
    256  f052		       b1 e5		      lda	(FetchPtr),Y
    257  f054		       4a		      lsr
    258  f055		       4a		      lsr
    259  f056		       4a		      lsr
    260  f057		       4a		      lsr
    261  f058		       4a		      lsr
    262  f059		       4a		      lsr		; each earlier room's count (0..3)
    263  f05a		       18		      clc
    264  f05b		       65 a2		      adc	LevelConnSpare
    265  f05d		       85 a2		      sta	LevelConnSpare
    266  f05f		       c8		      iny
    267  f060		       4c 4e f0 	      jmp	.EBSumLoop
    268  f063				   .EBSumDone
    269  f063		       a5 e5		      lda	FetchPtr
    270  f065		       18		      clc
    271  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    272  f068		       85 b1		      sta	EnemyDataLo
    273  f06a		       a5 e6		      lda	FetchPtr+1
    274  f06c		       69 00		      adc	#0
    275  f06e		       85 b2		      sta	EnemyDataHi
    276  f070		       a5 a2		      lda	LevelConnSpare
    277  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    278  f073		       18		      clc
    279  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    280  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    281  f078		       85 b1		      sta	EnemyDataLo
    282  f07a		       a5 b2		      lda	EnemyDataHi
    283  f07c		       69 00		      adc	#0
    284  f07e		       85 b2		      sta	EnemyDataHi
    285  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    286  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    287  f084
    288  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    289  f084		       85 b5		      sta	BombPacked
    290  f086		       85 f7		      sta	BombTimer
    291  f088		       85 f1		      sta	BombSnd
    292  f08a		       85 19		      sta	AUDV0
    293  f08c
    294  f08c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    295  f08c
    296  f08c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    297  f08c		       a5 c1		      lda	EnemyRamD
    298  f08e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    299  f090		       85 c1		      sta	EnemyRamD
    300  f092		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    301  f094		       85 c2		      sta	EnemyRamP
    302  f096		       a5 b1		      lda	EnemyDataLo
