    122  f000
    123  f000							; --- 5-byte stub ---
    124  f000		       a9 00		      lda	#0
    125  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    126  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    127  f008
    128  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    129  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    130  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    131  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    132  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    133  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    134  f008							; = Origin Reverse.
    135  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    136  f010				   EnterRoomB2
    137  f010		       85 98		      sta	RoomNo
    138  f012		       0a		      asl
    139  f013		       0a		      asl
    140  f014		       a8		      tay		; Y = room * 4
    141  f015		       a5 9f		      lda	LevelPFDataLo
    142  f017		       85 e5		      sta	FetchPtr
    143  f019		       a5 a0		      lda	LevelPFDataHi
    144  f01b		       85 e6		      sta	FetchPtr+1
    145  f01d		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: PF0 ptr lo
    146  f01f		       85 99		      sta	RoomPF0Lo
    147  f021		       c8		      iny
    148  f022		       b1 e5		      lda	(FetchPtr),Y	; PF0 ptr hi
    149  f024		       85 9a		      sta	RoomPF0Hi
    150  f026		       c8		      iny
    151  f027		       b1 e5		      lda	(FetchPtr),Y	; rects ptr lo
    152  f029		       85 90		      sta	RoomRectsLo
    153  f02b		       c8		      iny
    154  f02c		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    155  f02e		       85 91		      sta	RoomRectsHi
    156  f030
    157  f030							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    158  f030							;     live in BANK3 (the level-data bank). One tail-jump into the block
    159  f030							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    160  f030							;     0 pushes (the room-load chain sits at the measured SP floor).
    161  f030		       4c 50 f4 	      jmp	ERBlocksPad
    162  f033				   ERBlocksDone
    163  f033
    164  f033							; --- enemy record for this room (4 bytes: ptr_lo, ptr_hi, count, band) ---
    165  f033		       a5 98		      lda	RoomNo
    166  f035		       0a		      asl
    167  f036		       0a		      asl
    168  f037		       a8		      tay
    169  f038		       a5 af		      lda	LevelEnemyLo
    170  f03a		       85 e5		      sta	FetchPtr
    171  f03c		       a5 b0		      lda	LevelEnemyHi
    172  f03e		       85 e6		      sta	FetchPtr+1
    173  f040		       b1 e5		      lda	(FetchPtr),Y
    174  f042		       a2 00		      ldx	#0	; EnemyDataLo/Hi/Count are contiguous
    175  f044				   .EBrec
    176  f044		       95 b1		      sta	EnemyDataLo,X	; $B1/$B2/$B3 (record bytes 0-2)
    177  f046		       c8		      iny
    178  f047		       e8		      inx
    179  f048		       b1 e5		      lda	(FetchPtr),Y
    180  f04a		       e0 03		      cpx	#3
    181  f04c		       d0 f6		      bne	.EBrec
    182  f04e		       85 bc		      sta	RoomBandColor	; SOURCE room's band on the transition frame
    183  f050		       a9 00		      lda	#0	; (also the bomb reset seed below)
    184  f052		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    185  f054
    186  f054							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    187  f054		       85 b5		      sta	BombPacked
    188  f056		       85 f7		      sta	BombTimer
    189  f058		       85 f1		      sta	BombSnd
    190  f05a		       85 19		      sta	AUDV0
