   1332  feff							; arg, stored by LaserInput .LaserGo), drawn M0 = [A-7, A]. The body tests
   1333  feff							; ONE tip cell for wall first, then the missile's OWN body box against each
   1334  feff							; live enemy — no piercing: first contact wins and the caller resets the
   1335  feff							; beam to the eye. Vertical: beam rows [RoomY+2, RoomY+3] vs enemy [Y,+7] ->
   1336  feff							; (RoomY-Y)+3 in [0..8]. Horizontal (same convention as CheckEnemyHit):
   1337  feff							; |eLo-lo| <= 7 via (d+7) in [0..14]; caller keeps arg in [0,159].
   1338  feff							; Fold-free: enemy records are level data in THIS bank — stage once, direct
   1339  feff							; `lda (FetchPtr),Y` for the type (was `jsr FoldIndirect`).
   1340  feff							; RESULT PROTOCOL (pads cannot nest from a pad body — the kill/lamp/wall
   1341  feff							; ACTIONS stay in bank0's LaserInput): every exit returns A + Z through
   1342  feff							; ReturnPad (sta/rts preserve both): A=0 no contact (keep travelling) /
   1343  feff							; #$50 kill (dead bit set here, caller scores + resets) / A=1 lamp (caller
   1344  feff							; does CallPad_SetRoomDark + resets) / A=2 wall tip (caller resets, no
   1345  feff							; score). First live enemy in span only (dead mask skips it next frame —
   1346  feff							; no resurrection, no double score).
   1347  feff							; Does NOT touch Temp (joystick still live at the call site).
   1348  feff							; Wall first: the body tail-jmps to LaserWallClamp ($F25A) — tip cell
   1349  feff							; (patch-strip + mirrored PF rows) — solid returns A=2 straight through
   1350  feff							; ReturnPad (enemies behind the wall survive); clear ends
   1351  feff							; `jmp LaserClampDone` (back here = enemy loop): stack depth unchanged.
   1352  feff							; Clobbers A/X/Y/FetchPtr + CollisionCellY/CollisionEndY, RectCount,
   1353  feff							; CollisionEndX (strip marker); MODIFIES NOTHING else (no clamp any more).
   1354  feff							; ------------------------------------------------------------------------------
   1355  feff		       00		      .ds	$FF00 - *, 0	; pinned: bank0 tramp operand is literal $FF00
   1356  ff00				   LaserHitTestBody
   1357  ff00		       4c 5a f2 	      jmp	LaserWallClamp	; contact: tip-cell wall test FIRST (A=2 or
   1358  ff03							; fall into the enemy loop via LaserClampDone)
   1359  ff03				   LaserClampDone
   1360  ff03							; --- Stage (P3.1): enemy record pointer — loop writes no FetchPtr ---
   1361  ff03		       a5 b1		      lda	EnemyDataLo
   1362  ff05		       85 e5		      sta	FetchPtr
   1363  ff07		       a5 b2		      lda	EnemyDataHi
   1364  ff09		       85 e6		      sta	FetchPtr+1
   1365  ff0b		       a2 00		      ldx	#0
   1366  ff0d				   .LHLoop
   1367  ff0d		       e4 b3		      cpx	EnemyCount
   1368  ff0f		       b0 3c		      bcs	.LHTOut
   1369  ff11		       a5 ba		      lda	EnemyDeadMask
   1370  ff13		       3d 55 ff 	      and	EnemyBitTable,X
   1371  ff16		       d0 32		      bne	.LHNext
   1372  ff18		       a5 81		      lda	RoomY
   1373  ff1a		       38		      sec
   1374  ff1b		       f5 e2		      sbc	EnemyRamY,X
   1375  ff1d		       18		      clc
   1376  ff1e		       69 03		      adc	#3	; (RoomY-eY)+3 in [0..8] = eY in [RoomY-5, RoomY+3]
   1377  ff20		       c9 09		      cmp	#9	; out of beam rows RoomY+2..3
   1378  ff22		       b0 26		      bcs	.LHNext
   1379  ff24		       b5 bd		      lda	EnemyRamX,X
   1380  ff26		       38		      sec
   1381  ff27		       e5 8b		      sbc	CollisionX
   1382  ff29		       18		      clc
   1383  ff2a		       69 07		      adc	#7	; kill == drawn overlap: beam [A-7,A] x
   1384  ff2c							; enemy [eX-7,eX] (SAME arg-box convention
   1385  ff2c							; CheckEnemyHit uses for RoomX vs eX) ->
   1386  ff2c							; eX in [A-7, A+7] <=> (eX-A)+7 in [0..14].
   1387  ff2c							; S6b's adc #14 was a 7px-LEFT shift: it
   1388  ff2c							; killed empty space left of the beam and
   1389  ff2c							; missed every enemy overlapping the tip
   1390  ff2c							; from the right (laser_collision_tip_bug).
   1391  ff2c		       c9 0f		      cmp	#15	; bcs -> miss
   1392  ff2e		       b0 1a		      bcs	.LHNext
   1393  ff30				   .LHHit
   1394  ff30		       bc 52 ff 	      ldy	EnemyOffTable,X	; type offset into staged record
   1395  ff33		       b1 e5		      lda	(FetchPtr),Y	; direct — level data in this bank (was fold)
   1396  ff35		       c9 05		      cmp	#LAMP
   1397  ff37		       f0 0c		      beq	.LHLamp
   1398  ff39		       a5 ba		      lda	EnemyDeadMask
   1399  ff3b		       1d 55 ff 	      ora	EnemyBitTable,X
   1400  ff3e		       85 ba		      sta	EnemyDeadMask
   1401  ff40		       a9 50		      lda	#$50	; result: kill — caller adds #$50 score
   1402  ff42		       4c f8 fb 	      jmp	ReturnPad	; ReturnPad → bank0 caller (A/Z/C preserved)
   1403  ff45				   .LHLamp
   1404  ff45		       a9 01		      lda	#1	; result: lamp — caller crashes the lamp
   1405  ff47		       4c f8 fb 	      jmp	ReturnPad
   1406  ff4a				   .LHNext
   1407  ff4a		       e8		      inx
   1408  ff4b		       d0 c0		      bne	.LHLoop
   1409  ff4d				   .LHTOut
   1410  ff4d		       a9 00		      lda	#0	; result: miss (Z set for caller's beq)
   1411  ff4f		       4c f8 fb 	      jmp	ReturnPad
   1412  ff52
   1413  ff52							; Type-offset table (copy of kernel EnemyOffTable: enemy index * 4; S4.1) and
   1414  ff52							; dead-bit table (copy of kernel EnemyBitTable) — bank0 ROM is not visible
   1415  ff52							; from here; labels keep the kernel-side test anchors working.
   1416  ff52				   EnemyOffTable
   1417  ff52		       00 04 08 	      .byte.b	0,4,8
   1418  ff55
   1419  ff55				   EnemyBitTable
   1420  ff55		       01 02 04 08	      .byte.b	$01, $02, $04, $08
   1421  ff59
   1422  ff59							; Tally entry tramp slice ($FFE6-$FFEB, byte-identical with kernel.asm —
   1423  ff59							; guard: check_moth_tramp). bank0 executes `sta $1FF8`; the fetch at $FFE9
   1424  ff59							; comes from THIS bank = `jmp TallyEntry`. Neither bank runs its other half.
   1425  ff59		       00 00 00 00*	      .ds	$FFE6 - *, 0
   1426  ffe6				   TallyTramp
   1427  ffe6		       8d f8 1f 	      sta	$1FF8
   1428  ffe9		       4c 13 f3 	      jmp	TallyEntry
   1429  ffec
   1430  ffec							; ------------------------------------------------------------------------------
   1431  ffec							; HotOverlapFlag (bank2-side, A3): OvM1Block/OvShutBand reach it with `jmp`
   1432  ffec							; while bank2 is selected, so THIS copy is the live one. Bank3 has no room
   1433  ffec							; at $FE93 (OvShutBand .OSline), so the pad sits at $FFEC like bank0's;
   1434  ffec							; the `jmp` at +3 is fetched from bank3's $FFEF image.
   1435  ffec							; ------------------------------------------------------------------------------
   1436  ffec					      .ds	$FFEC - *, 0
   1437  ffec				   HotOverlapFlag
   1438  ffec		       8d f9 1f 	      sta	$1FF9	; select bank3
   1439  ffef		       4c c3 f5 	      jmp	$F5C3	; bank3 HotOverlapBody (synced by verify_build)
   1440  fff2					      .ds	$FFF2 - *, 0	; $FFF2-$FFF9 stay fill (F6 hotspot mirrors)
   1441  fff2
   1442  fff2							; Pad to vectors at $FFFA ($FFF2-$FFF9 = fill — never code: $FFF6-$FFF9
   1443  fff2							; are F6 hotspot mirrors on peek, see MothExitPad at $FC49)
   1444  fff2		       00 00 00 00*	      .ds	$FFFA - *, 0
   1445  fffa
   1446  fffa							; Interrupt vectors
   1447  fffa		       00 f0		      .word.w	$F000	; NMI vector
   1448  fffc		       00 f0		      .word.w	$F000	; RESET vector
   1449  fffe		       00 f0		      .word.w	$F000	; IRQ vector
