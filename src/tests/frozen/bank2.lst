   1916  fc81		       a4 98		      ldy	RoomNo
   1917  fc83		       b1 e5		      lda	(FetchPtr),Y	; own position (x<<4|y)
   1918  fc85		       18		      clc
   1919  fc86		       7d a2 fc 	      adc	ExitDeltaTab,X	; neighbour position (nibble 15 = off grid)
   1920  fc89		       20 4f fc 	      jsr	ExitScanB2
   1921  fc8c		       b0 1c		      bcs	ExitNoneB2	; nobody there: stay here
   1922  fc8e		       e0 02		      cpx	#2
   1923  fc90		       90 08		      bcc	.EDvertical
   1924  fc92		       bc a6 fc 	      ldy	ExitEdgeTab,X	; left/right: enter at the opposite X edge
   1925  fc95		       84 80		      sty	RoomX
   1926  fc97		       4c 10 f0 	      jmp	EnterRoomB2
   1927  fc9a				   .EDvertical
   1928  fc9a		       bc a6 fc 	      ldy	ExitEdgeTab,X	; up/down: enter at the opposite Y edge
   1929  fc9d		       84 81		      sty	RoomY
   1930  fc9f		       4c 10 f0 	      jmp	EnterRoomB2
