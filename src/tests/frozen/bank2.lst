    673  f313		       a5 8a		      lda	DropTarget
    674  f315		       f0 36		      beq	.TEArm
    675  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    676  f319		       d0 2d		      bne	.TEIdle
    677  f31b		       a9 04		      lda	#4
    678  f31d		       85 ad		      sta	TickCounter
    679  f31f		       c6 f2		      dec	TallyTicks
    680  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    681  f323		       a5 f2		      lda	TallyTicks
    682  f325		       29 03		      and	#3
    683  f327		       d0 15		      bne	.TEOne	; tick only
    684  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    685  f32b		       85 f1		      sta	BombSnd
    686  f32d		       a9 04		      lda	#4
    687  f32f		       85 15		      sta	AUDC0	; square
    688  f331		       a9 18		      lda	#24
    689  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    690  f335		       a9 08		      lda	#8
    691  f337		       85 19		      sta	AUDV0
    692  f339		       a9 03		      lda	#3	; tick + coin
    693  f33b		       4c f8 fb 	      jmp	ReturnPad
