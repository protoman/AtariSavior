   1265  f78a		       85 1b		      sta	GRP0	; GRP0A (buffer) = 0
   1266  f78c		       85 1c		      sta	GRP1	; GRP1A (buffer) = 0, GRP0 live = GRP0A = 0
   1267  f78e		       85 1b		      sta	GRP0	; GRP1 live = GRP1A = 0
