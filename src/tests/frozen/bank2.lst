   2477  ff59							;   punched left-half cell to the right half.
   2478  ff59							; - Stages Temp = mirrored BallX = 159-4x (right edge; >= 87 so the pack's
   2479  ff59							;   (Temp-87)>>3 decode stays valid) and BandTab[band..band+h-1] = $ff —
