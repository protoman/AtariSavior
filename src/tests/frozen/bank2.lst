   1749  fcc1		       00 00 00 	      .byte.b	0, 0, 0
   1750  fcc4		       4c 96 fb 	      jmp	PhNext	; vcrunch PF staging return (Y = base+2)
   1751  fcc7		       00 00 00 	      .byte.b	0, 0, 0
   1752  fcca		       4c 96 fb 	      jmp	PhNext	; hcrunch PF staging return (Y = base+2)
   1753  fccd		       00 00 00 	      .byte.b	0, 0, 0
   1754  fcd0		       4c 6b fd 	      jmp	HOVnext	; crunch miss → record walk continues
   1755  fcd3		       00 00 00 	      .byte.b	0, 0, 0
   1756  fcd6		       4c 60 fd 	      jmp	HOVlegHit	; crunch kill HIT → shared Temp b7 tail
   1757  fcd9		       00 00 00 	      .byte.b	0, 0, 0
   1758  fcdc		       4c 1c fd 	      jmp	HOVafterGate	; phase armed → overlap tests
