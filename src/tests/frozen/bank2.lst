    225  f08b		       a2 00		      ldx	#0
    226  f08d				   EBLER_Loop
    227  f08d		       e4 b3		      cpx	EnemyCount
    228  f08f		       b0 36		      bcs	EBLER_Done
    229  f091		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    230  f094		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    231  f096		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    232  f098		       c8		      iny		; +1 = x
    233  f099		       b1 e5		      lda	(FetchPtr),Y
    234  f09b		       95 bd		      sta	EnemyRamX,X
    235  f09d		       c8		      iny		; +2 = y
    236  f09e		       b1 e5		      lda	(FetchPtr),Y
    237  f0a0		       95 e2		      sta	EnemyRamY,X
    238  f0a2		       c8		      iny		; +3 = dir ($FF = left)
    239  f0a3		       b1 e5		      lda	(FetchPtr),Y
    240  f0a5		       a4 88		      ldy	Temp	; record type
    241  f0a7		       c0 02		      cpy	#SNAKE
    242  f0a9		       d0 02		      bne	EBLER_Dir
    243  f0ab		       49 ff		      eor	#$FF	; SNAKE: the authored dir = where it will
    244  f0ad							; come OUT, so invert the live bit — the
    245  f0ad							; first move must be the retreat into its
    246  f0ad							; wall (user 2026-10-19). Nothing else
    247  f0ad							; reads the ROM dir: the patrol bounds are
