   1492  fa26
   1493  fa26							; GetConnIdx RETIRED (C3, 2026-10-20): the four exit handlers moved to
   1494  fa26							; bank2 and read the connection record in-bank (LevelConnB2), so this pad's
   1495  fa26							; body had no caller. Deleting it (plus the bank0 `sta` half and this bank's
   1496  fa26							; `jmp` half) reclaimed 15 B here and removed a live-but-uncalled pad.
   1497  fa26
   1498  fa26							; ClearPFColumn/BombClearMask moved to the gameplay bank (bank 3).
   1499  fa26
   1500  fa26							; AddScore — add BCD amount in A (e.g. #$50, #$75) to HUD score.
   1501  fa26							; Score = THREE packed-BCD bytes, 6 digits, max 999,999 (user 2026-10-27; it was
   1502  fa26							; one binary thousands digit = 9,999, and level 1 alone is worth ~1,200):
   1503  fa26							;   ScoreTe = tens|ones   ScoreHu = thousands|hundreds   ScoreTh = 100k|10k
   1504  fa26							; Real 6502 BCD add — SED/ADC/CLD straight-line: D is cleared before any
   1505  fa26							; jsr, the 2600 has no interrupts, and nothing here restores D via plp
   1506  fa26							; (the 2026-09-23 decimal-mode rule). The old BINARY fix-up missed nibble-level
   1507  fa26							; overflow: $25+$75 = $9A stored raw -> glyph index 10 -> the solid-block score
   1508  fa26							; digit (screenshots/score_issue_002.png).
   1509  fa26							; A carry out of ScoreTe (>= 100 points) is rare, so it jumps to AddScoreCarry
   1510  fa26							; (in the $FABB fill) which ripples it up and awards the EXTRA LIFE.
   1511  fa26							; SIZE PIN: routine runs exactly 40 bytes (UpdateLaserSound's pad target follows).
   1512  fa26				   AddScore
   1513  fa26		       f8		      sed
   1514  fa27		       18		      clc
   1515  fa28		       65 f5		      adc	ScoreTe
   1516  fa2a		       85 f5		      sta	ScoreTe
   1517  fa2c		       90 03		      bcc	.ASdone	; the common case: no carry out of tens/ones
   1518  fa2e		       4c 76 fa 	      jmp	AddScoreCarry	; D is still set here, C = 1
   1519  fa31				   .ASdone
   1520  fa31		       d8		      cld
   1521  fa32		       4c f8 fb 	      jmp	ReturnPad
   1522  fa35		       ea ea ea ea*	      .ds	AddScore + 40 - *, $EA	; byte-pin (see SIZE PIN above)
   1523  fa4e
   1524  fa4e							; UpdateLaserSound — low "zoom" tone on channel 0 while fire is held.
   1525  fa4e							; Call order in bank0 overscan: UpdateBombSound, UpdateJetSound, this — so
   1526  fa4e							; AUDV0 is already forced to 0 by UpdateBombSound when BombSnd = 0, which is
   1527  fa4e							; exactly what silence-on-release needs (this routine then does nothing).
   1528  fa4e							; Bomb events own ch0 (BombSnd > 0 -> skip) so blip/explosion stay audible.
   1529  fa4e							; Pitch sweeps AUDF 4..14 on the free-running frame clock: AUDC=2 divides by
   1530  fa4e							; 15, so f = 31400/((AUDF+1)*15) = 419..140 Hz (low). Triangle, 8 steps x
   1531  fa4e							; 8 frames = 1.07 s per cycle, no audible wrap jump.
   1532  fa4e							; Clobbers A/X; Y preserved. No ZP writes.
   1533  fa4e				   UpdateLaserSound
   1534  fa4e		       a5 f1		      lda	BombSnd
   1535  fa50		       d0 19		      bne	.ULSOut	; bomb event owns channel 0
   1536  fa52		       a5 c0		      lda	LaserState
   1537  fa54		       10 15		      bpl	.ULSOut	; fire released -> ch0 stays silent
   1538  fa56		       a5 c2		      lda	EnemyRamP
   1539  fa58		       4a		      lsr
   1540  fa59		       4a		      lsr
   1541  fa5a		       4a		      lsr		; /8 frames per sweep step
   1542  fa5b		       29 07		      and	#7
   1543  fa5d		       aa		      tax
   1544  fa5e		       bd 6e fa 	      lda	LaserFreqTable,X
   1545  fa61		       85 17		      sta	AUDF0
   1546  fa63		       a9 02		      lda	#LASER_AUD_C
   1547  fa65		       85 15		      sta	AUDC0
   1548  fa67		       a9 09		      lda	#LASER_AUD_V
   1549  fa69		       85 19		      sta	AUDV0
   1550  fa6b				   .ULSOut
   1551  fa6b		       4c f8 fb 	      jmp	ReturnPad
   1552  fa6e
   1553  fa6e				   LaserFreqTable
   1554  fa6e		       04 07 0a 0c*	      .byte.b	4,7,10,12,14,12,10,7
   1555  fa76
   1556  fa76							; (PairGone RETIRED, plan 5.1b 2026-10-20: the cell punch guards a repeat
   1557  fa76							;  blast on the PF buffer itself — the punched cell pair is empty, so a
   1558  fa76							;  second blast in the same room cannot score again. No rect idx4, no mask.)
   1559  fa76
   1560  fa76							; ========================================================================
   1561  fa76							; AddScoreCarry — the rare path of AddScore (>= 100 points carried out of ScoreTe).
   1562  fa76							; Entered with D=1 and C=1. Ripples the carry through ScoreHu and ScoreTh; a
   1563  fa76							; carry INTO ScoreTh is a 10,000-point crossing, and ScoreTh's low digit
   1564  fa76							; (ten-thousands) is then 0 or 5 exactly on a 50,000 / 100,000 mark — that is
   1565  fa76							; the EXTRA LIFE (user 2026-10-27: every 50,000, max MAX_LIVES = 8). A carry out
   1566  fa76							; of ScoreTh means 999,999 + more: the score sticks at 999,999. Runs once per
   1567  fa76							; 100 points at most, and each 10,000 crossing happens once, so no life can be
   1568  fa76							; awarded twice for the same mark. Tested by tools/test_addscore.py.
   1569  fa76				   AddScoreCarry
   1570  fa76		       a5 f4		      lda	ScoreHu
   1571  fa78		       69 00		      adc	#0	; + the carry (BCD)
   1572  fa7a		       85 f4		      sta	ScoreHu
   1573  fa7c		       90 18		      bcc	.ASCdone	; no 10,000 crossing
   1574  fa7e		       a5 f3		      lda	ScoreTh
   1575  fa80		       69 00		      adc	#0	; + the carry (BCD)
   1576  fa82		       b0 16		      bcs	.ASCcap	; past 999,999
   1577  fa84		       85 f3		      sta	ScoreTh
   1578  fa86		       29 0f		      and	#$0F	; ten-thousands digit
   1579  fa88		       f0 04		      beq	.ASClife	; x0,000 : 100,000 / 200,000 ...
   1580  fa8a		       c9 05		      cmp	#5
   1581  fa8c		       d0 08		      bne	.ASCdone	; only x5,000... i.e. 50,000 / 150,000 ...
   1582  fa8e				   .ASClife
   1583  fa8e		       a5 ac		      lda	PlayerLives
   1584  fa90		       c9 08		      cmp	#MAX_LIVES
   1585  fa92		       b0 02		      bcs	.ASCdone
   1586  fa94		       e6 ac		      inc	PlayerLives
   1587  fa96				   .ASCdone
   1588  fa96		       d8		      cld
   1589  fa97		       4c f8 fb 	      jmp	ReturnPad
   1590  fa9a				   .ASCcap
   1591  fa9a		       a9 99		      lda	#$99
   1592  fa9c		       85 f3		      sta	ScoreTh
   1593  fa9e		       85 f4		      sta	ScoreHu
   1594  faa0		       85 f5		      sta	ScoreTe
   1595  faa2		       d0 f2		      bne	.ASCdone	; A = $99, always taken
