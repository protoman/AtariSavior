------- FILE bank2.asm
    123  f000
    124  f000							; --- 5-byte stub ---
    125  f000		       a9 00		      lda	#0
    126  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    127  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    128  f008
    129  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    130  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    131  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    132  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    133  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    134  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    135  f008							; = Origin Reverse.
    136  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    137  f010				   EnterRoomB2
    138  f010		       85 98		      sta	RoomNo
    139  f012		       0a		      asl
    140  f013		       a8		      tay		; Y = room * 2 (C3: ONE word per room)
    141  f014		       a5 9f		      lda	LevelPFDataLo
    142  f016		       85 e5		      sta	FetchPtr
    143  f018		       a5 a0		      lda	LevelPFDataHi
    144  f01a		       85 e6		      sta	FetchPtr+1
    145  f01c		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: rects ptr lo
    146  f01e		       85 90		      sta	RoomRectsLo
    147  f020		       c8		      iny
    148  f021		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    149  f023		       85 91		      sta	RoomRectsHi
    150  f025							; TilePF0 is no longer stored per room: bank3's block reader derives it
    151  f025							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    152  f025
    153  f025							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    154  f025							;     live in BANK3 (the level-data bank). One tail-jump into the block
    155  f025							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    156  f025							;     0 pushes (the room-load chain sits at the measured SP floor).
    157  f025		       4c 50 f4 	      jmp	ERBlocksPad
    158  f028				   ERBlocksDone
    159  f028
    160  f028							; --- enemy record for this room (C2 2026-10-20, packed 1 B 2026-10-20) ---
    161  f028							; byte = count<<6 | first record index<<1 | bottom-band flag.
    162  f028							; RoomEnemies = level base + 4n, enemy records = level base + 5n
    163  f028							; (2026-10-20: the enemy record is ONE byte/room now)
    164  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    165  f028							; The band COLOR is the global BAND_COLOR (one water color per game).
    166  f028		       a5 98		      lda	RoomNo
    167  f02a		       a8		      tay		; Y = room (one byte per record)
    168  f02b		       a5 9f		      lda	LevelPFDataLo
    169  f02d		       18		      clc
    170  f02e		       65 a1		      adc	LevelRoomN
    171  f030		       65 a1		      adc	LevelRoomN
    172  f032		       65 a1		      adc	LevelRoomN
    173  f034		       65 a1		      adc	LevelRoomN	; base + 4n = RoomEnemies
    174  f036		       85 e5		      sta	FetchPtr
    175  f038		       a5 a0		      lda	LevelPFDataHi
    176  f03a		       69 00		      adc	#0
    177  f03c		       85 e6		      sta	FetchPtr+1
    178  f03e		       b1 e5		      lda	(FetchPtr),Y
    179  f040		       4a		      lsr
    180  f041		       4a		      lsr
    181  f042		       4a		      lsr
    182  f043		       4a		      lsr
    183  f044		       4a		      lsr
    184  f045		       4a		      lsr		; count = b7-6
    185  f046		       85 b3		      sta	EnemyCount
    186  f048		       a5 e5		      lda	FetchPtr
    187  f04a		       18		      clc
    188  f04b		       65 a1		      adc	LevelRoomN	; base + 5n = enemy records (1 B/room)
    189  f04d		       85 b1		      sta	EnemyDataLo
    190  f04f		       a5 e6		      lda	FetchPtr+1
    191  f051		       69 00		      adc	#0
    192  f053		       85 b2		      sta	EnemyDataHi
    193  f055		       b1 e5		      lda	(FetchPtr),Y
    194  f057		       4a		      lsr		; first record index → b4-0 (was b5-1)
    195  f058		       29 1f		      and	#$1F
    196  f05a		       0a		      asl
    197  f05b		       0a		      asl		; *4 (index <= 31 → fits one byte)
    198  f05c		       18		      clc
    199  f05d		       65 b1		      adc	EnemyDataLo
    200  f05f		       85 b1		      sta	EnemyDataLo
    201  f061		       a5 b2		      lda	EnemyDataHi
    202  f063		       69 00		      adc	#0
    203  f065		       85 b2		      sta	EnemyDataHi
    204  f067		       b1 e5		      lda	(FetchPtr),Y	; raw record: b0 = bottom-band flag
    205  f069		       29 01		      and	#$01
    206  f06b		       f0 02		      beq	.EBnoBand
    207  f06d		       a9 80		      lda	#BAND_COLOR
    208  f06f				   .EBnoBand
    209  f06f		       85 bc		      sta	RoomBandColor	; SOURCE room's band on the transition frame
    210  f071		       a9 00		      lda	#0	; (also the bomb reset seed below)
    211  f073		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    212  f075
    213  f075							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    214  f075		       85 b5		      sta	BombPacked
    215  f077		       85 f7		      sta	BombTimer
    216  f079		       85 f1		      sta	BombSnd
    217  f07b		       85 19		      sta	AUDV0
    218  f07d
    219  f07d							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    220  f07d
    221  f07d							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    222  f07d		       a5 c1		      lda	EnemyRamD
    223  f07f		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    224  f081		       85 c1		      sta	EnemyRamD
    225  f083		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    226  f085		       85 c2		      sta	EnemyRamP
    227  f087		       a5 b1		      lda	EnemyDataLo
    228  f089		       85 e5		      sta	FetchPtr
    229  f08b		       a5 b2		      lda	EnemyDataHi
    230  f08d		       85 e6		      sta	FetchPtr+1
    231  f08f		       a2 00		      ldx	#0
    232  f091				   EBLER_Loop
    233  f091		       e4 b3		      cpx	EnemyCount
    234  f093		       b0 36		      bcs	EBLER_Done
    235  f095		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    236  f098		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    237  f09a		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    238  f09c		       c8		      iny		; +1 = x
    239  f09d		       b1 e5		      lda	(FetchPtr),Y
