    664  f301							; TallyEntry — level-bonus tally body (user spec 2026-10-02). Entered from
    665  f301							; bank0's TallyTramp ($FFE6) via jsr; tail-jmps ReturnPad ($FBF8) so A (and
    666  f301							; Z) survive back to the bank0 caller.
    667  f301							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    668  f301							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    669  f301							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    670  f301							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    671  f301							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    672  f301							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    673  f301							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    674  f301							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    675  f301							; Pinned $F313 (org $F9D9 below: level data pins the overflow = build fails).
    676  f301							; Was $F310 → $F313 (Phase 4 walk-head; kernel TallyEntry EQU moves with
    677  f301							; it — both jmp operands are symbolic). The LWC M1 tip test (2026-10-08)
    678  f301							; funds itself by moving ColOff/ColMask past this pin (see their comment).
    679  f301							; ------------------------------------------------------------------------------
    680  f301		       00 00 00 00*	      .ds	$F313 - *, 0
    681  f313				   TallyEntry
    682  f313		       a5 8a		      lda	DropTarget
    683  f315		       f0 36		      beq	.TEArm
    684  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    685  f319		       d0 2d		      bne	.TEIdle
    686  f31b		       a9 04		      lda	#4
    687  f31d		       85 ad		      sta	TickCounter
    688  f31f		       c6 f2		      dec	TallyTicks
    689  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    690  f323		       a5 f2		      lda	TallyTicks
    691  f325		       29 03		      and	#3
    692  f327		       d0 15		      bne	.TEOne	; tick only
    693  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    694  f32b		       85 f1		      sta	BombSnd
    695  f32d		       a9 04		      lda	#4
    696  f32f		       85 15		      sta	AUDC0	; square
    697  f331		       a9 18		      lda	#24
    698  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    699  f335		       a9 08		      lda	#8
    700  f337		       85 19		      sta	AUDV0
    701  f339		       a9 03		      lda	#3	; tick + coin
    702  f33b		       4c f8 fb 	      jmp	ReturnPad
    703  f33e				   .TEOne
    704  f33e		       a9 01		      lda	#1	; tick only
    705  f340		       4c f8 fb 	      jmp	ReturnPad
    706  f343				   .TEFinal
    707  f343		       a9 07		      lda	#7	; tick + coin + done
    708  f345		       4c f8 fb 	      jmp	ReturnPad
    709  f348				   .TEIdle
    710  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    711  f34a		       4c f8 fb 	      jmp	ReturnPad
    712  f34d				   .TEArm
