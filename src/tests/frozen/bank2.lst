------- FILE generated/levels_equ.asm LEVEL 2 PASS 2
      0  f000					      include	"generated/levels_equ.asm"	; BAND_COLOR (0 bytes of ROM)
      1  f000							; Generated by convert_level.py --levels. Do not edit by hand.
      2  f000							; One bottom-band color for the whole game: the room record keeps only
      3  f000							; the per-room FLAG (convert_level rejects a second
      4  f000							; color — extend the format first if that is ever needed).
      5  f000		       00 80	   BAND_COLOR =	$80
------- FILE bank2.asm
    175  f000
    176  f000							; --- 5-byte stub ---
    177  f000		       a9 00		      lda	#0
    178  f002		       8d f4 1f 	      sta	$1FF4	; select bank0
    179  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    180  f008
    181  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    182  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF6 / jmp $F010).
    183  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    184  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    185  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    186  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    187  f008							; = Origin Reverse.
    188  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    189  f010				   EnterRoomB2
    190  f010		       85 98		      sta	RoomNo
    191  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    192  f013		       a5 9f		      lda	LevelPFDataLo
    193  f015		       85 e5		      sta	FetchPtr
    194  f017		       a5 a0		      lda	LevelPFDataHi
    195  f019		       85 e6		      sta	FetchPtr+1
    196  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b6-0 | band b7
    197  f01d		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    198  f01f							;   SHAPE ADDRESS TABLE lives in that bank,
    199  f01f							;   so bank2 needs no bank3 label). Loader
    200  f01f							;   scratch: overwritten with MetaA later.
    201  f01f		       85 88		      sta	Temp
    202  f021							; band flag b7 → RoomBandColor (staged BEFORE the block reader — the
    203  f021							; reader never writes it, and this is the only writer in the game).
    204  f021							; LAYOUT 8 (2026-10-24): the index is 7 bits and the band flag moved to b7;
    205  f021							; the owns-extras bit is GONE (a room has a record iff its counts byte
    206  f021							; carries a nonzero extras ordinal, which is exactly what ExtrasLoad
    207  f021							; indexes with — b7 was redundant).
    208  f021		       a5 88		      lda	Temp
    209  f023		       29 80		      and	#$80
    210  f025		       f0 02		      beq	.EBnoBand
    211  f027		       a9 80		      lda	#BAND_COLOR
    212  f029				   .EBnoBand
    213  f029		       85 bc		      sta	RoomBandColor
    214  f02b							; TilePF0 is no longer stored per room: bank3's block reader derives it
    215  f02b							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    216  f02b
    217  f02b							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    218  f02b							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    219  f02b							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    220  f02b							; (records stay contiguous in room order), so the old packed index byte
    221  f02b							; and its 31-record/level cap are gone. The band COLOR is the global
    222  f02b							; BAND_COLOR (one water color per game).
    223  f02b							; LevelConnSpare is free here: it only carries the exit-scan target, and
    224  f02b							; that scan has already returned when EnterRoomB2 is entered.
    225  f02b		       a5 98		      lda	RoomNo
    226  f02d		       a8		      tay		; Y = room (one byte per record)
    227  f02e							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    228  f02e							; low byte loses the first carry (the second `adc n` consumes it) and the
    229  f02e							; high byte then misses that carry — level 14 of a 20-level stage read its
    230  f02e							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    231  f02e		       a5 a1		      lda	LevelRoomN
    232  f030		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    233  f031		       18		      clc
    234  f032		       65 9f		      adc	LevelPFDataLo
    235  f034		       85 e5		      sta	FetchPtr
    236  f036		       a5 a0		      lda	LevelPFDataHi
    237  f038		       69 00		      adc	#0
    238  f03a		       85 e6		      sta	FetchPtr+1
    239  f03c		       b1 e5		      lda	(FetchPtr),Y
    240  f03e		       4a		      lsr
    241  f03f		       4a		      lsr
    242  f040		       4a		      lsr
    243  f041		       4a		      lsr
    244  f042		       4a		      lsr
    245  f043		       4a		      lsr		; count = b7-6
    246  f044		       85 b3		      sta	EnemyCount
    247  f046		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    248  f048		       a0 00		      ldy	#0
    249  f04a		       a9 00		      lda	#0
    250  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    251  f04e				   .EBSumLoop
    252  f04e		       c4 88		      cpy	Temp
    253  f050		       f0 11		      beq	.EBSumDone
    254  f052		       b1 e5		      lda	(FetchPtr),Y
    255  f054		       4a		      lsr
    256  f055		       4a		      lsr
    257  f056		       4a		      lsr
    258  f057		       4a		      lsr
    259  f058		       4a		      lsr
    260  f059		       4a		      lsr		; each earlier room's count (0..3)
    261  f05a		       18		      clc
    262  f05b		       65 a2		      adc	LevelConnSpare
    263  f05d		       85 a2		      sta	LevelConnSpare
    264  f05f		       c8		      iny
    265  f060		       4c 4e f0 	      jmp	.EBSumLoop
    266  f063				   .EBSumDone
    267  f063		       a5 e5		      lda	FetchPtr
    268  f065		       18		      clc
    269  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    270  f068		       85 b1		      sta	EnemyDataLo
    271  f06a		       a5 e6		      lda	FetchPtr+1
    272  f06c		       69 00		      adc	#0
    273  f06e		       85 b2		      sta	EnemyDataHi
    274  f070		       a5 a2		      lda	LevelConnSpare
    275  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    276  f073		       18		      clc
    277  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    278  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    279  f078		       85 b1		      sta	EnemyDataLo
    280  f07a		       a5 b2		      lda	EnemyDataHi
    281  f07c		       69 00		      adc	#0
    282  f07e		       85 b2		      sta	EnemyDataHi
    283  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    284  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    285  f084
    286  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    287  f084		       85 b5		      sta	BombPacked
    288  f086		       85 f7		      sta	BombTimer
    289  f088		       85 f1		      sta	BombSnd
    290  f08a		       85 19		      sta	AUDV0
    291  f08c
    292  f08c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    293  f08c
    294  f08c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    295  f08c		       a5 c1		      lda	EnemyRamD
    296  f08e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    297  f090		       85 c1		      sta	EnemyRamD
    298  f092		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    299  f094		       85 c2		      sta	EnemyRamP
    300  f096		       a5 b1		      lda	EnemyDataLo
    301  f098		       85 e5		      sta	FetchPtr
    302  f09a		       a5 b2		      lda	EnemyDataHi
    303  f09c		       85 e6		      sta	FetchPtr+1
    304  f09e		       a2 00		      ldx	#0
    305  f0a0				   EBLER_Loop
