    123  f000
    124  f000							; --- 5-byte stub ---
    125  f000		       a9 00		      lda	#0
    126  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    127  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    128  f008
    129  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    130  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    131  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    132  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    133  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    134  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    135  f008							; = Origin Reverse.
    136  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    137  f010				   EnterRoomB2
    138  f010		       85 98		      sta	RoomNo
    139  f012		       0a		      asl
    140  f013		       0a		      asl
    141  f014		       a8		      tay		; Y = room * 4
    142  f015		       a5 9f		      lda	LevelPFDataLo
    143  f017		       85 e5		      sta	FetchPtr
    144  f019		       a5 a0		      lda	LevelPFDataHi
    145  f01b		       85 e6		      sta	FetchPtr+1
    146  f01d		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: PF0 ptr lo
    147  f01f		       85 99		      sta	RoomPF0Lo
    148  f021		       c8		      iny
    149  f022		       b1 e5		      lda	(FetchPtr),Y	; PF0 ptr hi
    150  f024		       85 9a		      sta	RoomPF0Hi
    151  f026		       c8		      iny
    152  f027		       b1 e5		      lda	(FetchPtr),Y	; rects ptr lo
    153  f029		       85 90		      sta	RoomRectsLo
    154  f02b		       c8		      iny
    155  f02c		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    156  f02e		       85 91		      sta	RoomRectsHi
    157  f030
    158  f030							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    159  f030							;     live in BANK3 (the level-data bank). One tail-jump into the block
    160  f030							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    161  f030							;     0 pushes (the room-load chain sits at the measured SP floor).
    162  f030		       4c 50 f4 	      jmp	ERBlocksPad
    163  f033				   ERBlocksDone
    164  f033
    165  f033							; --- enemy record for this room (4 bytes: ptr_lo, ptr_hi, count, band) ---
    166  f033		       a5 98		      lda	RoomNo
    167  f035		       0a		      asl
    168  f036		       0a		      asl
    169  f037		       a8		      tay
    170  f038		       a5 af		      lda	LevelEnemyLo
    171  f03a		       85 e5		      sta	FetchPtr
    172  f03c		       a5 b0		      lda	LevelEnemyHi
    173  f03e		       85 e6		      sta	FetchPtr+1
    174  f040		       b1 e5		      lda	(FetchPtr),Y
    175  f042		       a2 00		      ldx	#0	; EnemyDataLo/Hi/Count are contiguous
    176  f044				   .EBrec
    177  f044		       95 b1		      sta	EnemyDataLo,X	; $B1/$B2/$B3 (record bytes 0-2)
    178  f046		       c8		      iny
    179  f047		       e8		      inx
    180  f048		       b1 e5		      lda	(FetchPtr),Y
    181  f04a		       e0 03		      cpx	#3
    182  f04c		       d0 f6		      bne	.EBrec
    183  f04e		       85 bc		      sta	RoomBandColor	; SOURCE room's band on the transition frame
    184  f050		       a9 00		      lda	#0	; (also the bomb reset seed below)
    185  f052		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    186  f054
    187  f054							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    188  f054		       85 b5		      sta	BombPacked
    189  f056		       85 f7		      sta	BombTimer
    190  f058		       85 f1		      sta	BombSnd
    191  f05a		       85 19		      sta	AUDV0
    192  f05c
    193  f05c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    194  f05c
    195  f05c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    196  f05c		       a5 c1		      lda	EnemyRamD
    197  f05e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    198  f060		       85 c1		      sta	EnemyRamD
    199  f062		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    200  f064		       85 c2		      sta	EnemyRamP
    201  f066		       a5 b1		      lda	EnemyDataLo
    202  f068		       85 e5		      sta	FetchPtr
    203  f06a		       a5 b2		      lda	EnemyDataHi
    204  f06c		       85 e6		      sta	FetchPtr+1
    205  f06e		       a2 00		      ldx	#0
    206  f070				   EBLER_Loop
    207  f070		       e4 b3		      cpx	EnemyCount
    208  f072		       b0 36		      bcs	EBLER_Done
    209  f074		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    210  f077		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    211  f079		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    212  f07b		       c8		      iny		; +1 = x
    213  f07c		       b1 e5		      lda	(FetchPtr),Y
    214  f07e		       95 bd		      sta	EnemyRamX,X
    215  f080		       c8		      iny		; +2 = y
    216  f081		       b1 e5		      lda	(FetchPtr),Y
    217  f083		       95 e2		      sta	EnemyRamY,X
    218  f085		       c8		      iny		; +3 = dir ($FF = left)
    219  f086		       b1 e5		      lda	(FetchPtr),Y
    220  f088		       a4 88		      ldy	Temp	; record type
    221  f08a		       c0 02		      cpy	#SNAKE
    222  f08c		       d0 02		      bne	EBLER_Dir
    223  f08e		       49 ff		      eor	#$FF	; SNAKE: the authored dir = where it will
    224  f090							; come OUT, so invert the live bit — the
    225  f090							; first move must be the retreat into its
    226  f090							; wall (user 2026-10-19). Nothing else
    227  f090							; reads the ROM dir: the patrol bounds are
    228  f090							; spawn ± SNAKE_PATROL.
    229  f090				   EBLER_Dir
    230  f090		       a8		      tay		; Y = dir, re-setting N from A (the cpy
    231  f091							; above clobbered the flags `bmi` needs;
    232  f091							; Y is reloaded at the loop top)
    233  f091		       30 0a		      bmi	EBLER_Left
    234  f093		       bd 55 ff 	      lda	EnemyBitTable,X	; face right → set bit
    235  f096		       05 c1		      ora	EnemyRamD
    236  f098		       85 c1		      sta	EnemyRamD
    237  f09a		       4c a6 f0 	      jmp	EBLER_Next
    238  f09d				   EBLER_Left
    239  f09d		       bd 55 ff 	      lda	EnemyBitTable,X	; face left → clear bit
    240  f0a0		       49 ff		      eor	#$FF
    241  f0a2		       25 c1		      and	EnemyRamD
    242  f0a4		       85 c1		      sta	EnemyRamD
    243  f0a6				   EBLER_Next
    244  f0a6		       e8		      inx
    245  f0a7		       4c 70 f0 	      jmp	EBLER_Loop
    246  f0aa				   EBLER_Done
    247  f0aa		       4c f8 fb 	      jmp	ReturnPad	; sta $1FF6 / rts — back to bank0 caller
    248  f0ad
    249  f0ad							; --- E4 moth body (bank2 free space $F008-$F9D8) -------------------------
    250  f0ad							; Entered from bank0 via the $FEF0 entry tramp (sta $1FF8 lands on the
    251  f0ad							; jmp below at $FEF3). Exits via `jmp MothExitPad` ($FC49): bank2 runs
    252  f0ad							; sta $1FF6, bank0 serves jmp UE_Next. Rules:
    253  f0ad							;   - NEVER jsr FoldIndirect or any bank0 routine (a fold from inside
    254  f0ad							;     bank2 would switch away mid-routine = frozen player).
    255  f0ad							;   - Enemy records ARE here (org $F9D9) — read directly, no fold needed.
    256  f0ad							;   - Keep the whole routine inline (no jsr): tramps are tail jmps so
    257  f0ad							;     the stack depth equals the UE body (+0 vs the $F8 guard).
