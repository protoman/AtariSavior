    278  f0ad		       a2 00		      ldx	#0
    279  f0af				   EBLER_Loop
    280  f0af		       e4 b3		      cpx	EnemyCount
    281  f0b1		       b0 36		      bcs	EBLER_Done
    282  f0b3		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    283  f0b6		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    284  f0b8		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    285  f0ba		       c8		      iny		; +1 = x
    286  f0bb		       b1 e5		      lda	(FetchPtr),Y
    287  f0bd		       95 bd		      sta	EnemyRamX,X
    288  f0bf		       c8		      iny		; +2 = y
    289  f0c0		       b1 e5		      lda	(FetchPtr),Y
