    283  f0b5		       05 c1		      ora	EnemyRamD
    284  f0b7		       85 c1		      sta	EnemyRamD
    285  f0b9		       4c c5 f0 	      jmp	EBLER_Next
    286  f0bc				   EBLER_Left
