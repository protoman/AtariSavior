    133  f008
    134  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    135  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    136  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    137  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    138  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    139  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    140  f008							; = Origin Reverse.
    141  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    142  f010				   EnterRoomB2
    143  f010		       85 98		      sta	RoomNo
    144  f012		       0a		      asl
    145  f013		       0a		      asl
    146  f014		       a8		      tay		; Y = room * 4
    147  f015		       a5 9f		      lda	LevelPFDataLo
    148  f017		       85 e5		      sta	FetchPtr
    149  f019		       a5 a0		      lda	LevelPFDataHi
    150  f01b		       85 e6		      sta	FetchPtr+1
    151  f01d		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: PF0 ptr lo
    152  f01f		       85 99		      sta	RoomPF0Lo
    153  f021		       c8		      iny
    154  f022		       b1 e5		      lda	(FetchPtr),Y	; PF0 ptr hi
    155  f024		       85 9a		      sta	RoomPF0Hi
    156  f026		       c8		      iny
    157  f027		       b1 e5		      lda	(FetchPtr),Y	; rects ptr lo
    158  f029		       85 90		      sta	RoomRectsLo
    159  f02b		       c8		      iny
    160  f02c		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    161  f02e		       85 91		      sta	RoomRectsHi
    162  f030
    163  f030							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    164  f030							;     live in BANK3 (the level-data bank). One tail-jump into the block
    165  f030							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    166  f030							;     0 pushes (the room-load chain sits at the measured SP floor).
    167  f030		       4c 50 f4 	      jmp	ERBlocksPad
    168  f033				   ERBlocksDone
    169  f033
    170  f033							; --- enemy record for this room (4 bytes: ptr_lo, ptr_hi, count, band) ---
    171  f033		       a5 98		      lda	RoomNo
    172  f035		       0a		      asl
    173  f036		       0a		      asl
    174  f037		       a8		      tay
    175  f038		       a5 af		      lda	LevelEnemyLo
    176  f03a		       85 e5		      sta	FetchPtr
    177  f03c		       a5 b0		      lda	LevelEnemyHi
    178  f03e		       85 e6		      sta	FetchPtr+1
    179  f040		       b1 e5		      lda	(FetchPtr),Y
    180  f042		       a2 00		      ldx	#0	; EnemyDataLo/Hi/Count are contiguous
    181  f044				   .EBrec
    182  f044		       95 b1		      sta	EnemyDataLo,X	; $B1/$B2/$B3 (record bytes 0-2)
    183  f046		       c8		      iny
    184  f047		       e8		      inx
    185  f048		       b1 e5		      lda	(FetchPtr),Y
    186  f04a		       e0 03		      cpx	#3
    187  f04c		       d0 f6		      bne	.EBrec
    188  f04e		       85 bc		      sta	RoomBandColor	; SOURCE room's band on the transition frame
    189  f050		       a9 00		      lda	#0	; (also the bomb reset seed below)
    190  f052		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    191  f054
