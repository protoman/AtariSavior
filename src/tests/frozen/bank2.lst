    192  f05c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    193  f05c
    194  f05c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    195  f05c		       a5 c1		      lda	EnemyRamD
    196  f05e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    197  f060		       85 c1		      sta	EnemyRamD
    198  f062		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    199  f064		       85 c2		      sta	EnemyRamP
    200  f066		       a5 b1		      lda	EnemyDataLo
    201  f068		       85 e5		      sta	FetchPtr
    202  f06a		       a5 b2		      lda	EnemyDataHi
    203  f06c		       85 e6		      sta	FetchPtr+1
    204  f06e		       a2 00		      ldx	#0
    205  f070				   EBLER_Loop
    206  f070		       e4 b3		      cpx	EnemyCount
    207  f072		       b0 36		      bcs	EBLER_Done
    208  f074		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    209  f077		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    210  f079		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    211  f07b		       c8		      iny		; +1 = x
    212  f07c		       b1 e5		      lda	(FetchPtr),Y
    213  f07e		       95 bd		      sta	EnemyRamX,X
    214  f080		       c8		      iny		; +2 = y
    215  f081		       b1 e5		      lda	(FetchPtr),Y
    216  f083		       95 e2		      sta	EnemyRamY,X
    217  f085		       c8		      iny		; +3 = dir ($FF = left)
    218  f086		       b1 e5		      lda	(FetchPtr),Y
    219  f088		       a4 88		      ldy	Temp	; record type
    220  f08a		       c0 02		      cpy	#SNAKE
    221  f08c		       d0 02		      bne	EBLER_Dir
    222  f08e		       49 ff		      eor	#$FF	; SNAKE: the authored dir = where it will
    223  f090							; come OUT, so invert the live bit — the
    224  f090							; first move must be the retreat into its
    225  f090							; wall (user 2026-10-19). Nothing else
    226  f090							; reads the ROM dir: the patrol bounds are
    227  f090							; spawn ± SNAKE_PATROL.
    228  f090				   EBLER_Dir
    229  f090		       a8		      tay		; Y = dir, re-setting N from A (the cpy
    230  f091							; above clobbered the flags `bmi` needs;
    231  f091							; Y is reloaded at the loop top)
    232  f091		       30 0a		      bmi	EBLER_Left
    233  f093		       bd 55 ff 	      lda	EnemyBitTable,X	; face right → set bit
    234  f096		       05 c1		      ora	EnemyRamD
    235  f098		       85 c1		      sta	EnemyRamD
    236  f09a		       4c a6 f0 	      jmp	EBLER_Next
    237  f09d				   EBLER_Left
    238  f09d		       bd 55 ff 	      lda	EnemyBitTable,X	; face left → clear bit
    239  f0a0		       49 ff		      eor	#$FF
    240  f0a2		       25 c1		      and	EnemyRamD
    241  f0a4		       85 c1		      sta	EnemyRamD
    242  f0a6				   EBLER_Next
    243  f0a6		       e8		      inx
    244  f0a7		       4c 70 f0 	      jmp	EBLER_Loop
    245  f0aa				   EBLER_Done
    246  f0aa		       4c f8 fb 	      jmp	ReturnPad	; sta $1FF6 / rts — back to bank0 caller
    247  f0ad
    248  f0ad							; --- E4 moth body (bank2 free space $F008-$F9D8) -------------------------
    249  f0ad							; Entered from bank0 via the $FEF0 entry tramp (sta $1FF8 lands on the
    250  f0ad							; jmp below at $FEF3). Exits via `jmp MothExitPad` ($FC49): bank2 runs
    251  f0ad							; sta $1FF6, bank0 serves jmp UE_Next. Rules:
    252  f0ad							;   - NEVER jsr FoldIndirect or any bank0 routine (a fold from inside
    253  f0ad							;     bank2 would switch away mid-routine = frozen player).
    254  f0ad							;   - Enemy records ARE here (org $F9D9) — read directly, no fold needed.
    255  f0ad							;   - Keep the whole routine inline (no jsr): tramps are tail jmps so
