------- FILE bank2.asm
    148  f000
    149  f000							; --- 5-byte stub ---
    150  f000		       a9 00		      lda	#0
    151  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    152  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    153  f008
    154  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    155  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    156  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    157  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    158  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    159  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    160  f008							; = Origin Reverse.
    161  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    162  f010				   EnterRoomB2
    163  f010		       85 98		      sta	RoomNo
    164  f012		       0a		      asl
    165  f013		       a8		      tay		; Y = room * 2 (C3: ONE word per room)
    166  f014		       a5 9f		      lda	LevelPFDataLo
    167  f016		       85 e5		      sta	FetchPtr
    168  f018		       a5 a0		      lda	LevelPFDataHi
    169  f01a		       85 e6		      sta	FetchPtr+1
    170  f01c		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: rects ptr lo
    171  f01e		       85 90		      sta	RoomRectsLo
    172  f020		       c8		      iny
    173  f021		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    174  f023		       85 91		      sta	RoomRectsHi
    175  f025							; TilePF0 is no longer stored per room: bank3's block reader derives it
    176  f025							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    177  f025
    178  f025							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    179  f025							;     live in BANK3 (the level-data bank). One tail-jump into the block
    180  f025							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    181  f025							;     0 pushes (the room-load chain sits at the measured SP floor).
    182  f025		       4c 50 f4 	      jmp	ERBlocksPad
    183  f028				   ERBlocksDone
    184  f028
    185  f028							; --- enemy record for this room (C2 2026-10-20, packed 1 B 2026-10-20) ---
    186  f028							; byte = count<<6 | first record index<<1 | bottom-band flag.
    187  f028							; RoomEnemies = level base + 4n, enemy records = level base + 5n
    188  f028							; (2026-10-20: the enemy record is ONE byte/room now)
    189  f028							; (n = LevelRoomN; the record index replaces the old absolute pointer).
    190  f028							; The band COLOR is the global BAND_COLOR (one water color per game).
    191  f028		       a5 98		      lda	RoomNo
    192  f02a		       a8		      tay		; Y = room (one byte per record)
    193  f02b		       a5 9f		      lda	LevelPFDataLo
    194  f02d		       18		      clc
    195  f02e		       65 a1		      adc	LevelRoomN
    196  f030		       65 a1		      adc	LevelRoomN
    197  f032		       65 a1		      adc	LevelRoomN
    198  f034		       65 a1		      adc	LevelRoomN	; base + 4n = RoomEnemies
    199  f036		       85 e5		      sta	FetchPtr
    200  f038		       a5 a0		      lda	LevelPFDataHi
    201  f03a		       69 00		      adc	#0
    202  f03c		       85 e6		      sta	FetchPtr+1
    203  f03e		       b1 e5		      lda	(FetchPtr),Y
    204  f040		       4a		      lsr
    205  f041		       4a		      lsr
    206  f042		       4a		      lsr
    207  f043		       4a		      lsr
    208  f044		       4a		      lsr
    209  f045		       4a		      lsr		; count = b7-6
    210  f046		       85 b3		      sta	EnemyCount
    211  f048		       a5 e5		      lda	FetchPtr
    212  f04a		       18		      clc
    213  f04b		       65 a1		      adc	LevelRoomN	; base + 5n = enemy records (1 B/room)
    214  f04d		       85 b1		      sta	EnemyDataLo
    215  f04f		       a5 e6		      lda	FetchPtr+1
    216  f051		       69 00		      adc	#0
    217  f053		       85 b2		      sta	EnemyDataHi
    218  f055		       b1 e5		      lda	(FetchPtr),Y
    219  f057		       4a		      lsr		; first record index → b4-0 (was b5-1)
    220  f058		       29 1f		      and	#$1F
    221  f05a		       0a		      asl
    222  f05b		       0a		      asl		; *4 (index <= 31 → fits one byte)
    223  f05c		       18		      clc
    224  f05d		       65 b1		      adc	EnemyDataLo
    225  f05f		       85 b1		      sta	EnemyDataLo
    226  f061		       a5 b2		      lda	EnemyDataHi
    227  f063		       69 00		      adc	#0
    228  f065		       85 b2		      sta	EnemyDataHi
    229  f067		       b1 e5		      lda	(FetchPtr),Y	; raw record: b0 = bottom-band flag
    230  f069		       29 01		      and	#$01
    231  f06b		       f0 02		      beq	.EBnoBand
    232  f06d		       a9 80		      lda	#BAND_COLOR
    233  f06f				   .EBnoBand
