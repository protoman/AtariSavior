    856  f4d1		       85 07		      sta	COLUP1
    857  f4d3		       4c 94 f5 	      jmp	.SODone	; ObjTop from ActiveObjectY
    858  f4d6				   .SOCount
    859  f4d6							; Count objects: enemies + miner if in miner's room (Temp = count; VBLANK-safe)
    860  f4d6		       a5 b3		      lda	EnemyCount
    861  f4d8		       85 88		      sta	Temp
    862  f4da		       a5 a4		      lda	LevelMinerRoom
    863  f4dc		       29 7f		      and	#$7f
