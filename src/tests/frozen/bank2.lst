   2113  fd3c							; --- Phase 4: pack collision overlay byte → CollisionEndY ($8F) ---
   2114  fd3c							; b4-b7 = right_col+1, b0-2 = ball band mask, b3 = M1 present
   2115  fd3c							; (staged $8E != 0), 0 = symmetric. Cave never
   2116  fd3c							; writes $8F; bank1 HUD entry copies it to LineCount ($84 — cave .Row
   2117  fd3c							; clobbers it) before overscan PHM reads. BallX in Temp stays raw (the
   2118  fd3c							; kernel's ball block reads it later this VBL).
   2119  fd3c							; b3 seeds BEFORE the Temp=0 early-out so an M1-ONLY room still packs
   2120  fd3c							; nonzero (kernel OverlayTramp gates on LineCount != 0 — no M1 cross
   2121  fd3c							; otherwise).
   2122  fd3c		       a5 8e		      lda	CollisionEndX	; staged M1X (kill-gated above)
   2123  fd3e		       f0 02		      beq	.M1nof	; 0 = no M1 → seed 0 (A is 0)
   2124  fd40		       a9 08		      lda	#$08	; b3 = M1 present
