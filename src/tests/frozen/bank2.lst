    650  f301							; TallyEntry — level-bonus tally body (user spec 2026-10-02). Entered from
    651  f301							; bank0's TallyTramp ($FFE6) via jsr; tail-jmps ReturnPad ($FBF8) so A (and
    652  f301							; Z) survive back to the bank0 caller.
    653  f301							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    654  f301							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    655  f301							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    656  f301							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    657  f301							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    658  f301							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    659  f301							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    660  f301							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    661  f301							; Pinned $F313 (org $F9D9 below: level data pins the overflow = build fails).
    662  f301							; Was $F310 → $F313 (Phase 4 walk-head; kernel TallyEntry EQU moves with
    663  f301							; it — both jmp operands are symbolic). The LWC M1 tip test (2026-10-08)
    664  f301							; funds itself by moving ColOff/ColMask past this pin (see their comment).
    665  f301							; ------------------------------------------------------------------------------
    666  f301		       00 00 00 00*	      .ds	$F313 - *, 0
    667  f313				   TallyEntry
    668  f313		       a5 8a		      lda	DropTarget
    669  f315		       f0 36		      beq	.TEArm
    670  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    671  f319		       d0 2d		      bne	.TEIdle
    672  f31b		       a9 04		      lda	#4
    673  f31d		       85 ad		      sta	TickCounter
    674  f31f		       c6 f2		      dec	TallyTicks
    675  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    676  f323		       a5 f2		      lda	TallyTicks
    677  f325		       29 03		      and	#3
    678  f327		       d0 15		      bne	.TEOne	; tick only
    679  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    680  f32b		       85 f1		      sta	BombSnd
    681  f32d		       a9 04		      lda	#4
    682  f32f		       85 15		      sta	AUDC0	; square
    683  f331		       a9 18		      lda	#24
    684  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    685  f335		       a9 08		      lda	#8
    686  f337		       85 19		      sta	AUDV0
    687  f339		       a9 03		      lda	#3	; tick + coin
    688  f33b		       4c f8 fb 	      jmp	ReturnPad
    689  f33e				   .TEOne
    690  f33e		       a9 01		      lda	#1	; tick only
    691  f340		       4c f8 fb 	      jmp	ReturnPad
    692  f343				   .TEFinal
    693  f343		       a9 07		      lda	#7	; tick + coin + done
    694  f345		       4c f8 fb 	      jmp	ReturnPad
    695  f348				   .TEIdle
    696  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    697  f34a		       4c f8 fb 	      jmp	ReturnPad
    698  f34d				   .TEArm
