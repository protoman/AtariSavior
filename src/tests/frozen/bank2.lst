    737  f35e				   .TEDivSum
    738  f35e		       8a		      txa
    739  f35f		       18		      clc
    740  f360		       69 14		      adc	#20	; miner reach = 1000 pts
    741  f362		       65 f0		      adc	PlayerBombs	; + 50 per unspent bomb (chain carry ok)
    742  f364		       85 f2		      sta	TallyTicks
    743  f366		       a5 ac		      lda	PlayerLives
    744  f368		       0a		      asl		; + 100 per life = 2 ticks
    745  f369		       18		      clc
