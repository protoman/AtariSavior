------- FILE bank2.asm
   1422  f864		       00 00 00 00*	      .ds	$F880 - *, 0
   1423  f880							; TallySum — the level-bonus total for TallyEntry (frozen-scene frame).
   1424  f880							; Split OUT of the inline TallyEntry region (it ends at a hard org) into bank2's
   1425  f880							; free slack before the $F970 pin. IN: X = time ticks (0..20). OUT: TallyTicks
   1426  f880							; set; A clobbered, X/Y kept. The bomb count MUST be masked: PlayerBombs' high
   1427  f880							; bits carry the raft's take-off ramp state (b7 flag, b6-3 level — see the
   1428  f880							; kernel EQU contract), and a stale ride would otherwise inflate the bonus.
   1429  f880							; Temp ($88) is free here: the tally frame bypasses the input (its joystick
   1430  f880							; store) and the next VBL restages Temp anyway.
   1431  f880				   TallySum
   1432  f880		       a5 f0		      lda	PlayerBombs
   1433  f882		       29 07		      and	#%00000111	; bombs only, never the ramp bits
   1434  f884		       85 88		      sta	Temp
