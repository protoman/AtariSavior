    177  f02d							; reader never writes it, and this is the only writer in the game).
    178  f02d		       a5 88		      lda	Temp
    179  f02f		       29 40		      and	#$40
    180  f031		       f0 02		      beq	.EBnoBand
    181  f033		       a9 80		      lda	#BAND_COLOR
