    985  f46b		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    986  f46d							; (vcrunch) AND b6 (hot) — b6 used to survive
    987  f46d							; and fake a 1-cell ball at x72-79 on a
    988  f46d							; hot-without-ball model
    989  f46d		       f0 0b		      beq	.SBTnoBall
    990  f46f		       0a		      asl
