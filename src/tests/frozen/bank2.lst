    965  f463							; --- BallX staging: Temp ($88) ---
    966  f463							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    967  f463							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    968  f463							; GONE (user 2026-10-12: door must look like the plain async strip;
    969  f463							; only the key/bomb semantics differ). One write per VBL is the
    970  f463							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    971  f463		       a9 35		      lda	#$35
    972  f465		       85 0a		      sta	CTRLPF
    973  f467		       a0 0a		      ldy	#10
