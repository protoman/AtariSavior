    263  f096		       a5 b1		      lda	EnemyDataLo
    264  f098		       85 e5		      sta	FetchPtr
    265  f09a		       a5 b2		      lda	EnemyDataHi
    266  f09c		       85 e6		      sta	FetchPtr+1
    267  f09e		       a2 00		      ldx	#0
    268  f0a0				   EBLER_Loop
    269  f0a0		       e4 b3		      cpx	EnemyCount
    270  f0a2		       b0 36		      bcs	EBLER_Done
    271  f0a4		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    272  f0a7		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    273  f0a9		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    274  f0ab		       c8		      iny		; +1 = x
    275  f0ac		       b1 e5		      lda	(FetchPtr),Y
    276  f0ae		       95 bd		      sta	EnemyRamX,X
    277  f0b0		       c8		      iny		; +2 = y
    278  f0b1		       b1 e5		      lda	(FetchPtr),Y
    279  f0b3		       95 e2		      sta	EnemyRamY,X
    280  f0b5		       c8		      iny		; +3 = dir ($FF = left)
    281  f0b6		       b1 e5		      lda	(FetchPtr),Y
    282  f0b8		       a4 88		      ldy	Temp	; record type
    283  f0ba		       c0 02		      cpy	#SNAKE
    284  f0bc		       d0 02		      bne	EBLER_Dir
    285  f0be		       49 ff		      eor	#$FF	; SNAKE: the authored dir = where it will
    286  f0c0							; come OUT, so invert the live bit — the
    287  f0c0							; first move must be the retreat into its
    288  f0c0							; wall (user 2026-10-19). Nothing else
    289  f0c0							; reads the ROM dir: the patrol bounds are
    290  f0c0							; spawn ± SNAKE_PATROL.
    291  f0c0				   EBLER_Dir
    292  f0c0		       a8		      tay		; Y = dir, re-setting N from A (the cpy
    293  f0c1							; above clobbered the flags `bmi` needs;
    294  f0c1							; Y is reloaded at the loop top)
    295  f0c1		       30 0a		      bmi	EBLER_Left
