    984  f473		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    985  f475							; calibrated SetObjectXPos arg (S6b: arg A
    986  f475							; draws clocks [A-7, A]; right_col c occupies
    987  f475							; [80+8c, 87+8c]). PHMOverlay recomputes this
    988  f475							; value independently (:1992) — the two MUST
    989  f475							; agree or the stripe draws beside its own
    990  f475							; collision cell (was #86 = +7px ≈ one cell
    991  f475							; right; user-spotted 2026-10-12).
