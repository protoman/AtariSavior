    228  f05a		       18		      clc
    229  f05b		       65 a2		      adc	LevelConnSpare
    230  f05d		       85 a2		      sta	LevelConnSpare
    231  f05f		       c8		      iny
    232  f060		       4c 4e f0 	      jmp	.EBSumLoop
    233  f063				   .EBSumDone
    234  f063		       a5 e5		      lda	FetchPtr
    235  f065		       18		      clc
    236  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    237  f068		       85 b1		      sta	EnemyDataLo
    238  f06a		       a5 e6		      lda	FetchPtr+1
    239  f06c		       69 00		      adc	#0
    240  f06e		       85 b2		      sta	EnemyDataHi
    241  f070		       a5 a2		      lda	LevelConnSpare
    242  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    243  f073		       18		      clc
    244  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    245  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    246  f078		       85 b1		      sta	EnemyDataLo
    247  f07a		       a5 b2		      lda	EnemyDataHi
    248  f07c		       69 00		      adc	#0
    249  f07e		       85 b2		      sta	EnemyDataHi
    250  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    251  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    252  f084
    253  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    254  f084		       85 b5		      sta	BombPacked
    255  f086		       85 f7		      sta	BombTimer
    256  f088		       85 f1		      sta	BombSnd
    257  f08a		       85 19		      sta	AUDV0
