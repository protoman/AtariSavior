   2125  fd4b		       4a		      lsr		;   87+8*ball_col) → <<4 lands it in b4-b7
   2126  fd4c		       4a		      lsr		;   with ONE sbc (was sbc #87 + adc #$10)
   2127  fd4d		       4a		      lsr
   2128  fd4e		       0a		      asl
   2129  fd4f		       0a		      asl
   2130  fd50		       0a		      asl
   2131  fd51		       0a		      asl
