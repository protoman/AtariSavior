    694  f307							; TallyEntry — level-bonus tally body (user spec 2026-10-02). Entered from
    695  f307							; bank0's TallyTramp ($FFE6) via jsr; tail-jmps ReturnPad ($FBF8) so A (and
    696  f307							; Z) survive back to the bank0 caller.
    697  f307							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    698  f307							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    699  f307							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    700  f307							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    701  f307							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    702  f307							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    703  f307							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    704  f307							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    705  f307							; Pinned $F313 (org $F9D9 below: level data pins the overflow = build fails).
    706  f307							; Was $F310 → $F313 (Phase 4 walk-head; kernel TallyEntry EQU moves with
    707  f307							; it — both jmp operands are symbolic). The LWC M1 tip test (2026-10-08)
    708  f307							; funds itself by moving ColOff/ColMask past this pin (see their comment).
    709  f307							; ------------------------------------------------------------------------------
    710  f307		       00 00 00 00*	      .ds	$F313 - *, 0
    711  f313				   TallyEntry
    712  f313		       a5 8a		      lda	DropTarget
    713  f315		       f0 36		      beq	.TEArm
    714  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    715  f319		       d0 2d		      bne	.TEIdle
    716  f31b		       a9 04		      lda	#4
    717  f31d		       85 ad		      sta	TickCounter
    718  f31f		       c6 f2		      dec	TallyTicks
    719  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    720  f323		       a5 f2		      lda	TallyTicks
    721  f325		       29 03		      and	#3
    722  f327		       d0 15		      bne	.TEOne	; tick only
    723  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    724  f32b		       85 f1		      sta	BombSnd
    725  f32d		       a9 04		      lda	#4
    726  f32f		       85 15		      sta	AUDC0	; square
    727  f331		       a9 18		      lda	#24
    728  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    729  f335		       a9 08		      lda	#8
    730  f337		       85 19		      sta	AUDV0
    731  f339		       a9 03		      lda	#3	; tick + coin
    732  f33b		       4c f8 fb 	      jmp	ReturnPad
    733  f33e				   .TEOne
    734  f33e		       a9 01		      lda	#1	; tick only
    735  f340		       4c f8 fb 	      jmp	ReturnPad
    736  f343				   .TEFinal
    737  f343		       a9 07		      lda	#7	; tick + coin + done
    738  f345		       4c f8 fb 	      jmp	ReturnPad
    739  f348				   .TEIdle
    740  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    741  f34a		       4c f8 fb 	      jmp	ReturnPad
    742  f34d				   .TEArm
    743  f34d		       a5 ae		      lda	BarLevel
    744  f34f		       18		      clc
    745  f350		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    746  f352		       a2 00		      ldx	#0
