    969  f459		       a5 ba		      lda	EnemyDeadMask
    970  f45b		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    971  f45d		       f0 04		      beq	.M1stage
    972  f45f		       a9 00		      lda	#0
    973  f461		       85 8e		      sta	CollisionEndX
