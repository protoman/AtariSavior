    712  f34f							; ------------------------------------------------------------------------------
    713  f34f							; TallyAward — score += 50 * TallyTicks in ONE BCD step (TallyEntry arm).
    714  f34f							; 50*N = 100*(N/2) + 50*(N&1): the odd half adds $50 to ScoreTe (packed
    715  f34f							; tens/ones) and its decimal carry bumps the hundreds count; the hundreds
    716  f34f							; count then goes to ScoreHu with a binary normalize (carry -> ScoreTh).
    717  f34f							; Saturates at $9999 exactly like AddScore. Clobbers A/X/Temp; Y kept.
    718  f34f							; Temp ($88) is free here (same window as TallySum).
    719  f34f							; ------------------------------------------------------------------------------
    720  f34f				   TallyAward
    721  f34f		       a5 f2		      lda	TallyTicks
    722  f351		       4a		      lsr		; A = N/2 hundreds, C = odd (extra 50)
    723  f352		       85 88		      sta	Temp
    724  f354		       a5 f5		      lda	ScoreTe
    725  f356		       90 09		      bcc	.TAHund	; even: no tens addend
    726  f358		       f8		      sed
    727  f359		       18		      clc
    728  f35a		       69 50		      adc	#$50
    729  f35c		       d8		      cld
    730  f35d		       90 02		      bcc	.TAHund	; tens digit did not overflow
    731  f35f		       e6 88		      inc	Temp	; 50 crossed into the hundreds digit
    732  f361				   .TAHund
    733  f361		       85 f5		      sta	ScoreTe
    734  f363		       a5 f4		      lda	ScoreHu
    735  f365		       18		      clc
    736  f366		       65 88		      adc	Temp	; binary 0..34
    737  f368		       a2 00		      ldx	#0
    738  f36a				   .TANorm
    739  f36a		       c9 0a		      cmp	#10
    740  f36c		       90 05		      bcc	.TAHuOk
    741  f36e		       e9 0a		      sbc	#10
    742  f370		       e8		      inx
    743  f371		       b0 f7		      bcs	.TANorm
    744  f373				   .TAHuOk
    745  f373		       85 f4		      sta	ScoreHu
    746  f375		       8a		      txa
    747  f376		       f0 14		      beq	.TADone
    748  f378		       18		      clc
    749  f379		       65 f3		      adc	ScoreTh
    750  f37b		       c9 0a		      cmp	#10
    751  f37d		       90 0b		      bcc	.TAThOk
    752  f37f		       a9 09		      lda	#9	; $9999 cap (AddScore's saturation)
    753  f381		       85 f3		      sta	ScoreTh
    754  f383		       85 f4		      sta	ScoreHu
