   1480  fb7a		       4a		      lsr
   1481  fb7b		       4a		      lsr
   1482  fb7c		       4a		      lsr
   1483  fb7d		       4a		      lsr		; s = P>>4
   1484  fb7e		       c9 04		      cmp	#4
   1485  fb80		       b0 04		      bcs	.hcNd
   1486  fb82		       a9 00		      lda	#0	; s0-3 dwell: eff 0
   1487  fb84		       f0 11		      beq	.hcOut	; (always)
   1488  fb86				   .hcNd
