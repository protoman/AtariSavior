    254  f095		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    255  f098		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    256  f09a		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
