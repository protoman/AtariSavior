   1368  f82d							; HUD squares (2026-10-26): QUAD-size players, one pattern bit = 4 px, so squares
   1369  f82d							; on every other bit sit 8 px apart. SquarePat[n] = n squares from the left
   1370  f82d							; (lives 0..4 per player, P0 then P1 = up to 8; bombs 0..5; the 5th bomb is missile 0). MinerPat[mask] = the
   1371  f82d							; miners still to rescue (LevelStartRoom b6-4 popcount) packed to the RIGHT end
   1372  f82d							; of the 32 px sprite (P1 at X 128), so the row reads right aligned.
   1373  f82d				   SquarePat
   1374  f82d		       00 80 a0 a8*	      .byte.b	$00,$80,$A0,$A8,$AA,$AA,$AA,$AA,$AA	; [4..8] P0 stays full for lives 5-8
