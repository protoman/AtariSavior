    138  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    139  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    140  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    141  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    142  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    143  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    144  f008							; = Origin Reverse.
    145  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    146  f010				   EnterRoomB2
    147  f010		       85 98		      sta	RoomNo
    148  f012		       0a		      asl
    149  f013		       0a		      asl
    150  f014		       a8		      tay		; Y = room * 4
    151  f015		       a5 9f		      lda	LevelPFDataLo
    152  f017		       85 e5		      sta	FetchPtr
    153  f019		       a5 a0		      lda	LevelPFDataHi
    154  f01b		       85 e6		      sta	FetchPtr+1
    155  f01d		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: PF0 ptr lo
    156  f01f		       85 99		      sta	RoomPF0Lo
    157  f021		       c8		      iny
    158  f022		       b1 e5		      lda	(FetchPtr),Y	; PF0 ptr hi
    159  f024		       85 9a		      sta	RoomPF0Hi
    160  f026		       c8		      iny
