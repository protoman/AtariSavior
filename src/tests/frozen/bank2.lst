    898  f632							; bit3, phases 2/3/5/7 static A, phases 0/1/8 jet flutter), REFP0 =
    899  f632							; PlayerDir<<3 (bit3 = mirror, kernel.asm:602), FooterPtr1 = bomb state (draw rows), COLUP1 = fuse color or
    900  f632							; COLUBK = explosion blink color (same (60-BombTimer)&3 table as the game's
    901  f632							; BombBlinkColors). Band tail restores COLUBK/REFP0 before the footer.
    902  f632							; Clobbers A/X/Y; rts (same-bank — NOT a fold; stack +2 during the call).
    903  f632							; ------------------------------------------------------------------------------
    904  f632							; ==============================================================================
