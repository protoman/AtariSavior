   1449  f88c		       85 f2		      sta	TallyTicks
   1450  f88e		       a5 ac		      lda	PlayerLives
   1451  f890		       0a		      asl		; + 100 per life = 2 ticks
   1452  f891		       18		      clc
   1453  f892		       65 f2		      adc	TallyTicks
   1454  f894		       85 f2		      sta	TallyTicks
