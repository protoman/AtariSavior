   1926  fc89		       20 4f fc 	      jsr	ExitScanB2
   1927  fc8c		       b0 1c		      bcs	ExitNoneB2	; nobody there: stay here
   1928  fc8e		       e0 02		      cpx	#2
   1929  fc90		       90 08		      bcc	.EDvertical
   1930  fc92		       bc a6 fc 	      ldy	ExitEdgeTab,X	; left/right: enter at the opposite X edge
   1931  fc95		       84 80		      sty	RoomX
   1932  fc97		       4c 10 f0 	      jmp	EnterRoomB2
   1933  fc9a				   .EDvertical
   1934  fc9a		       bc a6 fc 	      ldy	ExitEdgeTab,X	; up/down: enter at the opposite Y edge
   1935  fc9d		       84 81		      sty	RoomY
