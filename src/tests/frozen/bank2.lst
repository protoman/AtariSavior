    142  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    143  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    144  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    145  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    146  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    147  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    148  f008							; = Origin Reverse.
    149  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    150  f010				   EnterRoomB2
    151  f010		       85 98		      sta	RoomNo
    152  f012		       0a		      asl
    153  f013		       0a		      asl
    154  f014		       a8		      tay		; Y = room * 4
    155  f015		       a5 9f		      lda	LevelPFDataLo
    156  f017		       85 e5		      sta	FetchPtr
    157  f019		       a5 a0		      lda	LevelPFDataHi
    158  f01b		       85 e6		      sta	FetchPtr+1
    159  f01d		       b1 e5		      lda	(FetchPtr),Y	; RoomDataTable: PF0 ptr lo
    160  f01f		       85 99		      sta	RoomPF0Lo
    161  f021		       c8		      iny
    162  f022		       b1 e5		      lda	(FetchPtr),Y	; PF0 ptr hi
    163  f024		       85 9a		      sta	RoomPF0Hi
    164  f026		       c8		      iny
    165  f027		       b1 e5		      lda	(FetchPtr),Y	; rects ptr lo
    166  f029		       85 90		      sta	RoomRectsLo
    167  f02b		       c8		      iny
    168  f02c		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    169  f02e		       85 91		      sta	RoomRectsHi
    170  f030
    171  f030							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    172  f030							;     live in BANK3 (the level-data bank). One tail-jump into the block
    173  f030							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    174  f030							;     0 pushes (the room-load chain sits at the measured SP floor).
    175  f030		       4c 50 f4 	      jmp	ERBlocksPad
    176  f033				   ERBlocksDone
    177  f033
    178  f033							; --- enemy record for this room (4 bytes: ptr_lo, ptr_hi, count, band) ---
    179  f033		       a5 98		      lda	RoomNo
    180  f035		       0a		      asl
    181  f036		       0a		      asl
    182  f037		       a8		      tay
    183  f038		       a5 af		      lda	LevelEnemyLo
    184  f03a		       85 e5		      sta	FetchPtr
    185  f03c		       a5 b0		      lda	LevelEnemyHi
