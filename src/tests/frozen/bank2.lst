------- FILE bank2.asm
------- FILE banks.inc LEVEL 2 PASS 3
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; NEW ROM bank selectors by ROLE (docs/agents/banks.md, Layout v3). BKI_x = the physical bank of role x.
      3  10000 ????						; The new ROM is built from newrom/ (tools/build_newrom.sh); this file shadows src/banks.inc there.
      4  10000 ????						; ==============================================================================
      5  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      6  10000 ????		00 01	    BKI_CAVE   =	1	; the generated gameplay cave kernel (+ its prologue)
      7  10000 ????		00 02	    BKI_HUD    =	2	; HUD, title, level select
      8  10000 ????		00 03	    BKI_GAMEPLAY =	3	; raft, bomb wall marks, strip blast, stage band, colour build
      9  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     10  10000 ????		00 04	    BKI_TRANS  =	4	; version header, blank transition frame, attract script
     11  10000 ????		00 04	    BKI_MODELS =	4	; room models: shape step + shape blocks / row pool
     12  10000 ????		00 04	    BKI_OVERLAY =	4	; asym-patch collision overlay cluster (placed when bank 4 is filled)
     13  10000 ????		00 05	    BKI_EXTRAS =	5	; extras walkers + extras data of all 32 levels
     14  10000 ????		00 06	    BKI_ROOMS  =	6	; room bank A: room code + room data
     15  10000 ????		00 07	    BKI_ROOMS_B =	7	; room bank B: same code, the levels past LEVEL_SPLIT
     16  10000 ????		00 03	    BKI_PROLOGUE =	3	; cave kernel start-up code (does not fit in the cave bank: 2 KB tables + 1.7 KB code)
     17  10000 ????
     18  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  10000 ????		1f f5	    BK_CAVE    =	$1FF4 + BKI_CAVE
     20  10000 ????		1f f6	    BK_HUD     =	$1FF4 + BKI_HUD
     21  10000 ????		1f f7	    BK_GAMEPLAY =	$1FF4 + BKI_GAMEPLAY
     22  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     23  10000 ????		1f f8	    BK_TRANS   =	$1FF4 + BKI_TRANS
     24  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
     25  10000 ????		1f f8	    BK_OVERLAY =	$1FF4 + BKI_OVERLAY
     26  10000 ????		1f f9	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     27  10000 ????		1f fa	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     28  10000 ????		1f fb	    BK_ROOMS_B =	$1FF4 + BKI_ROOMS_B
     29  10000 ????		1f f7	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
------- FILE bank2.asm
      4  10000 ????						; ==============================================================================
      5  10000 ????						; NEW ROM bank 2 — HUD rendering + 6-digit score (F6 bankswitch, $F000-$FFFF)
      6  10000 ????						; ==============================================================================
      7  10000 ????						; Follows HERO/comparison pattern exactly:
      8  10000 ????						; - GRP0/GRP1 for indicator sprites (lives, bombs)
      9  10000 ????						; - 48-pixel sprite technique for score (NUSIZ copies + VDELP cross-buffer)
     10  10000 ????						; - SetObjectXPos for precise positioning
     11  10000 ????						; - Returns via fold-pad at $FC70
     12  10000 ????
     13  10000 ????		00 01	    VBLANK     =	$01
     14  10000 ????		00 02	    WSYNC      =	$02
     15  10000 ????		00 04	    NUSIZ0     =	$04
     16  10000 ????		00 05	    NUSIZ1     =	$05
     17  10000 ????		00 06	    COLUP0     =	$06
     18  10000 ????		00 07	    COLUP1     =	$07
     19  10000 ????		00 08	    COLUPF     =	$08
     20  10000 ????		00 09	    COLUBK     =	$09
     21  10000 ????		00 ac	    PlayerLives =	$AC
     22  10000 ????		00 f0	    PlayerBombs =	$F0
     23  10000 ????		00 a7	    LevelStartRoom =	$A7	; b7 = KeyHeld (bank0 owns it; read-only here)
     24  10000 ????		00 ae	    BarLevel   =	$AE
     25  10000 ????		00 9b	    BarIdx     =	$9B	; (BarLevel+7)>>3, synced by kernel overscan (D2)
     26  10000 ????		00 78	    BAR_MAX    =	120	; full bar (60 frames/step × 120 = 120s)
     27  10000 ????		00 08	    COLUPF     =	$08
     28  10000 ????		00 09	    COLUBK     =	$09
     29  10000 ????		00 0d	    PF0        =	$0D
     30  10000 ????		00 0e	    PF1        =	$0E
     31  10000 ????		00 0f	    PF2        =	$0F
     32  10000 ????		00 10	    RESP0      =	$10
     33  10000 ????		00 11	    RESP1      =	$11
     34  10000 ????		00 1b	    GRP0       =	$1B
     35  10000 ????		00 1c	    GRP1       =	$1C
