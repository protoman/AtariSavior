   1940  fcad							; ------------------------------------------------------------------------------
   1941  fcad							; BuildColupF + HotOverlapBody moved to bank3 (A3 2026-10-19 — they walk the
   1942  fcad							; level-data record stream, which now lives there). The space below is fill;
   1943  fcad							; BombEnemyBlastBody stays PINNED at its original address so the bank0/bank2
   1944  fcad							; blast-tramp literals ($FDD8 twins) need no resync.
   1945  fcad							; ------------------------------------------------------------------------------
   1946  fcad							; ------------------------------------------------------------------
   1947  fcad							; C2 (2026-10-20): B3StageBand + M1OffTab (was bank3 $FC38-$FCF2).
   1948  fcad							; Called from BCFDarkRun (`jmp B3StageBand`) and bank1's HUD fold; ends
   1949  fcad							; `jmp ReturnPad`. ZP/TIA only — no level-data read.
   1950  fcad							; ------------------------------------------------------------------
   1951  fcad		       00 00 00 00*	      .ds	$FCB8 - *, 0
   1952  fcb8				   B3StageBand
   1953  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1954  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1955  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1956  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1957  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1958  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1959  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1960  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1961  fcb8							; the pack uses $8F).
   1962  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1963  fcba		       29 01		      and	#$01
   1964  fcbc		       aa		      tax
   1965  fcbd		       bd 71 fd 	      lda	M1OffTab,X
   1966  fcc0		       85 92		      sta	RectCount
   1967  fcc2		       a5 99		      lda	RoomMetaA	; MetaA
   1968  fcc4		       4a		      lsr		; band0 bit -> carry
   1969  fcc5		       a9 00		      lda	#0
   1970  fcc7		       2a		      rol
   1971  fcc8		       f0 02		      beq	.SBTb0z
   1972  fcca		       a9 ff		      lda	#$ff
   1973  fccc				   .SBTb0z
   1974  fccc		       85 ed		      sta	BandTab
   1975  fcce		       a5 99		      lda	RoomMetaA
   1976  fcd0		       4a		      lsr
   1977  fcd1		       4a		      lsr		; band1 bit -> carry
   1978  fcd2		       a9 00		      lda	#0
   1979  fcd4		       2a		      rol
   1980  fcd5		       f0 02		      beq	.SBTb1z
   1981  fcd7		       a9 ff		      lda	#$ff
   1982  fcd9				   .SBTb1z
   1983  fcd9		       85 ee		      sta	BandTab+1
   1984  fcdb		       a5 99		      lda	RoomMetaA
   1985  fcdd		       4a		      lsr
   1986  fcde		       4a		      lsr
   1987  fcdf		       4a		      lsr		; band2 bit -> carry
   1988  fce0		       a9 00		      lda	#0
   1989  fce2		       2a		      rol
   1990  fce3		       f0 02		      beq	.SBTb2z
   1991  fce5		       a9 ff		      lda	#$ff
   1992  fce7				   .SBTb2z
   1993  fce7		       85 ef		      sta	BandTab+2
   1994  fce9							; --- strip destroyed by a bomb? (EnemyDeadMask b3 — StripBlastCheck
   1995  fce9							; set it this overscan) → blank all band gates so the cave renders no
   1996  fce9							; strip; the pack below then emits mask 0 → every overlay stays
   1997  fce9							; transparent too. BandTab restages from ROM next room entry. ---
   1998  fce9		       a5 ba		      lda	EnemyDeadMask
   1999  fceb		       29 08		      and	#$08
   2000  fced		       f0 08		      beq	.SBTstripAlive
   2001  fcef		       a9 00		      lda	#0
