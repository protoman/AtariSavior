   1904  fc6d		       a2 02		      ldx	#2
   1905  fc6f		       4c 74 fc 	      jmp	ExitDirB2
   1906  fc72				   ExitRightB2
   1907  fc72		       a2 03		      ldx	#3	; (falls through: last stub)
   1908  fc74				   ExitDirB2
   1909  fc74		       a5 9f		      lda	LevelPFDataLo
   1910  fc76		       18		      clc
   1911  fc77		       65 a1		      adc	LevelRoomN
