   1300  f7b7		       b1 ea		      lda	(scorePtr6),Y	; 5c — pre-load LAST digit (digit 6)
   1301  f7b9		       aa		      tax		; 2c — cache in X
   1302  f7ba		       85 02		      sta	WSYNC	; 3c
   1303  f7bc		       b1 e0		      lda	(scorePtr1),Y	; 5c — load digit 1
   1304  f7be		       8d 1b 00 	      sta.w	GRP0	; 4c — digit 1 -> GRP0A buffer
   1305  f7c1		       b1 e2		      lda	(scorePtr2),Y	; 5c — load digit 2
   1306  f7c3		       85 1c		      sta	GRP1	; 3c — digit 2 -> GRP1A, digit 1 live on P0c1
   1307  f7c5		       b1 e4		      lda	(scorePtr3),Y	; 5c — load digit 3
   1308  f7c7		       85 1b		      sta	GRP0	; 3c — digit 3 -> GRP0A, digit 2 live on P1c1
   1309  f7c9		       b1 e6		      lda	(scorePtr4),Y	; 5c — load digit 4
   1310  f7cb		       85 ed		      sta	<scbrdTmp	; 3c — cache digit 4
   1311  f7cd		       b1 e8		      lda	(scorePtr5),Y	; 5c — load digit 5
   1312  f7cf		       a4 ed		      ldy	<scbrdTmp	; 3c — Y = digit 4
   1313  f7d1		       84 1c		      sty	GRP1	; 3c — digit 4 -> GRP1A, digit 3 live on P0c2
   1314  f7d3		       85 1b		      sta	GRP0	; 3c — digit 5 -> GRP0A, digit 4 live on P1c2
   1315  f7d5		       86 1c		      stx	GRP1	; 3c — digit 6 -> GRP1A, digit 5 live on P0c3
   1316  f7d7		       86 1b		      stx	GRP0	; 3c — digit 6 -> GRP0A, digit 6 live on P1c3
   1317  f7d9		       c6 ec		      dec	<scbrdCnt	; 5c
