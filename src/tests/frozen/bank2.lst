   1497  f970							; only job (P2b stager): the packed meta (TilePF0+9/+10) lives in THIS
   1498  f970							; bank's ROM — read the door flags + left-strip dcol, stage them, let
   1499  f970							; bank1 StripBlastCheck run BOTH overlap takes (the blast window is
   1500  f970							; left-half cols 0..19 and stays READ-ONLY here).
   1501  f970							; Staging contract (both scratch bytes free in this flow):
   1502  f970							;   RectCount := 2ℓ left-strip dcol, or $FF = none/door/right-bomb;
   1503  f970							;   Temp ($88 = bank1 BMWScratch) := $FF when MetaB b7 (right door)
