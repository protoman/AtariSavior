    895  f410		       a9 00		      lda	#0
    896  f412		       2a		      rol
    897  f413		       f0 02		      beq	.SBTb0z
    898  f415		       a9 ff		      lda	#$ff
    899  f417				   .SBTb0z
    900  f417		       85 ed		      sta	BandTab
    901  f419		       b1 99		      lda	(RoomPF0Lo),Y
    902  f41b		       4a		      lsr
    903  f41c		       4a		      lsr		; band1 bit -> carry
    904  f41d		       a9 00		      lda	#0
    905  f41f		       2a		      rol
