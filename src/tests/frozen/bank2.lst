   1830  fc4c							; ==============================================================================
   1831  fc4c							; Room-exit handlers — MOVED from bank0 (C3, 2026-10-20; were $F4DB-$F535 = 90 B).
   1832  fc4c							; C1 (2026-10-20): LEVEL_FORMAT 2 — there is NO connection table any more. Each
   1833  fc4c							; room owns ONE grid-position byte (x<<4|y, normalised to the level origin) at
   1834  fc4c							; level base + n (C2 2026-10-20: the 3 B record is three columns, so the
   1835  fc4c							; position column still starts one block-of-n in), and an exit is resolved by
   1836  fc4c							; stepping that byte by a direction delta ($FF up / $01 down / $F0 left /
   1837  fc4c							; $10 right) and SCANNING the level's position column for a match (<= 20
   1838  fc4c							; iterations, cold path = room load only).
   1839  fc4c							;
   1840  fc4c							; Why no boundary guard is needed: a nibble of 15 never occurs in a stored
   1841  fc4c							; position (POSITION_SPAN = 15 in convert_level.py, nibble 15 = sentinel), and
   1842  fc4c							; stepping off the grid always wraps the moved nibble to 15 — so an exit past
   1843  fc4c							; the grid edge can never match a room. The old nibble-room-index pack capped a
   1844  fc4c							; level at 15 rooms; this lifts it to 225 grid cells (20 rooms/level with room
   1845  fc4c							; to spare) at 1 B/room instead of 2.
   1846  fc4c							;
   1847  fc4c							; Entry: bank0's `jsr ExitRoomXxx` pad ($FBD9-$FBE4, `sta $1FF8`) -> the `jmp`
   1848  fc4c							; halves at $FBDC-$FBE5 above. Every exit path ends in a `jmp`:
   1849  fc4c							;   * no exit	    -> ReturnPad (bank0 `rts` pops the caller's jsr frame)
   1850  fc4c							;   * room changed -> `jmp EnterRoomB2`, whose own `jmp ReturnPad` does the same
   1851  fc4c							; The opposite-edge placement is written BEFORE EnterRoomB2 because EnterRoom
   1852  fc4c							; never reads/writes RoomX/RoomY (verified in EnterRoomB2 + B3RoomBlocks), and
   1853  fc4c							; Y is used for the constant so A keeps the ROOM INDEX EnterRoomB2 stores.
   1854  fc4c							; Guard: verify_build.check_exit_handlers.
   1855  fc4c							; ==============================================================================
   1856  fc4c		       00 00 00 	      .ds	$FC4F - *, 0
   1857  fc4f							; Scan the level's position column for the target byte.
   1858  fc4f							; In: A = target position, FetchPtr = level base + n. Out: A = room index,
   1859  fc4f							; C = 0 found / 1 none. Clobbers A/Y only (X is the caller's direction).
   1860  fc4f				   ExitScanB2
   1861  fc4f		       85 a2		      sta	LevelConnSpare
   1862  fc51		       a0 00		      ldy	#0
   1863  fc53				   .EScanLoop
   1864  fc53		       b1 e5		      lda	(FetchPtr),Y
   1865  fc55		       c5 a2		      cmp	LevelConnSpare
   1866  fc57		       f0 07		      beq	.EScanHit
   1867  fc59		       c8		      iny
   1868  fc5a		       c4 a1		      cpy	LevelRoomN
   1869  fc5c		       d0 f5		      bne	.EScanLoop
   1870  fc5e		       38		      sec		; ran off the end: no room at that position
   1871  fc5f		       60		      rts
   1872  fc60				   .EScanHit
   1873  fc60		       98		      tya		; room index
   1874  fc61		       18		      clc
   1875  fc62		       60		      rts
   1876  fc63
   1877  fc63							; Shared body: X = direction (0 up, 1 down, 2 left, 3 right).
   1878  fc63							; Stages FetchPtr = level base + n (RoomPositions, C2 2026-10-20: the room
   1879  fc63							; record is 3 B spread over three columns, so the position column still starts
   1880  fc63							; one block-of-n in), reads this room's own position, steps it by the
   1881  fc63							; direction delta and scans (no jsr for the staging: one push fewer than the
   1882  fc63							; old LevelConnB2 helper).
   1883  fc63				   ExitUpB2
   1884  fc63		       a2 00		      ldx	#0
   1885  fc65		       4c 74 fc 	      jmp	ExitDirB2
   1886  fc68				   ExitDownB2
