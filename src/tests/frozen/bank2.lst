    146  f000
    147  f000							; --- 5-byte stub ---
    148  f000		       a9 00		      lda	#0
    149  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    150  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    151  f008
    152  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    153  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    154  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    155  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    156  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    157  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    158  f008							; = Origin Reverse.
    159  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    160  f010				   EnterRoomB2
    161  f010		       85 98		      sta	RoomNo
    162  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    163  f013		       a5 9f		      lda	LevelPFDataLo
    164  f015		       85 e5		      sta	FetchPtr
    165  f017		       a5 a0		      lda	LevelPFDataHi
    166  f019		       85 e6		      sta	FetchPtr+1
    167  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b5-0 | band b6 | b7 extras
    168  f01d		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    169  f01f							;   SHAPE ADDRESS TABLE lives in that bank,
    170  f01f							;   so bank2 needs no bank3 label). Loader
    171  f01f							;   scratch: overwritten with MetaA later.
    172  f01f		       85 88		      sta	Temp
    173  f021							; band flag b6 → RoomBandColor (staged BEFORE the block reader — the
    174  f021							; reader never writes it, and this is the only writer in the game).
    175  f021		       a5 88		      lda	Temp
    176  f023		       29 40		      and	#$40
    177  f025		       f0 02		      beq	.EBnoBand
    178  f027		       a9 80		      lda	#BAND_COLOR
    179  f029				   .EBnoBand
    180  f029		       85 bc		      sta	RoomBandColor
    181  f02b							; TilePF0 is no longer stored per room: bank3's block reader derives it
    182  f02b							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    183  f02b
    184  f02b							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    185  f02b							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    186  f02b							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    187  f02b							; (records stay contiguous in room order), so the old packed index byte
    188  f02b							; and its 31-record/level cap are gone. The band COLOR is the global
    189  f02b							; BAND_COLOR (one water color per game).
    190  f02b							; LevelConnSpare is free here: it only carries the exit-scan target, and
    191  f02b							; that scan has already returned when EnterRoomB2 is entered.
    192  f02b		       a5 98		      lda	RoomNo
    193  f02d		       a8		      tay		; Y = room (one byte per record)
    194  f02e							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    195  f02e							; low byte loses the first carry (the second `adc n` consumes it) and the
    196  f02e							; high byte then misses that carry — level 14 of a 20-level stage read its
    197  f02e							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    198  f02e		       a5 a1		      lda	LevelRoomN
    199  f030		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    200  f031		       18		      clc
    201  f032		       65 9f		      adc	LevelPFDataLo
    202  f034		       85 e5		      sta	FetchPtr
    203  f036		       a5 a0		      lda	LevelPFDataHi
    204  f038		       69 00		      adc	#0
    205  f03a		       85 e6		      sta	FetchPtr+1
    206  f03c		       b1 e5		      lda	(FetchPtr),Y
    207  f03e		       4a		      lsr
    208  f03f		       4a		      lsr
    209  f040		       4a		      lsr
    210  f041		       4a		      lsr
    211  f042		       4a		      lsr
    212  f043		       4a		      lsr		; count = b7-6
    213  f044		       85 b3		      sta	EnemyCount
    214  f046		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    215  f048		       a0 00		      ldy	#0
    216  f04a		       a9 00		      lda	#0
    217  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    218  f04e				   .EBSumLoop
    219  f04e		       c4 88		      cpy	Temp
    220  f050		       f0 11		      beq	.EBSumDone
    221  f052		       b1 e5		      lda	(FetchPtr),Y
    222  f054		       4a		      lsr
    223  f055		       4a		      lsr
    224  f056		       4a		      lsr
    225  f057		       4a		      lsr
