    182  f046		       c8		      iny
    183  f047		       e8		      inx
    184  f048		       b1 e5		      lda	(FetchPtr),Y
    185  f04a		       e0 03		      cpx	#3
    186  f04c		       d0 f6		      bne	.EBrec
