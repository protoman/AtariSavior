    465  f278							; TitleSelect lives here (2026-11: sample + joystick grew it past the $F080
    466  f278							; pin; the $FC52 pad jumps by label).
    467  f278				   TitleSelect
    468  f278							; Sample = console switches merged with the joystick (title only):
    469  f278							;   b0 = RESET, b1 = SELECT and UP, b2 = DOWN, b4 = FIRE (SWCHB b2/b4 are
    470  f278							;   unused). FIRE has its own bit so RESET still starts with fire held.
    471  f278		       ad 80 02 	      lda	$0280	; SWCHA: D4 up, D5 down (0 = pressed)
    472  f27b		       29 30		      and	#%00110000
    473  f27d		       4a		      lsr
    474  f27e		       4a		      lsr
    475  f27f		       4a		      lsr		; up -> b1, down -> b2
    476  f280		       09 f9		      ora	#%11111001
    477  f282		       2d 82 02 	      and	SWCHB
    478  f285		       24 0c		      bit	$0C	; INPT4 D7 -> N (0 = fire pressed)
    479  f287		       30 02		      bmi	.TSfire
    480  f289		       29 ef		      and	#%11101111
    481  f28b				   .TSfire
    482  f28b		       aa		      tax		; X = this frame's sample
    483  f28c		       49 ff		      eor	#$FF
    484  f28e		       25 97		      and	StepsLeft	; edges: released last frame, pressed now
    485  f290		       86 97		      stx	StepsLeft	; remember the sample for next frame
    486  f292		       a8		      tay
    487  f293		       a5 85		      lda	BombY	; grace after a game over (GameStart sets it to $C4):
    488  f295		       c9 c4		      cmp	#$C4	;   keys are ignored while it counts up $C4..$FF -> 0
    489  f297		       90 05		      bcc	.TSlive	;   (a real bomb Y is < $C0, so a leftover one - after
    490  f299		       e6 85		      inc	BombY	;   a demo or SELECT - is no grace). The sample is still
    491  f29b		       4c c7 f2 	      jmp	.TSnone	;   stored: a key held through it gives no edge later
    492  f29e				   .TSlive
    493  f29e		       98		      tya
    494  f29f		       29 11		      and	#%00010001	; RESET or FIRE edge
    495  f2a1		       d0 2a		      bne	.TSstart
    496  f2a3		       98		      tya
    497  f2a4		       4a		      lsr
