    153  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    154  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    155  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    156  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    157  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    158  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    159  f008							; = Origin Reverse.
    160  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    161  f010				   EnterRoomB2
    162  f010		       85 98		      sta	RoomNo
    163  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    164  f013		       a5 9f		      lda	LevelPFDataLo
    165  f015		       85 e5		      sta	FetchPtr
    166  f017		       a5 a0		      lda	LevelPFDataHi
    167  f019		       85 e6		      sta	FetchPtr+1
    168  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b5-0 | band b6 | b7 extras
    169  f01d		       85 88		      sta	Temp
    170  f01f		       29 3f		      and	#$3F	; shape index (C2 2026-10-20)
    171  f021		       0a		      asl		; *2: LEVEL_ShapeTable is a word table
    172  f022		       aa		      tax
    173  f023		       bd 00 f7 	      lda	LEVEL_ShapeTable,X	; block address = the table entry
    174  f026		       85 90		      sta	RoomRectsLo
    175  f028		       bd 01 f7 	      lda	LEVEL_ShapeTable+1,X
    176  f02b		       85 91		      sta	RoomRectsHi
    177  f02d							; band flag b6 → RoomBandColor (staged BEFORE the block reader — the
    178  f02d							; reader never writes it, and this is the only writer in the game).
    179  f02d		       a5 88		      lda	Temp
    180  f02f		       29 40		      and	#$40
    181  f031		       f0 02		      beq	.EBnoBand
    182  f033		       a9 80		      lda	#BAND_COLOR
    183  f035				   .EBnoBand
    184  f035		       85 bc		      sta	RoomBandColor
    185  f037							; TilePF0 is no longer stored per room: bank3's block reader derives it
    186  f037							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    187  f037
    188  f037							; --- A3 (2026-10-19): the rect stream, the PF block and the room meta
    189  f037							;     live in BANK3 (the level-data bank). One tail-jump into the block
    190  f037							;     reader; it returns to ERBlocksDone with the ptrs still in ZP.
    191  f037							;     0 pushes (the room-load chain sits at the measured SP floor).
    192  f037		       4c 50 f4 	      jmp	ERBlocksPad
    193  f03a				   ERBlocksDone
    194  f03a
    195  f03a							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    196  f03a							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    197  f03a							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    198  f03a							; (records stay contiguous in room order), so the old packed index byte
    199  f03a							; and its 31-record/level cap are gone. The band COLOR is the global
    200  f03a							; BAND_COLOR (one water color per game).
    201  f03a							; LevelConnSpare is free here: it only carries the exit-scan target, and
    202  f03a							; that scan has already returned when EnterRoomB2 is entered.
    203  f03a		       a5 98		      lda	RoomNo
    204  f03c		       a8		      tay		; Y = room (one byte per record)
    205  f03d		       a5 9f		      lda	LevelPFDataLo
    206  f03f		       18		      clc
    207  f040		       65 a1		      adc	LevelRoomN
    208  f042		       65 a1		      adc	LevelRoomN	; base + 2n = RoomCounts
    209  f044		       85 e5		      sta	FetchPtr
