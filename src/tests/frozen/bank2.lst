------- FILE generated/levels_equ.asm LEVEL 2 PASS 2
      0  f000					      include	"generated/levels_equ.asm"	; BAND_COLOR (0 bytes of ROM)
      1  f000							; Generated by convert_level.py --levels. Do not edit by hand.
      2  f000							; One bottom-band color for the whole game: the room record keeps only
      3  f000							; the per-room FLAG (convert_level rejects a second
      4  f000							; color — extend the format first if that is ever needed).
      5  f000		       00 80	   BAND_COLOR =	$80
------- FILE bank2.asm
    166  f000
    167  f000							; --- 5-byte stub ---
    168  f000		       a9 00		      lda	#0
    169  f002		       8d f6 1f 	      sta	$1FF6	; select bank0
    170  f005		       4c 05 f0 	      jmp	$F005	; GameStart in bank0
    171  f008
    172  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    173  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    174  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    175  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    176  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    177  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    178  f008							; = Origin Reverse.
    179  f008		       00 00 00 00*	      .ds	$F010 - *, 0
    180  f010				   EnterRoomB2
    181  f010		       85 98		      sta	RoomNo
    182  f012		       a8		      tay		; Y = room (C2: every column is 1 B/room)
    183  f013		       a5 9f		      lda	LevelPFDataLo
    184  f015		       85 e5		      sta	FetchPtr
    185  f017		       a5 a0		      lda	LevelPFDataHi
    186  f019		       85 e6		      sta	FetchPtr+1
    187  f01b		       b1 e5		      lda	(FetchPtr),Y	; RoomShapes: idx b5-0 | band b6 | b7 extras
    188  f01d		       85 99		      sta	RoomPF0Lo	; C7: staged for bank3's B3RoomBlocks (the
    189  f01f							;   SHAPE ADDRESS TABLE lives in that bank,
    190  f01f							;   so bank2 needs no bank3 label). Loader
    191  f01f							;   scratch: overwritten with MetaA later.
    192  f01f		       85 88		      sta	Temp
    193  f021							; band flag b6 → RoomBandColor (staged BEFORE the block reader — the
    194  f021							; reader never writes it, and this is the only writer in the game).
    195  f021		       a5 88		      lda	Temp
    196  f023		       29 40		      and	#$40
    197  f025		       f0 02		      beq	.EBnoBand
    198  f027		       a9 80		      lda	#BAND_COLOR
    199  f029				   .EBnoBand
    200  f029		       85 bc		      sta	RoomBandColor
    201  f02b							; TilePF0 is no longer stored per room: bank3's block reader derives it
    202  f02b							; as rects + 2 + 2*nrect from the rect list it already copies (C3).
    203  f02b
    204  f02b							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    205  f02b							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    206  f02b							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    207  f02b							; (records stay contiguous in room order), so the old packed index byte
    208  f02b							; and its 31-record/level cap are gone. The band COLOR is the global
    209  f02b							; BAND_COLOR (one water color per game).
    210  f02b							; LevelConnSpare is free here: it only carries the exit-scan target, and
    211  f02b							; that scan has already returned when EnterRoomB2 is entered.
    212  f02b		       a5 98		      lda	RoomNo
    213  f02d		       a8		      tay		; Y = room (one byte per record)
    214  f02e							; base + 2n = RoomCounts. 2n is computed FIRST: adding n twice to the
    215  f02e							; low byte loses the first carry (the second `adc n` consumes it) and the
    216  f02e							; high byte then misses that carry — level 14 of a 20-level stage read its
    217  f02e							; counts from base+2n-0x100 and saw EnemyCount=0 (2026-10-20).
    218  f02e		       a5 a1		      lda	LevelRoomN
    219  f030		       0a		      asl		; 2n (n <= 20 rooms -> <= 40, fits a byte)
    220  f031		       18		      clc
    221  f032		       65 9f		      adc	LevelPFDataLo
    222  f034		       85 e5		      sta	FetchPtr
    223  f036		       a5 a0		      lda	LevelPFDataHi
    224  f038		       69 00		      adc	#0
    225  f03a		       85 e6		      sta	FetchPtr+1
    226  f03c		       b1 e5		      lda	(FetchPtr),Y
    227  f03e		       4a		      lsr
    228  f03f		       4a		      lsr
    229  f040		       4a		      lsr
    230  f041		       4a		      lsr
    231  f042		       4a		      lsr
    232  f043		       4a		      lsr		; count = b7-6
    233  f044		       85 b3		      sta	EnemyCount
    234  f046		       84 88		      sty	Temp	; room index (Temp free until EBLER)
    235  f048		       a0 00		      ldy	#0
    236  f04a		       a9 00		      lda	#0
    237  f04c		       85 a2		      sta	LevelConnSpare	; running first-record index
    238  f04e				   .EBSumLoop
    239  f04e		       c4 88		      cpy	Temp
    240  f050		       f0 11		      beq	.EBSumDone
    241  f052		       b1 e5		      lda	(FetchPtr),Y
    242  f054		       4a		      lsr
    243  f055		       4a		      lsr
    244  f056		       4a		      lsr
    245  f057		       4a		      lsr
    246  f058		       4a		      lsr
    247  f059		       4a		      lsr		; each earlier room's count (0..3)
    248  f05a		       18		      clc
    249  f05b		       65 a2		      adc	LevelConnSpare
    250  f05d		       85 a2		      sta	LevelConnSpare
    251  f05f		       c8		      iny
    252  f060		       4c 4e f0 	      jmp	.EBSumLoop
    253  f063				   .EBSumDone
    254  f063		       a5 e5		      lda	FetchPtr
    255  f065		       18		      clc
    256  f066		       65 a1		      adc	LevelRoomN	; base + 3n = enemy records (1 B/room)
    257  f068		       85 b1		      sta	EnemyDataLo
    258  f06a		       a5 e6		      lda	FetchPtr+1
    259  f06c		       69 00		      adc	#0
    260  f06e		       85 b2		      sta	EnemyDataHi
    261  f070		       a5 a2		      lda	LevelConnSpare
    262  f072		       0a		      asl		; 2*first (records are 3 B, 2026-10-21)
    263  f073		       18		      clc
    264  f074		       65 a2		      adc	LevelConnSpare	; 3*first; C = carry out (not dropped)
    265  f076		       65 b1		      adc	EnemyDataLo	; + record base (C saved for the high byte)
    266  f078		       85 b1		      sta	EnemyDataLo
    267  f07a		       a5 b2		      lda	EnemyDataHi
    268  f07c		       69 00		      adc	#0
    269  f07e		       85 b2		      sta	EnemyDataHi
    270  f080		       a9 00		      lda	#0	; (also the bomb reset seed below)
    271  f082		       85 ba		      sta	EnemyDeadMask	; no dead enemies in new room
    272  f084
    273  f084							; --- bomb reset: clear state/timer/sound (wall bits b3-6 die with it) ---
    274  f084		       85 b5		      sta	BombPacked
    275  f086		       85 f7		      sta	BombTimer
    276  f088		       85 f1		      sta	BombSnd
    277  f08a		       85 19		      sta	AUDV0
    278  f08c
    279  f08c							; (PF rebuild + room-meta staging moved to bank3 B3RoomBlocks — A3.)
    280  f08c
    281  f08c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    282  f08c		       a5 c1		      lda	EnemyRamD
    283  f08e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    284  f090		       85 c1		      sta	EnemyRamD
    285  f092		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    286  f094		       85 c2		      sta	EnemyRamP
    287  f096		       a5 b1		      lda	EnemyDataLo
    288  f098		       85 e5		      sta	FetchPtr
    289  f09a		       a5 b2		      lda	EnemyDataHi
    290  f09c		       85 e6		      sta	FetchPtr+1
    291  f09e		       a2 00		      ldx	#0
    292  f0a0				   EBLER_Loop
    293  f0a0		       e4 b3		      cpx	EnemyCount
    294  f0a2		       b0 3a		      bcs	EBLER_Done
    295  f0a4		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*3 record offset
    296  f0a7		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (b3-0) | dir (b7: 1 = left)
    297  f0a9		       85 88		      sta	Temp	; Temp = raw record byte (free: EnterRoom)
    298  f0ab		       c8		      iny		; +1 = x
    299  f0ac		       b1 e5		      lda	(FetchPtr),Y
    300  f0ae		       95 bd		      sta	EnemyRamX,X
    301  f0b0		       c8		      iny		; +2 = y
    302  f0b1		       b1 e5		      lda	(FetchPtr),Y
    303  f0b3		       95 e2		      sta	EnemyRamY,X
    304  f0b5		       a5 88		      lda	Temp
    305  f0b7		       29 0f		      and	#$0F	; record type
    306  f0b9		       c9 02		      cmp	#SNAKE
    307  f0bb		       d0 06		      bne	EBLER_Dir
    308  f0bd		       a5 88		      lda	Temp
    309  f0bf		       49 80		      eor	#$80	; SNAKE: the authored dir = where it will
