    188  f042		       a2 00		      ldx	#0	; EnemyDataLo/Hi/Count are contiguous
    189  f044				   .EBrec
    190  f044		       95 b1		      sta	EnemyDataLo,X	; $B1/$B2/$B3 (record bytes 0-2)
    191  f046		       c8		      iny
    192  f047		       e8		      inx
    193  f048		       b1 e5		      lda	(FetchPtr),Y
    194  f04a		       e0 03		      cpx	#3
    195  f04c		       d0 f6		      bne	.EBrec
    196  f04e		       85 bc		      sta	RoomBandColor	; SOURCE room's band on the transition frame
    197  f050		       a9 00		      lda	#0	; (also the bomb reset seed below)
