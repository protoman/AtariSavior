    783  f486							; ==============================================================================
    784  f486							; SelectActiveObject — MOVED from bank0 (C1, 2026-10-20; was $F5D5-$F6F6).
    785  f486							; Entry: bank0 VBL `jsr CallPad_SelectObject` ($FC1D `sta $1FF8`) -> the fetch
    786  f486							; at $FC20 is THIS bank's `jmp SelectActiveObject` (see the pad note at $FC20).
    787  f486							; Every exit tail-jmps ReturnPad ($FBF8 = `sta $1FF6`; bank0 serves the `rts`),
    788  f486							; so the VBL frame is popped exactly once and nothing is pushed here.
    789  f486							; ------------------------------------------------------------------------------
    790  f486							; Chosen GRP1 object for this frame; the TIA has one GRP1 sprite, so objects
    791  f486							; flicker by rotating slots. Sets ObjBase, ActiveObjectX, ActiveObjectY,
    792  f486							; ObjTop and COLUP1 (plus P1's hardware X via SetObjectXPos_b2).
    793  f486							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
    794  f486							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0 (~15 Hz);
    795  f486							; other frames normal miner/enemy rotation (FlickerFrame alone).
    796  f486							;
    797  f486							; What changed vs the bank0 body (behaviour identical):
    798  f486							;   * the enemy TYPE is a direct `lda (EnemyDataLo),Y` — the room records are
    799  f486							;     level data in THIS bank, so the FoldIndirect hop (25c, 2 switches) and
    800  f486							;     the FetchPtr staging are gone;
    801  f486							;   * the room-dark test is INLINE: bank1's IsRoomDark ends in `jmp ReturnPad`,
    802  f486							;     which would land back in bank0 and strand this frame. Same mask split and
    803  f486							;     same Z contract; tools/test_room_dark.py drives BOTH bodies and asserts
    804  f486							;     they agree for rooms 0-9 and every split bit;
    805  f486							;   * SetObjectXPos / fineAdjust / SetObjReflection / the two type tables are
    806  f486							;     local copies at $F800 (bank0 ROM is not visible from here).
    807  f486							; ==============================================================================
    808  f486					      .ds	$F486 - *, 0
    809  f486				   SelectActiveObject
    810  f486							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
    811  f486							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
    812  f486							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
    813  f486							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
    814  f486							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
    815  f486							; middle of the screen" the moment the points counting started).
    816  f486		       a5 8a		      lda	DropTarget
    817  f488		       c9 fe		      cmp	#$FE
    818  f48a		       d0 27		      bne	.SOFull
    819  f48c		       a9 00		      lda	#0
    820  f48e		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
    821  f490		       85 b6		      sta	ObjBase	; 0 = no object
    822  f492		       a5 a4		      lda	LevelMinerRoom
    823  f494		       29 7f		      and	#$7f
    824  f496		       c5 98		      cmp	RoomNo
    825  f498		       f0 03		      beq	.SOTallyMiner
    826  f49a		       4c 94 f5 	      jmp	.SODone	; miner not here -> nothing drawn
    827  f49d				   .SOTallyMiner
    828  f49d		       a9 38		      lda	#OBJ_MINER
    829  f49f		       85 b6		      sta	ObjBase
    830  f4a1		       a5 a5		      lda	MinerX
    831  f4a3		       85 b7		      sta	ActiveObjectX
    832  f4a5		       a5 a6		      lda	MinerY
    833  f4a7		       18		      clc
    834  f4a8		       69 03		      adc	#3	; same 3px offset as the normal miner path
    835  f4aa		       85 b8		      sta	ActiveObjectY
    836  f4ac		       a9 66		      lda	#$66	; purple (hue 6, luma 3)
    837  f4ae		       85 07		      sta	COLUP1
    838  f4b0		       4c 94 f5 	      jmp	.SODone
    839  f4b3				   .SOFull
    840  f4b3		       e6 b4		      inc	FlickerFrame	; advance every frame (bomb + enemy paths)
    841  f4b5							; --- Bomb fuse (state=1): 1 of 4 frames = bomb (enemies keep priority) ---
    842  f4b5		       a5 b5		      lda	BombPacked
    843  f4b7		       29 03		      and	#%00000011
    844  f4b9		       c9 01		      cmp	#1
    845  f4bb		       d0 19		      bne	.SOCount
    846  f4bd		       a5 f7		      lda	BombTimer
    847  f4bf		       29 03		      and	#3
