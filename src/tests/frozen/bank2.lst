    257  f0bf				   EBLER_Loop
    258  f0bf		       e4 b3		      cpx	EnemyCount
    259  f0c1		       b0 36		      bcs	EBLER_Done
    260  f0c3		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    261  f0c6		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
    262  f0c8		       85 88		      sta	Temp	; Temp = record type (EnterRoom: free)
    263  f0ca		       c8		      iny		; +1 = x
    264  f0cb		       b1 e5		      lda	(FetchPtr),Y
