    261  f08c							; --- LoadEnemyRam: copy each ROM enemy's x,y,dir into the RAM shadow ---
    262  f08c		       a5 c1		      lda	EnemyRamD
    263  f08e		       29 f0		      and	#$F0	; preserve RoomDarkMask bits 4-7
    264  f090		       85 c1		      sta	EnemyRamD
    265  f092		       a9 f0		      lda	#$F0	; EnemyRamP clock seed (arbitrary phase)
    266  f094		       85 c2		      sta	EnemyRamP
    267  f096		       a5 b1		      lda	EnemyDataLo
    268  f098		       85 e5		      sta	FetchPtr
    269  f09a		       a5 b2		      lda	EnemyDataHi
    270  f09c		       85 e6		      sta	FetchPtr+1
    271  f09e		       a2 00		      ldx	#0
    272  f0a0				   EBLER_Loop
    273  f0a0		       e4 b3		      cpx	EnemyCount
    274  f0a2		       b0 3a		      bcs	EBLER_Done
    275  f0a4		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*3 record offset
    276  f0a7		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (b3-0) | dir (b7: 1 = left)
    277  f0a9		       85 88		      sta	Temp	; Temp = raw record byte (free: EnterRoom)
    278  f0ab		       c8		      iny		; +1 = x
    279  f0ac		       b1 e5		      lda	(FetchPtr),Y
    280  f0ae		       95 bd		      sta	EnemyRamX,X
    281  f0b0		       c8		      iny		; +2 = y
    282  f0b1		       b1 e5		      lda	(FetchPtr),Y
    283  f0b3		       95 e2		      sta	EnemyRamY,X
    284  f0b5		       a5 88		      lda	Temp
    285  f0b7		       29 0f		      and	#$0F	; record type
    286  f0b9		       c9 02		      cmp	#SNAKE
    287  f0bb		       d0 06		      bne	EBLER_Dir
    288  f0bd		       a5 88		      lda	Temp
    289  f0bf		       49 80		      eor	#$80	; SNAKE: the authored dir = where it will
    290  f0c1							; come OUT, so invert the live bit — the
    291  f0c1							; first move must be the retreat into its
    292  f0c1							; wall (user 2026-10-19). Nothing else
    293  f0c1							; reads the ROM dir: the patrol bounds are
    294  f0c1							; spawn ± SNAKE_PATROL.
    295  f0c1		       85 88		      sta	Temp
    296  f0c3				   EBLER_Dir
    297  f0c3		       a5 88		      lda	Temp	; b7 = 1 -> left (sets N)
    298  f0c5		       30 0a		      bmi	EBLER_Left
    299  f0c7		       bd 55 ff 	      lda	EnemyBitTable,X	; face right → set bit
    300  f0ca		       05 c1		      ora	EnemyRamD
    301  f0cc		       85 c1		      sta	EnemyRamD
    302  f0ce		       4c da f0 	      jmp	EBLER_Next
    303  f0d1				   EBLER_Left
    304  f0d1		       bd 55 ff 	      lda	EnemyBitTable,X	; face left → clear bit
    305  f0d4		       49 ff		      eor	#$FF
    306  f0d6		       25 c1		      and	EnemyRamD
    307  f0d8		       85 c1		      sta	EnemyRamD
    308  f0da				   EBLER_Next
    309  f0da		       e8		      inx
    310  f0db		       4c a0 f0 	      jmp	EBLER_Loop
    311  f0de				   EBLER_Done
    312  f0de							; --- C7 (2026-10-20): the joystick-shadow refresh (Temp = SWCHA>>4)
    313  f0de							;     moved to bank3's ERLoadDone: the shape/PF/meta walkers that run
