   1899  ff0f							; Tally entry tramp slice ($FFE6-$FFEB) — byte-identical with kernel.asm's
   1900  ff0f							; copy at the same address (F6 pad rule). bank0 executes `sta $1FF5` at
   1901  ff0f							; $FFE6-$FFE8; the fetch at $FFE9 comes from THIS bank = `jmp TallyEntry`
   1902  ff0f							; ($F44F — moved here from bank2, repack chunk 3, 2026-10-20). Neither bank
   1903  ff0f							; runs its other half. $FFF2-$FFF9 stay fill (hotspot mirrors).
   1904  ff0f							; ------------------------------------------------------------------------------
   1905  ff0f							; SetupScorePointers — score digit ptrs + #18 LV001 banner (#18):
   1906  ff0f							; first frame zeroes ScoreTh/Hu/Te (Temp = $AD first-frame flag); every
   1907  ff0f							; frame points scorePtr1-6 at DigitGfx+digit*8 (right-aligned "00ThHu.."),
   1908  ff0f							; or — while LevelShowTimer > 0 — at "L V 0 tens ones _" for Level+1
   1909  ff0f							; (hundreds stays '0'; LEVEL_COUNT <= 99). Decrements LevelShowTimer
   1910  ff0f							; once per banner frame. Lives in the $FF0F fill since the 6-digit score
   1911  ff0f							; (2026-10-27) outgrew its old slot ending at $FDE3 (jsr here from MenuMain).
   1912  ff0f				   SetupScorePointers
   1913  ff0f							; --- Initialize score to 0 on first frame ---
   1914  ff0f		       a5 ad		      lda	Temp
   1915  ff11		       d0 0c		      bne	.scoreInitDone
   1916  ff13		       e6 ad		      inc	Temp
   1917  ff15		       a9 00		      lda	#0
   1918  ff17		       85 f3		      sta	ScoreTh
   1919  ff19		       85 f4		      sta	ScoreHu
   1920  ff1b		       a9 00		      lda	#$00
   1921  ff1d		       85 f5		      sta	ScoreTe
   1922  ff1f				   .scoreInitDone
   1923  ff1f
   1924  ff1f							; --- Set up 6 digit pointers ---
