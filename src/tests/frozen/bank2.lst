    922  f442							; --- D6 M1 (left-col block): M1X = 8*(m1_col+1)-1 -> CollisionEndX ($8E) ---
    923  f442							; 0 = no M1 patch. Window: this VBL write -> PositionBallM1 reads it
    924  f442							; later the same VBL (staged-file pattern like Temp/BallX). Overscan
    925  f442							; routines (PHM/LWC/blast/laser) restage their own CollisionEndX values
    926  f442							; AFTER the cave read, so the alias never crosses a frame boundary.
    927  f442							; NOT zeroed with BandTab on strip kill — M1 is a whole-cave latch and
    928  f442							; convert guarantees its cell is solid/unpatched (wall) where it must hide.
    929  f442							; M1 strip DESTROYED (EnemyDeadMask b4, StripBlastCheck's M1 twin) →
    930  f442							; stage 0: PositionBallM1 skips ENAM1, the pack's b3 flag clears, and
    931  f442							; both overlay paths (PHM/blast) treat the strip as gone next frame.
    932  f442		       a0 09		      ldy	#9
    933  f444		       b1 99		      lda	(RoomPF0Lo),Y
    934  f446		       4a		      lsr
    935  f447		       4a		      lsr
    936  f448		       4a		      lsr
    937  f449		       4a		      lsr		; m1_col+1 (0 = no M1 patch)
    938  f44a		       f0 09		      beq	.M1zero
    939  f44c		       0a		      asl
    940  f44d		       0a		      asl
    941  f44e		       0a		      asl		; *8
    942  f44f		       18		      clc
    943  f450		       65 92		      adc	RectCount	; staged offset: -1 (left, $FF) / +79 (right,$4f)
    944  f452		       4c 57 f4 	      jmp	.M1got
    945  f455				   .M1zero
    946  f455		       a9 00		      lda	#0
    947  f457				   .M1got
    948  f457		       85 8e		      sta	CollisionEndX
    949  f459		       a5 ba		      lda	EnemyDeadMask
    950  f45b		       29 10		      and	#$10	; b4 = M1 strip destroyed (room-scoped)
    951  f45d		       f0 04		      beq	.M1stage
    952  f45f		       a9 00		      lda	#0
    953  f461		       85 8e		      sta	CollisionEndX
    954  f463				   .M1stage
    955  f463							; --- BallX staging: Temp ($88) ---
    956  f463							; 0 ⇔ symmetric (kernel ball block skips; verify_build enforces).
    957  f463							; CTRLPF: constant $35 (8-clk ball) — the P2 door 4clk eor ($B5) is
    958  f463							; GONE (user 2026-10-12: door must look like the plain async strip;
    959  f463							; only the key/bomb semantics differ). One write per VBL is the
    960  f463							; cave's value (the HUD's own $05/$35 dance runs after the cave).
    961  f463		       a9 35		      lda	#$35
    962  f465		       85 0a		      sta	CTRLPF
    963  f467		       a0 0a		      ldy	#10
    964  f469		       b1 99		      lda	(RoomPF0Lo),Y	; MetaB = ball_col+1 (0 = none)
    965  f46b		       29 0f		      and	#$0F	; ball_col+1 is b0-b3 only (max 10); drops b7
    966  f46d							; (vcrunch) AND b6 (hot) — b6 used to survive
    967  f46d							; and fake a 1-cell ball at x72-79 on a
    968  f46d							; hot-without-ball model
    969  f46d		       f0 0b		      beq	.SBTnoBall
    970  f46f		       0a		      asl
    971  f470		       0a		      asl
    972  f471		       0a		      asl		; *8
    973  f472		       18		      clc
    974  f473		       69 4f		      adc	#79	; 8*(ball_col+1)+79 = 87+8*ball_col — the
    975  f475							; calibrated SetObjectXPos arg (S6b: arg A
    976  f475							; draws clocks [A-7, A]; right_col c occupies
    977  f475							; [80+8c, 87+8c]). PHMOverlay recomputes this
    978  f475							; value independently (:1992) — the two MUST
    979  f475							; agree or the stripe draws beside its own
    980  f475							; collision cell (was #86 = +7px ≈ one cell
    981  f475							; right; user-spotted 2026-10-12).
    982  f475		       85 88		      sta	Temp
    983  f477		       4c 84 f4 	      jmp	.SBTballDone
    984  f47a				   .SBTnoBall
    985  f47a		       a9 00		      lda	#0
    986  f47c		       85 88		      sta	Temp
    987  f47e							; --- No ball in this room → BE the ball gate off. ---------------------
    988  f47e							; BandTab is the per-band ENABL gate for the cave (.Row). MetaA bit0 is
    989  f47e							; the band-0 gate AND (for a door) the "M1 strip on the RIGHT half"
    990  f47e							; flag — a door has no ball, so its bit0 must NOT enable one. Before
    991  f47e							; this, the door room rendered a wall-coloured (COLUPF) ball bar over
    992  f47e							; the band-0 opening: ENABL on, RESPBL never strobed (Temp=0) → the
    993  f47e							; ball free-ran at x72-79 (user screenshot 2026-10-17, door_right.png).
    994  f47e		       85 ed		      sta	BandTab
    995  f480		       85 ee		      sta	BandTab+1
