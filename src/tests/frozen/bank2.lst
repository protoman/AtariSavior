    758  f307							;   $FF59-$FFE5  141 B  HOVFeatEntry
    759  f307							; Reserving them turns an overflow into a named pad instead of a ROM error.
    760  f307							; ------------------------------------------------------------------------------
    761  f307					      .ds	$F307 - *, 0
