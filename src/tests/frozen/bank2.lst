     50  f000							; --- power-up stub: the F6 latch powers up in an UNDEFINED bank on real
     51  f000							; hardware (Stella only randomises it with developer settings), so every
     52  f000							; bank must be able to start. This is 5 bytes on purpose: `sta $1FF4`
     53  f000							; switches to bank0, and the next fetch ($F005) then comes from BANK0,
     54  f000							; where a `jmp $F008` (GameStart) sits — the same 5-byte prefix bank2 and
     55  f000							; bank3 carry. Never shorten it to a bare `jmp`: that is what this bank had
     56  f000							; (a bank-select-less `jmp $F008` = BRK loop into zero fill).
     57  f000							; Guard: verify_build.check_boot_banks + tools/test_boot_banks.py.
     58  f000		       a9 00		      lda	#0
     59  f002		       8d f4 1f 	      sta	BK_GENERAL	; select bank0 (hotspot: the DATA is ignored)
     60  f005
     61  f005							; --- ColOff/ColMask (plan 5.1b, 2026-10-20) ---
     62  f005							; The cell punch reads PF cells directly: PF0Buf/Y with ColOff,X (row
     63  f005							; base 0/3/6) and AND ColMask,X. Same 20-entry encoding as bank2's
     64  f005							; LaserWallClamp copy (cross-bank reads are impossible). These replace
     65  f005							; the ABW rect tables + BombMaskBit (the rect cache has no reader once
     66  f005							; the punch is cell-based). Parked in the $F003 fill gap, clear of the
     67  f005							; power-up stub's $F008 landing zone.
     68  f005		       00 00 00 00*	      .ds	$F010 - *, 0
     69  f010				   ColOff
     70  f010		       00 00 00 00*	      .byte.b	0,0,0,0, 4,4,4,4,4,4,4,4, 8,8,8,8,8,8,8,8
     71  f024							; N=4: stride 4 → PF1/PF2 rows at +4/+8
     72  f024				   ColMask
     73  f024		       10 20 40 80*	      .byte.b	$10,$20,$40,$80, $80,$40,$20,$10,$08,$04,$02,$01
     74  f030		       01 02 04 08*	      .byte.b	$01,$02,$04,$08, $10,$20,$40,$80
