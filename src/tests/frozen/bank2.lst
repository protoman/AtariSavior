   2112  fdd3							; ------------------------------------------------------------------------------
   2113  fdd3							; HOF entry tramp ($FE80-$FE85) — byte-identical with kernel.asm's copy
   2114  fdd3							; (guard: verify_build check_moth_tramp). bank0 executes `sta $1FF8` at
   2115  fdd3							; $FE80-$FE82; the fetch at $FE83 comes from THIS bank = `jmp $FCF0`. Neither
   2116  fdd3							; bank runs its other half: bank0 is switched away at $FE82, bank2 never
   2117  fdd3							; enters at $FE80. Pinned $FE80: the $FBF8-$FC48 pad window is full (5 B
   2118  fdd3							; left, a stub needs 6 B) and $FE86-$FEEF is the only free hole before the
   2119  fdd3							; moth tramp's $FEF0.
   2120  fdd3							; ------------------------------------------------------------------------------
   2121  fdd3							; ------------------------------------------------------------------------------
   2122  fdd3							; BombEnemyBlast tramp mirror ($FDD8-$FDDD) — byte-identical with kernel.asm's
   2123  fdd3							; copy at the same address (bomb-lamp fix 2026-10-07). bank0 executes `sta
   2124  fdd3							; $1FF8` at $FDD8-$FDDA; the fetch at $FDDB comes from THIS bank = `jmp $FD87`
   2125  fdd3							; (BombEnemyBlastBody). Neither bank runs its other half: bank0 is switched
   2126  fdd3							; away at $FDDA, bank2 never enters at $FDD8 (the .HOVdone tail-jmps $FBF8
   2127  fdd3							; before this pad). Pinned $FDE1 below = PickPlayerFrame tramp.
   2128  fdd3							; ------------------------------------------------------------------------------
   2129  fdd3		       00 00 00 00*	      .ds	$FDD8 - *, 0
   2130  fdd8		       8d f8 1f 	      .byte.b	$8D, $F8, $1F	; sta $1FF8 (twin)
   2131  fddb		       4c 87 fd 	      .byte.b	$4C, $87, $FD	; jmp $FD87 (twin — fetched post-switch)
   2132  fdde		       00 00 00 	      .ds	$FDE1 - *, 0	; PickPlayerFrame tramp mirror (byte-identical
   2133  fde1							; with kernel.asm's copy — verify_frame_tramp)
   2134  fde1				   PickPlayerFrameTramp
   2135  fde1		       8d f8 1f 	      sta	$1FF8	; executed only as the post-switch fetch image
   2136  fde4		       4c c4 f3 	      jmp	$F3C4	; bank2 PickPlayerFrame body (this bank)
   2137  fde7							; Twin of bank0 PlayerWalkA/B ($FDE7, 12+12 rows): PickPlayerFrame reads
   2138  fde7							; the hand-copy EQUs while THIS bank is active — without these bytes the
   2139  fde7							; walk frames fetched zeros and the sprite vanished (title + gameplay).
   2140  fde7		       3c 7e 7c 7e	      .byte.b	%00111100, %01111110, %01111100, %01111110
   2141  fdeb		       7c fe fe 3e	      .byte.b	%01111100, %11111110, %11111110, %00111110
   2142  fdef		       3e 14 22 42	      .byte.b	%00111110, %00010100, %00100010, %01000010	; walk A boots apart
   2143  fdf3		       3c 7e 7c 7e	      .byte.b	%00111100, %01111110, %01111100, %01111110
   2144  fdf7		       7c fe fe 3e	      .byte.b	%01111100, %11111110, %11111110, %00111110
   2145  fdfb		       3e 14 18 18	      .byte.b	%00111110, %00010100, %00011000, %00011000	; walk B boots together
