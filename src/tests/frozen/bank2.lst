    162  f029		       85 90		      sta	RoomRectsLo
    163  f02b		       c8		      iny
    164  f02c		       b1 e5		      lda	(FetchPtr),Y	; rects ptr hi
    165  f02e		       85 91		      sta	RoomRectsHi
    166  f030
    167  f030							; --- copy solid rect list → ZP cache: ROM is packed 2B/rect
    168  f030							;     [x<<2|y, w<<2|h], cache keeps the uniform 4B walk form.
    169  f030							;     Copies 5 slots unconditionally (count = RcBase gates walkers).
    170  f030		       a5 90		      lda	RoomRectsLo
    171  f032		       85 e5		      sta	FetchPtr
    172  f034		       a5 91		      lda	RoomRectsHi
    173  f036		       85 e6		      sta	FetchPtr+1
    174  f038		       a0 00		      ldy	#0
    175  f03a		       b1 e5		      lda	(FetchPtr),Y	; count
    176  f03c		       c9 06		      cmp	#6
    177  f03e		       90 02		      bcc	.EBrcCntOk
    178  f040		       a9 05		      lda	#5	; rect5+ not cached (ZP ends $DF) — clamp
    179  f042				   .EBrcCntOk		; so walkers can trust RcBase <= 5
    180  f042		       85 89		      sta	RcBase
    181  f044		       c8		      iny		; Y = first packed byte
    182  f045		       a2 00		      ldx	#0	; dest offset in rect0..4 ($CC+)
    183  f047				   .EBrcW
    184  f047		       b1 e5		      lda	(FetchPtr),Y
    185  f049		       4a		      lsr
    186  f04a		       4a		      lsr		; x = p0 >> 2
    187  f04b		       95 cc		      sta	RcW1,X
    188  f04d		       b1 e5		      lda	(FetchPtr),Y
    189  f04f		       29 03		      and	#3	; y = p0 & 3
    190  f051		       95 cd		      sta	RcW1+1,X
    191  f053		       c8		      iny
    192  f054		       b1 e5		      lda	(FetchPtr),Y
    193  f056		       4a		      lsr
    194  f057		       4a		      lsr		; w = p1 >> 2
    195  f058		       95 ce		      sta	RcW1+2,X
    196  f05a		       b1 e5		      lda	(FetchPtr),Y
    197  f05c		       29 03		      and	#3	; h = p1 & 3
    198  f05e		       95 cf		      sta	RcW1+3,X
    199  f060		       c8		      iny
    200  f061		       e8		      inx
    201  f062		       e8		      inx
    202  f063		       e8		      inx
    203  f064		       e8		      inx
    204  f065		       e0 14		      cpx	#20
    205  f067		       d0 de		      bne	.EBrcW
