    861  f401							; StageBandTab — asym meta: decode packed model meta into bank0 ZP for the cave.
    862  f401							; Reached from BuildColupF's tail (BCFDarkRun jmp here); ends at ReturnPad so
    863  f401							; the VBL jsr returns to bank0 (pads must not nest — no rts here).
    864  f401							; WHY here: models_data lives in THIS bank — a bank0 (RoomPF0Lo),Y read
    865  f401							; fetches bank0's $F9xx zero pad (the Phase 2 ball block silently read zeros).
    866  f401							; Packed meta (bugs.md 28 point 1): TilePF0+9 = MetaA = (m1_col+1)<<4 |
    867  f401							; band_mask (b0-2 = band0/1/2 gates); TilePF0+10 = MetaB = ball_col+1
    868  f401							; (0 = feature absent). Expanded to the old RAM shapes:
    869  f401							;   BandTab ($ED-$EF) <- $ff/$00 per-band ENABL gates (.Row ENABL reads
    870  f401							;			  bit0; the pack's `bit`/`bpl` reads bit7)
    871  f401							;   Temp    ($88)     <- BallX = 87+8*ball_col (0 ⇔ symmetric → skip;
    872  f401							;			  verify_build enforces)
    873  f401							;   CollisionEndX ($8E) <- M1X = 7+8*m1_col (0 = no M1; kill-gated below)
    874  f401							; Window: staged every VBL → read by cave → bank1 HUD stomps $ED-$EF after
    875  f401							; the cave read → overscan rewrites $88 (joystick) after the ball read.
    876  f401							; ------------------------------------------------------------------------------
    877  f401				   StageBandTab
    878  f401							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
    879  f401		       a0 09		      ldy	#9
    880  f403							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
    881  f403							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
    882  f403							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
    883  f403							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
    884  f403							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
    885  f403							; no-ball path below blanks BandTab so it never enables the ball.
    886  f403							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
    887  f403							; the pack uses $8F).
    888  f403		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
    889  f405		       29 01		      and	#$01
    890  f407		       aa		      tax
    891  f408		       bd c0 f4 	      lda	M1OffTab,X
    892  f40b		       85 92		      sta	RectCount
    893  f40d		       b1 99		      lda	(RoomPF0Lo),Y	; MetaA
