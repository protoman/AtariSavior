   1259  f784		       85 25		      sta	VDELP0
   1260  f786		       85 26		      sta	VDELP1
   1261  f788							; Flush both VDELP buffers + live registers to 0.
   1262  f788							; Without this, stale buffer data from previous frame shows as
   1263  f788							; white ghost copies during the positioning scanlines.
