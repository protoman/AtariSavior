    676  f307							; ------------------------------------------------------------------------------
    677  f307							; TallyEntry — level-bonus tally body (user spec 2026-10-02). Entered from
    678  f307							; bank0's TallyTramp ($FFE6) via jsr; tail-jmps ReturnPad ($FBF8) so A (and
    679  f307							; Z) survive back to the bank0 caller.
    680  f307							;   DropTarget == 0 (pickup frame) -> ARM: snapshot the bonus into TallyTicks
    681  f307							;     in 50-pt units — 20 = miner (1000), (BarLevel+3)/6 = remaining time
    682  f307							;     (50% -> 10 ticks -> 500), 1/bomb, 2/life — then arm the 4-frame pace
    683  f307							;     divider (TickCounter), clear jet/beam, set DropTarget = $FE.
    684  f307							;   DropTarget == $FE (every frame) -> STEP: dec TickCounter; on 0 reload 4,
    685  f307							;     dec TallyTicks. Event A: b0 = add 50, b1 = coin tone written here
    686  f307							;     (AUDC/F/V + BombSnd=8; bank0 TallyWork's UpdateBombSound holds it,
    687  f307							;     coin = every 4 ticks = 200 pts), b2 = done (last tick consumed).
    688  f307							; Pinned $F313 (org $F9D9 below: level data pins the overflow = build fails).
    689  f307							; Was $F310 → $F313 (Phase 4 walk-head; kernel TallyEntry EQU moves with
    690  f307							; it — both jmp operands are symbolic). The LWC M1 tip test (2026-10-08)
    691  f307							; funds itself by moving ColOff/ColMask past this pin (see their comment).
    692  f307							; ------------------------------------------------------------------------------
    693  f307		       00 00 00 00*	      .ds	$F313 - *, 0
    694  f313				   TallyEntry
    695  f313		       a5 8a		      lda	DropTarget
    696  f315		       f0 36		      beq	.TEArm
    697  f317		       c6 ad		      dec	TickCounter	; pace: 1 tick per 4 frames
    698  f319		       d0 2d		      bne	.TEIdle
    699  f31b		       a9 04		      lda	#4
    700  f31d		       85 ad		      sta	TickCounter
    701  f31f		       c6 f2		      dec	TallyTicks
    702  f321		       f0 20		      beq	.TEFinal	; last unit: event = tick+coin+done
    703  f323		       a5 f2		      lda	TallyTicks
    704  f325		       29 03		      and	#3
    705  f327		       d0 15		      bne	.TEOne	; tick only
    706  f329		       a9 08		      lda	#8	; --- coin blip (200 pts = every 4th tick)
    707  f32b		       85 f1		      sta	BombSnd
    708  f32d		       a9 04		      lda	#4
    709  f32f		       85 15		      sta	AUDC0	; square
    710  f331		       a9 18		      lda	#24
    711  f333		       85 17		      sta	AUDF0	; high pitch — distinct from bomb drop ($0A)
    712  f335		       a9 08		      lda	#8
    713  f337		       85 19		      sta	AUDV0
    714  f339		       a9 03		      lda	#3	; tick + coin
    715  f33b		       4c f8 fb 	      jmp	ReturnPad
    716  f33e				   .TEOne
    717  f33e		       a9 01		      lda	#1	; tick only
    718  f340		       4c f8 fb 	      jmp	ReturnPad
    719  f343				   .TEFinal
    720  f343		       a9 07		      lda	#7	; tick + coin + done
    721  f345		       4c f8 fb 	      jmp	ReturnPad
    722  f348				   .TEIdle
    723  f348		       a9 00		      lda	#0	; no event (Z set for bank0 beq)
    724  f34a		       4c f8 fb 	      jmp	ReturnPad
    725  f34d				   .TEArm
    726  f34d		       a5 ae		      lda	BarLevel
    727  f34f		       18		      clc
    728  f350		       69 03		      adc	#3	; round-to-nearest: (BarLevel+3)/6
    729  f352		       a2 00		      ldx	#0
    730  f354				   .TEDiv
    731  f354		       c9 06		      cmp	#6
    732  f356		       90 06		      bcc	.TEDivSum
    733  f358		       38		      sec
    734  f359		       e9 06		      sbc	#6
