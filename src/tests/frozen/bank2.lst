    776  f486							; SelectActiveObject — MOVED from bank0 (C1, 2026-10-20; was $F5D5-$F6F6).
    777  f486							; Entry: bank0 VBL `jsr CallPad_SelectObject` ($FC1D `sta $1FF8`) -> the fetch
    778  f486							; at $FC20 is THIS bank's `jmp SelectActiveObject` (see the pad note at $FC20).
    779  f486							; Every exit tail-jmps ReturnPad ($FBF8 = `sta $1FF6`; bank0 serves the `rts`),
    780  f486							; so the VBL frame is popped exactly once and nothing is pushed here.
    781  f486							; ------------------------------------------------------------------------------
    782  f486							; Chosen GRP1 object for this frame; the TIA has one GRP1 sprite, so objects
    783  f486							; flicker by rotating slots. Sets ObjBase, ActiveObjectX, ActiveObjectY,
    784  f486							; ObjTop and COLUP1 (plus P1's hardware X via SetObjectXPos_b2).
    785  f486							; Slot count (enemies + miner?) lives in Temp for this VBLANK only.
    786  f486							; Bomb fuse (state=1): low-priority — bomb only when (BombTimer&3)==0 (~15 Hz);
    787  f486							; other frames normal miner/enemy rotation (FlickerFrame alone).
    788  f486							;
    789  f486							; What changed vs the bank0 body (behaviour identical):
    790  f486							;   * the enemy TYPE is a direct `lda (EnemyDataLo),Y` — the room records are
    791  f486							;     level data in THIS bank, so the FoldIndirect hop (25c, 2 switches) and
    792  f486							;     the FetchPtr staging are gone;
    793  f486							;   * the room-dark test is INLINE: bank1's IsRoomDark ends in `jmp ReturnPad`,
    794  f486							;     which would land back in bank0 and strand this frame. Same mask split and
    795  f486							;     same Z contract; tools/test_room_dark.py drives BOTH bodies and asserts
    796  f486							;     they agree for rooms 0-9 and every split bit;
    797  f486							;   * SetObjectXPos / fineAdjust / SetObjReflection / the two type tables are
    798  f486							;     local copies at $F800 (bank0 ROM is not visible from here).
    799  f486							; ==============================================================================
    800  f486					      .ds	$F486 - *, 0
    801  f486				   SelectActiveObject
    802  f486							; Tally / frozen scene (DropTarget = $FE): show the PLAYER and the MINER
    803  f486							; only — no enemies, no raft, no bomb. That frame bypasses the overscan, so
    804  f486							; RefreshEnemyY never runs while bank1's HUD writes $E0-$EF: EnemyRamY
    805  f486							; ($E2-$E4) is left holding score-pointer bytes, and any enemy drawn then
    806  f486							; jumps to a garbage Y (user report 2026-10-18: the raft "moved up to the
    807  f486							; middle of the screen" the moment the points counting started).
    808  f486		       a5 8a		      lda	DropTarget
    809  f488		       c9 fe		      cmp	#$FE
    810  f48a		       d0 27		      bne	.SOFull
    811  f48c		       a9 00		      lda	#0
    812  f48e		       85 b4		      sta	FlickerFrame	; keep the modulo counter bounded (2026-10-16)
    813  f490		       85 b6		      sta	ObjBase	; 0 = no object
    814  f492		       a5 a4		      lda	LevelMinerRoom
    815  f494		       29 7f		      and	#$7f
    816  f496		       c5 98		      cmp	RoomNo
    817  f498		       f0 03		      beq	.SOTallyMiner
    818  f49a		       4c 94 f5 	      jmp	.SODone	; miner not here -> nothing drawn
    819  f49d				   .SOTallyMiner
    820  f49d		       a9 38		      lda	#OBJ_MINER
    821  f49f		       85 b6		      sta	ObjBase
    822  f4a1		       a5 a5		      lda	MinerX
    823  f4a3		       85 b7		      sta	ActiveObjectX
