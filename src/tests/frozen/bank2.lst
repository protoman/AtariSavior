    194  f03a							; --- enemies (C2 2026-10-20): count column = base + 2n, records = base
    195  f03a							; + 3n (n = LevelRoomN). The count byte is count<<6 | extras index; the
    196  f03a							; FIRST RECORD INDEX is DERIVED by summing the counts of rooms 0..room-1
    197  f03a							; (records stay contiguous in room order), so the old packed index byte
    198  f03a							; and its 31-record/level cap are gone. The band COLOR is the global
    199  f03a							; BAND_COLOR (one water color per game).
    200  f03a							; LevelConnSpare is free here: it only carries the exit-scan target, and
    201  f03a							; that scan has already returned when EnterRoomB2 is entered.
    202  f03a		       a5 98		      lda	RoomNo
    203  f03c		       a8		      tay		; Y = room (one byte per record)
    204  f03d		       a5 9f		      lda	LevelPFDataLo
    205  f03f		       18		      clc
