    692  f2f7		       a5 88		      lda	Temp
    693  f2f9		       95 bd		      sta	EnemyRamX,X	; same box -> arrival state was clear -> commit
    694  f2fb		       4c 28 f2 	      jmp	MothExit
    695  f2fe				   .MothGateWalk
    696  f2fe		       4c 50 f1 	      jmp	MothDoWalk
