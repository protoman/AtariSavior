    302  f0d0		       49 ff		      eor	#$FF
    303  f0d2		       25 c1		      and	EnemyRamD
    304  f0d4		       85 c1		      sta	EnemyRamD
    305  f0d6				   EBLER_Next
    306  f0d6		       e8		      inx
    307  f0d7		       4c a0 f0 	      jmp	EBLER_Loop
    308  f0da				   EBLER_Done
    309  f0da							; --- C7 (2026-10-20): the joystick-shadow refresh (Temp = SWCHA>>4)
    310  f0da							;     moved to bank3's ERLoadDone: the shape/PF/meta walkers that run
    311  f0da							;     AFTER this point use Temp as scratch, and Temp is the byte bank0's
    312  f0da							;     input block keeps reading for the rest of the frame.
    313  f0da							; --- C7 (2026-10-20): the PF / meta / extras half runs in BANK3 (the
    314  f0da							;     shape blocks, the row pool and the async extras streams live
    315  f0da							;     there). It is LAST on purpose: bank3's chain ends in its own
