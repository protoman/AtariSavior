   1665  fc78							; IsRoomDark/SetRoomDark — moved here (post-ToGameStub free space) when the
   1666  fc78							; mask grew to 8 bits: the $F9C0-$FB10 body span had only ~19 B headroom.
   1667  fc78							; CallPad jmp literals live in BOTH kernel.asm and bank1.asm — verify_build
   1668  fc78							; check_callpads asserts they equal these labels.
   1669  fc78							; ------------------------------------------------------------------------
   1670  fc78							; IsRoomDark — Z=1 if lit, Z=0 if dark (RoomDarkMask = 8-bit split:
   1671  fc78							; rooms 0-3 = EnemyRamD bits 4-7, rooms 4-7 = LaserState bits 2-5.
   1672  fc78							; Rooms 8+ have no bit → always lit, never crash.)
   1673  fc78							; Clobbers A/X; Y preserved. PLA in ReturnPad re-sets Z from A — contract
   1674  fc78							; survives the cross-bank return.
   1675  fc78				   IsRoomDark
   1676  fc78		       a5 98		      lda	RoomNo
   1677  fc7a		       c9 04		      cmp	#4
   1678  fc7c		       b0 0c		      bcs	.IRDhi
   1679  fc7e		       18		      clc
   1680  fc7f		       69 04		      adc	#4	; bit index = 4 + RoomNo
   1681  fc81		       aa		      tax
   1682  fc82		       bd c3 fc 	      lda	BitMaskTable,X
   1683  fc85		       25 c1		      and	EnemyRamD	; Z=1 → lit (bit clear), Z=0 → dark
   1684  fc87		       4c f8 fb 	      jmp	ReturnPad
   1685  fc8a				   .IRDhi
   1686  fc8a		       c9 08		      cmp	#8
   1687  fc8c		       b0 0b		      bcs	.IRDlit	; rooms 8+ never dark (no mask bit)
   1688  fc8e		       aa		      tax
   1689  fc8f		       bd c3 fc 	      lda	BitMaskTable,X	; $10/$20/$40/$80
   1690  fc92		       4a		      lsr
   1691  fc93		       4a		      lsr		; → $04/$08/$10/$20 = LaserState b2-5
   1692  fc94		       25 c0		      and	LaserState
   1693  fc96		       4c f8 fb 	      jmp	ReturnPad
   1694  fc99				   .IRDlit
   1695  fc99		       a9 00		      lda	#0	; Z=1 → lit
   1696  fc9b		       4c f8 fb 	      jmp	ReturnPad
   1697  fc9e
   1698  fc9e							; SetRoomDark — set dark flag for current RoomNo (rooms 0-3 → EnemyRamD
   1699  fc9e							; bits 4-7, rooms 4-7 → LaserState bits 2-5; rooms 8+ = no-op, room
   1700  fc9e							; simply stays lit). Cleared only by LoadLevel.
   1701  fc9e				   SetRoomDark
   1702  fc9e		       a5 98		      lda	RoomNo
   1703  fca0		       c9 04		      cmp	#4
   1704  fca2		       b0 0e		      bcs	.SRDhi
   1705  fca4		       18		      clc
   1706  fca5		       69 04		      adc	#4
   1707  fca7		       aa		      tax
