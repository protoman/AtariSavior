   1932  fcad							; ------------------------------------------------------------------
   1933  fcad							; C2 (2026-10-20): B3StageBand + M1OffTab (was bank3 $FC38-$FCF2).
   1934  fcad							; Called from BCFDarkRun (`jmp B3StageBand`) and bank1's HUD fold; ends
   1935  fcad							; `jmp ReturnPad`. ZP/TIA only — no level-data read.
   1936  fcad							; ------------------------------------------------------------------
   1937  fcad		       00 00 00 00*	      .ds	$FCB8 - *, 0
   1938  fcb8				   B3StageBand
   1939  fcb8							; --- expand band mask -> BandTab $ff/$00 ×3 (bit0 ENABL + bit7 pack) ---
   1940  fcb8							; --- Phase 5: stage the M1 x-offset for the door SIDE. A door has no
   1941  fcb8							; ball (its asym rows resolve to None → band mask $00), so MetaA bit0
   1942  fcb8							; is free: 1 = M1 strip on the RIGHT half (x = 87+8*col → offset +79),
   1943  fcb8							; 0 = left (x = 7+8*col → offset -1). The M1 block adds it via
   1944  fcb8							; clc/adc RectCount. MetaA bit0 is ALSO the band-0 ball gate — the
   1945  fcb8							; no-ball path below blanks BandTab so it never enables the ball.
   1946  fcb8							; RectCount ($92) is free in the VBL (kernel re-inits RowIdx at entry;
   1947  fcb8							; the pack uses $8F).
   1948  fcb8		       a5 99		      lda	RoomMetaA	; MetaA
   1949  fcba		       29 01		      and	#$01
   1950  fcbc		       aa		      tax
   1951  fcbd		       bd 71 fd 	      lda	M1OffTab,X
   1952  fcc0		       85 92		      sta	RectCount
   1953  fcc2		       a5 99		      lda	RoomMetaA	; MetaA
   1954  fcc4		       4a		      lsr		; band0 bit -> carry
   1955  fcc5		       a9 00		      lda	#0
   1956  fcc7		       2a		      rol
   1957  fcc8		       f0 02		      beq	.SBTb0z
   1958  fcca		       a9 ff		      lda	#$ff
   1959  fccc				   .SBTb0z
   1960  fccc		       85 ed		      sta	BandTab
   1961  fcce		       a5 99		      lda	RoomMetaA
   1962  fcd0		       4a		      lsr
   1963  fcd1		       4a		      lsr		; band1 bit -> carry
   1964  fcd2		       a9 00		      lda	#0
   1965  fcd4		       2a		      rol
   1966  fcd5		       f0 02		      beq	.SBTb1z
   1967  fcd7		       a9 ff		      lda	#$ff
   1968  fcd9				   .SBTb1z
   1969  fcd9		       85 ee		      sta	BandTab+1
   1970  fcdb		       a5 99		      lda	RoomMetaA
   1971  fcdd		       4a		      lsr
   1972  fcde		       4a		      lsr
   1973  fcdf		       4a		      lsr		; band2 bit -> carry
   1974  fce0		       a9 00		      lda	#0
   1975  fce2		       2a		      rol
   1976  fce3		       f0 02		      beq	.SBTb2z
   1977  fce5		       a9 ff		      lda	#$ff
   1978  fce7				   .SBTb2z
