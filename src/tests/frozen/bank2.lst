    279  f0b1		       b0 36		      bcs	EBLER_Done
    280  f0b3		       bc 52 ff 	      ldy	EnemyOffTable,X	; Y = X*4 type offset
    281  f0b6		       b1 e5		      lda	(FetchPtr),Y	; +0 = type (kept for the snake invert)
