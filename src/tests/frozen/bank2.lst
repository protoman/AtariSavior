    151  f008							; --- #22 EnterRoomB2 ($F010) -----------------------------------------------
    152  f008							; Body of bank0's EnterRoom (tramp at $FBD0: sta $1FF8 / jmp $F010).
    153  f008							; Reached with A = room index; returns via jmp ReturnPad (X = EnemyCount).
    154  f008							; Level data lives in THIS bank → direct (FetchPtr),Y reads, NO folds
    155  f008							; (same transcription as MothRoutine below). Saves ~1660c per room change.
    156  f008							; Must end before MothRoutine ($F110 since the meta staging) — overflow
    157  f008							; = Origin Reverse.
    158  f008		       00 00 00 00*	      .ds	$F010 - *, 0
