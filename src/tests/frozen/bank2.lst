   1597  faa4							; BombMarkWalls (+BMWCellSolid) moved to the gameplay bank (bank 3).
   1598  faa4
   1599  faa4							; ColOff/ColMask live at $F010 (top-of-bank fill gap) — only BMWCellSolid and
   1600  faa4							; BeamMask-era code index them (abs,X); no cross-bank operand points here.
   1601  faa4
   1602  faa4							; ========================================================================
   1603  faa4							; Cross-bank call pads — 2026-10-20 (chunk 4): SPLIT across the banks, no
   1604  faa4							; twin. kernel.asm holds the eleven `sta $1FFx` halves compactly at
   1605  faa4							; $FBFC..$FC1C; after the switch the fetch at A+3 lands HERE, so this bank
   1606  faa4							; keeps only the `jmp` halves (at A+3, i.e. $FBFF onward). The reverse halves
   1607  faa4							; were dead bytes: no bank1/bank2/bank3 code calls a CallPad (guard:
   1608  faa4							; verify_build.check_callpads rejects any `jsr/jmp CallPad_*` outside
   1609  faa4							; kernel.asm). F6 hotspot ignores the written value, so a pad still passes
   1610  faa4							; A/X/Y/flags through untouched (`sta` affects no flag).
   1611  faa4							;   $FBFF <-$FBFC+3 UpdateBombSound	  $FC0E <-$FC0B+3 AddScore
   1612  faa4							;   $FC02 <-$FBFF+3 UpdateJetSound	  $FC11 <-$FC0E+3 IsRoomDark
   1613  faa4							;   $FC05 <-$FC02+3 BombSndDrop	  $FC14 <-$FC11+3 SetRoomDark
   1614  faa4							;   $FC08 <-$FC05+3 BombSndExplode	  $FC17 <-$FC14+3 UpdateLaserSound
   1615  faa4							;   ($FC0B retired by C3)		 $FC1D <-$FC1A+3 BombMarkWalls
   1616  faa4							; $FC1A (BuildColupF's +3) belongs to BANK3 — its pad is `sta $1FF7`.
   1617  faa4							; ========================================================================
   1618  faa4		       00 00 00 00*	      .ds	$FBF8 - *, 0
   1619  fbf8				   ReturnPad
   1620  fbf8		       8d f4 1f 	      sta	BK_GENERAL	; the `rts` at $FBFB is served by bank0
   1621  fbfb		       00 00 00 00	      .ds	$FBFF - *, 0
   1622  fbff		       4c c0 f9 	      jmp	UpdateBombSound
   1623  fc02		       4c cf f9 	      jmp	UpdateJetSound
   1624  fc05		       4c 00 fa 	      jmp	BombSndDrop
   1625  fc08		       4c 13 fa 	      jmp	BombSndExplode
   1626  fc0b		       00 00 00 	      .byte.b	0,0,0	; $FC0B: GetConnIdx's half, retired by C3
   1627  fc0e		       4c 26 fa 	      jmp	AddScore	; label, not the literal: bank1 shifts move it
   1628  fc11		       4c 78 fc 	      jmp	IsRoomDark
   1629  fc14		       4c 9e fc 	      jmp	SetRoomDark
   1630  fc17		       4c 4e fa 	      jmp	UpdateLaserSound	; label, not the literal (bank1 shifts)
   1631  fc1a							; (the `jmp BombMarkWalls` pad half is served by the gameplay bank)
   1632  fc1a
   1633  fc1a							; CallPad tail pads (2026-10-20: SPLIT across the banks, no twin). kernel.asm
   1634  fc1a							; holds the three `sta $1FF5` at $FC4F/$FC52/$FC55; after the switch the fetch
   1635  fc1a							; at A+3 lands HERE, so bank1 keeps only the `jmp` halves. Nothing calls a
   1636  fc1a							; tail pad from bank1, so bank1's `sta` halves and bank0's `jmp` halves were
   1637  fc1a							; dead bytes — reclaiming them gave bank0 15 B of pre-pad headroom.
   1638  fc1a							;   $FC52 <-$FC4F+3 CallPad_TitleSelect
   1639  fc1a							;   $FC55 <-$FC52+3 CallPad_TitleBand
   1640  fc1a							;   $FC58 <-$FC55+3 CallPad_MusicTick
   1641  fc1a							; Guard: verify_build.check_callpads (per-pad A / A+3 contract).
   1642  fc1a		       00 00 00 00*	      .ds	$FC52 - *, 0
   1643  fc52		       4c 78 f2 	      jmp	TitleSelect
   1644  fc55					      .ds	$FC55 - *, 0
   1645  fc55		       4c 80 f0 	      jmp	$F080	; TitleBand
   1646  fc58					      .ds	$FC58 - *, 0
   1647  fc58		       4c 5a f3 	      jmp	MusicTick
