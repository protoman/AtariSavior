   1373  fae9
   1374  fae9							; --- Phase 3: phase-cell blink (moved here — StageBandTab window full)
   1375  fae9							; Walks the hot-stream $80 records [class, 2c, row, 2, 1] and toggles
   1376  fae9							; the cell's two PF bits per EnemyRamP bit5 (64f cycle: 32 ON + 32
   1377  fae9							; OFF). The PF buffers are the collision map — render, PHM, and the
   1378  fae9							; laser all follow the blink for free. $81/$82 (vcrunch/hcrunch)
   1379  fae9							; tramp to bank3 (CrunchClock ping-pong staging — Phase 4); legacy
   1380  fae9							; hot rects are skipped. CollisionEndY ($8F) is
   1381  fae9							; scratch: the pack rebuild in StageBandTab overwrites it right
   1382  fae9							; after the call returns.
   1383  fae9				   PhaseBlink
   1384  fae9							; --- Phase C vcrunch slice staging (defaults; the walk's VcrShutter
   1385  fae9							; arm overwrites for shutter rooms). Runs every VBL this routine does —
   1386  fae9							; bank1 HUD already stomped $EA/$EB/$EC after the cave, so a full
   1387  fae9							; restage here is the only way the next kernel reads sane values.
   1388  fae9							; Idle defaults: VcrBand=$FF (tail dispatch never matches), VcrNext=0
   1389  fae9							; (idle marker — only 1..4 slices), VcrState=0. The band0 length needs
   1390  fae9							; no byte: .Row derives 8/48 from these two.
   1391  fae9		       a9 ff		      lda	#$FF
   1392  faeb		       85 ec		      sta	VcrBand
   1393  faed		       a9 00		      lda	#0
   1394  faef		       85 eb		      sta	VcrNext
   1395  faf1		       85 ea		      sta	VcrState
   1396  faf3							; Door stripe color → CollisionCellY ($8D): $80 = no door (the kernel
   1397  faf3		       a9 80		      lda	#$80
   1398  faf5							; band-setup line keeps the band color on COLUP1); $1C = yellow
   1399  faf5							; (hue1 luma6 — doors + key are yellow, user ruling 2026-10-12; the
   1400  faf5							; +10c door branch cost +2 cave frame lines — wall-model retargeted
   1401  faf5							; per-kernel, bugs.md #32 closed). The overscan PHM prologue restages
   1402  faf5							; $8D as its own top-row temp AFTER the kernel — no lifecycle overlap.
   1403  faf5							; (Staged here, not in StageBandTab: that window is pin-full.)
   1404  faf5		       a9 80		      lda	#$80
   1405  faf7		       85 8d		      sta	CollisionCellY
   1406  faf9		       a5 99		      lda	RoomMetaA	; MetaA
   1407  fafb		       29 08		      and	#$08	; b3 = left door
   1408  fafd		       f0 04		      beq	.PhNoDoor
   1409  faff		       a9 1c		      lda	#$1C	; yellow door stripe
   1410  fb01		       85 8d		      sta	CollisionCellY
   1411  fb03				   .PhNoDoor
   1412  fb03							; --- blink phase → EnemyDeadMask b5 (armed = cell solid this frame) --
   1413  fb03							; mod-90 clock: 45 ON / 45 OFF (+76f tail per 256 wrap) = ~+40% over the
   1414  fb03							; old raw bit5 32/32 blink (user, 2026-10-13). Staged here every VBL so
   1415  fb03							; overscan HotOverlapBody can read the SAME frame's state: EnemyRamP is
   1416  fb03							; incremented at overscan entry (RefreshEnemyY), so a raw-clock read in
   1417  fb03							; HOV would be one frame ahead of the kernel's rendered blink.
   1418  fb03		       a5 c2		      lda	EnemyRamP
   1419  fb05		       c9 5a		      cmp	#90
   1420  fb07		       90 02		      bcc	.Phm1
   1421  fb09		       e9 5a		      sbc	#90
   1422  fb0b				   .Phm1
   1423  fb0b		       c9 5a		      cmp	#90
   1424  fb0d		       90 02		      bcc	.Phm2
   1425  fb0f		       e9 5a		      sbc	#90
   1426  fb11				   .Phm2
   1427  fb11		       c9 2d		      cmp	#45	; C=1 ⟺ phase ≥ 45 ⟺ blink OFF
   1428  fb13		       a5 ba		      lda	EnemyDeadMask	; (LDA preserves C)
   1429  fb15		       b0 04		      bcs	.PhfOff
   1430  fb17		       09 20		      ora	#$20
   1431  fb19		       90 02		      bcc	.PhfSt	; C=0 → always taken (skips the AND)
   1432  fb1b				   .PhfOff
   1433  fb1b		       29 df		      and	#$DF
   1434  fb1d				   .PhfSt
