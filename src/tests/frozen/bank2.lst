    976  f46d							; (vcrunch) AND b6 (hot) — b6 used to survive
    977  f46d							; and fake a 1-cell ball at x72-79 on a
    978  f46d							; hot-without-ball model
    979  f46d		       f0 0b		      beq	.SBTnoBall
    980  f46f		       0a		      asl
    981  f470		       0a		      asl
