    870  f864		       00 00 00 00*	      .ds	$F880 - *, 0
    871  f880							; TallySum — the level-bonus total for TallyEntry (frozen-scene frame).
    872  f880							; Split OUT of the inline TallyEntry region (it ends at a hard org) into bank2's
    873  f880							; free slack before the $F970 pin. IN: X = time ticks (0..20). OUT: TallyTicks
    874  f880							; set; A clobbered, X/Y kept. The bomb count MUST be masked: PlayerBombs' high
    875  f880							; bits carry the raft's take-off ramp state (b7 flag, b6-3 level — see the
    876  f880							; kernel EQU contract), and a stale ride would otherwise inflate the bonus.
    877  f880							; Temp ($88) is free here: the tally frame bypasses the input (its joystick
    878  f880							; store) and the next VBL restages Temp anyway.
    879  f880				   TallySum
    880  f880		       a5 f0		      lda	PlayerBombs
    881  f882		       29 07		      and	#%00000111	; bombs only, never the ramp bits
    882  f884		       85 88		      sta	Temp
    883  f886		       8a		      txa
    884  f887		       18		      clc
    885  f888		       69 14		      adc	#20	; miner reach = 1000 pts
    886  f88a		       65 88		      adc	Temp	; + 50 per unspent bomb (chain carry ok)
    887  f88c		       85 f2		      sta	TallyTicks
    888  f88e		       a5 ac		      lda	PlayerLives
    889  f890		       0a		      asl		; + 100 per life = 2 ticks
    890  f891		       18		      clc
    891  f892		       65 f2		      adc	TallyTicks
    892  f894		       85 f2		      sta	TallyTicks
    893  f896		       60		      rts
