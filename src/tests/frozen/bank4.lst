    476  f296							; ---- the SHAPE STEP of the room load (moved from bank3 2026-11-10, from bank7 to bank4 (the models share bank4) 2026-11-14) ------------------
    477  f296							; bank3 B3RoomBlocks (at $F453) does `sta BK_MODELS`; the next fetch (+3) is the jmp below.
    478  f296							; ShapeStep7 expands the room's shape block into the PF buffers and stages the hot flag in
    479  f296							; RoomMetaB; `sta $1FF7` at +6 returns to bank3 (B3Meta, +9).
    480  f296		       00 e5	   FetchPtr   =	$E5
    481  f296		       00 99	   RoomPF0Lo  =	$99
    482  f296		       00 9a	   RoomMetaB  =	$9A
    483  f296		       00 c3	   PF0Buf     =	$C3
    484  f296		       00 c7	   PF1Buf     =	$C7
    485  f296		       00 cb	   PF2Buf     =	$CB
    486  f296		       00 04	   TILE_ROWS  =	4
    487  f456					      org	$F453 + 3
    488  f456		       4c 60 f4 	      jmp	ShapeStep7
    489  f459					      org	$F453 + 6
    490  f459		       8d f7 1f 	      sta	BK_EXTRAS
    491  f460					      org	$F460
    492  f460				   ShapeStep7
    493  f460		       a5 99		      lda	RoomPF0Lo
    494  f462		       29 7f		      and	#$7F	; shape index, 7 bits (128 shapes)
    495  f464		       0a		      asl		; *2: LEVEL_ShapeTable is a word table
    496  f465		       aa		      tax
    497  f466		       bd 1c f7 	      lda	LEVEL_ShapeTable,X	; block address = the table entry
    498  f469		       85 e5		      sta	FetchPtr
    499  f46b		       bd 1d f7 	      lda	LEVEL_ShapeTable+1,X
    500  f46e		       85 e6		      sta	FetchPtr+1
    501  f470		       a0 03		      ldy	#TILE_ROWS-1
    502  f472				   .sp
    503  f472		       b1 e5		      lda	(FetchPtr),Y	; row index for this band (b7 = band 1's hot flag)
    504  f474		       29 7f		      and	#$7F
    505  f476		       aa		      tax
    506  f477		       bd a4 f6 	      lda	RowPoolPF0,X
    507  f47a		       99 c3 00 	      sta	PF0Buf,Y
    508  f47d		       bd cc f6 	      lda	RowPoolPF1,X
    509  f480		       99 c7 00 	      sta	PF1Buf,Y
    510  f483		       bd f4 f6 	      lda	RowPoolPF2,X
    511  f486		       99 cb 00 	      sta	PF2Buf,Y
    512  f489		       88		      dey
    513  f48a		       10 e6		      bpl	.sp
    514  f48c		       a0 01		      ldy	#1
    515  f48e		       b1 e5		      lda	(FetchPtr),Y	; band-1 index | hot b7
    516  f490		       29 80		      and	#$80
    517  f492		       4a		      lsr		; $80 -> $40 (MetaB b6)
    518  f493		       85 9a		      sta	RoomMetaB
    519  f495		       4c 59 f4 	      jmp	$F453 + 6	; sta $1FF7 -> bank3 B3Meta
