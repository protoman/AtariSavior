------- FILE banks.inc LEVEL 2 PASS 2
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  10000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  10000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  10000 ????						;
      6  10000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  10000 ????						; ==============================================================================
      8  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  10000 ????		00 01	    BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  10000 ????		00 02	    BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  10000 ????		00 03	    BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  10000 ????		00 04	    BKI_TRANS  =	4	; version header, blank transition frame, attract script
     14  10000 ????		00 06	    BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  10000 ????		00 07	    BKI_PROLOGUE =	7	; cave kernel start-up code
     16  10000 ????		00 04	    BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     17  10000 ????
     18  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  10000 ????		1f f5	    BK_HUD     =	$1FF4 + BKI_HUD
     20  10000 ????		1f f6	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     21  10000 ????		1f f7	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     22  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     23  10000 ????		1f f8	    BK_TRANS   =	$1FF4 + BKI_TRANS
     24  10000 ????		1f fa	    BK_CAVE    =	$1FF4 + BKI_CAVE
     25  10000 ????		1f fb	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     26  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
------- FILE bank4.asm
      5  f000					      org	$F000
      6  f000							; The power-up pad every bank carries: `lda #0 / sta $1FF4` selects bank0, whose
      7  f000							; $F005 is `jmp GameStart`. The restart ops (game over, last stage cleared) jump
      8  f000							; here: the run restarts at the title and never returns to the caller.
      9  f000				   Restart
     10  f000		       a9 00		      lda	#0
     11  f002		       8d f4 1f 	      sta	BK_GENERAL
     12  f005							; ==============================================================================
     13  f005							; Bank4 — SaveKey service (docs/savekey_design.md, user 2026-10-28).
     14  f005							; ==============================================================================
     15  f005							; A 24LC256 I2C EEPROM on the RIGHT controller port: pin 3 = SDA = SWCHA bit 2,
     16  f005							; pin 4 = SCL = SWCHA bit 3 (Stella SaveKey.cxx). Open drain by hand: the SWCHA
     17  f005							; latch bits stay 0 and a line is driven LOW by setting its SWACNT bit (output)
     18  f005							; or RELEASED by clearing it (input, pulled up in the key). Nothing is ever
     19  f005							; driven high. Bit-banged without delays: every SWACNT store is >= 4 cycles
     20  f005							; (3.4 us), far above the chip's 400 kHz timing.
     21  f005							;
     22  f005							; ONE 12-byte record at SK_ADDR (16-byte aligned: it never straddles a 64-byte
     23  f005							; page), staged in SkBuf for the whole call:
     24  f005							;   0-1 magic $53,$01 (the 2nd byte is the format version)   2 state (1 = save)
     25  f005							;   3 level (0-based)	 4 lives   5-7 score (packed BCD Th,Hu,Te)
     26  f005							;   8-10 HIGH score (packed BCD)  11 checksum = $A5 eor bytes 0-10
     27  f005							; A bad magic/checksum is "no data": the game starts fresh and the next write
     28  f005							; repairs it. No key (NACK on the control byte) aborts every op at once.
     29  f005							;
     30  f005							; SkService (A = op), C=0 when it did something, C=1 when there was nothing to do
     31  f005							;   0 BOOT	   title power-on: Level := the saved stage; the high score goes
     32  f005							;		   to SkHi (vyLo/vyHi/PlayerYSub) for the title to show
     33  f005							;   1 RESUME	   RESET on the saved stage: lives + score := the saved ones
     34  f005							;   2 CHECKPOINT  stage advance (the caller already did `inc Level`): save {Level,
     35  f005							;		   lives, score}; high = max(high,score). Level >= LEVEL_COUNT =
     36  f005							;		   the last stage was cleared: same as GAMEOVER
     37  f005							;   3 GAMEOVER    erase the save; high = max(high, score); then RESTART at the
     38  f005							;		   title (never returns; with no key it just restarts)
     39  f005							; Clobbers A/X/Y, SkB/SkN/SkT/SkL and SkBuf. Leaves SWACNT = 0 (bus released).
     40  f005							; Hotspot for this bank: $1FF8 (F4: bank = addr - $1FF4).
