------- FILE banks.inc LEVEL 2 PASS 2
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  10000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  10000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  10000 ????						;
      6  10000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  10000 ????						; ==============================================================================
      8  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  10000 ????		00 01	    BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  10000 ????		00 02	    BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  10000 ????		00 03	    BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  10000 ????		00 04	    BKI_TRANS  =	4	; version header, blank transition frame, attract script
     14  10000 ????		00 06	    BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  10000 ????		00 07	    BKI_PROLOGUE =	7	; cave kernel start-up code
     16  10000 ????		00 05	    BKI_ROOMS_B =	5	; room bank B: identical code to ROOMS (bank2), the data of the levels past LEVEL_SPLIT
     17  10000 ????		00 04	    BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     18  10000 ????
     19  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     20  10000 ????		1f f5	    BK_HUD     =	$1FF4 + BKI_HUD
     21  10000 ????		1f f6	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     22  10000 ????		1f f7	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     23  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     24  10000 ????		1f f8	    BK_TRANS   =	$1FF4 + BKI_TRANS
     25  10000 ????		1f fa	    BK_CAVE    =	$1FF4 + BKI_CAVE
     26  10000 ????		1f fb	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     27  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
     28  10000 ????		1f f9	    BK_ROOMS_B =	$1FF4 + BKI_ROOMS_B
------- FILE bank4.asm
      5  f000					      org	$F000
      6  f000							; The power-up pad every bank carries: `lda #0 / sta $1FF4` selects bank0, whose
      7  f000							; $F005 is `jmp GameStart`. The restart ops (game over, last stage cleared) jump
      8  f000							; here: the run restarts at the title and never returns to the caller.
      9  f000				   Restart
     10  f000		       a9 00		      lda	#0
     11  f002		       8d f4 1f 	      sta	BK_GENERAL
     12  f005							; ==============================================================================
     13  f005							; Bank4 — SaveKey service (docs/savekey_design.md, user 2026-10-28).
     14  f005							; ==============================================================================
     15  f005							; A 24LC256 I2C EEPROM on the RIGHT controller port: pin 3 = SDA = SWCHA bit 2,
     16  f005							; pin 4 = SCL = SWCHA bit 3 (Stella SaveKey.cxx). Open drain by hand: the SWCHA
     17  f005							; latch bits stay 0 and a line is driven LOW by setting its SWACNT bit (output)
     18  f005							; or RELEASED by clearing it (input, pulled up in the key). Nothing is ever
     19  f005							; driven high. Bit-banged without delays: every SWACNT store is >= 4 cycles
     20  f005							; (3.4 us), far above the chip's 400 kHz timing.
     21  f005							;
     22  f005							; ONE 12-byte record at SK_ADDR (16-byte aligned: it never straddles a 64-byte
     23  f005							; page), staged in SkBuf for the whole call:
     24  f005							;   0-1 magic $53,$01 (the 2nd byte is the format version)   2 state (1 = save)
     25  f005							;   3 level (0-based)	 4 lives   5-7 score (packed BCD Th,Hu,Te)
     26  f005							;   8-10 HIGH score (packed BCD)  11 checksum = $A5 eor bytes 0-10
     27  f005							; A bad magic/checksum is "no data": the game starts fresh and the next write
     28  f005							; repairs it. No key (NACK on the control byte) aborts every op at once.
     29  f005							;
     30  f005							; SkService (A = op), C=0 when it did something, C=1 when there was nothing to do
     31  f005							;   0 BOOT	   title power-on: Level := the saved stage; the high score goes
     32  f005							;		   to SkHi (vyLo/vyHi/PlayerYSub) for the title to show
     33  f005							;   1 RESUME	   RESET on the saved stage: lives + score := the saved ones
     34  f005							;   2 CHECKPOINT  stage advance (the caller already did `inc Level`): save {Level,
     35  f005							;		   lives, score}; high = max(high,score). Level >= LEVEL_COUNT =
     36  f005							;		   the last stage was cleared: same as GAMEOVER
     37  f005							;   3 GAMEOVER    erase the save; high = max(high, score); then RESTART at the
     38  f005							;		   title (never returns; with no key it just restarts)
     39  f005							; Clobbers A/X/Y, SkB/SkN/SkT/SkL and SkBuf. Leaves SWACNT = 0 (bus released).
     40  f005							; Hotspot for this bank: $1FF8 (F4: bank = addr - $1FF4).
     41  f005							; ==============================================================================
     42  f005		       02 80	   SWCHA      =	$0280
     43  f005		       02 81	   SWACNT     =	$0281
     44  f005		       00 04	   SK_SDA     =	$04	; SWCHA/SWACNT bit of pin 3
     45  f005		       00 08	   SK_SCL     =	$08	; SWCHA/SWACNT bit of pin 4
     46  f005		       00 0c	   SK_BOTH    =	SK_SDA|SK_SCL
     47  f005		       00 7f	   SK_ADDR_H  =	$7F	; record block $7FE0 (open question: AtariVox list)
     48  f005		       00 e0	   SK_ADDR_L  =	$E0
     49  f005		       00 a0	   SK_CTRL_W  =	$A0	; 1010 000 R/W
     50  f005		       00 a1	   SK_CTRL_R  =	$A1
     51  f005		       00 0c	   SK_REC_LEN =	12
     52  f005		       00 02	   R_STATE    =	2
     53  f005		       00 03	   R_LEVEL    =	3
     54  f005		       00 04	   R_LIVES    =	4
     55  f005		       00 05	   R_SCORE    =	5
     56  f005		       00 08	   R_HIGH     =	8
     57  f005		       00 0b	   R_CHK      =	11
     58  f005		       00 08	   LIVES_MAX  =	8
     59  f005		       00 14	   LEVEL_COUNT =	20	; hand copy of the kernel's LEVEL_COUNT
     60  f005
     61  f005							; Game variables (hand copies of kernel.asm; check_equ_sync pairs the names)
     62  f005		       00 a3	   Level      =	$A3
     63  f005		       00 ac	   PlayerLives =	$AC
     64  f005		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock (bank0 RefreshEnemyY)
     65  f005		       00 f3	   ScoreTh    =	$F3
     66  f005		       00 f4	   ScoreHu    =	$F4
     67  f005		       00 f5	   ScoreTe    =	$F5
     68  f005
     69  f005							; Scratch: dead at every call site (title / level load) - see the design doc.
     70  f005		       00 88	   SkB	      =	$88	; byte being shifted (kernel Temp)
     71  f005		       00 89	   SkN	      =	$89	; op flag (kernel ZPSpare89, free)
     72  f005		       00 8b	   SkT	      =	$8B	; (kernel CollisionX)
     73  f005		       00 8e	   SkL	      =	$8E	; loop counter (kernel CollisionEndX)
     74  f005		       00 93	   SkHi       =	$93	; high score handed to the title: vyLo, vyHi, PlayerYSub
     75  f005							;   (dead on the title; bank0 TitleScore reads them)
     76  f005		       00 c3	   SkBuf      =	$C3	; 12 bytes = PF0Buf..PF2Buf (rebuilt by the room load)
     77  f005
     78  f005							; ------------------------------------------------------------------------------
     79  f005							; I2C primitives. Between bits SCL is low; STOP/START leave the bus released/low.
     80  f005							; ------------------------------------------------------------------------------
     81  f005				   SkStart		; bus released -> START, SCL low
     82  f005		       a9 04		      lda	#SK_SDA
     83  f007		       8d 81 02 	      sta	SWACNT	; SDA falls while SCL is high
     84  f00a		       a9 0c		      lda	#SK_BOTH
     85  f00c		       8d 81 02 	      sta	SWACNT
     86  f00f		       60		      rts
     87  f010
     88  f010				   SkStop		; any state -> STOP, bus released
     89  f010		       a9 0c		      lda	#SK_BOTH
     90  f012		       8d 81 02 	      sta	SWACNT	; SDA low, SCL low
     91  f015		       a9 04		      lda	#SK_SDA
     92  f017		       8d 81 02 	      sta	SWACNT	; SCL high
     93  f01a		       a9 00		      lda	#0
     94  f01c		       8d 81 02 	      sta	SWACNT	; SDA rises while SCL is high
     95  f01f		       60		      rts
     96  f020
     97  f020				   SkRestart		; SCL low -> repeated START, SCL low
     98  f020		       a9 08		      lda	#SK_SCL
     99  f022		       8d 81 02 	      sta	SWACNT	; release SDA
    100  f025		       a9 00		      lda	#0
    101  f027		       8d 81 02 	      sta	SWACNT	; release SCL
    102  f02a		       4c 05 f0 	      jmp	SkStart
    103  f02d
    104  f02d							; Send A, MSB first; returns C=0 when the chip ACKed. SCL low, SDA low on exit.
    105  f02d				   SkSend
    106  f02d		       85 88		      sta	SkB
    107  f02f		       a2 08		      ldx	#8
    108  f031				   .SkBit
    109  f031		       06 88		      asl	SkB
    110  f033		       a0 0c		      ldy	#SK_BOTH	; bit 0: SDA low
    111  f035		       90 02		      bcc	.SkOut
    112  f037		       a0 08		      ldy	#SK_SCL	; bit 1: SDA released
    113  f039				   .SkOut
    114  f039		       8c 81 02 	      sty	SWACNT	; data valid, SCL low
    115  f03c		       98		      tya
    116  f03d		       29 04		      and	#SK_SDA
    117  f03f		       8d 81 02 	      sta	SWACNT	; SCL high
    118  f042		       8c 81 02 	      sty	SWACNT	; SCL low
    119  f045		       ca		      dex
    120  f046		       d0 e9		      bne	.SkBit
    121  f048		       a9 08		      lda	#SK_SCL
    122  f04a		       8d 81 02 	      sta	SWACNT	; release SDA for the ACK
    123  f04d		       a9 00		      lda	#0
    124  f04f		       8d 81 02 	      sta	SWACNT	; SCL high: the chip holds SDA low for an ACK
    125  f052		       ad 80 02 	      lda	SWCHA
    126  f055		       29 04		      and	#SK_SDA
    127  f057		       85 8b		      sta	SkT
    128  f059		       a9 08		      lda	#SK_SCL
    129  f05b		       8d 81 02 	      sta	SWACNT	; SCL low
    130  f05e		       a9 0c		      lda	#SK_BOTH
    131  f060		       8d 81 02 	      sta	SWACNT	; SDA low again
    132  f063		       a5 8b		      lda	SkT
    133  f065		       c9 01		      cmp	#1	; C = 1 when SDA stayed high (NACK)
    134  f067		       60		      rts
    135  f068
    136  f068							; Receive a byte into A. C=1 on entry -> NACK it (the last byte), C=0 -> ACK.
    137  f068				   SkRecv
    138  f068		       a9 00		      lda	#0
    139  f06a		       2a		      rol		; A = the ACK bit to send (1 = NACK)
    140  f06b		       85 8b		      sta	SkT
    141  f06d		       a9 08		      lda	#SK_SCL
    142  f06f		       8d 81 02 	      sta	SWACNT	; SDA released, SCL low
    143  f072		       a2 08		      ldx	#8
    144  f074				   .SkRb
    145  f074		       a9 00		      lda	#0
    146  f076		       8d 81 02 	      sta	SWACNT	; SCL high
    147  f079		       ad 80 02 	      lda	SWCHA
    148  f07c		       29 04		      and	#SK_SDA
    149  f07e		       c9 01		      cmp	#1	; C = the data bit
    150  f080		       26 88		      rol	SkB
    151  f082		       a9 08		      lda	#SK_SCL
    152  f084		       8d 81 02 	      sta	SWACNT	; SCL low
    153  f087		       ca		      dex
    154  f088		       d0 ea		      bne	.SkRb
    155  f08a		       a0 0c		      ldy	#SK_BOTH	; ACK: SDA low
    156  f08c		       a5 8b		      lda	SkT
    157  f08e		       f0 02		      beq	.SkAck
    158  f090		       a0 08		      ldy	#SK_SCL	; NACK: SDA released
    159  f092				   .SkAck
    160  f092		       8c 81 02 	      sty	SWACNT
    161  f095		       98		      tya
    162  f096		       29 04		      and	#SK_SDA
    163  f098		       8d 81 02 	      sta	SWACNT	; SCL high
    164  f09b		       8c 81 02 	      sty	SWACNT	; SCL low
    165  f09e		       a9 08		      lda	#SK_SCL
    166  f0a0		       8d 81 02 	      sta	SWACNT	; release SDA
    167  f0a3		       a5 88		      lda	SkB
    168  f0a5		       60		      rts
