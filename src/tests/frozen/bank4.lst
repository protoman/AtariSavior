     78  f005							; ------------------------------------------------------------------------------
     79  f005							; I2C primitives. Between bits SCL is low; STOP/START leave the bus released/low.
     80  f005							; ------------------------------------------------------------------------------
     81  f005				   SkStart		; bus released -> START, SCL low
     82  f005		       a9 04		      lda	#SK_SDA
     83  f007		       8d 81 02 	      sta	SWACNT	; SDA falls while SCL is high
     84  f00a		       a9 0c		      lda	#SK_BOTH
     85  f00c		       8d 81 02 	      sta	SWACNT
     86  f00f		       60		      rts
     87  f010
     88  f010				   SkStop		; any state -> STOP, bus released
     89  f010		       a9 0c		      lda	#SK_BOTH
     90  f012		       8d 81 02 	      sta	SWACNT	; SDA low, SCL low
     91  f015		       a9 04		      lda	#SK_SDA
     92  f017		       8d 81 02 	      sta	SWACNT	; SCL high
     93  f01a		       a9 00		      lda	#0
     94  f01c		       8d 81 02 	      sta	SWACNT	; SDA rises while SCL is high
     95  f01f		       60		      rts
     96  f020
     97  f020				   SkRestart		; SCL low -> repeated START, SCL low
     98  f020		       a9 08		      lda	#SK_SCL
