    176  f0ad		       88		      dey
    177  f0ae		       10 fa		      bpl	.SkS1
    178  f0b0		       60		      rts
    179  f0b1
    180  f0b1							; SkLoad: read the record into SkBuf.
    181  f0b1							; C=0 valid. C=1 with A=0: no key (nothing else is worth trying); A=1: bad data.
    182  f0b1				   SkLoad
    183  f0b1		       a9 00		      lda	#0
    184  f0b3		       8d 80 02 	      sta	SWCHA	; latch low for pins 3/4 (never drive high)
    185  f0b6		       8d 81 02 	      sta	SWACNT
