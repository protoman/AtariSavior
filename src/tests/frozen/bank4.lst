     96  fcea		       4c 58 fc 	      jmp	$FC58
     97  fced
     98  fced
     99  fced							; ==============================================================================
    100  fced							; DemoHook (attract mode, 2026-11) — runs at the END of every non-plain frame
    101  fced							; (title, drop-in, tally, demo), from TransBody. Entered with A != 0.
    102  fced							;   title idle  : 300 frames (5 s) with every title input released -> start the demo
    103  fced							;   demo	 : play DemoScript through StickA/DemoOn (EOR-ed onto the real
    104  fced							;		   SWCHA/INPT4 reads), any real input -> back to the title
    105  fced							;   reload	 : LevelConnSpare = $A0 makes TransBody run LoadLevel in a blank
    106  fced							;		   frame (like a room change); DropTarget decides the result:
    107  fced							;		   0 = the real drop-in (demo), $FF = the title preview.
    108  fced							; The demo is the REAL game on the selected stage (so the logo/credits band hook
    109  fced							; of the title is off by design); lives are topped up every frame, nothing saves.
    110  fced							; ==============================================================================
    111  fced				   DemoHook
    112  fced		       a5 dd		      lda	DemoOn
    113  fcef		       d0 3c		      bne	.DHdemo
    114  fcf1		       a5 8a		      lda	DropTarget
    115  fcf3		       c9 ff		      cmp	#$FF
    116  fcf5		       d0 33		      bne	.DHout	; drop-in fall / tally sentinel: not ours
    117  fcf7		       a5 97		      lda	StepsLeft	; title's last input sample (1 = released)
    118  fcf9		       29 17		      and	#$17
    119  fcfb		       c9 17		      cmp	#$17
    120  fcfd		       d0 20		      bne	.DHidleReset
    121  fcff		       e6 df		      inc	DemoDur
    122  fd01		       a5 df		      lda	DemoDur
    123  fd03		       c9 96		      cmp	#IDLE_FRAMES
    124  fd05		       90 1e		      bcc	.DHwait
    125  fd07		       a9 00		      lda	#0
    126  fd09		       85 df		      sta	DemoDur
    127  fd0b		       e6 de		      inc	DemoPos
    128  fd0d		       a5 de		      lda	DemoPos
    129  fd0f		       c9 02		      cmp	#2
    130  fd11		       90 12		      bcc	.DHwait
    131  fd13		       a5 a3		      lda	Level
    132  fd15		       09 40		      ora	#$40
    133  fd17		       85 dd		      sta	DemoOn	; 5 s of nothing: play (remembering the title's stage)
    134  fd19		       a9 00		      lda	#0
    135  fd1b		       85 a3		      sta	Level	; the demo is scripted on stage 1 whatever is selected
    136  fd1d		       f0 59		      beq	DHreload	; always taken
    137  fd1f				   .DHidleReset
    138  fd1f		       a9 00		      lda	#0
    139  fd21		       85 df		      sta	DemoDur
    140  fd23		       85 de		      sta	DemoPos
    141  fd25				   .DHwait		; a title frame ends with its overscan timer
    142  fd25		       ad 84 02 	      lda	INTIM
    143  fd28		       d0 fb		      bne	.DHwait
    144  fd2a				   .DHout
    145  fd2a		       4c 58 fc 	      jmp	$FC58
    146  fd2d				   .DHdemo
    147  fd2d		       a5 8a		      lda	DropTarget
    148  fd2f		       c9 ff		      cmp	#$FF
    149  fd31		       f0 6d		      beq	DHabort	; a console switch (REY) already sent us to the title:
    150  fd33							;   only the stage number and the preview are left to fix
    151  fd33		       ad 80 02 	      lda	SWCHA
    152  fd36		       29 f0		      and	#$F0
    153  fd38		       c9 f0		      cmp	#$F0
    154  fd3a		       d0 64		      bne	DHabort	; stick moved
    155  fd3c		       a5 0c		      lda	INPT4
    156  fd3e		       10 60		      bpl	DHabort	; fire
    157  fd40		       ad 82 02 	      lda	SWCHB
    158  fd43		       29 03		      and	#3
    159  fd45		       c9 03		      cmp	#3
    160  fd47		       d0 57		      bne	DHabort	; SELECT / RESET
    161  fd49		       a9 03		      lda	#3
    162  fd4b		       85 ac		      sta	PlayerLives	; the demo never loses
    163  fd4d		       c6 df		      dec	DemoDur
    164  fd4f		       d0 d9		      bne	.DHout	; mid-step: the virtual presses stay
    165  fd51		       a4 de		      ldy	DemoPos
    166  fd53		       b9 c9 fd 	      lda	DemoScript,y	; step = duration, presses (D7-D4 = R L D U, D0 = fire)
    167  fd56		       f0 20		      beq	DHloop	; 0 = end of script: restart it
    168  fd58		       85 df		      sta	DemoDur
    169  fd5a		       b9 ca fd 	      lda	DemoScript+1,y
    170  fd5d		       aa		      tax
    171  fd5e		       29 f0		      and	#$F0
    172  fd60		       85 dc		      sta	StickA
    173  fd62		       a5 dd		      lda	DemoOn
    174  fd64		       29 7f		      and	#$7F
    175  fd66		       85 dd		      sta	DemoOn
    176  fd68		       8a		      txa
    177  fd69		       4a		      lsr		; C = fire
    178  fd6a		       90 06		      bcc	.DHnoFire
    179  fd6c		       a5 dd		      lda	DemoOn
    180  fd6e		       09 80		      ora	#$80	; EOR-ed onto INPT4 D7: pressed
    181  fd70		       85 dd		      sta	DemoOn
    182  fd72				   .DHnoFire
    183  fd72		       c8		      iny
    184  fd73		       c8		      iny
    185  fd74		       84 de		      sty	DemoPos
    186  fd76		       d0 b2		      bne	.DHout	; always taken (script < 256 B)
    187  fd78				   DHloop
    188  fd78				   DHreload
    189  fd78		       a5 dd		      lda	DemoOn
    190  fd7a		       29 7f		      and	#$7F
    191  fd7c		       85 dd		      sta	DemoOn	; fire released
    192  fd7e		       a9 00		      lda	#0
    193  fd80		       85 dc		      sta	StickA
    194  fd82		       85 de		      sta	DemoPos
    195  fd84		       85 8a		      sta	DropTarget	; 0 -> LoadLevel arms the real drop-in
    196  fd86		       85 f3		      sta	ScoreTh
    197  fd88		       85 f4		      sta	ScoreHu
    198  fd8a		       85 f5		      sta	ScoreTe
    199  fd8c		       85 f6		      sta	BombX	; the title melody's state byte
    200  fd8e		       a9 01		      lda	#1
    201  fd90		       85 df		      sta	DemoDur	; next frame fetches step 0
    202  fd92		       a9 03		      lda	#3
    203  fd94		       85 ac		      sta	PlayerLives
    204  fd96		       a9 3c		      lda	#TICKS_PER_SEC
    205  fd98		       85 ad		      sta	TickCounter
    206  fd9a		       a9 78		      lda	#120
    207  fd9c		       85 ae		      sta	BarLevel
    208  fd9e		       d0 22		      bne	DHpend
    209  fda0				   DHabort		; back to the title (the REY exit's state)
    210  fda0		       a5 dd		      lda	DemoOn
    211  fda2		       29 3f		      and	#$3F
    212  fda4		       85 a3		      sta	Level	; the stage the player had selected
    213  fda6		       a9 00		      lda	#0
    214  fda8		       85 dd		      sta	DemoOn
    215  fdaa		       85 dc		      sta	StickA
    216  fdac		       85 de		      sta	DemoPos
    217  fdae		       85 df		      sta	DemoDur
    218  fdb0		       85 f6		      sta	BombX
    219  fdb2		       85 f7		      sta	BombTimer
    220  fdb4		       85 f3		      sta	ScoreTh
    221  fdb6		       85 f4		      sta	ScoreHu
    222  fdb8		       85 f5		      sta	ScoreTe
    223  fdba		       a9 e8		      lda	#%11101000	; SELECT/RESET/UP/DOWN/FIRE count as held: no instant start
    224  fdbc		       85 97		      sta	StepsLeft
    225  fdbe		       a9 ff		      lda	#$FF
    226  fdc0		       85 8a		      sta	DropTarget
    227  fdc2				   DHpend
    228  fdc2		       a9 a0		      lda	#$A0
    229  fdc4		       85 a2		      sta	LevelConnSpare
    230  fdc6		       4c 8a fc 	      jmp	TBgo
    231  fdc9
    232  fdc9							; The script: duration (frames), presses. Presses: $80 right, $40 left, $20 down
    233  fdc9							; (drops the bomb on its press edge, standing only), $10 up (jet), $01 fire (laser).
    234  fdc9							; Stage 1 (the pocket under the start): fall in, walk to both walls, drop a bomb,
    235  fdc9							; fly out over it (the laser fires while flying), hover until it has gone off,
    236  fdc9							; then glide back to the drop-in spot (X=39, Y=0, facing right) for a seamless loop. The first step covers the drop-in (~72 frames) and the free fall.
    237  fdc9				   DemoScript
    238  fdc9		       8c 00		      .byte.b	140, $00	; drop-in + fall to the floor
    239  fdcb		       0c 80		      .byte.b	12, $80	; walk right to the wall
    240  fdcd		       0e 40		      .byte.b	14, $40	; walk left (faces left)
    241  fdcf		       03 20		      .byte.b	3, $20	; DOWN: bomb
    242  fdd1		       02 00		      .byte.b	2, $00
    243  fdd3		       0e 80		      .byte.b	14, $80	; walk right, away from it
    244  fdd5		       28 10		      .byte.b	40, $10	; jet up out of the pocket
    245  fdd7		       1e 90		      .byte.b	30, $90	; up + right
    246  fdd9		       28 11		      .byte.b	40, $11	; up + FIRE: laser
    247  fddb		       23 50		      .byte.b	35, $50	; up + left
    248  fddd		       23 90		      .byte.b	35, $90	; up + right
    249  fddf		       28 11		      .byte.b	40, $11	; up + FIRE
    250  fde1		       1e 10		      .byte.b	30, $10
    251  fde3		       27 50		      .byte.b	39, $50	; up + left along the ceiling ...
    252  fde5		       06 90		      .byte.b	6, $90	; ... and back right: ends at X=39, facing right, Y=0 --
    253  fde7		       0a 10		      .byte.b	10, $10	;   exactly where the next drop-in starts (a seamless loop)
    254  fde9		       00		      .byte.b	0	; end: restart the demo
    255  fdea
------- FILE bank4.asm
    558  fdea
    559  fdea		       00 00 00 00*	      .ds	$FFFA - *, 0
    560  fffa		       00 f0		      .word.w	$F000
    561  fffc		       00 f0		      .word.w	$F000
    562  fffe		       00 f0		      .word.w	$F000
