------- FILE bank4.asm LEVEL 1 PASS 2
      1  fffe					      processor	6502
      2  10000 ????				       seg	code
      3  f000					      org	$F000
      4  f000							; The power-up pad every bank carries: `lda #0 / sta $1FF4` selects bank0, whose
      5  f000							; $F005 is `jmp GameStart`. The restart ops (game over, last stage cleared) jump
      6  f000							; here: the run restarts at the title and never returns to the caller.
      7  f000				   Restart
      8  f000		       a9 00		      lda	#0
      9  f002		       8d f4 1f 	      sta	$1FF4
     10  f005							; ==============================================================================
     11  f005							; Bank4 — SaveKey service (docs/savekey_design.md, user 2026-10-28).
     12  f005							; ==============================================================================
     13  f005							; A 24LC256 I2C EEPROM on the RIGHT controller port: pin 3 = SDA = SWCHA bit 2,
     14  f005							; pin 4 = SCL = SWCHA bit 3 (Stella SaveKey.cxx). Open drain by hand: the SWCHA
     15  f005							; latch bits stay 0 and a line is driven LOW by setting its SWACNT bit (output)
     16  f005							; or RELEASED by clearing it (input, pulled up in the key). Nothing is ever
     17  f005							; driven high. Bit-banged without delays: every SWACNT store is >= 4 cycles
     18  f005							; (3.4 us), far above the chip's 400 kHz timing.
     19  f005							;
     20  f005							; ONE 12-byte record at SK_ADDR (16-byte aligned: it never straddles a 64-byte
     21  f005							; page), staged in SkBuf for the whole call:
     22  f005							;   0-1 magic $53,$01 (the 2nd byte is the format version)   2 state (1 = save)
     23  f005							;   3 level (0-based)	 4 lives   5-7 score (packed BCD Th,Hu,Te)
     24  f005							;   8-10 HIGH score (packed BCD)  11 checksum = $A5 eor bytes 0-10
     25  f005							; A bad magic/checksum is "no data": the game starts fresh and the next write
     26  f005							; repairs it. No key (NACK on the control byte) aborts every op at once.
     27  f005							;
     28  f005							; SkService (A = op), C=0 when it did something, C=1 when there was nothing to do
     29  f005							;   0 BOOT	   title power-on: Level := the saved stage
     30  f005							;   1 RESUME	   RESET on the saved stage: lives + score := the saved ones
     31  f005							;   2 CHECKPOINT  stage advance (the caller already did `inc Level`): save {Level,
     32  f005							;		   lives, score}; high = max(high,score). Level >= LEVEL_COUNT =
     33  f005							;		   the last stage was cleared: same as GAMEOVER
     34  f005							;   3 GAMEOVER    erase the save; high = max(high, score); then RESTART at the
     35  f005							;		   title (never returns; with no key it just restarts)
     36  f005							; Clobbers A/X/Y, SkB/SkN/SkT/SkL and SkBuf. Leaves SWACNT = 0 (bus released).
     37  f005							; Hotspot for this bank: $1FF8 (F4: bank = addr - $1FF4).
     38  f005							; ==============================================================================
     39  f005		       02 80	   SWCHA      =	$0280
     40  f005		       02 81	   SWACNT     =	$0281
     41  f005		       00 04	   SK_SDA     =	$04	; SWCHA/SWACNT bit of pin 3
     42  f005		       00 08	   SK_SCL     =	$08	; SWCHA/SWACNT bit of pin 4
     43  f005		       00 0c	   SK_BOTH    =	SK_SDA|SK_SCL
     44  f005		       00 7f	   SK_ADDR_H  =	$7F	; record block $7FE0 (open question: AtariVox list)
     45  f005		       00 e0	   SK_ADDR_L  =	$E0
     46  f005		       00 a0	   SK_CTRL_W  =	$A0	; 1010 000 R/W
     47  f005		       00 a1	   SK_CTRL_R  =	$A1
     48  f005		       00 0c	   SK_REC_LEN =	12
     49  f005		       00 02	   R_STATE    =	2
     50  f005		       00 03	   R_LEVEL    =	3
     51  f005		       00 04	   R_LIVES    =	4
     52  f005		       00 05	   R_SCORE    =	5
     53  f005		       00 08	   R_HIGH     =	8
     54  f005		       00 0b	   R_CHK      =	11
     55  f005		       00 08	   LIVES_MAX  =	8
     56  f005		       00 14	   LEVEL_COUNT =	20	; hand copy of the kernel's LEVEL_COUNT
     57  f005
     58  f005							; Game variables (hand copies of kernel.asm; check_equ_sync pairs the names)
     59  f005		       00 a3	   Level      =	$A3
     60  f005		       00 ac	   PlayerLives =	$AC
     61  f005		       00 f3	   ScoreTh    =	$F3
     62  f005		       00 f4	   ScoreHu    =	$F4
     63  f005		       00 f5	   ScoreTe    =	$F5
     64  f005
     65  f005							; Scratch: dead at every call site (title / level load) - see the design doc.
     66  f005		       00 88	   SkB	      =	$88	; byte being shifted (kernel Temp)
     67  f005		       00 89	   SkN	      =	$89	; op flag (kernel ZPSpare89, free)
     68  f005		       00 8b	   SkT	      =	$8B	; (kernel CollisionX)
     69  f005		       00 8e	   SkL	      =	$8E	; loop counter (kernel CollisionEndX)
     70  f005		       00 c3	   SkBuf      =	$C3	; 12 bytes = PF0Buf..PF2Buf (rebuilt by the room load)
     71  f005
     72  f005							; ------------------------------------------------------------------------------
     73  f005							; I2C primitives. Between bits SCL is low; STOP/START leave the bus released/low.
     74  f005							; ------------------------------------------------------------------------------
     75  f005				   SkStart		; bus released -> START, SCL low
     76  f005		       a9 04		      lda	#SK_SDA
     77  f007		       8d 81 02 	      sta	SWACNT	; SDA falls while SCL is high
     78  f00a		       a9 0c		      lda	#SK_BOTH
     79  f00c		       8d 81 02 	      sta	SWACNT
     80  f00f		       60		      rts
     81  f010
     82  f010				   SkStop		; any state -> STOP, bus released
     83  f010		       a9 0c		      lda	#SK_BOTH
     84  f012		       8d 81 02 	      sta	SWACNT	; SDA low, SCL low
     85  f015		       a9 04		      lda	#SK_SDA
     86  f017		       8d 81 02 	      sta	SWACNT	; SCL high
     87  f01a		       a9 00		      lda	#0
     88  f01c		       8d 81 02 	      sta	SWACNT	; SDA rises while SCL is high
     89  f01f		       60		      rts
     90  f020
     91  f020				   SkRestart		; SCL low -> repeated START, SCL low
     92  f020		       a9 08		      lda	#SK_SCL
     93  f022		       8d 81 02 	      sta	SWACNT	; release SDA
     94  f025		       a9 00		      lda	#0
     95  f027		       8d 81 02 	      sta	SWACNT	; release SCL
     96  f02a		       4c 05 f0 	      jmp	SkStart
     97  f02d
     98  f02d							; Send A, MSB first; returns C=0 when the chip ACKed. SCL low, SDA low on exit.
     99  f02d				   SkSend
    100  f02d		       85 88		      sta	SkB
    101  f02f		       a2 08		      ldx	#8
    102  f031				   .SkBit
    103  f031		       06 88		      asl	SkB
    104  f033		       a0 0c		      ldy	#SK_BOTH	; bit 0: SDA low
    105  f035		       90 02		      bcc	.SkOut
    106  f037		       a0 08		      ldy	#SK_SCL	; bit 1: SDA released
    107  f039				   .SkOut
    108  f039		       8c 81 02 	      sty	SWACNT	; data valid, SCL low
    109  f03c		       98		      tya
    110  f03d		       29 04		      and	#SK_SDA
    111  f03f		       8d 81 02 	      sta	SWACNT	; SCL high
    112  f042		       8c 81 02 	      sty	SWACNT	; SCL low
    113  f045		       ca		      dex
    114  f046		       d0 e9		      bne	.SkBit
    115  f048		       a9 08		      lda	#SK_SCL
    116  f04a		       8d 81 02 	      sta	SWACNT	; release SDA for the ACK
    117  f04d		       a9 00		      lda	#0
    118  f04f		       8d 81 02 	      sta	SWACNT	; SCL high: the chip holds SDA low for an ACK
    119  f052		       ad 80 02 	      lda	SWCHA
    120  f055		       29 04		      and	#SK_SDA
    121  f057		       85 8b		      sta	SkT
    122  f059		       a9 08		      lda	#SK_SCL
    123  f05b		       8d 81 02 	      sta	SWACNT	; SCL low
    124  f05e		       a9 0c		      lda	#SK_BOTH
    125  f060		       8d 81 02 	      sta	SWACNT	; SDA low again
    126  f063		       a5 8b		      lda	SkT
    127  f065		       c9 01		      cmp	#1	; C = 1 when SDA stayed high (NACK)
    128  f067		       60		      rts
    129  f068
    130  f068							; Receive a byte into A. C=1 on entry -> NACK it (the last byte), C=0 -> ACK.
    131  f068				   SkRecv
    132  f068		       a9 00		      lda	#0
    133  f06a		       2a		      rol		; A = the ACK bit to send (1 = NACK)
    134  f06b		       85 8b		      sta	SkT
    135  f06d		       a9 08		      lda	#SK_SCL
    136  f06f		       8d 81 02 	      sta	SWACNT	; SDA released, SCL low
    137  f072		       a2 08		      ldx	#8
    138  f074				   .SkRb
    139  f074		       a9 00		      lda	#0
    140  f076		       8d 81 02 	      sta	SWACNT	; SCL high
    141  f079		       ad 80 02 	      lda	SWCHA
    142  f07c		       29 04		      and	#SK_SDA
    143  f07e		       c9 01		      cmp	#1	; C = the data bit
    144  f080		       26 88		      rol	SkB
    145  f082		       a9 08		      lda	#SK_SCL
    146  f084		       8d 81 02 	      sta	SWACNT	; SCL low
    147  f087		       ca		      dex
    148  f088		       d0 ea		      bne	.SkRb
    149  f08a		       a0 0c		      ldy	#SK_BOTH	; ACK: SDA low
    150  f08c		       a5 8b		      lda	SkT
    151  f08e		       f0 02		      beq	.SkAck
    152  f090		       a0 08		      ldy	#SK_SCL	; NACK: SDA released
    153  f092				   .SkAck
    154  f092		       8c 81 02 	      sty	SWACNT
    155  f095		       98		      tya
    156  f096		       29 04		      and	#SK_SDA
    157  f098		       8d 81 02 	      sta	SWACNT	; SCL high
    158  f09b		       8c 81 02 	      sty	SWACNT	; SCL low
    159  f09e		       a9 08		      lda	#SK_SCL
    160  f0a0		       8d 81 02 	      sta	SWACNT	; release SDA
    161  f0a3		       a5 88		      lda	SkB
    162  f0a5		       60		      rts
    163  f0a6
    164  f0a6							; ------------------------------------------------------------------------------
    165  f0a6							; Record transactions
    166  f0a6							; ------------------------------------------------------------------------------
    167  f0a6				   SkSum		; A = $A5 eor SkBuf[0..10]
    168  f0a6		       a9 a5		      lda	#$A5
    169  f0a8		       a0 0a		      ldy	#R_CHK-1
    170  f0aa				   .SkS1
    171  f0aa		       59 c3 00 	      eor	SkBuf,y
    172  f0ad		       88		      dey
    173  f0ae		       10 fa		      bpl	.SkS1
    174  f0b0		       60		      rts
    175  f0b1
    176  f0b1							; SkLoad: read the record into SkBuf.
    177  f0b1							; C=0 valid. C=1 with A=0: no key (nothing else is worth trying); A=1: bad data.
    178  f0b1				   SkLoad
    179  f0b1		       a9 00		      lda	#0
    180  f0b3		       8d 80 02 	      sta	SWCHA	; latch low for pins 3/4 (never drive high)
    181  f0b6		       8d 81 02 	      sta	SWACNT
    182  f0b9		       20 05 f0 	      jsr	SkStart
    183  f0bc		       a9 a0		      lda	#SK_CTRL_W
    184  f0be		       20 2d f0 	      jsr	SkSend
    185  f0c1		       b0 3d		      bcs	.SkAbsent
    186  f0c3		       a9 7f		      lda	#SK_ADDR_H
    187  f0c5		       20 2d f0 	      jsr	SkSend
    188  f0c8		       a9 e0		      lda	#SK_ADDR_L
