    357  f1e1							; The two writers share SkPrep (entered by `jmp`, so the call chain stays at
    358  f1e1							; pad 2 + SkLoad 2 + a leaf 2 = 6 stack bytes - the stack mirror is only 8 wide).
    359  f1e1							; SkN = 2 checkpoint, 3 game over. A missing key ends the op, bad data leaves a
    360  f1e1							; zero high score. SkBuf[R_HIGH..] = max(old high, current score) on the way out.
    361  f1e1				   SkCheckpoint
    362  f1e1		       a5 a3		      lda	Level
    363  f1e3		       c9 14		      cmp	#LEVEL_COUNT
    364  f1e5		       90 04		      bcc	SkWriter	; a stage advance
    365  f1e7		       a9 03		      lda	#3
    366  f1e9		       85 89		      sta	SkN	; the last stage was cleared: the run is over
    367  f1eb				   SkWriter
    368  f1eb		       20 b1 f0 	      jsr	SkLoad
    369  f1ee		       90 10		      bcc	.SkHave
    370  f1f0		       c9 00		      cmp	#0
    371  f1f2		       d0 04		      bne	.SkBadData
