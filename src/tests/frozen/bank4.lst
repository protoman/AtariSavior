    190  f0cd		       20 20 f0 	      jsr	SkRestart
    191  f0d0		       a9 a1		      lda	#SK_CTRL_R
    192  f0d2		       20 2d f0 	      jsr	SkSend
    193  f0d5		       a0 00		      ldy	#0
    194  f0d7				   .SkRd
    195  f0d7		       84 8e		      sty	SkL
    196  f0d9		       c0 0b		      cpy	#SK_REC_LEN-1	; C=1 for the last byte: NACK it
    197  f0db		       20 68 f0 	      jsr	SkRecv
    198  f0de		       a4 8e		      ldy	SkL
    199  f0e0		       99 c3 00 	      sta	SkBuf,y
    200  f0e3		       c8		      iny
    201  f0e4		       c0 0c		      cpy	#SK_REC_LEN
    202  f0e6		       d0 ef		      bne	.SkRd
    203  f0e8		       20 10 f0 	      jsr	SkStop
    204  f0eb		       a5 c3		      lda	SkBuf
    205  f0ed		       c9 53		      cmp	#$53
    206  f0ef		       d0 16		      bne	.SkBad
    207  f0f1		       a5 c4		      lda	SkBuf+1
