    415  f243
    416  f243							; Op 4 TITLE (every title frame, no I2C): the HUD score window shows the 1-based
    417  f243							; stage number (packed BCD, 000001 = stage 1) and, for 64 of every 256 frames
    418  f243							; (EnemyRamP $80-$BF; it restarts at $F0 on every LoadLevel, so SELECT always
    419  f243							; shows the stage first), the HIGH SCORE BOOT left in SkHi. No high score (no key,
    420  f243							; blank chip) = the stage number only. DropArm's title path writes the same stage
    421  f243							; number once per LoadLevel (SELECT); this keeps it right in between.
    422  f243				   SkTitle
    423  f243		       a5 a3		      lda	Level
    424  f245		       18		      clc
    425  f246		       69 01		      adc	#1
    426  f248		       a2 00		      ldx	#0
    427  f24a				   .SkTen
    428  f24a		       c9 0a		      cmp	#10
    429  f24c		       90 05		      bcc	.SkOnes
    430  f24e		       e9 0a		      sbc	#10
    431  f250		       e8		      inx
    432  f251		       d0 f7		      bne	.SkTen	; (X <= 2: always taken)
    433  f253				   .SkOnes
    434  f253		       85 88		      sta	SkB
    435  f255		       8a		      txa
    436  f256		       0a		      asl
    437  f257		       0a		      asl
    438  f258		       0a		      asl
    439  f259		       0a		      asl
    440  f25a		       05 88		      ora	SkB
    441  f25c		       85 f5		      sta	ScoreTe	; packed BCD: tens, ones
    442  f25e		       a9 00		      lda	#0
    443  f260		       85 f3		      sta	ScoreTh
    444  f262		       85 f4		      sta	ScoreHu
    445  f264		       a5 c2		      lda	EnemyRamP
    446  f266		       29 c0		      and	#$C0
    447  f268		       c9 80		      cmp	#$80
    448  f26a		       d0 11		      bne	.SkTdone	; only clock $80-$BF (64 of 256 frames) shows it
    449  f26c		       a5 93		      lda	SkHi
    450  f26e		       05 94		      ora	SkHi+1
    451  f270		       05 95		      ora	SkHi+2
    452  f272		       f0 09		      beq	.SkTdone	; no high score yet
    453  f274		       a2 02		      ldx	#2
    454  f276				   .SkTHi
    455  f276		       b5 93		      lda	SkHi,x
    456  f278		       95 f3		      sta	ScoreTh,x
    457  f27a		       ca		      dex
    458  f27b		       10 f9		      bpl	.SkTHi
    459  f27d				   .SkTdone
