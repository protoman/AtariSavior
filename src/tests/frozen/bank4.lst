     19  fc83		       00 f4	   ScoreHu    =	$F4
     20  fc83		       00 f5	   ScoreTe    =	$F5
     21  fc83		       00 f6	   BombX      =	$F6
     22  fc83		       00 f7	   BombTimer  =	$F7
     23  fc83		       00 dc	   StickA     =	$DC
     24  fc83		       00 dd	   DemoOn     =	$DD	; b7 = virtual FIRE, b6 = demo playing, b5-0 = the title's Level
     25  fc83		       00 a3	   Level      =	$A3
     26  fc83		       00 de	   DemoPos    =	$DE
     27  fc83		       00 df	   DemoDur    =	$DF
