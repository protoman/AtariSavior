      1  fffe					      processor	6502
      2  10000 ????				       seg	code
------- FILE banks.inc LEVEL 2 PASS 2
      0  10000 ????				       include	"banks.inc"	; BK_* bank selectors by role (docs/agents/banks.md)
      1  10000 ????						; ==============================================================================
      2  10000 ????						; Bank selectors by ROLE (docs/agents/banks.md). Code never writes a literal $1FF4-$1FFB: it writes
      3  10000 ????						; the selector of the bank that holds the ROLE it wants (`sta BK_ROOMS`), so the physical bank
      4  10000 ????						; number of every role is decided HERE and nowhere else. The F4 hotspot of physical bank n is $1FF4+n.
      5  10000 ????						;
      6  10000 ????						; BKI_x = the physical bank (0-7) that holds role x. OLD layout (what build.sh assembles today):
      7  10000 ????						; ==============================================================================
      8  10000 ????		00 00	    BKI_GENERAL =	0	; main loop, input, physics, collision, sound, the fold pads
      9  10000 ????		00 01	    BKI_HUD    =	1	; HUD, title and level select, raft, bomb wall marks, strip blast
     10  10000 ????		00 02	    BKI_ROOMS  =	2	; level room half: room readers, exits, laser, moth, blast + the room tables
     11  10000 ????		00 03	    BKI_EXTRAS =	3	; level extras half: phase/hcrunch/hot/dark walkers + the extras data
     12  10000 ????		00 04	    BKI_SAVE   =	4	; save-to-cartridge (I2C)
     13  10000 ????		00 05	    BKI_TRANS  =	5	; version header, blank transition frame, attract script
     14  10000 ????		00 06	    BKI_CAVE   =	6	; the generated gameplay cave kernel
     15  10000 ????		00 07	    BKI_PROLOGUE =	7	; cave kernel start-up code
     16  10000 ????		00 04	    BKI_MODELS =	4	; room models: the shape step + the shape blocks / row pool (shares bank4, plan phase 3)
     17  10000 ????
     18  10000 ????		1f f4	    BK_GENERAL =	$1FF4 + BKI_GENERAL
     19  10000 ????		1f f5	    BK_HUD     =	$1FF4 + BKI_HUD
     20  10000 ????		1f f6	    BK_ROOMS   =	$1FF4 + BKI_ROOMS
     21  10000 ????		1f f7	    BK_EXTRAS  =	$1FF4 + BKI_EXTRAS
     22  10000 ????		1f f8	    BK_SAVE    =	$1FF4 + BKI_SAVE
     23  10000 ????		1f f9	    BK_TRANS   =	$1FF4 + BKI_TRANS
     24  10000 ????		1f fa	    BK_CAVE    =	$1FF4 + BKI_CAVE
     25  10000 ????		1f fb	    BK_PROLOGUE =	$1FF4 + BKI_PROLOGUE
     26  10000 ????		1f f8	    BK_MODELS  =	$1FF4 + BKI_MODELS
------- FILE bank4.asm
      4  f000					      org	$F000
      5  f000							; The power-up pad every bank carries: `lda #0 / sta $1FF4` selects bank0, whose
      6  f000							; $F005 is `jmp GameStart`. The restart ops (game over, last stage cleared) jump
      7  f000							; here: the run restarts at the title and never returns to the caller.
      8  f000				   Restart
      9  f000		       a9 00		      lda	#0
     10  f002		       8d f4 1f 	      sta	BK_GENERAL
     11  f005							; ==============================================================================
     12  f005							; Bank4 — SaveKey service (docs/savekey_design.md, user 2026-10-28).
     13  f005							; ==============================================================================
     14  f005							; A 24LC256 I2C EEPROM on the RIGHT controller port: pin 3 = SDA = SWCHA bit 2,
     15  f005							; pin 4 = SCL = SWCHA bit 3 (Stella SaveKey.cxx). Open drain by hand: the SWCHA
     16  f005							; latch bits stay 0 and a line is driven LOW by setting its SWACNT bit (output)
     17  f005							; or RELEASED by clearing it (input, pulled up in the key). Nothing is ever
     18  f005							; driven high. Bit-banged without delays: every SWACNT store is >= 4 cycles
     19  f005							; (3.4 us), far above the chip's 400 kHz timing.
     20  f005							;
     21  f005							; ONE 12-byte record at SK_ADDR (16-byte aligned: it never straddles a 64-byte
     22  f005							; page), staged in SkBuf for the whole call:
     23  f005							;   0-1 magic $53,$01 (the 2nd byte is the format version)   2 state (1 = save)
     24  f005							;   3 level (0-based)	 4 lives   5-7 score (packed BCD Th,Hu,Te)
     25  f005							;   8-10 HIGH score (packed BCD)  11 checksum = $A5 eor bytes 0-10
     26  f005							; A bad magic/checksum is "no data": the game starts fresh and the next write
     27  f005							; repairs it. No key (NACK on the control byte) aborts every op at once.
     28  f005							;
     29  f005							; SkService (A = op), C=0 when it did something, C=1 when there was nothing to do
     30  f005							;   0 BOOT	   title power-on: Level := the saved stage; the high score goes
     31  f005							;		   to SkHi (vyLo/vyHi/PlayerYSub) for the title to show
     32  f005							;   1 RESUME	   RESET on the saved stage: lives + score := the saved ones
     33  f005							;   2 CHECKPOINT  stage advance (the caller already did `inc Level`): save {Level,
     34  f005							;		   lives, score}; high = max(high,score). Level >= LEVEL_COUNT =
     35  f005							;		   the last stage was cleared: same as GAMEOVER
     36  f005							;   3 GAMEOVER    erase the save; high = max(high, score); then RESTART at the
     37  f005							;		   title (never returns; with no key it just restarts)
     38  f005							; Clobbers A/X/Y, SkB/SkN/SkT/SkL and SkBuf. Leaves SWACNT = 0 (bus released).
     39  f005							; Hotspot for this bank: $1FF8 (F4: bank = addr - $1FF4).
     40  f005							; ==============================================================================
     41  f005		       02 80	   SWCHA      =	$0280
     42  f005		       02 81	   SWACNT     =	$0281
     43  f005		       00 04	   SK_SDA     =	$04	; SWCHA/SWACNT bit of pin 3
     44  f005		       00 08	   SK_SCL     =	$08	; SWCHA/SWACNT bit of pin 4
     45  f005		       00 0c	   SK_BOTH    =	SK_SDA|SK_SCL
     46  f005		       00 7f	   SK_ADDR_H  =	$7F	; record block $7FE0 (open question: AtariVox list)
     47  f005		       00 e0	   SK_ADDR_L  =	$E0
     48  f005		       00 a0	   SK_CTRL_W  =	$A0	; 1010 000 R/W
     49  f005		       00 a1	   SK_CTRL_R  =	$A1
     50  f005		       00 0c	   SK_REC_LEN =	12
     51  f005		       00 02	   R_STATE    =	2
     52  f005		       00 03	   R_LEVEL    =	3
     53  f005		       00 04	   R_LIVES    =	4
     54  f005		       00 05	   R_SCORE    =	5
     55  f005		       00 08	   R_HIGH     =	8
     56  f005		       00 0b	   R_CHK      =	11
     57  f005		       00 08	   LIVES_MAX  =	8
     58  f005		       00 14	   LEVEL_COUNT =	20	; hand copy of the kernel's LEVEL_COUNT
     59  f005
     60  f005							; Game variables (hand copies of kernel.asm; check_equ_sync pairs the names)
     61  f005		       00 a3	   Level      =	$A3
     62  f005		       00 ac	   PlayerLives =	$AC
     63  f005		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock (bank0 RefreshEnemyY)
     64  f005		       00 f3	   ScoreTh    =	$F3
     65  f005		       00 f4	   ScoreHu    =	$F4
     66  f005		       00 f5	   ScoreTe    =	$F5
     67  f005
     68  f005							; Scratch: dead at every call site (title / level load) - see the design doc.
     69  f005		       00 88	   SkB	      =	$88	; byte being shifted (kernel Temp)
     70  f005		       00 89	   SkN	      =	$89	; op flag (kernel ZPSpare89, free)
     71  f005		       00 8b	   SkT	      =	$8B	; (kernel CollisionX)
     72  f005		       00 8e	   SkL	      =	$8E	; loop counter (kernel CollisionEndX)
     73  f005		       00 93	   SkHi       =	$93	; high score handed to the title: vyLo, vyHi, PlayerYSub
     74  f005							;   (dead on the title; bank0 TitleScore reads them)
     75  f005		       00 c3	   SkBuf      =	$C3	; 12 bytes = PF0Buf..PF2Buf (rebuilt by the room load)
     76  f005
     77  f005							; ------------------------------------------------------------------------------
     78  f005							; I2C primitives. Between bits SCL is low; STOP/START leave the bus released/low.
     79  f005							; ------------------------------------------------------------------------------
     80  f005				   SkStart		; bus released -> START, SCL low
     81  f005		       a9 04		      lda	#SK_SDA
     82  f007		       8d 81 02 	      sta	SWACNT	; SDA falls while SCL is high
     83  f00a		       a9 0c		      lda	#SK_BOTH
     84  f00c		       8d 81 02 	      sta	SWACNT
     85  f00f		       60		      rts
     86  f010
     87  f010				   SkStop		; any state -> STOP, bus released
     88  f010		       a9 0c		      lda	#SK_BOTH
     89  f012		       8d 81 02 	      sta	SWACNT	; SDA low, SCL low
     90  f015		       a9 04		      lda	#SK_SDA
     91  f017		       8d 81 02 	      sta	SWACNT	; SCL high
     92  f01a		       a9 00		      lda	#0
     93  f01c		       8d 81 02 	      sta	SWACNT	; SDA rises while SCL is high
     94  f01f		       60		      rts
     95  f020
     96  f020				   SkRestart		; SCL low -> repeated START, SCL low
     97  f020		       a9 08		      lda	#SK_SCL
     98  f022		       8d 81 02 	      sta	SWACNT	; release SDA
     99  f025		       a9 00		      lda	#0
    100  f027		       8d 81 02 	      sta	SWACNT	; release SCL
    101  f02a		       4c 05 f0 	      jmp	SkStart
    102  f02d
    103  f02d							; Send A, MSB first; returns C=0 when the chip ACKed. SCL low, SDA low on exit.
    104  f02d				   SkSend
    105  f02d		       85 88		      sta	SkB
    106  f02f		       a2 08		      ldx	#8
    107  f031				   .SkBit
    108  f031		       06 88		      asl	SkB
    109  f033		       a0 0c		      ldy	#SK_BOTH	; bit 0: SDA low
    110  f035		       90 02		      bcc	.SkOut
    111  f037		       a0 08		      ldy	#SK_SCL	; bit 1: SDA released
    112  f039				   .SkOut
    113  f039		       8c 81 02 	      sty	SWACNT	; data valid, SCL low
    114  f03c		       98		      tya
    115  f03d		       29 04		      and	#SK_SDA
    116  f03f		       8d 81 02 	      sta	SWACNT	; SCL high
    117  f042		       8c 81 02 	      sty	SWACNT	; SCL low
    118  f045		       ca		      dex
    119  f046		       d0 e9		      bne	.SkBit
    120  f048		       a9 08		      lda	#SK_SCL
    121  f04a		       8d 81 02 	      sta	SWACNT	; release SDA for the ACK
    122  f04d		       a9 00		      lda	#0
    123  f04f		       8d 81 02 	      sta	SWACNT	; SCL high: the chip holds SDA low for an ACK
    124  f052		       ad 80 02 	      lda	SWCHA
    125  f055		       29 04		      and	#SK_SDA
    126  f057		       85 8b		      sta	SkT
    127  f059		       a9 08		      lda	#SK_SCL
    128  f05b		       8d 81 02 	      sta	SWACNT	; SCL low
    129  f05e		       a9 0c		      lda	#SK_BOTH
    130  f060		       8d 81 02 	      sta	SWACNT	; SDA low again
    131  f063		       a5 8b		      lda	SkT
    132  f065		       c9 01		      cmp	#1	; C = 1 when SDA stayed high (NACK)
    133  f067		       60		      rts
    134  f068
    135  f068							; Receive a byte into A. C=1 on entry -> NACK it (the last byte), C=0 -> ACK.
    136  f068				   SkRecv
    137  f068		       a9 00		      lda	#0
    138  f06a		       2a		      rol		; A = the ACK bit to send (1 = NACK)
    139  f06b		       85 8b		      sta	SkT
    140  f06d		       a9 08		      lda	#SK_SCL
    141  f06f		       8d 81 02 	      sta	SWACNT	; SDA released, SCL low
    142  f072		       a2 08		      ldx	#8
    143  f074				   .SkRb
    144  f074		       a9 00		      lda	#0
    145  f076		       8d 81 02 	      sta	SWACNT	; SCL high
    146  f079		       ad 80 02 	      lda	SWCHA
    147  f07c		       29 04		      and	#SK_SDA
    148  f07e		       c9 01		      cmp	#1	; C = the data bit
    149  f080		       26 88		      rol	SkB
    150  f082		       a9 08		      lda	#SK_SCL
    151  f084		       8d 81 02 	      sta	SWACNT	; SCL low
    152  f087		       ca		      dex
    153  f088		       d0 ea		      bne	.SkRb
    154  f08a		       a0 0c		      ldy	#SK_BOTH	; ACK: SDA low
    155  f08c		       a5 8b		      lda	SkT
    156  f08e		       f0 02		      beq	.SkAck
    157  f090		       a0 08		      ldy	#SK_SCL	; NACK: SDA released
    158  f092				   .SkAck
    159  f092		       8c 81 02 	      sty	SWACNT
    160  f095		       98		      tya
    161  f096		       29 04		      and	#SK_SDA
    162  f098		       8d 81 02 	      sta	SWACNT	; SCL high
    163  f09b		       8c 81 02 	      sty	SWACNT	; SCL low
    164  f09e		       a9 08		      lda	#SK_SCL
    165  f0a0		       8d 81 02 	      sta	SWACNT	; release SDA
    166  f0a3		       a5 88		      lda	SkB
    167  f0a5		       60		      rts
    168  f0a6
    169  f0a6							; ------------------------------------------------------------------------------
    170  f0a6							; Record transactions
    171  f0a6							; ------------------------------------------------------------------------------
    172  f0a6				   SkSum		; A = $A5 eor SkBuf[0..10]
    173  f0a6		       a9 a5		      lda	#$A5
    174  f0a8		       a0 0a		      ldy	#R_CHK-1
    175  f0aa				   .SkS1
    176  f0aa		       59 c3 00 	      eor	SkBuf,y
    177  f0ad		       88		      dey
    178  f0ae		       10 fa		      bpl	.SkS1
    179  f0b0		       60		      rts
    180  f0b1
    181  f0b1							; SkLoad: read the record into SkBuf.
    182  f0b1							; C=0 valid. C=1 with A=0: no key (nothing else is worth trying); A=1: bad data.
    183  f0b1				   SkLoad
    184  f0b1		       a9 00		      lda	#0
    185  f0b3		       8d 80 02 	      sta	SWCHA	; latch low for pins 3/4 (never drive high)
    186  f0b6		       8d 81 02 	      sta	SWACNT
    187  f0b9		       20 05 f0 	      jsr	SkStart
    188  f0bc		       a9 a0		      lda	#SK_CTRL_W
    189  f0be		       20 2d f0 	      jsr	SkSend
    190  f0c1		       b0 3d		      bcs	.SkAbsent
    191  f0c3		       a9 7f		      lda	#SK_ADDR_H
    192  f0c5		       20 2d f0 	      jsr	SkSend
    193  f0c8		       a9 e0		      lda	#SK_ADDR_L
    194  f0ca		       20 2d f0 	      jsr	SkSend
    195  f0cd		       20 20 f0 	      jsr	SkRestart
    196  f0d0		       a9 a1		      lda	#SK_CTRL_R
    197  f0d2		       20 2d f0 	      jsr	SkSend
    198  f0d5		       a0 00		      ldy	#0
    199  f0d7				   .SkRd
    200  f0d7		       84 8e		      sty	SkL
    201  f0d9		       c0 0b		      cpy	#SK_REC_LEN-1	; C=1 for the last byte: NACK it
    202  f0db		       20 68 f0 	      jsr	SkRecv
    203  f0de		       a4 8e		      ldy	SkL
    204  f0e0		       99 c3 00 	      sta	SkBuf,y
    205  f0e3		       c8		      iny
    206  f0e4		       c0 0c		      cpy	#SK_REC_LEN
    207  f0e6		       d0 ef		      bne	.SkRd
    208  f0e8		       20 10 f0 	      jsr	SkStop
    209  f0eb		       a5 c3		      lda	SkBuf
    210  f0ed		       c9 53		      cmp	#$53
    211  f0ef		       d0 16		      bne	.SkBad
    212  f0f1		       a5 c4		      lda	SkBuf+1
    213  f0f3		       c9 01		      cmp	#$01
    214  f0f5		       d0 10		      bne	.SkBad
    215  f0f7		       20 a6 f0 	      jsr	SkSum
    216  f0fa		       c5 ce		      cmp	SkBuf+R_CHK
    217  f0fc		       d0 09		      bne	.SkBad
    218  f0fe		       18		      clc
    219  f0ff		       60		      rts
    220  f100				   .SkAbsent
    221  f100		       20 10 f0 	      jsr	SkStop
    222  f103		       a9 00		      lda	#0
    223  f105		       38		      sec
    224  f106		       60		      rts
    225  f107				   .SkBad
    226  f107		       a9 01		      lda	#1
    227  f109		       38		      sec
    228  f10a		       60		      rts
    229  f10b
    230  f10b							; SkStore: complete the record (magic + checksum) and write it, then ACK-poll the
    231  f10b							; chip's write cycle (<= 5 ms). C=0 written, C=1 the chip never answered.
    232  f10b				   SkStore
    233  f10b		       a9 53		      lda	#$53
    234  f10d		       85 c3		      sta	SkBuf
    235  f10f		       a9 01		      lda	#$01
    236  f111		       85 c4		      sta	SkBuf+1
    237  f113		       20 a6 f0 	      jsr	SkSum
    238  f116		       85 ce		      sta	SkBuf+R_CHK
    239  f118		       20 05 f0 	      jsr	SkStart
    240  f11b		       a9 a0		      lda	#SK_CTRL_W
    241  f11d		       20 2d f0 	      jsr	SkSend
    242  f120		       b0 37		      bcs	.SkWfail
    243  f122		       a9 7f		      lda	#SK_ADDR_H
    244  f124		       20 2d f0 	      jsr	SkSend
    245  f127		       a9 e0		      lda	#SK_ADDR_L
    246  f129		       20 2d f0 	      jsr	SkSend
    247  f12c		       a0 00		      ldy	#0
    248  f12e				   .SkWr
    249  f12e		       84 8e		      sty	SkL
    250  f130		       b9 c3 00 	      lda	SkBuf,y
    251  f133		       20 2d f0 	      jsr	SkSend
    252  f136		       a4 8e		      ldy	SkL
    253  f138		       c8		      iny
    254  f139		       c0 0c		      cpy	#SK_REC_LEN
    255  f13b		       d0 f1		      bne	.SkWr
    256  f13d		       20 10 f0 	      jsr	SkStop
    257  f140		       a9 c8		      lda	#200
    258  f142		       85 8e		      sta	SkL	; poll up to 200 times
    259  f144				   .SkPoll
    260  f144		       20 05 f0 	      jsr	SkStart
    261  f147		       a9 a0		      lda	#SK_CTRL_W
    262  f149		       20 2d f0 	      jsr	SkSend
    263  f14c		       20 10 f0 	      jsr	SkStop	; (keeps C)
    264  f14f		       90 0f		      bcc	.SkWdone	; ACK: the write cycle is over
    265  f151		       c6 8e		      dec	SkL
    266  f153		       d0 ef		      bne	.SkPoll
    267  f155		       38		      sec
    268  f156		       4c 61 f1 	      jmp	SkRelease
    269  f159				   .SkWfail
    270  f159		       20 10 f0 	      jsr	SkStop
    271  f15c		       38		      sec
    272  f15d		       4c 61 f1 	      jmp	SkRelease
    273  f160				   .SkWdone
    274  f160		       18		      clc
    275  f161				   SkRelease		; leave the bus released (C kept)
    276  f161		       a9 00		      lda	#0
    277  f163		       8d 81 02 	      sta	SWACNT
    278  f166		       a6 89		      ldx	SkN
    279  f168		       ca		      dex
    280  f169		       ca		      dex
    281  f16a		       ca		      dex		; (dex keeps C) SkN = 3: game over / run won
    282  f16b		       d0 15		      bne	.SkBack
    283  f16d		       a5 a3		      lda	Level	; game over / run won: the title comes back on the level
    284  f16f		       c9 14		      cmp	#LEVEL_COUNT	;   just played (no SaveKey needed): GameStart keeps
    285  f171		       90 04		      bcc	.SkKeep	;   Level when these two bytes hold the magic
    286  f173		       a9 00		      lda	#0
    287  f175		       85 a3		      sta	Level
    288  f177				   .SkKeep
    289  f177		       a9 5a		      lda	#$5A
    290  f179		       85 8b		      sta	SkT
    291  f17b		       a9 a5		      lda	#$A5
    292  f17d		       85 8e		      sta	SkL
    293  f17f		       4c 00 f0 	      jmp	Restart
    294  f182				   .SkBack
    295  f182		       4c f8 fb 	      jmp	ReturnPad	; back to the bank0 caller (the C flag survives)
    296  f185
    297  f185							; ------------------------------------------------------------------------------
    298  f185							; Ops
    299  f185							; ------------------------------------------------------------------------------
    300  f185				   SkService
    301  f185		       85 89		      sta	SkN	; the op: SkRelease restarts the run when it is 3
    302  f187		       aa		      tax
    303  f188		       f0 0f		      beq	SkBoot
    304  f18a		       ca		      dex
    305  f18b		       f0 2f		      beq	SkResume
    306  f18d		       ca		      dex
    307  f18e		       f0 51		      beq	SkCheckpoint
    308  f190		       ca		      dex
    309  f191		       f0 03		      beq	.SkGO
    310  f193		       4c 59 f2 	      jmp	SkTitle	; 4 = the title's score window
    311  f196				   .SkGO
    312  f196		       4c eb f1 	      jmp	SkWriter	; 3 = game over
    313  f199
    314  f199
    315  f199				   SkBoot
    316  f199		       20 b1 f0 	      jsr	SkLoad
    317  f19c		       b0 16		      bcs	SkNothing
    318  f19e		       a0 02		      ldy	#2
    319  f1a0				   .SkHi
    320  f1a0		       b9 cb 00 	      lda	SkBuf+R_HIGH,y	; the title shows the high score now and then
    321  f1a3		       99 93 00 	      sta	SkHi,y
    322  f1a6		       88		      dey
    323  f1a7		       10 f7		      bpl	.SkHi
    324  f1a9		       a5 c6		      lda	SkBuf+R_LEVEL	; (state 0 = no run to resume, but the level of the
    325  f1ab		       c9 14		      cmp	#LEVEL_COUNT	;   last run stays selected: user 2026-11-11)
    326  f1ad		       b0 05		      bcs	SkNothing
    327  f1af		       85 a3		      sta	Level
    328  f1b1		       4c b8 f1 	      jmp	SkOk
    329  f1b4				   SkNothing
