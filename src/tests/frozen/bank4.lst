    239  f11b		       a9 a0		      lda	#SK_CTRL_W
    240  f11d		       20 2d f0 	      jsr	SkSend
    241  f120		       b0 37		      bcs	.SkWfail
    242  f122		       a9 7f		      lda	#SK_ADDR_H
    243  f124		       20 2d f0 	      jsr	SkSend
    244  f127		       a9 e0		      lda	#SK_ADDR_L
    245  f129		       20 2d f0 	      jsr	SkSend
    246  f12c		       a0 00		      ldy	#0
    247  f12e				   .SkWr
    248  f12e		       84 8e		      sty	SkL
    249  f130		       b9 c3 00 	      lda	SkBuf,y
    250  f133		       20 2d f0 	      jsr	SkSend
    251  f136		       a4 8e		      ldy	SkL
    252  f138		       c8		      iny
    253  f139		       c0 0c		      cpy	#SK_REC_LEN
    254  f13b		       d0 f1		      bne	.SkWr
    255  f13d		       20 10 f0 	      jsr	SkStop
    256  f140		       a9 c8		      lda	#200
    257  f142		       85 8e		      sta	SkL	; poll up to 200 times
    258  f144				   .SkPoll
