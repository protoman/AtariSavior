    430  f259							; Op 4 TITLE (every title frame, no I2C): the HUD score window shows the 1-based
    431  f259							; stage number (packed BCD, 000001 = stage 1) and, for 64 of every 256 frames
    432  f259							; (EnemyRamP $80-$BF; it restarts at $F0 on every LoadLevel, so SELECT always
    433  f259							; shows the stage first), the HIGH SCORE BOOT left in SkHi. No high score (no key,
    434  f259							; blank chip) = the stage number only. DropArm's title path writes the same stage
    435  f259							; number once per LoadLevel (SELECT); this keeps it right in between.
    436  f259				   SkTitle
    437  f259		       a5 a3		      lda	Level
    438  f25b		       18		      clc
    439  f25c		       69 01		      adc	#1
    440  f25e		       a2 00		      ldx	#0
    441  f260				   .SkTen
    442  f260		       c9 0a		      cmp	#10
    443  f262		       90 05		      bcc	.SkOnes
    444  f264		       e9 0a		      sbc	#10
    445  f266		       e8		      inx
    446  f267		       d0 f7		      bne	.SkTen	; (X <= 2: always taken)
    447  f269				   .SkOnes
    448  f269		       85 88		      sta	SkB
    449  f26b		       8a		      txa
    450  f26c		       0a		      asl
    451  f26d		       0a		      asl
    452  f26e		       0a		      asl
    453  f26f		       0a		      asl
    454  f270		       05 88		      ora	SkB
    455  f272		       85 f5		      sta	ScoreTe	; packed BCD: tens, ones
    456  f274		       a9 00		      lda	#0
    457  f276		       85 f3		      sta	ScoreTh
    458  f278		       85 f4		      sta	ScoreHu
    459  f27a		       a5 c2		      lda	EnemyRamP
    460  f27c		       29 c0		      and	#$C0
    461  f27e		       c9 80		      cmp	#$80
    462  f280		       d0 11		      bne	.SkTdone	; only clock $80-$BF (64 of 256 frames) shows it
    463  f282		       a5 93		      lda	SkHi
    464  f284		       05 94		      ora	SkHi+1
    465  f286		       05 95		      ora	SkHi+2
    466  f288		       f0 09		      beq	.SkTdone	; no high score yet
    467  f28a		       a2 02		      ldx	#2
    468  f28c				   .SkTHi
    469  f28c		       b5 93		      lda	SkHi,x
    470  f28e		       95 f3		      sta	ScoreTh,x
