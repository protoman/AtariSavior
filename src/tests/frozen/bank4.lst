     54  f005		       00 04	   R_LIVES    =	4
     55  f005		       00 05	   R_SCORE    =	5
     56  f005		       00 08	   R_HIGH     =	8
     57  f005		       00 0b	   R_CHK      =	11
     58  f005		       00 08	   LIVES_MAX  =	8
     59  f005		       00 14	   LEVEL_COUNT =	20	; hand copy of the kernel's LEVEL_COUNT
     60  f005
     61  f005							; Game variables (hand copies of kernel.asm; check_equ_sync pairs the names)
     62  f005		       00 a3	   Level      =	$A3
     63  f005		       00 ac	   PlayerLives =	$AC
     64  f005		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock (bank0 RefreshEnemyY)
     65  f005		       00 f3	   ScoreTh    =	$F3
     66  f005		       00 f4	   ScoreHu    =	$F4
     67  f005		       00 f5	   ScoreTe    =	$F5
