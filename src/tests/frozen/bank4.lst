    528  f80e							; ------------------------------------------------------------------------------
    529  f80e							; Cross-bank twins (bank0 is the caller; every pad is split across the banks):
    530  f80e							;   entry  A=$FC08: bank0 runs `sta $1FF8`; the fetch at $FC0B comes from HERE
    531  f80e							;	    = `jmp SkService` (bank0's own bytes at $FC0B are never fetched)
    532  f80e							;   return $FBF8: this `sta $1FF4` selects bank0, whose `rts` at $FBFB returns
    533  f80e							;	    to the caller (bank0's ReturnPad is the same two instructions)
    534  f80e							; ------------------------------------------------------------------------------
    535  f80e		       00 00 00 00*	      .ds	$FBF8 - *, 0
    536  fbf8				   ReturnPad
    537  fbf8		       8d f4 1f 	      sta	BK_GENERAL
    538  fbfb		       00 00 00 00*	      .ds	$FC0B - *, 0
    539  fc0b		       4c 85 f1 	      jmp	SkService
    540  fc0e
    541  fc0e		       00 00 00 00*	      .ds	$FFFA - *, 0
    542  fffa		       00 f0		      .word.w	$F000
    543  fffc		       00 f0		      .word.w	$F000
