    523  f498							; (models_data.asm via generated/spill_bank3_shapes.asm; convert_level.py capacity-checks
    524  f498							; it as _BANK3_SHAPES_SLOT = $F4C0-$FBF7, below bank4's ReturnPad.)
    525  f498		       00 00 00 00*	      .ds	$F4C0 - *, 0
