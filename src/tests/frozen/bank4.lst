    461  f280
    462  f280							; ------------------------------------------------------------------------------
    463  f280							; Cross-bank twins (bank0 is the caller; every pad is split across the banks):
    464  f280							;   entry  A=$FC08: bank0 runs `sta $1FF8`; the fetch at $FC0B comes from HERE
    465  f280							;	    = `jmp SkService` (bank0's own bytes at $FC0B are never fetched)
    466  f280							;   return $FBF8: this `sta $1FF4` selects bank0, whose `rts` at $FBFB returns
    467  f280							;	    to the caller (bank0's ReturnPad is the same two instructions)
    468  f280							; ------------------------------------------------------------------------------
    469  f280		       00 00 00 00*	      .ds	$FBF8 - *, 0
    470  fbf8				   ReturnPad
    471  fbf8		       8d f4 1f 	      sta	$1FF4
    472  fbfb		       00 00 00 00*	      .ds	$FC0B - *, 0
    473  fc0b		       4c 73 f1 	      jmp	SkService
    474  fc0e
    475  fc0e		       00 00 00 00*	      .ds	$FFFA - *, 0
    476  fffa		       00 f0		      .word.w	$F000
    477  fffc		       00 f0		      .word.w	$F000
    478  fffe		       00 f0		      .word.w	$F000
