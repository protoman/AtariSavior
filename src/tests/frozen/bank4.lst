    418  f242		       90 02		      bcc	.SkOvLv
    419  f244		       a9 00		      lda	#0
    420  f246				   .SkOvLv
    421  f246		       85 c6		      sta	SkBuf+R_LEVEL
    422  f248		       a9 00		      lda	#0
    423  f24a		       85 c5		      sta	SkBuf+R_STATE
    424  f24c		       85 c8		      sta	SkBuf+R_SCORE
    425  f24e		       85 c9		      sta	SkBuf+R_SCORE+1
    426  f250		       85 ca		      sta	SkBuf+R_SCORE+2
    427  f252		       a9 03		      lda	#3
    428  f254		       85 c7		      sta	SkBuf+R_LIVES
    429  f256		       4c 0b f1 	      jmp	SkStore
    430  f259
    431  f259							; Op 4 TITLE (every title frame, no I2C): the HUD score window shows the 1-based
    432  f259							; stage number (packed BCD, 000001 = stage 1) and, for 64 of every 256 frames
    433  f259							; (EnemyRamP $80-$BF; it restarts at $F0 on every LoadLevel, so SELECT always
    434  f259							; shows the stage first), the HIGH SCORE BOOT left in SkHi. No high score (no key,
    435  f259							; blank chip) = the stage number only. DropArm's title path writes the same stage
    436  f259							; number once per LoadLevel (SELECT); this keeps it right in between.
    437  f259				   SkTitle
    438  f259		       a5 a3		      lda	Level
    439  f25b		       18		      clc
    440  f25c		       69 01		      adc	#1
    441  f25e		       a2 00		      ldx	#0
    442  f260				   .SkTen
    443  f260		       c9 0a		      cmp	#10
    444  f262		       90 05		      bcc	.SkOnes
    445  f264		       e9 0a		      sbc	#10
    446  f266		       e8		      inx
    447  f267		       d0 f7		      bne	.SkTen	; (X <= 2: always taken)
    448  f269				   .SkOnes
    449  f269		       85 88		      sta	SkB
    450  f26b		       8a		      txa
    451  f26c		       0a		      asl
    452  f26d		       0a		      asl
    453  f26e		       0a		      asl
    454  f26f		       0a		      asl
    455  f270		       05 88		      ora	SkB
    456  f272		       85 f5		      sta	ScoreTe	; packed BCD: tens, ones
    457  f274		       a9 00		      lda	#0
    458  f276		       85 f3		      sta	ScoreTh
    459  f278		       85 f4		      sta	ScoreHu
    460  f27a		       a5 c2		      lda	EnemyRamP
    461  f27c		       29 c0		      and	#$C0
    462  f27e		       c9 80		      cmp	#$80
    463  f280		       d0 11		      bne	.SkTdone	; only clock $80-$BF (64 of 256 frames) shows it
    464  f282		       a5 93		      lda	SkHi
    465  f284		       05 94		      ora	SkHi+1
    466  f286		       05 95		      ora	SkHi+2
    467  f288		       f0 09		      beq	.SkTdone	; no high score yet
    468  f28a		       a2 02		      ldx	#2
    469  f28c				   .SkTHi
    470  f28c		       b5 93		      lda	SkHi,x
    471  f28e		       95 f3		      sta	ScoreTh,x
    472  f290		       ca		      dex
    473  f291		       10 f9		      bpl	.SkTHi
    474  f293				   .SkTdone
    475  f293		       4c f8 fb 	      jmp	ReturnPad
    476  f296
    477  f296							; ---- the SHAPE STEP of the room load (moved from bank3 2026-11-10, from bank7 to bank4 (the models share bank4) 2026-11-14) ------------------
    478  f296							; bank3 B3RoomBlocks (at $F453) does `sta BK_MODELS`; the next fetch (+3) is the jmp below.
    479  f296							; ShapeStep7 expands the room's shape block into the PF buffers and stages the hot flag in
    480  f296							; RoomMetaB; `sta $1FF7` at +6 returns to bank3 (B3Meta, +9).
    481  f296		       00 e5	   FetchPtr   =	$E5
    482  f296		       00 99	   RoomPF0Lo  =	$99
    483  f296		       00 9a	   RoomMetaB  =	$9A
    484  f296		       00 c3	   PF0Buf     =	$C3
    485  f296		       00 c7	   PF1Buf     =	$C7
    486  f296		       00 cb	   PF2Buf     =	$CB
    487  f296		       00 04	   TILE_ROWS  =	4
    488  f456					      org	$F453 + 3
    489  f456		       4c 60 f4 	      jmp	ShapeStep7
    490  f459					      org	$F453 + 6
    491  f459		       8d f7 1f 	      sta	BK_EXTRAS
    492  f460					      org	$F460
    493  f460				   ShapeStep7
    494  f460		       a5 99		      lda	RoomPF0Lo
    495  f462		       29 7f		      and	#$7F	; shape index, 7 bits (128 shapes)
    496  f464		       0a		      asl		; *2: LEVEL_ShapeTable is a word table
    497  f465		       aa		      tax
    498  f466		       bd 1c f7 	      lda	LEVEL_ShapeTable,X	; block address = the table entry
    499  f469		       85 e5		      sta	FetchPtr
    500  f46b		       bd 1d f7 	      lda	LEVEL_ShapeTable+1,X
    501  f46e		       85 e6		      sta	FetchPtr+1
    502  f470		       a0 03		      ldy	#TILE_ROWS-1
    503  f472				   .sp
    504  f472		       b1 e5		      lda	(FetchPtr),Y	; row index for this band (b7 = band 1's hot flag)
    505  f474		       29 7f		      and	#$7F
    506  f476		       aa		      tax
    507  f477		       bd a4 f6 	      lda	RowPoolPF0,X
    508  f47a		       99 c3 00 	      sta	PF0Buf,Y
    509  f47d		       bd cc f6 	      lda	RowPoolPF1,X
    510  f480		       99 c7 00 	      sta	PF1Buf,Y
    511  f483		       bd f4 f6 	      lda	RowPoolPF2,X
    512  f486		       99 cb 00 	      sta	PF2Buf,Y
    513  f489		       88		      dey
    514  f48a		       10 e6		      bpl	.sp
    515  f48c		       a0 01		      ldy	#1
    516  f48e		       b1 e5		      lda	(FetchPtr),Y	; band-1 index | hot b7
    517  f490		       29 80		      and	#$80
    518  f492		       4a		      lsr		; $80 -> $40 (MetaB b6)
    519  f493		       85 9a		      sta	RoomMetaB
    520  f495		       4c 59 f4 	      jmp	$F453 + 6	; sta $1FF7 -> bank3 B3Meta
    521  f498
