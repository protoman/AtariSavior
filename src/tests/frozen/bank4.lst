    187  f0bc		       a9 a0		      lda	#SK_CTRL_W
    188  f0be		       20 2d f0 	      jsr	SkSend
    189  f0c1		       b0 3d		      bcs	.SkAbsent
    190  f0c3		       a9 7f		      lda	#SK_ADDR_H
    191  f0c5		       20 2d f0 	      jsr	SkSend
    192  f0c8		       a9 e0		      lda	#SK_ADDR_L
    193  f0ca		       20 2d f0 	      jsr	SkSend
    194  f0cd		       20 20 f0 	      jsr	SkRestart
    195  f0d0		       a9 a1		      lda	#SK_CTRL_R
    196  f0d2		       20 2d f0 	      jsr	SkSend
    197  f0d5		       a0 00		      ldy	#0
    198  f0d7				   .SkRd
    199  f0d7		       84 8e		      sty	SkL
    200  f0d9		       c0 0b		      cpy	#SK_REC_LEN-1	; C=1 for the last byte: NACK it
    201  f0db		       20 68 f0 	      jsr	SkRecv
    202  f0de		       a4 8e		      ldy	SkL
    203  f0e0		       99 c3 00 	      sta	SkBuf,y
    204  f0e3		       c8		      iny
    205  f0e4		       c0 0c		      cpy	#SK_REC_LEN
    206  f0e6		       d0 ef		      bne	.SkRd
    207  f0e8		       20 10 f0 	      jsr	SkStop
    208  f0eb		       a5 c3		      lda	SkBuf
