    224  f10b
    225  f10b							; SkStore: complete the record (magic + checksum) and write it, then ACK-poll the
    226  f10b							; chip's write cycle (<= 5 ms). C=0 written, C=1 the chip never answered.
    227  f10b				   SkStore
    228  f10b		       a9 53		      lda	#$53
    229  f10d		       85 c3		      sta	SkBuf
    230  f10f		       a9 01		      lda	#$01
    231  f111		       85 c4		      sta	SkBuf+1
    232  f113		       20 a6 f0 	      jsr	SkSum
    233  f116		       85 ce		      sta	SkBuf+R_CHK
    234  f118		       20 05 f0 	      jsr	SkStart
    235  f11b		       a9 a0		      lda	#SK_CTRL_W
    236  f11d		       20 2d f0 	      jsr	SkSend
    237  f120		       b0 37		      bcs	.SkWfail
    238  f122		       a9 7f		      lda	#SK_ADDR_H
    239  f124		       20 2d f0 	      jsr	SkSend
    240  f127		       a9 e0		      lda	#SK_ADDR_L
    241  f129		       20 2d f0 	      jsr	SkSend
    242  f12c		       a0 00		      ldy	#0
    243  f12e				   .SkWr
    244  f12e		       84 8e		      sty	SkL
    245  f130		       b9 c3 00 	      lda	SkBuf,y
    246  f133		       20 2d f0 	      jsr	SkSend
    247  f136		       a4 8e		      ldy	SkL
    248  f138		       c8		      iny
    249  f139		       c0 0c		      cpy	#SK_REC_LEN
    250  f13b		       d0 f1		      bne	.SkWr
    251  f13d		       20 10 f0 	      jsr	SkStop
    252  f140		       a9 c8		      lda	#200
    253  f142		       85 8e		      sta	SkL	; poll up to 200 times
    254  f144				   .SkPoll
    255  f144		       20 05 f0 	      jsr	SkStart
    256  f147		       a9 a0		      lda	#SK_CTRL_W
    257  f149		       20 2d f0 	      jsr	SkSend
    258  f14c		       20 10 f0 	      jsr	SkStop	; (keeps C)
