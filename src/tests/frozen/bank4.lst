------- FILE bank4.asm LEVEL 1 PASS 2
      1  fffe					      processor	6502
      2  10000 ????				       seg	code
      3  f000					      org	$F000
      4  f000							; The power-up pad every bank carries: `lda #0 / sta $1FF4` selects bank0, whose
      5  f000							; $F005 is `jmp GameStart`. The restart ops (game over, last stage cleared) jump
      6  f000							; here: the run restarts at the title and never returns to the caller.
      7  f000				   Restart
      8  f000		       a9 00		      lda	#0
      9  f002		       8d f4 1f 	      sta	$1FF4
     10  f005							; ==============================================================================
     11  f005							; Bank4 — SaveKey service (docs/savekey_design.md, user 2026-10-28).
     12  f005							; ==============================================================================
     13  f005							; A 24LC256 I2C EEPROM on the RIGHT controller port: pin 3 = SDA = SWCHA bit 2,
     14  f005							; pin 4 = SCL = SWCHA bit 3 (Stella SaveKey.cxx). Open drain by hand: the SWCHA
     15  f005							; latch bits stay 0 and a line is driven LOW by setting its SWACNT bit (output)
     16  f005							; or RELEASED by clearing it (input, pulled up in the key). Nothing is ever
     17  f005							; driven high. Bit-banged without delays: every SWACNT store is >= 4 cycles
     18  f005							; (3.4 us), far above the chip's 400 kHz timing.
     19  f005							;
     20  f005							; ONE 12-byte record at SK_ADDR (16-byte aligned: it never straddles a 64-byte
     21  f005							; page), staged in SkBuf for the whole call:
     22  f005							;   0-1 magic $53,$01 (the 2nd byte is the format version)   2 state (1 = save)
     23  f005							;   3 level (0-based)	 4 lives   5-7 score (packed BCD Th,Hu,Te)
     24  f005							;   8-10 HIGH score (packed BCD)  11 checksum = $A5 eor bytes 0-10
     25  f005							; A bad magic/checksum is "no data": the game starts fresh and the next write
     26  f005							; repairs it. No key (NACK on the control byte) aborts every op at once.
     27  f005							;
     28  f005							; SkService (A = op), C=0 when it did something, C=1 when there was nothing to do
     29  f005							;   0 BOOT	   title power-on: Level := the saved stage; the high score goes
     30  f005							;		   to SkHi (vyLo/vyHi/PlayerYSub) for the title to show
     31  f005							;   1 RESUME	   RESET on the saved stage: lives + score := the saved ones
     32  f005							;   2 CHECKPOINT  stage advance (the caller already did `inc Level`): save {Level,
     33  f005							;		   lives, score}; high = max(high,score). Level >= LEVEL_COUNT =
     34  f005							;		   the last stage was cleared: same as GAMEOVER
     35  f005							;   3 GAMEOVER    erase the save; high = max(high, score); then RESTART at the
     36  f005							;		   title (never returns; with no key it just restarts)
     37  f005							; Clobbers A/X/Y, SkB/SkN/SkT/SkL and SkBuf. Leaves SWACNT = 0 (bus released).
     38  f005							; Hotspot for this bank: $1FF8 (F4: bank = addr - $1FF4).
     39  f005							; ==============================================================================
     40  f005		       02 80	   SWCHA      =	$0280
     41  f005		       02 81	   SWACNT     =	$0281
     42  f005		       00 04	   SK_SDA     =	$04	; SWCHA/SWACNT bit of pin 3
     43  f005		       00 08	   SK_SCL     =	$08	; SWCHA/SWACNT bit of pin 4
     44  f005		       00 0c	   SK_BOTH    =	SK_SDA|SK_SCL
     45  f005		       00 7f	   SK_ADDR_H  =	$7F	; record block $7FE0 (open question: AtariVox list)
     46  f005		       00 e0	   SK_ADDR_L  =	$E0
     47  f005		       00 a0	   SK_CTRL_W  =	$A0	; 1010 000 R/W
     48  f005		       00 a1	   SK_CTRL_R  =	$A1
     49  f005		       00 0c	   SK_REC_LEN =	12
     50  f005		       00 02	   R_STATE    =	2
     51  f005		       00 03	   R_LEVEL    =	3
     52  f005		       00 04	   R_LIVES    =	4
     53  f005		       00 05	   R_SCORE    =	5
     54  f005		       00 08	   R_HIGH     =	8
     55  f005		       00 0b	   R_CHK      =	11
     56  f005		       00 08	   LIVES_MAX  =	8
     57  f005		       00 14	   LEVEL_COUNT =	20	; hand copy of the kernel's LEVEL_COUNT
     58  f005
     59  f005							; Game variables (hand copies of kernel.asm; check_equ_sync pairs the names)
     60  f005		       00 a3	   Level      =	$A3
     61  f005		       00 ac	   PlayerLives =	$AC
     62  f005		       00 c2	   EnemyRamP  =	$C2	; free-running frame clock (bank0 RefreshEnemyY)
     63  f005		       00 f3	   ScoreTh    =	$F3
     64  f005		       00 f4	   ScoreHu    =	$F4
     65  f005		       00 f5	   ScoreTe    =	$F5
     66  f005
     67  f005							; Scratch: dead at every call site (title / level load) - see the design doc.
     68  f005		       00 88	   SkB	      =	$88	; byte being shifted (kernel Temp)
     69  f005		       00 89	   SkN	      =	$89	; op flag (kernel ZPSpare89, free)
     70  f005		       00 8b	   SkT	      =	$8B	; (kernel CollisionX)
     71  f005		       00 8e	   SkL	      =	$8E	; loop counter (kernel CollisionEndX)
     72  f005		       00 93	   SkHi       =	$93	; high score handed to the title: vyLo, vyHi, PlayerYSub
     73  f005							;   (dead on the title; bank0 TitleScore reads them)
     74  f005		       00 c3	   SkBuf      =	$C3	; 12 bytes = PF0Buf..PF2Buf (rebuilt by the room load)
     75  f005
     76  f005							; ------------------------------------------------------------------------------
     77  f005							; I2C primitives. Between bits SCL is low; STOP/START leave the bus released/low.
     78  f005							; ------------------------------------------------------------------------------
     79  f005				   SkStart		; bus released -> START, SCL low
     80  f005		       a9 04		      lda	#SK_SDA
     81  f007		       8d 81 02 	      sta	SWACNT	; SDA falls while SCL is high
     82  f00a		       a9 0c		      lda	#SK_BOTH
     83  f00c		       8d 81 02 	      sta	SWACNT
     84  f00f		       60		      rts
     85  f010
     86  f010				   SkStop		; any state -> STOP, bus released
     87  f010		       a9 0c		      lda	#SK_BOTH
     88  f012		       8d 81 02 	      sta	SWACNT	; SDA low, SCL low
     89  f015		       a9 04		      lda	#SK_SDA
     90  f017		       8d 81 02 	      sta	SWACNT	; SCL high
     91  f01a		       a9 00		      lda	#0
     92  f01c		       8d 81 02 	      sta	SWACNT	; SDA rises while SCL is high
     93  f01f		       60		      rts
     94  f020
     95  f020				   SkRestart		; SCL low -> repeated START, SCL low
     96  f020		       a9 08		      lda	#SK_SCL
     97  f022		       8d 81 02 	      sta	SWACNT	; release SDA
     98  f025		       a9 00		      lda	#0
     99  f027		       8d 81 02 	      sta	SWACNT	; release SCL
    100  f02a		       4c 05 f0 	      jmp	SkStart
    101  f02d
    102  f02d							; Send A, MSB first; returns C=0 when the chip ACKed. SCL low, SDA low on exit.
    103  f02d				   SkSend
    104  f02d		       85 88		      sta	SkB
    105  f02f		       a2 08		      ldx	#8
    106  f031				   .SkBit
    107  f031		       06 88		      asl	SkB
    108  f033		       a0 0c		      ldy	#SK_BOTH	; bit 0: SDA low
    109  f035		       90 02		      bcc	.SkOut
    110  f037		       a0 08		      ldy	#SK_SCL	; bit 1: SDA released
    111  f039				   .SkOut
    112  f039		       8c 81 02 	      sty	SWACNT	; data valid, SCL low
    113  f03c		       98		      tya
    114  f03d		       29 04		      and	#SK_SDA
    115  f03f		       8d 81 02 	      sta	SWACNT	; SCL high
    116  f042		       8c 81 02 	      sty	SWACNT	; SCL low
    117  f045		       ca		      dex
    118  f046		       d0 e9		      bne	.SkBit
    119  f048		       a9 08		      lda	#SK_SCL
    120  f04a		       8d 81 02 	      sta	SWACNT	; release SDA for the ACK
    121  f04d		       a9 00		      lda	#0
    122  f04f		       8d 81 02 	      sta	SWACNT	; SCL high: the chip holds SDA low for an ACK
    123  f052		       ad 80 02 	      lda	SWCHA
    124  f055		       29 04		      and	#SK_SDA
    125  f057		       85 8b		      sta	SkT
    126  f059		       a9 08		      lda	#SK_SCL
    127  f05b		       8d 81 02 	      sta	SWACNT	; SCL low
    128  f05e		       a9 0c		      lda	#SK_BOTH
    129  f060		       8d 81 02 	      sta	SWACNT	; SDA low again
    130  f063		       a5 8b		      lda	SkT
    131  f065		       c9 01		      cmp	#1	; C = 1 when SDA stayed high (NACK)
    132  f067		       60		      rts
    133  f068
    134  f068							; Receive a byte into A. C=1 on entry -> NACK it (the last byte), C=0 -> ACK.
    135  f068				   SkRecv
    136  f068		       a9 00		      lda	#0
    137  f06a		       2a		      rol		; A = the ACK bit to send (1 = NACK)
    138  f06b		       85 8b		      sta	SkT
    139  f06d		       a9 08		      lda	#SK_SCL
    140  f06f		       8d 81 02 	      sta	SWACNT	; SDA released, SCL low
    141  f072		       a2 08		      ldx	#8
    142  f074				   .SkRb
    143  f074		       a9 00		      lda	#0
    144  f076		       8d 81 02 	      sta	SWACNT	; SCL high
    145  f079		       ad 80 02 	      lda	SWCHA
    146  f07c		       29 04		      and	#SK_SDA
    147  f07e		       c9 01		      cmp	#1	; C = the data bit
    148  f080		       26 88		      rol	SkB
    149  f082		       a9 08		      lda	#SK_SCL
    150  f084		       8d 81 02 	      sta	SWACNT	; SCL low
    151  f087		       ca		      dex
    152  f088		       d0 ea		      bne	.SkRb
    153  f08a		       a0 0c		      ldy	#SK_BOTH	; ACK: SDA low
    154  f08c		       a5 8b		      lda	SkT
    155  f08e		       f0 02		      beq	.SkAck
    156  f090		       a0 08		      ldy	#SK_SCL	; NACK: SDA released
    157  f092				   .SkAck
    158  f092		       8c 81 02 	      sty	SWACNT
    159  f095		       98		      tya
    160  f096		       29 04		      and	#SK_SDA
    161  f098		       8d 81 02 	      sta	SWACNT	; SCL high
    162  f09b		       8c 81 02 	      sty	SWACNT	; SCL low
    163  f09e		       a9 08		      lda	#SK_SCL
    164  f0a0		       8d 81 02 	      sta	SWACNT	; release SDA
    165  f0a3		       a5 88		      lda	SkB
    166  f0a5		       60		      rts
    167  f0a6
    168  f0a6							; ------------------------------------------------------------------------------
    169  f0a6							; Record transactions
    170  f0a6							; ------------------------------------------------------------------------------
    171  f0a6				   SkSum		; A = $A5 eor SkBuf[0..10]
