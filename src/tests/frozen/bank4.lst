    348  f1d3							; The two writers share SkPrep (entered by `jmp`, so the call chain stays at
    349  f1d3							; pad 2 + SkLoad 2 + a leaf 2 = 6 stack bytes - the stack mirror is only 8 wide).
    350  f1d3							; SkN = 2 checkpoint, 3 game over. A missing key ends the op, bad data leaves a
    351  f1d3							; zero high score. SkBuf[R_HIGH..] = max(old high, current score) on the way out.
    352  f1d3				   SkCheckpoint
    353  f1d3		       a5 a3		      lda	Level
    354  f1d5		       c9 14		      cmp	#LEVEL_COUNT
