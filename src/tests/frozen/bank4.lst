    228  f10b
    229  f10b							; SkStore: complete the record (magic + checksum) and write it, then ACK-poll the
    230  f10b							; chip's write cycle (<= 5 ms). C=0 written, C=1 the chip never answered.
    231  f10b				   SkStore
    232  f10b		       a9 53		      lda	#$53
    233  f10d		       85 c3		      sta	SkBuf
    234  f10f		       a9 01		      lda	#$01
    235  f111		       85 c4		      sta	SkBuf+1
