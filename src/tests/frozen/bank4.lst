    527  f526
    528  f526
    529  f526							; ------------------------------------------------------------------------------
    530  f526							; Cross-bank twins (bank0 is the caller; every pad is split across the banks):
    531  f526							;   entry  A=$FC08: bank0 runs `sta $1FF8`; the fetch at $FC0B comes from HERE
    532  f526							;	    = `jmp SkService` (bank0's own bytes at $FC0B are never fetched)
    533  f526							;   return $FBF8: this `sta $1FF4` selects bank0, whose `rts` at $FBFB returns
    534  f526							;	    to the caller (bank0's ReturnPad is the same two instructions)
    535  f526							; ------------------------------------------------------------------------------
    536  f526		       00 00 00 00*	      .ds	$FBD0 - *, 0
    537  fbd0		       8d f6 1f 	      sta	BK_ROOMS	; twin of bank0's EnterRoom pad (the transition frame jumps here)
    538  fbd3		       00 00 00 00*	      .ds	$FBF8 - *, 0
    539  fbf8				   ReturnPad
    540  fbf8		       8d f4 1f 	      sta	BK_GENERAL
    541  fbfb		       00 00 00 00*	      .ds	$FC08 - *, 0
    542  fc08		       8d f8 1f 	      sta	BK_SAVE	; twin of CallPad_SaveKey (the `jmp` below is fetched after it)
    543  fc0b					      .ds	$FC0B - *, 0
    544  fc0b		       4c 85 f1 	      jmp	SkService
    545  fc0e		       00 00 00 00*	      .ds	$FC20 - *, 0
    546  fc20		       8d f6 1f 	      sta	BK_ROOMS	; twin of LoadLevel (bank2 serves the jmp at $FC23)
    547  fc23		       00 00 00 00*	      .ds	$FC58 - *, 0
    548  fc58		       8d f4 1f 	      sta	BK_GENERAL	; bank0 $FC5B = jmp StartFrame
    549  fc5b		       4c 83 fc 	      jmp	TransBody	; $FC5B: fetched after bank0's `sta BK_TRANS` pad at $FC58
    550  fc5e		       00 00 00 	      .ds	$FC61 - *, 0
    551  fc61		       4c de fc 	      jmp	TransFinish	; $FC61: after bank0's second pad at $FC5E
    552  fc64					      .ds	$FC64 - *, 0
    553  fc64		       4c d5 fc 	      jmp	TransAfterSave	; $FC64: after bank0's third pad at $FC61
    554  fc67		       00 00 00 00*	      .ds	$FC70 - *, 0
    555  fc70				   RomVersion
