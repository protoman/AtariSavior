    400  f232
    401  f232							; ------------------------------------------------------------------------------
    402  f232							; Cross-bank twins (bank0 is the caller; every pad is split across the banks):
    403  f232							;   entry  A=$FC08: bank0 runs `sta $1FF8`; the fetch at $FC0B comes from HERE
    404  f232							;	    = `jmp SkService` (bank0's own bytes at $FC0B are never fetched)
    405  f232							;   return $FBF8: this `sta $1FF4` selects bank0, whose `rts` at $FBFB returns
    406  f232							;	    to the caller (bank0's ReturnPad is the same two instructions)
    407  f232							; ------------------------------------------------------------------------------
    408  f232		       00 00 00 00*	      .ds	$FBF8 - *, 0
    409  fbf8				   ReturnPad
    410  fbf8		       8d f4 1f 	      sta	$1FF4
    411  fbfb		       00 00 00 00*	      .ds	$FC0B - *, 0
    412  fc0b		       4c 73 f1 	      jmp	SkService
    413  fc0e
    414  fc0e		       00 00 00 00*	      .ds	$FFFA - *, 0
    415  fffa		       00 f0		      .word.w	$F000
    416  fffc		       00 f0		      .word.w	$F000
    417  fffe		       00 f0		      .word.w	$F000
