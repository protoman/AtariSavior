    451  f26c		       0a		      asl
    452  f26d		       0a		      asl
    453  f26e		       0a		      asl
    454  f26f		       0a		      asl
    455  f270		       05 88		      ora	SkB
    456  f272		       85 f5		      sta	ScoreTe	; packed BCD: tens, ones
    457  f274		       a9 00		      lda	#0
    458  f276		       85 f3		      sta	ScoreTh
    459  f278		       85 f4		      sta	ScoreHu
    460  f27a		       a5 c2		      lda	EnemyRamP
    461  f27c		       29 c0		      and	#$C0
    462  f27e		       c9 80		      cmp	#$80
    463  f280		       d0 11		      bne	.SkTdone	; only clock $80-$BF (64 of 256 frames) shows it
    464  f282		       a5 93		      lda	SkHi
    465  f284		       05 94		      ora	SkHi+1
    466  f286		       05 95		      ora	SkHi+2
    467  f288		       f0 09		      beq	.SkTdone	; no high score yet
    468  f28a		       a2 02		      ldx	#2
    469  f28c				   .SkTHi
    470  f28c		       b5 93		      lda	SkHi,x
    471  f28e		       95 f3		      sta	ScoreTh,x
    472  f290		       ca		      dex
    473  f291		       10 f9		      bpl	.SkTHi
