    209  f0f5		       d0 10		      bne	.SkBad
    210  f0f7		       20 a6 f0 	      jsr	SkSum
    211  f0fa		       c5 ce		      cmp	SkBuf+R_CHK
    212  f0fc		       d0 09		      bne	.SkBad
    213  f0fe		       18		      clc
    214  f0ff		       60		      rts
    215  f100				   .SkAbsent
    216  f100		       20 10 f0 	      jsr	SkStop
    217  f103		       a9 00		      lda	#0
    218  f105		       38		      sec
    219  f106		       60		      rts
    220  f107				   .SkBad
    221  f107		       a9 01		      lda	#1
    222  f109		       38		      sec
