    100  f025		       a9 00		      lda	#0
    101  f027		       8d 81 02 	      sta	SWACNT	; release SCL
    102  f02a		       4c 05 f0 	      jmp	SkStart
    103  f02d
    104  f02d							; Send A, MSB first; returns C=0 when the chip ACKed. SCL low, SDA low on exit.
    105  f02d				   SkSend
    106  f02d		       85 88		      sta	SkB
    107  f02f		       a2 08		      ldx	#8
    108  f031				   .SkBit
