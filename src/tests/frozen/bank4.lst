    378  f207		       85 c5		      sta	SkBuf+R_STATE
    379  f209		       a5 a3		      lda	Level
    380  f20b		       85 c6		      sta	SkBuf+R_LEVEL
    381  f20d		       a5 ac		      lda	PlayerLives
    382  f20f		       85 c7		      sta	SkBuf+R_LIVES
    383  f211		       a0 02		      ldy	#2
    384  f213				   .SkSv
    385  f213		       b9 f3 00 	      lda	ScoreTh,y
    386  f216		       99 c8 00 	      sta	SkBuf+R_SCORE,y
    387  f219		       88		      dey
    388  f21a		       10 f7		      bpl	.SkSv
    389  f21c		       4c 0b f1 	      jmp	SkStore
    390  f21f				   .SkOver
    391  f21f		       a9 00		      lda	#0
    392  f221		       85 c5		      sta	SkBuf+R_STATE
    393  f223		       85 c6		      sta	SkBuf+R_LEVEL
    394  f225		       85 c8		      sta	SkBuf+R_SCORE
    395  f227		       85 c9		      sta	SkBuf+R_SCORE+1
    396  f229		       85 ca		      sta	SkBuf+R_SCORE+2
