    311  f15e				   SetObjectXPos subroutine
    312  f15e		       85 02		      sta	WSYNC	; start new scanline
    313  f160		       38		      sec		; ensure carry flag
    314  f161				   .Div15Loop
    315  f161		       e9 0f		      sbc	#15	; sub 15 from desired X to get coarse location
    316  f163		       b0 fc		      bcs	.Div15Loop	; loop until carry is clear
    317  f165		       49 07		      eor	#7	; put in range -8 to 7
    318  f167					      repeat	4	; shift left 4 times, only want top 4 bits
    319  f167		       0a		      asl
    318  f167					      repend
    319  f168		       0a		      asl
    318  f168					      repend
    319  f169		       0a		      asl
