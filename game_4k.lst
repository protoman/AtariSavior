    407  f1d0		       38		      sec		; ensure carry flag
    408  f1d1				   .Div15Loop
    409  f1d1		       e9 0f		      sbc	#15	; sub 15 from desired X to get coarse location
    410  f1d3		       b0 fc		      bcs	.Div15Loop	; loop until carry is clear
    411  f1d5		       49 07		      eor	#7	; put in range -8 to 7
    412  f1d7					      repeat	4	; shift left 4 times, only want top 4 bits
    413  f1d7		       0a		      asl
    412  f1d7					      repend
    413  f1d8		       0a		      asl
    412  f1d8					      repend
    413  f1d9		       0a		      asl
