    327  f16c							; Subroutines
    328  f16c							; ------------------------------------------------------------------------------
    329  f16c							; Horizontal positioning conversion
    330  f16c							; A is the desired room-space X coordinate. TIA conversion happens here.
    331  f16c							; Y is the object type
    332  f16c							;   0 = player0, 1 = player1, 2 = missile0, 3 = missile1, 4 = ball
    333  f16c							; ------------------------------------------------------------------------------
    334  f16c				   SetObjectXPos subroutine
    335  f16c		       85 02		      sta	WSYNC	; start new scanline
    336  f16e		       38		      sec		; ensure carry flag
    337  f16f				   .Div15Loop
    338  f16f		       e9 0f		      sbc	#15	; sub 15 from desired X to get coarse location
    339  f171		       b0 fc		      bcs	.Div15Loop	; loop until carry is clear
    340  f173		       49 07		      eor	#7	; put in range -8 to 7
    341  f175					      repeat	4	; shift left 4 times, only want top 4 bits
    342  f175		       0a		      asl
    341  f175					      repend
    342  f176		       0a		      asl
    341  f176					      repend
    342  f177		       0a		      asl
    341  f177					      repend
    342  f178		       0a		      asl
    343  f179					      repend
    344  f179		       99 20 00 	      sta	HMP0,Y	; store the fine offset
    345  f17c		       99 10 00 	      sta	RESP0,Y	; store the coarse offset
    346  f17f		       60		      rts
